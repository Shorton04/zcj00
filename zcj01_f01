* Get PRPS-OBJNR + JEST-STAT
* Active statuses only
*---------------------------------------------------------------------*
  SELECT a~posid,
         a~objnr,
         b~stat
    INTO TABLE @lt_prps_stat
    FROM prps  AS a
    INNER JOIN jest  AS b
      ON b~objnr = a~objnr
   WHERE a~posid IN @lt_posid_range
     AND b~inact = @space
     AND b~stat IN ( 'I0002', 'I0045', 'I0046' ).

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* Fill TXT04 as constant
*---------------------------------------------------------------------*
  LOOP AT lt_prps_stat INTO ls_prps_stat.
    CASE ls_prps_stat-stat.
      WHEN 'I0002'.
        ls_prps_stat-txt04 = 'REL'.
      WHEN 'I0045'.
        ls_prps_stat-txt04 = 'TECO'.
      WHEN 'I0046'.
        ls_prps_stat-txt04 = 'CLSD'.
    ENDCASE.

    MODIFY lt_prps_stat FROM ls_prps_stat INDEX sy-tabix.
  ENDLOOP.

*---------------------------------------------------------------------*
* Update gt_wbs_unclose-status
*---------------------------------------------------------------------*
  SORT lt_prps_stat BY posid txt04.

  IF sy-uname <> 'EV92123'.
    LOOP AT gt_wbs_unclose ASSIGNING <fs_unclose>.
      CLEAR lv_status.

      LOOP AT lt_prps_stat INTO ls_prps_stat
        WHERE posid = <fs_unclose>-wbs_element_code.

        IF lv_status IS INITIAL.
          lv_status = ls_prps_stat-txt04.
        ELSE.
          CONCATENATE lv_status ls_prps_stat-txt04
            INTO lv_status SEPARATED BY ', '.
        ENDIF.
      ENDLOOP.

      <fs_unclose>-status = lv_status.
    ENDLOOP.

  ELSE.
    LOOP AT gt_wbs_unclose ASSIGNING <fs_unclose>.

      <fs_unclose>-status =
        REDUCE string(
          INIT lv = ``
          FOR ls_stat IN lt_prps_stat
          WHERE ( posid = <fs_unclose>-wbs_element_code )
          NEXT lv = condense(
                     SWITCH string(
                       lv
                       WHEN `` THEN ls_stat-txt04
                       ELSE |{ lv }, { ls_stat-txt04 }|
                     )
                   )
        ).

    ENDLOOP.
  ENDIF.

*---------------------------------------------------------------------*
* DISPLAY MODE
*---------------------------------------------------------------------*

  IF gv_disp_req = abap_true.

    LOOP AT gt_wbs_unclose ASSIGNING <fs_unclose>.
      lv_tabix = sy-tabix.

      READ TABLE gt_wbs_items INTO gs_wbs_item INDEX lv_tabix.
      IF sy-subrc = 0.
        IF gs_wbs_item-zstat IS NOT INITIAL.
          <fs_unclose>-status = gs_wbs_item-zstat.
        ENDIF.

        IF gs_wbs_item-zstat_tobe IS NOT INITIAL.
          <fs_unclose>-to_be = gs_wbs_item-zstat_tobe.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form validate_teco_clsd
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM validate_teco_clsd CHANGING cv_error TYPE abap_bool.

*---------------------------------------------------------------------*
* Local Types
*---------------------------------------------------------------------*
  TYPES: BEGIN OF ty_posid_range,
           sign   TYPE c LENGTH 1,
           option TYPE c LENGTH 2,
           low    TYPE prps-posid,
           high   TYPE prps-posid,
         END OF ty_posid_range.

  TYPES: BEGIN OF ty_wbs_stat,
           posid TYPE prps-posid,
           stat  TYPE jest-stat,
         END OF ty_wbs_stat.

*---------------------------------------------------------------------*
* Data
*---------------------------------------------------------------------*
  DATA: lv_pspnr       TYPE proj-pspnr,
        lv_posid       TYPE prps-posid,
        ls_display     TYPE ty_wbs_display,
        ls_posid_range TYPE ty_posid_range,
        ls_wbs_stat    TYPE ty_wbs_stat,
        lt_posid_range TYPE STANDARD TABLE OF ty_posid_range,
        lt_wbs_stat    TYPE STANDARD TABLE OF ty_wbs_stat,
        lv_total_wbs   TYPE i,
        lv_closed_wbs  TYPE i.

*---------------------------------------------------------------------*
* Init
*---------------------------------------------------------------------*
  CLEAR: cv_error,
         lv_total_wbs,
         lv_closed_wbs.

*---------------------------------------------------------------------*
* Validate Project Definition
*---------------------------------------------------------------------*
  lv_pspnr = gs_header-pspnr.

  IF lv_pspnr IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Project Definition is required'(v21).
    cv_error = gc_x.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* Build WBS POSID range from gt_wbs_display
*---------------------------------------------------------------------*
  LOOP AT gt_wbs_display INTO ls_display.
    IF ls_display-posid IS INITIAL.
      CONTINUE.
    ENDIF.

    lv_posid = ls_display-posid.
    REPLACE ALL OCCURRENCES OF '.' IN lv_posid WITH ''.

    CLEAR ls_posid_range.
    ls_posid_range-sign   = 'I'.
    ls_posid_range-option = 'EQ'.
    ls_posid_range-low    = lv_posid.
    APPEND ls_posid_range TO lt_posid_range.

    ADD 1 TO lv_total_wbs.
  ENDLOOP.

  IF lt_posid_range IS INITIAL.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* Remove duplicate POSID entries
*---------------------------------------------------------------------*
  SORT lt_posid_range BY low.
  DELETE ADJACENT DUPLICATES FROM lt_posid_range COMPARING low.

*---------------------------------------------------------------------*
* Get active WBS statuses TECO / CLSD only
*---------------------------------------------------------------------*
  SELECT a~posid,
         b~stat
    INTO TABLE @lt_wbs_stat
    FROM prps AS a
    INNER JOIN jest AS b
      ON b~objnr = a~objnr
   WHERE a~posid IN @lt_posid_range
     AND b~inact = @space
     AND b~stat  IN ( 'I0045', 'I0046', 'I0043', 'I0002' ).

  SORT lt_wbs_stat BY posid stat.
  DELETE ADJACENT DUPLICATES FROM lt_wbs_stat COMPARING posid stat.

*---------------------------------------------------------------------*
* Count how many selected WBS are already TECO / CLSD
*---------------------------------------------------------------------*
  LOOP AT gt_wbs_display INTO ls_display.
    IF ls_display-posid IS INITIAL.
      CONTINUE.
    ENDIF.

    lv_posid = ls_display-posid.
    REPLACE ALL OCCURRENCES OF '.' IN lv_posid WITH ''.

    READ TABLE lt_wbs_stat INTO ls_wbs_stat
      WITH KEY posid = lv_posid.

    gt_wbs_stat = lt_wbs_stat.

    IF ls_wbs_stat-stat = 'I0043'.
      gv_disp_req_wbs = abap_true.
    ENDIF.
    IF sy-subrc = 0.
      ADD 1 TO lv_closed_wbs.
    ENDIF.
  ENDLOOP.

*---------------------------------------------------------------------*
* Validation Result
* Pass if partially TECO/CLSD exists
* Error only if all selected WBS are still Released/open
*---------------------------------------------------------------------*
  IF lv_closed_wbs = 0.
    MESSAGE e000(zmsg_a2r)
      WITH 'WBS are in Released status. Re-open not needed.'(v20).
    cv_error = gc_x.
    RETURN.
  ENDIF.

  CLEAR cv_error.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form populate_gt_wbs_car_wert2
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM populate_gt_wbs_car_wert2 .
  TYPES: BEGIN OF ty_item_map,
           posid         TYPE ps_posid,
           wert2         TYPE zta2r_wbsitem-wert2,
           zbudget_check TYPE zta2r_wbsitem-zbudget_check,
           post1         TYPE zta2r_wbsitem-post1,
           kostl         TYPE zta2r_wbsitem-kostl,
           imprf         TYPE zta2r_wbsitem-imprf,
           prart         TYPE zta2r_wbsitem-prart,
           bukrs         TYPE zta2r_wbsitem-bukrs,
           werks         TYPE zta2r_wbsitem-werks,
           vkokr         TYPE zta2r_wbsitem-vkokr,
         END OF ty_item_map.

  DATA: lt_item_map TYPE HASHED TABLE OF ty_item_map WITH UNIQUE KEY posid,
        ls_item_map TYPE ty_item_map,
        ls_item     TYPE zta2r_wbsitem,
        lv_posid    TYPE ps_posid.

  FIELD-SYMBOLS: <fs_car> TYPE zta2r_wbsitem,
                 <fs_map> TYPE ty_item_map.

  CLEAR lt_item_map.

  LOOP AT gt_wbs_items INTO ls_item.
    CLEAR: ls_item_map, lv_posid.

    lv_posid = ls_item-posid.
    REPLACE ALL OCCURRENCES OF '.' IN lv_posid WITH ''.

    ls_item_map-posid         = lv_posid.
    ls_item_map-wert2         = ls_item-wert2.
    ls_item_map-zbudget_check = ls_item-zbudget_check.
    ls_item_map-post1         = ls_item-post1.
    ls_item_map-kostl         = ls_item-kostl.
    ls_item_map-imprf         = ls_item-imprf.
    ls_item_map-prart         = ls_item-prart.
    ls_item_map-bukrs         = ls_item-bukrs.
    ls_item_map-werks         = ls_item-werks.
    ls_item_map-vkokr         = ls_item-vkokr.

    INSERT ls_item_map INTO TABLE lt_item_map.
  ENDLOOP.

  LOOP AT gt_wbs_car ASSIGNING <fs_car>.
    READ TABLE lt_item_map ASSIGNING <fs_map>
      WITH TABLE KEY posid = <fs_car>-posid.
    IF sy-subrc = 0.
      <fs_car>-wert2         = <fs_map>-wert2.
      <fs_car>-zbudget_check = <fs_map>-zbudget_check.
      <fs_car>-post1         = <fs_map>-post1.
      <fs_car>-kostl         = <fs_map>-kostl.
      <fs_car>-imprf         = <fs_map>-imprf.
      <fs_car>-prart         = <fs_map>-prart.
      <fs_car>-bukrs         = <fs_map>-bukrs.
      <fs_car>-werks         = <fs_map>-werks.
      <fs_car>-vkokr         = <fs_map>-vkokr.
    ENDIF.
  ENDLOOP.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form submit_e1
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM submit_e1 .

  DATA: lv_reqnum  TYPE zta2r_wbshdr-zreq_num,
        lv_success TYPE abap_bool,
        lt_return  TYPE TABLE OF bapiret2,
        ls_return  TYPE bapiret2,
        lv_message TYPE string.

*---------------------------------------------------------------------*
* STEP 1 : Sync screen
*---------------------------------------------------------------------*
  PERFORM sync_screen_to_header.
  PERFORM convert_from_display.
  PERFORM append_tobe.
*  PERFORM convert_wbs_posid_to_external.

  IF go_builder IS INITIAL.
    CREATE OBJECT go_builder.
  ENDIF.

  IF gv_z_remarks IS NOT INITIAL AND gs_header-z_remarks IS INITIAL.
    gs_header-z_remarks = gv_z_remarks.
  ENDIF.

  gs_header-waers = gv_project_currency.

  IF gv_gos_reqnum IS NOT INITIAL.
    gs_header-zreq_num = gv_gos_reqnum.
  ELSE.
    CALL METHOD go_builder->get_next_request_number
      RECEIVING
        rv_reqnum = gv_gos_reqnum.

    gs_header-zreq_num = gv_gos_reqnum.
  ENDIF.

*---------------------------------------------------------------------*
* STEP 2 : SAVE E1 REQUEST
*---------------------------------------------------------------------*
  lv_reqnum = go_builder->save_request_for_submit_e1(
    is_header    = gs_header
    it_wbs_items = gt_wbs_items
    it_wbs_unclose = gt_wbs_unclose ).

  IF lv_reqnum IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Failed to create B2 request'(v15).
    RETURN.
  ENDIF.

  gs_header-zreq_num = lv_reqnum.
  gs_header-z_reqtype = 'E1'.

  " trigger WF
  PERFORM trigger_wf USING gs_header.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form append_tobe
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM append_tobe .
  DATA: ls_unclose TYPE zsa2r_wbsunclose,
        lv_posid   TYPE ps_posid.

  FIELD-SYMBOLS: <fs_item> TYPE zta2r_wbsitem.

  IF gt_wbs_unclose IS INITIAL
     OR gt_wbs_items   IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT gt_wbs_unclose INTO ls_unclose.

    lv_posid = ls_unclose-wbs_element_code.

    CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
      EXPORTING
        input  = lv_posid
      IMPORTING
        output = lv_posid.

    READ TABLE gt_wbs_items ASSIGNING <fs_item>
      WITH KEY posid = lv_posid.

    IF sy-subrc = 0.
      <fs_item>-zstat_tobe = ls_unclose-to_be.
      <fs_item>-zstat      = ls_unclose-status.
    ENDIF.

  ENDLOOP.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form validate_and_load_display_req
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM validate_and_load_display_req  USING iv_reqnum TYPE zta2r_wbshdr-zreq_num.

  "Basic check
  IF iv_reqnum IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Please enter Request Number.'(m71).
  ENDIF.

  "Read Header
  SELECT SINGLE *
    FROM zta2r_wbshdr
    INTO @DATA(ls_hdr)
    WHERE zreq_num = @iv_reqnum.

  IF sy-subrc <> 0.
    MESSAGE e000(zmsg_a2r) WITH 'Request Number Not found'(m29).
  ENDIF.

*  "Only creator can edit
*  IF ls_hdr-ernam <> sy-uname.
*    MESSAGE e000(zmsg_a2r) WITH 'You are not allowed to edit this request.'(m30).
*  ENDIF.

*  Only Draft and Rejected can edit
*  IF ls_hdr-request_status <> 'PENDING'.
*    MESSAGE e000(zmsg_a2r) WITH 'Request Number are not Pending'(m62).
*  ENDIF.

  "Reset buffers (important)
  CLEAR: gs_header.
  FREE:  gt_wbs_items, gt_wbs_display.

  "Load header to screen2 structure
  MOVE-CORRESPONDING ls_hdr TO gs_header.

  "Load items to internal table used by screen2
  SELECT *
    FROM zta2r_wbsitem
    INTO TABLE @gt_wbs_items
    WHERE zreq_num = @iv_reqnum.

  "Align your helper PERFORMs that use p_* (posnr used by IMPR reads)
  gv_p_posnr = gs_header-posnr.
  gv_p_prnam = gs_header-prnam.
  gv_p_kostl = gs_header-kostl.
  gv_p_verna = gs_header-vernr.
  gv_p_post1 = gs_header-post1.
  gv_p_prctr = gs_header-prctr.
  gv_p_plsez = gs_header-plsez.
  gv_p_profl = gs_header-profl.
  gs_header-request_status = ls_hdr-request_status.

  IF gv_p_posnr IS NOT INITIAL.

    SELECT SINGLE posnr
      FROM zta2r_wbshdr
      INTO @DATA(lv_edit_posnr)
      WHERE zreq_num = @gv_p_req_num.

    SELECT SINGLE gjahr
      FROM impr
      INTO @DATA(lv_edit_gjahr)
      WHERE posnr = @lv_edit_posnr.
  ENDIF.

  "Mark edit mode so prepare_screen2 will NOT copy template
  gv_gjahr              = lv_edit_gjahr.
  gv_edit_mode          = abap_true.
  gv_loaded_reqnum      = iv_reqnum.
  gv_header_initialized = abap_false.

  gv_req_type = ls_hdr-z_reqtype.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form tobe_validate
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM tobe_validate .

  LOOP AT gt_wbs_unclose INTO gs_wbs_unclose.
    IF gs_wbs_unclose-to_be IS NOT INITIAL.
      IF gs_wbs_unclose-to_be <> 'REL' AND gs_wbs_unclose-to_be <> 'TECO'.
        MESSAGE e000(zmsg_a2r) WITH 'To-Be Status are not REL/TECO'(v24).
        RETURN.

      ENDIF.
    ENDIF.
  ENDLOOP.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form show_workflow_log
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM show_workflow_log.

  DATA: lv_top_wi_id     TYPE sww_wiid,
        lv_top_wi_id_err TYPE sww_wiid,
        lt_wflog_err     TYPE ty_t_wflog.

  CLEAR: gt_wflog, gv_top_wi_id.

* --- Main workflow ---
  PERFORM get_top_wi_id_for_req USING    gs_header-zreq_num
                                         'ZCL_A2R_WBS_REQUEST_FLEXWF'
                                CHANGING lv_top_wi_id.

* --- Error-handling workflow ---
  PERFORM get_top_wi_id_for_req USING    gs_header-zreq_num
                                         'ZCL_A2R_WBS_REQUEST_ERR_FLEXWF'
                                CHANGING lv_top_wi_id_err.

  IF lv_top_wi_id IS INITIAL AND lv_top_wi_id_err IS INITIAL.
    RETURN.
  ENDIF.

* --- Read main workflow log ---
  IF lv_top_wi_id IS NOT INITIAL.
    gv_top_wi_id = lv_top_wi_id.
    PERFORM get_workflow_log USING    gv_top_wi_id
                             CHANGING gt_wflog.
  ENDIF.

* --- Read error workflow log and append ---
  IF lv_top_wi_id_err IS NOT INITIAL.
    gv_top_wi_id = lv_top_wi_id_err.
    CLEAR lt_wflog_err.
    PERFORM get_workflow_log USING    gv_top_wi_id
                             CHANGING lt_wflog_err.
    APPEND LINES OF lt_wflog_err TO gt_wflog.
  ENDIF.

  IF gt_wflog IS INITIAL.
    RETURN.
  ENDIF.

* --- Final sort: chronological across both workflows ---
  SORT gt_wflog BY created_on created_at wi_id.

  PERFORM display_workflow_log_popup.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form get_top_wi_id_for_req
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM get_top_wi_id_for_req USING    iv_zreq_num  TYPE zta2r_wbshdr-zreq_num
                                    iv_typeid    TYPE sibftypeid
                           CHANGING cv_top_wi_id TYPE sww_wiid.

  CLEAR cv_top_wi_id.

  SELECT top_wi_id
    FROM sww_wi2obj
    INTO @cv_top_wi_id
    UP TO 1 ROWS
   WHERE instid = @iv_zreq_num
     AND typeid = @iv_typeid
     AND catid  = 'CL'.
  ENDSELECT.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form get_workflow_log
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM get_workflow_log USING    iv_top_wi_id TYPE sww_wiid
                      CHANGING ct_wflog     TYPE ty_t_wflog.

  DATA: lt_worklist      TYPE STANDARD TABLE OF swr_wihdr,
        ls_worklist      TYPE swr_wihdr,
        lt_message_lines TYPE STANDARD TABLE OF swr_messag,
        lt_message_struc TYPE STANDARD TABLE OF swr_mstruc,
        lv_return_code   TYPE sy-subrc,
        ls_wflog         TYPE ty_wflog.

  CLEAR ct_wflog.

*---------------------------------------------------------------------*
* Read top workitem
*---------------------------------------------------------------------*
  CLEAR ls_wflog.
  PERFORM read_single_wi_log USING    iv_top_wi_id
                             CHANGING ls_wflog.

  IF ls_wflog-wi_id IS NOT INITIAL.
    APPEND ls_wflog TO ct_wflog.
  ENDIF.

*---------------------------------------------------------------------*
* Read child workitems
*---------------------------------------------------------------------*
  CALL FUNCTION 'SAP_WAPI_GET_CHILD_WORKITEMS'
    EXPORTING
      workitem_id    = iv_top_wi_id
      user           = sy-uname
      text           = abap_true
      language       = sy-langu
    IMPORTING
      return_code    = lv_return_code
    TABLES
      worklist       = lt_worklist
      message_lines  = lt_message_lines
      message_struct = lt_message_struc.

  LOOP AT lt_worklist INTO ls_worklist.

    CLEAR ls_wflog.

    PERFORM read_single_wi_log USING    ls_worklist-wi_id
                               CHANGING ls_wflog.

    IF ls_wflog-wi_id IS NOT INITIAL.
      APPEND ls_wflog TO ct_wflog.
    ENDIF.

  ENDLOOP.

  SORT ct_wflog BY wi_id.
  DELETE ADJACENT DUPLICATES FROM ct_wflog COMPARING wi_id.

  SORT ct_wflog BY created_on created_at wi_id.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form read_single_wi_log
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM read_single_wi_log USING    iv_wi_id TYPE sww_wiid
                        CHANGING cs_wflog TYPE ty_wflog.

  DATA: ls_header        TYPE swr_wihdr,
        lt_message_lines TYPE STANDARD TABLE OF swr_messag,
        lt_message_struc TYPE STANDARD TABLE OF swr_mstruc,
        lv_return_code   TYPE sy-subrc.

  CLEAR cs_wflog.

  CALL FUNCTION 'SAP_WAPI_GET_HEADER'
    EXPORTING
      workitem_id         = iv_wi_id
      user                = sy-uname
      language            = sy-langu
      translate_texts     = abap_true
    IMPORTING
      workitem_attributes = ls_header
      return_code         = lv_return_code
    TABLES
      message_lines       = lt_message_lines
      message_struct      = lt_message_struc.

  IF lv_return_code <> 0.
    RETURN.
  ENDIF.

  cs_wflog-wi_id         = ls_header-wi_id.
  cs_wflog-top_wi_id     = gv_top_wi_id.
  cs_wflog-wi_text       = ls_header-wi_text.
  cs_wflog-created_on    = ls_header-wi_cd.
  cs_wflog-created_at    = ls_header-wi_ct.
*  cs_wflog-completed_on  = ls_header-wi_led.
*  cs_wflog-completed_at  = ls_header-wi_let.

  IF ls_header-wi_aa_name IS NOT INITIAL.
    cs_wflog-agent = ls_header-wi_aa_name.
  ELSEIF ls_header-wi_aagent IS NOT INITIAL.
    cs_wflog-agent = ls_header-wi_aagent.
  ENDIF.

  IF ls_header-statustext IS NOT INITIAL.
    cs_wflog-status = ls_header-statustext.
  ELSE.
    cs_wflog-status = ls_header-wi_stat.
  ENDIF.

  CLEAR cs_wflog-comment.

*---------------------------------------------------------------------*
* Read comment only for real human approval workitems
*---------------------------------------------------------------------*
  IF cs_wflog-wi_text CP 'WBS Approval*'
     AND cs_wflog-agent IS NOT INITIAL
     AND cs_wflog-agent NS 'IF On-prem'
     AND cs_wflog-agent NS 'Workflow'
     AND cs_wflog-agent NS 'RFC'
     AND cs_wflog-agent NS 'S/4HANA'.

    PERFORM get_wi_comment USING    iv_wi_id
                           CHANGING cs_wflog-comment.
  ENDIF.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form get_wi_comment
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM get_wi_comment USING    iv_wi_id     TYPE sww_wiid
                    CHANGING cv_comment   TYPE string.

  DATA: lt_attachments   TYPE STANDARD TABLE OF swr_object,
        ls_attachment    TYPE swr_object,
        lt_message_lines TYPE STANDARD TABLE OF swr_messag,
        lt_message_struc TYPE STANDARD TABLE OF swr_mstruc,
        lv_return_code   TYPE sy-subrc.

  DATA: lt_objcont TYPE STANDARD TABLE OF soli,
        ls_objcont TYPE soli,
        lt_objhead TYPE STANDARD TABLE OF soli,
        lv_text    TYPE string,
        lv_doc_id  TYPE sofolenti1-doc_id.

  DATA: lt_parts TYPE STANDARD TABLE OF string,
        lv_part  TYPE string.

  DATA: ls_filter        TYPE sofilteri1.

  CLEAR: cv_comment,
         lt_attachments,
         lt_message_lines,
         lt_message_struc,
         ls_filter.

*---------------------------------------------------------------------*
* Get only comment-semantic attachments
*---------------------------------------------------------------------*
  CALL FUNCTION 'SAP_WAPI_GET_ATTACHMENTS'
    EXPORTING
      workitem_id           = iv_wi_id
      user                  = sy-uname
      language              = sy-langu
      comment_semantic_only = 'X'
    IMPORTING
      return_code           = lv_return_code
    TABLES
      attachments           = lt_attachments
      message_lines         = lt_message_lines
      message_struct        = lt_message_struc.

  IF lv_return_code <> 0 OR lt_attachments IS INITIAL.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* Read all "Approver Comments" attachments and keep the latest
*---------------------------------------------------------------------*
  LOOP AT lt_attachments INTO ls_attachment
    WHERE def_attrib = 'Approver Comments'
       OR object_typ = 'CM'.

    CLEAR: lt_parts, lv_part, lv_doc_id, lt_objhead, lt_objcont, lv_text.

*-------------------------------------------------------------------*
* OBJECT_ID format:
* SOFM      FOL50000000000004RAW51000000055075
* Need the 2nd token only
*-------------------------------------------------------------------*
    SPLIT ls_attachment-object_id AT space INTO TABLE lt_parts.
    DELETE lt_parts WHERE table_line IS INITIAL.

    READ TABLE lt_parts INTO lv_part INDEX 2.
    IF sy-subrc <> 0 OR lv_part IS INITIAL.
      CONTINUE.
    ENDIF.

    lv_doc_id = lv_part.

*-------------------------------------------------------------------*
* Read SAPoffice document text
*-------------------------------------------------------------------*
    ls_filter-send_info  = space.
    ls_filter-no_content = space.
    ls_filter-rec_list   = space.

    CALL FUNCTION 'SO_DOCUMENT_READ_API1'
      EXPORTING
        document_id                = lv_doc_id
        filter                     = ls_filter
      TABLES
        object_header              = lt_objhead
        object_content             = lt_objcont
      EXCEPTIONS
        document_id_not_exist      = 1
        operation_no_authorization = 2
        x_error                    = 3
        OTHERS                     = 4.

    IF sy-subrc <> 0 OR lt_objcont IS INITIAL.
      CONTINUE.
    ENDIF.

*-------------------------------------------------------------------*
* Build text for this attachment
*-------------------------------------------------------------------*
    LOOP AT lt_objcont INTO ls_objcont.
      IF ls_objcont-line IS INITIAL.
        CONTINUE.
      ENDIF.

      IF lv_text IS INITIAL.
        lv_text = ls_objcont-line.
      ELSE.
        CONCATENATE lv_text ls_objcont-line
          INTO lv_text
          SEPARATED BY cl_abap_char_utilities=>newline.
      ENDIF.
    ENDLOOP.

*-------------------------------------------------------------------*
* Keep the latest non-initial comment
* Since loop continues, later attachment overwrites older one
*-------------------------------------------------------------------*
    IF lv_text IS NOT INITIAL.
      cv_comment = lv_text.
    ENDIF.

  ENDLOOP.

ENDFORM.

