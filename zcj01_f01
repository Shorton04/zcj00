*&---------------------------------------------------------------------*
*& Form f_auto_approve
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM f_auto_approve CHANGING cv_error TYPE c .

  CASE gv_req_type.
    WHEN 'B1'.   "CAR

      go_builder->create_car_wbs_b1(
        EXPORTING
          is_header     = gs_header
          it_wbs_items  = gt_wbs_items
          it_wbs_car    = gt_wbs_car
          it_phris_hier = gt_phris_hier
        IMPORTING
          rv_success    = DATA(lv_response)
      ).

    WHEN 'B2'.   "Budget Distribution
      lv_response = go_builder->budget_distribution( is_header = gs_header ).

    WHEN 'B3'.   "Critical Changes
      lv_response = go_builder->crit_change( is_header = gs_header ).

    WHEN 'A1'. "Project Creation
      lv_response = go_builder->create_project_cj20n(
        EXPORTING
          is_header = gs_header
      ).
      IF lv_response EQ abap_true.
        UPDATE zta2r_wbshdr
          SET request_status       = 'APPROVED'
              zapproved_by         = sy-uname
              zrequest_approved_on = sy-datum
         WHERE zreq_num = gs_header-zreq_num.

        CLEAR lv_response.
      ENDIF.


    WHEN 'E1'. "Project Creation
      lv_response = go_builder->unclose_wbs_status( it_wbs_unclose = gt_wbs_unclose
                                                    iv_req_num     = gs_header-zreq_num ).


    WHEN OTHERS.
      CLEAR lv_response.
  ENDCASE.

  cv_error = lv_response.

  IF lv_response EQ abap_true.
    PERFORM f_update_tab_wbshdr.
    CLEAR lv_response.
  ENDIF.

ENDFORM.

