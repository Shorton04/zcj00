*&---------------------------------------------------------------------*
*& Form text_editor
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM text_editor .

  CHECK sy-batch IS INITIAL AND sy-binpt IS INITIAL.

  IF go_editor IS INITIAL.
    CREATE OBJECT go_editor
      EXPORTING
        repid                      = sy-repid
        dynnr                      = sy-dynnr
        dynpro_container           = 'REMARKS'
        wordwrap_mode              = 2
        wordwrap_position          = 72
        wordwrap_to_linebreak_mode = 1.
  ENDIF.

  CHECK go_editor IS BOUND.

  IF lines( gt_text ) = gv_rlines AND NOT gt_text IS INITIAL.
    APPEND INITIAL LINE TO gt_text.
  ENDIF.
  CALL METHOD go_editor->set_text_as_r3table
    EXPORTING
      table = gt_text.

  IF NOT gt_text IS INITIAL AND NOT gv_rlines IS INITIAL.
    CALL METHOD go_editor->select_lines
      EXPORTING
        from_line = 1
        to_line   = gv_rlines.
    CALL METHOD go_editor->protect_selection
      EXPORTING
        protect_mode = 1.
    CALL METHOD go_editor->set_selection_pos_in_line
      EXPORTING
        line                   = ( gv_rlines + 1 )
        pos                    = 0
      EXCEPTIONS
        error_cntl_call_method = 1
        OTHERS                 = 2.
    IF sy-subrc <> 0.
      CLEAR gt_text.
    ENDIF.
  ENDIF.

  "----- Statusbar
  CALL METHOD go_editor->set_statusbar_mode
    EXPORTING
      statusbar_mode = 1.

  "---- Toolbar
  CALL METHOD go_editor->set_toolbar_mode
    EXPORTING
      toolbar_mode = 1.

  "---- Visibililty
  IF NOT gv_dflag IS INITIAL.
    CALL METHOD go_editor->set_readonly_mode
      EXPORTING
        readonly_mode          = 1
      EXCEPTIONS
        error_cntl_call_method = 1
        invalid_parameter      = 2
        OTHERS                 = 3.
    IF sy-subrc <> 0.
      CLEAR gv_dflag.
    ENDIF.
  ENDIF.

  CALL METHOD go_editor->flush.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form get_text
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM get_text.

  DATA: gv_remarks TYPE zta2r_wbshdr-z_remarks.

  CHECK sy-batch IS INITIAL AND sy-binpt IS INITIAL.

  CLEAR: gs_text, gt_text.

  IF gv_reqnum_text IS NOT INITIAL.
    gs_header-zreq_num = gv_reqnum_text.
  ENDIF.

  IF gs_header-zreq_num = 0 OR gs_header-zreq_num IS INITIAL.
    IF go_builder IS INITIAL.
      "if you normally create it elsewhere, keep this defensive guard
      CREATE OBJECT go_builder.  "adjust constructor if needed

      CALL METHOD go_builder->get_next_request_number
        RECEIVING
          rv_reqnum = gv_request_number.

      gs_header-zreq_num = gv_request_number.
    ENDIF.

  ENDIF.

*---------------------------------------------------------------------*
* DISPLAY REQUEST MODE
*---------------------------------------------------------------------*
  IF gv_disp_req = abap_true.

    SELECT SINGLE z_remarks
      INTO gv_remarks
      FROM zta2r_wbshdr
      WHERE zreq_num = gs_header-zreq_num.

    IF sy-subrc = 0 AND gv_remarks IS NOT INITIAL.
      CLEAR gs_text.
      gs_text-text = gv_remarks.
      APPEND gs_text TO gt_text.
    ENDIF.

    CALL METHOD go_editor->set_text_as_r3table
      EXPORTING
        table = gt_text.

*--- statusbar in text-control
    CALL METHOD go_editor->set_statusbar_mode
      EXPORTING
        statusbar_mode = 1.

*--- toolbar in text-control
    CALL METHOD go_editor->set_toolbar_mode
      EXPORTING
        toolbar_mode = 1.

*--- display only
    CALL METHOD go_editor->set_readonly_mode
      EXPORTING
        readonly_mode          = 1
      EXCEPTIONS
        error_cntl_call_method = 1
        invalid_parameter      = 2
        OTHERS                 = 3.

    IF sy-subrc <> 0.
      RETURN.

    ENDIF.

    CALL METHOD go_editor->flush.

    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* INPUT / EDIT MODE
*---------------------------------------------------------------------*
  CALL METHOD go_editor->get_text_as_r3table
    IMPORTING
      table = gt_text.

*--- statusbar in text-control
  CALL METHOD go_editor->set_statusbar_mode
    EXPORTING
      statusbar_mode = 1.

*--- toolbar in text-control
  CALL METHOD go_editor->set_toolbar_mode
    EXPORTING
      toolbar_mode = 1.

  CALL METHOD go_editor->flush.

  CLEAR gv_z_remarks.

  LOOP AT gt_text INTO gs_text.
    IF gv_z_remarks IS INITIAL.
      gv_z_remarks = gs_text-text.
    ELSE.
      CONCATENATE gv_z_remarks
                  gs_text-text
             INTO gv_z_remarks
        SEPARATED BY cl_abap_char_utilities=>newline.
    ENDIF.
  ENDLOOP.

  gs_header-z_remarks = gv_z_remarks.

*---------------------------------------------------------------------*
* Additional Lines Check
*---------------------------------------------------------------------*
  IF lines( gt_text ) > gv_rlines.
    READ TABLE gt_text INTO gs_text INDEX ( gv_rlines + 1 ).
    IF gs_text IS INITIAL.
      DELETE gt_text INDEX ( gv_rlines + 1 ).
    ENDIF.
  ENDIF.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form get_user_fullname
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM get_user_fullname USING    iv_uname      TYPE xubname
                       CHANGING cv_fullname   TYPE char50.

  DATA:lv_datefrom TYPE ad_date_fr,
       lv_nation   TYPE ad_nation.


  CLEAR cv_fullname.

  " Get person number from username
  SELECT SINGLE bname, persnumber
    FROM usr21
    INTO @DATA(ls_usr21)
    WHERE bname = @iv_uname.

  IF ls_usr21-persnumber IS NOT INITIAL.
    " Get full name from address data
    SELECT SINGLE persnumber, name_first, name_last
      FROM adrp
      INTO @DATA(ls_adrp)
      WHERE persnumber = @ls_usr21-persnumber
      AND   date_from = @lv_datefrom
      AND   nation    = @lv_nation.

    " Build full name: First Name Last Name
    IF ls_adrp-name_first IS NOT INITIAL
      OR ls_adrp-name_last IS NOT INITIAL.

      CONCATENATE ls_adrp-name_first ls_adrp-name_last
        INTO cv_fullname
        SEPARATED BY space. CONDENSE cv_fullname.

    ELSE.
      " Fallback to username if no name found
      cv_fullname = iv_uname.
    ENDIF.

  ELSE.
    " If user not found, use username
    cv_fullname = iv_uname.
  ENDIF.
ENDFORM.

