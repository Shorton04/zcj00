*&---------------------------------------------------------------------*
*& Form submit_b1
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM submit_b1 .
  DATA:
    lv_reqnum        TYPE zta2r_wbshdr-zreq_num,
    lv_success       TYPE abap_bool,
    lt_return        TYPE STANDARD TABLE OF bapiret2,
    lv_error         TYPE abap_bool,
    lv_auto          TYPE char1,
    lv_error_handler TYPE char8.

  CLEAR: gt_l1_approvers, gt_l2_approvers.

  "STEP 1: Sync + convert
  PERFORM sync_screen_to_header.
  PERFORM convert_from_display.
  PERFORM populate_gt_wbs_car_wert2.

  "Ensure builder exists ONLY if we will call it
  IF go_builder IS INITIAL.
    CREATE OBJECT go_builder. "adjust if constructor requires params
  ENDIF.

  IF gv_req_type = 'B1'.
    gs_header-z_reqtype = 'B1'.
  ENDIF.

  IF gv_gos_reqnum IS NOT INITIAL.
    gs_header-zreq_num = gv_gos_reqnum.
  ENDIF.

  IF gv_z_remarks IS NOT INITIAL AND gs_header-z_remarks IS INITIAL.
    gs_header-z_remarks = gv_z_remarks.
  ENDIF.

  "Create mode: use your existing builder method
  lv_reqnum = go_builder->save_request_for_submit(
    is_header    = gs_header
    it_wbs_items = gt_wbs_items
  ).

*  go_builder->clear_left_if_zero(
*    CHANGING
*      ct_wbs_items = gt_wbs_items
*      ct_phris_hier = gt_phris_hier
*    ).

  IF lv_reqnum IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Failed to save request before submit'(m13).
    RETURN.
  ENDIF.

  gs_header-zreq_num = lv_reqnum.

  "STEP 3: Set PENDING
  UPDATE zta2r_wbshdr
    SET request_status = 'PENDING'
    WHERE zreq_num = @lv_reqnum.

  IF sy-subrc <> 0.
    MESSAGE e000(zmsg_a2r) WITH 'Failed to update status for'(m03) lv_reqnum.
    RETURN.
  ENDIF.

  COMMIT WORK AND WAIT.
  gs_header-request_status = 'PENDING'.
  gs_header-zreq_num = lv_reqnum.
  gs_header-z_reqtype = 'B1'.

  " trigger WF approval process
  PERFORM trigger_wf USING gs_header.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form prepare_screen2_b1
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM prepare_screen2_b1 .
  DATA: lv_error    TYPE abap_bool,
        ls_esr_root TYPE zta2r_wbsitem,
        lv_esr_root TYPE zta2r_wbsitem-posid.

  "Always get IM data (safe, doesn't overwrite screen2 edits)
  PERFORM get_additional_im_data USING gv_p_posnr.

  "Initialize screen2 ONCE only
  IF gv_header_initialized = abap_true.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "FIRST ENTRY ONLY
  "------------------------------------------------------------

  "=============================
  "EDIT SAVED REQUEST (F1)
  "=============================
  IF gv_edit_mode = abap_true.

    IF gv_req_type = 'B1'.
      IF go_builder IS INITIAL.
        CREATE OBJECT go_builder.
      ENDIF.

      "CAR
      CALL METHOD go_builder->append_car_template
        EXPORTING
          iv_pspid_car = gv_p_pspid_car
          iv_kostl     = gv_p_kostl
        CHANGING
          ct_wbs_items = gt_wbs_items
          ct_wbs_car   = gt_wbs_car.

      READ TABLE gt_wbs_items INTO ls_esr_root WITH KEY stufe = 1.
      IF sy-subrc = 0.
        REPLACE ALL OCCURRENCES OF '.' IN ls_esr_root-posid WITH ''.
        lv_esr_root = ls_esr_root-posid.
      ENDIF.

      CALL METHOD go_builder->build_phris_hierarchy
        EXPORTING
          iv_pspid_car  = gv_p_pspid_car
          iv_esr_root   = lv_esr_root
          it_wbs_car    = gt_wbs_car
        IMPORTING
          et_phris_hier = gt_phris_hier.
    ENDIF.

    "At this point, caller already loaded:
    " - gs_header from zta2r_WBSHDR
    " - gt_wbs_items from zta2r_WBSITEM
    "So DO NOT rebuild anything from template.
*    PERFORM refresh_gt_wbs_items_from_db USING gv_loaded_reqnum.

    PERFORM convert_to_display.
    PERFORM set_wbs_default_values.  "only fills INITIAL values (safe)

    "IMPORTANT: Do NOT call populate_header_structure in edit mode
    "because it may overwrite DB header values (erdat/ernam etc.)

    gv_header_initialized = abap_true.
    RETURN.

  ENDIF.

  "=============================
  "CREATE MODE (A1)
  "=============================

  " Build WBS items in correct PRHIS order
  CLEAR gt_wbs_items.
  CALL METHOD go_builder->copy_template_structure
    EXPORTING
      iv_pspid     = gv_p_pspid
      iv_kostl     = gv_p_kostl
    CHANGING
      ct_wbs_items = gt_wbs_items.

  PERFORM convert_to_display.
  PERFORM set_wbs_default_values.
  PERFORM populate_header_structure.
  PERFORM validate_approver_matrix
    CHANGING lv_error.


  gv_header_initialized = abap_true.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form trigger_wf
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM trigger_wf  USING is_header TYPE zta2r_wbshdr.
  DATA lv_wferror TYPE c.

  go_builder->check_approver_matrix(
    EXPORTING
      iv_bukrs        = is_header-bukrs
      iv_profl        = is_header-profl
      iv_reqtype      = is_header-z_reqtype
    IMPORTING
      ev_auto         = DATA(lv_auto)
      ev_found        = DATA(lv_found)
      et_l1_approvers = DATA(lt_l1_approvers)
      et_l2_approvers = DATA(lt_l2_approvers)
      et_l3_approvers = DATA(lt_l3_approvers)
  ).

  IF lv_found EQ abap_true.

    IF lv_auto = abap_true.
      PERFORM f_auto_approve CHANGING lv_wferror.
    ENDIF.

    go_builder->trigger_workflow(
      is_header     = is_header
      iv_auto       = lv_auto
      iv_wferror    = lv_wferror
      it_l1_apprv   = lt_l1_approvers
      it_l2_apprv   = lt_l2_approvers
      it_l3_apprv   = lt_l3_approvers
      it_wbscar     = gt_wbs_car
      it_wbshier    = gt_phris_hier
      it_wbsunclose = gt_wbs_unclose
    ).

    IF lv_auto = abap_true.
      MESSAGE s000(zmsg_a2r) WITH 'Request'(m14) is_header-zreq_num
             'submitted and auto approved'(t01).
    ELSE.
      MESSAGE s000(zmsg_a2r) WITH 'Request'(m14) is_header-zreq_num
             'submitted for approval'(m06).
    ENDIF.

    LEAVE TO SCREEN 0.

  ELSE.
    MESSAGE s000(zmsg_a2r) WITH 'No approver configuration found for'(m08)
                                 is_header-zreq_num.
    LEAVE TO SCREEN 0.
  ENDIF.

ENDFORM.

