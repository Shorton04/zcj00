*&---------------------------------------------------------------------*
*& Form get_raw_data
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*&      --> gv_p_pspid_PROJ
*&---------------------------------------------------------------------*
FORM get_raw_data
  USING iv_pspid_proj TYPE zta2r_wbshdr-pspid.

  "------------------------------------------------------------
  " Local Types
  "------------------------------------------------------------
  TYPES: BEGIN OF ty_proj,
           pspnr TYPE proj-pspnr,
           post1 TYPE proj-post1,
           ernam TYPE proj-ernam,
           erdat TYPE proj-erdat,
           vernr TYPE proj-vernr,
           vbukr TYPE proj-vbukr,
           vkokr TYPE proj-vkokr,
           prctr TYPE proj-prctr,
           plsez TYPE proj-plsez,
           werks TYPE proj-werks,
           profl TYPE proj-profl,
           kostl TYPE proj-kostl,
         END OF ty_proj.

  TYPES: BEGIN OF ty_prps,
           posid         TYPE prps-posid,
           post1         TYPE prps-post1,
           objnr         TYPE prps-objnr,
           pbukr         TYPE prps-pbukr,
           pkokr         TYPE prps-pkokr,
           fkstl         TYPE prps-fkstl,
           werks         TYPE prps-werks,
           stufe         TYPE prps-stufe,
           usr10         TYPE prps-usr10,
           zunifier_proj TYPE prps-zunifier_proj,
         END OF ty_prps.

  TYPES: BEGIN OF ty_objnr,
           objnr TYPE bpge-objnr,
         END OF ty_objnr.

  TYPES: BEGIN OF ty_posid,
           posid TYPE v_ivp_pr-posid,
         END OF ty_posid.

  TYPES: BEGIN OF ty_posnr,
           posnr TYPE impr-posnr,
         END OF ty_posnr.

  TYPES: BEGIN OF ty_bpge_lednr,
           objnr TYPE bpge-objnr,
           lednr TYPE bpge-lednr,
         END OF ty_bpge_lednr.

  TYPES: BEGIN OF ty_bpge_wert2,
           objnr TYPE bpge-objnr,
           wtges TYPE bpge-wtges,
         END OF ty_bpge_wert2.

  TYPES: BEGIN OF ty_bpge_geber,
           objnr TYPE bpge-objnr,
           geber TYPE bpge-geber,
         END OF ty_bpge_geber.

  TYPES: BEGIN OF ty_ivp_pr,
           posid TYPE v_ivp_pr-posid,
           prnam TYPE v_ivp_pr-prnam,
           gjahr TYPE v_ivp_pr-gjahr,
           posnr TYPE v_ivp_pr-posnr,
           prart TYPE v_ivp_pr-prart,
         END OF ty_ivp_pr.

  TYPES: BEGIN OF ty_impr,
           posnr TYPE impr-posnr,
           izwek TYPE impr-izwek,
         END OF ty_impr.

  "------------------------------------------------------------
  " Local Data
  "------------------------------------------------------------
  DATA: ls_proj TYPE ty_proj.

  DATA: lt_prps TYPE STANDARD TABLE OF ty_prps,
        ls_prps TYPE ty_prps.

  DATA: lt_objnr TYPE SORTED TABLE OF ty_objnr
                  WITH UNIQUE KEY objnr,
        lt_posid TYPE SORTED TABLE OF ty_posid
                  WITH UNIQUE KEY posid,
        lt_posnr TYPE SORTED TABLE OF ty_posnr
                  WITH UNIQUE KEY posnr.

  DATA: lt_max_kstp   TYPE HASHED TABLE OF ty_bpge_lednr
                     WITH UNIQUE KEY objnr,
        lt_wert2      TYPE HASHED TABLE OF ty_bpge_wert2
                   WITH UNIQUE KEY objnr,
        lt_max_kbud   TYPE HASHED TABLE OF ty_bpge_lednr
                     WITH UNIQUE KEY objnr,
        lt_geber_kbud TYPE HASHED TABLE OF ty_bpge_geber
                       WITH UNIQUE KEY objnr.

  DATA: lt_ivp_pr_raw TYPE STANDARD TABLE OF ty_ivp_pr,
        lt_ivp_pr     TYPE HASHED TABLE OF ty_ivp_pr
                    WITH UNIQUE KEY posid.

  DATA: lt_impr TYPE HASHED TABLE OF ty_impr
                 WITH UNIQUE KEY posnr.

  DATA: lt_max_kstp_raw TYPE STANDARD TABLE OF ty_bpge_lednr,
        lt_max_kbud_raw TYPE STANDARD TABLE OF ty_bpge_lednr,
        lt_wert2_raw    TYPE STANDARD TABLE OF ty_bpge_wert2,
        lt_geber_raw    TYPE STANDARD TABLE OF ty_bpge_geber,
        lt_impr_raw     TYPE STANDARD TABLE OF ty_impr.

  FIELD-SYMBOLS:
    <fs_item>   TYPE zta2r_wbsitem,
    <fs_wert2>  TYPE ty_bpge_wert2,
    <fs_ivp_pr> TYPE ty_ivp_pr,
    <fs_impr>   TYPE ty_impr.

  CLEAR: gs_header,
         gt_wbs_items.

  "------------------------------------------------------------
  " 1) Read PROJ Header
  "------------------------------------------------------------
  SELECT SINGLE
         pspnr
         post1
         ernam
         erdat
         vernr
         vbukr
         vkokr
         prctr
         plsez
         werks
         profl
         kostl
    INTO ls_proj
    FROM proj
   WHERE pspid = iv_pspid_proj.

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  gs_header-mandt = sy-mandt.
  gs_header-pspnr = ls_proj-pspnr.
  gs_header-post1 = ls_proj-post1.
  gs_header-ernam = ls_proj-ernam.
  gs_header-erdat = ls_proj-erdat.
  gs_header-vernr = ls_proj-vernr.
  gs_header-bukrs = ls_proj-vbukr.
  gs_header-vkokr = ls_proj-vkokr.
  gs_header-prctr = ls_proj-prctr.
  gs_header-plsez = ls_proj-plsez.
  gs_header-werks = ls_proj-werks.
  gs_header-profl = ls_proj-profl.
  gs_header-kostl = ls_proj-kostl.

  "------------------------------------------------------------
  " 2) Read PRPS Items
  "------------------------------------------------------------
  SELECT
         posid
         post1
         objnr
         pbukr
         pkokr
         fkstl
         werks
         stufe
         usr10
         zunifier_proj
    INTO TABLE lt_prps
    FROM prps
   WHERE psphi = ls_proj-pspnr.

  SORT lt_prps BY posid.

  IF lt_prps IS INITIAL.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " Build helper tables
  "------------------------------------------------------------
  LOOP AT lt_prps INTO ls_prps.

    IF ls_prps-stufe = 1.
      gs_header-usr10 = ls_prps-usr10.
    ENDIF.

    INSERT VALUE #( objnr = ls_prps-objnr )
      INTO TABLE lt_objnr.

    INSERT VALUE #( posid = ls_prps-posid )
      INTO TABLE lt_posid.

  ENDLOOP.

  "------------------------------------------------------------
  " 4) BPGE KSTP -> WERT2
  " Highest LEDNR only (no SUM)
  "------------------------------------------------------------
  IF lt_objnr IS NOT INITIAL.

    CLEAR lt_max_kstp_raw.

    SELECT
           objnr
           lednr
      INTO TABLE lt_max_kstp_raw
      FROM bpge
      FOR ALL ENTRIES IN lt_objnr
     WHERE objnr = lt_objnr-objnr
       AND vorga = 'KSTP'.

    SORT lt_max_kstp_raw BY objnr lednr DESCENDING.
    DELETE ADJACENT DUPLICATES FROM lt_max_kstp_raw COMPARING objnr.
    .

    lt_max_kstp = CORRESPONDING #( lt_max_kstp_raw ).

    IF lt_max_kstp IS NOT INITIAL.

      SELECT
             a~objnr,
             a~wtges
        FROM bpge AS a
        INNER JOIN @lt_max_kstp AS b
           ON a~objnr = b~objnr
          AND a~lednr = b~lednr
       WHERE a~vorga = 'KSTP'
        INTO TABLE @lt_wert2_raw.

      SORT lt_wert2_raw BY objnr.

      LOOP AT lt_wert2_raw INTO DATA(ls_wert2_raw).

        READ TABLE lt_wert2
          WITH TABLE KEY objnr = ls_wert2_raw-objnr
          TRANSPORTING NO FIELDS.

        IF sy-subrc <> 0.
          INSERT VALUE #(
            objnr = ls_wert2_raw-objnr
            wtges = ls_wert2_raw-wtges
          ) INTO TABLE lt_wert2.
        ENDIF.

      ENDLOOP.

    ENDIF.

    "----------------------------------------------------------
    " 5) BPGE KBUD -> GEBER
    "----------------------------------------------------------
    CLEAR lt_max_kbud_raw.

    SELECT
           objnr
           lednr
      INTO TABLE lt_max_kbud_raw
      FROM bpge
      FOR ALL ENTRIES IN lt_objnr
     WHERE objnr = lt_objnr-objnr
       AND vorga = 'KBUD'
       AND geber <> ''.

    SORT lt_max_kbud_raw BY objnr lednr DESCENDING.
    DELETE ADJACENT DUPLICATES FROM lt_max_kbud_raw COMPARING objnr.

    lt_max_kbud = CORRESPONDING #( lt_max_kbud_raw ).

    IF lt_max_kbud IS NOT INITIAL.

      SELECT
             a~objnr,
             MAX( a~geber ) AS geber
        FROM bpge AS a
        INNER JOIN @lt_max_kbud AS b
           ON a~objnr = b~objnr
          AND a~lednr = b~lednr
       WHERE a~vorga = 'KBUD'
         AND a~geber <> ''
       GROUP BY a~objnr
        INTO TABLE @lt_geber_raw.

      lt_geber_kbud = CORRESPONDING #( lt_geber_raw ).

    ENDIF.

  ENDIF.

  "------------------------------------------------------------
  " 6) V_IVP_PR
  " No MAX(GJAHR), keep first only
  "------------------------------------------------------------
  IF lt_posid IS NOT INITIAL.

    SELECT
           posid
           prnam
           gjahr
           posnr
           prart
      INTO TABLE lt_ivp_pr_raw
      FROM v_ivp_pr
      FOR ALL ENTRIES IN lt_posid
     WHERE posid = lt_posid-posid.

    SORT lt_ivp_pr_raw BY posid gjahr posnr.

    LOOP AT lt_ivp_pr_raw INTO DATA(ls_ivp_raw).

      READ TABLE lt_ivp_pr
        WITH TABLE KEY posid = ls_ivp_raw-posid
        TRANSPORTING NO FIELDS.

      IF sy-subrc <> 0.

        INSERT ls_ivp_raw
          INTO TABLE lt_ivp_pr.

        INSERT VALUE #( posnr = ls_ivp_raw-posnr )
          INTO TABLE lt_posnr.

      ENDIF.

    ENDLOOP.

  ENDIF.

  "------------------------------------------------------------
  " 7) IMPR -> IZWEK
  "------------------------------------------------------------
  IF lt_posnr IS NOT INITIAL.

    SELECT
           posnr
           izwek
      INTO TABLE lt_impr_raw
      FROM impr
      FOR ALL ENTRIES IN lt_posnr
     WHERE posnr = lt_posnr-posnr.

    lt_impr = CORRESPONDING #( lt_impr_raw ).

  ENDIF.

  "------------------------------------------------------------
  " 3) Populate gt_wbs_items
  "------------------------------------------------------------
  LOOP AT lt_prps INTO ls_prps.

    APPEND INITIAL LINE TO gt_wbs_items ASSIGNING <fs_item>.

    <fs_item>-mandt = sy-mandt.
    <fs_item>-pspid = iv_pspid_proj.
    <fs_item>-posid = ls_prps-posid.
    <fs_item>-post1 = ls_prps-post1.
    <fs_item>-bukrs = ls_prps-pbukr.
    <fs_item>-vkokr = ls_prps-pkokr.
    <fs_item>-stufe = ls_prps-stufe.
    <fs_item>-werks = ls_prps-werks.

    IF gs_header-zunifier_proj IS INITIAL
       AND ls_prps-zunifier_proj IS NOT INITIAL.
      gs_header-zunifier_proj = ls_prps-zunifier_proj.
    ENDIF.


    READ TABLE lt_wert2 ASSIGNING <fs_wert2>
      WITH TABLE KEY objnr = ls_prps-objnr.

    IF sy-subrc = 0.
      <fs_item>-wert2 = <fs_wert2>-wtges.
    ENDIF.

    READ TABLE lt_ivp_pr ASSIGNING <fs_ivp_pr>
      WITH TABLE KEY posid = ls_prps-posid.

    IF sy-subrc = 0.

      <fs_item>-gjahr = <fs_ivp_pr>-gjahr.
      <fs_item>-prart = <fs_ivp_pr>-prart.

      IF gs_header-prnam IS INITIAL.
        gs_header-prnam = <fs_ivp_pr>-prnam.
      ENDIF.

      IF gs_header-gjahr IS INITIAL.
        gs_header-gjahr = <fs_ivp_pr>-gjahr.
      ENDIF.

      IF gs_header-posnr IS INITIAL.
        gs_header-posnr = <fs_ivp_pr>-posnr.
      ENDIF.

      IF gs_header-izwek IS INITIAL.

        READ TABLE lt_impr ASSIGNING <fs_impr>
          WITH TABLE KEY posnr = <fs_ivp_pr>-posnr.

        IF sy-subrc = 0.
          gs_header-izwek = <fs_impr>-izwek.
        ENDIF.

      ENDIF.

    ENDIF.

  ENDLOOP.

ENDFORM.
*&---------------------------------------------------------------------*
*& Form get_raw
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*&      --> gv_p_pspid_CAR
*&---------------------------------------------------------------------*
FORM get_raw  USING    iv_pspid TYPE zta2r_wbshdr-pspid.

  DATA: lv_psphi TYPE prps-psphi,
        lv_kostl TYPE zta2r_wbsitem-kostl,
        lv_prart TYPE zta2r_wbsitem-prart.

  lv_psphi = iv_pspid.

  SELECT SINGLE pspnr, pspid, post1, ernam, erdat, vernr, vbukr, vkokr, prctr, plsez, werks, profl, kostl, pwhie
    FROM proj
    INTO @DATA(ls_hdr)
    WHERE pspid = @iv_pspid.

  IF sy-subrc <> 0.
    MESSAGE e000(zmsg_a2r) WITH 'Please enter valid project'(m54).
  ENDIF.

  SELECT SINGLE prnam, gjahr, posnr
    FROM v_ivp_pr
    INTO @DATA(ls_ivp)
    WHERE posid = @iv_pspid.

  IF sy-subrc = 0.
    gs_header-pspnr = ls_hdr-pspnr.
    gs_header-pspid = ls_hdr-pspid.
    gs_header-post1 = ls_hdr-post1.
    gs_header-ernam = sy-uname.
    gs_header-erdat = sy-datum.
    gs_header-vernr = ls_hdr-vernr.
    gs_header-bukrs = ls_hdr-vbukr.
    gs_header-vkokr = ls_hdr-vkokr.
    gs_header-prctr = ls_hdr-prctr.
    gs_header-plsez = ls_hdr-plsez.
    gs_header-werks = ls_hdr-werks.
    gs_header-profl = ls_hdr-profl.
    gs_header-prctr = ls_hdr-prctr.
    gs_header-prnam = ls_ivp-prnam.
    gs_header-gjahr = ls_ivp-gjahr.
    gs_header-posnr = ls_ivp-posnr.
    gs_header-kostl = ls_hdr-kostl.
    gs_header-waers = ls_hdr-pwhie.
    gs_header-z_reqtype = gv_req_type.
    gs_header-pspid = iv_pspid.
  ELSE.
    MESSAGE e000(zmsg_a2r) WITH 'Project not assigned to any IM'(m74).
  ENDIF.


  DATA:
*      lt_prps TYPE SORTED TABLE OF prps
*                WITH UNIQUE KEY posid,
        lt_bpge TYPE STANDARD TABLE OF bpge.

  DATA: lr_posid TYPE RANGE OF prps-posid.

  FIELD-SYMBOLS:
    <fs_wbs_item> TYPE zta2r_wbsitem.

  "------------------------------------------------------------
  " Build range using POSID from GT_WBS_ITEMS
  "------------------------------------------------------------
  LOOP AT gt_wbs_items ASSIGNING <fs_wbs_item>.

    IF <fs_wbs_item>-posid IS NOT INITIAL.
      APPEND VALUE #(
        sign   = 'I'
        option = 'EQ'
        low    = <fs_wbs_item>-posid
      ) TO lr_posid.
    ENDIF.

  ENDLOOP.

  SORT lr_posid BY low.
  DELETE ADJACENT DUPLICATES FROM lr_posid COMPARING low.

  "------------------------------------------------------------
  " Read PRPS for:
  " - ZUNIFIER_PROJ
  " - OBJNR (needed for BPGE)
  "------------------------------------------------------------
  IF lr_posid IS NOT INITIAL.

    SELECT pspnr,
           posid,
           post1,
           objnr,
           prart,
           imprf,
           fkstl,
           zunifier_proj
      FROM prps
      INTO TABLE @DATA(lt_prps)
      WHERE posid IN @lr_posid.

    SORT lt_prps BY posid.

  ENDIF.

  "------------------------------------------------------------
  " Read BPGE using OBJNR from PRPS
  " Need max LEDNR where GEBER is not initial
  "------------------------------------------------------------
  IF lt_prps IS NOT INITIAL.

    SELECT objnr, lednr, wtges
      FROM bpge
      FOR ALL ENTRIES IN @lt_prps
      WHERE objnr = @lt_prps-objnr
        AND vorga = 'KSTP'
      INTO TABLE @DATA(lt_budget).

    SELECT objnr,
           lednr,
           geber
      FROM bpge
      FOR ALL ENTRIES IN @lt_prps
      WHERE objnr = @lt_prps-objnr
        AND vorga = 'KBUD'
        AND geber IS NOT INITIAL
      INTO TABLE @lt_bpge.

  ENDIF.

  SORT lt_bpge BY objnr lednr DESCENDING.
  SORT lt_budget BY objnr lednr DESCENDING.

  "------------------------------------------------------------
  " Fill GT_WBS_ITEMS
  "------------------------------------------------------------
  LOOP AT gt_wbs_items ASSIGNING <fs_wbs_item>.
*    IF <fs_wbs_item>-stufe = 1.
*      lv_kostl = <fs_wbs_item>-kostl.
*      lv_prart = <fs_wbs_item>-prart.
*      <fs_wbs_item>-post1 = gs_header-post1.
*      gs_header-kostl = lv_kostl.
*    ELSE.
*      <fs_wbs_item>-kostl = lv_kostl.
*      <fs_wbs_item>-prart = lv_prart.
*    ENDIF.

    CLEAR:
      <fs_wbs_item>-zbudget_check.

    "------------------------------------------
    " Read PRPS using POSID
    "------------------------------------------
    READ TABLE lt_prps INTO DATA(ls_prps)
      WITH KEY posid = <fs_wbs_item>-posid
      BINARY SEARCH.

    IF sy-subrc = 0.

      "Fill ZUNIFIER_PROJ
      gs_header-zunifier_proj = ls_prps-zunifier_proj.
      <fs_wbs_item>-posid = ls_prps-posid.
      <fs_wbs_item>-post1 = ls_prps-post1.
      <fs_wbs_item>-werks = ls_hdr-werks.
      <fs_wbs_item>-vkokr = ls_hdr-vkokr.
*      <fs_wbs_item>-stufe = ls_prps-stufe.
      <fs_wbs_item>-kostl = ls_prps-fkstl.
      <fs_wbs_item>-prart = ls_prps-prart.
      <fs_wbs_item>-imprf = ls_prps-imprf.
      <fs_wbs_item>-gjahr = ls_ivp-gjahr.

      gs_header-kostl     = ls_prps-fkstl.
*---------------------------------------------------------------------*
* Copy KOSTL and PRART from STUFE = 1 WBS to all lower level WBS
*---------------------------------------------------------------------*

      DATA: ls_level1 TYPE zta2r_wbsitem.

      CLEAR ls_level1.

*---------------------------------------------------------------------*
* Get Level 1 WBS (parent/root)
*---------------------------------------------------------------------*
      READ TABLE gt_wbs_items INTO ls_level1
        WITH KEY stufe = 1.

      gs_header-kostl = ls_level1-kostl.
      gv_p_kostl = ls_level1-kostl.

      IF sy-subrc = 0.

        LOOP AT gt_wbs_items ASSIGNING FIELD-SYMBOL(<fs_wbs>).

          IF <fs_wbs>-stufe > 1.

            IF <fs_wbs>-kostl IS INITIAL.
              <fs_wbs>-kostl = ls_level1-kostl.

            ENDIF.

            IF <fs_wbs>-prart IS INITIAL.
              <fs_wbs>-prart = ls_level1-prart.
            ENDIF.
*            ELSE.
*              <fs_wbs>-post1 = gs_header-post1.
          ELSE.
            gv_wert2 = <fs_wbs>-wert2.
          ENDIF.

        ENDLOOP.

      ENDIF.


      "------------------------------------------
      " Budget Check from BPGE
      " if max LEDNR exists with GEBER not initial
      " then set X
      "------------------------------------------
      READ TABLE lt_bpge INTO DATA(ls_bpge)
        WITH KEY objnr = ls_prps-objnr
        BINARY SEARCH.
      IF sy-subrc = 0.
        <fs_wbs_item>-zbudget_check = 'X'.
      ENDIF.

      READ TABLE lt_budget INTO DATA(ls_budget)
        WITH KEY objnr = ls_prps-objnr
        BINARY SEARCH.
      IF sy-subrc = 0.
        <fs_wbs_item>-wert2 = ls_budget-wtges.
      ENDIF.

    ENDIF.


  ENDLOOP.

  PERFORM arrange_prhi.

  gv_gjahr              = ls_ivp-gjahr.
  gv_edit_mode          = abap_true.
  gv_header_initialized = abap_false.
  gs_header-ernam = sy-uname.
  gs_header-erdat = sy-datum.
ENDFORM.
*&---------------------------------------------------------------------*
*& Form arrange_prhi
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM arrange_prhi .
*---------------------------------------------------------------------*
* Arrange gt_wbs_items-POSID based on PRHI hierarchy sequence
*---------------------------------------------------------------------*

  TYPES: BEGIN OF ty_prhi,
           posid TYPE prps-posid,
           up    TYPE prhi-up,
           left  TYPE prhi-left,
           right TYPE prhi-right,
         END OF ty_prhi.

  DATA: lt_prhi_order TYPE STANDARD TABLE OF ty_prhi,
        ls_prhi_order TYPE ty_prhi,
        lt_wbs_sorted TYPE STANDARD TABLE OF zta2r_wbsitem,
        ls_wbs_item   TYPE zta2r_wbsitem.

  CLEAR: lt_prhi_order,
         lt_wbs_sorted.

*---------------------------------------------------------------------*
* Get hierarchy order from PRHI using current project
* Replace gs_header-pspid with your project definition if needed
*---------------------------------------------------------------------*
  SELECT
      p~posid,
      h~up,
      h~left,
      h~right
    INTO TABLE @lt_prhi_order
    FROM prhi AS h
    INNER JOIN prps AS p
      ON p~pspnr = h~posnr
    WHERE h~psphi = @gs_header-pspid
    ORDER BY h~left ASCENDING.

*---------------------------------------------------------------------*
* Arrange gt_wbs_items following PRHI sequence
*---------------------------------------------------------------------*
  LOOP AT lt_prhi_order INTO ls_prhi_order.

    READ TABLE gt_wbs_items INTO ls_wbs_item
      WITH KEY posid = ls_prhi_order-posid.

    IF sy-subrc = 0.
      APPEND ls_wbs_item TO lt_wbs_sorted.
    ENDIF.

  ENDLOOP.

*---------------------------------------------------------------------*
* Replace original table with arranged sequence
*---------------------------------------------------------------------*
  IF lt_wbs_sorted IS NOT INITIAL.
    gt_wbs_items = lt_wbs_sorted.
  ENDIF.
ENDFORM.
*&---------------------------------------------------------------------*
*& Form get_budgetchk
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM get_budgetchk.

  "-------------------------------------------------------
  " Local types (only needed fields)
  "-------------------------------------------------------
  TYPES: BEGIN OF ty_wbs_budget,
           posid         TYPE prps-posid,
           zbudget_check TYPE zta2r_wbsitem-zbudget_check,
         END OF ty_wbs_budget.

  DATA: lt_wbs_db  TYPE STANDARD TABLE OF ty_wbs_budget,
        lt_wbs_map TYPE HASHED TABLE OF ty_wbs_budget
                     WITH UNIQUE KEY posid.

  "-------------------------------------------------------
  " Validate input
  "-------------------------------------------------------
  IF gv_reqnum IS INITIAL.
    RETURN.
  ENDIF.

  "-------------------------------------------------------
  " Get data from DB
  "-------------------------------------------------------
  SELECT posid,
         zbudget_check
    FROM zta2r_wbsitem
    INTO TABLE @lt_wbs_db
    WHERE zreq_num = @gv_reqnum.

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  LOOP AT lt_wbs_db ASSIGNING FIELD-SYMBOL(<fs_wbsdb>).
    REPLACE ALL OCCURRENCES OF '.' IN <fs_wbsdb>-posid WITH ''.
  ENDLOOP.

  "-------------------------------------------------------
  " Convert to hashed table for fast lookup
  "-------------------------------------------------------
  lt_wbs_map = lt_wbs_db.

  "-------------------------------------------------------
  " Update gt_wbs_items
  "-------------------------------------------------------
  LOOP AT gt_wbs_items ASSIGNING FIELD-SYMBOL(<fs_wbs>).

    READ TABLE lt_wbs_map ASSIGNING FIELD-SYMBOL(<fs_db>)
      WITH TABLE KEY posid = <fs_wbs>-posid.

    IF sy-subrc = 0.
      <fs_wbs>-zbudget_check = <fs_db>-zbudget_check.
    ENDIF.

  ENDLOOP.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form validate_plant
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*&      --> GS_HEADER_WERKS
*&      --> GS_HEADER_BUKRS
*&---------------------------------------------------------------------*
FORM validate_plant  USING    iv_hdr_werks
                              iv_hdr_bukrs.

  SELECT SINGLE bwkey
  FROM t001k
  INTO @DATA(lv_bwkey)
 WHERE bwkey = @iv_hdr_werks
   AND bukrs = @iv_hdr_bukrs.

  IF sy-subrc <> 0.
    MESSAGE e000(zmsg_a2r) WITH 'Plant'(m75) iv_hdr_werks 'does not belong to company code'(m76) iv_hdr_bukrs.
    RETURN.
  ENDIF.

ENDFORM.
*&---------------------------------------------------------------------*
*& Form get_data_display
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM get_data_display .
  SELECT SINGLE *
    FROM zta2r_wbshdr
    INTO @gs_header
    WHERE zreq_num = @gv_p_req_num.

  SELECT *
    FROM zta2r_wbsitem
    INTO TABLE @gt_wbs_items
    WHERE zreq_num = @gv_p_req_num.
*  gt_wbs_unclose = gt_wbs_items.

  LOOP AT gt_wbs_unclose ASSIGNING FIELD-SYMBOL(<fs_unclose>).

    READ TABLE gt_wbs_items INTO DATA(ls_item)
      WITH KEY pspid = <fs_unclose>-wbs_element_code.

    IF sy-subrc = 0.
      <fs_unclose>-status = ls_item-zstat.
      <fs_unclose>-to_be  = ls_item-zstat_tobe.
    ENDIF.

  ENDLOOP.
ENDFORM.
*&---------------------------------------------------------------------*
*& Form populate_wbs_unclose_status_d
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM populate_wbs_unclose_status_d.

*---------------------------------------------------------------------*
* Local Types
*---------------------------------------------------------------------*

*---------------------------------------------------------------------*
* Data
*---------------------------------------------------------------------*
  DATA: lt_posid_range TYPE STANDARD TABLE OF ty_posid_range,
        ls_posid_range TYPE ty_posid_range,
        lt_prps_stat   TYPE STANDARD TABLE OF ty_prps_stat,
        ls_prps_stat   TYPE ty_prps_stat,
        lv_status      TYPE string.

  DATA lv_tabix TYPE sy-tabix.


*---------------------------------------------------------------------*
* Check data
*---------------------------------------------------------------------*
  IF gt_wbs_unclose IS INITIAL.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* Build POSID range from gt_wbs_unclose
*---------------------------------------------------------------------*
  LOOP AT gt_wbs_unclose ASSIGNING FIELD-SYMBOL(<fs_unclose>).
    IF <fs_unclose>-wbs_element_code IS NOT INITIAL.
      REPLACE ALL OCCURRENCES OF '.' IN <fs_unclose>-wbs_element_code WITH ''.
      CLEAR ls_posid_range.
      ls_posid_range-sign   = 'I'.
      ls_posid_range-option = 'EQ'.
      ls_posid_range-low    = <fs_unclose>-wbs_element_code.
      APPEND ls_posid_range TO lt_posid_range.
    ENDIF.
  ENDLOOP.

  IF lt_posid_range IS INITIAL.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* Get PRPS-OBJNR + JEST-STAT
* Active statuses only
*---------------------------------------------------------------------*
  SELECT a~posid,
         a~objnr,
         b~stat
    INTO TABLE @lt_prps_stat
    FROM prps  AS a
    INNER JOIN jest  AS b
      ON b~objnr = a~objnr
   WHERE a~posid IN @lt_posid_range
     AND b~inact = @space
     AND b~stat IN ( 'I0002', 'I0045', 'I0046' ).

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* Fill TXT04 as constant
*---------------------------------------------------------------------*
  LOOP AT lt_prps_stat INTO ls_prps_stat.
    CASE ls_prps_stat-stat.
      WHEN 'I0002'.
        ls_prps_stat-txt04 = 'REL'.
      WHEN 'I0045'.
        ls_prps_stat-txt04 = 'TECO'.
      WHEN 'I0046'.
        ls_prps_stat-txt04 = 'CLSD'.
    ENDCASE.

    MODIFY lt_prps_stat FROM ls_prps_stat INDEX sy-tabix.
  ENDLOOP.

*---------------------------------------------------------------------*
* Update gt_wbs_unclose-status
*---------------------------------------------------------------------*
  SORT lt_prps_stat BY posid txt04.

  IF sy-uname <> 'EV92123'.
    LOOP AT gt_wbs_unclose ASSIGNING <fs_unclose>.
      CLEAR lv_status.

      LOOP AT lt_prps_stat INTO ls_prps_stat
        WHERE posid = <fs_unclose>-wbs_element_code.

        IF lv_status IS INITIAL.
          lv_status = ls_prps_stat-txt04.
        ELSE.
          CONCATENATE lv_status ls_prps_stat-txt04
            INTO lv_status SEPARATED BY ', '.
        ENDIF.
      ENDLOOP.

      <fs_unclose>-status = lv_status.
    ENDLOOP.

  ELSE.
    LOOP AT gt_wbs_unclose ASSIGNING <fs_unclose>.

      <fs_unclose>-status =
        REDUCE string(
          INIT lv = ``
          FOR ls_stat IN lt_prps_stat
          WHERE ( posid = <fs_unclose>-wbs_element_code )
          NEXT lv = condense(
                     SWITCH string(
                       lv
                       WHEN `` THEN ls_stat-txt04
                       ELSE |{ lv }, { ls_stat-txt04 }|
                     )
                   )
        ).

    ENDLOOP.
  ENDIF.

*---------------------------------------------------------------------*
* DISPLAY MODE
*---------------------------------------------------------------------*

  IF gv_disp_req = abap_true.

    LOOP AT gt_wbs_unclose ASSIGNING <fs_unclose>.
      lv_tabix = sy-tabix.

      READ TABLE gt_wbs_items INTO gs_wbs_item INDEX lv_tabix.
      IF sy-subrc = 0.
        IF gs_wbs_item-zstat IS NOT INITIAL.
          <fs_unclose>-status = gs_wbs_item-zstat.
        ENDIF.

        IF gs_wbs_item-zstat_tobe IS NOT INITIAL.
          <fs_unclose>-to_be = gs_wbs_item-zstat_tobe.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.

ENDFORM.
