*&---------------------------------------------------------------------*
*& Form load_b1_project_and_car_wbs
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM load_b1_project_and_car_wbs.

  DATA: lt_existing_wbs TYPE ty_t_wbs_items,
        lt_car_wbs      TYPE STANDARD TABLE OF zta2r_wbsitem,
        ls_wbs          TYPE zta2r_wbsitem,
        lv_proj_pspnr   TYPE proj-pspnr.

  FIELD-SYMBOLS: <fs_car> TYPE zta2r_wbsitem.

  CLEAR gt_wbs_items.

  "------------------------------------------------------------
  " 1) Get selected ESR project internal number
  "------------------------------------------------------------
  SELECT SINGLE pspnr
    FROM proj
    INTO @lv_proj_pspnr
    WHERE pspid = @gv_p_pspid_proj.

  IF sy-subrc <> 0 OR lv_proj_pspnr IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Please enter valid project'(v17).
  ENDIF.

  "------------------------------------------------------------
  " 2) Load ALL existing ESR project WBS
  "------------------------------------------------------------
  PERFORM get_existing_project_wbs
    USING    lv_proj_pspnr
    CHANGING lt_existing_wbs.

  APPEND LINES OF lt_existing_wbs TO gt_wbs_items.

  "------------------------------------------------------------
  " 3) Load CAR template WBS
  "------------------------------------------------------------
  CALL METHOD go_builder->copy_template_structure
    EXPORTING
      iv_pspid     = gv_p_pspid_car
      iv_kostl     = gs_header-kostl
    CHANGING
      ct_wbs_items = lt_car_wbs.

  "------------------------------------------------------------
  " 4) Append CAR WBS except level 1 only
  "------------------------------------------------------------
  LOOP AT lt_car_wbs ASSIGNING <fs_car>.
    CHECK <fs_car>-stufe > 1.

    CLEAR ls_wbs.
    MOVE-CORRESPONDING <fs_car> TO ls_wbs.

    PERFORM replace_template_posid
      USING    gv_p_pspid_car
               gv_p_pspid_proj
               <fs_car>-posid
      CHANGING ls_wbs-posid.

    ls_wbs-bukrs = gs_header-bukrs.
    ls_wbs-kostl = gs_header-kostl.

    IF gs_header-vkokr IS NOT INITIAL.
      ls_wbs-vkokr = gs_header-vkokr.
    ENDIF.

    APPEND ls_wbs TO gt_wbs_items.
  ENDLOOP.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form get_existing_project_wbs
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM get_existing_project_wbs
  USING    iv_proj_pspnr TYPE proj-pspnr
  CHANGING ct_wbs_items  TYPE ty_t_wbs_items.

  TYPES: BEGIN OF ty_prps,
           pspnr TYPE prps-pspnr,
           psphi TYPE prps-psphi,
           stufe TYPE prps-stufe,
           posid TYPE prps-posid,
           post1 TYPE prps-post1,
           pkokr TYPE prps-pkokr,
           prart TYPE prps-prart,
           pbukr TYPE prps-pbukr,
           kostl TYPE prps-kostl,
           imprf TYPE prps-imprf,
         END OF ty_prps.

  DATA: lt_prps TYPE STANDARD TABLE OF ty_prps,
        ls_prps TYPE ty_prps,
        ls_wbs  TYPE zta2r_wbsitem.

  CLEAR ct_wbs_items.

  SELECT pspnr,
         psphi,
         stufe,
         posid,
         post1,
         pkokr,
         prart,
         pbukr,
         kostl,
         imprf
    FROM prps
    INTO TABLE @lt_prps
    WHERE psphi = @iv_proj_pspnr
    ORDER BY posid.

  LOOP AT lt_prps INTO ls_prps.
    CLEAR ls_wbs.
    ls_wbs-posnr = ls_prps-pspnr.
    ls_wbs-stufe = ls_prps-stufe.
    ls_wbs-posid = ls_prps-posid.
    ls_wbs-post1 = ls_prps-post1.
    ls_wbs-vkokr = ls_prps-pkokr.
    ls_wbs-prart = ls_prps-prart.
    ls_wbs-bukrs = ls_prps-pbukr.
    ls_wbs-kostl = ls_prps-kostl.
    ls_wbs-imprf = ls_prps-imprf.

    APPEND ls_wbs TO ct_wbs_items.
  ENDLOOP.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form replace_template_posid
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM replace_template_posid
  USING    iv_car_pspid   TYPE projs-pspid
           iv_proj_pspid  TYPE proj-pspid
           iv_old_posid   TYPE prps-posid
  CHANGING cv_new_posid   TYPE prps-posid.

  DATA: lv_old  TYPE string,
        lv_car  TYPE string,
        lv_proj TYPE string.

  lv_old  = iv_old_posid.
  lv_car  = iv_car_pspid.
  lv_proj = iv_proj_pspid.

  cv_new_posid = iv_old_posid.

  IF lv_old CS lv_car.
    REPLACE FIRST OCCURRENCE OF lv_car IN lv_old WITH lv_proj.
    cv_new_posid = lv_old.
  ENDIF.

ENDFORM.

