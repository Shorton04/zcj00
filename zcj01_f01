*&---------------------------------------------------------------------*
*& Form get_im_data
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
FORM get_im_data USING iv_posnr TYPE im_posnr.
  DATA: ls_imprs TYPE impr.
  " Validate posnr exists and get data
  SELECT SINGLE posnr, gjahr, prnam, izwek, verna,
                bukrs, kostl, werks, prctr, sizecl, usr08, usr10
  FROM impr
  INTO @DATA(ls_impr)
  WHERE posnr = @iv_posnr.

  IF sy-subrc = 0.
    " Get IM Program (PRNAM)
    " Population: Get IMPR-POSID where IMPR-POSNR = selected POSNR
    gv_p_prnam = ls_impr-prnam.

    " Get Approval Year (GJAHR)
    " Population: Get IMPR-GJAHR where IMPR-POSNR = selected POSNR
    gv_p_gjahr = ls_impr-gjahr.

    " Get Profit Center (PRCTR)
    " Population: Get IMPR-PRCTR where IMPR-POSNR = selected POSNR
    gv_p_prctr = ls_impr-prctr.

    " Get Cost Center (KOSTL)
    " Population: Get IMPR-KOSTL where IMPR-POSNR = selected POSNR
    gv_p_kostl = ls_impr-kostl.

    gv_p_verna = ls_impr-verna.

    " Store additional fields for Screen 2
    gv_bukrs = ls_impr-bukrs.
    gv_werks = ls_impr-werks.
    gv_izwek = ls_impr-izwek.
    gv_usr008 = ls_impr-usr08.

    " Get Project Profile and Template
    " Population: From IMPR-POSNR, get IMPR-IZWEK, then query config table
    PERFORM get_profile_template USING ls_impr-izwek
                                 CHANGING gv_p_profl gv_p_pspid gv_p_post1.

    " Check GE Ariba flag
    " Population: Auto-selected if IM Project management field = "GE"
    ls_imprs = CORRESPONDING #( ls_impr ).

    PERFORM check_ge_ariba USING ls_imprs CHANGING gv_p_usr10_c.

    " Set finish date for lumpsum
    " Population: For Lumpsum, auto-populate with last day of current year
    IF ls_impr-izwek = 'LS'.
      gv_p_plsez = sy-datum.
      gv_p_plsez+4(4) = '1231'. " Last day of year (e.g., 31.12.2025)
    ENDIF.

  ELSE.
    MESSAGE e000(zmsg_a2r) WITH iv_posnr. " im Number not found
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form get_profile_template
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM get_profile_template USING iv_izwek TYPE izwek
                          CHANGING cv_profl TYPE profidproj
                                   cv_pspid TYPE ps_pspid
                                   cv_post1 TYPE ps_post1.

  DATA: lv_pspnr  TYPE ps_pspnr,
        lv_zstage TYPE zde_a2r_satge.


  " CRITICAL FIX: PSPNR in config table is INTERNAL number, not PSPID!
  " From design: PSPNR = PC.000001 (display), 00000008 (internal)

  SELECT SINGLE *
    FROM zta2r_conftab1
    INTO @DATA(ls_conf)
    WHERE izwek = @iv_izwek
    AND   z_stage = @lv_zstage.


  IF sy-subrc = 0.

    cv_profl = ls_conf-profl.
    lv_pspnr = ls_conf-pspnr.

    " NOW get the PSPID (external ID) from PSPNR (internal number)
    " Use PROJS table (standard WBS structure table from design 4)
    SELECT SINGLE pspid, post1
      FROM projs
      INTO (@cv_pspid, @cv_post1)
      WHERE pspnr = @lv_pspnr.


    IF cv_pspid IS INITIAL.
      MESSAGE w000(zmsg_a2r) WITH 'Template PSPID not found for PSPNR'(m18) lv_pspnr.
      CLEAR: cv_profl, cv_pspid.
    ENDIF.


  ELSE.
    MESSAGE w000(zmsg_a2r) WITH 'No configuration found for IZWEK'(m19) iv_izwek.
    CLEAR: cv_profl, cv_pspid.
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form get_im_posid_for_display
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM get_im_posid_for_display USING iv_posnr TYPE im_posnr
                            CHANGING cv_posid_display TYPE im_posid.

  CHECK iv_posnr IS NOT INITIAL.

  SELECT SINGLE posid
    FROM impr
    INTO cv_posid_display
  WHERE posnr = iv_posnr.
  IF sy-subrc <> 0.
    cv_posid_display = iv_posnr.
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form get_im_posid_for_display
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM get_available_budget_display USING iv_posnr         TYPE im_posnr
                               CHANGING cv_budget_text   TYPE char10
                                        cv_budget_amount TYPE bpge-wlges.

  DATA: lv_avail TYPE bpge-wlges.

  " Get OBJNR for the WBS element
  SELECT SINGLE objnr
    FROM impr
    WHERE posnr = @iv_posnr
    INTO @DATA(lv_objnr).

  IF lv_objnr IS NOT INITIAL.
    " Get budget values
    SELECT SINGLE objnr, wlges, wtgev
      FROM bpge
      INTO @DATA(ls_bpge)
*      UP TO 1 ROWS
      WHERE objnr = @lv_objnr.
*    ENDSELECT.

    IF sy-subrc = 0.
      lv_avail = ls_bpge-wlges - ls_bpge-wtgev.
      cv_budget_amount = lv_avail.
      cv_budget_text   = COND #( WHEN lv_avail > 0 THEN 'Yes' ELSE 'No' ).
    ELSE.
      cv_budget_text   = 'No'.
      cv_budget_amount = 0.
    ENDIF.

  ELSE.
    cv_budget_text   = 'No'.
    cv_budget_amount = 0.
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form get_project_currency
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM get_project_currency USING iv_pspnr     TYPE ps_pspnr
                       CHANGING cv_currency  TYPE waers.

  CLEAR cv_currency.
  IF iv_pspnr IS NOT INITIAL.
    SELECT SINGLE pwhie
    FROM proj
    INTO cv_currency
    WHERE pspnr = iv_pspnr.
    IF sy-subrc <> 0.
      SELECT SINGLE waers
        FROM t001
        INTO cv_currency
        WHERE bukrs = gv_bukrs.
    ENDIF.
  ENDIF.
ENDFORM.

