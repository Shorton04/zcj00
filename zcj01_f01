*&---------------------------------------------------------------------*
*& Form validate_screen2
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM validate_screen2 USING iv_on_submit TYPE abap_bool.

  DATA: lv_error          TYPE abap_bool,
        lv_kokrs          TYPE kokrs,
        lv_im_budget      TYPE bpge-wlges,
        lv_level1_budget  TYPE bpge-wlges,
        lv_has_attachment TYPE abap_bool,

        lv_budget_im_curr TYPE bpge-wlges,
        lv_im_waers       TYPE imtp-waers,
        lv_ukurs          TYPE tcurr-ukurs.

  CLEAR: lv_error, lv_kokrs, lv_im_budget, lv_level1_budget, lv_has_attachment.

  "---------------------------------------------------------------*
  " 1. Get KOKRS from IM Position
  "---------------------------------------------------------------*
  SELECT SINGLE kokrs
    INTO @lv_kokrs
    FROM impr
   WHERE posnr = @gs_header-posnr.

  IF gv_vkokr IS NOT INITIAL.
    lv_kokrs = gv_vkokr.
  ENDIF.

  "---------------------------------------------------------------*
  " 2. Mandatory header fields
  "---------------------------------------------------------------*
  PERFORM validate_screen2_header
    CHANGING lv_error.

  IF lv_error = abap_true.
    MESSAGE e004.
    EXIT.
  ENDIF.

  PERFORM validate_plant USING gs_header-werks gs_header-bukrs.

  "---------------------------------------------------------------*
  " 3. Reuse existing validations
  "---------------------------------------------------------------*
  PERFORM validate_cost_center
    USING    lv_kokrs
             gs_header-kostl
             gs_header-plsez
    CHANGING lv_error.

  IF lv_error = abap_true.
    MESSAGE e004.
    EXIT.
  ENDIF.

  PERFORM resp_pers USING gs_header-vernr.

  PERFORM validate_profit_center
    USING    lv_kokrs
             gs_header-prctr
             gs_header-plsez
             gs_header-prnam
             gs_header-posnr
    CHANGING lv_error.

  IF lv_error = abap_true.
    MESSAGE e004.
    EXIT.
  ENDIF.

  PERFORM validate_cc_pc_assignment
    USING    lv_kokrs
             gs_header-kostl
             gs_header-prctr
    CHANGING lv_error.

  IF lv_error = abap_true.
    MESSAGE e004.
    EXIT.
  ENDIF.

  PERFORM validate_approver_matrix
  CHANGING lv_error.

  "---------------------------------------------------------------*
  " 4. WBS table validations
  "---------------------------------------------------------------*
  PERFORM validate_screen2_wbs_table
    CHANGING lv_error.

  IF lv_error = abap_true.
    MESSAGE e004.
    EXIT.
  ENDIF.


  PERFORM validate_total_up_done
    CHANGING lv_error.

  IF lv_error = abap_true.
    MESSAGE e004.
    EXIT.
  ENDIF.

*---------------------------------------------------------------------*
* 5. Level 1 budget vs IM available budget
*---------------------------------------------------------------------*
  PERFORM get_im_available_budget_s2
    CHANGING lv_im_budget
             lv_im_waers.

  PERFORM get_level1_total_budget
    CHANGING lv_level1_budget.

  " Optional: no level 1 budget entered
  IF lv_level1_budget IS INITIAL.
    RETURN.
  ENDIF.

  " Optional: cannot validate if no IM currency found
  IF lv_im_waers IS INITIAL.
    RETURN.
  ENDIF.

  " Convert Level 1 budget to IM currency if needed
  IF gv_project_currency = lv_im_waers.

    lv_budget_im_curr = lv_level1_budget.

  ELSE.

    PERFORM get_exchange_rate_to_im
      USING    lv_im_waers
               gv_project_currency
      CHANGING lv_ukurs.

    IF lv_ukurs IS INITIAL.
      MESSAGE e000(zmsg_a2r) WITH 'Unable to determine exchange rate'(m59).
      EXIT.
    ENDIF.

    lv_budget_im_curr = lv_level1_budget / lv_ukurs.

  ENDIF.

  " Final comparison
  IF lv_budget_im_curr > lv_im_budget.
    MESSAGE e000(zmsg_a2r) WITH 'Amount is greater than the available IM budget'(m60).
    EXIT.
  ENDIF.

  "---------------------------------------------------------------*
  " 6. Attachment validation - submit only
  "---------------------------------------------------------------*
  IF gv_req_type <> 'B2' AND gv_req_type <> 'E1'.
    PERFORM check_attachment_exists
      CHANGING lv_has_attachment.

    IF lv_has_attachment IS INITIAL.
      MESSAGE e000(zmsg_a2r) WITH 'Attachment is Mandatory.'(m43).
      RETURN.
    ENDIF.
  ENDIF.

  IF gv_req_type = 'E1'.
    "---------------------------------------------------------------*
    " 7. Remarks validation
    "---------------------------------------------------------------*
    IF gv_z_remarks IS INITIAL.
      MESSAGE e000(zmsg_a2r) WITH 'Remarks is Mandatory'(v23).
      RETURN.
    ENDIF.


    "---------------------------------------------------------------*
    " 8. To-Be validation
    "---------------------------------------------------------------*
    PERFORM tobe_validate.
  ENDIF.

  IF gs_header-pspid IS INITIAL.
    SELECT SINGLE pspnr, pspid
      FROM proj
      INTO ( @gs_header-pspnr, @gs_header-pspid )
      WHERE pspnr = @gs_header-pspnr.
  ENDIF.
  IF gs_header-pspnr IS INITIAL.
    SELECT SINGLE pspnr, pspid
      FROM proj
      INTO ( @gs_header-pspnr, @gs_header-pspid )
      WHERE pspnr = @gs_header-pspnr.
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form validate_screen2_header
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM validate_screen2_header
  CHANGING cv_error TYPE abap_bool.

  CLEAR cv_error.

  IF gs_header-post1 IS INITIAL
  OR gs_header-bukrs IS INITIAL
  OR gs_header-vernr IS INITIAL
  OR gs_header-plsez IS INITIAL
  OR gs_header-werks IS INITIAL
  OR gs_header-prctr IS INITIAL
  OR gs_header-prnam IS INITIAL
  OR gs_header-kostl IS INITIAL
  OR gs_header-izwek IS INITIAL
  OR gs_header-posnr IS INITIAL.

    MESSAGE e000(zmsg_a2r) WITH 'Fill in all required entry fields'(m42).
    cv_error = abap_true.
    RETURN.
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form validate_screen2_wbs_table
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM validate_screen2_wbs_table
  CHANGING cv_error TYPE abap_bool.

  DATA: ls_wbs TYPE ty_wbs_display.

  CLEAR cv_error.

  IF gt_wbs_display IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Please enter at least one WBS row'(m41).
    cv_error = abap_true.
    RETURN.
  ENDIF.

  " Duplicate / mandatory / level validations
  PERFORM validate_wbs_duplicates
    CHANGING cv_error.
  IF cv_error = abap_true.
    RETURN.
  ENDIF.

  LOOP AT gt_wbs_display INTO ls_wbs.

    " Mandatory fields in table
    IF ls_wbs-stufe IS INITIAL
    OR ls_wbs-posid IS INITIAL
    OR ls_wbs-post1 IS INITIAL.
      MESSAGE e000(zmsg_a2r) WITH 'Fill in all required WBS entry fields'(m40).
      cv_error = abap_true.
      RETURN.
    ENDIF.

    " Level 1 validations based on FS
    IF ls_wbs-stufe = 1.

      " Only for ZPC00001
      IF gv_p_profl = 'ZPC0001'.
        " Investment Profile required in Level 1 WBS
        IF ls_wbs-imprf IS INITIAL.
          MESSAGE e000(zmsg_a2r)
            WITH 'Investment Profile is required in Level 1 WBS'(m58) ls_wbs-posid.
          cv_error = abap_true.
          RETURN.
        ENDIF.
      ENDIF.

      " Responsible Cost Center required in Level 1 WBS
      IF ls_wbs-kostl IS INITIAL.
        MESSAGE e000(zmsg_a2r)
          WITH 'Responsible Cost Center is required in Level 1 WBS'(m57) ls_wbs-posid.
        cv_error = abap_true.
        RETURN.
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form validate_wbs_duplicates
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM validate_wbs_duplicates
  CHANGING cv_error TYPE abap_bool.

  DATA: ls_wbs   TYPE ty_wbs_display,
        lt_posid TYPE SORTED TABLE OF ps_posid WITH UNIQUE KEY table_line.

  CLEAR cv_error.

  LOOP AT gt_wbs_display INTO ls_wbs.

    READ TABLE lt_posid
      WITH TABLE KEY table_line = ls_wbs-posid
      TRANSPORTING NO FIELDS.

    IF sy-subrc = 0.
      MESSAGE e000(zmsg_a2r)
        WITH 'Duplicate WBS element found'(m37) ls_wbs-posid.
