FORM check_ge_ariba  USING is_impr TYPE impr
                  CHANGING cv_flag TYPE char1.

  " Check if project management field = GE (Global Engineering)
  IF is_impr-sizecl = 'GE'.
    cv_flag = gc_x.
  ELSE.
    CLEAR cv_flag.
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form validate_screen1
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM validate_screen1.

  DATA: lv_error TYPE abap_bool,
        lv_kokrs TYPE kokrs.

  SELECT SINGLE kokrs
    INTO @lv_kokrs
    FROM impr
    WHERE posnr = @gv_p_posnr.

  " Cost Center validation
  PERFORM validate_cost_center USING lv_kokrs gv_p_kostl gv_p_plsez
  CHANGING lv_error.

  " Profit Center validation
  PERFORM validate_profit_center USING lv_kokrs gv_p_prctr gv_p_plsez gv_p_prnam gv_p_posnr
  CHANGING lv_error.

  " CC to PC assignment
  PERFORM validate_cc_pc_assignment USING lv_kokrs gv_p_kostl gv_p_prctr
  CHANGING lv_error.

  IF lv_error = abap_true.
    MESSAGE e000(zmsg_a2r). " Validation errors found
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form validate_cost_center
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM validate_cost_center USING iv_kokrs TYPE kokrs
                                iv_kostl TYPE kostl
                                iv_plsez TYPE ps_plsez_chg
                          CHANGING cv_error TYPE abap_bool.

  " Check cost center validity against Finish Date
  SELECT SINGLE @abap_true
    FROM csks
    WHERE kostl = @iv_kostl
      AND kokrs = @iv_kokrs
      AND datab <= @iv_plsez
      AND datbi >= @iv_plsez
   INTO @DATA(lv_found) .
  IF sy-subrc = 0.
    CLEAR cv_error.
  ELSE.
    MESSAGE e000(zmsg_a2r) WITH 'Cost center is not valid in current year.'(v42).
    cv_error = gc_x.
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form validate_profit_center
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
##NEEDED FORM validate_profit_center USING    iv_kokrs TYPE kokrs
                                     iv_prctr TYPE prctr
                                     iv_plsez TYPE ps_plsez_chg
                                     iv_prnam TYPE im_prnam
                                     iv_posnr TYPE im_posnr
                            CHANGING cv_error TYPE abap_bool.

  DATA: lv_prctr    TYPE impr-prctr,
        lv_kokrs    TYPE impr-kokrs,
        lv_prnam    TYPE impr-prnam,
        lv_posnr    TYPE impr-posnr,
        lv_datab    TYPE cepc-datab,
        lv_datbi    TYPE cepc-datbi,
        lv_year_end TYPE sy-datum.

  CLEAR cv_error.

*---------------------------------------------------------------------*
* Step 1: Get PRCTR + KOKRS from IMPR (override input values)
*---------------------------------------------------------------------*
  SELECT SINGLE prnam,
                posnr,
                prctr,
                kokrs
    INTO ( @lv_prnam, @lv_posnr, @lv_prctr, @lv_kokrs )
    FROM impr
   WHERE prnam = @iv_prnam
     AND posnr = @iv_posnr.

  IF sy-subrc <> 0.
    MESSAGE e000(zmsg_a2r) WITH 'IMPR data not found'(m63).
    cv_error = gc_x.
    EXIT.
  ENDIF.

*---------------------------------------------------------------------*
* Step 2: Read CEPC validity period
*---------------------------------------------------------------------*
  SELECT SINGLE datab, datbi
    INTO ( @lv_datab, @lv_datbi )
    FROM cepc
   WHERE prctr = @lv_prctr
     AND kokrs = @lv_kokrs.
*  ENDSELECT.

  IF sy-subrc <> 0.
    MESSAGE e000(zmsg_a2r) WITH 'Profit center is not valid in current year'(m45).
    cv_error = gc_x.
    EXIT.
  ENDIF.

*---------------------------------------------------------------------*
* Step 3: Validate current year
*---------------------------------------------------------------------*
  lv_year_end = |{ sy-datum+0(4) }1231|.

  IF lv_datab <= sy-datum
     AND ( lv_datbi >= sy-datum
        OR lv_datbi >= lv_year_end ).

    CLEAR cv_error.

  ELSE.
    MESSAGE e000(zmsg_a2r) WITH 'Profit center is not valid in current year'(m45) lv_year_end.
    cv_error = gc_x.
  ENDIF.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form validate_cc_pc_assignment
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM validate_cc_pc_assignment USING iv_kokrs TYPE kokrs
                                     iv_kostl TYPE kostl
                                     iv_prctr TYPE prctr
                            CHANGING cv_error TYPE abap_bool.

  SELECT kokrs, kostl, datbi, datab, bukrs, prctr
    FROM csks
    INTO @DATA(ls_csks)
     WHERE kokrs = @iv_kokrs
     AND   kostl = @iv_kostl
     AND   prctr = @iv_prctr
     AND datab <= @sy-datum
     AND datbi >= @sy-datum
    ORDER BY datab.
  ENDSELECT.


  IF ls_csks-prctr <> iv_prctr.
    MESSAGE e000(zmsg_a2r) WITH iv_kostl 'is not assigned to'(m47) iv_prctr.
    cv_error = gc_x.
    RETURN.
  ENDIF.

  SELECT prctr, datbi, kokrs, bukrs
    FROM cepc
    INTO @DATA(ls_cepc)
    WHERE prctr = @iv_prctr
    AND kokrs = @iv_kokrs
    ORDER BY datbi.
  ENDSELECT.

  IF ls_cepc-bukrs IS NOT INITIAL AND
      ls_cepc-bukrs NE ls_csks-bukrs.
    MESSAGE e000(zmsg_a2r) WITH 'No Company Code Assigned'(v01)."ERROR ASSIGNEE
    cv_error = gc_x.
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form get_available_im_budget
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM get_available_im_budget USING iv_posnr TYPE im_posnr
                          CHANGING cv_budget TYPE bpge-wlges.

  SELECT SINGLE b~wlges, b~wtgev
    FROM impr AS i
    INNER JOIN bpge AS b ON b~objnr = i~objnr
    WHERE i~posnr = @iv_posnr
    INTO @DATA(ls_bpge).
  "UP TO 1 ROWS.
  "ENDSELECT.

  IF sy-subrc = 0.
    cv_budget = ls_bpge-wlges - ls_bpge-wtgev.
    cv_budget = COND #( WHEN cv_budget > 0 THEN cv_budget ELSE 0 ).
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form create_tree_control
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM create_tree_control.

  " Don't create if already exists
  CHECK lo_tree_preview IS INITIAL.

  TRY.
      " Create container
      CREATE OBJECT lo_cont_preview
        EXPORTING
          container_name = gc_tree_container.

      " Set header
      CLEAR ls_hierarchy_header.
      ls_hierarchy_header-heading = 'Project Structure: Description'(m05).
      ls_hierarchy_header-tooltip = 'Project Structure: Description'(m05).
      ls_hierarchy_header-width   = 40.

      " Create tree
      CREATE OBJECT lo_tree_preview
        EXPORTING
          parent                = lo_cont_preview
          node_selection_mode   = 0
          item_selection        = space
          hierarchy_column_name = gc_hierarchy_short_text
          hierarchy_header      = ls_hierarchy_header.

      " Add column
      CALL METHOD lo_tree_preview->add_column
        EXPORTING
          name        = gc_hierarchy_technical_key
          width       = 30
          alignment   = cl_gui_column_tree=>align_left
          header_text = CONV #( 'Identification'(m65) ) ##NO_TEXT.

      " Set alignment (CFW workaround)
      CALL METHOD lo_tree_preview->set_alignment
        EXPORTING
          alignment = 15.

      lv_tree_loaded = abap_true.

    CATCH cx_root INTO DATA(lx_error).
      " Clean up on error
      IF lo_tree_preview IS NOT INITIAL.
        FREE lo_tree_preview.
      ENDIF.
      IF lo_cont_preview IS NOT INITIAL.
        FREE lo_cont_preview.
      ENDIF.
      MESSAGE lx_error->get_text( ) TYPE 'S' DISPLAY LIKE 'E'.
  ENDTRY.
ENDFORM.

*&---------------------------------------------------------------------*
*& Form load_tree_hierarchy
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM load_tree_hierarchy.

  TYPES: BEGIN OF ty_prhis,
           pspnr TYPE ps_pspnr,
           psphi TYPE ps_pspnr,
           up    TYPE ps_pspnr,
           down  TYPE ps_pspnr,
           left  TYPE ps_pspnr,
           right TYPE ps_pspnr,
         END OF ty_prhis.

  TYPES: BEGIN OF ty_prpss,
           pspnr TYPE prpss-pspnr,
           stufe TYPE prpss-stufe,
           posid TYPE prpss-posid,
           post1 TYPE prpss-post1,
         END OF ty_prpss.

  TYPES: BEGIN OF ty_seq,
           seqno TYPE i,
           pspnr TYPE ps_pspnr,
           stufe TYPE prpss-stufe,
           posid TYPE prpss-posid,
           post1 TYPE prpss-post1,
         END OF ty_seq.

  TYPES: BEGIN OF ty_level_map,
           stufe    TYPE i,
           node_key TYPE lvc_nkey,
         END OF ty_level_map.

  DATA: lv_psphi      TYPE ps_pspnr,
        lv_node       TYPE ps_pspnr,
        lv_parent_key TYPE lvc_nkey,
        lv_last_key   TYPE lvc_nkey VALUE 0,
        lv_next_stufe TYPE i,
        lv_index      TYPE sy-tabix.

  DATA: lt_prhis     TYPE STANDARD TABLE OF ty_prhis,
        lt_prhis_h   TYPE HASHED TABLE OF ty_prhis WITH UNIQUE KEY pspnr,
        lt_prpss     TYPE STANDARD TABLE OF ty_prpss,
        lt_prpss_h   TYPE HASHED TABLE OF ty_prpss WITH UNIQUE KEY pspnr,
        ls_prpss     TYPE ty_prpss,
        lt_stack     TYPE STANDARD TABLE OF ps_pspnr,
        lt_seq       TYPE STANDARD TABLE OF ty_seq,
        ls_seq       TYPE ty_seq,
        ls_next_seq  TYPE ty_seq,
        lt_level_map TYPE STANDARD TABLE OF ty_level_map,
        ls_level_map TYPE ty_level_map,
        ls_node      TYPE treev_node,
        ls_item      TYPE cnpb_h_treeitm.

  FIELD-SYMBOLS: <lfs_prhis>     TYPE ty_prhis,
                 <lfs_prpss>     TYPE ty_prpss,
                 <lfs_level_map> TYPE ty_level_map.

  CHECK gv_p_pspid IS NOT INITIAL.
  CHECK lo_tree_preview IS NOT INITIAL.

  TRY.

      CLEAR: gt_treev_node,
             gt_treeitm,
             lt_prhis,
             lt_prpss,
             lt_seq,
             lt_level_map.

*--------------------------------------------------------------------*
* 1. Get template project internal number
*--------------------------------------------------------------------*
      SELECT SINGLE pspnr, pspid, post1
        INTO @DATA(ls_projs)
        FROM projs
        WHERE pspid = @gv_p_pspid.

      IF sy-subrc <> 0.
        DATA(lv_pspid_input) = gv_p_pspid.

        CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
          EXPORTING
            input  = lv_pspid_input
          IMPORTING
            output = lv_pspid_input.

        SELECT SINGLE pspnr, pspid, post1
          INTO @ls_projs
          FROM projs
          WHERE pspid = @lv_pspid_input.
      ENDIF.

      IF sy-subrc <> 0 OR ls_projs-pspnr IS INITIAL.
        MESSAGE 'Template project not found in PROJS table'(m01) TYPE 'S' DISPLAY LIKE 'W'.
        RETURN.
      ENDIF.

      lv_psphi = ls_projs-pspnr.

*--------------------------------------------------------------------*
* 2. Read PRHIS hierarchy
*--------------------------------------------------------------------*
      SELECT posnr AS pspnr,
             psphi,
             up,
             down,
             left,
             right
        FROM prhis
        INTO TABLE @lt_prhis
        WHERE psphi = @lv_psphi.
      IF sy-subrc <> 0.
        CLEAR lt_prhis.
      ENDIF.

*--------------------------------------------------------------------*
* 3. Read PRPSS details
*--------------------------------------------------------------------*
      SELECT pspnr,
             stufe,
             posid,
             post1
        FROM prpss
        INTO TABLE @lt_prpss
        WHERE psphi = @lv_psphi.

      IF lt_prpss IS INITIAL.
        MESSAGE 'No WBS elements found for template'(m02) TYPE 'S' DISPLAY LIKE 'W'.
        RETURN.
      ENDIF.

      lt_prpss_h = lt_prpss.

*--------------------------------------------------------------------*
* 4. Build sequence using PRHIS preorder traversal
*    Fallback to POSID if PRHIS missing
*--------------------------------------------------------------------*
      IF lt_prhis IS NOT INITIAL.

        lt_prhis_h = lt_prhis.

        DATA(lv_root) = VALUE ps_pspnr( ).

        " First try: entry where UP is initial
        READ TABLE lt_prhis INTO DATA(ls_prhis)
             WITH KEY up = VALUE ps_pspnr( ).

        IF sy-subrc = 0.
          lv_root = ls_prhis-pspnr.

          " Fallback: first row of the table
        ELSEIF lt_prhis IS NOT INITIAL.
          lv_root = lt_prhis[ 1 ]-pspnr.                "#EC CI_NOORDER
        ENDIF.

        IF lv_root IS INITIAL.
          MESSAGE e000(zmsg_a2r) WITH 'Unable to determine template root node'(m68).
          RETURN.
        ENDIF.

        CLEAR lt_stack.
        APPEND lv_root TO lt_stack.

        WHILE lt_stack IS NOT INITIAL.

          READ TABLE lt_stack INTO lv_node INDEX lines( lt_stack ).
          DELETE lt_stack INDEX lines( lt_stack ).

          READ TABLE lt_prhis_h ASSIGNING <lfs_prhis> WITH KEY pspnr = lv_node.
          IF sy-subrc <> 0.
            CONTINUE.
          ENDIF.

          READ TABLE lt_prpss_h ASSIGNING <lfs_prpss> WITH KEY pspnr = lv_node.
          IF sy-subrc <> 0.
            CONTINUE.
          ENDIF.

          CLEAR ls_seq.
          ls_seq-seqno = lines( lt_seq ) + 1.
          ls_seq-pspnr = <lfs_prpss>-pspnr.
          ls_seq-stufe = <lfs_prpss>-stufe.
          ls_seq-posid = <lfs_prpss>-posid.
          ls_seq-post1 = <lfs_prpss>-post1.
          APPEND ls_seq TO lt_seq.

          IF <lfs_prhis>-right IS NOT INITIAL.
            APPEND <lfs_prhis>-right TO lt_stack.
          ENDIF.
          IF <lfs_prhis>-down IS NOT INITIAL.
            APPEND <lfs_prhis>-down TO lt_stack.
          ENDIF.

        ENDWHILE.

      ELSE.

        "Fallback only if PRHIS not available
        LOOP AT lt_prpss INTO ls_prpss.
          CLEAR ls_seq.
          ls_seq-seqno = lines( lt_seq ) + 1.
          ls_seq-pspnr = ls_prpss-pspnr.
          ls_seq-stufe = ls_prpss-stufe.
          ls_seq-posid = ls_prpss-posid.
          ls_seq-post1 = ls_prpss-post1.
          APPEND ls_seq TO lt_seq.
        ENDLOOP.

        SORT lt_seq BY posid.

      ENDIF.

      IF lt_seq IS INITIAL.
        MESSAGE 'No WBS elements found for template'(m02) TYPE 'S' DISPLAY LIKE 'W'.
        RETURN.
      ENDIF.

*--------------------------------------------------------------------*
* 5. Root project node
*--------------------------------------------------------------------*
      lv_last_key = lv_last_key + 1.

      CLEAR ls_node.
      ls_node-node_key   = lv_last_key.
      ls_node-relatkey   = ''.
      ls_node-relatship  = cl_gui_column_tree=>relat_last_child.
      ls_node-hidden     = space.
      ls_node-disabled   = space.
      ls_node-isfolder   = abap_true.
      ls_node-expander   = abap_true.
      APPEND ls_node TO gt_treev_node.

      CLEAR ls_item.
      ls_item-node_key  = lv_last_key.
      ls_item-item_name = gc_hierarchy_short_text.
      ls_item-class     = cl_gui_column_tree=>item_class_text.
      CONCATENATE 'Template:'(v25) ls_projs-post1 INTO ls_item-text SEPARATED BY space.
      APPEND ls_item TO gt_treeitm.

      CLEAR ls_item.
      ls_item-node_key  = lv_last_key.
      ls_item-item_name = gc_hierarchy_technical_key.
      ls_item-class     = cl_gui_column_tree=>item_class_text.
      ls_item-text      = ls_projs-pspid.
      APPEND ls_item TO gt_treeitm.

      CLEAR ls_level_map.
      ls_level_map-stufe    = 0.
      ls_level_map-node_key = lv_last_key.
      APPEND ls_level_map TO lt_level_map.

*--------------------------------------------------------------------*
* 6. Add nodes in exact template sequence
*--------------------------------------------------------------------*
      LOOP AT lt_seq INTO ls_seq.
        lv_index = sy-tabix.

        CLEAR ls_next_seq.
        CLEAR lv_next_stufe.

        READ TABLE lt_seq INTO ls_next_seq INDEX lv_index + 1.
        IF sy-subrc = 0.
          lv_next_stufe = ls_next_seq-stufe.
        ELSE.
          lv_next_stufe = 0.
        ENDIF.

        IF ls_seq-stufe = 1.
          READ TABLE lt_level_map INTO ls_level_map WITH KEY stufe = 0.
        ELSE.
          READ TABLE lt_level_map INTO ls_level_map WITH KEY stufe = ls_seq-stufe - 1.
        ENDIF.

        IF sy-subrc = 0.
          lv_parent_key = ls_level_map-node_key.
        ELSE.
          lv_parent_key = 1.
        ENDIF.

        lv_last_key = lv_last_key + 1.

        CLEAR ls_node.
        ls_node-node_key   = lv_last_key.
        ls_node-relatkey   = lv_parent_key.
        ls_node-relatship  = cl_gui_column_tree=>relat_last_child.
        ls_node-hidden     = space.
        ls_node-disabled   = space.

        IF lv_next_stufe > ls_seq-stufe.
          ls_node-isfolder = abap_true.
          ls_node-expander = abap_true.
        ELSE.
          ls_node-isfolder = abap_false.
          ls_node-expander = space.
        ENDIF.

        APPEND ls_node TO gt_treev_node.

        CLEAR ls_item.
        ls_item-node_key  = lv_last_key.
        ls_item-item_name = gc_hierarchy_short_text.
        ls_item-class     = cl_gui_column_tree=>item_class_text.
        ls_item-text      = ls_seq-post1.
        APPEND ls_item TO gt_treeitm.

        CLEAR ls_item.
        ls_item-node_key  = lv_last_key.
        ls_item-item_name = gc_hierarchy_technical_key.
        ls_item-class     = cl_gui_column_tree=>item_class_text.
        ls_item-text      = ls_seq-posid.
        APPEND ls_item TO gt_treeitm.

        READ TABLE lt_level_map ASSIGNING <lfs_level_map>
          WITH KEY stufe = ls_seq-stufe.
        IF sy-subrc = 0.
          <lfs_level_map>-node_key = lv_last_key.
        ELSE.
          CLEAR ls_level_map.
          ls_level_map-stufe    = ls_seq-stufe.
          ls_level_map-node_key = lv_last_key.
          APPEND ls_level_map TO lt_level_map.
        ENDIF.

        DELETE lt_level_map WHERE stufe > ls_seq-stufe.

      ENDLOOP.

*--------------------------------------------------------------------*
* 7. Display tree
*--------------------------------------------------------------------*
      CALL METHOD lo_tree_preview->delete_all_nodes.

      CALL METHOD lo_tree_preview->hierarchy_header_set_text
        EXPORTING
          text = 'Project Structure: Description' ##NO_TEXT.

      CALL METHOD lo_tree_preview->add_nodes_and_items
        EXPORTING
          node_table                = gt_treev_node
          item_table                = gt_treeitm
          item_table_structure_name = 'CNPB_H_TREEITM' ##NO_TEXT.

      CALL METHOD lo_tree_preview->expand_root_nodes
        EXPORTING
          level_count    = 0
          expand_subtree = abap_true.

      CALL METHOD lo_tree_preview->hierarchy_header_set_width
        EXPORTING
          width     = 50
          width_pix = space.

      CALL METHOD lo_tree_preview->column_set_width
        EXPORTING
          column_name = gc_hierarchy_technical_key
          width       = 25
          width_pix   = space.

      CALL METHOD cl_gui_cfw=>flush
        EXCEPTIONS
          cntl_system_error = 1
          cntl_error        = 2.

      IF sy-subrc = 0.
        lv_tree_loaded = abap_true.
      ENDIF.

    CATCH cx_root INTO DATA(lx_error).
      MESSAGE lx_error->get_text( ) TYPE 'S' DISPLAY LIKE 'E'.
  ENDTRY.
ENDFORM.

