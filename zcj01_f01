*&---------------------------------------------------------------------*
*& Form get_exchange_rate_to_im
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------
FORM get_exchange_rate_to_im
  USING    iv_im_waers      TYPE waers
           iv_proj_waers    TYPE waers
  CHANGING cv_ukurs         TYPE tcurr-ukurs.

  DATA: lt_tcurr TYPE STANDARD TABLE OF tcurr,
        ls_tcurr TYPE tcurr.

  CLEAR cv_ukurs.

  SELECT *
    INTO TABLE lt_tcurr
    FROM tcurr
    WHERE kurst = 'M'
      AND fcurr = iv_im_waers
      AND tcurr = iv_proj_waers.

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  SORT lt_tcurr BY gdatu ASCENDING.
  READ TABLE lt_tcurr INTO ls_tcurr INDEX 1.
  IF sy-subrc = 0.
    cv_ukurs = ls_tcurr-ukurs.
  ENDIF.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form get_im_available_budget_s2
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM get_im_available_budget_s2
  CHANGING cv_im_budget TYPE bpge-wlges
           cv_im_waers  TYPE imtp-waers.

  DATA: lv_objnr     TYPE j_objnr,
        lv_prnam     TYPE impr-prnam,
        lv_gjahr     TYPE impr-gjahr,
        lv_sum_wlges TYPE bpge-wtges,
        lv_sum_wtgev TYPE bpge-wtgev,
        lv_sum_wlgev TYPE bpge-wlgev.

  CLEAR: cv_im_budget,
         cv_im_waers,
         lv_objnr,
         lv_prnam,
         lv_gjahr,
         lv_sum_wlges,
         lv_sum_wtgev,
         lv_sum_wlgev.

  " Get IM object number / program / year
  SELECT SINGLE objnr
                prnam
                gjahr
    INTO (lv_objnr, lv_prnam, lv_gjahr)
    FROM impr
    WHERE posnr = gs_header-posnr.

  IF sy-subrc <> 0
     OR lv_objnr IS INITIAL
     OR lv_prnam IS INITIAL
     OR lv_gjahr IS INITIAL.
    RETURN.
  ENDIF.

  " Get IM currency
  SELECT SINGLE waers
    INTO cv_im_waers
    FROM imtp
    WHERE prnam = lv_prnam
      AND gjahr = lv_gjahr.

  IF sy-subrc <> 0 OR cv_im_waers IS INITIAL.
    CLEAR cv_im_waers.
    RETURN.
  ENDIF.

  " Available IM budget = WTGES - WTGEV - WLGEV
  SELECT SUM( wlges )
         SUM( wlgev )
    INTO (lv_sum_wlges, lv_sum_wlgev)
    FROM bpge
    WHERE objnr = lv_objnr
      AND vorga = 'KBUD'.

  IF sy-subrc = 0.
    cv_im_budget = lv_sum_wlges - lv_sum_wlgev.
  ENDIF.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form validate_total_up_done
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM validate_total_up_done
  CHANGING cv_error TYPE abap_bool.

  DATA: ls_parent     TYPE ty_wbs_display,
        ls_child      TYPE ty_wbs_display,
        lv_tabix      TYPE sy-tabix,
        lv_nextix     TYPE sy-tabix,
        lv_lines      TYPE i,
        lv_sum        TYPE ty_wbs_display-zapproved_budg,
        lv_next_stufe TYPE ps_stufe.

  CLEAR cv_error.

  lv_lines = lines( gt_wbs_display ).
  IF lv_lines IS INITIAL.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* Dynamic hierarchy validation
*---------------------------------------------------------------------*
  LOOP AT gt_wbs_display INTO ls_parent.

    lv_tabix = sy-tabix.
    CLEAR lv_sum.

    lv_nextix = lv_tabix + 1.
    lv_next_stufe = ls_parent-stufe + 1.

    WHILE lv_nextix <= lv_lines.

      READ TABLE gt_wbs_display INTO ls_child INDEX lv_nextix.
      IF sy-subrc <> 0.
        EXIT.
      ENDIF.

      " Stop when next sibling or higher parent starts
      IF ls_child-stufe <= ls_parent-stufe.
        EXIT.
      ENDIF.

      " Only direct children
      IF ls_child-stufe = lv_next_stufe.
        lv_sum = lv_sum + ls_child-zapproved_budg.
      ENDIF.

      lv_nextix = lv_nextix + 1.

    ENDWHILE.

*---------------------------------------------------------------------*
* Validation
*---------------------------------------------------------------------*
    " If child total is zero, consider valid
    " Only validate when child total is greater than zero
    IF lv_sum > 0.

      IF ls_parent-zapproved_budg < lv_sum.
        IF gv_req_type = 'B2'.
          MESSAGE e000(zmsg_a2r)
            WITH 'Budget is greater than Level 1.'(m61).
        ELSE.
          MESSAGE e000(zmsg_a2r)
            WITH 'Budget mismatch. Total Up required.'(m35).
        ENDIF.

        cv_error = abap_true.
        RETURN.
      ENDIF.

    ENDIF.

  ENDLOOP.

ENDFORM.

