* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_REQUEST_FLEXWF->CONSTRUCTOR
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_REQNUM                      TYPE        ZDE_A2R_REQNUM
* | [--->] IT_L1APPROVER                  TYPE        HPA_T_BNAME(optional)
* | [--->] IT_L2APPROVER                  TYPE        HPA_T_BNAME(optional)
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR(optional)
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD constructor.
    me->ms_lpor-catid  = cl_swf_evt_event=>mc_objcateg_cl.
    me->ms_lpor-typeid = 'ZCL_A2R_WBS_REQUEST_FLEXWF'.
    me->ms_lpor-instid = iv_reqnum.
    gv_reqnum = iv_reqnum.
    me->mt_l1approver = it_l1approver.
    me->mt_l2approver = it_l2approver.
    me->ms_header = is_header.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_REQUEST_FLEXWF->SUBMIT
* +-------------------------------------------------------------------------------------------------+
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD submit.
    DATA:
      lv_event            TYPE        sibfevent,
      lv_objkey           TYPE        sibfinstid,
      lr_event_parameters TYPE REF TO cl_swf_cnt_container.


    CREATE OBJECT lr_event_parameters.

    lv_event  = me->mv_event_id.
    lv_objkey = me->gv_reqnum.
    DATA(lv_typeid) = 'ZCL_A2R_WBS_REQUEST_FLEXWF'.

    TRY.
        CALL METHOD lr_event_parameters->if_swf_cnt_element_access_1~element_set_value
          EXPORTING
            name  = 'IV_HEADER'
            value = me->ms_header.
      CATCH cx_root .
    ENDTRY.

    TRY.
        CALL METHOD lr_event_parameters->if_swf_cnt_element_access_1~element_set_value
          EXPORTING
            name  = 'IT_L1APPROVER'
            value = me->mt_l1approver.
      CATCH cx_root .
    ENDTRY.

    TRY.
        CALL METHOD lr_event_parameters->if_swf_cnt_element_access_1~element_set_value
          EXPORTING
            name  = 'IT_L2APPROVER'
            value = me->mt_l2approver.
      CATCH cx_root .
    ENDTRY.

*    TRY.
*        CALL METHOD lr_event_parameters->if_swf_cnt_element_access_1~element_set_value
*          EXPORTING
*            name  = 'Submitter'
**            value = 'US' && sy-uname.
*            value = 'US' && 'HQ75177'.
*      CATCH cx_root .
*    ENDTRY.

    TRY.
        CALL METHOD cl_swf_evt_event=>raise
          EXPORTING
            im_objcateg        = cl_swf_evt_event=>mc_objcateg_cl
            im_objtype         = lv_typeid
            im_event           = lv_event
            im_objkey          = lv_objkey
            im_event_container = lr_event_parameters.
        COMMIT WORK.
      CATCH cx_swf_evt_invalid_objtype .
      CATCH cx_swf_evt_invalid_event .
    ENDTRY.
  ENDMETHOD.
