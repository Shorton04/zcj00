*----------------------------------------------------------------------*
*form vcopy_dyn_fm_mgr_enq using enq.                       "KI4K012083
FORM VCOPY_DYN_FM_MGR_ENQ USING ENQ VALUE(P_CHECK_ONLY).    "KI4K012083

  DATA: L_VERSION_ACTIVATE_MODE LIKE FM01-VERSACT.



*----Neue/alte Sperrlogik
  CALL FUNCTION 'FM17_ACTIVATION_MODE_GET'
       EXPORTING
            I_FIKRS                 = VCOPY_DYN_FM_MGR-FIKRS
       IMPORTING
            E_VERSION_ACTIVATE_MODE = L_VERSION_ACTIVATE_MODE
       EXCEPTIONS
            OTHERS                  = 1.

  IF SY-SUBRC = 0 AND
      L_VERSION_ACTIVATE_MODE = G_CON_VERSIONACTIVATE.
    MESSAGE E453(BP) WITH VCOPY_DYN_FM_MGR-FIKRS.
  ENDIF.

*----Budget ausgewählt?
  IF  BPDY-V_AKTU IS INITIAL AND BPDY-V_FREIG IS INITIAL.
    MESSAGE E091.
  ENDIF.

*-----Berechtigung Version sperren
  IF ENQ = ON.
    PERFORM VERSION_CHECK_AUTHORITY USING FMAU_VE_BLO BPDY-V_VERS_V
                                          FMPS-FIKRS.
  ELSE.
*-----Berechtigung Version entsperren
    PERFORM VERSION_CHECK_AUTHORITY USING FMAU_VE_UBL BPDY-V_VERS_V
                                          FMPS-FIKRS.
  ENDIF.

*-----Objektnummer aufbereiten
  DATA: L_OBJNR LIKE BPHI-OBJNR.

  CALL FUNCTION 'KBPS_OBJHI_NAME_GENERATE'
       EXPORTING
            I_APPLICATION = L_FUNDS
            I_FM_AREA     = FMPS-FIKRS
       IMPORTING
            E_OBJHI       = L_OBJNR.

*-----Selekt vorbeiten
  RANGES L_T_WRTTP FOR BPHI-WRTTP.
  RANGES L_T_GEBER FOR BPHI-GEBER.

  IF BPDY-V_GEBER IS INITIAL.
    MOVE: 'I'         TO L_T_GEBER-SIGN,
          'EQ'        TO L_T_GEBER-OPTION,
           FMPS-GEBER TO L_T_GEBER-LOW.
    APPEND L_T_GEBER.
  ENDIF.

  MOVE: 'I'         TO L_T_WRTTP-SIGN,
        'EQ'        TO L_T_WRTTP-OPTION.

  IF NOT BPDY-V_AKTU IS INITIAL.
    MOVE L_WFBUDGET TO L_T_WRTTP-LOW.
    APPEND L_T_WRTTP.
    MOVE L_WPBUDGET TO L_T_WRTTP-LOW.                       "KI3K035142
    APPEND L_T_WRTTP.                                       "KI3K035142
*-----Vorerfassung
    L_T_WRTTP-LOW = L_WFBUDRES.
    APPEND L_T_WRTTP.
    L_T_WRTTP-LOW = L_WFBUDNOTE.
    APPEND L_T_WRTTP.
    L_T_WRTTP-LOW = L_WPBUDRES.
    APPEND L_T_WRTTP.
    L_T_WRTTP-LOW = L_WPBUDNOTE.
    APPEND L_T_WRTTP.
*-----kommunale Werttypen mit aktuellem Budget behandeln          "DKOM
    L_T_WRTTP-LOW = L_WFFINPLAN.       "DKOM
    APPEND L_T_WRTTP.                  "DKOM
    L_T_WRTTP-LOW = L_WFBUDSTAT.       "DKOM
    APPEND L_T_WRTTP.                  "DKOM
    L_T_WRTTP-LOW = L_WFBUDTOT.                            "GesKost
    APPEND L_T_WRTTP.
    L_T_WRTTP-LOW = L_WFBUDRERG.       "DKOM
    APPEND L_T_WRTTP.                  "DKOM
    L_T_WRTTP-LOW = L_WFSTAT.          "DKOM
    APPEND L_T_WRTTP.                  "DKOM
    L_T_WRTTP-LOW = L_WFRERGSTAT.      "DKOM
    APPEND L_T_WRTTP.                  "DKOM
    L_T_WRTTP-LOW = L_WFFIPLSTAT.      "DKOM
    APPEND L_T_WRTTP.                  "DKOM
  ENDIF.
  IF NOT BPDY-V_FREIG IS INITIAL.
    MOVE L_WFRELEASE TO L_T_WRTTP-LOW.
    APPEND L_T_WRTTP.
    MOVE L_WPRELEASE TO L_T_WRTTP-LOW.                      "KI3K035142
    APPEND L_T_WRTTP.                                       "KI3K035142
*-----Vorerfassung
    L_T_WRTTP-LOW = L_WFRELRES.
    APPEND L_T_WRTTP.
    L_T_WRTTP-LOW = L_WFRELNOTE.
    APPEND L_T_WRTTP.
    L_T_WRTTP-LOW = L_WPRELRES.
    APPEND L_T_WRTTP.
    L_T_WRTTP-LOW = L_WPRELNOTE.
    APPEND L_T_WRTTP.
  ENDIF.

  IF P_CHECK_ONLY = OFF.                                    "KI4K012083
    UPDATE BPHI SET GESPERRT = ENQ
                WHERE OBJNR = L_OBJNR
                AND   WRTTP IN L_T_WRTTP
                AND   GEBER IN L_T_GEBER
                AND   VERSN = BPDY-V_VERS_V.

