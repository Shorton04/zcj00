*&---------------------------------------------------------------------*
*&      Form  VCOPY_DYN_CJ_MGR_REQV_VERS
*&---------------------------------------------------------------------*
*       F4 fuer Versionen - Projekte                                   *
*                                                                      *
*   * Destination-Version: es werden alle Versionen angezeigt          *
*                                                                      *
*   * Source-Version: es werden wahlweise "alle Versionen" oder die    *
*     "erstellten Versionen" angezeigt. Fuer die "erstellten Versioen" *
*     wird die Eingabe in dem Dynprofeld    "Finanzkreis"              *
*     beruecksichtigt - es wird nicht zwischen Kostenplan und          *
*     Erloesplan unterschieden.                                        *
*                                                                      *
*----------------------------------------------------------------------*
*  -->  p_is_source_vers:  ON = Versionen anzeigen, die als Source
*                               beim Versions-Kopieren verwendbar sind
*                          OFF= Versionen anzeigen, die als Destination
*                               beim Versions-Kopieren verwendbar sind
*  <--
*----------------------------------------------------------------------*
FORM VCOPY_DYN_CJ_MGR_REQV_VERS USING VALUE(P_IS_SOURCE_VERS).

  DATA: L_VERSION LIKE BPDY-V_VERS_V,
        L_COP_VERSN,
        L_ALL_VERSN.
  DATA: L_SUBRC LIKE SY-SUBRC.

  DATA: BEGIN OF L_PROJ.
          INCLUDE STRUCTURE PROJ.
  DATA: END OF L_PROJ.


*-----init
  L_SUBRC = 0.

*-----Dynprofelder lesen
  REFRESH DYNP.
  CLEAR DYNP.
  DYNP-FIELDNAME = 'PROJ-PSPID'.
  APPEND DYNP.

  CALL FUNCTION 'DYNP_VALUES_READ'
       EXPORTING
            DYNAME     = 'SAPMKBUD'
            DYNUMB     = SY-DYNNR
       TABLES
            DYNPFIELDS = DYNP
       EXCEPTIONS
            OTHERS     = 1.

  IF SY-SUBRC IS INITIAL.
    READ TABLE DYNP INDEX 1.
  ENDIF.

  IF SY-SUBRC IS INITIAL.
    PROJ-PSPID = DYNP-FIELDVALUE.

    CALL FUNCTION 'CONVERSION_EXIT_PROJN_INPUT'
         EXPORTING
              INPUT         = PROJ-PSPID
         IMPORTING
              OUTPUT        = PROJ-PSPID
         EXCEPTIONS
              ERROR_MESSAGE = 1.

    IF SY-SUBRC = 1.
      MESSAGE ID SY-MSGID TYPE 'S' NUMBER SY-MSGNO
                 WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
      L_SUBRC = 1.
    ENDIF.

*-----Projekt angegeben?
    IF L_SUBRC = 0.
      IF PROJ-PSPID IS INITIAL.
        MESSAGE S003(CJ).
        L_SUBRC = 1.
      ENDIF.
    ENDIF.

*-----Projekt einlesen
    IF L_SUBRC = 0.
      CALL FUNCTION 'CJDW_PROJ_SELECT_SINGLE'
           EXPORTING
                PSPID     = PROJ-PSPID
           IMPORTING
                E_PROJ    = L_PROJ
           EXCEPTIONS
                NOT_FOUND = 01.

      IF SY-SUBRC = 1.
        MESSAGE S011(CJ) WITH PROJ-PSPID.
        L_SUBRC = 1.
      ENDIF.
    ENDIF.

*-----Versionen anzeigen
    IF L_SUBRC = 0.
      IF P_IS_SOURCE_VERS = ON.
*-----Source: wahlweise die erstellten oder alle Versionen anzeigen,
        L_COP_VERSN = OFF.
        L_ALL_VERSN = OFF.
      ELSE.
*-----Destination: immer alle Versionen anzeigen
        L_COP_VERSN = ON.
        L_ALL_VERSN = ON.
      ENDIF.

      CALL FUNCTION 'KBPS_SHOW_VERSIONS'
           EXPORTING
                APPLIK       = VCOPY_DYN_MGR-APPLICATION
                OBJECT       = L_PROJ-OBJNR
                WRTTP        = L_WPLAN
                IM_KOKRS     = L_PROJ-VKOKR
                IM_COP_VERSN = L_COP_VERSN
                IM_ALL_VERSN = L_ALL_VERSN
           IMPORTING
                VERSION      = L_VERSION
           EXCEPTIONS
                NO_VERSIONS  = 01.

      IF SY-SUBRC IS INITIAL.
        IF P_IS_SOURCE_VERS = ON.
          BPDY-V_VERS_V = L_VERSION.
        ELSE.
          BPDY-V_VERS_Z = L_VERSION.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

ENDFORM.



