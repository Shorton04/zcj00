*&---------------------------------------------------------------------*
*&      Form  leave_to_current_transaction
*&---------------------------------------------------------------------*
*       check if transaction variant is used
*----------------------------------------------------------------------*

FORM leave_to_current_transaction .

  DATA p_tcvariant  LIKE shdtvciu-tcvariant VALUE space.
  DATA p_returncode TYPE syst-subrc         VALUE 0.
  DATA p_flag_client_independent.

* the end must also take the transaction variant into account
  CALL FUNCTION 'RS_HDSYS_GET_TC_VARIANT'
    IMPORTING
      tcvariant               = p_tcvariant
      flag_client_independent = p_flag_client_independent
      rc                      = p_returncode.

  IF p_returncode = 4.
* no variant is active
    LEAVE TO TRANSACTION sy-tcode.

  ELSE.
* back to transaction variant
    CALL FUNCTION 'RS_HDSYS_CALL_TC_VARIANT'
      EXPORTING
        tcode                     = sy-tcode
        variant                   = p_tcvariant
        i_flag_client_independent = p_flag_client_independent
        call_mode                 = ' '  " LEAVE TO TRANSACTION
        authority_check           = 'X'
        variant_check             = 'X'
      EXCEPTIONS
        no_variant                = 1
        no_authority_tcode        = 2
        OTHERS                    = 3.
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.
  ENDIF.

ENDFORM.                    " leave_to_current_transaction
*                                                " beg_ins " n. 971073
form determine_bpin_twaer_rollup
  changing c_bpin  like bpin
           c_tbp1c like tbp1c
           c_twaer like bpge-twaer.

  data: l_orgwaer like tka01-waers,
        l_psphi   like prps-psphi,
        l_tfill   like sy-tfill.

  data: begin of tab_objcurr occurs 10,
          waers like tka01-waers,
        end   of tab_objcurr.

* Die Funktion "Hochsummieren" ist nur erlaubt,
* wenn die Transaktiosnwährung für alle Elemente
* der Hierarchie gleich ist.
* Also ist "Hochsummieren" nicht erlaubt bei
* unterschiedlichen Objektwährungen innerhalb
* der Hierarchie und
* -  Planungs-/Budgetierungswährung = Objektwährung oder
* -  Planungs-/Budgetierungswährung = Transaktionswährung
*    mit Default = Objektwährung und nicht explizit
*    angegebener Transaktionswährung.
  check (   c_tbp1c-curobj <> space       or
          ( c_tbp1c-curtra <> space   and
            c_tbp1c-obj    <> space   and
            bpdy-twaer     is initial )   ).

* Investitionsprogramm.
  if c_bpin-applik = l_iprog.
*   Kreiswährung bestimmen.
    select  single waers
      from  imtp
      into  (l_orgwaer)
      where prnam = imtp-prnam
      and   gjahr = impr-gjahr.
*   Bestimme alle im Investitionsprogramm
*   vorkommenden Objektwährungen.
    select  distinct owaers as waers
      from  impr
      into  corresponding fields of table tab_objcurr
      where prnam = imtp-prnam
      and   gjahr = impr-gjahr.
    loop at tab_objcurr
      where waers is initial.
      tab_objcurr-waers = l_orgwaer.
      modify tab_objcurr.
    endloop.
  endif.

* Projekt.
  if bpin-applik = l_project.
*   Projektdefinition angegeben.
    if not proj-pspid is initial.
*     Bestimme alle im Projekt
*     vorkommenden Objektwährungen.
      select  distinct pwpos as waers
        from  proj inner join prps
                on proj~pspnr = prps~psphi
        into  corresponding fields of table tab_objcurr
        where pspid = proj-pspid.
*   PSP-Element angegeben.
    elseif not prps-posid is initial.
*     Bestimme alle im Projekt
*     vorkommenden Objektwährungen.
      select  single psphi
        from  prps
        into  (l_psphi)
        where posid = prps-posid.
      select  distinct prps~pwpos as waers
        from  proj inner join prps
                on proj~pspnr = prps~psphi
        into  corresponding fields of table tab_objcurr
        where proj~pspnr = l_psphi.
    endif.
  endif.

* Wie viele Objektwährungen gibt es in der Hierarchie?
  sort tab_objcurr by waers.
  delete adjacent duplicates from tab_objcurr
    comparing waers.
  describe table tab_objcurr lines l_tfill.
  case l_tfill.
* Keine.
  when 0.
    exit.
* Genau eine.
  when 1.
*   Dann ist Transaktionswährung = Objektwährung.
    read table tab_objcurr index 1.
    c_twaer = tab_objcurr-waers.
*   Merke: Transaktionswährung explizit gesetzt            " n. 2231415
*   und Transaktionswährung = Objektwährung                " n. 2231415
*   für alle Elemente des Proj./Inv.prog.                  " n. 2231415
    c_bpin-all_farea = 'O'.                                " n. 2231415
* Mehr als eine.
  when others.
*   Merke: "Hochsummieren" nicht erlaubt.
    c_bpin-all_farea = 'N'.
    clear c_tbp1c-bottomup.
  endcase.

endform.
*                                                " end_ins " n. 971073


