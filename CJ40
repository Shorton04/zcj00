*       Fehlerprotokoll anzeigen oder drucken                          *
*----------------------------------------------------------------------*
*  -->  print_prot  ON: Fehlerprotokoll drucken
*                   OFF: Fehlerprotokoll anzeigen
*       p_title     0: Fehlerprotokoll
*                   1: Finanzbudgetversion
*                   2: Kostenplanung
*                   3: Erloesplanung
*----------------------------------------------------------------------*
FORM errorprot_proc USING value(print_prot) value(p_title).

  DATA  BEGIN OF t_msg OCCURS 10.      "*** die Message Zeilen
          INCLUDE STRUCTURE mesg.
  DATA  END OF t_msg.

  DATA: BEGIN OF p_msg OCCURS 10,      "zu Druckendes der Message-Zeilen
          zeile LIKE mesg-zeile,
          s1,                          "SPACE
          msgty LIKE mesg-msgty,
          s2,                          "SPACE
          text  LIKE mesg-text,
        END OF p_msg.

  DATA  msg_lines TYPE i.

  DATA  l_err_prot_title LIKE mesg-text.

  DATA  l_valid.

  DATA  l_params LIKE pri_params.



  IF print_prot = on.
*-----Fehlerprotokoll drucken
*-----hole angefallene Messages
    REFRESH t_msg.

    CALL FUNCTION 'MESSAGES_GIVE'
         TABLES
              t_mesg = t_msg.

    DESCRIBE TABLE t_msg LINES msg_lines.

    IF msg_lines EQ 0.
      MESSAGE s168(gp).
    ELSE.
*-----Drucken
      CALL FUNCTION 'GET_PRINT_PARAMETERS'
           IMPORTING
                out_parameters         = l_params
                valid                  = l_valid
           EXCEPTIONS
                archive_info_not_found = 01
                invalid_print_params   = 02
                invalid_archive_params = 03.

      IF sy-subrc = 0 AND NOT l_valid IS INITIAL.
        NEW-PAGE PRINT ON PARAMETERS l_params NO DIALOG.
        ULINE.
        WRITE 'Fehlerprotokoll'(309).
        ULINE.
        SKIP.
        LOOP AT t_msg.
          CLEAR p_msg.
          MOVE-CORRESPONDING t_msg TO p_msg.
          WRITE p_msg.
          NEW-LINE.
        ENDLOOP.
        NEW-PAGE PRINT OFF.
      ENDIF.
    ENDIF.
  ELSE.
*-----Fehlerprotokoll anzeigen
    CASE p_title.
      WHEN 0.
*-----Fehlerprotokoll
        l_err_prot_title = text-309.
      WHEN 1.
*-----Finanzbudgetversion
        l_err_prot_title = text-312.
      WHEN 2.
*-----Kostenplanung
        l_err_prot_title = text-310.
      WHEN 3.
*-----Erloesplanung
        l_err_prot_title = text-311.
      WHEN OTHERS.
*-----Fehlerprotokoll
        l_err_prot_title = text-309.
    ENDCASE.
    CALL FUNCTION 'MESSAGES_SHOW'
         EXPORTING
              object      = l_err_prot_title
         EXCEPTIONS
              no_messages = 01.

    IF sy-subrc EQ 1.
      MESSAGE s168(gp).
    ENDIF.
  ENDIF.

ENDFORM.



