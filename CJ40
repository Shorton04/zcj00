*&---------------------------------------------------------------------*
*&      Form  VCOPY_DYN_CJ_MGR_COPY_VERS
*&---------------------------------------------------------------------*
*       Version kopieren                                               *
*----------------------------------------------------------------------*
*  -->
*  <--
*  read access glob. Var.:
*  proj und prps (werden beide beim Einlesen des Projektes gesetzt)
*----------------------------------------------------------------------*
FORM VCOPY_DYN_CJ_MGR_COPY_VERS
                  USING VALUE(P_GSBER)
                        VALUE(P_PROFIL)
                        VALUE(P_OBJHI).


  DATA: L_COPY_MODE,
        L_OBJECT LIKE BPIN-OBJNR,
        L_STATISTIC,
       L_DETAIL,
       L_OVERWRITE_CHECK.                                   "ALRK023069

  STATICS: L_MULTI.                                         "ALRK023069

  DATA: BEGIN OF L_BPIN.
          INCLUDE STRUCTURE BPIN.
  DATA: END OF L_BPIN.

  DATA: BEGIN OF L_TIME.
          INCLUDE STRUCTURE BPTIME.
  DATA: END OF L_TIME.

  DATA: BEGIN OF LT_COPY OCCURS 10.
          INCLUDE STRUCTURE BPCOPY.
  DATA: END OF LT_COPY.



*-----Kopiermodus
  IF VCOPY_DYN_CJ_MGR-COPY_RESET = ON.
    L_COPY_MODE = VERSION_CMODE_DEST_OVERWR.
  ELSE.
    L_COPY_MODE = VERSION_CMODE_DEST_KEEP.
  ENDIF.

*-----Tabelle mit den zu kopierenden Vorgaengen erzeugen
  CLEAR LT_COPY.

*-----Strukturplanwert
  IF VCOPY_DYN_CJ_MGR-V_PSP = ON.
    LT_COPY-WRTTP      = L_WPLAN.
    IF VCOPY_DYN_CJ_MGR-IS_COST_PL = ON.
*-----Kostenplanung:
*-----Strukturplanwert Kosten (KSTP)
      LT_COPY-SRC_VORGA = L_VPLAN.
      APPEND LT_COPY.
    ELSE.
*-----Erloesplanung:
*-----Strukturplan Erloese (RKP5), SD-Angebot(SDQU), SD-Auftrag(SDOR)
*-----!!!RKP5 heisst seit 3.0.A KSTR !!!
      LT_COPY-SRC_VORGA = L_VKPE.
      APPEND LT_COPY.
      LT_COPY-SRC_VORGA = L_VSDOR.
      APPEND LT_COPY.
      LT_COPY-SRC_VORGA = L_VSDQU.
      APPEND LT_COPY.
    ENDIF.
  ENDIF.

*-----Einzelkalkulation
  IF VCOPY_DYN_CJ_MGR-V_EINZKALK = ON.
    LT_COPY-WRTTP = L_WPLAN.
    LT_COPY-SRC_VORGA = L_VKALC.
    APPEND LT_COPY.
  ENDIF.

*-----Statistische Kennzahlen
  IF VCOPY_DYN_CJ_MGR-V_COST = ON OR VCOPY_DYN_CJ_MGR-V_ERLOESE = ON.
    L_STATISTIC = ON.
  ELSE.
    L_STATISTIC = OFF.
  ENDIF.

*-----Detailplanung implizit bei Auswahl von Kostenarten/Erloesarten
  IF VCOPY_DYN_CJ_MGR-V_COST = ON OR VCOPY_DYN_CJ_MGR-V_ERLOESE = ON.
    L_DETAIL = ON.
  ELSE.
    L_DETAIL = OFF.
  ENDIF.

*-----Zeitraum festlegen
  L_TIME-TOTAL_VAL  = VCOPY_DYN_CJ_MGR-V_GESAMT.
  L_TIME-PERIOD_VAL = OFF.

  IF VCOPY_DYN_CJ_MGR-V_YEAR_X = ON.
    L_TIME-YEAR_VAL     = ON.
    L_TIME-Y_SRC_FRST   = VCOPY_DYN_CJ_MGR-V_YEAR_XS.
    L_TIME-Y_SRC_LAST   = VCOPY_DYN_CJ_MGR-V_YEAR_XE.
    L_TIME-Y_DST_FRST   = VCOPY_DYN_CJ_MGR-V_YEAR_XS.
  ELSE.
    L_TIME-YEAR_VAL     = OFF.
    CLEAR L_TIME-Y_SRC_FRST.
    CLEAR L_TIME-Y_SRC_LAST.
    CLEAR L_TIME-Y_DST_FRST.
  ENDIF.

