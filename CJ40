*---------------------------------------------------------------------*
*     FORM   !OKCODE
*---------------------------------------------------------------------*
*     Auswertung OK-Code                                              *
*---------------------------------------------------------------------*
FORM okcode.

  CASE okcode.

    WHEN 'BACK'.
      SET SCREEN 0. LEAVE SCREEN.

    WHEN 'EESC'.
      SET SCREEN 0. LEAVE SCREEN.

    WHEN 'ERET'.
      SET SCREEN 0. LEAVE SCREEN.

    WHEN 'CLAS'.
      PERFORM classification_select.
      LEAVE SCREEN.

    WHEN 'SELE'.
      PERFORM select_level.
      LEAVE SCREEN.

    WHEN 'FISI'.                       "DKOM
      PERFORM master_data USING on.    "DKOM
      LEAVE SCREEN.                    "DKOM

    WHEN 'POSI'.                       "DKOM
      PERFORM master_data USING on.    "DKOM
      LEAVE SCREEN.                    "DKOM

    WHEN 'MSEL'.                       "DKOM
      PERFORM master_data_select.      "DKOM
      LEAVE SCREEN.                    "DKOM

    WHEN 'EKKS'.                       "KoReKreis setzen     K11K119820
      CLEAR okcode.
      CALL FUNCTION 'K_KOKRS_SET'
        EXPORTING
          popup   = '1'
        IMPORTING
          e_kokrs = kostv-kokrs.
      SET SCREEN sy-dynnr.             "Dynpro nochmal prozessieren
      LEAVE SCREEN.

    WHEN 'EOKS'.                       "KoReKreis setzen
      CLEAR okcode.
      CALL FUNCTION 'K_KOKRS_SET'
        EXPORTING
          popup   = '1'
        IMPORTING
          e_kokrs = codia-kokrs.
      SET SCREEN sy-dynnr.             "Dynpro nochmal prozessieren
      LEAVE SCREEN.

    WHEN 'KSH3'.                       "Anzeige Kostenstellengruppe
      CLEAR okcode.
      IF kostv-ksgru NE space.
        SET PARAMETER ID 'CAC' FIELD kostv-kokrs.
        SET PARAMETER ID 'HNA' FIELD kostv-ksgru.
        CALL TRANSACTION 'KSH3' AND SKIP FIRST SCREEN.
      ENDIF.
      LEAVE SCREEN.

    WHEN 'FPRT'.                       "Anzeige Fehlerprotokoll
      CLEAR okcode.
      CALL FUNCTION 'MESSAGES_SHOW'
        EXPORTING
          show_linno  = space
        EXCEPTIONS
          no_messages = 1.
      IF sy-subrc = 1.
        MESSAGE s168(gp).
      ENDIF.
*     leave screen.
      LEAVE TO TRANSACTION sy-tcode.

    WHEN 'ENTE'.

    WHEN OTHERS.
      PERFORM start.

  ENDCASE.

ENDFORM.                    "OKCODE


*---------------------------------------------------------------------*
*     FORM   !START
*---------------------------------------------------------------------*
*     Start Budgetierung / Planung                                    *
*---------------------------------------------------------------------*
FORM start.

*-----Transaktionscode
  bpin-tcode = okcode = sy-tcode.

*-----Aktionen gemaess Okcode
  CASE okcode.

*-----Projekte Budget/Plan: Check KOKRS                     "ALRK203311
    WHEN 'CJ30' OR 'CJ31' OR                                "ALRK203311
         'CJ32' OR 'CJ33' OR                                "ALRK203311
         'CJ37' OR 'CJ38' OR                                "ALRK203311
         'CJ40' OR 'CJ41' OR                                "ALRK203311
         'CJ42' OR 'CJ43' OR                                "ALRK203311
         'CJ48' OR 'CJ49'.                                  "ALRK203311
      PERFORM check_projekt_kokrs.                          "ALRK203311

*-----Maßnahmenanforderung Plan                             "E40K000323
    WHEN 'IMAP' OR 'IMAQ'  OR                               "E40K000323
         'IMAR' OR 'IMAS'.                                  "E40K000323
      PERFORM anforderung_dy600.                            "E40K000323

*-----Maßnahmenanforderung Plan Cash Flow                   "ALRK032074
    WHEN 'IMAV' OR 'IMAW'.                                  "ALRK032074
      PERFORM anforderung_dy600.                            "ALRK032074


*-----Auftrag Original Plan Update
    WHEN 'KO12'.
      PERFORM auftrag_dy300.

*-----Auftrag Original Plan Anzeige
    WHEN 'KO13'.
      PERFORM auftrag_dy300.

*-----Auftrag Original Budget Update
    WHEN 'KO22'.
      PERFORM auftrag_dy300.
      PERFORM determine_bpin_twaer.

*-----Auftrag Original Budget Anzeige
    WHEN 'KO23'.
      PERFORM auftrag_dy300.
      PERFORM determine_bpin_twaer.

*-----Auftrag Nachtrag Update
    WHEN 'KO24'.
      PERFORM auftrag_dy300.
      PERFORM determine_bpin_twaer.

*-----Auftrag Nachtrag Anzeige
    WHEN 'KO25'.
      PERFORM auftrag_dy300.
      PERFORM determine_bpin_twaer.

*-----Auftrag Rueckgabe Update
    WHEN 'KO26'.
      PERFORM auftrag_dy300.
      PERFORM determine_bpin_twaer.

*-----Auftrag Rueckgabe Anzeige
    WHEN 'KO27'.
      PERFORM auftrag_dy300.
      PERFORM determine_bpin_twaer.

*-----Fertigungsauftrag Plan Update
    WHEN 'KKF4'.
      PERFORM auftrag.

*-----Fertigungsauftrag Plan Anzeige
    WHEN 'KKF5'.
      PERFORM auftrag.

*-----Kostenstelle Etat  Update
    WHEN 'KPZ2'.
      PERFORM kostenstelle.

*-----Kostenstelle Etat Anzeige
    WHEN 'KPZ3'.
      PERFORM kostenstelle.

  ENDCASE.

*---Routine DETERMINE_BPIN_TWAER kann unabhängig vom TCODE "MCUR
*   gerufen werden                                         "MCUR
  PERFORM determine_bpin_twaer.                            "MCUR

*-----Prozessor aufrufen incl. Initialisierung
  PERFORM bp_start USING on.

*-----Buchen
  PERFORM bp_post.

*----Batch-Input
*                                                " beg_del " n. 834956
* IF NOT SY-BINPT IS INITIAL OR NOT SY-CALLD IS INITIAL.
*   LEAVE.
* ENDIF.
*                                                " end_del " n. 834956
  IF sy-calld IS INITIAL.                                   " n. 834956
    IF NOT sy-binpt IS INITIAL.                             " n. 834956
      LEAVE TO TRANSACTION space.                           " n. 834956
    ENDIF.                                                  " n. 834956
  ELSE.                                                     " n. 834956
    LEAVE.                                                  " n. 834956
  ENDIF.                                                    " n. 834956

*-----Beenden
  IF bpex-end = on.
    SET SCREEN 0. LEAVE SCREEN.
  ELSE.
*-----Ende
    PERFORM leave_to_current_transaction.
  ENDIF.

ENDFORM.                    "START
