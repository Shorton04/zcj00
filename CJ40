*---------------------------------------------------------------------*
*     FORM !READ_KOSTL                                                *
*---------------------------------------------------------------------*
*     Selektion und ENQUEUE KOSTL                                     *
*---------------------------------------------------------------------*
FORM READ_KOSTL.
  DATA: TABIX LIKE SY-TABIX.

  DATA: BEGIN OF DATE_TAB OCCURS 0,                     "P30K122162
          DATE_FROM LIKE SY-DATLO,                      "P30K122162
          DATE_TO   LIKE SY-DATLO,                      "P30K122162
        END OF DATE_TAB.                                "P30K122162

  IF SY-TCODE = 'KPZ2'.
    VARC1 = 'X'.                     "Schalter f. enqueue
  ELSE.
    VARC1 = SPACE.
  ENDIF.
    VRGNG = L_VBUD.                    "Vorgang KBUD
* Message-Handler einschalten, wenn nicht aktiv
  CALL FUNCTION 'MESSAGES_ACTIVE'                           "ALRK026412
       EXCEPTIONS                                           "ALRK026412
            NOT_ACTIVE   = 1.                               "ALRK026412
  IF SY-SUBRC = 1.                                          "ALRK026412
    CALL FUNCTION 'MESSAGES_INITIALIZE'
         EXPORTING                                          "ALRK026412
              I_IDENTIFICATION =  MSG_IDENT                 "ALRK026412
         IMPORTING                                          "ALRK026412
              E_IDENTIFICATION =  MSG_IDENT.                "ALRK026412
  ENDIF.                                                    "ALRK026412
  IF NOT KOSTV-KOSTL IS INITIAL.
*   Einzelne Kostl lesen und prüfen
    CALL FUNCTION 'K_KOSTL_CHECK_SET'
         EXPORTING
              VERSN     = KOSTV-VERSN
              KOKRS     = KOSTV-KOKRS
              KOSTL     = KOSTV-KOSTL
              DATUM_AB  = MINDATUM
              DATUM_BIS = MAXDATUM
              ENQUEUE   = VARC1
              VRGNG     = VRGNG
         IMPORTING
              TABIX     = TABIX.
    IF TABIX NE 0.
      CALL FUNCTION 'K_KOSTL_GET_SINGLE'
           EXPORTING
                INDEX   = 1
           IMPORTING
                I_KOSTV = F_KOSTV.
      KOSTV-KTEXT = F_KOSTV-KTEXT.
    ENDIF.
  ELSEIF NOT KOSTV-KSGRU IS INITIAL.
*   Kostenstellengruppe lesen und prüfen
*   Devide date interval into single intervals for every year
    REFRESH DATE_TAB.                                   "P30K122162
    DATE_TAB-DATE_FROM  = MINDATUM.                     "P30K122162
    WHILE DATE_TAB-DATE_FROM(4) < MAXDATUM(4).          "P30K122162
      DATE_TAB-DATE_TO+4(4) = '1231'.                   "P30K122162
      DATE_TAB-DATE_TO(4)   = DATE_TAB-DATE_FROM(4).    "P30K122162
      APPEND DATE_TAB.                                  "P30K122162
      DATE_TAB-DATE_FROM+4(4) = '0101'.                 "P30K122162
      DATE_TAB-DATE_FROM(4) = DATE_TAB-DATE_FROM(4) + 1."P30K122162
    ENDWHILE.                                           "P30K122162
    DATE_TAB-DATE_TO = MAXDATUM.                        "P30K122162
    APPEND DATE_TAB.                                    "P30K122162

    LOOP AT DATE_TAB.                                   "P30K122162
      CALL FUNCTION 'K_KOSTL_CHECK_SET'
           EXPORTING
                VERSN     = KOSTV-VERSN
                KSGRU     = KOSTV-KSGRU
                KOKRS     = KOSTV-KOKRS
                DATUM_AB  = DATE_TAB-DATE_FROM          "P30K122162
                DATUM_BIS = DATE_TAB-DATE_TO            "P30K122162
                VRGNG     = VRGNG
                ENQUEUE   = VARC1
           IMPORTING
                SET_TITLE = KOSTV-TITLE
                TABIX     = TABIX.                      "P30K122162
      IF TABIX = 0.                                     "P30K122162
        EXIT.                                           "P30K122162
      ENDIF.                                            "P30K122162
    ENDLOOP.                                            "P30K122162
  ENDIF.                               "IF NOT KOSTV-KOSTL IS INITIAL
  CALL FUNCTION 'MESSAGES_STOP'
       EXCEPTIONS
            A_MESSAGE = 04
            E_MESSAGE = 03
            W_MESSAGE = 02
            I_MESSAGE = 01.
  IF TABIX = 0.
    MESSAGE S113(GP) WITH 'Kostenstelle'(306).
    SET SCREEN 400.
    LEAVE SCREEN.
  ENDIF.
  IF SY-SUBRC GE 1 AND SY-TCODE NE 'KSBE'.
    MESSAGE S113(GP) WITH 'Kostenstelle'(306).
  ENDIF.
ENDFORM.



