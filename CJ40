*&---------------------------------------------------------------------*
*&      Form  VCOPY_DYN_FM_MGR_CHECK_DYN.
*&---------------------------------------------------------------------*
*       Eingaben     (des Hauptdynpros) ueberpruefen                   *
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM VCOPY_DYN_FM_MGR_CHECK_DYN.

  DATA L_DA_ACTIVE.

*-----Check der Eingaben bei Jahres- und Gesamtwerte (abh.v.Geldgeber)
  IF VCOPY_DYN_FM_MGR-GEBER IS INITIAL AND
     VCOPY_DYN_FM_MGR-V_GEBER IS INITIAL.
*-----sollen nur Daten "ohne Geldgeber" bearbeitet werden.
*----- ---> Jahreswerte muessen eingegeben sein,
*----- ---> Gesamtwerte sind nicht erlaubt
    IF VCOPY_DYN_FM_MGR-V_VJAHR IS INITIAL.
      "*** Fehler: geben Sie das Vorlage-Geschaeftsjahr ein
      MESSAGE E094.
    ENDIF.

    IF VCOPY_DYN_FM_MGR-V_ZJAHR IS INITIAL.
      "*** Fehler: geben Sie das Ziel-Geschaeftsjahr ein
      MESSAGE E093.
    ENDIF.

    IF NOT VCOPY_DYN_FM_MGR-V_GESAMT IS INITIAL.
      "*** Fehler: Gesamtwerte sind nicht erlaubt
      MESSAGE E095.
    ENDIF.
  ELSE.
*-----es wird 1 oder alle Geldgeber (auch "ohne" Geldgeber)
*-----bearbeitet
*----- ---> Jahres- und/oder Gesamtwerte muessen eingegeben sein

*-----Check: Source-/Destination-Jahr:
*-----entweder beide Jahre oder kein Jahr eingeben
    IF ( VCOPY_DYN_FM_MGR-V_VJAHR IS INITIAL AND
         NOT VCOPY_DYN_FM_MGR-V_ZJAHR IS INITIAL ) OR
       ( VCOPY_DYN_FM_MGR-V_ZJAHR IS INITIAL AND
         NOT VCOPY_DYN_FM_MGR-V_VJAHR IS INITIAL ).
      "*** Fehler: geben Sie beide oder kein Jahr ein
      MESSAGE E092.
    ENDIF.

*-----Check: von "Jahreswerten" und "Gesamtwerten" muss zumindest
*-----ein Teil ausgewaehlt sein
    IF VCOPY_DYN_FM_MGR-V_VJAHR IS INITIAL AND
       VCOPY_DYN_FM_MGR-V_GESAMT  IS INITIAL.
      "*** Fehler: waehlen Sie zumindest Jahreswerte oder Gesamtwerte
      MESSAGE E096.
    ENDIF.
  ENDIF.

*-----Check: zumindest eine Budgetsorte muss ausgewaehlt sein
  IF VCOPY_DYN_FM_MGR-V_AKTU = OFF AND
     VCOPY_DYN_FM_MGR-V_FREIG = OFF AND
     ( VCOPY_DYN_FM_MGR-V_ACTIV_SE = OFF OR
       ( VCOPY_DYN_FM_MGR-V_ACTIV_SE = ON AND
         VCOPY_DYN_FM_MGR-V_ORIG     = OFF AND
         VCOPY_DYN_FM_MGR-V_NTRAG    = OFF AND
         VCOPY_DYN_FM_MGR-V_RUECKGA  = OFF AND
         VCOPY_DYN_FM_MGR-V_UMBUCH   = OFF ) ).
    "*** Errormsg: Bitte waehlen Sie das zu kopierende Budget aus
    MESSAGE E091.
  ENDIF.


*-----Check: sind nur Freigaben ausgewaehlt, so ist zusammenfassen zu
*-----Originalbudget nicht moeglich
  IF VCOPY_DYN_FM_MGR-V_AKTU = OFF AND
     VCOPY_DYN_FM_MGR-V_FREIG = ON AND
     ( VCOPY_DYN_FM_MGR-V_ACTIV_SE = OFF OR
       ( VCOPY_DYN_FM_MGR-V_ACTIV_SE = ON AND
         VCOPY_DYN_FM_MGR-V_ORIG     = OFF AND
         VCOPY_DYN_FM_MGR-V_NTRAG    = OFF AND
         VCOPY_DYN_FM_MGR-V_RUECKGA  = OFF AND
         VCOPY_DYN_FM_MGR-V_UMBUCH   = OFF ) ) AND
     VCOPY_DYN_FM_MGR-V_COLL = ON.
    "*** Errormsg: Freigaben koennen nicht zu Originalbudget
                                       "*** zusammengefasst werden
    MESSAGE E090.
  ENDIF.


*-----Check: zumindest eine Budgetart (Verpflichtungs- oder
*-----Zahlungsbudget) ausgewaehlt

  CALL FUNCTION 'FM00_CHECK_ISPS'
       IMPORTING
            E_DA_ACTIV = L_DA_ACTIVE.

  IF L_DA_ACTIVE = ON.
*-----ISPS aktiv: mindestens 1 Budgetart ausgewaehlt?
    VCOPY_DYN_MGR-ISPS_MODE_ACT = ON.
*** radio buttons ---> eine Budgetart ist immer ausgewaehlt.
*** die folgenden Zeilen wieder enablen falls Umstellung auf CheckBoxes
*** IF VCOPY_DYN_FM_MGR-COMMIT = OFF AND VCOPY_DYN_FM_MGR-PAYMENT = OFF.
***   MESSAGE E159.
*** ENDIF.
  ELSE.
*-----ISPS nicht aktiv: Zahlungsbudget muss ausgewaehlt sein
    VCOPY_DYN_MGR-ISPS_MODE_ACT = OFF.
    IF VCOPY_DYN_FM_MGR-PAYMENT = OFF.
      MESSAGE E158.
    ENDIF.
  ENDIF.

ENDFORM.



*&---------------------------------------------------------------------*
*&      Form  VCOPY_DYN_FM_MGR_COPY_VERS.
*&---------------------------------------------------------------------*
*       Version kopieren                                               *
*----------------------------------------------------------------------*
*  -->
*  <--
*----------------------------------------------------------------------*
FORM VCOPY_DYN_FM_MGR_COPY_VERS.

  DATA: L_OBJHI  LIKE BPIN-OBJHI,
        L_DEST_ACTIVITY LIKE BPIN-VORGA.

  DATA: BEGIN OF LT_COPY OCCURS 0.
          INCLUDE STRUCTURE BPCOPY.
  DATA: END OF LT_COPY.

  DATA: BEGIN OF L_BPIN.
          INCLUDE STRUCTURE BPIN.
  DATA: END OF L_BPIN.

  DATA: BEGIN OF L_TIME.
          INCLUDE STRUCTURE BPTIME.
  DATA: END OF L_TIME.



*-----Initialisierungen
  REFRESH LT_COPY.

*-----Objektnummer erzeugen
  CALL FUNCTION 'KBPS_OBJHI_NAME_GENERATE'
       EXPORTING
            I_APPLICATION = L_FUNDS
            I_FM_AREA     = VCOPY_DYN_FM_MGR-FIKRS
       IMPORTING
            E_OBJHI       = L_OBJHI.

*-----Tabelle mit den zu kopierenden Vorgaengen erzeugen
*-----normale Budgets aufnehmen
*-----Destinationvorgang bestimmen
  IF VCOPY_DYN_FM_MGR-V_COLL IS INITIAL.
*-----Destination-Vorgang entsprechend Source-Vorgang
    CLEAR L_DEST_ACTIVITY.
  ELSE.
*-----Destination-Vorgang: Originalbudget
    L_DEST_ACTIVITY = L_VBUD.
  ENDIF.

*-----VERPFLICHTUNGSBUDGET
  IF VCOPY_DYN_FM_MGR-COMMIT = ON AND VCOPY_DYN_MGR-ISPS_MODE_ACT = ON.
    CLEAR LT_COPY.
    LT_COPY-WRTTP      = L_WPBUDGET.
    LT_COPY-DEST_VORGA = L_DEST_ACTIVITY.

*-----"aktuelles Budget" hat Vorrang vor direkt ausgewaehlten
*-----Vorgaengen
    IF VCOPY_DYN_FM_MGR-V_AKTU = ON.
      APPEND LT_COPY.
    ELSEIF VCOPY_DYN_FM_MGR-V_ACTIV_SE = ON.
*-----Originalbudget
      IF VCOPY_DYN_FM_MGR-V_ORIG = ON.
        LT_COPY-SRC_VORGA = L_VBUD.
        APPEND LT_COPY.
      ENDIF.
*-----Nachtrag
      IF VCOPY_DYN_FM_MGR-V_NTRAG = ON.
        LT_COPY-SRC_VORGA = L_VBN0.
        APPEND LT_COPY.
      ENDIF.
*-----Rueckgabe
      IF VCOPY_DYN_FM_MGR-V_RUECKGA = ON.
        LT_COPY-SRC_VORGA = L_VBR0.
        APPEND LT_COPY.
      ENDIF.
*-----Umbuchung - Sender und Empfaenger
      IF VCOPY_DYN_FM_MGR-V_UMBUCH = ON.
        LT_COPY-SRC_VORGA = L_VBUS.
        APPEND LT_COPY.
        LT_COPY-SRC_VORGA = L_VBUE.
        APPEND LT_COPY.
        LT_COPY-SRC_VORGA = L_VKBU1.
        APPEND LT_COPY.
        LT_COPY-SRC_VORGA = L_VKBU2.
        APPEND LT_COPY.
        LT_COPY-SRC_VORGA = L_VKBU3.
        APPEND LT_COPY.
        LT_COPY-SRC_VORGA = L_VKBU4.
        APPEND LT_COPY.
      ENDIF.
    ENDIF.

*-----Freigaben aufnehmen
    IF VCOPY_DYN_FM_MGR-V_FREIG = ON.
      CLEAR LT_COPY.
      LT_COPY-WRTTP     = L_WPRELEASE.
      LT_COPY-SRC_VORGA = L_VBFR.
      APPEND LT_COPY.
    ENDIF.
  ENDIF.

*-----ZAHLUNGSBUDGET
  IF VCOPY_DYN_FM_MGR-PAYMENT = ON.
    CLEAR LT_COPY.
    LT_COPY-WRTTP      = L_WFBUDGET.
    LT_COPY-DEST_VORGA = L_DEST_ACTIVITY.

*-----"aktuelles Budget" hat Vorrang vor direkt ausgewaehlten
*-----Vorgaengen
    IF VCOPY_DYN_FM_MGR-V_AKTU = ON.
      APPEND LT_COPY.
    ELSEIF VCOPY_DYN_FM_MGR-V_ACTIV_SE = ON.
*-----Originalbudget
      IF VCOPY_DYN_FM_MGR-V_ORIG = ON.
        LT_COPY-SRC_VORGA = L_VBUD.
        APPEND LT_COPY.
      ENDIF.
*-----Nachtrag
      IF VCOPY_DYN_FM_MGR-V_NTRAG = ON.
        LT_COPY-SRC_VORGA = L_VBN0.
        APPEND LT_COPY.
      ENDIF.
*-----Rueckgabe
      IF VCOPY_DYN_FM_MGR-V_RUECKGA = ON.
        LT_COPY-SRC_VORGA = L_VBR0.
        APPEND LT_COPY.
      ENDIF.
*-----Umbuchung - Sender und Empfaenger
      IF VCOPY_DYN_FM_MGR-V_UMBUCH = ON.
        LT_COPY-SRC_VORGA = L_VBUS.
        APPEND LT_COPY.
        LT_COPY-SRC_VORGA = L_VBUE.
        APPEND LT_COPY.
        LT_COPY-SRC_VORGA = L_VKBU1.
        APPEND LT_COPY.
        LT_COPY-SRC_VORGA = L_VKBU2.
        APPEND LT_COPY.
        LT_COPY-SRC_VORGA = L_VKBU3.
        APPEND LT_COPY.
        LT_COPY-SRC_VORGA = L_VKBU4.
        APPEND LT_COPY.
      ENDIF.
    ENDIF.

*-----Freigaben aufnehmen
    IF VCOPY_DYN_FM_MGR-V_FREIG = ON.
      CLEAR LT_COPY.
      LT_COPY-WRTTP     = L_WFRELEASE.
      LT_COPY-SRC_VORGA = L_VBFR.
      APPEND LT_COPY.
    ENDIF.
  ENDIF.

*-----Jahreswerte?
  IF VCOPY_DYN_FM_MGR-V_VJAHR IS INITIAL.
    L_TIME-YEAR_VAL = OFF.
    CLEAR: L_TIME-Y_SRC_FRST, L_TIME-Y_SRC_LAST, L_TIME-Y_DST_FRST.
  ELSE.
    L_TIME-YEAR_VAL = ON.
    L_TIME-Y_SRC_FRST  = VCOPY_DYN_FM_MGR-V_VJAHR.
    L_TIME-Y_SRC_LAST  = VCOPY_DYN_FM_MGR-V_VJAHR.
    L_TIME-Y_DST_FRST  = VCOPY_DYN_FM_MGR-V_ZJAHR.
  ENDIF.

*-----Periodenwerte: Finanzbudgets haben normal keine Periodenwerte,
*-----jedoch Aktivierung ueber speziellen Report moeglich (Toronto).
*-----Periodenwerte werden in diesem Fall kopiert, wenn der User
*-----Jahreswerte auswaehlt. Dann stets alle Perioden.
  L_TIME-PERIOD_VAL = L_TIME-YEAR_VAL.
  CLEAR: L_TIME-P_SRC_FRST, L_TIME-P_SRC_LAST, L_TIME-P_DST_FRST.

*-----Gesamtwerte
  L_TIME-TOTAL_VAL = VCOPY_DYN_FM_MGR-V_GESAMT.

*-----L_BPIN setzen
  L_BPIN-SGTEXT  = VCOPY_DYN_FM_MGR-SGTXT.
  L_BPIN-NAMTEXT = VCOPY_DYN_FM_MGR-TDNAME.
  L_BPIN-FIKRS   = VCOPY_DYN_FM_MGR-FIKRS.
  L_BPIN-APPLIK  = L_FUNDS.
  L_BPIN-OBJHI   = L_OBJHI.

*-----Error Handler initialisieren
  CALL FUNCTION 'MESSAGES_INITIALIZE'.

*-----Version kopieren
  CALL FUNCTION 'KBPP_COPY_VERSION'
       EXPORTING
            IM_VERSION_SRC     = VCOPY_DYN_FM_MGR-V_VERS_V
            IM_VERSION_DEST    = VCOPY_DYN_FM_MGR-V_VERS_Z
            IM_TIME            = L_TIME
            IM_FIN_CODE        = VCOPY_DYN_FM_MGR-GEBER
*           im_fin_codes_all   = vcopy_dyn_fm_mgr-v_geber   "P30K085473
            IM_COPY_MODE       = VCOPY_DYN_FM_MGR-COPY_MODE
            IM_OVERWRITE_CHECK = ON
            IM_BPIN            = L_BPIN
       TABLES
            T_COPY             = LT_COPY.

ENDFORM.



