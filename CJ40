*&---------------------------------------------------------------------*
*&      Form  INIT_D0700_PBO
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM INIT_D0700_PBO.

  DATA: L_FLG_FAREA_ACTIVE VALUE 'X'.

* check whether IS-PS-standard or EU flag is active.

  CALL FUNCTION 'FM_BUD_CHECK_COMPONENT'  "#EC *     " 470
       EXPORTING
         i_standard_env     = 'X'
       EXCEPTIONS
         error_message      = 1.

  IF SY-SUBRC <> 0.
    IF SY-BINPT IS INITIAL.
      MESSAGE ID SY-MSGID TYPE 'S' NUMBER SY-MSGNO
              WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
      LEAVE PROGRAM.
    ELSE.
      MESSAGE ID SY-MSGID TYPE 'E' NUMBER SY-MSGNO
              WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
    ENDIF.
  ENDIF.

* remove fund in case of an initial fund flag

  IF GF_FM_ACTIVE_DIM-FUND_ACTIVE IS INITIAL.
    CLEAR FMPS-GEBER.
    PERFORM VSCREEN_HIDE_FIELD USING 'FMPS-GEBER'.
    PERFORM VSCREEN_HIDE_FIELD USING 'BPDY-FINCODE_TXT'.
  ENDIF.

* remove selection field subvo in case of releases
  IF BPIN-VORGA EQ L_VBFR.
    CLEAR BPDY-SUBVO.
    PERFORM VSCREEN_HIDE_FIELD USING 'BPDY-SUBVO'.
    PERFORM VSCREEN_HIDE_FIELD USING 'BPDY-SUBVO_BEZ'.
  ENDIF.

  CALL FUNCTION 'FM_FIKRS_CHECK_FAREA_ACTIVE'               "FAREA
       EXPORTING                                            "FAREA
            I_ALL_FIKRS      = ON                           "FAREA
       EXCEPTIONS                                           "FAREA
            NOT_FAREA_ACTIVE = 1.                           "FAREA
                                                            "FAREA
  IF NOT SY-SUBRC IS INITIAL.                               "FAREA
    CLEAR BPDY-FAREA.                                       "FAREA
    CLEAR L_FLG_FAREA_ACTIVE.
    PERFORM VSCREEN_HIDE_FIELD USING 'BPDY-FAREA'.          "FAREA
    PERFORM VSCREEN_HIDE_FIELD USING 'BPDY-FAREA_TXT'.      "FAREA
  ENDIF.                                                    "FAREA

  IF GF_FM_ACTIVE_DIM-FUND_ACTIVE IS INITIAL.
    IF SY-BINPT = OFF.
      CLEAR FMPS-GEBER.
      PERFORM VSCREEN_HIDE_FIELD USING 'FMPS-GEBER'.
      PERFORM VSCREEN_HIDE_FIELD USING 'BPDY-FINCODE_TXT'.
    ENDIF.
  ENDIF.

  IF BPIN-VORGA EQ L_VBFR                    AND
     GF_FM_ACTIVE_DIM-FUND_ACTIVE IS INITIAL AND
     L_FLG_FAREA_ACTIVE IS INITIAL.
     LOOP AT SCREEN.
       IF SCREEN-GROUP1 EQ 'DIM'.
         SCREEN-INVISIBLE = 1.
         SCREEN-INPUT     = 0.
         SCREEN-OUTPUT    = 0.
         MODIFY SCREEN.
         EXIT.
       ENDIF.
     ENDLOOP.
  ENDIF.

  IF SY-BINPT = ON.
*   normal entry for batch input
    PERFORM VSCREEN_SET_REQUIRED_FIELD USING 'FMPS-FIKRS'.
    PERFORM VSCREEN_SET_INPUT_FIELD USING 'FMPS-FIKRS'.
  ELSE.
    PERFORM SET_FM_AREA USING OFF
                        CHANGING FMPS-FIKRS.
    IF FMPS-FIKRS IS INITIAL.
      LEAVE PROGRAM.
    ENDIF.
  ENDIF.

ENDFORM.                               " INIT_D0700_PBO

*&---------------------------------------------------------------------*
*&      Form  VSCREEN_HIDE_FIELD
*&---------------------------------------------------------------------*
*       No display of this field on the dynpro
*----------------------------------------------------------------------*
FORM VSCREEN_HIDE_FIELD USING    VALUE(P_FIELDNAME).

  LOOP AT SCREEN.
    IF SCREEN-NAME = P_FIELDNAME.
      SCREEN-INVISIBLE = 1.
      SCREEN-OUTPUT    = 0.
      SCREEN-INPUT     = 0.
      MODIFY SCREEN.
    ENDIF.
  ENDLOOP.

ENDFORM.                               " VSCREEN_HIDE_FIELD

