  IF SY-TCODE = 'FMDC' OR SY-TCODE = 'FMDD' OR
     SY-TCODE = 'FMDG' OR SY-TCODE = 'FMDH' OR
     SY-TCODE = 'FMD9' OR SY-TCODE = 'FMD0'.

*-----Finanzstellenfeld leer und nicht eingabebereit
    IF L_BINPT = OFF.
      CLEAR FMPS-FISTL.

      LOOP AT SCREEN.
        IF SCREEN-NAME = 'FMPS-FISTL'.
          SCREEN-INVISIBLE = 0.
          SCREEN-OUTPUT    = 1.
          SCREEN-INPUT     = 0.
          MODIFY SCREEN.
        ENDIF.
      ENDLOOP.
    ENDIF.

*-----bei Sammelnachweisplanung ist Fipos Muss-Eingabe
    LOOP AT SCREEN.
      IF SCREEN-NAME = 'FMPS-FIPOS'.
        SCREEN-REQUIRED  = 1.
        MODIFY SCREEN.
      ENDIF.
    ENDLOOP.
  ENDIF.

*-----beim Rechnungsergebnis keine Version
  IF SY-TCODE = 'FMDE' OR SY-TCODE = 'FMDF' OR SY-TCODE = 'FMDG'
     OR SY-TCODE = 'FMDH'.
    LOOP AT SCREEN.
      IF SCREEN-NAME = 'BPDY-VERSN'.
        SCREEN-INVISIBLE = 1.
        SCREEN-OUTPUT    = 0.
        SCREEN-INPUT     = 0.
        MODIFY SCREEN.
      ENDIF.
    ENDLOOP.
  ENDIF.

*-----nur beim Rechnungsergebnis GJahr RE anzeigen
  IF SY-TCODE <> 'FMDE' AND SY-TCODE <> 'FMDF' AND SY-TCODE <> 'FMDG'
     AND SY-TCODE <> 'FMDH'.
    LOOP AT SCREEN.
      IF SCREEN-NAME = 'BPDY-RE_GNJHR'.
        SCREEN-INVISIBLE = 1.
        SCREEN-OUTPUT    = 0.
        SCREEN-INPUT     = 0.
        MODIFY SCREEN.
      ENDIF.
    ENDLOOP.
  ENDIF.

*--bei Kommunen pruefen ob Fund aktiv is
  IF GF_FM_ACTIVE_DIM-FUND_ACTIVE IS INITIAL.
    IF L_BINPT = OFF.
      CLEAR FMPS-GEBER.
      PERFORM VSCREEN_HIDE_FIELD USING 'FMPS-GEBER'.
    ENDIF.
  ENDIF.

*--beim Saldenbudget und beim Rechnungsergebnis keine Unterart
  IF SY-TCODE = 'FMDK' OR SY-TCODE = 'FMDL' OR
     SY-TCODE = 'FMDE' OR SY-TCODE = 'FMDF' OR              "KI4K043716
     SY-TCODE = 'FMDG' OR SY-TCODE = 'FMDH'.                "KI4K043716

    CLEAR BPDY-SUBVO.
    LOOP AT SCREEN.
      IF SCREEN-NAME EQ 'BPDY-SUBVO' OR
         SCREEN-NAME EQ 'BPDY-SUBVO_BEZ'.
        SCREEN-INVISIBLE = 1.
        SCREEN-INPUT     = 0.
        SCREEN-OUTPUT    = 0.
        MODIFY SCREEN.
        EXIT.
      ENDIF.
    ENDLOOP.
*--evtl. Rahmen 'Feste Budgetdimensionen' ausblenden
    IF GF_FM_ACTIVE_DIM-FUND_ACTIVE IS INITIAL.
      LOOP AT SCREEN.
        IF SCREEN-GROUP1 EQ 'DIM'.
          SCREEN-INVISIBLE = 1.
          SCREEN-INPUT     = 0.
          SCREEN-OUTPUT    = 0.
          MODIFY SCREEN.
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDIF.

  IF SY-BINPT = ON.
*   normal entry for batch input
    PERFORM VSCREEN_SET_REQUIRED_FIELD USING 'FMPS-FIKRS'.
    PERFORM VSCREEN_SET_INPUT_FIELD USING 'FMPS-FIKRS'.
  ELSE.
    PERFORM SET_FM_AREA USING OFF
                        CHANGING FMPS-FIKRS.
    IF FMPS-FIKRS IS INITIAL.
      LEAVE PROGRAM.
    ENDIF.
  ENDIF.



ENDFORM.



*---------------------------------------------------------------------*
*     FORM !HAUSHALTSPLAN                                             *
*---------------------------------------------------------------------*
*     Selektion Haushaltsplan                                         *
*---------------------------------------------------------------------*
*
*---------------------------------------------------------------------*
FORM HAUSHALTSPLAN.

  DATA: L_ALTERNATIVE_HIERARCHY.
  DATA: L_CARRIER_PAYMENT,
        L_CARRIER_COMMITMENT,
        L_ALL_LEV LIKE FMPS-POS_LEV,
        L_ONE_LEV LIKE FMPS-POS_LEV.
  DATA: LT_BPCJ    LIKE BPCJ OCCURS 0 WITH HEADER LINE.
  DATA: L_OBJHI LIKE BPIN-OBJHI.
  DATA: L_COUNT TYPE I.
  DATA: L_FISTL LIKE FMPS-FISTL.
  TABLES BPCJ.
  DATA   L_ACTVT LIKE TACT-ACTVT.

  DATA: L_F_FM01 LIKE FM01.                                 "KI4K044204

* transaction-depending component check

  CALL FUNCTION 'FM_BUD_CHECK_COMPONENT'    "#EC *          " 470
       EXPORTING
        i_fikrs            = FMPS-FIKRS
        i_kom_env          = g_flg_kom_env
        i_no_hierarchy_env = g_flg_no_hierarchy_env.


*-----Lesen der Finanzkreisdaten (fuer das Bestimmen ob mit einer
*-----Finanzstelle des Haushalts gearbeitet wird oder nicht
  CALL FUNCTION 'FMFK_FIKRS_READ'                           "KI4K044204
       EXPORTING                                            "KI4K044204
            IP_FIKRS            = FMPS-FIKRS                "KI4K044204
       IMPORTING                                            "KI4K044204
            F_FM01              = L_F_FM01.                 "KI4K044204

*-----Wird ohne Finanzstelle fuer den Haushalt gearbeitet, sind folgende
*-----Transaktionen gesperrt:
  IF SY-TCODE = 'FMD0' OR SY-TCODE = 'FMD9' OR"Nachtrag im SN"KI4K044204
     SY-TCODE = 'FMDC' OR SY-TCODE = 'FMDD' OR"SN-Planung    "KI4K044204
     SY-TCODE = 'FMDG' OR SY-TCODE = 'FMDH' OR"RechErg im SN "KI4K044204
     SY-TCODE = 'FMDK' OR SY-TCODE = 'FMDL'.  "Saldenbudget. "KI4K044204
    IF NOT L_F_FM01-NO_HIERARCHY IS INITIAL.                "KI4K044204
      MESSAGE E251.                                         "KI4K044204
*   Funktion nicht erlaubt                                   "KI4K044204
    ENDIF.                                                  "KI4K044204
  ENDIF.                                                    "KI4K044204

  CASE OKCODE.
    WHEN 'SELE'.
      PERFORM OKCODE. CLEAR OKCODE.

    WHEN 'CLAS'.
      PERFORM OKCODE. CLEAR OKCODE.

    WHEN 'FISI'.
      PERFORM MASTER_DATA USING ON.

    WHEN 'POSI'.
      PERFORM MASTER_DATA USING OFF.

    WHEN 'MSEL'.
      PERFORM MASTER_DATA_SELECT.

    WHEN 'SFIK'.
      PERFORM CHANGE_FM_AREA.

    WHEN 'CVAR'.
      PERFORM CHANGE_VARIANT.

  ENDCASE.

*-----Fehlerprotokoll zuruecksetzen
  CALL FUNCTION 'MESSAGES_INITIALIZE'
       EXPORTING
            RESET = ON.

*-----Ermittlung Default-Geschaeftsjahr
  IF BPDY-GJAHR IS INITIAL.
    CALL FUNCTION 'KBPA_GET_START_FISCAL_YEAR_OPT'
         EXPORTING
              I_FM_AREA           = FMPS-FIKRS
              I_FIN_CODE          = FMPS-GEBER
         IMPORTING
              E_START_FISCAL_YEAR = BPDY-GJAHR.
  ELSE.
    CALL FUNCTION 'KBPS_CHECK_GJAHR'
         EXPORTING
              I_GJAHR = BPDY-GJAHR
         IMPORTING
              E_GJAHR = BPDY-GJAHR.
  ENDIF.

*-----Berechtigungspruefung Finanzkreis
  IF BPIN-SHOW = OFF.
    L_ACTVT = FMAU_BU_CRE.
  ELSE.
    L_ACTVT = FMAU_BU_DIS.
  ENDIF.

  CALL FUNCTION 'FM_AUTH_CHECK_FM_AREA'
       EXPORTING
            I_FIKRS = FMPS-FIKRS
            I_ACTVT = L_ACTVT
            I_MSGTY = 'E'.

  IF SY-TCODE = 'FMDA' OR SY-TCODE = 'FMDB' OR
     SY-TCODE = 'FMD7' OR SY-TCODE = 'FMD8' OR
     SY-TCODE = 'FMDK' OR SY-TCODE = 'FMDL' OR
     SY-TCODE = 'FMDE' OR SY-TCODE = 'FMDF'.
    IF SY-BINPT = ON AND FMPS-C_CTR_LEV = 1 AND
       FMPS-C_POS_LEV = 1 AND NOT FMPS-FIPOS IS INITIAL.
      L_ALTERNATIVE_HIERARCHY = ON.
    ENDIF.

    IF L_ALTERNATIVE_HIERARCHY = ON.
*     PERFORM HHPLAN_ALT_HIERARCHY.                         "KI4K046838
      PERFORM HHPLAN_ALT_HIERARCHY                          "KI4K046838
                         USING L_F_FM01-NO_HIERARCHY.       "KI4K046838
    ELSE.
      PERFORM SET_LEVEL USING OFF.

*     CALL FUNCTION 'FM4C_READ_HIERARCHY_SET'               "KI4K064369
      CALL FUNCTION 'FM4C_READ_HIERARCHY_SET'       "#EC *  "KI4K064369
           EXPORTING
                I_CTR_LEV         = FMPS-CTR_LEV
                I_POS_LEV         = FMPS-POS_LEV
                I_C_CTR_LEV       = FMPS-C_CTR_LEV
                I_C_POS_LEV       = FMPS-C_POS_LEV
                I_MULTI_SEL       = ON
                I_DEL_NON_CARRIER = ON
                I_ONLY_30_POS     = ON
                I_BALBUD_CARRIER  = BPIN-BALANCE_HY
                I_POST_CARRIER    = OFF.

*-----Finanzstelle bestimmen
*-----Falls mit Finanzstelle fuer den HH gearbeitet wird
      IF L_F_FM01-NO_HIERARCHY IS INITIAL.                  "KI4K044204
        L_OBJHI = 'FS....%'.
        L_OBJHI+2(4) = FMPS-FIKRS.
        SELECT * FROM BPCJ INTO TABLE LT_BPCJ WHERE OBJNR LIKE L_OBJHI
                                        AND   POSIT = '*'
                                        AND   TRGKZ = L_NODE
                                        AND   WRTTP = L_WFBUDGET
                                        AND   GJAHR = BPDY-GJAHR
                                        AND   GEBER = FMPS-GEBER.

        LOOP AT LT_BPCJ.
          L_COUNT = L_COUNT + 1.
          L_FISTL = LT_BPCJ-OBJNR+6.
        ENDLOOP.
        IF L_COUNT <> 1 AND BPIN-BALANCE_HY = OFF.
*-----Fehlermeldung: Keine zu bearbeitenden Objekte vorhanden
          MESSAGE E008(BP) WITH TEXT-401.
        ENDIF.
      ENDIF.                                                "KI4K044204

*-----Saldenbudgetierung: nicht die Default-Fistl
      IF BPIN-BALANCE_HY = ON.
        L_FISTL = FMPS-FISTL.
      ENDIF.

* Aufruf FM4C mit eingegebener Fistl (keine Fistl fuer HH)
      IF L_F_FM01-NO_HIERARCHY IS INITIAL.                  "KI4K044204
        IF NOT FMPS-FISTL IS INITIAL AND FMPS-FISTL <> L_FISTL.
*-----Fehlermeldung: Keine zu bearbeitenden Objekte vorhanden
          MESSAGE E008(BP) WITH TEXT-401.
        ENDIF.

*       CALL FUNCTION 'FM4C_READ_HIERARCHY'                 "KI4K064369
        CALL FUNCTION 'FM4C_READ_HIERARCHY'         "#EC *  "KI4K064369
             EXPORTING
                  I_FIKRS  = FMPS-FIKRS
                  I_FIPOS  = FMPS-FIPOS
                  I_FISTL  = L_FISTL
                  I_GEBER  = FMPS-GEBER
                  I_GJAHR  = BPDY-GJAHR
             IMPORTING
                  E_PROFIL = TBP1C-PROFIL.
      ELSE.                                                 "KI4K044204
*       CALL FUNCTION 'FM4C_READ_HIERARCHY'      "KI4K044204"KI4K064369
        CALL FUNCTION 'FM4C_READ_HIERARCHY'         "#EC *  "KI4K064369
             EXPORTING                                      "KI4K044204
                  I_FIKRS  = FMPS-FIKRS                     "KI4K044204
                  I_FIPOS  = FMPS-FIPOS                     "KI4K044204
                  I_FISTL  = FMPS-FISTL                     "KI4K044204
                  I_GEBER  = FMPS-GEBER                     "KI4K044204
                  I_GJAHR  = BPDY-GJAHR                     "KI4K044204
             IMPORTING                                      "KI4K044204
                  E_PROFIL = TBP1C-PROFIL.                  "KI4K044204
                                                            "KI4K044204
      ENDIF.                                                "KI4K044204

    ENDIF.
  ELSEIF SY-TCODE = 'FMDC' OR SY-TCODE = 'FMDD' OR
         SY-TCODE = 'FMD9' OR SY-TCODE = 'FMD0' OR
         SY-TCODE = 'FMDG' OR SY-TCODE = 'FMDH'.
*-----Planung Sammelnachweise
    PERFORM HHPLAN_SET_HIERARCHY_FOR_SN USING FMPS-FIKRS
                                           FMPS-FIPOS
                                           FMPS-FISTL
                                           FMPS-GEBER
                                           BPDY-GJAHR
                                     CHANGING TBP1C-PROFIL.
  ELSE.
    MESSAGE A005(BP) WITH '-' '-' 'MKBUDF04' 'HAUSHALTSPLAN'.
  ENDIF.

  CALL FUNCTION 'FM_FIKRS_CHECK_MD_YEAR_DEPEND'
       EXPORTING
            I_FIKRS                = FMPS-FIKRS
       IMPORTING
            E_FLG_YEAR_MASTER_DATA = BPIN-MD_YEARDEP.

  BPIN-GEBER = FMPS-GEBER.

  MOVE: BPDY-GJAHR TO BPIN-GJAHR,
        FMPS-FIKRS TO BPIN-FIKRS,
        BPDY-SUBVO TO BPIN-SUBVO,
        BPDY-VERSN TO BPIN-VERSN.

  IF SY-TCODE = 'FMDE' OR SY-TCODE = 'FMDF' OR
     SY-TCODE = 'FMDG' OR SY-TCODE = 'FMDH'.
*-----bei Rechnungsergebnis-Transaktionen GNJHR setzen
    IF BPDY-RE_GNJHR IS INITIAL.
      BPIN-GNJHR = BPDY-GJAHR.
    ELSE.
      BPIN-GNJHR = BPDY-RE_GNJHR.
    ENDIF.
  ENDIF.

*-----Textformatierung ausschalten
* CALL FUNCTION 'FM4C_SET_FORMAT'                           "KI4K064369
  CALL FUNCTION 'FM4C_SET_FORMAT'                   "#EC *  "KI4K064369
       EXPORTING
            I_ACTIVATE_FORMAT = OFF.

  CALL FUNCTION 'KBPS_OBJHI_NAME_GENERATE'
       EXPORTING
            I_APPLICATION = L_FUNDS
            I_FM_AREA     = FMPS-FIKRS
       IMPORTING
            E_OBJHI       = BPIN-OBJHI.

*-----Pruefung auf Saldenbudgettraeger
  IF BPIN-BALANCE_HY = ON.
    SELECT * FROM BPCK WHERE OBJNR = BPIN-OBJHI
                       AND   GEBER = FMPS-GEBER
                       AND   TRGKZ = L_NODE
                       AND   WRTTP = L_WFBALBUD
                       AND   GJAHR = BPDY-GJAHR.
    ENDSELECT.
    IF SY-SUBRC <> 0.
      MESSAGE E008(BP) WITH TEXT-401.
    ENDIF.
  ENDIF.

*-----Fondseingabe bei deaktiviertem Fond nicht erlaubt
  IF GF_FM_ACTIVE_DIM-FUND_ACTIVE IS INITIAL AND
     NOT FMPS-GEBER IS INITIAL.
    MESSAGE E811(F6).
*   Das Kontierungselement Fonds ist nicht aktiv. Nur Wert SPACE erlaub
   ENDIF.

ENDFORM.



*---------------------------------------------------------------------*
*     FORM !HHPLAN_SET_HIERARCHY_FOR_SN                               *
*---------------------------------------------------------------------*
*     Hierarchieaufbau fuer Sammelnachweisplanung - Dt Kommunen       *
*---------------------------------------------------------------------*
FORM HHPLAN_SET_HIERARCHY_FOR_SN USING VALUE(P_FIKRS)
                                       VALUE(P_FIPOS)
                                       VALUE(P_FISTL)
                                       VALUE(P_GEBER)
                                       VALUE(P_GJAHR)
                                 CHANGING P_PROFIL.

  TABLES FM01SN.

  DATA: L_ALL_LEV LIKE FMPS-POS_LEV,
        L_ONE_LEV LIKE FMPS-POS_LEV.
  DATA: L_FIPEX LIKE FMPG-FIPEX.
  DATA: LF_VFMPG LIKE VFMPG.
  DATA: L_ROOT_FICTR LIKE FMFCTR-FICTR.
  DATA: L_FIKRS_OBJNR LIKE BPIN-OBJNR.



  IF NOT P_FISTL IS INITIAL.
    PERFORM UTIL_CHECK_FISTL USING P_FIKRS
                                   P_FISTL
                                   P_GJAHR
                             CHANGING L_ROOT_FICTR.
  ENDIF.

*-----Budgettraeger obligatorisch
  L_FIKRS_OBJNR = 'FK'.
  L_FIKRS_OBJNR+2 = P_FIKRS.
  SELECT SINGLE * FROM BPCK WHERE OBJNR = L_FIKRS_OBJNR
                            AND   GEBER = P_GEBER
                            AND   TRGKZ = L_NODE
                            AND   WRTTP = L_WFBUDGET
                            AND   GJAHR = P_GJAHR.

  IF SY-SUBRC <> 0.
    MESSAGE E008(BP) WITH TEXT-401.
  ENDIF.

*-----Existiert die Finanzposition und ist es eine SN-BuStl?
  IF P_FIPOS IS INITIAL.
    MESSAGE E008(BP) WITH TEXT-401.
  ENDIF.

  CALL FUNCTION 'FM_FIPEX_GET_FROM_FIPOS'
       EXPORTING
            I_FIPOS = P_FIPOS
       IMPORTING
            E_FIPEX = L_FIPEX.

  CALL FUNCTION 'FM_FIPEX_READ_SINGLE_DATA'
       EXPORTING
            I_FIKRS   = P_FIKRS
            I_GJAHR   = P_GJAHR
            I_FIPEX   = L_FIPEX
       IMPORTING
            E_F_VFMPG = LF_VFMPG.

  IF LF_VFMPG-SNROL <> '1'.
*-----nur Sammelnachweisrolle 1
    MESSAGE E008(BP) WITH TEXT-401.
  ENDIF.

*-----SN-Fistl ermitteln
  SELECT SINGLE * FROM FM01SN WHERE FIKRS = P_FIKRS
                              AND   GJAHR = P_GJAHR.
  IF SY-SUBRC <> 0 OR FM01SN-TOPFICTR IS INITIAL.
    MESSAGE E008(BP) WITH TEXT-401.
  ENDIF.
  IF NOT P_FISTL IS INITIAL AND FM01SN-TOPFICTR <> L_ROOT_FICTR.
    MESSAGE E008(BP) WITH TEXT-401.
  ENDIF.

  L_ONE_LEV = 1.

* CALL FUNCTION 'FM4C_READ_HIERARCHY_SET'                   "KI4K064369
  CALL FUNCTION 'FM4C_READ_HIERARCHY_SET'           "#EC *  "KI4K064369
       EXPORTING
            I_CTR_LEV         = L_ALL_LEV
            I_POS_LEV         = L_ONE_LEV
            I_C_CTR_LEV       = L_ALL_LEV
            I_C_POS_LEV       = L_ONE_LEV
            I_DEL_NON_CARRIER = ON
            I_ONLY_30_POS     = ON
            I_POST_CARRIER    = OFF.

* CALL FUNCTION 'FM4C_READ_HIERARCHY'                       "KI4K064369
  CALL FUNCTION 'FM4C_READ_HIERARCHY'               "#EC *  "KI4K064369
       EXPORTING
            I_FIKRS  = P_FIKRS
            I_FIPOS  = P_FIPOS
            I_FISTL  = FM01SN-TOPFICTR
            I_GEBER  = P_GEBER
            I_GJAHR  = P_GJAHR
       IMPORTING
            E_PROFIL = P_PROFIL.

ENDFORM.



*&---------------------------------------------------------------------*
*&      Form  HHPLAN_ALT_HIERARCHY
*&---------------------------------------------------------------------*
*     alternative "Top-Pos suchen und ohne Stufeneingrenzung"          *
*----------------------------------------------------------------------*
*  -->
*  <--
*----------------------------------------------------------------------*
*FORM HHPLAN_ALT_HIERARCHY.
FORM HHPLAN_ALT_HIERARCHY USING VALUE(U_NO_HIERARCHY).      "KI4K046838

  DATA: L_ALL_LEV LIKE FMPS-POS_LEV,
        L_ONE_LEV LIKE FMPS-POS_LEV.
  DATA: LT_BPCJ    LIKE BPCJ OCCURS 0 WITH HEADER LINE.
  DATA: L_OBJHI LIKE BPIN-OBJHI.
  DATA: L_COUNT LIKE SY-TABIX.
  DATA: L_FISTL LIKE FMPS-FISTL.
  DATA: L_POSIT LIKE BPIN-POSIT.
  DATA: L_FIPEX LIKE FMPG-FIPEX.
  DATA: L_TOP_FIPOS LIKE FMFPO-FIPOS.
  DATA: L_ENTRIES LIKE SY-TABIX.
  DATA  LF_VFMPG LIKE VFMPG.
  DATA  LF_FMHIPG LIKE FMHIPG.



*-----Fipos vorhanden?
  IF FMPS-FIPOS IS INITIAL OR FMPS-FIKRS IS INITIAL.
    MESSAGE A005(BP) WITH 'FMPS-FIPOS' '-' 'MKBUDF20' 'HHPLAN_ALT'.
  ENDIF.

*-----Fipex ermitteln
  PERFORM UTIL_GET_FIPEX_FROM_FIPOS USING    FMPS-FIKRS
                                             FMPS-FIPOS
                                    CHANGING L_FIPEX.

*-----TOP Fipex ermitteln
  CALL FUNCTION 'FM_FIPEX_READ_SINGLE_DATA'
       EXPORTING
            I_FIKRS         = FMPS-FIKRS
            I_GJAHR         = BPDY-GJAHR
            I_FIPEX         = L_FIPEX
            I_FLG_HIERARCHY = ON
       IMPORTING
            E_F_VFMPG       = LF_VFMPG
            E_F_FMHIPG      = LF_FMHIPG.

  IF LF_VFMPG-SNROL <> SPACE.
    MESSAGE E008(BP) WITH TEXT-401.
  ENDIF.

  PERFORM UTIL_GET_FIPOS_FROM_FIPEX USING    FMPS-FIKRS
                                             LF_FMHIPG-HIROOT_FIP
                                    CHANGING L_TOP_FIPOS.

*Test Schleswig-Holstein
  IF U_NO_HIERARCHY IS INITIAL.                             "KI4K046838

*----Hierarchieaufbau von oben
    PERFORM SET_LEVEL USING OFF.

    L_ONE_LEV = 1.

*   CALL FUNCTION 'FM4C_READ_HIERARCHY_SET'                 "KI4K064369
    CALL FUNCTION 'FM4C_READ_HIERARCHY_SET'         "#EC *  "KI4K064369
         EXPORTING
              I_CTR_LEV         = L_ONE_LEV
              I_POS_LEV         = L_ALL_LEV
              I_C_CTR_LEV       = L_ONE_LEV
              I_C_POS_LEV       = L_ALL_LEV
              I_MULTI_SEL       = ON
              I_DEL_NON_CARRIER = ON
              I_ONLY_30_POS     = ON
              I_POST_CARRIER    = OFF.

*-----Finanzstelle bestimmen
    L_OBJHI = 'FS....%'.
    L_OBJHI+2(4) = FMPS-FIKRS.
    SELECT * FROM BPCJ INTO TABLE LT_BPCJ WHERE OBJNR LIKE L_OBJHI
                                    AND   POSIT = '*'
                                    AND   TRGKZ = L_NODE
                                    AND   WRTTP = L_WFBUDGET
                                    AND   GJAHR = BPDY-GJAHR
                                    AND   GEBER = FMPS-GEBER.

    LOOP AT LT_BPCJ.
      L_COUNT = L_COUNT + 1.
      L_FISTL = LT_BPCJ-OBJNR+6.
    ENDLOOP.
    IF L_COUNT <> 1.
*-----Fehlermeldung: Keine zu bearbeitenden Objekte vorhanden
      MESSAGE E008(BP) WITH TEXT-401.
    ENDIF.

    IF NOT FMPS-FISTL IS INITIAL AND FMPS-FISTL <> L_FISTL.
*-----Fehlermeldung: Keine zu bearbeitenden Objekte vorhanden
      MESSAGE E008(BP) WITH TEXT-401.
    ENDIF.

*   CALL FUNCTION 'FM4C_READ_HIERARCHY'                     "KI4K064369
    CALL FUNCTION 'FM4C_READ_HIERARCHY'             "#EC *  "KI4K064369
         EXPORTING
              I_FIKRS  = FMPS-FIKRS
              I_FIPOS  = L_TOP_FIPOS
              I_FISTL  = L_FISTL
              I_GEBER  = FMPS-GEBER
              I_GJAHR  = BPDY-GJAHR
         IMPORTING
              E_PROFIL = TBP1C-PROFIL.

  ELSE.                                                     "KI4K046838
                                                            "KI4K046838
* Obiger Teil kopiert und verändert
    DATA: L_TOP_FISTL LIKE FMFCTR-FICTR.
    DATA: L_F_FMHISV LIKE FMHISV.

*    CALL FUNCTION 'FM_FICTR_READ_SINGLE'                   "KI4K065208
    CALL FUNCTION 'FM_FICTR_READ_SINGLE'            "#EC *  "KI4K065208
         EXPORTING
              I_FIKRS     = FMPS-FIKRS
              I_FICTR     = FMPS-FISTL
              I_FLAG_HIER = 'X'
              I_GJAHR     = BPDY-GJAHR
         IMPORTING
              E_F_FMHISV  = L_F_FMHISV.
    L_TOP_FISTL = L_F_FMHISV-HIROOT_ST.
    IF L_TOP_FISTL IS INITIAL.
      MESSAGE E008(BP) WITH TEXT-401.
    ENDIF.

*----Hierarchieaufbau von oben
    PERFORM SET_LEVEL USING OFF.

    L_ONE_LEV = 1.

*   CALL FUNCTION 'FM4C_READ_HIERARCHY_SET'                 "KI4K064369
    CALL FUNCTION 'FM4C_READ_HIERARCHY_SET'         "#EC *  "KI4K064369
         EXPORTING
              I_CTR_LEV         = L_ALL_LEV
              I_POS_LEV         = L_ALL_LEV
              I_C_CTR_LEV       = L_ALL_LEV
              I_C_POS_LEV       = L_ALL_LEV
              I_MULTI_SEL       = ON
              I_DEL_NON_CARRIER = ON
