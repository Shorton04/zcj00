*&---------------------------------------------------------------------*
*&      Form  DETERMINE_BPIN_TWAER
*&---------------------------------------------------------------------*
FORM determine_bpin_twaer.

  data: l_twaer like bpge-twaer.                           " n. 971073
  CHECK new_currency = on.

  bpin-twaer = bpdy-twaer.

*-----die Routine DETERMINE_BPIN-TWAER wird aus der Routine START
*     jetzt mehrere Male gerufen - die Verprobung der STATICS l_profil
*     ermöglicht Verarbeitung jedoch nur einmal
  STATICS l_profil LIKE tbp1c-profil.                        "MCUR
  CHECK tbp1c-profil <> l_profil.                            "MCUR
  MOVE tbp1c-profil TO l_profil.                             "MCUR

  CALL FUNCTION 'KBPS_CHECK_PROFIL'
    EXPORTING
      applik  = bpin-applik
      profil  = tbp1c-profil
      wrttp   = bpin-wrttp
    IMPORTING
      ex_bp1c = tbp1c.
* Bei Budgetverteilung keinerlei Meldungen,                " n. 684794
* da Transaktionswährung eh je Maßnahme einzeln            " n. 684794
* bestimmt wird.                                           " n. 684794
  CHECK NOT ( bpin-applik = l_iprog AND                     " n. 684794
              bpin-ind_1  = on      ).                      " n. 684794

*-----beliebige Transaktionswaehrung
  IF tbp1c-curtra = on.
    perform determine_bpin_twaer_rollup                    " n. 971073
      changing bpin tbp1c l_twaer.                         " n. 971073
    IF bpin-twaer IS INITIAL.
      IF tbp1c-obj IS INITIAL.                   "MCUR
        MESSAGE i402(bp).
      ELSE.                                      "MCUR
        MESSAGE i422(bp).                        "MCUR
      ENDIF.                                     "MCUR
*     Weiter wie mit explizit gesetzter                    " n. 971073
*     Transaktionswährung.                                 " n. 971073
      if not l_twaer is initial.                           " n. 971073
        bpin-twaer = l_twaer.                              " n. 971073
        bpdy-twaer = l_twaer.                              " n. 971073
      endif.                                               " n. 971073
    ENDIF.
    EXIT.
  ENDIF.

*-----Objektwaehrung
  IF tbp1c-curobj = on.
    perform determine_bpin_twaer_rollup                    " n. 971073
      changing bpin tbp1c l_twaer.                         " n. 971073
    IF NOT bpin-twaer IS INITIAL.
      CLEAR bpin-twaer.
      MESSAGE i401(bp).
    ENDIF.
    EXIT.
  ENDIF.

*-----Kostenrechnungskreiswaehrung
  CHECK NOT bpin-twaer IS INITIAL.
  CLEAR bpin-twaer.
  MESSAGE i400(bp).

ENDFORM.                               " DETERMINE_BPIN_TWAER

