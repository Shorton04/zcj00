FORM finanzbudget.

  DATA: l_carrier_payment,
        l_carrier_commitment.
  DATA  l_actvt LIKE tact-actvt.



  CASE okcode.
    WHEN 'SELE'.
      PERFORM okcode. CLEAR okcode.

    WHEN 'CLAS'.
      PERFORM okcode. CLEAR okcode.

    WHEN 'FISI'.
      PERFORM master_data USING on.

    WHEN 'POSI'.
      PERFORM master_data USING off.

* Change FM-Area
    WHEN 'SFIK'.
      PERFORM change_fm_area.

    WHEN 'CVAR'.
      perform change_variant.

  ENDCASE.

*-----Fehlerprotokoll zuruecksetzen
  CALL FUNCTION 'MESSAGES_INITIALIZE'
    EXPORTING
      reset = on.


*-----Ermittlung Default-Geschaeftsjahr
  IF bpdy-gjahr IS INITIAL.

    CALL FUNCTION 'KBPA_GET_START_FISCAL_YEAR_OPT'
      EXPORTING
        i_fm_area           = fmps-fikrs
        i_fin_code          = fmps-geber
      IMPORTING
        e_start_fiscal_year = bpdy-gjahr.

  ELSE.

    CALL FUNCTION 'KBPS_CHECK_GJAHR'
      EXPORTING
        i_gjahr = bpdy-gjahr
      IMPORTING
        e_gjahr = bpdy-gjahr.

    SET PARAMETER ID 'GJR' FIELD bpdy-gjahr.
  ENDIF.

  PERFORM set_level USING off.

* if bpin-wrttp = l_wfbudget or bpin-wrttp = l_wfrelease.
*   move on to l_carrier_payment.
* endif.

* if bpin-wrttp = l_wpbudget or bpin-wrttp = l_wprelease.
*   move on to l_carrier_commitment.
* endif.

*-----Berechtigungspruefung Finanzkreis
  IF bpin-show = off.
    l_actvt = fmau_bu_cre.
  ELSE.
    l_actvt = fmau_bu_dis.
  ENDIF.

  CALL FUNCTION 'FM_AUTH_CHECK_FM_AREA'
    EXPORTING
      i_fikrs = fmps-fikrs
      i_actvt = l_actvt
      i_msgty = 'E'.


* CALL FUNCTION 'FM4C_READ_HIERARCHY_SET'                   "KI4K064369
  CALL FUNCTION 'FM4C_READ_HIERARCHY_SET'           "#EC *  "KI4K064369
       EXPORTING
*           i_carrier_payment    = l_carrier_payment
*           i_carrier_commitment = l_carrier_commitment
            i_ctr_lev            = fmps-ctr_lev
            i_pos_lev            = fmps-pos_lev
            i_c_ctr_lev          = fmps-c_ctr_lev
            i_c_pos_lev          = fmps-c_pos_lev
            i_classification     = on
            i_del_non_carrier    = on
            i_only_30_pos        = on
            i_post_carrier       = off.

* CALL FUNCTION 'FM4C_READ_HIERARCHY'                       "KI4K064369
  CALL FUNCTION 'FM4C_READ_HIERARCHY'               "#EC *  "KI4K064369
       EXPORTING
            i_fikrs  = fmps-fikrs
            i_fipos  = fmps-fipos
            i_fistl  = fmps-fistl
            i_geber  = fmps-geber
            i_gjahr  = bpdy-gjahr
            i_farea  = bpdy-farea                           "FAREA
       IMPORTING
            e_profil = tbp1c-profil.

  CALL FUNCTION 'FM_FIKRS_CHECK_MD_YEAR_DEPEND'              "YYPOS
         EXPORTING                                           "YYPOS
            i_fikrs                = fmps-fikrs              "YYPOS
         IMPORTING                                           "YYPOS
            e_flg_year_master_data = bpin-md_yeardep.        "YYPOS

  bpin-geber = fmps-geber.

  MOVE: bpdy-gjahr TO bpin-gjahr,
        fmps-fikrs TO bpin-fikrs,
        bpdy-versn TO bpin-versn,
        bpdy-subvo TO bpin-subvo,
        bpdy-farea TO bpin-farea.

*-----Textformatierung ausschalten
* CALL FUNCTION 'FM4E_SET_FORMAT'                           "KI4K064369
  CALL FUNCTION 'FM4E_SET_FORMAT'                   "#EC *  "KI4K064369
       EXPORTING
            i_activate_format = off.

  CALL FUNCTION 'KBPS_OBJHI_NAME_GENERATE'
    EXPORTING
      i_application = l_funds
      i_fm_area     = fmps-fikrs
    IMPORTING
      e_objhi       = bpin-objhi.

*-----Periodenverarbeitung
  CHECK NOT bpdy-perio IS INITIAL.

  DATA: l_min_period LIKE t009-anzbp VALUE 1,
        l_max_period LIKE t009-anzbp.

  CALL FUNCTION 'KBPS_CHECK_PROFIL'
    EXPORTING
      applik  = l_funds
      profil  = tbp1c-profil
    IMPORTING
      ex_bp1c = tbp1c.

  IF tbp1c-bppe = off.
    MESSAGE e017.
  ENDIF.

  CALL FUNCTION 'KBPS_GET_PERIODS'
    EXPORTING
      fikrs_periv    = space
      fikrs_ca_periv = on
      fikrs          = fmps-fikrs
      kokrs          = space
    IMPORTING
      perio          = l_max_period.

  IF  bpdy-perio <  l_min_period OR
      bpdy-perio >  l_max_period.
    MESSAGE e028 WITH l_min_period l_max_period.
  ENDIF.

  MOVE: bpdy-perio TO bpin-perio,
        on         TO bpin-peri.

*-----Fondeingabe bei deaktiviertem Fond nicht erlaubt
