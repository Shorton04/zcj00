  CALL FUNCTION 'KBPP_START'
    EXPORTING
      bp_in = bpin
      init  = init
      imp01 = <h>                                           "ALRK203311
      imp02 = <i>                                           "ALRK203311
    IMPORTING
      bp_ex = bpex.

