  CALL FUNCTION 'DEQUEUE_ALL'.

  IF VCOPY_DYN_MGR-APPLIC_INIT_DONE IS INITIAL.
    PERFORM ERRORPROT_RESET.


    PERFORM PROJ_READ_MGR_INIT.

    CLEAR VCOPY_DYN_CJ_MGR-PSPID.
    CLEAR VCOPY_DYN_CJ_MGR-V_VERS_Z.
    CLEAR VCOPY_DYN_CJ_MGR-V_VERS_V.

    VCOPY_DYN_CJ_MGR-V_PSP        = ON.
*   IF VCOPY_DYN_CJ_MGR-IS_COST_PL = ON.
*     VCOPY_DYN_CJ_MGR-V_COST     = ON.
*     VCOPY_DYN_CJ_MGR-V_EINZKALK = ON.
*     VCOPY_DYN_CJ_MGR-V_ERLOESE  = OFF.
*   ELSE.
*     VCOPY_DYN_CJ_MGR-V_COST     = OFF.
*     VCOPY_DYN_CJ_MGR-V_EINZKALK = OFF.
*     VCOPY_DYN_CJ_MGR-V_ERLOESE  = ON.
*   ENDIF.

*   VCOPY_DYN_CJ_MGR-V_YEAR_X  = ON.
*   VCOPY_DYN_CJ_MGR-V_YEAR_XS = '1900'.
*   VCOPY_DYN_CJ_MGR-V_YEAR_XE = '9999'.
*   VCOPY_DYN_CJ_MGR-V_GESAMT  = ON.

*-----Daten Popup Kopiermodus
    VCOPY_DYN_CJ_MGR-COPY_RESET = ON.

    VCOPY_DYN_MGR-APPLIC_INIT_DONE = ON.
  ENDIF.

* Dynprofelder aus Zeitintervall-Popup
  VCOPY_DYN_CJ_MGR-V_YEAR_X  = BPDY-V_YEAR_X.
  VCOPY_DYN_CJ_MGR-V_YEAR_XS = BPDY-V_YEAR_XS.
  VCOPY_DYN_CJ_MGR-V_YEAR_XE = BPDY-V_YEAR_XE.
  VCOPY_DYN_CJ_MGR-V_GESAMT  = BPDY-V_GESAMT.

* Versionen kopieren
  PERFORM VCOPY_PROC_CMD_PROJ.

* Fehlerprotokoll ausgeben
  PERFORM ERRORPROT_PRINT USING VCOPY_DYN_MGR-ERR_TITLE.

ENDFORM.                               " BATCH_PROCESS      "ALRK054341


