*&---------------------------------------------------------------------*
*&      Form  INIT_PROJ_PBO
*&---------------------------------------------------------------------*
*       Projektspezifische Initialisierung bei PBO - Dynpro 200        *
*----------------------------------------------------------------------*
FORM INIT_PROJ_PBO.

*-----Initialisierung des Objekts PROJ_READ_MGR
*-----(es wurde noch kein Projekt eingelesen)
  PERFORM PROJ_READ_MGR_INIT.

*-----Version ausblenden
  IF SY-TCODE <> 'CJ40' AND SY-TCODE <> 'CJ41' AND
     SY-TCODE <> 'CJ42' AND SY-TCODE <> 'CJ43'.
    MOVE: 'VER' TO DYN-GROUP1,
          '1' TO DYN-INVISIBLE.
    PERFORM SCREENLOOP USING ON.
  ELSE.                                                     "P30K065072
*-----Version setzen (aus Set/Get-Parameter) bzw. 000)
    IF BPDY-VERSN IS INITIAL.
      GET PARAMETER ID 'BP2' FIELD BPDY-VERSN.
      IF BPDY-VERSN IS INITIAL.
        BPDY-VERSN = BPIN-VERSN.
      ENDIF.
    ENDIF.                                                  "P30K065072
  ENDIF.

*-----Finanzposition ausblenden
  IF SY-TCODE <> 'CJ48' AND SY-TCODE <> 'CJ49'.
    MOVE: 'FIP' TO DYN-GROUP1,
          '1' TO DYN-INVISIBLE.
    PERFORM SCREENLOOP USING ON.
  ENDIF.

*-----Obligatorische Felder
  IF SY-TCODE = 'CJ48' OR SY-TCODE =  'CJ49'.
    MOVE: 'PROJ-PSPID' TO DYN-SPALTE1.
  ELSE.
    MOVE: 'PRPS-POSID' TO DYN-SPALTE1.
  ENDIF.

  MOVE '0' TO DYN-REQUIRED.
  PERFORM SCREENLOOP USING ON.

* gegebenenfalls Währung ausblenden                                 "CUR
  LOOP AT SCREEN.                                           "CUR
    CHECK ( SCREEN-NAME = 'BPDY-TWAER' AND NEW_CURRENCY = SPACE )."CUR
    SCREEN-ACTIVE = 0.                                      "CUR
    MODIFY SCREEN.                                          "CUR
  ENDLOOP.  "CUR

* Kostenrechnungskreis                                      "ALRK203311
  LOOP AT SCREEN.                                           "ALRK203311
    CHECK SCREEN-NAME = 'CODIA-KOKRS'.                      "ALRK203311
    SCREEN-ACTIVE = 0.                                      "ALRK203311
    MODIFY SCREEN.                                          "ALRK203311
  ENDLOOP.                                                  "ALRK203311

* Kostenrechnungskreis setzen                               "ALRK203311
  IF CODIA-KOKRS IS INITIAL.                                "ALRK203311
    CALL FUNCTION 'K_KOKRS_SET'                             "ALRK203311
         IMPORTING                                          "ALRK203311
              E_KOKRS = CODIA-KOKRS.                        "ALRK203311
  ENDIF.                                                    "ALRK203311

ENDFORM.



*---------------------------------------------------------------------*
*     FORM   !PROJEKT                                                 *
*---------------------------------------------------------------------*
*     Selektion Projekt                                               *
