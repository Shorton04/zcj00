*&---------------------------------------------------------------------*
*&      Form  VCOPY_DYN_FM_MGR_REQV_VERS
*&---------------------------------------------------------------------*
*       F4 fuer Versionen - Finanzbudgets                              *
*                                                                      *
*   * Destination-Version: es werden alle Versionen angezeigt          *
*                                                                      *
*   * Source-Version: es werden wahlweise "alle Versionen" oder die    *
*     "erstellten Versionen" angezeigt. Fuer die "erstellten Versioen" *
*     wird die Eingabe in den Dynprofeldern "Finanzkreis", "Geldgeber" *
*     und "alle Geldgeber" beruecksichtigt, wobei alle Versionen ange- *
*     zeigt werden, die fuer mindestens einen der Werttypen            *
*     "Budget" und "Freigaben" definiert sind.                         *
*                                                                      *
*----------------------------------------------------------------------*
*  -->  p_is_source_vers:  ON = Auswahl einer "Source"-Version
*                               ---> Ergebnis nach BPDY-V_VERS_V
*                          OFF= Auswahl einer "Destination"-Version
*                               ---> Ergebnis nach BPDY-V_VERS_Z
*       P_NO_DIALOG:       ON = keinen Benutzerauswahl, ob alle oder
*                               nur erstellte Versionen anzeigen,
*                               sondern: was angezeigt wird, haengt von
*                               P_SHOW_ALL_VERSN ab
*                          OFF= Benutzerauswahl, ob alle oder nur die
*                               erstellten Versionen anzeigen,
*                               P_SHOW_ALL_VERSN ist ohne Bedeutung
*        P_SHOW_ALL_VERSN: wird nur ausgewertet, falls P_NO_DIALOG = ON:
*                          ON = alle Versionen anzeigen
*                          OFF= nur die erstellten Versionen anzeigen
*                               (die es fuer mindestens 1 Geldgeber gibt
*        P_WRTTP, P_WRTTP2: Werttypen, die bei "erstellte Versionen
*                           anzeigen" beruecksichtigt werden
*
*----------------------------------------------------------------------*
FORM VCOPY_DYN_FM_MGR_REQV_VERS USING VALUE(P_IS_SOURCE_VERS)
                                      VALUE(P_NO_DIALOG)
                                      VALUE(P_SHOW_ALL_VERSN)
                                      VALUE(P_WRTTP)
                                      VALUE(P_WRTTP2).

  DATA: L_VERSION LIKE BPDY-V_VERS_V,
        L_OBJHI   LIKE BPIN-OBJHI,
        L_FIKRS   LIKE BPIN-FIKRS,
        L_SUBRC LIKE SY-SUBRC.



*-----Dynprofelder lesen
  REFRESH DYNP.
  CLEAR DYNP.
  DYNP-FIELDNAME = 'FMPS-FIKRS'.
  APPEND DYNP.

  CALL FUNCTION 'DYNP_VALUES_READ'
       EXPORTING
            DYNAME     = 'SAPMKBUD'
            DYNUMB     = SY-DYNNR
       TABLES
            DYNPFIELDS = DYNP
       EXCEPTIONS
            OTHERS     = 1.

  L_SUBRC = SY-SUBRC.

  IF L_SUBRC IS INITIAL.
    READ TABLE DYNP INDEX 1.
    L_SUBRC = SY-SUBRC.
    L_FIKRS = DYNP-FIELDVALUE.
  ENDIF.

  IF L_SUBRC IS INITIAL.
*-----Umwandlung in Grossbuchstaben
    SET LOCALE LANGUAGE SY-LANGU.
    TRANSLATE L_FIKRS TO UPPER CASE.
    SET LOCALE LANGUAGE SPACE.

    CALL FUNCTION 'KBPS_OBJHI_NAME_GENERATE'
         EXPORTING
              I_APPLICATION            = VCOPY_DYN_MGR-APPLICATION
              I_FM_AREA                = L_FIKRS
              I_OBJECT_INITIAL_ALLOWED = ON
         IMPORTING
              E_OBJHI                  = L_OBJHI.

    CALL FUNCTION 'KBPS_SHOW_VERSIONS'
         EXPORTING
              APPLIK       = VCOPY_DYN_MGR-APPLICATION
              OBJECT       = L_OBJHI
              WRTTP        = P_WRTTP
              WRTTP2       = P_WRTTP2
              GEBER_ALL    = ON
              IM_COP_VERSN = P_NO_DIALOG
              IM_ALL_VERSN = P_SHOW_ALL_VERSN
         IMPORTING
              VERSION      = L_VERSION
         EXCEPTIONS
              NO_VERSIONS  = 01.

    IF SY-SUBRC IS INITIAL.
      IF P_IS_SOURCE_VERS = ON.
        BPDY-V_VERS_V = L_VERSION.
      ELSE.
        BPDY-V_VERS_Z = L_VERSION.
      ENDIF.
    ENDIF.
  ENDIF.

ENDFORM.



