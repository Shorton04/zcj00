*&---------------------------------------------------------------------*
*&      Form  ACTIVITY_CHECK
*&---------------------------------------------------------------------*
*       Aktivitaetspruefungn                                           *
*----------------------------------------------------------------------*
FORM activity_check.

  DATA l_check_com_bud.
  DATA l_check_pay_bud.
  DATA l_activity TYPE bpbu_act_allowed-activity.
  DATA l_versn LIKE bpin-versn.



  l_versn = bpdy-versn.
  IF l_versn IS INITIAL.
    l_versn = ini_versn.
  ENDIF.

  IF sy-tcode = 'FMDA' OR sy-tcode = 'FMDC'.
*-----Haushaltsplanung, Sammelnachweisplanung
    l_check_com_bud = on.
    l_check_pay_bud = on.
    l_activity      = g_con_act_org.
  ELSEIF sy-tcode = 'FMD7' OR sy-tcode = 'FMD9'.
*-----Nachtrags-Haushaltsplanung, Nachtrags-Sammelnachweisplanung
    l_check_com_bud = on.
    l_check_pay_bud = on.
    l_activity      = g_con_act_sup.
  ELSEIF sy-tcode = 'FMDE' OR sy-tcode = 'FMDG'.
*-----Rechnungsergebnis, Rechnungsergebnis im SN
    l_check_pay_bud = on.
    l_activity      = g_con_act_ych.
  ELSEIF sy-tcode = 'FMDK'.
*-----Saldenbudgetierung
    l_check_pay_bud = on.
    l_activity      = g_con_act_org.
  ENDIF.

  IF NOT l_activity IS INITIAL.
    CALL FUNCTION 'FM17_ACTIVITY_ALLOWED_GET'
      EXPORTING
        i_fikrs       = fmps-fikrs
        i_gjahr       = bpdy-gjahr
        i_geber       = fmps-geber
        i_versn       = l_versn
        i_activity    = l_activity
        i_flg_com_bud = l_check_com_bud
        i_flg_pay_bud = l_check_pay_bud.

  ENDIF.

ENDFORM.                    "ACTIVITY_CHECK



