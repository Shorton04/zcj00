*&---------------------------------------------------------------------*
*&      Form  VCOPY_DYN_MGR_INIT
*&---------------------------------------------------------------------*
*       Versionen Kopieren - Initialisierungen zum Zeitpunkt PBO       *
*----------------------------------------------------------------------*
*  -->
*  <--
*----------------------------------------------------------------------*
FORM vcopy_dyn_mgr_init.

  DATA l_da_active.
  DATA l_fund_active.                                       "470

  DATA: title_code LIKE sy-tcode,
        tdid       LIKE bpin-tdid.

*-----Berechtigungspruefung bei "Versionen kopieren - Projekte"
  IF sy-tcode = 'CJ9B' OR sy-tcode = 'CJ9C'.
    CALL FUNCTION 'CNAU_AUTHORITY_TCD'.
  ENDIF.

*-----Initialisierung ISPS-Mode
  vcopy_dyn_mgr-isps_mode = off.

*-----Applikation ermitteln
  vcopy_dyn_mgr-err_title = 0.
  CASE sy-dynnr.
    WHEN '0900'.

       CALL FUNCTION 'FM_BUD_CHECK_COMPONENT'  "#EC *     " 470
            EXCEPTIONS
                 error_message      = 1.

      IF SY-SUBRC <> 0.
        MESSAGE ID SY-MSGID TYPE 'S' NUMBER SY-MSGNO
                WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
        LEAVE PROGRAM.
      ENDIF.

*-----Finanzbudgets - Versionen kopieren
      vcopy_dyn_mgr-application = l_funds.
      vcopy_dyn_mgr-err_title = 1.

      CALL FUNCTION 'FM00_CHECK_ISPS'
           IMPORTING
                e_da_activ = l_da_active.

      IF l_da_active = on.
        vcopy_dyn_mgr-isps_mode = on.
      ENDIF.

      call function 'FM_GET_ACTIVE_DIMENSIONS'                "#EC *
           importing
                e_fund_active     = l_fund_active.


    WHEN '0903'.
*-----Finanzbudgets - Versionen sperren, entsperren, loeschen
      vcopy_dyn_mgr-application = l_funds.
      IF sy-tcode = 'FMP2'.
*-----Finanzplan-Versionen loeschen
        vcopy_dyn_mgr-application = l_fipl.
      ELSE.
        CALL FUNCTION 'FM_BUD_CHECK_COMPONENT'     "#EC *     " 470
             EXCEPTIONS
                  error_message      = 1.

        IF SY-SUBRC <> 0.
          MESSAGE ID SY-MSGID TYPE 'S' NUMBER SY-MSGNO
                  WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
          LEAVE PROGRAM.
        ENDIF.

        call function 'FM_GET_ACTIVE_DIMENSIONS'              "#EC *
             importing
                  e_fund_active     = l_fund_active.

      ENDIF.

    WHEN '0910'.
*-----Projekte - Kostenplanung
      vcopy_dyn_mgr-application = l_project.
      vcopy_dyn_mgr-err_title = 2.
    WHEN '0920'.
*-----Projekte - Erloesplanung
      vcopy_dyn_mgr-application = l_project.
      vcopy_dyn_mgr-err_title = 3.
    WHEN OTHERS.
      MESSAGE a005 WITH 'SY-DYNNR' '-' 'MKBUDF05'
                        'VCOPY_DYN_MGR_INIT'.
  ENDCASE.

  CLEAR bpin.

*-----Textid fuer Langtexte ermitteln
*--- evtl. in kbps_init ...
  tdid = 'BPXT'.
  WRITE vcopy_dyn_mgr-application TO tdid+2(1).

*-----Langtext-Objekt initialisieren
  PERFORM longtext_mgr_init USING tdid.

*-----alles entsperren
  CALL FUNCTION 'DEQUEUE_ALL'.

*-----Status setzen
  SET PF-STATUS sy-tcode.

*-----Titel setzen
  WRITE sy-tcode+1 TO title_code.
  SET TITLEBAR title_code.

*-----einmalige Initialisierungen bei Programmstart
  IF vcopy_dyn_mgr-applic_init_done IS INITIAL.
*-----noch keine Initialisierung erfolgt - jetzt initialisieren

*-----allgemeine Initialisierungen
    PERFORM errorprot_reset.

*-----applikationsabhaengige Initialisierungen
    PERFORM vcopy_dyn_mgr_init_applic.

*-----Initialisierung ist jetzt durchgefuehrt
    vcopy_dyn_mgr-applic_init_done = on.
  ENDIF.

*-----Dynprofelder setzen
  PERFORM vcopy_dyn_mgr_set_dynpro.

*----Dynpro modifizieren
  LOOP AT SCREEN.

*-----bei "FMR loeschen" und "HHM entsperren"               "KI4K011572
*-----die Felder Gesamtwerte/Geschaeftsjahr ausblenden      "KI4K011572
    IF ( sy-tcode = 'FM9E' OR sy-tcode = 'FMP2' )           "KI4K011572
       AND screen-group1 = 'M9D'.                           "KI4K011572
      MOVE: '1' TO screen-invisible,                        "KI4K011572
            '0' TO screen-input,                            "KI4K011572
            '0' TO screen-output.                           "KI4K011572
      MODIFY SCREEN.                                        "KI4K011572
    ENDIF.                                                  "KI4K011572

    CASE sy-tcode.
*-----Versionen sperren ü
      WHEN 'FM9D'.
        CHECK screen-group1 = 'M9D'.
        MOVE: '1' TO screen-invisible,
              '0' TO screen-input,
              '0' TO screen-output.

        IF l_fund_active IS INITIAL.                        "470
          CLEAR FMPS-GEBER.
          CHECK screen-group3 = 'M9E'.
          MOVE: '1' TO screen-invisible,
                '0' TO screen-input,
                '0' TO screen-output.
        ENDIF.
*-----Versionen entsperren
      WHEN 'FM9E'.                                          "470
        IF l_fund_active IS INITIAL.
          CLEAR FMPS-GEBER.
          CHECK screen-group3 = 'M9E'.
          MOVE: '1' TO screen-invisible,
                '0' TO screen-input,
                '0' TO screen-output.
        ENDIF.
*-----löschen Versionen Finanzbudgetmanagement
      WHEN 'FM9F'.
        CHECK screen-group1 = 'M9F'.
        MOVE: '1' TO screen-invisible,
              '0' TO screen-input,
              '0' TO screen-output.
*-----löschen Versionen Finanzmittelrechnung
      WHEN 'FMP2'.
        CHECK screen-group2 = 'MP2'.
        MOVE: '1' TO screen-invisible,
              '0' TO screen-input,
              '0' TO screen-output.
*-----Finanzbudget-Versionen kopieren
      WHEN 'FM9B'.
        CHECK screen-group1 = 'IPS' AND vcopy_dyn_mgr-isps_mode = off.
        MOVE: '1' TO screen-invisible,
              '0' TO screen-input,
              '0' TO screen-output.
    ENDCASE.

*-----Versionen kopieren - Projekte
    IF sy-tcode = 'CJ9B' OR sy-tcode = 'CJ9C'.
      CHECK screen-group1 = 'PLD'.
      MOVE: '1' TO screen-invisible,
            '0' TO screen-input,
            '0' TO screen-output.
    ENDIF.

    MODIFY SCREEN.
  ENDLOOP.

ENDFORM.



