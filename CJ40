*       FORM VCOPY_PROC_CMD_PROJ                                      *
*---------------------------------------------------------------------*
*       Versionen von Projektintervallen kopieren                     *
*---------------------------------------------------------------------*
FORM VCOPY_PROC_CMD_PROJ.                                   "ALRK023069

  DATA: BEGIN OF LT_PSPID OCCURS 0,                         "ALRK023069
          PSPID LIKE PROJ-PSPID.                            "ALRK023069
  DATA: END   OF LT_PSPID.                                  "ALRK023069

  STATICS: L_PSPID LIKE PROJ-PSPID,                         "ALRK023069
           L_OKCODE(4).                                     "ALRK023069

* Daten von Selektionsdynpro retten
  L_PSPID  = PROJ-PSPID.                                    "ALRK023069
  L_OKCODE = OKCODE.                                        "ALRK023069
* Projekte aus Intervall einlesen
  IF L_OKCODE = 'CJ9B' OR                                   "ALRK023069
     L_OKCODE = 'CJ9C'.                                     "ALRK023069
    IF BPDY-V_BATCH IS INITIAL.                             "ALRK023069
      SELECT PSPID FROM PROJ INTO TABLE LT_PSPID            "ALRK023069
            WHERE PSPID = L_PSPID. "4.0 Zeile entfernen     "ALRK023069
**          WHERE PSPID BETWEEN L_PSPID  "4.0 ** entfernen  "ALRK023069
**                      AND     *PROJ-PSPID."4.0 ** entf.   "ALRK023069
* Projekte verarbeiten
      LOOP AT LT_PSPID.                                     "ALRK023069
        PROJ-PSPID = LT_PSPID-PSPID.                        "ALRK023069
        OKCODE    = L_OKCODE.                               "ALRK023069
        PERFORM VCOPY_DYN_MGR_PROC_NORMAL_CMD.              "ALRK023069
      ENDLOOP.                                              "ALRK023069
    ELSE.                                                   "ALRK023069
      PERFORM BATCH_JOB_CREATE.                             "ALRK023069
    ENDIF.                                                  "ALRK023069
  ENDIF.                                                    "ALRK023069

* PSPID von Selektionsdynpro zurückschreiben
  PROJ-PSPID = L_PSPID.                                     "ALRK023069
  VCOPY_DYN_CJ_MGR-PSPID = L_PSPID.                         "ALRK023069
  VCOPY_DYN_CJ_MGR-V_VERS_Z = BPDY-V_VERS_Z.                "ALRK023069
  VCOPY_DYN_CJ_MGR-V_VERS_V = BPDY-V_VERS_V.                "ALRK023069

ENDFORM.                               " VCOPY_PROC_CMD_PROJ


