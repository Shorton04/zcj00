FORM PROJEKT.

  CALL FUNCTION 'MESSAGES_INITIALIZE'
       EXPORTING
            RESET = ON.

  PERFORM PROJ_READ_MGR_READ.

  MOVE: PROJ-VGSBR TO BPIN-GSBER,
        PROJ-OBJNR TO BPIN-OBJHI.

  PERFORM PROJECT_PROFILE USING    BPIN-WRTTP
                          CHANGING TBP1C-PROFIL.

  ASSIGN: PROJ TO <H>,                                      "ALRK203311
          PRPS TO <I>.                                      "ALRK203311

*-----Finanzplanung
  IF SY-TCODE = 'CJ48' OR SY-TCODE = 'CJ49'.

    CALL FUNCTION 'FMFK_GET_FIKRS_FROM_BUKRS'
         EXPORTING
              I_BUKRS = PROJ-VBUKR
         IMPORTING
              E_FIKRS = FMPS-FIKRS.

    MOVE FMPS-FIKRS TO BPIN-FIKRS.

  ENDIF.

ENDFORM.


*---------------------------------------------------------------------*
*       FORM !PROJECT_PROFILE                                         *
*---------------------------------------------------------------------*
*  Bestimmen Projektprofil in Abhängigkeit vom Werttyp                *
*  Globale Feldleiste PROJ enthält Projektdefinition                  *
*---------------------------------------------------------------------*
FORM PROJECT_PROFILE USING    L_WRTTP
                     CHANGING L_PROFIL.

  CASE L_WRTTP.
    WHEN L_WPLAN.                      "Kosten-, Erlösplanung
      MOVE: PROJ-PPROF TO L_PROFIL.
*-----Sonderlösung für 3.0: ggf. doch noch das Budgetprofil verwenden
      IF L_PROFIL = SPACE.
        MOVE: PROJ-BPROF TO L_PROFIL.
      ENDIF.
    WHEN L_WFPLAN.                     "Finanzplanung
      MOVE: PROJ-FMPRF TO L_PROFIL.
    WHEN OTHERS.                       "Budgetierung
      MOVE: PROJ-BPROF TO L_PROFIL.
  ENDCASE.

ENDFORM.

*&---------------------------------------------------------------------*
*&      Form !PROJECT_F4_VERSION
*&---------------------------------------------------------------------*
*       F4 auf Projekt Versionen                                       *
*----------------------------------------------------------------------*
FORM PROJECT_F4_VERSION.

  DATA  L_SUBRC LIKE SY-SUBRC.
  DATA  L_KOKRS LIKE BPIN-KOKRS.

  DATA: BEGIN OF L_PRPS_PROJ.
          INCLUDE STRUCTURE PROJ.
  DATA: END OF L_PRPS_PROJ.

  DATA: BEGIN OF L_PROJ.
          INCLUDE STRUCTURE PROJ.
  DATA: END OF L_PROJ.

  DATA: BEGIN OF L_PRPS.
          INCLUDE STRUCTURE PRPS.
  DATA: END OF L_PRPS.

*-----init
  L_SUBRC = 0.

*----Dynpro-Felder lesen
  REFRESH DYNP.
  CLEAR   DYNP.
  MOVE: 'PROJ-PSPID' TO DYNP-FIELDNAME.
  APPEND DYNP.
  MOVE: 'PRPS-POSID' TO DYNP-FIELDNAME.
  APPEND DYNP.

  CALL FUNCTION 'DYNP_VALUES_READ'
       EXPORTING
            DYNAME     = 'SAPMKBUD'
            DYNUMB     = SY-DYNNR
       TABLES
            DYNPFIELDS = DYNP
       EXCEPTIONS
            OTHERS     = 1.

  IF SY-SUBRC = 1.
    L_SUBRC = 1.
  ENDIF.

  IF L_SUBRC = 0.
    READ TABLE DYNP INDEX 1.
    MOVE DYNP-FIELDVALUE TO PROJ-PSPID.
    READ TABLE DYNP INDEX 2.
    MOVE DYNP-FIELDVALUE TO PRPS-POSID.

    CALL FUNCTION 'CONVERSION_EXIT_PROJN_INPUT'
         EXPORTING
              INPUT         = PROJ-PSPID
         IMPORTING
              OUTPUT        = PROJ-PSPID
         EXCEPTIONS
              ERROR_MESSAGE = 1.

    IF SY-SUBRC = 1.
      MESSAGE ID SY-MSGID TYPE 'S' NUMBER SY-MSGNO
                 WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
      L_SUBRC = 1.
    ENDIF.
  ENDIF.

  IF L_SUBRC = 0.
    CALL FUNCTION 'CONVERSION_EXIT_PROJN_INPUT'
         EXPORTING
              INPUT         = PRPS-POSID
         IMPORTING
              OUTPUT        = PRPS-POSID
         EXCEPTIONS
              ERROR_MESSAGE = 1.

    IF SY-SUBRC = 1.
      MESSAGE ID SY-MSGID TYPE 'S' NUMBER SY-MSGNO
                 WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
      L_SUBRC = 1.
    ENDIF.
  ENDIF.

*-----wurde PSP-Element oder Projekt eingegeben?
  IF L_SUBRC = 0.
    IF PROJ-PSPID IS INITIAL AND PRPS-POSID IS INITIAL.
      MESSAGE S005(CJ).
      L_SUBRC = 1.
    ENDIF.
  ENDIF.

*-----PSP-Element lesen
  IF L_SUBRC = 0.
    IF NOT PRPS-POSID IS INITIAL.
      CALL FUNCTION 'CJDW_PRPS_SELECT_SINGLE'
           EXPORTING
                POSID     = PRPS-POSID
           IMPORTING
                E_PRPS    = L_PRPS
           EXCEPTIONS
                NOT_FOUND = 01.

      IF SY-SUBRC = 1.
        MESSAGE S021(CJ) WITH PRPS-POSID.
        L_SUBRC = 1.
      ELSE.
*-----zugehoeriges Projekt einlesen
        CALL FUNCTION 'CJDW_PROJ_SELECT_SINGLE'
             EXPORTING
                  PSPNR     = L_PRPS-PSPHI
             IMPORTING
                  E_PROJ    = L_PRPS_PROJ
             EXCEPTIONS
                  NOT_FOUND = 01.

        IF SY-SUBRC = 1.
          MESSAGE S011(CJ) WITH L_PRPS-PSPHI.
          L_SUBRC = 1.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

*-----Projekt lesen
  IF L_SUBRC = 0.
    IF NOT PROJ-PSPID IS INITIAL.
      CALL FUNCTION 'CJDW_PROJ_SELECT_SINGLE'
           EXPORTING
                PSPID     = PROJ-PSPID
           IMPORTING
                E_PROJ    = L_PROJ
           EXCEPTIONS
                NOT_FOUND = 01.

      IF SY-SUBRC = 1.
        MESSAGE S011(CJ) WITH PROJ-PSPID.
        L_SUBRC = 1.
      ELSE.
        IF NOT PRPS-POSID IS INITIAL.
*-----gehoert PSP-Element zum angegebenen Projekt?
          IF L_PROJ-PSPNR <> L_PRPS_PROJ-PSPNR.
            MESSAGE S122(CJ) WITH L_PRPS-POSID L_PRPS_PROJ-PSPNR.
            L_SUBRC = 1.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

*-----Versionen anzeigen
  IF L_SUBRC = 0.
    IF NOT L_PROJ-OBJNR IS INITIAL.
      BPIN-OBJHI = L_PROJ-OBJNR.
    ELSE.
      BPIN-OBJHI = L_PRPS_PROJ-OBJNR.
    ENDIF.
    IF NOT L_PRPS-PKOKR IS INITIAL.
      L_KOKRS = L_PRPS-PKOKR.
    ELSE.
      L_KOKRS = L_PROJ-VKOKR.
    ENDIF.
    PERFORM SHOW_VERSIONS USING L_PROJECT BPIN-WRTTP L_KOKRS.

  ENDIF.

ENDFORM.



*---------------------------------------------------------------------*
*     FORM   !READ_PROJECT                                            *
*---------------------------------------------------------------------*
*     Selektion und ENQUEUE Projekt                                   *
*---------------------------------------------------------------------*
FORM READ_PROJECT.

  CLEAR VARC1.
  IF BPIN-SHOW = OFF.
    MOVE ON TO VARC1.
  ENDIF.


  CALL FUNCTION 'CJDW_SELECT_BASIC_DATA'
       EXPORTING
            ENQUEUE       = VARC1
            ENTRY_ELEMENT = PRPS-POSID
            PROJECT       = PROJ-PSPID
       IMPORTING
            E_PROJ        = PROJ
            E_PRPS        = PRPS
       EXCEPTIONS
            ENTRY_ELEMENT_NOT_FOUND       = 1
            MISSING_PARAMETER             = 2
            PROJECT_NOT_FOUND             = 3
            PROJECT_INACT                 = 4
            OTHERS                        = 5.

 IF sy-subrc <> 0.
   MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
           WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
 ENDIF.

ENDFORM.



*&---------------------------------------------------------------------*
*&      Form  CHECK_VERSION_PROJ_PAI
*&---------------------------------------------------------------------*
