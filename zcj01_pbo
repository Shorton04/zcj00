*&---------------------------------------------------------------------*
*& Module BUILD_IM_DROPDOWN OUTPUT
*&---------------------------------------------------------------------*
MODULE build_im_dropdown OUTPUT.

  DATA: gs_value  TYPE vrm_value,
        gt_values TYPE vrm_values,
        gt_impr   TYPE STANDARD TABLE OF ty_impr,
        gs_impr   TYPE ty_impr,
        gt_parts  TYPE STANDARD TABLE OF string,
        gv_dummy  TYPE string,
        gv_pr01   TYPE string.

  CHECK gt_im_dropdown IS INITIAL.

  " Get IM positions that have config entries
  SELECT
    i~posnr AS posnr,
    i~gjahr AS gjahr,
    i~posid AS posid,
    i~prnam AS prnam,
    i~izwek AS izwek
    FROM impr AS i
    INNER JOIN zta2r_conftab1 AS c
      ON c~izwek = i~izwek
      INTO TABLE @gt_impr
  ORDER BY i~posid DESCENDING.
  IF sy-subrc EQ 0.
    LOOP AT gt_impr INTO gs_impr.
      CLEAR gs_value.
      " Internal value.
      gs_value-key = gs_impr-posnr.

      SPLIT gs_impr-posid AT space INTO TABLE gt_parts.
      READ TABLE gt_parts INDEX lines( gt_parts ) INTO gs_value-text.

      APPEND gs_value TO gt_im_dropdown.
    ENDLOOP.


    CALL FUNCTION 'VRM_SET_VALUES'
      EXPORTING
        id              = 'gv_p_posnr'
        values          = gt_im_dropdown
      EXCEPTIONS
        id_illegal_name = 1
        OTHERS          = 2.
    IF sy-subrc <> 0.
      CLEAR gt_im_dropdown.
    ENDIF.
  ENDIF.

*  PERFORM ge_ariba.
ENDMODULE.



MODULE display_tree_preview OUTPUT.

  " Only proceed if template is set
  CHECK gv_p_pspid IS NOT INITIAL.

  " Create tree on first call
  IF lo_tree_preview IS INITIAL.
    PERFORM create_tree_control.
    " Verify creation succeeded
    CHECK lo_tree_preview IS NOT INITIAL.
  ENDIF.

  " Load or reload data if template changed
  IF gv_p_pspid NE gv_pspid_old.
    PERFORM load_tree_hierarchy.
    gv_pspid_old = gv_p_pspid.
  ENDIF.

ENDMODULE.

MODULE posnr_changed INPUT.

  SELECT SINGLE posnr
    FROM impr
    INTO @gv_im_posnr
    "UP TO 1 ROWS
    WHERE posid = @gv_p_posid.
  "ENDSELECT.
  IF sy-subrc EQ 0.
    gv_p_posnr = gv_im_posnr.
  ENDIF.

  IF gv_p_posnr IS NOT INITIAL AND gv_p_posnr NE gv_posnr_old.

    PERFORM get_im_data USING gv_p_posnr.

    " Force tree refresh
    IF lo_tree_preview IS NOT INITIAL.
      PERFORM free_tree_control.
    ENDIF.

    gv_posnr_old = gv_p_posnr.
  ENDIF.

ENDMODULE.
