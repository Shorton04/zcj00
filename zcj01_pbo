*&---------------------------------------------------------------------*
*& Module SET_TABLE_FIELD_ATTRIBUTES_E1 OUTPUT
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
MODULE set_table_field_attributes_e1 OUTPUT.
  DATA gs_p_wbs_stat TYPE ty_wbs_stat.

  LOOP AT SCREEN.

  IF gv_disp_req = abap_true.
    IF screen-name CP 'GS_WBS_UNCLOSE-TO_BE'.
      screen-input       = 0.
      screen-intensified = 0.
      MODIFY SCREEN.
      CONTINUE.
    ENDIF.

  ELSE.
    IF screen-name CP 'GS_WBS_UNCLOSE-TO_BE'.

      REPLACE ALL OCCURRENCES OF '.' IN gs_wbs_unclose-wbs_element_code WITH ''.

      CLEAR gs_p_wbs_stat.
      READ TABLE gt_wbs_stat INTO gs_p_wbs_stat
              WITH KEY posid = gs_wbs_unclose-wbs_element_code.

      IF sy-subrc = 0 AND ( gs_p_wbs_stat-stat = 'I0043' OR
                             gs_p_wbs_stat-stat = 'I0002' ).
        " Released / Lock → gray out
        screen-input       = 0.
        screen-intensified = 0.
        MODIFY SCREEN.

      ELSEIF sy-subrc <> 0.
        " Not found in status table → gray out as well
        screen-input       = 0.
        screen-intensified = 0.
        MODIFY SCREEN.

      ENDIF.
      " I0045 / I0046 → stays editable (no modify)

    ENDIF.
  ENDIF.

ENDLOOP.

ENDMODULE.
