  ELSE.
    APPEND 'WFLOG'   TO gt_excl.

    SET PF-STATUS 'STATUS_100' EXCLUDING gt_excl.
  ENDIF.

  LOOP AT SCREEN.

    "=========================================================
    " Default: Header fields are display-only
    "=========================================================
    IF screen-name = 'GS_HEADER-POST1'
    OR screen-name = 'GS_HEADER-BUKRS'
    OR screen-name = 'GS_HEADER-VERNR'
    OR screen-name = 'GV_PROJECT_CURRENCY'
    OR screen-name = 'GV_REQUESTOR_DISPLAY'
    OR screen-name = 'GS_HEADER-PLSEZ'
    OR screen-name = 'GS_HEADER-WERKS'
    OR screen-name = 'GS_HEADER-REQUEST_STATUS'
    OR screen-name = 'GV_IM_POSID_DISPLAY'
    OR screen-name = 'GS_HEADER-PRCTR'
    OR screen-name = 'GV_REQTYPE_DISPLAY'
    OR screen-name = 'GS_HEADER-PRNAM'
    OR screen-name = 'GS_HEADER-KOSTL'
    OR screen-name = 'GV_GJAHR'
    OR screen-name = 'GS_HEADER-IZWEK'
    OR screen-name = 'GV_AVAIL_BUDGET_TEXT'
    OR screen-name = 'GS_HEADER-USR008'
    OR screen-name = 'GS_HEADER-USR10'
    OR screen-name = 'GS_HEADER-ZUNIFIER_PROJ'.

      screen-input = 0.
      screen-intensified = 0.
      MODIFY SCREEN.

    ENDIF.

    "=========================================================
    " A1 editable fields only
    "=========================================================
    IF gv_disp_req = abap_false.
      IF gv_req_type = 'A1' OR gv_req_type = 'F1'.
        IF screen-name = 'GS_HEADER-POST1'
        OR screen-name = 'GS_HEADER-VERNR'
        OR screen-name = 'GS_HEADER-PLSEZ'
        OR screen-name = 'GS_HEADER-USR008'.

          screen-input = 1.
          screen-intensified = 0.
          MODIFY SCREEN.
        ENDIF.
      ENDIF.


      "=========================================================
      " B3 editable fields like B1 / FDS
      "=========================================================
      IF gv_req_type = 'B3'.
        IF screen-name = 'GS_HEADER-POST1'
        OR screen-name = 'GS_HEADER-VERNR'
        OR screen-name = 'GS_HEADER-PLSEZ'
        OR screen-name = 'GS_HEADER-WERKS'
        OR screen-name = 'GS_HEADER-USR10'.

          screen-input = 1.
          screen-intensified = 0.
          MODIFY SCREEN.
        ENDIF.
      ENDIF.

      IF gv_req_type = 'B2'.
        IF screen-name = 'GS_HEADER-POST1'
        OR screen-name = 'GS_HEADER-VERNR'
        OR screen-name = 'GS_HEADER-PLSEZ'.

          screen-input = 1.
          screen-intensified = 0.
          MODIFY SCREEN.
        ENDIF.
      ENDIF.

    ENDIF.

  ENDLOOP.

