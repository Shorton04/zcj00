  CLEAR gt_values.

  gs_value-key  = 'REL'.
  gs_value-text = 'REL'.
  APPEND gs_value TO gt_values.

  gs_value-key  = 'TECO'.
  gs_value-text = 'TECO'.
  APPEND gs_value TO gt_values.

