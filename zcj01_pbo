MODULE status_0100 OUTPUT.

  DATA gt_excl TYPE STANDARD TABLE OF sy-ucomm.

  IF gv_disp_req = abap_true.
    "Hide these toolbar buttons
    APPEND 'SUBMIT' TO gt_excl.
    APPEND 'ATTCH'   TO gt_excl.
    APPEND 'UPLD'   TO gt_excl.
*    APPEND 'DWNLD'  TO gt_excl.
