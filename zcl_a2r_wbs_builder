* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->GET_WBS_ITEMS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [<---] ET_WBSITEM                     TYPE        STANDARD TABLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_wbs_items.
    DATA: lv_pspnr_templ TYPE ps_pspnr,
          lt_prpss_all   TYPE TABLE OF prpss,
          lt_prpss_level TYPE TABLE OF prpss,
          ls_prpss       TYPE prpss,
          lt_pspnr_list  TYPE TABLE OF ps_pspnr,
          lv_level       TYPE i,
          lv_max_levels  TYPE i VALUE 10,
          ls_wbs_item    TYPE ztb_a2r_wbsitem.

    FIELD-SYMBOLS: <fs_prpss> TYPE prpss.

    " Get template pspnr
    SELECT SINGLE pspnr FROM projs
      INTO lv_pspnr_templ
      WHERE pspid = 'PC000001'."iv_pspid.

    IF sy-subrc <> 0.
      SELECT SINGLE pspnr FROM proj
        INTO lv_pspnr_templ
        WHERE pspid = 'PC000001'."iv_pspid.
    ENDIF.

    CHECK sy-subrc = 0.

    " Get all wbs elements recursively (same logic as tree)
    SELECT * FROM prpss
      INTO TABLE lt_prpss_all
      WHERE psphi = lv_pspnr_templ
      ORDER BY stufe posid.

    CHECK sy-subrc = 0.

    " Recursive fetch for children
    lv_level = 1.
    WHILE lv_level < lv_max_levels.

      CLEAR lt_pspnr_list.
      LOOP AT lt_prpss_all ASSIGNING <fs_prpss>.
        APPEND <fs_prpss>-pspnr TO lt_pspnr_list.
      ENDLOOP.

      IF lt_pspnr_list IS INITIAL.
        EXIT.
      ENDIF.

      CLEAR lt_prpss_level.
      SELECT * FROM prpss
        INTO TABLE lt_prpss_level
        FOR ALL ENTRIES IN lt_pspnr_list
        WHERE psphi = lt_pspnr_list-table_line.

      IF sy-subrc <> 0.
        EXIT.
      ENDIF.

      APPEND LINES OF lt_prpss_level TO lt_prpss_all.
      lv_level = lv_level + 1.

    ENDWHILE.

    SORT lt_prpss_all BY stufe posid.

    " Convert prpss to wbs items structure
    LOOP AT lt_prpss_all INTO ls_prpss.
      CLEAR ls_wbs_item.

      " ✓ FIXED: Use correct field mappings
      ls_wbs_item-stufe = ls_prpss-stufe.
      ls_wbs_item-posid = ls_prpss-posid.        " ← FIX: Use POSID not PSPNR!
      ls_wbs_item-post1 = ls_prpss-post1.
      ls_wbs_item-posnr = ls_prpss-pspnr.        " Internal number stored separately

      " ✓ FIXED: Inherit company code and plant from header
      ls_wbs_item-kostl = is_header-kostl.
      ls_wbs_item-bukrs = is_header-bukrs.              " ← FIX: Add company code
      ls_wbs_item-werks = is_header-werks.              " ← FIX: Add plant
      ls_wbs_item-bukrs = ls_prpss-pbukr.    " PBUKR = Company Code in WBS

      " Template properties
      ls_wbs_item-imprf = ls_prpss-imprf.
      ls_wbs_item-prart = ls_prpss-prart.

      " Initialize budget fields
      ls_wbs_item-wert2 = 0.                     " Budget - user will fill
      ls_wbs_item-zbudget_check = space.

      APPEND ls_wbs_item TO et_wbsitem.

    ENDLOOP.

  ENDMETHOD.


