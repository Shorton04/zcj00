      IMPORTING
        !iv_bukrs         TYPE bukrs
        !iv_profl         TYPE profidproj
        !iv_reqtype       TYPE ztb_a2r_reqtype-z_reqtype
      EXPORTING
        !ev_appr1         TYPE char8
        !ev_appr2         TYPE char8
        !ev_auto          TYPE char1
        !ev_error_handler TYPE char8
        !et_l1_approvers  TYPE hpa_t_bname
        !et_l2_approvers  TYPE hpa_t_bname
      RETURNING
        VALUE(rv_found)   TYPE abap_bool .

  PRIVATE SECTION.

    METHODS get_next_request_number
      RETURNING
        VALUE(rv_reqnum) TYPE char10 .
    " NO ZAUTO_APPROVAL parameter - uses blank approver logic
    METHODS trigger_workflow
      IMPORTING
        !is_header        TYPE ztb_a2r_wbshdr
        !iv_appr1         TYPE char8 OPTIONAL
        !iv_appr2         TYPE char8 OPTIONAL
        !it_l1_apprv      TYPE hpa_t_bname OPTIONAL
        !it_l2_apprv      TYPE hpa_t_bname OPTIONAL
      RETURNING
        VALUE(rv_success) TYPE abap_bool .
    METHODS create_wbs_elements
      IMPORTING
        !is_header        TYPE ztb_a2r_wbshdr
        !it_wbs_items     TYPE STANDARD TABLE
      EXPORTING
        !et_wbs_created   TYPE STANDARD TABLE
      RETURNING
        VALUE(rv_success) TYPE abap_bool .
    METHODS assign_plan_values
      IMPORTING
        !it_wbs_items     TYPE STANDARD TABLE
      RETURNING
        VALUE(rv_success) TYPE abap_bool .
    METHODS distribute_im_budget
      IMPORTING
        !is_header        TYPE ztb_a2r_wbshdr
        !it_wbs_items     TYPE STANDARD TABLE
      RETURNING
        VALUE(rv_success) TYPE abap_bool .
    METHODS create_settlement_rules
      IMPORTING
        !it_wbs_items     TYPE STANDARD TABLE
      RETURNING
        VALUE(rv_success) TYPE abap_bool .
    METHODS activate_statuses
      IMPORTING
        !it_wbs_items     TYPE STANDARD TABLE
      RETURNING
        VALUE(rv_success) TYPE abap_bool .
    METHODS get_next_project_number
      IMPORTING
        !iv_profl       TYPE profidproj
      RETURNING
        VALUE(rv_pspid) TYPE ps_pspid .
    METHODS get_user_email
      IMPORTING
        !iv_uname       TYPE xubname
      RETURNING
        VALUE(rv_email) TYPE ad_smtpadr .
ENDCLASS.



CLASS ZCL_A2R_WBS_BUILDER IMPLEMENTATION.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->ACTIVATE_STATUSES
* +-------------------------------------------------------------------------------------------------+
* | [--->] IT_WBS_ITEMS                   TYPE        STANDARD TABLE
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD activate_statuses.

    DATA: ls_wbs       TYPE ztb_a2r_wbsitem,
          lv_wbs_objnr TYPE j_objnr.

    rv_success = abap_false.

    LOOP AT it_wbs_items INTO ls_wbs.

      SELECT SINGLE objnr FROM prps
        INTO lv_wbs_objnr
        WHERE posid = ls_wbs-posid.

      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.

      " BUDG status
      IF ls_wbs-zbudget_check = 'X'.
        CALL FUNCTION 'STATUS_CHANGE_INTERN_VB'
          EXPORTING
            objnr               = lv_wbs_objnr
            user_stat           = 'BUDG'
            set_inact           = ''
          EXCEPTIONS
            object_not_found    = 1
            status_inconsistent = 2
            OTHERS              = 3.
      ENDIF.

      " AVAC status
      CALL FUNCTION 'STATUS_CHANGE_INTERN_VB'
        EXPORTING
          objnr               = lv_wbs_objnr
          user_stat           = 'AVAC'
          set_inact           = ''
        EXCEPTIONS
          object_not_found    = 1
          status_inconsistent = 2
          OTHERS              = 3.

      " AUC status (Level 1 only)
      IF ls_wbs-stufe = 1 AND ls_wbs-imprf IS NOT INITIAL.
        CALL FUNCTION 'STATUS_CHANGE_INTERN_VB'
          EXPORTING
            objnr               = lv_wbs_objnr
            user_stat           = 'AUC'
            set_inact           = ''
          EXCEPTIONS
            object_not_found    = 1
            status_inconsistent = 2
            OTHERS              = 3.
      ENDIF.

      " Release WBS
      CALL FUNCTION 'STATUS_CHANGE_EXTERN'
        EXPORTING
          objnr               = lv_wbs_objnr
          stsma               = 'PS000001'
          stone               = 'I0002'
          set_inact           = ''
        EXCEPTIONS
          object_not_found    = 1
          status_inconsistent = 2
          OTHERS              = 3.

    ENDLOOP.

    COMMIT WORK.
    rv_success = abap_true.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->ASSIGN_PLAN_VALUES
* +-------------------------------------------------------------------------------------------------+
* | [--->] IT_WBS_ITEMS                   TYPE        STANDARD TABLE
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD assign_plan_values.

    DATA: ls_wbs   TYPE ztb_a2r_wbsitem,
          lv_objnr TYPE j_objnr,
          ls_bpge  TYPE bpge.

    rv_success = abap_false.

    LOOP AT it_wbs_items INTO ls_wbs.

      " Skip WBS without budget
      IF ls_wbs-wert2 IS INITIAL.
        CONTINUE.
      ENDIF.

      " Get WBS object number
      SELECT SINGLE objnr FROM prps
        INTO lv_objnr
        WHERE posid = ls_wbs-posid.

      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.

      " Check if plan record exists
      " CORRECTED: No GJAHR field! Use VERSN = '0' and OBJNR only
      SELECT SINGLE * FROM bpge INTO ls_bpge
        WHERE objnr = lv_objnr
          AND versn = '0'
          AND wrttp = '01'.        " Plan value type

      IF sy-subrc = 0.
        " Update existing plan
        UPDATE bpge
          SET wtges = @ls_wbs-wert2,
              wlges = @ls_wbs-wert2
          WHERE objnr = @lv_objnr
            AND versn = '0'
            AND wrttp = '01'.
      ELSE.
        " Create new plan record
        CLEAR ls_bpge.
        ls_bpge-mandt = sy-mandt.
        ls_bpge-lednr = '0000'.           " Standard ledger
        ls_bpge-objnr = lv_objnr.
        ls_bpge-posit = '00000000'.       " No commitment item
        ls_bpge-wrttp = '01'.             " Plan values
        ls_bpge-versn = '0'.              " Version 0
        ls_bpge-twaer = ls_wbs-werks.     " Currency
        ls_bpge-wtges = ls_wbs-wert2.     " Total value
        ls_bpge-wlges = ls_wbs-wert2.     " Overall value

        INSERT bpge FROM ls_bpge.
      ENDIF.

      IF sy-subrc <> 0.
        rv_success = abap_false.
        RETURN.
      ENDIF.

    ENDLOOP.

    COMMIT WORK AND WAIT.
    rv_success = abap_true.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->CHECK_APPROVER_MATRIX
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BUKRS                       TYPE        BUKRS
* | [--->] IV_PROFL                       TYPE        PROFIDPROJ
* | [--->] IV_REQTYPE                     TYPE        ZTB_A2R_REQTYPE-Z_REQTYPE
* | [<---] EV_APPR1                       TYPE        CHAR8
* | [<---] EV_APPR2                       TYPE        CHAR8
* | [<---] EV_AUTO                        TYPE        CHAR1
* | [<---] EV_ERROR_HANDLER               TYPE        CHAR8
* | [<---] ET_L1_APPROVERS                TYPE        HPA_T_BNAME
* | [<---] ET_L2_APPROVERS                TYPE        HPA_T_BNAME
* | [<-()] RV_FOUND                       TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD check_approver_matrix.

  DATA: ls_config  TYPE ztb_a2r_conftab2,
        lt_hrp1001 TYPE TABLE OF hrp1001,
        ls_hrp1001 TYPE hrp1001,
        lv_uname   TYPE xubname.

  CLEAR: ev_appr1, ev_appr2, ev_auto, ev_error_handler,
         et_l1_approvers, et_l2_approvers.

  " Get approver configuration from ZTB_A2R_CONFTAB2
  SELECT SINGLE * FROM ztb_a2r_conftab2
    INTO ls_config
    WHERE bukrs = iv_bukrs          " Company Code
      AND profl = iv_profl          " Project Profile
      AND z_reqtype = iv_reqtype.   " Request Type

  IF sy-subrc <> 0.
    rv_found = abap_false.
    RETURN.
  ENDIF.

  " Store approver positions and error handler
  ev_appr1 = ls_config-zaproval_1.          " Level 1 approver position
  ev_appr2 = ls_config-zaproval_2.          " Level 2 approver position
  ev_error_handler = ls_config-zerror_handling.

  "  LEVEL 1 APPROVERS
  " Get users assigned to Level 1 approver position from HRP1001
  IF ev_appr1 IS NOT INITIAL.
    CLEAR lt_hrp1001.

    SELECT * FROM hrp1001
      INTO TABLE lt_hrp1001
      WHERE objid = ev_appr1        " Position ID (e.g., 30000)
        AND otype = 'S'             " Object type = Position
        AND plvar = '01'            " Plan version = Current
        AND rsign = 'A'             " Relationship sign = A
        AND relat = '008'           " Relationship = User assignment
        AND sclas = 'US'            " Object class = User
        AND endda >= sy-datum       " Valid to date >= today
        AND begda <= sy-datum.      " Valid from date <= today

    IF sy-subrc = 0.
      LOOP AT lt_hrp1001 INTO ls_hrp1001.
        "  FIX: Use VARYF field which contains 'US' + username
        " From image: VARYF = 'USKP05750' (Technical Field Name shown)
        lv_uname = ls_hrp1001-varyf.

        " Remove 'US' prefix (first 2 characters)
        IF lv_uname IS NOT INITIAL AND lv_uname(2) = 'US'.
          lv_uname = lv_uname+2.  " Extract username: 'USKP05750' → 'KP05750'
        ENDIF.

        " Only add if username is not empty
        IF lv_uname IS NOT INITIAL.
          APPEND lv_uname TO et_l1_approvers.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDIF.

  "  LEVEL 2 APPROVERS
  " Get users assigned to Level 2 approver position from HRP1001
  IF ev_appr2 IS NOT INITIAL.
    CLEAR lt_hrp1001.

    SELECT * FROM hrp1001
      INTO TABLE lt_hrp1001
      WHERE objid = ev_appr2        " Position ID (e.g., 30001)
        AND otype = 'S'
        AND plvar = '01'
        AND rsign = 'A'
        AND relat = '008'
        AND sclas = 'US'
        AND endda >= sy-datum
        AND begda <= sy-datum.

    IF sy-subrc = 0.
      LOOP AT lt_hrp1001 INTO ls_hrp1001.
        "  Use VARYF field
        lv_uname = ls_hrp1001-varyf.

        " Remove 'US' prefix
        IF lv_uname IS NOT INITIAL AND lv_uname(2) = 'US'.
          lv_uname = lv_uname+2.
        ENDIF.

        IF lv_uname IS NOT INITIAL.
          APPEND lv_uname TO et_l2_approvers.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDIF.

  "  AUTO-APPROVAL LOGIC
  " If BOTH approver lists are empty, mark as auto-approval
  IF et_l1_approvers IS INITIAL AND et_l2_approvers IS INITIAL.
    ev_auto = 'X'.
  ELSE.
    CLEAR ev_auto.
  ENDIF.

  rv_found = abap_true.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->COPY_TEMPLATE_STRUCTURE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_PSPID                       TYPE        PS_PSPID
* | [--->] IV_KOSTL                       TYPE        KOSTL
* | [<-->] CT_WBS_ITEMS                   TYPE        STANDARD TABLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD copy_template_structure.

    DATA: lt_prpss TYPE TABLE OF prpss,
          ls_prpss TYPE prpss,
          ls_wbs   TYPE ztb_a2r_wbsitem,
          lv_pspnr TYPE ps_pspnr.

    " CORRECTED: Get project internal number from template PSPID
    " Use PROJS table (screenshot 4 shows standard structure)
    SELECT SINGLE pspnr FROM projs
    INTO lv_pspnr
    WHERE pspid = iv_pspid.

    IF sy-subrc <> 0.
      " Fallback to PROJ
      SELECT SINGLE pspnr FROM proj
      INTO lv_pspnr
      WHERE pspid = iv_pspid.
    ENDIF.

    IF sy-subrc = 0.
      " Get all WBS elements using PRPSS (screenshot 5 confirms this)
      SELECT * FROM prpss
      INTO TABLE lt_prpss
      WHERE psphi = lv_pspnr
      ORDER BY stufe posid.


      IF sy-subrc = 0.
        LOOP AT lt_prpss INTO ls_prpss.
          CLEAR ls_wbs.

          ls_wbs-stufe = ls_prpss-stufe.
          ls_wbs-posid = ls_prpss-posid.
          ls_wbs-post1 = ls_prpss-post1.
          ls_wbs-posnr = ls_prpss-pspnr.    " PSPNR = internal WBS number
          ls_wbs-kostl = iv_kostl.          " Inherit from header
          ls_wbs-imprf = ls_prpss-imprf.
          ls_wbs-prart = ls_prpss-prart.
          ls_wbs-bukrs = ls_prpss-pbukr.
          ls_wbs-bukrs = ls_prpss-pbukr.    " PBUKR = Company Code in WBS

          APPEND ls_wbs TO ct_wbs_items.
        ENDLOOP.
      ENDIF.


    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->CREATE_PROJECT
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        STANDARD TABLE
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD create_project.

    DATA: lt_wbs_created TYPE STANDARD TABLE OF ztb_a2r_wbsitem.
    DATA(lv_dev) = xsdbool( sy-uname = 'HQ75176' ).

    rv_success = abap_false.

    IF lv_dev = abap_true.

      " Step 1: Create WBS elements
      IF create_wbs_elements(
        EXPORTING
          is_header      = is_header
          it_wbs_items   = it_wbs_items
        IMPORTING
          et_wbs_created = lt_wbs_created
      ) = abap_false.
        MESSAGE e025(zcj00).
        RETURN.
      ENDIF.

      " Step 2: Create settlement rules
      IF create_settlement_rules(
        it_wbs_items = lt_wbs_created
      ) = abap_false.
        MESSAGE e024(zcj00).
        RETURN.
      ENDIF.

      " Step 3: Assign plan values
      IF assign_plan_values(
        it_wbs_items = lt_wbs_created
      ) = abap_false.
        MESSAGE e026(zcj00).
        RETURN.
      ENDIF.

      " Step 4: Distribute IM budget
      IF distribute_im_budget(
        is_header    = is_header
        it_wbs_items = lt_wbs_created
      ) = abap_false.
        MESSAGE e027(zcj00).
        RETURN.
      ENDIF.

      " Step 5: Activate statuses
      IF activate_statuses(
        it_wbs_items = lt_wbs_created
      ) = abap_false.
        MESSAGE e028(zcj00).
        RETURN.
      ENDIF.

    ELSE.
      " Step 1: Create WBS elements
      IF create_wbs_elements(
        EXPORTING
          is_header      = is_header
          it_wbs_items   = it_wbs_items
        IMPORTING
          et_wbs_created = lt_wbs_created
      ) = abap_false.
        MESSAGE e025(zcj00).
        RETURN.
      ENDIF.

    ENDIF.

    rv_success = abap_true.
    COMMIT WORK.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->CREATE_SETTLEMENT_RULES
* +-------------------------------------------------------------------------------------------------+
* | [--->] IT_WBS_ITEMS                   TYPE        STANDARD TABLE
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD create_settlement_rules.

    DATA: ls_wbs          TYPE ztb_a2r_wbsitem,
          lv_parent_objnr TYPE j_objnr,
          lv_wbs_objnr    TYPE j_objnr,
          lv_bukrs        TYPE bukrs.

    rv_success = abap_false.

    LOOP AT it_wbs_items INTO ls_wbs.

      IF ls_wbs-stufe = 1.
        CONTINUE.
      ENDIF.

      IF ls_wbs-wert2 IS INITIAL.
        CONTINUE.
      ENDIF.

      SELECT SINGLE p~objnr, p~pbukr
        FROM prps AS p
        INTO (@lv_wbs_objnr, @lv_bukrs)
        WHERE p~posid = @ls_wbs-posid.

      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.

      SELECT SINGLE up FROM prhi
        INTO @lv_parent_objnr
        WHERE down = @lv_wbs_objnr.

      IF sy-subrc = 0 AND lv_parent_objnr IS NOT INITIAL.

        CALL FUNCTION 'K_SRULE_SAVE_UTASK'
          EXPORTING
            i_sender       = lv_wbs_objnr
            i_receiver     = lv_parent_objnr
            i_settl_type   = 'FUL'
            i_percentage   = '100.00'
            i_company_code = lv_bukrs
          EXCEPTIONS
            error_in_data  = 1
            OTHERS         = 2.

        IF sy-subrc = 0.
          CALL FUNCTION 'STATUS_CHANGE_INTERN'
            EXPORTING
              client              = sy-mandt
              objnr               = lv_wbs_objnr
              user_stat           = 'SETC'
              set_inact           = ''
            EXCEPTIONS
              object_not_found    = 1
              status_inconsistent = 2
              OTHERS              = 3.
        ELSE.
          MESSAGE e024(zcj00).
          rv_success = abap_false.
          RETURN.
        ENDIF.
      ENDIF.
    ENDLOOP.

    COMMIT WORK AND WAIT.
    rv_success = abap_true.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->CREATE_WBS_ELEMENTS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        STANDARD TABLE
* | [<---] ET_WBS_CREATED                 TYPE        STANDARD TABLE
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD create_wbs_elements.

    DATA: lv_pspid        TYPE ps_pspid,
          ls_wbs          TYPE ztb_a2r_wbsitem,
          ls_wbs_created  TYPE ztb_a2r_wbsitem,
          lt_return       TYPE TABLE OF bapiret2,
          ls_return       TYPE bapiret2,
          lv_level1_posid TYPE ps_posid,
          lv_level1_pspnr TYPE ps_pspnr,
          lv_counter      TYPE i.

    rv_success = abap_false.

    " Get next project number
    lv_pspid = get_next_project_number( is_header-profl ).

    IF lv_pspid IS INITIAL.
      MESSAGE e029(zcj00).
      RETURN.
    ENDIF.

    " Create Project Definition
    CALL FUNCTION 'BAPI_BUS2001_CREATE'
      EXPORTING
        i_project_definition = lv_pspid
        i_description        = is_header-post1        " Use POST1, not PSPNR
        i_start_date         = sy-datum
        i_end_date           = is_header-plsez
        i_company_code       = is_header-bukrs
        i_plant              = is_header-werks
        i_profit_center      = is_header-prctr
        i_responsible        = is_header-vernr
        i_currency           = 'USD'
        i_profile            = is_header-profl
      TABLES
        return               = lt_return.

    READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
    IF sy-subrc = 0.
      MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
        WITH ls_return-message_v1 ls_return-message_v2.
      rv_success = abap_false.
      RETURN.
    ENDIF.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = 'X'.

    " Get project internal number
    SELECT SINGLE pspnr FROM projs
      INTO lv_level1_pspnr
      WHERE pspid = lv_pspid.

    " Create WBS elements
    lv_counter = 1.
    LOOP AT it_wbs_items INTO ls_wbs.

      IF ls_wbs-wert2 IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR: lt_return, ls_wbs_created.

      IF ls_wbs-stufe = 1.
        lv_level1_posid = lv_pspid.
        ls_wbs_created-posid = lv_pspid.
        ls_wbs_created-posnr = lv_level1_pspnr.    " Use POSNR not PSPNR
      ELSE.
        ls_wbs_created-posid = |{ lv_pspid }-{ lv_counter }|.
        lv_counter = lv_counter + 1.

        CALL FUNCTION 'BAPI_BUS2054_CREATE_MULTI'
          EXPORTING
            i_project_definition = lv_pspid
            i_wbs_element        = ls_wbs_created-posid
            i_description        = ls_wbs-post1
            i_wbs_level          = ls_wbs-stufe
            i_cost_center        = ls_wbs-kostl
          TABLES
            return               = lt_return.

        READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
        IF sy-subrc = 0.
          MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
            WITH ls_return-message_v1 ls_return-message_v2.
          rv_success = abap_false.
          RETURN.
        ENDIF.

        SELECT SINGLE pspnr FROM prps
          INTO ls_wbs_created-posnr          " Use POSNR not PSPNR
          WHERE posid = ls_wbs_created-posid.
      ENDIF.

      ls_wbs_created-stufe = ls_wbs-stufe.
      ls_wbs_created-post1 = ls_wbs-post1.
      ls_wbs_created-kostl = ls_wbs-kostl.
      ls_wbs_created-wert2 = ls_wbs-wert2.
      ls_wbs_created-zbudget_check = ls_wbs-zbudget_check.
      ls_wbs_created-imprf = ls_wbs-imprf.
      ls_wbs_created-prart = ls_wbs-prart.
      ls_wbs_created-bukrs = is_header-bukrs.

      APPEND ls_wbs_created TO et_wbs_created.
    ENDLOOP.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = 'X'.

    " Link to IM Position
    CALL FUNCTION 'IM_ASSIGN_WBS_TO_POSITION'
      EXPORTING
        i_posnr = is_header-posnr
        i_posid = lv_level1_posid
      EXCEPTIONS
        OTHERS  = 1.

    rv_success = abap_true.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->DISTRIBUTE_IM_BUDGET
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        STANDARD TABLE
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD distribute_im_budget.

    DATA: lv_im_objnr      TYPE j_objnr,
          lv_wbs_objnr     TYPE j_objnr,
          ls_wbs_level1    TYPE ztb_a2r_wbsitem,
          lv_budget_amount TYPE bpge-wlges.

    rv_success = abap_false.

    " Get Level 1 WBS - CORRECTED: Loop and check instead of WITH KEY
    LOOP AT it_wbs_items INTO ls_wbs_level1.
      IF ls_wbs_level1-stufe = 1.
        EXIT.
      ENDIF.
    ENDLOOP.

    IF ls_wbs_level1 IS INITIAL.
      RETURN.
    ENDIF.

    " Get IM object number
    SELECT SINGLE objnr FROM impr
      INTO lv_im_objnr
      WHERE posnr = is_header-posnr.

    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    " Get WBS object number
    SELECT SINGLE objnr FROM prps
      INTO lv_wbs_objnr
      WHERE posid = ls_wbs_level1-posid.

    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    lv_budget_amount = ls_wbs_level1-wert2.

    " Check WBS assignment
    CALL FUNCTION 'IM_CHECK_WBS_ASSIGNMENT'
      EXPORTING
        i_posnr      = is_header-posnr
        i_posid      = ls_wbs_level1-posid
      EXCEPTIONS
        not_assigned = 1
        OTHERS       = 2.

    IF sy-subrc <> 0.
      MESSAGE e030(zcj00). " WBS not assigned to IM
      RETURN.
    ENDIF.

    " Check budget availability
    CALL FUNCTION 'IM_AVAILABILITY_CHECK'
      EXPORTING
        i_objnr         = lv_im_objnr
        i_amount        = lv_budget_amount
      EXCEPTIONS
        budget_exceeded = 1
        OTHERS          = 2.

    IF sy-subrc <> 0.
      MESSAGE e022(zcj00). " Budget exceeds available
      RETURN.
    ENDIF.

    " Distribute budget from IM to WBS
    UPDATE bpge
      SET wtgev = wtgev + lv_budget_amount
      WHERE objnr = lv_im_objnr.

    IF sy-subrc = 0.
      COMMIT WORK.
      rv_success = abap_true.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->GET_NEXT_PROJECT_NUMBER
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_PROFL                       TYPE        PROFIDPROJ
* | [<-()] RV_PSPID                       TYPE        PS_PSPID
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_next_project_number.

    DATA: lv_year TYPE gjahr.

    lv_year = sy-datum(4).

    CALL FUNCTION 'NUMBER_RANGE_ENQUEUE'
      EXPORTING
        object           = 'PS_PRO'
      EXCEPTIONS
        foreign_lock     = 1
        object_not_found = 2
        system_failure   = 3
        OTHERS           = 4.

    IF sy-subrc = 0.
      CALL FUNCTION 'NUMBER_GET_NEXT'
        EXPORTING
          nr_range_nr             = '01'
          object                  = 'PS_PRO'
          quantity                = 1
          toyear                  = lv_year
        IMPORTING
          number                  = rv_pspid
        EXCEPTIONS
          interval_not_found      = 1
          number_range_not_intern = 2
          object_not_found        = 3
          OTHERS                  = 4.

      CALL FUNCTION 'NUMBER_RANGE_DEQUEUE'
        EXPORTING
          object = 'PS_PRO'.
    ENDIF.

    IF rv_pspid IS INITIAL.
      rv_pspid = |P{ lv_year }{ sy-uzeit }|.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->GET_NEXT_REQUEST_NUMBER
* +-------------------------------------------------------------------------------------------------+
* | [<-()] RV_REQNUM                      TYPE        CHAR10
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_next_request_number.

    DATA: lv_request TYPE char10.

    CLEAR rv_reqnum.

    " Get next request number from number range
    CALL FUNCTION 'NUMBER_GET_NEXT'
      EXPORTING
        nr_range_nr             = '01'
        object                  = 'ZCJ00_REQN'    " Use FDS object name
        quantity                = '1'
        toyear                  = '0000'          " Important: same as old system
      IMPORTING
        number                  = lv_request
      EXCEPTIONS
        interval_not_found      = 1
        number_range_not_intern = 2
        object_not_found        = 3
        quantity_is_0           = 4
        quantity_is_not_1       = 5
        interval_overflow       = 6
        buffer_overflow         = 7
        OTHERS                  = 8.

    IF sy-subrc = 0.
      rv_reqnum = lv_request.
    ELSE.
      " Enhanced error handling
      CASE sy-subrc.
        WHEN 1.
          MESSAGE 'Number range interval not found' TYPE 'I' DISPLAY LIKE 'E'.
        WHEN 2.
          MESSAGE 'Number range is not internal' TYPE 'I' DISPLAY LIKE 'E'.
        WHEN 3.
          MESSAGE 'Number range object ZCJ00_REQN not found. Create in SNRO' TYPE 'I' DISPLAY LIKE 'E'.
        WHEN OTHERS.
          MESSAGE 'Error getting request number' TYPE 'I' DISPLAY LIKE 'E'.
      ENDCASE.
      CLEAR rv_reqnum.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->GET_USER_EMAIL
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_UNAME                       TYPE        XUBNAME
* | [<-()] RV_EMAIL                       TYPE        AD_SMTPADR
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_user_email.

    DATA: lv_persnumber TYPE ad_persnum.

    CLEAR rv_email.

    " Get person number from username (HRP1001-SOBID = USR21-BNAME)
    SELECT SINGLE persnumber
      FROM usr21
      INTO @lv_persnumber
      WHERE bname = @iv_uname.

    IF sy-subrc = 0 AND lv_persnumber IS NOT INITIAL.

      " Get email from ADR6 (USR21-PERSNUMBER = ADR6-PERSNUMBER)
      SELECT SINGLE smtp_addr
        FROM adr6
        INTO @rv_email
        WHERE persnumber = @lv_persnumber
          AND flgdefault = 'X'.      " Default email

      " If no default email found, get any email
      IF sy-subrc <> 0.
        SELECT SINGLE smtp_addr
          FROM adr6
          INTO @rv_email
          WHERE persnumber = @lv_persnumber.
      ENDIF.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->SAVE_REQUEST
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        STANDARD TABLE
* | [<-()] RV_REQNUM                      TYPE        CHAR10
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD save_request.

    DATA: ls_header TYPE ztb_a2r_wbshdr,
          ls_item   TYPE ztb_a2r_wbsitem,
          ls_wbs    TYPE ztb_a2r_wbsitem,
          lv_error  TYPE abap_bool.

    CLEAR: rv_reqnum, lv_error.

    " Get request number ONLY if not already assigned
    IF is_header-zreq_num IS INITIAL.
      rv_reqnum = get_next_request_number( ).

      IF rv_reqnum IS INITIAL.
        " Error message already displayed by get_next_request_number
        RETURN.
      ENDIF.
    ELSE.
      " Re-saving existing request (update scenario)
      rv_reqnum = is_header-zreq_num.
    ENDIF.

    " Prepare header with correct field mapping
    CLEAR ls_header.
    ls_header-mandt = sy-mandt.
    ls_header-zreq_num = rv_reqnum.

    " FDS Table 4.1.7 field mapping
    ls_header-posnr = is_header-posnr.              " IM Program Position
    ls_header-prnam = is_header-prnam.              " IM Program
    ls_header-pspnr = is_header-pspnr.              " Project ID (populated after creation)
    ls_header-post1 = is_header-post1.              " Description
    ls_header-vernr = is_header-vernr.              " Person Responsible
    ls_header-plsez = is_header-plsez.              " Finish Date
    ls_header-bukrs = is_header-bukrs.              " Company Code
    ls_header-werks = is_header-werks.              " Plant
    ls_header-prctr = is_header-prctr.              " Profit Center
    ls_header-kostl = is_header-kostl.              " Cost Center
    ls_header-izwek = is_header-izwek.              " Investment Reason
    ls_header-zunifier_proj = is_header-zunifier_proj.  " GE Ariba Flag
    ls_header-usr008 = is_header-usr008.            " CAR Approval Date
    ls_header-profl = is_header-profl.              " Project Profile
    ls_header-z_reqtype = is_header-z_reqtype.      " Request Type

    " Status and audit fields (similar to old system pattern)
    IF is_header-zreq_num IS INITIAL.
      " New request
      ls_header-ernam = sy-uname.                   " Created by
      ls_header-erdat = sy-datum.                   " Created on
      ls_header-request_status = 'DRAFT'.           " Draft status
    ELSE.
      " Existing request being updated
      ls_header-ernam = is_header-ernam.            " Keep original creator
      ls_header-erdat = is_header-erdat.            " Keep original date
      " Add change tracking if fields exist:
      " ls_header-changed_by = sy-uname.
      " ls_header-changed_on = sy-datum.
    ENDIF.

    " Optional fields
    IF is_header-z_remarks IS NOT INITIAL.
      ls_header-z_remarks = is_header-z_remarks.
    ENDIF.

    " Validate mandatory fields
    IF ls_header-posnr IS INITIAL.
      MESSAGE 'IM Program Position is mandatory' TYPE 'E'.
      CLEAR rv_reqnum.
      RETURN.
    ENDIF.

*  IF ls_header-bukrs IS INITIAL.
*    MESSAGE 'Company Code is mandatory' TYPE 'E'.
*    CLEAR rv_reqnum.
*    RETURN.
*  ENDIF.
*
*  IF ls_header-profl IS INITIAL.
*    MESSAGE 'Project Profile is mandatory' TYPE 'E'.
*    CLEAR rv_reqnum.
*    RETURN.
*  ENDIF.
*
*  IF ls_header-post1 IS INITIAL.
*    MESSAGE 'Project Description is mandatory' TYPE 'E'.
*    CLEAR rv_reqnum.
*    RETURN.
*  ENDIF.

    " Save with error handling
    TRY.
        " Check if updating or creating new
        IF is_header-zreq_num IS INITIAL.
          " Insert new header
          INSERT ztb_a2r_wbshdr FROM ls_header.
        ELSE.
          " Update existing header
          UPDATE ztb_a2r_wbshdr FROM ls_header.
          IF sy-subrc <> 0.
            " If update failed, try insert (might be new after all)
            INSERT ztb_a2r_wbshdr FROM ls_header.
          ENDIF.
        ENDIF.

        IF sy-subrc = 0.
          " Delete old items if updating
          IF is_header-zreq_num IS NOT INITIAL.
            DELETE FROM ztb_a2r_wbsitem WHERE zreq_num = rv_reqnum.
          ENDIF.

          " Insert/update WBS items
          LOOP AT it_wbs_items INTO ls_wbs.
            CLEAR ls_item.

            " FDS Table 4.1.8 field mapping
            ls_item-mandt = sy-mandt.
            ls_item-zreq_num = rv_reqnum.           " Request Number (Primary Key)
            ls_item-bukrs = ls_header-bukrs.        " Company Code (Primary Key)
            ls_item-posid = ls_wbs-posid.           " WBS Element Code (Primary Key)
            ls_item-stufe = ls_wbs-stufe.           " WBS Level
            ls_item-post1 = ls_wbs-post1.           " Description
            ls_item-kostl = ls_wbs-kostl.           " Cost Center
            ls_item-wert2 = ls_wbs-wert2.           " Approved Budget
            ls_item-zbudget_check = ls_wbs-zbudget_check.  " Budget Check
            ls_item-imprf = ls_wbs-imprf.           " Investment Profile
            ls_item-prart = ls_wbs-prart.           " Project Type

            IF ls_wbs-posnr IS NOT INITIAL.
              ls_item-posnr = ls_wbs-posnr.         " WBS Internal Number
            ENDIF.

            INSERT ztb_a2r_wbsitem FROM ls_item.

            IF sy-subrc <> 0.
              lv_error = abap_true.
              MESSAGE 'Error saving WBS item' && ls_item-posid TYPE 'I' DISPLAY LIKE 'E'.
              EXIT.
            ENDIF.
          ENDLOOP.

          " Commit or rollback
          IF lv_error = abap_false.
            COMMIT WORK AND WAIT.
            MESSAGE s024(zcj00) WITH rv_reqnum DISPLAY LIKE 'S'.
            CALL TRANSACTION 'ZA2R_ZCJ00'.
          ELSE.
            ROLLBACK WORK.
            CLEAR rv_reqnum.
          ENDIF.

        ELSE.
          MESSAGE 'Error saving header. Check table structure.' TYPE 'E'.
          CLEAR rv_reqnum.
          ROLLBACK WORK.
        ENDIF.

      CATCH cx_sy_sql_error INTO DATA(lx_sql).
        MESSAGE lx_sql->get_text( ) TYPE 'E'.
        CLEAR rv_reqnum.
        ROLLBACK WORK.

      CATCH cx_root INTO DATA(lx_error).
        MESSAGE lx_error->get_text( ) TYPE 'E'.
        CLEAR rv_reqnum.
        ROLLBACK WORK.
    ENDTRY.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->SUBMIT_REQUEST
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        STANDARD TABLE
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD submit_request.

  DATA: lv_reqnum        TYPE char10,
        lv_appr1         TYPE char8,
        lv_appr2         TYPE char8,
        lv_auto          TYPE char1,
        lv_error_handler TYPE char8,
        lv_found         TYPE abap_bool,
        ls_header        TYPE ztb_a2r_wbshdr,
        lt_l1_approvers  TYPE hpa_t_bname,    "  Will hold L1 usernames
        lt_l2_approvers  TYPE hpa_t_bname.    "  Will hold L2 usernames

  rv_success = abap_false.

  "  Step 1: Save the request (get request number)
  lv_reqnum = save_request(
    is_header    = is_header
    it_wbs_items = it_wbs_items
  ).

  IF lv_reqnum IS INITIAL.
    MESSAGE e013(zcj00) WITH 'Error saving request'.
    RETURN.
  ENDIF.

  "  Step 2: Get approvers from config + HRP1001
  lv_found = check_approver_matrix(
    EXPORTING
      iv_bukrs   = is_header-bukrs      " ZX99
      iv_profl   = is_header-profl      " ZPC0001
      iv_reqtype = is_header-z_reqtype  " A1
    IMPORTING
      ev_appr1         = lv_appr1             " Position 30000
      ev_appr2         = lv_appr2             " Position 30001
      ev_auto          = lv_auto              " 'X' if no approvers
      ev_error_handler = lv_error_handler
      et_l1_approvers  = lt_l1_approvers      "  Usernames from HRP1001
      et_l2_approvers  = lt_l2_approvers      "  Usernames from HRP1001
  ).

  IF lv_found = abap_false.
    MESSAGE e008(zcj00) WITH 'No approver configuration found'.
    RETURN.
  ENDIF.

  "  Step 3: Update header with pending status
  ls_header = is_header.
  ls_header-zreq_num = lv_reqnum.
  ls_header-request_status = 'PENDING'.

  UPDATE ztb_a2r_wbshdr
    SET request_status = 'PENDING'
    WHERE zreq_num = lv_reqnum.

  "  Step 4: Auto-approval or Workflow
  IF lv_auto = 'X'.
    "  AUTO-APPROVE: No approvers configured
    MESSAGE i035(zcj00) WITH 'Request' lv_reqnum 'auto-approved'.

    rv_success = create_project(
      is_header    = ls_header
      it_wbs_items = it_wbs_items
    ).

    IF rv_success = abap_true.
      UPDATE ztb_a2r_wbshdr
        SET request_status = 'APPROVED'
            zapproved_by = sy-uname
            zrequest_approved_on = sy-datum
        WHERE zreq_num = lv_reqnum.
      COMMIT WORK.
      MESSAGE s033(zcj00) WITH 'Request' lv_reqnum 'approved'.
    ELSE.
      UPDATE ztb_a2r_wbshdr
        SET request_status = 'ERROR'
        WHERE zreq_num = lv_reqnum.
      COMMIT WORK.
      MESSAGE e034(zcj00) WITH 'Error for request' lv_reqnum.
    ENDIF.

  ELSE.
    "  TRIGGER WORKFLOW WITH APPROVER LISTS
    rv_success = trigger_workflow(
      is_header   = ls_header
      it_l1_apprv = lt_l1_approvers    "  Pass L1 usernames
      it_l2_apprv = lt_l2_approvers    "  Pass L2 usernames
    ).

    IF rv_success = abap_true.
      COMMIT WORK.
      MESSAGE s015(zcj00) WITH lv_reqnum.
    ELSE.
      ROLLBACK WORK.
      MESSAGE e020(zcj00) WITH 'Workflow error for' lv_reqnum.
    ENDIF.
  ENDIF.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->TOTAL_UP_BUDGET
* +-------------------------------------------------------------------------------------------------+
* | [<-->] CT_WBS_ITEMS                   TYPE        STANDARD TABLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD total_up_budget.

    DATA: lt_wbs        TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
          ls_wbs        TYPE ztb_a2r_wbsitem,
          ls_wbs_parent TYPE ztb_a2r_wbsitem,
          lv_total      TYPE bpge-wlges,
          lv_max_level  TYPE ps_stufe,
          lv_tabix      TYPE sy-tabix.

    lt_wbs = ct_wbs_items.

    " Get maximum level
    LOOP AT lt_wbs INTO ls_wbs.
      IF ls_wbs-stufe > lv_max_level.
        lv_max_level = ls_wbs-stufe.
      ENDIF.
    ENDLOOP.

    " Process from bottom up (highest level to lowest)
    DO lv_max_level TIMES.
      DATA(lv_current_level) = lv_max_level - sy-index + 1.

      IF lv_current_level <= 1.
        EXIT.
      ENDIF.

      " For each WBS at current level
      LOOP AT lt_wbs INTO ls_wbs WHERE stufe = lv_current_level.

        " Find parent (one level up)
        READ TABLE lt_wbs INTO ls_wbs_parent
          WITH KEY stufe = lv_current_level - 1.

        IF sy-subrc = 0.
          lv_tabix = sy-tabix.
          ls_wbs_parent-wert2 = ls_wbs_parent-wert2 + ls_wbs-wert2.
          MODIFY lt_wbs FROM ls_wbs_parent INDEX lv_tabix.
        ENDIF.
      ENDLOOP.
    ENDDO.

    ct_wbs_items = lt_wbs.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->TRIGGER_WORKFLOW
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IV_APPR1                       TYPE        CHAR8(optional)
* | [--->] IV_APPR2                       TYPE        CHAR8(optional)
* | [--->] IT_L1_APPRV                    TYPE        HPA_T_BNAME(optional)
* | [--->] IT_L2_APPRV                    TYPE        HPA_T_BNAME(optional)
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD trigger_workflow.

    DATA: lo_instance TYPE REF TO zcl_a2r_wbs_request_flexwf.

    rv_success = abap_false.

    IF is_header-zreq_num IS INITIAL.
      RETURN.
    ENDIF.

*    " Placeholder for workflow
*    rv_success = abap_true.
    TRY.
        " trigger wf to create project
        lo_instance = NEW zcl_a2r_wbs_request_flexwf(
          iv_reqnum     = is_header-zreq_num
          is_header     = is_header
          it_l1approver = it_l1_apprv
          it_l2approver = it_l2_apprv
        ).

        lo_instance->submit( ).

        rv_success = abap_true.

      CATCH cx_root.
        rv_success = abap_false.
    ENDTRY.

  ENDMETHOD.
ENDCLASS.
