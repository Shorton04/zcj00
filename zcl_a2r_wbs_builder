    IF it_wbs_car IS INITIAL.
      RETURN.
    ENDIF.

    "------------------------------------------------------------
    " STEP 1: Get existing ESR project/WBS level 1
    "------------------------------------------------------------
    READ TABLE it_wbs_items INTO DATA(ls_esr_root) WITH KEY stufe = 1.
    IF sy-subrc <> 0.
      MESSAGE e029(zcj00) WITH 'Existing ESR level 1 not found'.
      RETURN.
    ENDIF.

    REPLACE ALL OCCURRENCES OF '.' IN ls_esr_root-posid WITH ''.

    lv_esr_pspid = ls_esr_root-posid.

    "------------------------------------------------------------
    " STEP 2: Initialize BAPI
    "------------------------------------------------------------
    CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

    "------------------------------------------------------------
    " STEP 3: Sort full structure in hierarchy order
    " it_wbs_items = ESR existing + CAR appended
    "------------------------------------------------------------
    lt_wbs_sorted = it_wbs_items.

    CLEAR: lt_wbs_celement,lt_phris_hier_used.
    IF is_header-ernam = 'HQ75177'.
      LOOP AT it_wbs_car INTO ls_car_filter

        WHERE wert2 IS NOT INITIAL
        AND wert2 <> 0.

        READ TABLE it_phris_hier ASSIGNING <fs_phris>
        WITH KEY target_posid = ls_car_filter-posid.
        IF sy-subrc = 0.
          APPEND <fs_phris> TO lt_phris_hier_used.
        ENDIF.

      ENDLOOP.
    ENDIF.

    LOOP AT it_wbs_car INTO ls_wbs.

      IF ls_wbs-wert2 = 0 OR ls_wbs-wert2 IS INITIAL.
        CONTINUE.
      ENDIF.

      REPLACE ALL OCCURRENCES OF '.' IN ls_wbs-posid WITH ''.

      CLEAR: ls_wbs_celement, lv_upper_level, lv_parent_posid.

      "Find current row position in full structure
      READ TABLE lt_wbs_sorted TRANSPORTING NO FIELDS
        WITH KEY posid = ls_wbs-posid.

      lv_index = sy-tabix.

      "----------------------------------------------------------
      " WBS ELEMENT
      " already prepared in gt_wbs_car like PC000533022
      "----------------------------------------------------------
      ls_wbs_celement-wbs_element = ls_wbs-posid.

      "----------------------------------------------------------
      " BASIC FIELDS
      "----------------------------------------------------------
      ls_wbs_celement-description      = ls_wbs-post1.
      ls_wbs_celement-company_code     = is_header-bukrs.
      ls_wbs_celement-profit_ctr       = is_header-prctr.
      ls_wbs_celement-controlling_area = is_header-vkokr.
      ls_wbs_celement-plant            = is_header-werks.

      ls_wbs_celement-wbs_planning_element = abap_true.
      ls_wbs_celement-inv_reason           = is_header-izwek.
      ls_wbs_celement-respsbl_cctr         = ls_wbs-kostl.
      ls_wbs_celement-proj_type            = ls_wbs-prart.
      ls_wbs_celement-responsible_no       = is_header-vernr.

      ls_wbs_celement-wbs_basic_start_date     = is_header-plfaz.
      ls_wbs_celement-wbs_basic_finish_date    = is_header-plsez.
      ls_wbs_celement-wbs_forecast_start_date  = is_header-plfaz.
      ls_wbs_celement-wbs_forecast_finish_date = is_header-plsez.

      ls_wbs_celement-wbs_account_assignment_element = abap_true.


      IF is_header-ernam = 'HQ75177'.
        READ TABLE lt_phris_hier_used INTO DATA(ls_phris_hier_t)
            WITH KEY target_posid = ls_wbs-posid.
        IF sy-subrc <> 0.
          MESSAGE e029(zcj00) WITH 'PRHIS hierarchy mapping not found'.
          RETURN.
        ENDIF.

        DATA(lv_up_int_t) = ls_phris_hier_t-wbs_up.
        IF lv_up_int_t IS NOT INITIAL.
          CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
            EXPORTING
              input  = lv_up_int_t
            IMPORTING
              output = lv_up_int_t.
        ENDIF.

        DATA(lv_left_int_t) = ls_phris_hier_t-wbs_left.
        IF lv_left_int_t IS NOT INITIAL.
          CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
            EXPORTING
              input  = lv_left_int_t
            IMPORTING
              output = lv_left_int_t.
        ENDIF.

        ls_wbs_celement-wbs_up   = lv_up_int_t.
        ls_wbs_celement-wbs_left = lv_left_int_t.

      ELSE.
        READ TABLE it_phris_hier INTO DATA(ls_phris_hier)
        WITH KEY target_posid = ls_wbs-posid.
        IF sy-subrc <> 0.
          MESSAGE e029(zcj00) WITH 'PRHIS hierarchy mapping not found'.
          RETURN.
        ENDIF.

        DATA(lv_up_int) = ls_phris_hier-wbs_up.
        IF lv_up_int IS NOT INITIAL.
          CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
            EXPORTING
              input  = lv_up_int
            IMPORTING
              output = lv_up_int.
        ENDIF.

        DATA(lv_left_int) = ls_phris_hier-wbs_left.
        IF lv_left_int IS NOT INITIAL.
          CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
            EXPORTING
              input  = lv_left_int
            IMPORTING
              output = lv_left_int.
        ENDIF.

        ls_wbs_celement-wbs_up   = lv_up_int.
        ls_wbs_celement-wbs_left = lv_left_int.
      ENDIF.

      APPEND ls_wbs_celement TO lt_wbs_celement.

    ENDLOOP.

    "------------------------------------------------------------
    " STEP 4: Create CAR WBS only
    " Existing ESR project already exists
    "------------------------------------------------------------
    IF lt_wbs_celement IS NOT INITIAL.

      CLEAR lt_return.

      CALL FUNCTION 'BAPI_BUS2054_CREATE_MULTI'
        EXPORTING
          i_project_definition = lv_esr_pspid
        TABLES
          it_wbs_element       = lt_wbs_celement
          et_return            = lt_return.

      LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'EA'.
        lv_error = 'X'.
        EXIT.
      ENDLOOP.

      IF lv_error = 'X'.
        MESSAGE e029(zcj00) WITH 'B1 CAR WBS creation failed'.
        RETURN.
      ENDIF.

    ENDIF.

    "------------------------------------------------------------
    " STEP 5: PRECOMMIT
    "------------------------------------------------------------
    CLEAR lt_return.

    CALL FUNCTION 'BAPI_PS_PRECOMMIT'
      TABLES
        et_return = lt_return.

    LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'EA'.
      lv_error = 'X'.
      EXIT.
    ENDLOOP.

    IF lv_error = 'X'.
      MESSAGE e029(zcj00) WITH 'B1 WBS precommit failed'.
      RETURN.
    ENDIF.

    "------------------------------------------------------------
    " STEP 6: COMMIT
    "------------------------------------------------------------
    CLEAR ls_return.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait   = 'X'
      IMPORTING
        return = ls_return.

    IF ls_return-type CA 'EA'.
      MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
        WITH ls_return-message_v1 ls_return-message_v2.
      RETURN.
    ENDIF.

    WAIT UP TO 1 SECONDS.

    "------------------------------------------------------------
    " STEP 7: Update created CAR internal numbers
    "------------------------------------------------------------
    LOOP AT it_wbs_car INTO ls_wbs.

      CLEAR ls_wbs_created.
      ls_wbs_created = ls_wbs.

      SELECT SINGLE pspnr
        INTO @ls_wbs_created-posnr
        FROM prps
        WHERE posid = @ls_wbs-posid.

      UPDATE ztb_a2r_wbsitem
        SET posnr = @ls_wbs_created-posnr,
            posid = @ls_wbs_created-posid
        WHERE zreq_num = @is_header-zreq_num
          AND posid    = @ls_wbs-posid.

      APPEND ls_wbs_created TO lt_wbs_created.

    ENDLOOP.

    lv_vkokr_setc = is_header-vkokr.
    lv_pspid_setc = is_header-pspid.

    settlement_rule( iv_vkokr = lv_vkokr_setc
                     iv_pspid = lv_pspid_setc
                    ).

    lv_blkd_ok = set_blkd_status_for_higher_wbs(
                 it_wbs_items = it_wbs_car
                 ).


* Assign plan values -> CJ40
    DATA(lv_check) = assign_plan_values(
      is_header    = is_header
      it_wbs_items = it_wbs_items
    ).

* Assign budget -> CJ30
    lv_check = assign_budget_cj30(
      is_header    = is_header
      it_wbs_items = it_wbs_items
    ).

    rv_success = abap_true.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->BUILD_PHRIS_HIERARCHY
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_PSPID_CAR                   TYPE        PS_PSPID
* | [--->] IV_ESR_ROOT                    TYPE        PS_POSID
* | [--->] IT_WBS_CAR                     TYPE        ZTT_A2R_WBSITEM
* | [<---] ET_PHRIS_HIER                  TYPE        ZTT_A2R_WBSHIER
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD build_phris_hierarchy.

    TYPES: BEGIN OF ty_prhis_raw,
             posnr TYPE ps_pspnr,
             psphi TYPE ps_pspnr,
             up    TYPE ps_pspnr,
             down  TYPE ps_pspnr,
             left  TYPE ps_pspnr,
             right TYPE ps_pspnr,
           END OF ty_prhis_raw.

    TYPES: BEGIN OF ty_prpss_raw,
             pspnr TYPE ps_pspnr,
             posid TYPE ps_posid,
             stufe TYPE ps_stufe,
           END OF ty_prpss_raw.

    DATA: lv_psphi         TYPE ps_pspnr,
          lv_template_root TYPE ps_posid,
          lv_target_posid  TYPE ps_posid,
          lv_target_up     TYPE ps_posid,
          lv_target_left   TYPE ps_posid,
          lv_pspid_car_int TYPE ztb_a2r_wbshdr-pspid.

    DATA: lt_prhis TYPE STANDARD TABLE OF ty_prhis_raw,
          ls_prhis TYPE ty_prhis_raw,
          lt_prpss TYPE STANDARD TABLE OF ty_prpss_raw,
          ls_prpss TYPE ty_prpss_raw.

    DATA: lt_prpss_h TYPE HASHED TABLE OF ty_prpss_raw WITH UNIQUE KEY pspnr,
          ls_phris   TYPE zsa2r_wbshier.

    FIELD-SYMBOLS: <fs_prpss> TYPE ty_prpss_raw.

    CLEAR et_phris_hier.

    IF iv_pspid_car IS INITIAL OR iv_esr_root IS INITIAL OR it_wbs_car IS INITIAL.
      RETURN.
    ENDIF.

*--------------------------------------------------------------------*
* 1. Get template project internal number
*--------------------------------------------------------------------*
    SELECT SINGLE pspnr
      INTO @lv_psphi
      FROM projs
      WHERE pspid = @iv_pspid_car.

    IF sy-subrc <> 0 OR lv_psphi IS INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
        EXPORTING
          input  = iv_pspid_car
        IMPORTING
          output = lv_pspid_car_int.

      SELECT SINGLE pspnr
        INTO @lv_psphi
        FROM projs
        WHERE pspid = @lv_pspid_car_int.
    ENDIF.

    IF sy-subrc <> 0 OR lv_psphi IS INITIAL.
      RETURN.
    ENDIF.

*--------------------------------------------------------------------*
* 2. Read PRHIS edges for this standard template
*--------------------------------------------------------------------*
    SELECT posnr,
           psphi,
           up,
           down,
           left,
           right
      FROM prhis
      INTO TABLE @lt_prhis
      WHERE psphi = @lv_psphi.

    IF lt_prhis IS INITIAL.
      RETURN.
    ENDIF.

*--------------------------------------------------------------------*
* 3. Read PRPSS nodes using PRHIS-POSNR / UP / LEFT references
*--------------------------------------------------------------------*
    SELECT pspnr,
           posid,
           stufe
      FROM prpss
      INTO TABLE @lt_prpss
      FOR ALL ENTRIES IN @lt_prhis
      WHERE pspnr = @lt_prhis-posnr
         OR pspnr = @lt_prhis-up
         OR pspnr = @lt_prhis-left
         OR pspnr = @lt_prhis-down
         OR pspnr = @lt_prhis-right.

    IF lt_prpss IS INITIAL.
      RETURN.
    ENDIF.

    lt_prpss_h = lt_prpss.

*--------------------------------------------------------------------*
* 4. Find template root POSID (node with UP initial)
*--------------------------------------------------------------------*
    CLEAR lv_template_root.

    LOOP AT lt_prhis INTO ls_prhis.
      IF ls_prhis-up IS INITIAL.
        READ TABLE lt_prpss_h ASSIGNING <fs_prpss>
          WITH KEY pspnr = ls_prhis-posnr.
        IF sy-subrc = 0.
          lv_template_root = <fs_prpss>-posid.
          EXIT.
        ENDIF.
      ENDIF.
    ENDLOOP.

    IF lv_template_root IS INITIAL.
      RETURN.
    ENDIF.

*--------------------------------------------------------------------*
* 5. Build converted hierarchy
*--------------------------------------------------------------------*
    LOOP AT lt_prhis INTO ls_prhis.

      CLEAR: ls_phris,
             lv_target_posid,
             lv_target_up,
             lv_target_left.

*------------------------------------------------------------------*
* Current node from PRPSS via PRHIS-POSNR
*------------------------------------------------------------------*
      READ TABLE lt_prpss_h ASSIGNING <fs_prpss>
        WITH KEY pspnr = ls_prhis-posnr.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.

      ls_phris-template_posid = <fs_prpss>-posid.
      ls_phris-stufe          = <fs_prpss>-stufe.

      lv_target_posid = ls_phris-template_posid.
      REPLACE FIRST OCCURRENCE OF lv_template_root IN lv_target_posid WITH iv_esr_root.
      ls_phris-target_posid = lv_target_posid.

*------------------------------------------------------------------*
* UP from PRPSS via PRHIS-UP
*------------------------------------------------------------------*
      IF ls_prhis-up IS INITIAL.
        ls_phris-wbs_up = iv_esr_root.
      ELSE.
        READ TABLE lt_prpss_h ASSIGNING <fs_prpss>
          WITH KEY pspnr = ls_prhis-up.
        IF sy-subrc = 0.
          lv_target_up = <fs_prpss>-posid.
          REPLACE FIRST OCCURRENCE OF lv_template_root IN lv_target_up WITH iv_esr_root.
          ls_phris-wbs_up = lv_target_up.
        ENDIF.
      ENDIF.

*------------------------------------------------------------------*
* LEFT from PRPSS via PRHIS-LEFT
*------------------------------------------------------------------*
      IF ls_prhis-left IS NOT INITIAL.
        READ TABLE lt_prpss_h ASSIGNING <fs_prpss>
          WITH KEY pspnr = ls_prhis-left.
        IF sy-subrc = 0.
          lv_target_left = <fs_prpss>-posid.
          REPLACE FIRST OCCURRENCE OF lv_template_root IN lv_target_left WITH iv_esr_root.
          ls_phris-wbs_left = lv_target_left.
        ENDIF.
      ENDIF.

*------------------------------------------------------------------*
* Keep only rows that really exist in gt_wbs_car
*------------------------------------------------------------------*
      READ TABLE it_wbs_car TRANSPORTING NO FIELDS
        WITH KEY posid = ls_phris-target_posid.
      IF sy-subrc = 0.
        APPEND ls_phris TO et_phris_hier.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->UNCLOSE_WBS_STATUS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IT_WBS_UNCLOSE                 TYPE        TT_WBS_UNCLOSE
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD unclose_wbs_status.

  DATA: lt_return_step1 TYPE TABLE OF bapiret2,
        lt_return_step2 TYPE TABLE OF bapiret2,
        lt_precommit    TYPE TABLE OF bapiret2,
        ls_return       TYPE bapiret2,
        lt_sys_status   TYPE TABLE OF bapi_wbs_mnt_system_status,
        ls_sys_status   TYPE bapi_wbs_mnt_system_status,
        ls_unclose      TYPE ty_wbs_unclose,
        lv_has_error    TYPE abap_bool.

  rv_success = abap_false.

*---------------------------------------------------------------------*
* Pass 1:
* - CLSD -> TECO
* - TECO -> REL
*---------------------------------------------------------------------*
  CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

  CLEAR: lt_sys_status, lt_return_step1, lt_precommit, lv_has_error.

  LOOP AT it_wbs_unclose INTO ls_unclose
       WHERE to_be IS NOT INITIAL.

    CLEAR ls_sys_status.

*-------------------------------------------------------------------*
* CLSD -> TECO
*-------------------------------------------------------------------*
    IF ls_unclose-status = 'CLSD'
       AND ls_unclose-to_be = 'TECO'.

      ls_sys_status-wbs_element        = ls_unclose-wbs_element_code.
      ls_sys_status-undo_system_status = 'CLSD'.
      APPEND ls_sys_status TO lt_sys_status.

*-------------------------------------------------------------------*
* TECO -> REL
*-------------------------------------------------------------------*
    ELSEIF ls_unclose-status = 'TECO'
       AND ls_unclose-to_be = 'REL'.

      ls_sys_status-wbs_element        = ls_unclose-wbs_element_code.
      ls_sys_status-undo_system_status = 'TECO'.
      APPEND ls_sys_status TO lt_sys_status.

*-------------------------------------------------------------------*
* CLSD -> REL
* Step 1 only: CLSD -> TECO
*-------------------------------------------------------------------*
    ELSEIF ls_unclose-status = 'CLSD'
       AND ls_unclose-to_be = 'REL'.

      ls_sys_status-wbs_element        = ls_unclose-wbs_element_code.
      ls_sys_status-undo_system_status = 'CLSD'.
      APPEND ls_sys_status TO lt_sys_status.

    ENDIF.

  ENDLOOP.

*---------------------------------------------------------------------*
* Execute Pass 1 if needed
*---------------------------------------------------------------------*
  IF lt_sys_status IS NOT INITIAL.

    CALL FUNCTION 'BAPI_BUS2054_SET_STATUS'
      TABLES
        i_wbs_system_status = lt_sys_status
        e_result            = lt_return_step1.

    LOOP AT lt_return_step1 INTO ls_return WHERE type CA 'AEX'.
      rv_success = abap_false.
      RETURN.
    ENDLOOP.

    CALL FUNCTION 'BAPI_PS_PRECOMMIT'
      TABLES
        et_return = lt_precommit.

    LOOP AT lt_precommit INTO ls_return WHERE type CA 'AEX'.
      rv_success = abap_false.
      RETURN.
    ENDLOOP.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = 'X'.

  ENDIF.

*---------------------------------------------------------------------*
* Pass 2:
* only for original CLSD -> REL
* after commit of pass 1, undo TECO
*---------------------------------------------------------------------*
  CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

  CLEAR: lt_sys_status, lt_return_step2, lt_precommit, lv_has_error.

  LOOP AT it_wbs_unclose INTO ls_unclose
       WHERE to_be = 'REL'
         AND status = 'CLSD'.

    CLEAR ls_sys_status.
    ls_sys_status-wbs_element        = ls_unclose-wbs_element_code.
    ls_sys_status-undo_system_status = 'TECO'.
    APPEND ls_sys_status TO lt_sys_status.

  ENDLOOP.

*---------------------------------------------------------------------*
* Execute Pass 2 if needed
*---------------------------------------------------------------------*
  IF lt_sys_status IS NOT INITIAL.

    CALL FUNCTION 'BAPI_BUS2054_SET_STATUS'
      TABLES
        i_wbs_system_status = lt_sys_status
        e_result            = lt_return_step2.

    LOOP AT lt_return_step2 INTO ls_return WHERE type CA 'AEX'.
      rv_success = abap_false.
      RETURN.
    ENDLOOP.

    CLEAR lt_precommit.

    CALL FUNCTION 'BAPI_PS_PRECOMMIT'
      TABLES
        et_return = lt_precommit.

    LOOP AT lt_precommit INTO ls_return WHERE type CA 'AEX'.
      rv_success = abap_false.
      RETURN.
    ENDLOOP.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = 'X'.

  ENDIF.

  rv_success = abap_true.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->SAVE_REQUEST_FOR_SUBMIT_E1
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        TT_WBS_ITEMS
* | [<-()] RV_REQNUM                      TYPE        ZTB_A2R_WBSHDR-ZREQ_NUM
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD save_request_for_submit_e1.

    TYPES: BEGIN OF ty_prps_map,
             pspnr TYPE prps-pspnr,
             posid TYPE prps-posid,
           END OF ty_prps_map.

    DATA: ls_header   TYPE ztb_a2r_wbshdr,
          ls_item     TYPE ztb_a2r_wbsitem,
          ls_wbs      TYPE ztb_a2r_wbsitem,
          lv_error    TYPE abap_bool,
          lv_vkokr    TYPE kokrs,
          lt_pspnr    TYPE SORTED TABLE OF prps-pspnr WITH UNIQUE KEY table_line,
          lt_prps_map TYPE HASHED TABLE OF ty_prps_map WITH UNIQUE KEY pspnr,
          ls_prps_map TYPE ty_prps_map.

*---------------------------------------------------------------------*
* Determine controlling area
*---------------------------------------------------------------------*
    lv_vkokr = is_header-vkokr.

    IF lv_vkokr IS INITIAL.
      SELECT SINGLE vkokr
        INTO @lv_vkokr
        FROM ztb_a2r_wbsitem
        WHERE zreq_num = @is_header-zreq_num
          AND stufe    = 1.
    ENDIF.

    IF lv_vkokr IS INITIAL AND is_header-pspnr IS NOT INITIAL.
      SELECT SINGLE vkokr
        INTO @lv_vkokr
        FROM proj
        WHERE pspnr = @is_header-pspnr.
    ENDIF.

*---------------------------------------------------------------------*
* Generate new request number
*---------------------------------------------------------------------*
    IF is_header-zreq_num IS INITIAL.
      rv_reqnum = get_next_request_number( ).
    ELSE.
      rv_reqnum = is_header-zreq_num.
    ENDIF.

    IF rv_reqnum IS INITIAL.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* Prepare header
*---------------------------------------------------------------------*
    CLEAR ls_header.

    SELECT SINGLE posnr, gjahr
    FROM impr
    INTO @DATA(ls_impr)
      WHERE posnr = @is_header-posnr
        AND prnam = @is_header-prnam.
    IF sy-subrc EQ 0.
      ls_header-gjahr = ls_impr-gjahr.
    ENDIF.

    ls_header-mandt          = sy-mandt.
    ls_header-zreq_num       = rv_reqnum.
    ls_header-posnr          = is_header-posnr.
    ls_header-prnam          = is_header-prnam.
    ls_header-pspnr          = is_header-pspnr.
    ls_header-post1          = is_header-post1.
    ls_header-vernr          = is_header-vernr.
    ls_header-plsez          = is_header-plsez.
    ls_header-bukrs          = is_header-bukrs.
    ls_header-werks          = is_header-werks.
    ls_header-waers          = is_header-waers.
    ls_header-prctr          = is_header-prctr.
    ls_header-kostl          = is_header-kostl.
    ls_header-vkokr          = lv_vkokr.
    ls_header-izwek          = is_header-izwek.
    ls_header-zunifier_proj  = is_header-zunifier_proj.
    ls_header-usr008         = is_header-usr008.
    ls_header-profl          = is_header-profl.
    ls_header-z_reqtype      = 'E1'.
    ls_header-request_status = 'PENDING'.
    ls_header-ernam          = sy-uname.
    ls_header-erdat          = sy-datum.

    IF is_header-z_remarks IS NOT INITIAL.
      ls_header-z_remarks = is_header-z_remarks.
    ENDIF.

*---------------------------------------------------------------------*
* Insert header
*---------------------------------------------------------------------*
    INSERT ztb_a2r_wbshdr FROM @ls_header.

    IF sy-subrc <> 0.
      CLEAR rv_reqnum.
      RETURN.
    ENDIF.

**---------------------------------------------------------------------*
** Read all external POSID from PRPS in one shot
**---------------------------------------------------------------------*
*  LOOP AT it_wbs_items INTO ls_wbs.
*    IF ls_wbs-posid IS NOT INITIAL.
*      INSERT CONV prps-pspnr( ls_wbs-posid ) INTO TABLE lt_pspnr.
*    ENDIF.
*  ENDLOOP.
*
*  IF lt_pspnr IS NOT INITIAL.
*    SELECT pspnr, posid
*      FROM prps
*      INTO TABLE @DATA(lt_prps_raw)
*      FOR ALL ENTRIES IN @lt_pspnr
*      WHERE pspnr = @lt_pspnr-table_line.
*
*    IF sy-subrc = 0.
*      LOOP AT lt_prps_raw INTO DATA(ls_prps_raw).
*        ls_prps_map-pspnr = ls_prps_raw-pspnr.
*        ls_prps_map-posid = ls_prps_raw-posid.
*        INSERT ls_prps_map INTO TABLE lt_prps_map.
*      ENDLOOP.
*    ENDIF.
*  ENDIF.

*---------------------------------------------------------------------*
* Insert item snapshot
*---------------------------------------------------------------------*
    LOOP AT it_wbs_items INTO ls_wbs.

      CLEAR: ls_item, ls_prps_map.

      ls_item-mandt         = sy-mandt.
      ls_item-zreq_num      = rv_reqnum.
      ls_item-bukrs         = ls_header-bukrs.
      ls_item-vkokr         = lv_vkokr.
      ls_item-stufe         = ls_wbs-stufe.
      ls_item-zstat_tobe    = ls_wbs-zstat_tobe.
      ls_item-post1         = ls_wbs-post1.
      ls_item-kostl         = ls_wbs-kostl.
      ls_item-wert2         = ls_wbs-wert2.
      ls_item-zbudget_check = ls_wbs-zbudget_check.
      ls_item-imprf         = ls_wbs-imprf.
      ls_item-prart         = ls_wbs-prart.
      ls_item-werks         = ls_header-werks.
      ls_item-posnr         = ls_wbs-posnr.

      READ TABLE lt_prps_map INTO ls_prps_map
        WITH TABLE KEY pspnr = CONV prps-pspnr( ls_wbs-posid ).

      IF sy-subrc = 0 AND ls_prps_map-posid IS NOT INITIAL.
        ls_item-posid = ls_prps_map-posid.
      ELSE.
        ls_item-posid = ls_wbs-posid.
      ENDIF.

      INSERT ztb_a2r_wbsitem FROM @ls_item.
      IF sy-subrc <> 0.
        lv_error = abap_true.
        EXIT.
      ENDIF.

    ENDLOOP.

    IF lv_error = abap_true.
      ROLLBACK WORK.
      CLEAR rv_reqnum.
      RETURN.
    ENDIF.

    COMMIT WORK AND WAIT.

  ENDMETHOD.
ENDCLASS.
