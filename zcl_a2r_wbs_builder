          lv_error          TYPE char1,
          ls_project_new    TYPE bapi_bus2001_new,
          lv_mode           TYPE c VALUE 'N',  " Changed to 'A' for debugging
          lv_update         TYPE c VALUE 'A'   " Asynchronous
          .

    rv_success = abap_false.
    CLEAR lv_error.
    DATA: lv_vkokr      TYPE kokrs,
          lv_pspnr      TYPE ps_spsnr,
          lv_posid      TYPE ps_posid,
          lv_vkokr_char TYPE char24,
          lv_posid_db   TYPE ps_posid.

    "1) Header value
    lv_vkokr = is_header-vkokr.

    "2) If missing -> read from Z table items
    IF lv_vkokr IS INITIAL.

      "Prefer VKOKR directly if your Z table has it
      SELECT SINGLE vkokr
        INTO @lv_vkokr
        FROM ztb_a2r_wbsitem
        WHERE zreq_num = @is_header-zreq_num
          AND vkokr    IS NOT NULL
          AND vkokr    <> ''.

    ENDIF.

    "3) If still missing -> derive via PRPSS using POSNR from Z table
    IF lv_vkokr IS INITIAL.

      SELECT SINGLE posnr
        INTO @lv_pspnr
        FROM ztb_a2r_wbsitem
        WHERE zreq_num = @is_header-zreq_num
          AND posnr    IS NOT NULL
          AND posnr    <> ''.

      IF lv_pspnr IS NOT INITIAL.
        SELECT SINGLE pkokr
          INTO lv_vkokr
          FROM prpss
          WHERE pspnr = lv_pspnr.
      ENDIF.

    ENDIF.

    "4) If still missing -> derive via PRPS->PRPSS using POSID from Z table
    IF lv_vkokr IS INITIAL.

      SELECT SINGLE posid
        INTO @lv_posid
        FROM ztb_a2r_wbsitem
        WHERE zreq_num = @is_header-zreq_num
          AND posid    IS NOT NULL
          AND posid    <> ''.

      IF lv_posid IS NOT INITIAL.

        lv_posid_db = lv_posid.

        "Normalize POSID if stored without dots
        TRY.
            CALL FUNCTION 'CONVERSION_EXIT_ABPSP_INPUT'
              EXPORTING
                input  = lv_posid_db
              IMPORTING
                output = lv_posid_db.
          CATCH cx_root.
        ENDTRY.

        "Get PSPNR from PRPS then get KOKRS from PRPSS
        CLEAR lv_pspnr.
        SELECT SINGLE pspnr
          INTO lv_pspnr
          FROM prps
          WHERE posid = lv_posid_db.

        IF lv_pspnr IS NOT INITIAL.
          SELECT SINGLE pkokr
            INTO lv_vkokr
            FROM prpss
            WHERE pspnr = lv_pspnr.
        ENDIF.

      ENDIF.

    ENDIF.


    "═══════════════════════════════════════════════════════════════════
    " STEP 1: GET NEXT PROJECT NUMBER
    "═══════════════════════════════════════════════════════════════════
    lv_pspid = get_next_project_number( is_header-profl ).

    IF lv_pspid IS INITIAL.
      MESSAGE e029(zcj00) WITH 'Failed to get project number'(m01).
      RETURN.
    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 2: GET CURRENCY FROM COMPANY CODE
    "═══════════════════════════════════════════════════════════════════
    SELECT SINGLE waers FROM t001
      INTO lv_waers
      WHERE bukrs = is_header-bukrs.

    IF sy-subrc <> 0.
      lv_waers = 'USD'.
    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 3: INITIALIZE BAPI
    "═══════════════════════════════════════════════════════════════════
    CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

    "═══════════════════════════════════════════════════════════════════
    " STEP 4: CREATE PROJECT DEFINITION (Level 1)
    " Reference: FORM check_proj_create
    "═══════════════════════════════════════════════════════════════════
    CLEAR ls_project_new.

    " Use the generated project number
    ls_project_new-project_definition = lv_pspid.

    " Map from header (following reference pattern)
    ls_project_new-description        = is_header-post1.
    ls_project_new-company_code       = is_header-bukrs.
    ls_project_new-controlling_area   = lv_vkokr.
    ls_project_new-profit_ctr         = is_header-prctr.
    ls_project_new-start              = is_header-plsez.
    ls_project_new-finish             = is_header-plsez.
    ls_project_new-fcst_start         = is_header-plsez.
    ls_project_new-fcst_finish        = is_header-plsez.
    ls_project_new-plant              = is_header-werks.
    ls_project_new-project_profile    = is_header-profl.
    ls_project_new-responsible_no     = is_header-vernr.
    ls_project_new-project_currency   = lv_waers.

    " Optional fields from reference
    IF is_header-vkokr IS NOT INITIAL.
      ls_project_new-controlling_area = lv_vkokr.
    ENDIF.

    " Create Project Definition via BAPI
    CALL FUNCTION 'BAPI_BUS2001_CREATE'
      EXPORTING
        i_project_definition = ls_project_new
      TABLES
        et_return            = lt_return.

    LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'EA'.
      lv_error = 'X'.
      EXIT.
    ENDLOOP.

    IF lv_error = 'X'.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
      MESSAGE e029(zcj00) WITH 'Project creation failed' ##NO_TEXT.
      RETURN.
    ENDIF.


    "═══════════════════════════════════════════════════════════════════
    " STEP 5: BUILD WBS ELEMENTS FROM TEMPLATE STRUCTURE
    " Reference: FORM check_prps_create
    " Critical: Maintain template hierarchy and naming from IT_WBS_ITEMS
    "═══════════════════════════════════════════════════════════════════
    DATA lv_level1_assigned TYPE abap_bool VALUE abap_false.
    " Sort by STUFE DESCENDING (reference pattern)
    lt_wbs_sorted = it_wbs_items.
    SORT lt_wbs_sorted BY stufe DESCENDING posid DESCENDING.
    CLEAR: lt_wbs_celement, lt_extensionin.

    LOOP AT lt_wbs_sorted INTO ls_wbs.

      " Skip Level 1 (already created as project definition)
      IF ls_wbs-stufe = 1.
        CONTINUE.
      ENDIF.

      CLEAR: ls_wbs_celement, ls_te_wbs, lv_upper_level, lv_left_level.
      lv_index = sy-tabix + 1.

      "───────────────────────────────────────────────────────────────
      " WBS ELEMENT ID: Critical - Build from new project number + template suffix
      " Template: PC.000003.00, PC.000003.00.1, PC.000003.00.2, etc.
      " New:      PC.000011.00, PC.000011.00.1, PC.000011.00.2, etc.
      "───────────────────────────────────────────────────────────────

      " Extract suffix from template POSID
      " Template POSID format: PC.000003.00.1
      " We need: .00.1 part
      DATA: lv_template_posid TYPE ps_posid,
            lv_new_posid      TYPE ps_posid,
            lv_suffix         TYPE string,
            lv_template_len   TYPE i,
            lv_project_len    TYPE i.

      lv_template_posid = ls_wbs-posid.

      " Find where project number ends in template
      " Template project should be in STUFE = 1 item or from COPY_TEMPLATE_STRUCTURE
      " Assuming template format: PC.NNNNNN.XX.Y where PC.NNNNNN is project
      " and .XX.Y is WBS hierarchy suffix

      " Simple approach: Replace template project ID with new project ID
      " Template: PC.000003.00.1 → Find 'PC.000003' and replace with new 'PC.000011'

      " Get template project ID (should be first 9 or 10 chars depending on format)
      " For safety, we'll use the Level 1 WBS POSID as template project
      DATA: lv_template_project TYPE ps_pspid.

      " Read Level 1 from sorted list to get template project ID
      READ TABLE lt_wbs_sorted INTO DATA(ls_level1) WITH KEY stufe = 1.
      IF sy-subrc = 0.
        lv_template_project = ls_level1-posid.
      ELSE.
        " Fallback: Extract from first Level 2 WBS
        " Format: PC.000003.00 → Extract PC.000003
        IF strlen( lv_template_posid ) >= 10.
          lv_template_project = lv_template_posid(10).  " 'PC.000003'
        ENDIF.
      ENDIF.

      " Build new WBS POSID by replacing template project with new project
      IF lv_template_project IS NOT INITIAL AND
         lv_template_posid CS lv_template_project.

        " Replace template project ID with new project ID
        lv_new_posid = lv_template_posid.
        REPLACE lv_template_project IN lv_new_posid WITH lv_pspid.

      ELSE.
        " Fallback: Use template POSID as-is (shouldn't happen)
        lv_new_posid = lv_template_posid.
      ENDIF.

      ls_wbs_celement-wbs_element = lv_new_posid.

      CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
        EXPORTING
          input  = lv_new_posid
        IMPORTING
          output = lv_new_posid.

      ls_wbs_celement-wbs_element = lv_new_posid.

      "───────────────────────────────────────────────────────────────
      " BASIC FIELDS (Reference: check_prps_create)
      "───────────────────────────────────────────────────────────────
      ls_wbs_celement-description      = ls_wbs-post1.
      ls_wbs_celement-company_code     = is_header-bukrs.
      ls_wbs_celement-profit_ctr       = is_header-prctr.
      ls_wbs_celement-plant            = is_header-werks.

      "───────────────────────────────────────────────────────────────
      " PLANNING & INVESTMENT FIELDS
      "───────────────────────────────────────────────────────────────
      ls_wbs_celement-wbs_planning_element = abap_true.
      ls_wbs_celement-inv_reason           = is_header-izwek.
      ls_wbs_celement-respsbl_cctr         = ls_wbs-kostl.
      ls_wbs_celement-responsible_no       = is_header-vernr.

      "───────────────────────────────────────────────────────────────
      " DATES
      "───────────────────────────────────────────────────────────────
      ls_wbs_celement-wbs_basic_start_date     = is_header-plfaz.
      ls_wbs_celement-wbs_basic_finish_date    = is_header-plsez.
      ls_wbs_celement-wbs_forecast_start_date  = is_header-plfaz.
      ls_wbs_celement-wbs_forecast_finish_date = is_header-plsez.


      "───────────────────────────────────────────────────────────────
      " ACCOUNT ASSIGNMENT
      "───────────────────────────────────────────────────────────────
      ls_wbs_celement-wbs_account_assignment_element = abap_true.

      "───────────────────────────────────────────────────────────────
      " HIERARCHY: WBS_UP and WBS_LEFT (CRITICAL - Reference pattern)
      "───────────────────────────────────────────────────────────────

      " Find UPPER level (parent) - same logic with new project ID
      DATA: lv_parent_template TYPE ps_posid,
            lv_parent_new      TYPE ps_posid.
      "---------------------------------------------------
      " Find UPPER level (parent) - CORRECT LOGIC
      "---------------------------------------------------
      CLEAR lv_upper_level.

      DATA(lv_back_index) = sy-tabix - 1.

      WHILE lv_back_index > 0.
        READ TABLE lt_wbs_sorted INTO ls_wbs_temp INDEX lv_back_index.
        IF sy-subrc <> 0.
          EXIT.
        ENDIF.

        IF ls_wbs_temp-stufe < ls_wbs-stufe.

          IF ls_wbs_temp-stufe = 1.
            " Parent is project
            lv_upper_level = lv_pspid.
          ELSE.
            " Parent is another WBS
            lv_parent_new = ls_wbs_temp-posid.
            REPLACE lv_template_project IN lv_parent_new WITH lv_pspid.
            lv_upper_level = lv_parent_new.
          ENDIF.

          EXIT.
        ENDIF.

        lv_back_index = lv_back_index - 1.
      ENDWHILE.

      " Find LEFT level (left sibling) - same logic
      CLEAR lv_left_level.
      DATA: lv_search_index TYPE i.
      lv_search_index = sy-tabix + 1.

      LOOP AT lt_wbs_sorted INTO ls_wbs_temp FROM lv_search_index.
        IF lv_left_level IS INITIAL AND
           ls_wbs_temp-stufe = ls_wbs-stufe.
          " Found left sibling
          DATA: lv_left_template TYPE ps_posid,
                lv_left_new      TYPE ps_posid.

          lv_left_template = ls_wbs_temp-posid.
          lv_left_new = lv_left_template.

          IF lv_template_project IS NOT INITIAL.
            REPLACE lv_template_project IN lv_left_new WITH lv_pspid.
          ENDIF.

          lv_left_level = lv_left_new.
          EXIT.
        ENDIF.
      ENDLOOP.

      " Set hierarchy pointers
      "---------------------------------------------------
      " Convert and assign WBS_ELEMENT
      "---------------------------------------------------
      CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
        EXPORTING
          input  = lv_new_posid
        IMPORTING
          output = ls_wbs_celement-wbs_element.

      "---------------------------------------------------
      " Convert and assign WBS_UP
      "---------------------------------------------------
      IF lv_upper_level IS NOT INITIAL.
        CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
          EXPORTING
            input  = lv_upper_level
          IMPORTING
            output = ls_wbs_celement-wbs_up.
      ENDIF.

      "---------------------------------------------------
      " Convert and assign WBS_LEFT
      "---------------------------------------------------
      IF lv_left_level IS NOT INITIAL.
        CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
          EXPORTING
            input  = lv_left_level
          IMPORTING
            output = ls_wbs_celement-wbs_left.
      ENDIF.
                                                            "ev92123
      DATA(lv_child) = ls_wbs_celement-wbs_element.
      DATA(lv_pos)   = 0.
      FIND ALL OCCURRENCES OF '.' IN lv_child MATCH OFFSET lv_pos.
      IF sy-subrc = 0.
        ls_wbs_celement-wbs_up = lv_child(lv_pos).
      ELSE.
        ls_wbs_celement-wbs_up = ''.
      ENDIF.
                                                            "ev92123
      APPEND ls_wbs_celement TO lt_wbs_celement.

      "───────────────────────────────────────────────────────────────
      " EXTENSION FIELDS (Reference pattern)STEP 6
      "───────────────────────────────────────────────────────────────
      IF ls_wbs-stufe = 2 AND is_header-zunifier_proj = 'X'.
        CLEAR: ls_te_wbs, ls_extensionin.

        ls_te_wbs-wbs_element   = ls_wbs_celement-wbs_element.
        ls_te_wbs-zunifier_proj = 'X'.

        ls_extensionin-structure  = 'BAPI_TE_WBS_ELEMENT'.
        ls_extensionin-valuepart1 = ls_te_wbs.
        ls_extensionin-valuepart2+49(01) = ls_te_wbs-zunifier_proj.

        APPEND ls_extensionin TO lt_extensionin.
      ENDIF.

    ENDLOOP.

    "═══════════════════════════════════════════════════════════════════
    " STEP 6: CREATE ALL WBS ELEMENTS IN ONE BAPI CALL
    "═══════════════════════════════════════════════════════════════════

    CLEAR lt_wbs_celement.

    " Sort by POSID DESCENDING, STUFE DESCENDING
    lt_wbs_sorted = it_wbs_items.
    SORT lt_wbs_sorted BY posid ASCENDING stufe ASCENDING.

    LOOP AT lt_wbs_sorted INTO ls_wbs.

      " CLEAR ALL variables including work variables
      CLEAR: ls_wbs_celement,
             ls_te_wbs,
             lv_upper_level,
             lv_left_level,
             lv_left_new,
             lv_parent_new,
             lv_backward_index.

      lv_index = sy-tabix + 1.

      "───────────────────────────────────────────────────────────────
      " WBS ELEMENT ID
      "───────────────────────────────────────────────────────────────

      lv_template_posid = ls_wbs-posid.

      " Get template project ID (Level 1)
      READ TABLE lt_wbs_sorted INTO ls_level1 WITH KEY stufe = 1.
      IF sy-subrc = 0.
        lv_template_project = ls_level1-posid.
      ENDIF.

      " Build new WBS POSID
      IF ls_wbs-stufe = 1.
        lv_new_posid = lv_pspid.
        REPLACE ALL OCCURRENCES OF '.' IN lv_new_posid WITH ''.
      ELSE.
        IF lv_template_project IS NOT INITIAL AND
           lv_template_posid CS lv_template_project.
          lv_new_posid = lv_template_posid.
          REPLACE lv_template_project IN lv_new_posid WITH lv_pspid.
        ELSE.
          lv_new_posid = lv_template_posid.
        ENDIF.
        REPLACE ALL OCCURRENCES OF '.' IN lv_new_posid WITH ''.
      ENDIF.

      ls_wbs_celement-wbs_element = lv_new_posid.

      "───────────────────────────────────────────────────────────────
      " BASIC FIELDS
      "───────────────────────────────────────────────────────────────
      ls_wbs_celement-description      = ls_wbs-post1.
      ls_wbs_celement-company_code     = is_header-bukrs.
      ls_wbs_celement-profit_ctr       = is_header-prctr.
      ls_wbs_celement-controlling_area = is_header-vkokr.
      ls_wbs_celement-plant            = is_header-werks.

      ls_wbs_celement-wbs_planning_element = abap_true.
      ls_wbs_celement-inv_reason           = is_header-izwek.

      IF ls_wbs-stufe = 1.
        ls_wbs_celement-invest_profile = ls_wbs-imprf.
      ELSE.
        CLEAR ls_wbs_celement-invest_profile.
      ENDIF.

      ls_wbs_celement-respsbl_cctr   = ls_wbs-kostl.
      ls_wbs_celement-inv_reason     = is_header-izwek.
      ls_wbs_celement-responsible_no = is_header-vernr.

      ls_wbs_celement-wbs_basic_start_date     = is_header-plfaz.
      ls_wbs_celement-wbs_basic_finish_date    = is_header-plsez.
      ls_wbs_celement-wbs_forecast_start_date  = is_header-plfaz.
      ls_wbs_celement-wbs_forecast_finish_date = is_header-plsez.

      ls_wbs_celement-wbs_account_assignment_element = abap_true.

      "───────────────────────────────────────────────────────────────
      " HIERARCHY: WBS_UP and WBS_LEFT
      "───────────────────────────────────────────────────────────────

      "------------------------------------------------------------
      " WBS_LEFT: Search FORWARD for same-level sibling
      "   from the next row after current (lv_index + 1) to the end
      "------------------------------------------------------------
      DATA: lv_forward_index TYPE sy-tabix.

      CLEAR: lv_left_new, lv_left_level.
      lv_forward_index = lv_index + 1.

      WHILE lv_forward_index <= lines( lt_wbs_sorted ).
        READ TABLE lt_wbs_sorted INDEX lv_forward_index INTO ls_wbs_temp.
        IF sy-subrc = 0 AND ls_wbs_temp-stufe = ls_wbs-stufe.

          " Found the next sibling - rebuild with new project id
          lv_left_new = ls_wbs_temp-posid.
          IF lv_template_project IS NOT INITIAL.
            REPLACE lv_template_project IN lv_left_new WITH lv_pspid.
          ENDIF.
          REPLACE ALL OCCURRENCES OF '.' IN lv_left_new WITH ''.
          lv_left_level = lv_left_new.
          EXIT.

        ENDIF.
        lv_forward_index = lv_forward_index + 1.
      ENDWHILE.


      "------------------------------------------------------------
      " WBS_UP: Search BACKWARD for parent (nearest upper level)
      "   from the previous row (lv_index - 1) up to the top
      "------------------------------------------------------------

      CLEAR: lv_parent_new, lv_upper_level.
      lv_backward_index = lv_index - 1.

      WHILE lv_backward_index >= 1.
        READ TABLE lt_wbs_sorted INDEX lv_backward_index INTO ls_wbs_temp.
        IF sy-subrc = 0 AND ls_wbs_temp-stufe < ls_wbs-stufe.

          IF ls_wbs_temp-stufe = 1.
            lv_parent_new = lv_pspid.
          ELSE.
            lv_parent_new = ls_wbs_temp-posid.
            IF lv_template_project IS NOT INITIAL.
              REPLACE lv_template_project IN lv_parent_new WITH lv_pspid.
            ENDIF.
          ENDIF.

          REPLACE ALL OCCURRENCES OF '.' IN lv_parent_new WITH ''.
          lv_upper_level = lv_parent_new.
          EXIT.

        ENDIF.
        lv_backward_index = lv_backward_index - 1.
      ENDWHILE.


      " Set results to the current element
      ls_wbs_celement-wbs_up   = lv_upper_level.
      ls_wbs_celement-wbs_left = lv_left_level.
      CLEAR: ls_wbs_celement-wbs_left, lv_left_level.
      APPEND ls_wbs_celement TO lt_wbs_celement.

      "───────────────────────────────────────────────────────────────
      " EXTENSION FIELDS
      "───────────────────────────────────────────────────────────────
      IF ls_wbs-stufe = 2 AND is_header-zunifier_proj = 'X'.
        CLEAR: ls_te_wbs, ls_extensionin.

        ls_te_wbs-wbs_element   = lv_new_posid.
        ls_te_wbs-zunifier_proj = 'X'.

        ls_extensionin-structure  = 'BAPI_TE_WBS_ELEMENT'.
        ls_extensionin-valuepart1 = ls_te_wbs.
        ls_extensionin-valuepart2+49(01) = ls_te_wbs-zunifier_proj.

        APPEND ls_extensionin TO lt_extensionin.
      ENDIF.

    ENDLOOP.

    " Create ALL WBS elements in ONE BAPI call
    IF lt_wbs_celement IS NOT INITIAL OR NOT lt_extensionin IS INITIAL.

      CLEAR lt_return.

      CALL FUNCTION 'BAPI_BUS2054_CREATE_MULTI'
        EXPORTING
          i_project_definition = lv_pspid
        TABLES
          it_wbs_element       = lt_wbs_celement
          et_return            = lt_return
          extensionin          = lt_extensionin.

      LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'EA'.
        lv_error = 'X'.
        EXIT.
      ENDLOOP.

      IF lv_error = 'X'.
        MESSAGE e029(zcj00) WITH 'WBS creation failed'.
        RETURN.
      ENDIF.

    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 7: PRE-COMMIT (Call ONCE after all WBS created)
    "═══════════════════════════════════════════════════════════════════
    CLEAR lt_return.

    CALL FUNCTION 'BAPI_PS_PRECOMMIT'
      TABLES
        et_return = lt_return.

    LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'EA'.
      lv_error = 'X'.
      EXIT.
    ENDLOOP.

    IF lv_error = 'X'.
      MESSAGE e029(zcj00) WITH 'WBS prrecommit failed'.
      RETURN.
    ENDIF.
    "═══════════════════════════════════════════════════════════════════
    " STEP 8: COMMIT WORK
    "═══════════════════════════════════════════════════════════════════

    CLEAR ls_return.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait   = 'X'
      IMPORTING
        return = ls_return.

    IF ls_return-type CA 'EA'.
      MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
        WITH ls_return-message_v1 ls_return-message_v2.
      RETURN.
    ENDIF.


    "═══════════════════════════════════════════════════════════════════
    " STEP 9: GET CREATED WBS INTERNAL NUMBERS
    "═══════════════════════════════════════════════════════════════════

    " Get project internal number
    SELECT SINGLE pspnr FROM proj
      INTO lv_level1_pspnr
      WHERE pspid = lv_pspid.

    " Build output table with created WBS elements
    LOOP AT it_wbs_items INTO ls_wbs.

      IF ls_wbs-wert2 IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR ls_wbs_created.

      IF ls_wbs-stufe = 1.
        " Level 1 = Project
        ls_wbs_created-posid = lv_pspid.
        ls_wbs_created-posnr = lv_level1_pspnr.
      ELSE.
        " Level 2+ = WBS Element - rebuild POSID with new project number
        DATA: lv_created_posid TYPE ps_posid.

        lv_created_posid = ls_wbs-posid.

        " Replace template project with new project
        READ TABLE lt_wbs_sorted INTO ls_level1 WITH KEY stufe = 1.
        IF sy-subrc = 0.
          REPLACE ls_level1-posid IN lv_created_posid WITH lv_pspid.
        ENDIF.

        ls_wbs_created-posid = lv_created_posid.

        " Get internal number from PRPS
        SELECT SINGLE pspnr FROM prps
          INTO ls_wbs_created-posnr
          WHERE posid = ls_wbs_created-posid.

      ENDIF.

      " Copy other fields
      ls_wbs_created-stufe          = ls_wbs-stufe.
      ls_wbs_created-post1          = ls_wbs-post1.
      ls_wbs_created-kostl          = ls_wbs-kostl.
      ls_wbs_created-wert2          = ls_wbs-wert2.
      ls_wbs_created-zbudget_check  = ls_wbs-zbudget_check.
      ls_wbs_created-imprf          = ls_wbs-imprf.
      ls_wbs_created-prart          = ls_wbs-prart.
      ls_wbs_created-bukrs          = is_header-bukrs.
      ls_wbs_created-werks          = is_header-werks.

      UPDATE ztb_a2r_wbsitem
        SET posid = @ls_wbs_created-posid,
          posnr = @ls_wbs_created-posnr
        WHERE zreq_num = @is_header-zreq_num
          AND posid    = @ls_wbs-posid.


      APPEND ls_wbs_created TO lt_wbs_created.

    ENDLOOP.

    "═══════════════════════════════════════════════════════════════════
    " STEP 10: UPDATE HEADER WITH PROJECT NUMBER
    "═══════════════════════════════════════════════════════════════════
    UPDATE ztb_a2r_wbshdr
      SET pspnr = @lv_level1_pspnr,
      pspid = @lv_pspid,
      vkokr = @is_header-vkokr,
      waers = @lv_waers
      WHERE zreq_num = @is_header-zreq_num.


    "═══════════════════════════════════════════════════════════════════
    " STEP 10: ASSIGN INVESTMENT PROGRAM
    " STEP 11: CREATE SETTLEMENT RULES
    "═══════════════════════════════════════════════════════════════════
    DATA: lv_hdr_prnam  TYPE ztb_a2r_wbshdr-prnam,
          lv_prnam      TYPE impr-prnam,
          lv_posid_im   TYPE impr-posid,
          lv_gjahr_im   TYPE impr-gjahr,
          lv_parnr_im   TYPE impr-parnr,
          lv_pspid_char TYPE char24.

    DATA: lt_bdc_cj02 TYPE STANDARD TABLE OF bdcdata,
          lt_msg_cj02 TYPE STANDARD TABLE OF bdcmsgcoll,
          ls_msg_cj02 TYPE bdcmsgcoll.

    DATA: lv_wbs_posid_cj02   TYPE prps-posid,
          lv_cj02_error       TYPE abap_bool,
          lv_try_cj02         TYPE i,
          lv_wbs_posid_cj02_c TYPE fnam_____4,
          lv_posid_char       TYPE char24.

    " Get Level 1 WBS Element (Project Definition) from lt_wbs_celement
    READ TABLE lt_wbs_celement INTO ls_wbs_celement INDEX 1.

    IF sy-subrc = 0 AND ls_wbs_celement-wbs_element IS NOT INITIAL.

      lv_wbs_posid_cj02_c = lv_wbs_posid_cj02.

      "------------------------------------------------------------
      "1) Read PRNAM from header table
      "------------------------------------------------------------
      CLEAR lv_hdr_prnam.
      SELECT SINGLE prnam
        FROM ztb_a2r_wbshdr
        INTO @lv_hdr_prnam
        WHERE zreq_num = @is_header-zreq_num.


      lv_prnam = lv_hdr_prnam.

      "------------------------------------------------------------
      "2) Get IM Position (POSID) by highest PARNR for this PRNAM
      "   (your requirement: PRNAM = header PRNAM, highest PARNR)
      "------------------------------------------------------------
      CLEAR: lv_posid_im, lv_gjahr_im, lv_parnr_im.

      SELECT posid, gjahr
        FROM impr AS a
        WHERE a~prnam = @lv_prnam
          AND NOT EXISTS (
      SELECT 1 FROM impr AS b
        WHERE b~prnam = a~prnam
          AND b~parnr = a~posnr )   "a is not parent of any node
        INTO (@lv_posid_im, @lv_gjahr_im)
          UP TO 1 ROWS.
      ENDSELECT.

      IF lv_posid_im IS INITIAL OR lv_gjahr_im IS INITIAL.
        "Fallback: at least get any record for PRNAM
        SELECT SINGLE posid, gjahr
          FROM impr
          INTO (@lv_posid_im, @lv_gjahr_im)
          WHERE prnam = @lv_prnam.
      ENDIF.

      " Convert to CHAR132
      lv_posid_char = ls_wbs_celement-wbs_element.

      lv_wbs_posid_cj02 = lv_posid_char.
      lv_wbs_posid_cj02_c = lv_wbs_posid_cj02.

      lv_cj02_error = abap_false.

      lv_try_cj02 = sy-index.
      CLEAR: lt_bdc_cj02, lt_msg_cj02.

      "SAPLCJWB 0100
      bdc_dynpro( EXPORTING iv_program = 'SAPLCJWB'
                            iv_dynpro  = '0100'
                  CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = 'BDC_CURSOR'
                           iv_fval    = '*PRPS-POSID'
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = 'BDC_OKCODE'
                           iv_fval    = '=LETB'
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = '*PROJ-PSPID'
                           iv_fval    = ''
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = '*PRPS-POSID'
                           iv_fval    = lv_wbs_posid_cj02_c
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).

      "SAPLCJWB 0901 -> AIPP
      bdc_dynpro( EXPORTING iv_program = 'SAPLCJWB'
                            iv_dynpro  = '0901'
                  CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = 'BDC_OKCODE'
                           iv_fval    = '=AIPP'
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = 'BDC_SUBSCR'
                           iv_fval    = 'SAPLCJWB                                0902LISTE'
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = 'BDC_CURSOR'
                           iv_fval    = 'RCWBS-IDENT(01)'
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = 'BDC_SUBSCR'
                           iv_fval    = 'SAPLCJWB                                3993BUTTONS'
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).

      "SAPLAIPP 0050 -> fill PRNAM/POSID/GJAHR and TAKE
      bdc_dynpro( EXPORTING iv_program = 'SAPLAIPP'
                            iv_dynpro  = '0050'
                  CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = 'BDC_CURSOR'
                           iv_fval    = 'RAIP1-PRNAM'
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = 'BDC_OKCODE'
                           iv_fval    = '=TAKE'
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).

      bdc_field(  EXPORTING iv_fnam = 'RAIP1-PRNAM' iv_fval = CONV #( lv_prnam )
                  CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field(  EXPORTING iv_fnam = 'RAIP1-POSID' iv_fval = CONV #( lv_posid_im )
                  CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = 'RAIP1-GJAHR'
                           iv_fval    = |{ lv_gjahr_im }|
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).

      "Back to 0901 -> Save
      bdc_dynpro( EXPORTING iv_program = 'SAPLCJWB'
                            iv_dynpro  = '0901'
                  CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = 'BDC_OKCODE'
                           iv_fval    = '=BU'
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = 'BDC_SUBSCR'
                           iv_fval    = 'SAPLCJWB                                0902LISTE'
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = 'BDC_CURSOR'
                           iv_fval    = 'RCWBS-IDENT(01)'
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).
      bdc_field( EXPORTING iv_fnam    = 'BDC_SUBSCR'
                           iv_fval    = 'SAPLCJWB                                3993BUTTONS'
                 CHANGING  ct_bdcdata = lt_bdc_cj02 ).

      CALL TRANSACTION 'CJ02'
        USING lt_bdc_cj02
        MODE  lv_mode
        UPDATE lv_update
        MESSAGES INTO lt_msg_cj02.

      lv_cj02_error = abap_false.
      LOOP AT lt_msg_cj02 INTO ls_msg_cj02 WHERE msgtyp CA 'AEX'.
        lv_cj02_error = abap_true.
        EXIT.
      ENDLOOP.

      IF sy-subrc EQ 0.
        MESSAGE e398(00) WITH 'CJ02 IM assignment failed for WBS' lv_wbs_posid_cj02.
      ELSE.
        COMMIT WORK AND WAIT.
        WAIT UP TO 2 SECONDS.
      ENDIF.

      " Proceed with settlement rule
      lv_pspid_char = ls_wbs_celement-wbs_element.
      lv_vkokr_char  = lv_vkokr.

      settlement_rule( iv_vkokr = lv_vkokr_char
                       iv_pspid = lv_pspid_char
                       ).

    ENDIF.

    "------------------------------------------------------------
    " AFTER CJB2 settlement-rule BDC + IM ASSIGNMENT
    " Next step: execute PLAN VALUES (CJ40 via KBPP_EXTERN_UPDATE_CO)
    " IMPORTANT: use LT_WBS_CREATED (created POSID), not IT_WBS_ITEMS (template)
    "------------------------------------------------------------

    DATA: lt_created_items TYPE tt_wbs_items,
          lv_plan_ok       TYPE abap_bool,
          lv_blkd_ok       TYPE abap_bool,
          lv_cj30_ok       TYPE abap_bool,
          lv_im52_ok       TYPE abap_bool,
          lv_auc_ok        TYPE abap_bool,
          lv_rel_ok        TYPE abap_bool.

    "Convert generic et_wbs_created -> typed table (if your et_wbs_created is STANDARD TABLE generic)
    lt_created_items = CORRESPONDING #( lt_wbs_created ).

    "NOTE: your assign_plan_values currently CONTINUE when WERT2 IS INITIAL,
    "so 0.00 will still be treated as initial. Keep this only if you want DB consistency.
    LOOP AT lt_created_items ASSIGNING FIELD-SYMBOL(<ls_ci>).
      IF <ls_ci>-wert2 IS INITIAL.
        <ls_ci>-wert2 = 0.
      ENDIF.
    ENDLOOP.

    lv_plan_ok = assign_plan_values(
      is_header    = is_header
      it_wbs_items = lt_created_items
    ).

    lv_cj30_ok = assign_budget_cj30(
      is_header    = is_header
      it_wbs_items = lt_created_items
    ).
    COMMIT WORK AND WAIT.
    WAIT UP TO 2 SECONDS.


    lv_blkd_ok = set_blkd_status_for_higher_wbs(
      it_wbs_items = lt_created_items
    ).

    release_project_cj02(
    iv_pspid = lv_pspid_char
    ).

    rv_success = abap_true.

*    IF create_wbs_elements( EXPORTING is_header      = is_header
*                                      it_wbs_items   = it_wbs_items
*                           ) = abap_true.
*      rv_success = abap_true.
*
*    ELSE.
*      MESSAGE e025(zcj00).
*      RETURN.
*    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->CREATE_WBS_ELEMENTS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        STANDARD TABLE
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD create_wbs_elements.
*&---------------------------------------------------------------------*
*& METHOD: CREATE_WBS_ELEMENTS
*& Creates Project Definition + WBS Elements based on template structure
*& Reference: FORM wbs_request_create + check_prps_create pattern
*&---------------------------------------------------------------------*

    DATA: lv_pspid          TYPE ps_pspid,
          lv_pspid_proj     TYPE ps_pspid,
          ls_wbs            TYPE ztb_a2r_wbsitem,
          ls_wbs_temp       TYPE ztb_a2r_wbsitem,
          ls_wbs_created    TYPE ztb_a2r_wbsitem,
          lt_wbs_created    TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
          lt_wbs_sorted     TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
          lt_return         TYPE TABLE OF bapiret2,
          ls_return         TYPE bapiret2,
          lv_backward_index TYPE i,
          lt_wbs_celement   TYPE TABLE OF bapi_bus2054_new,
          ls_wbs_celement   TYPE bapi_bus2054_new,
          lt_extensionin    TYPE TABLE OF bapiparex,
          ls_extensionin    TYPE bapiparex,
          ls_te_wbs         TYPE bapi_te_wbs_element,
          lv_level1_pspnr   TYPE ps_pspnr,
          lv_waers          TYPE waers,
          lv_upper_level    TYPE ps_posid,
          lv_left_level     TYPE ps_posid,
          lv_index          TYPE i,
          lv_error          TYPE char1,
          ls_project_new    TYPE bapi_bus2001_new,
          lv_mode           TYPE c VALUE 'N',  " Changed to 'A' for debugging
          lv_update         TYPE c VALUE 'S'   " Synchronous
          .

    rv_success = abap_false.
    CLEAR lv_error.
    DATA: lv_vkokr      TYPE kokrs,
          lv_pspnr      TYPE ps_spsnr,
          lv_posid      TYPE ps_posid,
          lv_vkokr_char TYPE char24,
          lv_posid_db   TYPE ps_posid.

    "1) Header value
    lv_vkokr = is_header-vkokr.

    "2) If missing -> read from Z table items
    IF lv_vkokr IS INITIAL.

      "Prefer VKOKR directly if your Z table has it
      SELECT SINGLE vkokr
        INTO @lv_vkokr
        FROM ztb_a2r_wbsitem
        WHERE zreq_num = @is_header-zreq_num
          AND vkokr    IS NOT NULL
          AND vkokr    <> ''.

    ENDIF.

    "3) If still missing -> derive via PRPSS using POSNR from Z table
    IF lv_vkokr IS INITIAL.

      SELECT SINGLE posnr
        INTO @lv_pspnr
        FROM ztb_a2r_wbsitem
        WHERE zreq_num = @is_header-zreq_num
          AND posnr    IS NOT NULL
          AND posnr    <> ''.

      IF lv_pspnr IS NOT INITIAL.
        SELECT SINGLE pkokr
          INTO lv_vkokr
          FROM prpss
          WHERE pspnr = lv_pspnr.
      ENDIF.

    ENDIF.

    "4) If still missing -> derive via PRPS->PRPSS using POSID from Z table
    IF lv_vkokr IS INITIAL.

      SELECT SINGLE posid
        INTO @lv_posid
        FROM ztb_a2r_wbsitem
        WHERE zreq_num = @is_header-zreq_num
          AND posid    IS NOT NULL
          AND posid    <> ''.

      IF lv_posid IS NOT INITIAL.

        lv_posid_db = lv_posid.

        "Normalize POSID if stored without dots
        TRY.
            CALL FUNCTION 'CONVERSION_EXIT_ABPSP_INPUT'
              EXPORTING
                input  = lv_posid_db
              IMPORTING
                output = lv_posid_db.
          CATCH cx_root.
        ENDTRY.

        "Get PSPNR from PRPS then get KOKRS from PRPSS
        CLEAR lv_pspnr.
        SELECT SINGLE pspnr
          INTO lv_pspnr
          FROM prps
          WHERE posid = lv_posid_db.

        IF lv_pspnr IS NOT INITIAL.
          SELECT SINGLE pkokr
            INTO lv_vkokr
            FROM prpss
            WHERE pspnr = lv_pspnr.
        ENDIF.

      ENDIF.

    ENDIF.


    "═══════════════════════════════════════════════════════════════════
    " STEP 1: GET NEXT PROJECT NUMBER
    "═══════════════════════════════════════════════════════════════════
    lv_pspid = get_next_project_number( is_header-profl ).

    IF lv_pspid IS INITIAL.
      MESSAGE e029(zcj00) WITH 'Failed to get project number'.
      RETURN.
    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 2: GET CURRENCY FROM COMPANY CODE
    "═══════════════════════════════════════════════════════════════════
    SELECT SINGLE waers FROM t001
      INTO lv_waers
      WHERE bukrs = is_header-bukrs.

    IF sy-subrc <> 0.
      lv_waers = 'USD'.
    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 3: INITIALIZE BAPI
    "═══════════════════════════════════════════════════════════════════
    CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

    "═══════════════════════════════════════════════════════════════════
    " STEP 4: CREATE PROJECT DEFINITION (Level 1)
    " Reference: FORM check_proj_create
    "═══════════════════════════════════════════════════════════════════
    CLEAR ls_project_new.

    " Use the generated project number
    ls_project_new-project_definition = lv_pspid.

    " Map from header (following reference pattern)
    ls_project_new-description        = is_header-post1.
    ls_project_new-company_code       = is_header-bukrs.
    ls_project_new-controlling_area   = lv_vkokr.
    ls_project_new-profit_ctr         = is_header-prctr.
    ls_project_new-start              = sy-datum. "date today
    ls_project_new-finish             = is_header-plsez.
    ls_project_new-fcst_start         = sy-datum. "date today
    ls_project_new-fcst_finish        = is_header-plsez.
    ls_project_new-plant              = is_header-werks.
    ls_project_new-project_profile    = is_header-profl.
    ls_project_new-responsible_no     = is_header-vernr.
    ls_project_new-project_currency   = lv_waers.

    " Optional fields from reference
    IF is_header-vkokr IS NOT INITIAL.
      ls_project_new-controlling_area = lv_vkokr.
    ENDIF.

    " Create Project Definition via BAPI
    CALL FUNCTION 'BAPI_BUS2001_CREATE'
      EXPORTING
        i_project_definition = ls_project_new
      TABLES
        et_return            = lt_return.

    LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'EA'.
      lv_error = 'X'.
      EXIT.
    ENDLOOP.

    IF lv_error = 'X'.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
      MESSAGE e029(zcj00) WITH 'Project creation failed'.
      RETURN.
    ENDIF.


    "═══════════════════════════════════════════════════════════════════
    " STEP 5: BUILD WBS ELEMENTS FROM TEMPLATE STRUCTURE
    " Reference: FORM check_prps_create
    " Critical: Maintain template hierarchy and naming from IT_WBS_ITEMS
    "═══════════════════════════════════════════════════════════════════
    DATA lv_level1_assigned TYPE abap_bool VALUE abap_false.
    " Sort by STUFE DESCENDING (reference pattern)
    lt_wbs_sorted = it_wbs_items.
    SORT lt_wbs_sorted BY stufe DESCENDING posid DESCENDING.
    CLEAR: lt_wbs_celement, lt_extensionin.

    LOOP AT lt_wbs_sorted INTO ls_wbs.

      " Skip Level 1 (already created as project definition)
      IF ls_wbs-stufe = 1.
        CONTINUE.
      ENDIF.

      " Skip items without budget
      IF ls_wbs-wert2 IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR: ls_wbs_celement, ls_te_wbs, lv_upper_level, lv_left_level.
      lv_index = sy-tabix + 1.

      "───────────────────────────────────────────────────────────────
      " WBS ELEMENT ID: Critical - Build from new project number + template suffix
      " Template: PC.000003.00, PC.000003.00.1, PC.000003.00.2, etc.
      " New:      PC.000011.00, PC.000011.00.1, PC.000011.00.2, etc.
      "───────────────────────────────────────────────────────────────

      " Extract suffix from template POSID
      " Template POSID format: PC.000003.00.1
      " We need: .00.1 part
      DATA: lv_template_posid TYPE ps_posid,
            lv_new_posid      TYPE ps_posid,
            lv_suffix         TYPE string,
            lv_template_len   TYPE i,
            lv_project_len    TYPE i.

      lv_template_posid = ls_wbs-posid.

      " Find where project number ends in template
      " Template project should be in STUFE = 1 item or from COPY_TEMPLATE_STRUCTURE
      " Assuming template format: PC.NNNNNN.XX.Y where PC.NNNNNN is project
      " and .XX.Y is WBS hierarchy suffix

      " Simple approach: Replace template project ID with new project ID
      " Template: PC.000003.00.1 → Find 'PC.000003' and replace with new 'PC.000011'

      " Get template project ID (should be first 9 or 10 chars depending on format)
      " For safety, we'll use the Level 1 WBS POSID as template project
      DATA: lv_template_project TYPE ps_pspid.

      " Read Level 1 from sorted list to get template project ID
      READ TABLE lt_wbs_sorted INTO DATA(ls_level1) WITH KEY stufe = 1.
      IF sy-subrc = 0.
        lv_template_project = ls_level1-posid.
      ELSE.
        " Fallback: Extract from first Level 2 WBS
        " Format: PC.000003.00 → Extract PC.000003
        IF strlen( lv_template_posid ) >= 10.
          lv_template_project = lv_template_posid(10).  " 'PC.000003'
        ENDIF.
      ENDIF.

      " Build new WBS POSID by replacing template project with new project
      IF lv_template_project IS NOT INITIAL AND
         lv_template_posid CS lv_template_project.

        " Replace template project ID with new project ID
        lv_new_posid = lv_template_posid.
        REPLACE lv_template_project IN lv_new_posid WITH lv_pspid.

      ELSE.
        " Fallback: Use template POSID as-is (shouldn't happen)
        lv_new_posid = lv_template_posid.
      ENDIF.

      ls_wbs_celement-wbs_element = lv_new_posid.

      CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
        EXPORTING
          input  = lv_new_posid
        IMPORTING
          output = lv_new_posid.

      ls_wbs_celement-wbs_element = lv_new_posid.

      "───────────────────────────────────────────────────────────────
      " BASIC FIELDS (Reference: check_prps_create)
      "───────────────────────────────────────────────────────────────
      ls_wbs_celement-description      = ls_wbs-post1.
      ls_wbs_celement-company_code     = is_header-bukrs.
*    ls_wbs_celement-business_area    = is_header-bukrs.
*    ls_wbs_celement-controlling_area = is_header-bukrs(4).
      ls_wbs_celement-profit_ctr       = is_header-prctr.
      ls_wbs_celement-plant            = is_header-werks.

      "───────────────────────────────────────────────────────────────
      " PLANNING & INVESTMENT FIELDS
      "───────────────────────────────────────────────────────────────
      ls_wbs_celement-wbs_planning_element = abap_true.
      ls_wbs_celement-inv_reason           = is_header-izwek.
*    ls_wbs_celement-invest_profile       = ls_wbs-imprf.
      ls_wbs_celement-respsbl_cctr         = ls_wbs-kostl.
      ls_wbs_celement-responsible_no       = is_header-vernr.

      "───────────────────────────────────────────────────────────────
      " DATES
      "───────────────────────────────────────────────────────────────
      ls_wbs_celement-wbs_basic_start_date     = is_header-plfaz.
      ls_wbs_celement-wbs_basic_finish_date    = is_header-plsez.
      ls_wbs_celement-wbs_forecast_start_date  = is_header-plfaz.
      ls_wbs_celement-wbs_forecast_finish_date = is_header-plsez.

*    " Applicant numbers from reference
*    IF is_header-vernr IS NOT INITIAL.
*      ls_wbs_celement-applicant_no = is_header-vernr.
*    ENDIF.

      "───────────────────────────────────────────────────────────────
      " ACCOUNT ASSIGNMENT
      "───────────────────────────────────────────────────────────────
      ls_wbs_celement-wbs_account_assignment_element = abap_true.

      "───────────────────────────────────────────────────────────────
      " HIERARCHY: WBS_UP and WBS_LEFT (CRITICAL - Reference pattern)
      "───────────────────────────────────────────────────────────────

      " Find UPPER level (parent) - same logic with new project ID
      DATA: lv_parent_template TYPE ps_posid,
            lv_parent_new      TYPE ps_posid.
      "---------------------------------------------------
      " Find UPPER level (parent) - CORRECT LOGIC
      "---------------------------------------------------
      CLEAR lv_upper_level.

      DATA(lv_back_index) = sy-tabix - 1.

      WHILE lv_back_index > 0.
        READ TABLE lt_wbs_sorted INTO ls_wbs_temp INDEX lv_back_index.
        IF sy-subrc <> 0.
          EXIT.
        ENDIF.

        IF ls_wbs_temp-stufe < ls_wbs-stufe.

          IF ls_wbs_temp-stufe = 1.
            " Parent is project
            lv_upper_level = lv_pspid.
          ELSE.
            " Parent is another WBS
            lv_parent_new = ls_wbs_temp-posid.
            REPLACE lv_template_project IN lv_parent_new WITH lv_pspid.
            lv_upper_level = lv_parent_new.
          ENDIF.

          EXIT.
        ENDIF.

        lv_back_index = lv_back_index - 1.
      ENDWHILE.

      " Find LEFT level (left sibling) - same logic
      CLEAR lv_left_level.
      DATA: lv_search_index TYPE i.
      lv_search_index = sy-tabix + 1.

      LOOP AT lt_wbs_sorted INTO ls_wbs_temp FROM lv_search_index.
        IF lv_left_level IS INITIAL AND
           ls_wbs_temp-stufe = ls_wbs-stufe.
          " Found left sibling
          DATA: lv_left_template TYPE ps_posid,
                lv_left_new      TYPE ps_posid.

          lv_left_template = ls_wbs_temp-posid.
          lv_left_new = lv_left_template.

          IF lv_template_project IS NOT INITIAL.
            REPLACE lv_template_project IN lv_left_new WITH lv_pspid.
          ENDIF.

          lv_left_level = lv_left_new.
          EXIT.
        ENDIF.
      ENDLOOP.

      " Set hierarchy pointers
      "---------------------------------------------------
      " Convert and assign WBS_ELEMENT
      "---------------------------------------------------
      CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
        EXPORTING
          input  = lv_new_posid
        IMPORTING
          output = ls_wbs_celement-wbs_element.

      "---------------------------------------------------
      " Convert and assign WBS_UP
      "---------------------------------------------------
      IF lv_upper_level IS NOT INITIAL.
        CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
          EXPORTING
            input  = lv_upper_level
          IMPORTING
            output = ls_wbs_celement-wbs_up.
      ENDIF.

      "---------------------------------------------------
      " Convert and assign WBS_LEFT
      "---------------------------------------------------
      IF lv_left_level IS NOT INITIAL.
        CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
          EXPORTING
            input  = lv_left_level
          IMPORTING
            output = ls_wbs_celement-wbs_left.
      ENDIF.
                                                            "ev92123
      DATA(lv_child) = ls_wbs_celement-wbs_element.
      DATA(lv_pos)   = 0.
      FIND ALL OCCURRENCES OF '.' IN lv_child MATCH OFFSET lv_pos.
      IF sy-subrc = 0.
        ls_wbs_celement-wbs_up = lv_child(lv_pos).
      ELSE.
        ls_wbs_celement-wbs_up = ''.
      ENDIF.
                                                            "ev92123
      APPEND ls_wbs_celement TO lt_wbs_celement.

      "───────────────────────────────────────────────────────────────
      " EXTENSION FIELDS (Reference pattern)STEP 6
      "───────────────────────────────────────────────────────────────
      IF ls_wbs-stufe = 2 AND is_header-zunifier_proj = 'X'.
        CLEAR: ls_te_wbs, ls_extensionin.

        ls_te_wbs-wbs_element   = ls_wbs_celement-wbs_element.
        ls_te_wbs-zunifier_proj = 'X'.

        ls_extensionin-structure  = 'BAPI_TE_WBS_ELEMENT'.
        ls_extensionin-valuepart1 = ls_te_wbs.
        ls_extensionin-valuepart2+49(01) = ls_te_wbs-zunifier_proj.

        APPEND ls_extensionin TO lt_extensionin.
      ENDIF.

    ENDLOOP.

    "═══════════════════════════════════════════════════════════════════
    " STEP 6: CREATE ALL WBS ELEMENTS IN ONE BAPI CALL
    "═══════════════════════════════════════════════════════════════════

    CLEAR lt_wbs_celement.

    " Sort by POSID DESCENDING, STUFE DESCENDING
    lt_wbs_sorted = it_wbs_items.
    SORT lt_wbs_sorted BY posid ASCENDING stufe ASCENDING.

    LOOP AT lt_wbs_sorted INTO ls_wbs.

      IF ls_wbs-wert2 IS INITIAL.
        CONTINUE.
      ENDIF.

      " CLEAR ALL variables including work variables
      CLEAR: ls_wbs_celement,
             ls_te_wbs,
             lv_upper_level,
             lv_left_level,
             lv_left_new,
             lv_parent_new,
             lv_backward_index.

      lv_index = sy-tabix + 1.

      "───────────────────────────────────────────────────────────────
      " WBS ELEMENT ID
      "───────────────────────────────────────────────────────────────

      lv_template_posid = ls_wbs-posid.

      " Get template project ID (Level 1)
      READ TABLE lt_wbs_sorted INTO ls_level1 WITH KEY stufe = 1.
      IF sy-subrc = 0.
        lv_template_project = ls_level1-posid.
      ENDIF.

      " Build new WBS POSID
      IF ls_wbs-stufe = 1.
        lv_new_posid = lv_pspid.
        REPLACE ALL OCCURRENCES OF '.' IN lv_new_posid WITH ''.
      ELSE.
        IF lv_template_project IS NOT INITIAL AND
           lv_template_posid CS lv_template_project.
          lv_new_posid = lv_template_posid.
          REPLACE lv_template_project IN lv_new_posid WITH lv_pspid.
        ELSE.
          lv_new_posid = lv_template_posid.
        ENDIF.
        REPLACE ALL OCCURRENCES OF '.' IN lv_new_posid WITH ''.
      ENDIF.

      ls_wbs_celement-wbs_element = lv_new_posid.

      "───────────────────────────────────────────────────────────────
      " BASIC FIELDS
      "───────────────────────────────────────────────────────────────
      ls_wbs_celement-description      = ls_wbs-post1.
      ls_wbs_celement-company_code     = is_header-bukrs.
      ls_wbs_celement-profit_ctr       = is_header-prctr.
      ls_wbs_celement-controlling_area = is_header-vkokr.
      ls_wbs_celement-plant            = is_header-werks.

      ls_wbs_celement-wbs_planning_element = abap_true.
      ls_wbs_celement-inv_reason           = is_header-izwek.

      IF ls_wbs-stufe = 1.
        ls_wbs_celement-invest_profile = ls_wbs-imprf.
      ELSE.
        CLEAR ls_wbs_celement-invest_profile.
      ENDIF.

      ls_wbs_celement-respsbl_cctr   = ls_wbs-kostl.
      ls_wbs_celement-inv_reason     = is_header-izwek.
      ls_wbs_celement-responsible_no = is_header-vernr.

      ls_wbs_celement-wbs_basic_start_date     = is_header-plfaz.
      ls_wbs_celement-wbs_basic_finish_date    = is_header-plsez.
      ls_wbs_celement-wbs_forecast_start_date  = is_header-plfaz.
      ls_wbs_celement-wbs_forecast_finish_date = is_header-plsez.

      ls_wbs_celement-wbs_account_assignment_element = abap_true.

      "───────────────────────────────────────────────────────────────
      " HIERARCHY: WBS_UP and WBS_LEFT
      "───────────────────────────────────────────────────────────────

      "------------------------------------------------------------
      " WBS_LEFT: Search FORWARD for same-level sibling
      "   from the next row after current (lv_index + 1) to the end
      "------------------------------------------------------------
      DATA: lv_forward_index TYPE sy-tabix.

      CLEAR: lv_left_new, lv_left_level.
      lv_forward_index = lv_index + 1.

      WHILE lv_forward_index <= lines( lt_wbs_sorted ).
        READ TABLE lt_wbs_sorted INDEX lv_forward_index INTO ls_wbs_temp.
        IF sy-subrc = 0 AND ls_wbs_temp-stufe = ls_wbs-stufe.

          " Found the next sibling - rebuild with new project id
          lv_left_new = ls_wbs_temp-posid.
          IF lv_template_project IS NOT INITIAL.
            REPLACE lv_template_project IN lv_left_new WITH lv_pspid.
          ENDIF.
          REPLACE ALL OCCURRENCES OF '.' IN lv_left_new WITH ''.
          lv_left_level = lv_left_new.
          EXIT.

        ENDIF.
        lv_forward_index = lv_forward_index + 1.
      ENDWHILE.


      "------------------------------------------------------------
      " WBS_UP: Search BACKWARD for parent (nearest upper level)
      "   from the previous row (lv_index - 1) up to the top
      "------------------------------------------------------------

      CLEAR: lv_parent_new, lv_upper_level.
      lv_backward_index = lv_index - 1.

      WHILE lv_backward_index >= 1.
        READ TABLE lt_wbs_sorted INDEX lv_backward_index INTO ls_wbs_temp.
        IF sy-subrc = 0 AND ls_wbs_temp-stufe < ls_wbs-stufe.

          IF ls_wbs_temp-stufe = 1.
            lv_parent_new = lv_pspid.
          ELSE.
            lv_parent_new = ls_wbs_temp-posid.
            IF lv_template_project IS NOT INITIAL.
              REPLACE lv_template_project IN lv_parent_new WITH lv_pspid.
            ENDIF.
          ENDIF.

          REPLACE ALL OCCURRENCES OF '.' IN lv_parent_new WITH ''.
          lv_upper_level = lv_parent_new.
          EXIT.

        ENDIF.
        lv_backward_index = lv_backward_index - 1.
      ENDWHILE.


      " Set results to the current element
      ls_wbs_celement-wbs_up   = lv_upper_level.
      ls_wbs_celement-wbs_left = lv_left_level.
      CLEAR: ls_wbs_celement-wbs_left, lv_left_level.
      APPEND ls_wbs_celement TO lt_wbs_celement.

      "───────────────────────────────────────────────────────────────
      " EXTENSION FIELDS
      "───────────────────────────────────────────────────────────────
      IF ls_wbs-stufe = 2 AND is_header-zunifier_proj = 'X'.
        CLEAR: ls_te_wbs, ls_extensionin.

        ls_te_wbs-wbs_element   = lv_new_posid.
        ls_te_wbs-zunifier_proj = 'X'.

        ls_extensionin-structure  = 'BAPI_TE_WBS_ELEMENT'.
        ls_extensionin-valuepart1 = ls_te_wbs.
        ls_extensionin-valuepart2+49(01) = ls_te_wbs-zunifier_proj.

        APPEND ls_extensionin TO lt_extensionin.
      ENDIF.

    ENDLOOP.

    " Create ALL WBS elements in ONE BAPI call
    IF lt_wbs_celement IS NOT INITIAL OR NOT lt_extensionin IS INITIAL.

      CLEAR lt_return.

      CALL FUNCTION 'BAPI_BUS2054_CREATE_MULTI'
        EXPORTING
          i_project_definition = lv_pspid
        TABLES
          it_wbs_element       = lt_wbs_celement
          et_return            = lt_return
          extensionin          = lt_extensionin.

      LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'EA'.
        lv_error = 'X'.
        EXIT.
      ENDLOOP.

      IF lv_error = 'X'.
        MESSAGE e029(zcj00) WITH 'WBS creation failed'.
        RETURN.
      ENDIF.

    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 7: PRE-COMMIT (Call ONCE after all WBS created)
    "═══════════════════════════════════════════════════════════════════
    CLEAR lt_return.

    CALL FUNCTION 'BAPI_PS_PRECOMMIT'
      TABLES
        et_return = lt_return.

    LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'EA'.
      lv_error = 'X'.
      EXIT.
    ENDLOOP.

    IF lv_error = 'X'.
      MESSAGE e029(zcj00) WITH 'WBS prrecommit failed'.
      RETURN.
    ENDIF.
    "═══════════════════════════════════════════════════════════════════
    " STEP 8: COMMIT WORK
    "═══════════════════════════════════════════════════════════════════

    CLEAR ls_return.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait   = 'X'
      IMPORTING
        return = ls_return.

    IF ls_return-type CA 'EA'.
      MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
        WITH ls_return-message_v1 ls_return-message_v2.
      RETURN.
    ENDIF.

    WAIT UP TO 1 SECONDS.

    "═══════════════════════════════════════════════════════════════════
    " STEP 9: GET CREATED WBS INTERNAL NUMBERS
    "═══════════════════════════════════════════════════════════════════

    " Get project internal number
    SELECT SINGLE pspnr FROM proj
      INTO lv_level1_pspnr
      WHERE pspid = lv_pspid.

    " Build output table with created WBS elements
    LOOP AT it_wbs_items INTO ls_wbs.

      IF ls_wbs-wert2 IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR ls_wbs_created.

      IF ls_wbs-stufe = 1.
        " Level 1 = Project
        ls_wbs_created-posid = lv_pspid.
        ls_wbs_created-posnr = lv_level1_pspnr.
      ELSE.
        " Level 2+ = WBS Element - rebuild POSID with new project number
        DATA: lv_created_posid TYPE ps_posid.

        lv_created_posid = ls_wbs-posid.

        " Replace template project with new project
        READ TABLE lt_wbs_sorted INTO ls_level1 WITH KEY stufe = 1.
        IF sy-subrc = 0.
          REPLACE ls_level1-posid IN lv_created_posid WITH lv_pspid.
        ENDIF.

        ls_wbs_created-posid = lv_created_posid.

        " Get internal number from PRPS
        SELECT SINGLE pspnr FROM prps
          INTO ls_wbs_created-posnr
          WHERE posid = ls_wbs_created-posid.

      ENDIF.

      " Copy other fields
      ls_wbs_created-stufe          = ls_wbs-stufe.
      ls_wbs_created-post1          = ls_wbs-post1.
      ls_wbs_created-kostl          = ls_wbs-kostl.
      ls_wbs_created-wert2          = ls_wbs-wert2.
      ls_wbs_created-zbudget_check  = ls_wbs-zbudget_check.
      ls_wbs_created-imprf          = ls_wbs-imprf.
      ls_wbs_created-prart          = ls_wbs-prart.
      ls_wbs_created-bukrs          = is_header-bukrs.
      ls_wbs_created-werks          = is_header-werks.

      UPDATE ztb_a2r_wbsitem
        SET posid = @ls_wbs_created-posid,
          posnr = @ls_wbs_created-posnr
        WHERE zreq_num = @is_header-zreq_num
          AND posid    = @ls_wbs-posid.


      APPEND ls_wbs_created TO lt_wbs_created.

    ENDLOOP.
    lv_pspid_proj = lv_pspid.
    REPLACE ALL OCCURRENCES OF '.' IN lv_pspid_proj WITH ''.


    SELECT SINGLE pspnr
      FROM proj
      INTO @DATA(lv_proj_pspnr)
      WHERE pspid = @lv_pspid_proj.

    "═══════════════════════════════════════════════════════════════════
    " STEP 10: UPDATE HEADER WITH PROJECT NUMBER
    "═══════════════════════════════════════════════════════════════════
    UPDATE ztb_a2r_wbshdr
      SET pspnr = @lv_proj_pspnr,
      pspid = @lv_pspid,
      vkokr = @is_header-vkokr,
      waers = @lv_waers
      WHERE zreq_num = @is_header-zreq_num.

    "═══════════════════════════════════════════════════════════════════
    " STEP 10: ASSIGN INVESTMENT PROGRAM
    " STEP 11: CREATE SETTLEMENT RULES
    "═══════════════════════════════════════════════════════════════════
    DATA: lv_hdr_prnam  TYPE ztb_a2r_wbshdr-prnam,
          lv_prnam      TYPE impr-prnam,
          lv_posnr      TYPE impr-prnam,
          lv_posid_im   TYPE impr-posid,
          lv_gjahr_im   TYPE impr-gjahr,
          lv_parnr_im   TYPE impr-parnr,
          lv_posnr_im   TYPE impr-posnr,
          lv_pspid_char TYPE char24.

    DATA: lt_bdc_cj02 TYPE STANDARD TABLE OF bdcdata,
          lt_msg_cj02 TYPE STANDARD TABLE OF bdcmsgcoll,
          ls_msg_cj02 TYPE bdcmsgcoll.

    DATA: lv_wbs_posid_cj02   TYPE prps-posid,
          lv_cj02_error       TYPE abap_bool,
          lv_try_cj02         TYPE i,
          lv_wbs_posid_cj02_c TYPE fnam_____4,
          lv_pspid_cj02       TYPE ztb_a2r_wbshdr-pspid,
          lv_pspid_cj02_char  TYPE char24,
          lv_pspid_setc_char  TYPE char24,
          lv_posid_char       TYPE char24.

    DATA: lv_assign_ok TYPE abap_bool.

    "------------------------------------------------------------
    "1) Read PRNAM + POSNR from header (you already do this)
    "------------------------------------------------------------
    SELECT SINGLE prnam, posnr, pspid
      INTO (@lv_prnam, @lv_posnr_im, @lv_pspid_cj02)
      FROM ztb_a2r_wbshdr
     WHERE zreq_num = @is_header-zreq_num.

    lv_pspid_cj02_char = lv_pspid_cj02.
    "------------------------------------------------------------
    "2) Call separated CJ02 method
    "------------------------------------------------------------
    lv_assign_ok = me->assign_im_cj02(
      iv_prnam     = lv_prnam
      iv_posnr     = lv_posnr_im
      iv_posid_wbs = lv_pspid_cj02_char
    ).

    lv_pspid_setc_char = lv_pspid_cj02.
    lv_vkokr_char      = lv_vkokr.

    settlement_rule( iv_vkokr = lv_vkokr_char
                     iv_pspid = lv_pspid_setc_char
                     ).

    "------------------------------------------------------------
    " AFTER CJB2 settlement-rule BDC + COMMIT
    " Next step: execute PLAN VALUES (CJ40 via KBPP_EXTERN_UPDATE_CO)
    " IMPORTANT: use lt_wbs_created (created POSID), not IT_WBS_ITEMS (template)
    "------------------------------------------------------------

    DATA: lt_created_items TYPE tt_wbs_items,
          lv_plan_ok       TYPE abap_bool,
          lv_blkd_ok       TYPE abap_bool,
          lv_cj30_ok       TYPE abap_bool,
          lv_im52_ok       TYPE abap_bool,
          lv_auc_ok        TYPE abap_bool,
          lv_rel_ok        TYPE abap_bool.

    "Convert generic lt_wbs_created -> typed table (if your lt_wbs_created is STANDARD TABLE generic)
    lt_created_items = CORRESPONDING #( lt_wbs_created ).

    "NOTE: your assign_plan_values currently CONTINUE when WERT2 IS INITIAL,
    "so 0.00 will still be treated as initial. Keep this only if you want DB consistency.
    LOOP AT lt_created_items ASSIGNING FIELD-SYMBOL(<ls_ci>).
      IF <ls_ci>-wert2 IS INITIAL.
        <ls_ci>-wert2 = 0.
      ENDIF.
    ENDLOOP.

    lv_plan_ok = assign_plan_values(
      is_header    = is_header
      it_wbs_items = lt_created_items
    ).

    lv_cj30_ok = assign_budget_cj30(
      is_header    = is_header
      it_wbs_items = lt_created_items
    ).

*    COMMIT WORK AND WAIT.
*    WAIT UP TO 2 SECONDS.

    lv_blkd_ok = set_blkd_status_for_higher_wbs(
      it_wbs_items = lt_created_items
    ).

    lv_pspid_char = lv_pspid_cj02_char.

    release_project_cj02(
      iv_pspid = lv_pspid_char
    ).

    rv_success = abap_true.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->GET_NEXT_PROJECT_NUMBER
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_PROFL                       TYPE        PROFIDPROJ
* | [<-()] RV_PSPID                       TYPE        PS_PSPID
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_next_project_number.
*&---------------------------------------------------------------------*
*& METHOD: GET_NEXT_PROJECT_NUMBER
*& Uses CN_SUCHE_FREIE_NUMMER exactly like CJ20N "Find Open Number"
*& Reference: Screenshot shows "Find number after last assigned"
*&---------------------------------------------------------------------*

    DATA: lv_template_pspnr TYPE ps_pspnr,
          lv_start_pspid    TYPE ps_pspid,
          lv_proj_exp       TYPE ps_pspid,
          lv_posid_raw      TYPE ps_posid.

    CLEAR rv_pspid.

    "═══════════════════════════════════════════════════════════════════
    " STEP 1: GET STARTING VALUE FROM ZTB_A2R_CONFTAB1
    " (Image 2 shows: Project Profile ZPC0001, PSPNR = 00000008 = PC.000001)
    "═══════════════════════════════════════════════════════════════════

    SELECT SINGLE w~posid
      FROM ztb_a2r_wbsitem AS w
      INNER JOIN ztb_a2r_wbshdr AS h
        ON h~zreq_num = w~zreq_num
      INTO @lv_posid_raw
      WHERE h~profl = @iv_profl    " Project profile parameter
        AND w~stufe = 1.           " Level = 1

    IF sy-subrc <> 0 OR lv_posid_raw IS INITIAL.
      MESSAGE e029(zcj00) WITH 'No template found in ZTB_A2R_CONFTAB1 for profile' iv_profl.
      RETURN.
    ENDIF.

    " Convert internal POSID (PC000001) to external PSPID (PC.000001)
    CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
      EXPORTING
        input  = lv_posid_raw
      IMPORTING
        output = lv_start_pspid.

    IF lv_start_pspid IS INITIAL.
      MESSAGE e029(zcj00) WITH 'Invalid PSPNR in config table' lv_template_pspnr.
      RETURN.
    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 2: CALL CN_SUCHE_FREIE_NUMMER
    " Image 1 shows the dialog with:
    "   Start value: PC.000001
    "   Finish value: PC.999999
    "   Strategy: "Find number after last assigned" (selected)
    "   Proposed: PC.000011
    "═══════════════════════════════════════════════════════════════════

    CALL FUNCTION 'CN_SUCHE_FREIE_NUMMER'
      EXPORTING
        search_imp      = '1'              " 1 = Project definition search
        proj_s_imp      = lv_start_pspid   " Start value from config (PC.000001)
        refresh         = 'X'              " Refresh buffer
        no_dialog       = 'X'              " ← CRITICAL: No popup dialog
      IMPORTING
        proj_exp        = lv_proj_exp      " Returns next available (e.g., PC.000011)
      EXCEPTIONS
        wrong_search    = 1
        search_canceled = 2
        OTHERS          = 3.

    "═══════════════════════════════════════════════════════════════════
    " STEP 3: ERROR HANDLING
    "═══════════════════════════════════════════════════════════════════

    IF sy-subrc <> 0.

      CASE sy-subrc.
        WHEN 1.
          MESSAGE e029(zcj00) WITH 'CN_SUCHE_FREIE_NUMMER: Wrong search type'.
        WHEN 2.
          MESSAGE e029(zcj00) WITH 'CN_SUCHE_FREIE_NUMMER: Search canceled by user'.
        WHEN OTHERS.
          MESSAGE e029(zcj00) WITH 'CN_SUCHE_FREIE_NUMMER failed' sy-subrc.
      ENDCASE.

      RETURN.

    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 4: VALIDATE OUTPUT
    "═══════════════════════════════════════════════════════════════════

    IF lv_proj_exp IS INITIAL.
      MESSAGE e029(zcj00) WITH 'CN_SUCHE_FREIE_NUMMER returned empty project number'.
      RETURN.
    ENDIF.

    " Double-check that returned number doesn't already exist
    SELECT SINGLE pspid FROM proj
      INTO @DATA(lv_exists)
      WHERE pspid = @lv_proj_exp.

    IF sy-subrc = 0.
      MESSAGE e029(zcj00) WITH 'Generated project' lv_proj_exp 'already exists!'.
      RETURN.
    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 5: RETURN PROPOSED VALUE
    "═══════════════════════════════════════════════════════════════════

    rv_pspid = lv_proj_exp.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->GET_NEXT_REQUEST_NUMBER
* +-------------------------------------------------------------------------------------------------+
* | [<-()] RV_REQNUM                      TYPE        CHAR10
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_next_request_number.

    DATA: lv_request TYPE char10.

    CLEAR rv_reqnum.

    " Get next request number from number range
    CALL FUNCTION 'NUMBER_GET_NEXT'
      EXPORTING
        nr_range_nr             = '01'
        object                  = 'ZCJ00_REQN'    " Use FDS object name
        quantity                = '1'
        toyear                  = '0000'          " Important: same as old system
      IMPORTING
        number                  = lv_request
      EXCEPTIONS
        interval_not_found      = 1
        number_range_not_intern = 2
        object_not_found        = 3
        quantity_is_0           = 4
        quantity_is_not_1       = 5
        interval_overflow       = 6
        buffer_overflow         = 7
        OTHERS                  = 8.

    IF sy-subrc = 0.
      rv_reqnum = lv_request.
    ELSE.
      " Enhanced error handling
      CASE sy-subrc.
        WHEN 1.
          MESSAGE 'Number range interval not found' TYPE 'I' DISPLAY LIKE 'E'.
        WHEN 2.
          MESSAGE 'Number range is not internal' TYPE 'I' DISPLAY LIKE 'E'.
        WHEN 3.
          MESSAGE 'Number range object ZCJ00_REQN not found. Create in SNRO' TYPE 'I' DISPLAY LIKE 'E'.
        WHEN OTHERS.
          MESSAGE 'Error getting request number' TYPE 'I' DISPLAY LIKE 'E'.
      ENDCASE.
      CLEAR rv_reqnum.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->SAVE_REQUEST
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        TT_WBS_ITEMS
* | [<-()] RV_REQNUM                      TYPE        CHAR10
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD save_request.

    DATA: ls_header TYPE ztb_a2r_wbshdr,
          ls_item   TYPE ztb_a2r_wbsitem,
          ls_wbs    TYPE ztb_a2r_wbsitem,
          lv_error  TYPE abap_bool.

    CLEAR: rv_reqnum, lv_error.

    " Get request number ONLY if not already assigned
    IF is_header-zreq_num IS INITIAL.
      rv_reqnum = get_next_request_number( ).

      IF rv_reqnum IS INITIAL.
        " Error message already displayed by get_next_request_number
        RETURN.
      ENDIF.
    ELSE.
      " Re-saving existing request (update scenario)
      rv_reqnum = is_header-zreq_num.
    ENDIF.

    SELECT SINGLE gjahr
      FROM impr
      INTO @DATA(lv_gjahr)
      WHERE posnr = @is_header-posnr
      AND prnam = @is_header-prnam.

    SELECT SINGLE posnr, gjahr
    FROM impr
    INTO @DATA(ls_impr)
     WHERE posnr = @is_header-posnr
        AND prnam = @is_header-prnam.
    IF sy-subrc EQ 0.
      ls_header-gjahr = ls_impr-gjahr.
    ENDIF.

    " Prepare header with correct field mapping
    CLEAR ls_header.
    ls_header-mandt = sy-mandt.
    ls_header-zreq_num = rv_reqnum.


    " FDS Table 4.1.7 field mapping
    ls_header-posnr = is_header-posnr.              " IM Program Position
    ls_header-prnam = is_header-prnam.              " IM Program
    ls_header-pspnr = is_header-pspnr.              " Project ID (populated after creation)
    ls_header-post1 = is_header-post1.              " Description
    ls_header-vernr = is_header-vernr.              " Person Responsible
    ls_header-plsez = is_header-plsez.              " Finish Date
    ls_header-bukrs = is_header-bukrs.              " Company Code
    ls_header-werks = is_header-werks.              " Plant
    ls_header-waers = is_header-waers.              " Currency
    ls_header-prctr = is_header-prctr.              " Profit Center
    ls_header-kostl = is_header-kostl.              " Cost Center
    ls_header-gjahr = ls_impr-gjahr.                " Approval Year
    ls_header-izwek = is_header-izwek.              " Investment Reason
    ls_header-zunifier_proj = is_header-zunifier_proj.  " GE Ariba Flag
    ls_header-usr008 = is_header-usr008.            " CAR Approval Date
    ls_header-profl = is_header-profl.              " Project Profile
    ls_header-z_reqtype = is_header-z_reqtype.      " Request Type
    ls_header-gjahr = lv_gjahr.

    " Status and audit fields (similar to old system pattern)
    IF is_header-zreq_num IS INITIAL.
      " New request
      ls_header-ernam = sy-uname.                   " Created by
      ls_header-erdat = sy-datum.                   " Created on
      ls_header-request_status = 'DRAFT'.           " DRAFT status
    ELSE.
      " Existing request being updated
      ls_header-ernam = is_header-ernam.            " Keep original creator
      ls_header-erdat = is_header-erdat.            " Keep original date
      ls_header-request_status = 'DRAFT'.           " DRAFT status
      " Add change tracking if fields exist:
      " ls_header-changed_by = sy-uname.
      " ls_header-changed_on = sy-datum.
    ENDIF.

    " Optional fields
    IF is_header-z_remarks IS NOT INITIAL.
      ls_header-z_remarks = is_header-z_remarks.
    ENDIF.

    " Validate mandatory fields
    IF ls_header-posnr IS INITIAL.
      MESSAGE 'IM Program Position is mandatory' TYPE 'E'.
      CLEAR rv_reqnum.
      RETURN.
    ENDIF.

*  IF ls_header-bukrs IS INITIAL.
*    MESSAGE 'Company Code is mandatory' TYPE 'E'.
*    CLEAR rv_reqnum.
*    RETURN.
*  ENDIF.
*
*  IF ls_header-profl IS INITIAL.
*    MESSAGE 'Project Profile is mandatory' TYPE 'E'.
*    CLEAR rv_reqnum.
*    RETURN.
*  ENDIF.
*
*  IF ls_header-post1 IS INITIAL.
*    MESSAGE 'Project Description is mandatory' TYPE 'E'.
*    CLEAR rv_reqnum.
*    RETURN.
*  ENDIF.

    " Save with error handling
    TRY.
        " Check if updating or creating new
        IF is_header-zreq_num IS INITIAL.
          " Insert new header
          INSERT ztb_a2r_wbshdr FROM ls_header.
        ELSE.
          " Update existing header
          UPDATE ztb_a2r_wbshdr FROM ls_header.
          IF sy-subrc <> 0.
            " If update failed, try insert (might be new after all)
            INSERT ztb_a2r_wbshdr FROM ls_header.
          ENDIF.
        ENDIF.

        IF sy-subrc = 0.
          " Delete old items if updating
          IF is_header-zreq_num IS NOT INITIAL.
            DELETE FROM ztb_a2r_wbsitem WHERE zreq_num = rv_reqnum.
          ENDIF.

          " Insert/update WBS items
          LOOP AT it_wbs_items INTO ls_wbs.
            CLEAR ls_item.

            " FDS Table 4.1.8 field mapping
            ls_item-mandt = sy-mandt.
            ls_item-zreq_num = rv_reqnum.           " Request Number (Primary Key)
            ls_item-bukrs = ls_header-bukrs.        " Company Code (Primary Key)
            ls_item-posid = ls_wbs-posid.           " WBS Element Code (Primary Key)
            ls_item-stufe = ls_wbs-stufe.           " WBS Level
            ls_item-zstat_tobe = ls_wbs-zstat_tobe. " To be status
            ls_item-post1 = ls_wbs-post1.           " Description
            ls_item-kostl = ls_wbs-kostl.           " Cost Center
            ls_item-wert2 = ls_wbs-wert2.           " Approved Budget
            ls_item-zbudget_check = ls_wbs-zbudget_check.  " Budget Check
            ls_item-imprf = ls_wbs-imprf.           " Investment Profile
            ls_item-prart = ls_wbs-prart.           " Project Type
            ls_item-gjahr = ls_impr-gjahr.          " Approval Year

            IF ls_wbs-posnr IS NOT INITIAL.
              ls_item-posnr = ls_wbs-posnr.         " WBS Internal Number
            ENDIF.

            INSERT ztb_a2r_wbsitem FROM ls_item.

            IF sy-subrc <> 0.
              lv_error = abap_true.
              MESSAGE 'Error saving WBS item' && ls_item-posid TYPE 'I' DISPLAY LIKE 'E'.
              EXIT.
            ENDIF.
          ENDLOOP.

          " Commit or rollback
          IF lv_error = abap_false.
            COMMIT WORK AND WAIT.
            MESSAGE s024(zcj00) WITH rv_reqnum DISPLAY LIKE 'S'.
            CALL TRANSACTION 'ZA2R_ZCJ00'.
          ELSE.
            ROLLBACK WORK.
            CLEAR rv_reqnum.
          ENDIF.

        ELSE.
          MESSAGE 'Error saving header. Check table structure.' TYPE 'E'.
          CLEAR rv_reqnum.
          ROLLBACK WORK.
        ENDIF.

      CATCH cx_sy_sql_error INTO DATA(lx_sql).
        MESSAGE lx_sql->get_text( ) TYPE 'E'.
        CLEAR rv_reqnum.
        ROLLBACK WORK.

      CATCH cx_root INTO DATA(lx_error).
        MESSAGE lx_error->get_text( ) TYPE 'E'.
        CLEAR rv_reqnum.
        ROLLBACK WORK.
    ENDTRY.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->TRIGGER_WORKFLOW
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_L1_APPRV                    TYPE        HPA_T_BNAME(optional)
* | [--->] IT_L2_APPRV                    TYPE        HPA_T_BNAME(optional)
* | [--->] IT_WBSCAR                      TYPE        ZTT_A2R_WBSITEM(optional)
* | [--->] IT_WBSHIER                     TYPE        ZTT_A2R_WBSHIER(optional)
* | [--->] IT_WBSUNCLOSE                  TYPE        ZTT_A2R_WBSUNCLOSE(optional)
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD trigger_workflow.

    DATA: lo_instance TYPE REF TO zcl_a2r_wbs_request_flexwf.

    rv_success = abap_false.

    IF is_header-zreq_num IS INITIAL.
      RETURN.
    ENDIF.

    TRY.
        " trigger wf to create project
        lo_instance = NEW zcl_a2r_wbs_request_flexwf(
          is_header     = is_header
          it_wbscar     = it_wbscar
          it_wbshier    = it_wbshier
          it_wbsunclose = it_wbsunclose
          it_l1approver = it_l1_apprv
          it_l2approver = it_l2_apprv
        ).

        lo_instance->submit( ).

        rv_success = abap_true.

      CATCH cx_root.
        rv_success = abap_false.
    ENDTRY.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->ASSIGN_BUDGET_CJ30
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        TT_WBS_ITEMS
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD assign_budget_cj30.

    DATA: lv_errors_found TYPE oax,
          lt_bpak         TYPE STANDARD TABLE OF bpak,
          lt_wbs_db       TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
          ls_bpak         TYPE bpak,
          ls_wbs_db       TYPE ztb_a2r_wbsitem,
          lv_objnr        TYPE j_objnr,
          lv_waers        TYPE waers,
          lv_version      TYPE bp_version,
          lv_reqtype      TYPE ztb_a2r_wbshdr-z_reqtype,
          lv_delta        TYPE c,
          lv_rollup       TYPE c,
          lt_return       TYPE STANDARD TABLE OF bapiret2,
          lv_posid_db     TYPE ps_posid,
          lv_has_error    TYPE abap_bool.

    rv_success = abap_false.
    CLEAR: lt_bpak, lt_return, lv_errors_found.

    lv_delta = ''.
    lv_rollup = ''.
    lv_version = '000'.

*---------------------------------------------------------------------*
* 1) Get Currency
*---------------------------------------------------------------------*
    SELECT SINGLE waers, z_reqtype
      INTO (@lv_waers, @lv_reqtype)
      FROM ztb_a2r_wbshdr
      WHERE zreq_num = @is_header-zreq_num.

    IF lv_waers IS INITIAL.
      lv_waers = is_header-waers.
    ENDIF.

    IF lv_waers IS INITIAL AND is_header-bukrs IS NOT INITIAL.
      SELECT SINGLE waers
        INTO @lv_waers
        FROM t001
        WHERE bukrs = @is_header-bukrs.
    ENDIF.

    IF lv_waers IS INITIAL.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* 2) Read ONLY flagged WBS from DB
*---------------------------------------------------------------------*
    SELECT *
      FROM ztb_a2r_wbsitem
      INTO TABLE @lt_wbs_db
      WHERE zreq_num      = @is_header-zreq_num
        AND zbudget_check = 'X'
        AND wert2         > 0.

    IF lt_wbs_db IS INITIAL.
      rv_success = abap_true.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* 3) Build BPAK from DB records
*---------------------------------------------------------------------*
    LOOP AT lt_wbs_db INTO ls_wbs_db.

      CLEAR lv_objnr.

      "Convert POSID external -> internal
      lv_posid_db = ls_wbs_db-posid.

      CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
        EXPORTING
          input  = lv_posid_db
        IMPORTING
          output = lv_posid_db
        EXCEPTIONS
          OTHERS = 1.

      SELECT SINGLE objnr
        INTO @lv_objnr
        FROM prps
        WHERE posid = @lv_posid_db.

      IF lv_objnr IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR ls_bpak.
      ls_bpak-e_objnr = lv_objnr.
      ls_bpak-e_versn = lv_version.
      ls_bpak-e_perio = '001'.
      ls_bpak-e_wrttp = '41'.     "CJ30 Budget
      ls_bpak-wert    = ls_wbs_db-wert2.
      ls_bpak-twaer   = lv_waers.

      APPEND ls_bpak TO lt_bpak.

    ENDLOOP.

    IF lt_bpak IS INITIAL.
      rv_success = abap_true.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* 4) Call FM
*---------------------------------------------------------------------*
    CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
      EXPORTING
        i_budget_activity             = 'KBUD'
        i_budget_distribution_allowed = 'X'
        i_delta_amounts               = lv_delta
        i_rollup_data                 = lv_rollup
        i_check_plan_data             = 'X'
        i_application                 = 'P'
        i_commit_all                  = 'X'
      IMPORTING
        e_errors_found                = lv_errors_found
      TABLES
        it_bpak                       = lt_bpak
        it_return                     = lt_return.

    IF sy-subrc <> 0 OR lv_errors_found IS NOT INITIAL.
      rv_success = abap_false.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* 5) Check Return Messages
*---------------------------------------------------------------------*

    LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'AEX'.
      EXIT.
    ENDLOOP.

    IF sy-subrc EQ 0.
      rv_success = abap_false. " Error updating
    ELSE.
      COMMIT WORK AND WAIT.
      WAIT UP TO 2 SECONDS.
      rv_success = abap_true.
    ENDIF.
  ENDMETHOD.


