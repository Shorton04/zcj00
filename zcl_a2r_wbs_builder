* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->GET_NEXT_PROJECT_NUMBER
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_PROFL                       TYPE        PROFIDPROJ
* | [<-()] RV_PSPID                       TYPE        PS_PSPID
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_next_project_number.
*&---------------------------------------------------------------------*
*& METHOD: GET_NEXT_PROJECT_NUMBER
*& Uses CN_SUCHE_FREIE_NUMMER exactly like CJ20N "Find Open Number"
*& Reference: Screenshot shows "Find number after last assigned"
*&---------------------------------------------------------------------*

    DATA: lv_template_pspnr TYPE ps_pspnr,
          lv_start_pspid    TYPE ps_pspid,
          lv_proj_exp       TYPE ps_pspid,
          lv_posid_raw      TYPE ps_posid.

    CLEAR rv_pspid.

    "═══════════════════════════════════════════════════════════════════
    " STEP 1: GET STARTING VALUE FROM ZTB_A2R_CONFTAB1
    " (Image 2 shows: Project Profile ZPC0001, PSPNR = 00000008 = PC.000001)
    "═══════════════════════════════════════════════════════════════════

    SELECT SINGLE w~posid
      FROM ztb_a2r_wbsitem AS w
      INNER JOIN ztb_a2r_wbshdr AS h
        ON h~zreq_num = w~zreq_num
      INTO @lv_posid_raw
      WHERE h~profl = @iv_profl    " Project profile parameter
        AND w~stufe = 1.           " Level = 1

    IF sy-subrc <> 0 OR lv_posid_raw IS INITIAL.
      MESSAGE e029(zcj00) WITH 'No template found in ZTB_A2R_CONFTAB1 for profile' iv_profl.
      RETURN.
    ENDIF.

    " Convert internal POSID (PC000001) to external PSPID (PC.000001)
    CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
      EXPORTING
        input  = lv_posid_raw
      IMPORTING
        output = lv_start_pspid.

    IF lv_start_pspid IS INITIAL.
      MESSAGE e029(zcj00) WITH 'Invalid PSPNR in config table' lv_template_pspnr.
      RETURN.
    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 2: CALL CN_SUCHE_FREIE_NUMMER
    " Image 1 shows the dialog with:
    "   Start value: PC.000001
    "   Finish value: PC.999999
    "   Strategy: "Find number after last assigned" (selected)
    "   Proposed: PC.000011
    "═══════════════════════════════════════════════════════════════════

    CALL FUNCTION 'CN_SUCHE_FREIE_NUMMER'
      EXPORTING
        search_imp      = '1'              " 1 = Project definition search
        proj_s_imp      = lv_start_pspid   " Start value from config (PC.000001)
        refresh         = 'X'              " Refresh buffer
        no_dialog       = 'X'              " ← CRITICAL: No popup dialog
      IMPORTING
        proj_exp        = lv_proj_exp      " Returns next available (e.g., PC.000011)
      EXCEPTIONS
        wrong_search    = 1
        search_canceled = 2
        OTHERS          = 3.

    "═══════════════════════════════════════════════════════════════════
    " STEP 3: ERROR HANDLING
    "═══════════════════════════════════════════════════════════════════

    IF sy-subrc <> 0.

      CASE sy-subrc.
        WHEN 1.
          MESSAGE e029(zcj00) WITH 'CN_SUCHE_FREIE_NUMMER: Wrong search type'.
        WHEN 2.
          MESSAGE e029(zcj00) WITH 'CN_SUCHE_FREIE_NUMMER: Search canceled by user'.
        WHEN OTHERS.
          MESSAGE e029(zcj00) WITH 'CN_SUCHE_FREIE_NUMMER failed' sy-subrc.
      ENDCASE.

      RETURN.

    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 4: VALIDATE OUTPUT
    "═══════════════════════════════════════════════════════════════════

    IF lv_proj_exp IS INITIAL.
      MESSAGE e029(zcj00) WITH 'CN_SUCHE_FREIE_NUMMER returned empty project number'.
      RETURN.
    ENDIF.

    " Double-check that returned number doesn't already exist
    SELECT SINGLE pspid FROM proj
      INTO @DATA(lv_exists)
      WHERE pspid = @lv_proj_exp.

    IF sy-subrc = 0.
      MESSAGE e029(zcj00) WITH 'Generated project' lv_proj_exp 'already exists!'.
      RETURN.
    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 5: RETURN PROPOSED VALUE
    "═══════════════════════════════════════════════════════════════════

    rv_pspid = lv_proj_exp.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->GET_NEXT_REQUEST_NUMBER
* +-------------------------------------------------------------------------------------------------+
* | [<-()] RV_REQNUM                      TYPE        CHAR10
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_next_request_number.

    DATA: lv_request TYPE char10.

    CLEAR rv_reqnum.

    " Get next request number from number range
    CALL FUNCTION 'NUMBER_GET_NEXT'
      EXPORTING
        nr_range_nr             = '01'
        object                  = 'ZCJ00_REQN'    " Use FDS object name
        quantity                = '1'
        toyear                  = '0000'          " Important: same as old system
      IMPORTING
        number                  = lv_request
      EXCEPTIONS
        interval_not_found      = 1
        number_range_not_intern = 2
        object_not_found        = 3
        quantity_is_0           = 4
        quantity_is_not_1       = 5
        interval_overflow       = 6
        buffer_overflow         = 7
        OTHERS                  = 8.

    IF sy-subrc = 0.
      rv_reqnum = lv_request.
    ELSE.
      " Enhanced error handling
      CASE sy-subrc.
        WHEN 1.
          MESSAGE 'Number range interval not found' TYPE 'I' DISPLAY LIKE 'E'.
        WHEN 2.
          MESSAGE 'Number range is not internal' TYPE 'I' DISPLAY LIKE 'E'.
        WHEN 3.
          MESSAGE 'Number range object ZCJ00_REQN not found. Create in SNRO' TYPE 'I' DISPLAY LIKE 'E'.
        WHEN OTHERS.
          MESSAGE 'Error getting request number' TYPE 'I' DISPLAY LIKE 'E'.
      ENDCASE.
      CLEAR rv_reqnum.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->GET_USER_EMAIL
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_UNAME                       TYPE        XUBNAME
* | [<-()] RV_EMAIL                       TYPE        AD_SMTPADR
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_user_email.

    DATA: lv_persnumber TYPE ad_persnum.

    CLEAR rv_email.

    " Get person number from username (HRP1001-SOBID = USR21-BNAME)
    SELECT SINGLE persnumber
      FROM usr21
      INTO @lv_persnumber
      WHERE bname = @iv_uname.

    IF sy-subrc = 0 AND lv_persnumber IS NOT INITIAL.

      " Get email from ADR6 (USR21-PERSNUMBER = ADR6-PERSNUMBER)
      SELECT SINGLE smtp_addr
        FROM adr6
        INTO @rv_email
        WHERE persnumber = @lv_persnumber
          AND flgdefault = 'X'.      " Default email

      " If no default email found, get any email
      IF sy-subrc <> 0.
        SELECT SINGLE smtp_addr
          FROM adr6
          INTO @rv_email
          WHERE persnumber = @lv_persnumber.
      ENDIF.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->SAVE_REQUEST
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        TT_WBS_ITEMS
* | [<-()] RV_REQNUM                      TYPE        CHAR10
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD save_request.

    DATA: ls_header TYPE ztb_a2r_wbshdr,
          ls_item   TYPE ztb_a2r_wbsitem,
          ls_wbs    TYPE ztb_a2r_wbsitem,
          lv_error  TYPE abap_bool.

    CLEAR: rv_reqnum, lv_error.

    " Get request number ONLY if not already assigned
    IF is_header-zreq_num IS INITIAL.
      rv_reqnum = get_next_request_number( ).

      IF rv_reqnum IS INITIAL.
        " Error message already displayed by get_next_request_number
        RETURN.
      ENDIF.
    ELSE.
      " Re-saving existing request (update scenario)
      rv_reqnum = is_header-zreq_num.
    ENDIF.

    " Prepare header with correct field mapping
    CLEAR ls_header.
    ls_header-mandt = sy-mandt.
    ls_header-zreq_num = rv_reqnum.

    " FDS Table 4.1.7 field mapping
    ls_header-posnr = is_header-posnr.              " IM Program Position
    ls_header-prnam = is_header-prnam.              " IM Program
    ls_header-pspnr = is_header-pspnr.              " Project ID (populated after creation)
    ls_header-post1 = is_header-post1.              " Description
    ls_header-vernr = is_header-vernr.              " Person Responsible
    ls_header-plsez = is_header-plsez.              " Finish Date
    ls_header-bukrs = is_header-bukrs.              " Company Code
    ls_header-werks = is_header-werks.              " Plant
    ls_header-prctr = is_header-prctr.              " Profit Center
    ls_header-kostl = is_header-kostl.              " Cost Center
    ls_header-izwek = is_header-izwek.              " Investment Reason
    ls_header-zunifier_proj = is_header-zunifier_proj.  " GE Ariba Flag
    ls_header-usr008 = is_header-usr008.            " CAR Approval Date
    ls_header-profl = is_header-profl.              " Project Profile
    ls_header-z_reqtype = is_header-z_reqtype.      " Request Type

    " Status and audit fields (similar to old system pattern)
    IF is_header-zreq_num IS INITIAL.
      " New request
      ls_header-ernam = sy-uname.                   " Created by
      ls_header-erdat = sy-datum.                   " Created on
      ls_header-request_status = 'DRAFT'.           " DRAFT status
    ELSE.
      " Existing request being updated
      ls_header-ernam = is_header-ernam.            " Keep original creator
      ls_header-erdat = is_header-erdat.            " Keep original date
      " Add change tracking if fields exist:
      " ls_header-changed_by = sy-uname.
      " ls_header-changed_on = sy-datum.
    ENDIF.

    " Optional fields
    IF is_header-z_remarks IS NOT INITIAL.
      ls_header-z_remarks = is_header-z_remarks.
    ENDIF.

    " Validate mandatory fields
    IF ls_header-posnr IS INITIAL.
      MESSAGE 'IM Program Position is mandatory' TYPE 'E'.
      CLEAR rv_reqnum.
      RETURN.
    ENDIF.

*  IF ls_header-bukrs IS INITIAL.
*    MESSAGE 'Company Code is mandatory' TYPE 'E'.
*    CLEAR rv_reqnum.
*    RETURN.
*  ENDIF.
*
*  IF ls_header-profl IS INITIAL.
*    MESSAGE 'Project Profile is mandatory' TYPE 'E'.
*    CLEAR rv_reqnum.
*    RETURN.
*  ENDIF.
*
*  IF ls_header-post1 IS INITIAL.
*    MESSAGE 'Project Description is mandatory' TYPE 'E'.
*    CLEAR rv_reqnum.
*    RETURN.
*  ENDIF.

    " Save with error handling
    TRY.
        " Check if updating or creating new
        IF is_header-zreq_num IS INITIAL.
          " Insert new header
          INSERT ztb_a2r_wbshdr FROM ls_header.
        ELSE.
          " Update existing header
          UPDATE ztb_a2r_wbshdr FROM ls_header.
          IF sy-subrc <> 0.
            " If update failed, try insert (might be new after all)
            INSERT ztb_a2r_wbshdr FROM ls_header.
          ENDIF.
        ENDIF.

        IF sy-subrc = 0.
          " Delete old items if updating
          IF is_header-zreq_num IS NOT INITIAL.
            DELETE FROM ztb_a2r_wbsitem WHERE zreq_num = rv_reqnum.
          ENDIF.

          " Insert/update WBS items
          LOOP AT it_wbs_items INTO ls_wbs.
            CLEAR ls_item.

            " FDS Table 4.1.8 field mapping
            ls_item-mandt = sy-mandt.
            ls_item-zreq_num = rv_reqnum.           " Request Number (Primary Key)
            ls_item-bukrs = ls_header-bukrs.        " Company Code (Primary Key)
            ls_item-posid = ls_wbs-posid.           " WBS Element Code (Primary Key)
            ls_item-stufe = ls_wbs-stufe.           " WBS Level
            ls_item-post1 = ls_wbs-post1.           " Description
            ls_item-kostl = ls_wbs-kostl.           " Cost Center
            ls_item-wert2 = ls_wbs-wert2.           " Approved Budget
            ls_item-zbudget_check = ls_wbs-zbudget_check.  " Budget Check
            ls_item-imprf = ls_wbs-imprf.           " Investment Profile
            ls_item-prart = ls_wbs-prart.           " Project Type

            IF ls_wbs-posnr IS NOT INITIAL.
              ls_item-posnr = ls_wbs-posnr.         " WBS Internal Number
            ENDIF.

            INSERT ztb_a2r_wbsitem FROM ls_item.

            IF sy-subrc <> 0.
              lv_error = abap_true.
              MESSAGE 'Error saving WBS item' && ls_item-posid TYPE 'I' DISPLAY LIKE 'E'.
              EXIT.
            ENDIF.
          ENDLOOP.

          " Commit or rollback
          IF lv_error = abap_false.
            COMMIT WORK AND WAIT.
            MESSAGE s024(zcj00) WITH rv_reqnum DISPLAY LIKE 'S'.
            CALL TRANSACTION 'ZA2R_ZCJ00'.
          ELSE.
            ROLLBACK WORK.
            CLEAR rv_reqnum.
          ENDIF.

        ELSE.
          MESSAGE 'Error saving header. Check table structure.' TYPE 'E'.
          CLEAR rv_reqnum.
          ROLLBACK WORK.
        ENDIF.

      CATCH cx_sy_sql_error INTO DATA(lx_sql).
        MESSAGE lx_sql->get_text( ) TYPE 'E'.
        CLEAR rv_reqnum.
        ROLLBACK WORK.

      CATCH cx_root INTO DATA(lx_error).
        MESSAGE lx_error->get_text( ) TYPE 'E'.
        CLEAR rv_reqnum.
        ROLLBACK WORK.
    ENDTRY.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->SAVE_REQUEST_FOR_SUBMIT
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        TT_WBS_ITEMS
* | [<-()] RV_REQNUM                      TYPE        CHAR10
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD save_request_for_submit.

    DATA: ls_header TYPE ztb_a2r_wbshdr,
          ls_item   TYPE ztb_a2r_wbsitem,
          ls_wbs    TYPE ztb_a2r_wbsitem,
          lv_error  TYPE abap_bool.
    DATA: lv_vkokr TYPE kokrs,
          lv_pspnr TYPE ps_spsnr.

    lv_vkokr = is_header-vkokr.

    IF lv_vkokr IS INITIAL.
      READ TABLE it_wbs_items INTO DATA(ls_any) INDEX 1.
      IF sy-subrc = 0 AND ls_any-posnr IS NOT INITIAL.
        lv_pspnr = ls_any-posnr.

        SELECT SINGLE pkokr
          INTO lv_vkokr
          FROM prpss
          WHERE pspnr = lv_pspnr.
      ENDIF.
    ENDIF.

    CLEAR: rv_reqnum, lv_error.

    "═══════════════════════════════════════════════════════════════════
    " STEP 1: GET REQUEST NUMBER
    "═══════════════════════════════════════════════════════════════════
    IF is_header-zreq_num IS INITIAL.
      rv_reqnum = get_next_request_number( ).
      IF rv_reqnum IS INITIAL.
        RETURN.
      ENDIF.
    ELSE.
      rv_reqnum = is_header-zreq_num.
    ENDIF.
    "═══════════════════════════════════════════════════════════════════
    " STEP 2: PREPARE HEADER
    "═══════════════════════════════════════════════════════════════════
    CLEAR ls_header.
    ls_header-mandt = sy-mandt.
    ls_header-zreq_num = rv_reqnum.
    ls_header-posnr = is_header-posnr.
    ls_header-prnam = is_header-prnam.
    ls_header-pspnr = is_header-pspnr.
    ls_header-post1 = is_header-post1.
    ls_header-vernr = is_header-vernr.
    ls_header-plsez = is_header-plsez.
    ls_header-bukrs = is_header-bukrs.
    ls_header-werks = is_header-werks.
    ls_header-waers = is_header-waers.
    ls_header-prctr = is_header-prctr.
    ls_header-kostl = is_header-kostl.

    ls_header-vkokr = lv_vkokr.
    ls_header-izwek = is_header-izwek.
    ls_header-zunifier_proj = is_header-zunifier_proj.
    ls_header-usr008 = is_header-usr008.
    ls_header-profl = is_header-profl.
    ls_header-z_reqtype = is_header-z_reqtype.


    IF is_header-zreq_num IS INITIAL.
      ls_header-ernam = sy-uname.
      ls_header-erdat = sy-datum.
      ls_header-request_status = 'DRAFT'.
    ELSE.
      ls_header-ernam = is_header-ernam.
      ls_header-erdat = is_header-erdat.
      " Preserve existing status if set
      IF is_header-request_status IS NOT INITIAL.
        ls_header-request_status = is_header-request_status.
      ELSE.
        ls_header-request_status = 'DRAFT'.
      ENDIF.
    ENDIF.

    IF is_header-z_remarks IS NOT INITIAL.
      ls_header-z_remarks = is_header-z_remarks.
    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 3: SAVE TO DATABASE
    "═══════════════════════════════════════════════════════════════════
    TRY.
        " Insert or update header
        IF is_header-zreq_num IS INITIAL.
          INSERT ztb_a2r_wbshdr FROM ls_header.
        ELSE.
          UPDATE ztb_a2r_wbshdr FROM ls_header.
          IF sy-subrc <> 0.
            INSERT ztb_a2r_wbshdr FROM ls_header.
          ENDIF.
        ENDIF.


        IF sy-subrc = 0.
          " Delete old items if updating
          IF is_header-zreq_num IS NOT INITIAL.
            DELETE FROM ztb_a2r_wbsitem WHERE zreq_num = rv_reqnum.
          ENDIF.

          " Insert WBS items
          LOOP AT it_wbs_items INTO ls_wbs.
            CLEAR ls_item.
            ls_item-mandt = sy-mandt.
            ls_item-zreq_num = rv_reqnum.
            ls_item-bukrs = ls_header-bukrs.
            ls_item-vkokr = ls_wbs-vkokr.
            ls_item-vkokr = ls_header-vkokr.
            ls_item-posid = ls_wbs-posid.
            ls_item-stufe = ls_wbs-stufe.
            ls_item-post1 = ls_wbs-post1.
            ls_item-kostl = ls_wbs-kostl.
            ls_item-wert2 = ls_wbs-wert2.
            ls_item-vkokr = lv_vkokr.
            ls_item-zbudget_check = ls_wbs-zbudget_check.
            ls_item-imprf = ls_wbs-imprf.
            ls_item-prart = ls_wbs-prart.
            ls_item-werks = ls_header-werks.

            IF ls_wbs-posnr IS NOT INITIAL.
              ls_item-posnr = ls_wbs-posnr.
            ENDIF.

            INSERT ztb_a2r_wbsitem FROM ls_item.

            IF sy-subrc <> 0.
              lv_error = abap_true.
              EXIT.
            ENDIF.
          ENDLOOP.

          "═══════════════════════════════════════════════════════════
          " COMMIT OR ROLLBACK
          " ✓ NO MESSAGE
          " ✓ NO TRANSACTION CALL
          " ✓ Just return the request number so caller can continue
          "═══════════════════════════════════════════════════════════
          IF lv_error = abap_false.
            COMMIT WORK AND WAIT.
            " Success - just return the request number
          ELSE.
            ROLLBACK WORK.
            CLEAR rv_reqnum.
          ENDIF.

        ELSE.
          CLEAR rv_reqnum.
          ROLLBACK WORK.
        ENDIF.


      CATCH cx_root INTO DATA(lx_error).
        " Don't show message - just clear request number
        CLEAR rv_reqnum.
        ROLLBACK WORK.
    ENDTRY.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->SUBMIT_REQUEST
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        STANDARD TABLE
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD submit_request.

    DATA: lv_reqnum        TYPE char10,
          lv_appr1         TYPE char8,
          lv_appr2         TYPE char8,
          lv_auto          TYPE char1,
          lv_error_handler TYPE char8,
          lv_found         TYPE abap_bool,
          ls_header        TYPE ztb_a2r_wbshdr,
          lt_l1_approvers  TYPE hpa_t_bname,    " Will contain VARYF values
          lt_l2_approvers  TYPE hpa_t_bname.

    rv_success = abap_false.

    " Step 1: Save request
    lv_reqnum = save_request(
    is_header    = is_header
    it_wbs_items = it_wbs_items
    ).

    IF lv_reqnum IS INITIAL.
      MESSAGE e013(zcj00) WITH 'Error saving request'.
      RETURN.
    ENDIF.

    " Step 2: Get approvers (now returns VARYF as-is)
    lv_found = check_approver_matrix(
    EXPORTING
    iv_bukrs   = is_header-bukrs
    iv_profl   = is_header-profl
    iv_reqtype = is_header-z_reqtype
    IMPORTING
    ev_appr1         = lv_appr1
    ev_appr2         = lv_appr2
    ev_auto          = lv_auto
    ev_error_handler = lv_error_handler
    et_l1_approvers  = lt_l1_approvers    " ← USRG33470, USEV92123, USHQ75177, USKP05750
    et_l2_approvers  = lt_l2_approvers
    ).

    IF lv_found = abap_false.
      MESSAGE e008(zcj00) WITH 'No approver configuration found'.
      RETURN.
    ENDIF.

    " Step 3: Update status to PENDING
    ls_header = is_header.
    ls_header-zreq_num = lv_reqnum.
    ls_header-request_status = 'pending'.

    UPDATE ztb_a2r_wbshdr
    SET request_status = 'pending'
    WHERE zreq_num = lv_reqnum.

    IF sy-subrc <> 0.
      MESSAGE e016(zcj00) WITH 'Failed to update status'.
      ROLLBACK WORK.
      RETURN.
    ENDIF.

    " CRITICAL: Commit before workflow
    COMMIT WORK AND WAIT.

    " Step 4: Trigger workflow or auto-approve
    IF lv_auto = 'x'.
      MESSAGE i035(zcj00) WITH 'Request' lv_reqnum 'auto-approved'.


      rv_success = create_project(
        is_header    = ls_header
        it_wbs_items = it_wbs_items
      ).

      IF rv_success = abap_true.
        UPDATE ztb_a2r_wbshdr
          SET request_status = 'APPROVED'
              zapproved_by = sy-uname
              zrequest_approved_on = sy-datum
          WHERE zreq_num = lv_reqnum.
        COMMIT WORK.
        MESSAGE s033(zcj00) WITH 'Request' lv_reqnum 'approved'.
      ELSE.
        UPDATE ztb_a2r_wbshdr
          SET request_status = 'ERROR'
          WHERE zreq_num = lv_reqnum.
        COMMIT WORK.
        MESSAGE e034(zcj00) WITH 'Error for request' lv_reqnum.
      ENDIF.


    ELSE.
      " Pass VARYF values to workflow
      rv_success = trigger_workflow(
      is_header   = ls_header
      iv_appr1    = lv_appr1
      iv_appr2    = lv_appr2
      it_l1_apprv = lt_l1_approvers     " ← USRG33470, USEV92123, USHQ75177, USKP05750
      it_l2_apprv = lt_l2_approvers
      ).


      IF rv_success = abap_true.
        COMMIT WORK.
        MESSAGE s015(zcj00) WITH lv_reqnum 'submitted for approval'.
      ELSE.
        ROLLBACK WORK.
        MESSAGE e020(zcj00) WITH 'Workflow error for' lv_reqnum.
      ENDIF.


    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->TOTAL_UP_BUDGET
* +-------------------------------------------------------------------------------------------------+
* | [<-->] CT_WBS_ITEMS                   TYPE        TT_WBS_ITEMS
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD total_up_budget.

    DATA: lt_wbs        TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
          ls_wbs        TYPE ztb_a2r_wbsitem,
          ls_wbs_parent TYPE ztb_a2r_wbsitem,
          lv_total      TYPE bpge-wlges,
          lv_max_level  TYPE ps_stufe,
          lv_tabix      TYPE sy-tabix.

    lt_wbs = ct_wbs_items.

    " Get maximum level
    LOOP AT lt_wbs INTO ls_wbs.
      IF ls_wbs-stufe > lv_max_level.
        lv_max_level = ls_wbs-stufe.
      ENDIF.
    ENDLOOP.

    " Process from bottom up (highest level to lowest)
    DO lv_max_level TIMES.
      DATA(lv_current_level) = lv_max_level - sy-index + 1.

      IF lv_current_level <= 1.
        EXIT.
      ENDIF.

      " For each WBS at current level
      LOOP AT lt_wbs INTO ls_wbs WHERE stufe = lv_current_level.

        " Find parent (one level up)
        READ TABLE lt_wbs INTO ls_wbs_parent
          WITH KEY stufe = lv_current_level - 1.

        IF sy-subrc = 0.
          lv_tabix = sy-tabix.
          ls_wbs_parent-wert2 = ls_wbs_parent-wert2 + ls_wbs-wert2.
          MODIFY lt_wbs FROM ls_wbs_parent INDEX lv_tabix.
        ENDIF.
      ENDLOOP.
    ENDDO.

    ct_wbs_items = lt_wbs.

  ENDMETHOD.


