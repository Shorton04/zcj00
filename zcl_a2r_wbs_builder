  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    METHODS copy_template_structure
      IMPORTING
        !iv_pspid     TYPE ps_pspid
        !iv_kostl     TYPE kostl
      CHANGING
        !ct_wbs_items TYPE STANDARD TABLE .
