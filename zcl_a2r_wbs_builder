* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->ASSIGN_BUDGET_CJ30
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        TT_WBS_ITEMS
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD assign_budget_cj30.

  DATA: lv_errors_found TYPE oax,
        lt_bpak         TYPE TABLE OF bpak,
        ls_bpak         TYPE bpak,
        ls_item         TYPE ztb_a2r_wbsitem,
        lv_objnr        TYPE j_objnr,
        lv_waers        TYPE waers,
        lt_return       TYPE TABLE OF bapiret2.

  rv_success = abap_false.
  CLEAR: lt_bpak, lt_return, lv_errors_found.

  lv_waers = get_currency_from_header( is_header ).
  IF lv_waers IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT it_wbs_items INTO ls_item.

    "If CJ30 should run only for flagged WBS
    IF ls_item-zbudget_check IS INITIAL.
      CONTINUE.
    ENDIF.

    IF ls_item-wert2 IS INITIAL.
      CONTINUE.
    ENDIF.

    SELECT SINGLE objnr
      FROM prps
      INTO @lv_objnr
      WHERE posid = @ls_item-posid.

    IF sy-subrc <> 0 OR lv_objnr IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_bpak.
    ls_bpak-e_objnr = lv_objnr.
    ls_bpak-e_versn = '000'.
    ls_bpak-e_perio = '001'.
    ls_bpak-e_wrttp = '41'.        "CJ30 Budget
    ls_bpak-wert    = ls_item-wert2.
    ls_bpak-twaer   = lv_waers.

    APPEND ls_bpak TO lt_bpak.

  ENDLOOP.

  IF lt_bpak IS INITIAL.
    "No budget lines, still OK
    rv_success = abap_true.
    RETURN.
  ENDIF.

  CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
    EXPORTING
      i_budget_activity = 'KBUD'   "CJ30
      i_delta_amounts   = 'X'
      i_rollup_data     = 'X'
      i_check_plan_data = 'X'
      i_application     = 'P'
      i_commit_all      = 'X'
    IMPORTING
      e_errors_found    = lv_errors_found
    TABLES
      it_bpak           = lt_bpak
      it_return         = lt_return
    EXCEPTIONS
      no_update         = 1
      OTHERS            = 2.

  IF sy-subrc <> 0 OR lv_errors_found IS NOT INITIAL.
    RETURN.
  ENDIF.

  READ TABLE lt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
  IF sy-subrc = 0.
    RETURN.
  ENDIF.

  "NEW: Call BLKD after CJ30 success
  IF set_blkd_status_for_higher_wbs( it_wbs_items = it_wbs_items ) = abap_false.
    rv_success = abap_false.
    RETURN.
  ENDIF.

  rv_success = abap_true.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->DISTRIBUTE_BUDGET_IM52
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        TT_WBS_ITEMS
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD distribute_budget_im52.

    DATA: lv_errors_found TYPE oax,
          lt_bpak         TYPE TABLE OF bpak,
          ls_bpak         TYPE bpak,
          ls_item         TYPE ztb_a2r_wbsitem,
          lv_objnr        TYPE j_objnr,
          lv_waers        TYPE waers,
          lv_posnr        TYPE bp_posit,
          lt_return       TYPE TABLE OF bapiret2.

    FIELD-SYMBOLS: <fs_posnr> TYPE any.

    rv_success = abap_false.
    CLEAR: lt_bpak, lt_return, lv_errors_found, lv_posnr.

    lv_waers = get_currency_from_header( is_header ).
    IF lv_waers IS INITIAL.
      RETURN.
    ENDIF.

    "Get IM Position (POSNR) from header
    ASSIGN COMPONENT 'POSNR' OF STRUCTURE is_header TO <fs_posnr>.
    IF sy-subrc = 0 AND <fs_posnr> IS ASSIGNED AND <fs_posnr> IS NOT INITIAL.
      lv_posnr = <fs_posnr>.
    ENDIF.

    IF lv_posnr IS INITIAL.
      "No IM position => cannot do IM52 distribution
      RETURN.
    ENDIF.

    "Build distribution lines ONLY for Level 1 WBS
    LOOP AT it_wbs_items INTO ls_item.

      "Adjust this condition to your real “Level 1” logic/field
      IF ls_item-stufe <> 1.
        CONTINUE.
      ENDIF.

      IF ls_item-wert2 IS INITIAL.
        CONTINUE.
      ENDIF.

      SELECT SINGLE objnr
        FROM prps
        INTO @lv_objnr
        WHERE posid = @ls_item-posid.

      IF sy-subrc <> 0 OR lv_objnr IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR ls_bpak.
      ls_bpak-s_posit = lv_posnr.     "IM Position (source)
      ls_bpak-e_objnr = lv_objnr.     "Receiver = Level 1 WBS
      ls_bpak-e_versn = '000'.
      ls_bpak-e_perio = '001'.
      ls_bpak-e_wrttp = '41'.         "Budget amount for distribution
      ls_bpak-wert    = ls_item-wert2.
      ls_bpak-twaer   = lv_waers.

      APPEND ls_bpak TO lt_bpak.

    ENDLOOP.

    IF lt_bpak IS INITIAL.
      rv_success = abap_true.
      RETURN.
    ENDIF.

    CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
      EXPORTING
        i_budget_activity             = 'KBUD'  "Budget update interface
        i_budget_distribution_allowed = 'X'     "<<< IM52 trigger (per SAP note)
        i_delta_amounts               = 'X'
        i_rollup_data                 = 'X'
        i_check_plan_data             = 'X'
        i_application                 = 'P'
        i_commit_all                  = 'X'
      IMPORTING
        e_errors_found                = lv_errors_found
      TABLES
        it_bpak                       = lt_bpak
        it_return                     = lt_return.

    IF sy-subrc <> 0 OR lv_errors_found IS NOT INITIAL.
      RETURN.
    ENDIF.

    READ TABLE lt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
    IF sy-subrc = 0.
      RETURN.
    ENDIF.

    rv_success = abap_true.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->GET_CURRENCY_FROM_HEADER
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [<-()] RV_WAERS                       TYPE        WAERS
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_currency_from_header.
    FIELD-SYMBOLS: <fs> TYPE any.

    CLEAR rv_waers.

    ASSIGN COMPONENT 'WAERS' OF STRUCTURE is_header TO <fs>.
    IF sy-subrc = 0 AND <fs> IS ASSIGNED AND <fs> IS NOT INITIAL.
      rv_waers = <fs>.
      RETURN.
    ENDIF.

    ASSIGN COMPONENT 'TWAER' OF STRUCTURE is_header TO <fs>.
    IF sy-subrc = 0 AND <fs> IS ASSIGNED AND <fs> IS NOT INITIAL.
      rv_waers = <fs>.
      RETURN.
    ENDIF.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->POST_PLAN_IM52_CJ30_FLOW
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        TT_WBS_ITEMS
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD post_plan_im52_cj30_flow.

    rv_success = abap_false.

    IF assign_plan_values(
         is_header    = is_header
         it_wbs_items = it_wbs_items ) = abap_false.
      RETURN.
    ENDIF.

    IF distribute_budget_im52(
         is_header    = is_header
         it_wbs_items = it_wbs_items ) = abap_false.
      RETURN.
    ENDIF.

    IF assign_budget_cj30(
         is_header    = is_header
         it_wbs_items = it_wbs_items ) = abap_false.
      RETURN.
    ENDIF.

    rv_success = abap_true.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->SET_BLKD_STATUS_FOR_HIGHER_WBS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IT_WBS_ITEMS                   TYPE        TT_WBS_ITEMS
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD set_blkd_status_for_higher_wbs.

  DATA:
    lt_user_status TYPE TABLE OF bapi_wbs_mnt_user_status,
    ls_user_status TYPE bapi_wbs_mnt_user_status,
    lt_result      TYPE TABLE OF bapi_status_result,
    ls_result      TYPE bapi_status_result.

  rv_success = abap_false.

  "Initialize PS context (MANDATORY in your system)
  CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

  LOOP AT it_wbs_items INTO DATA(ls_item).

    IF ls_item-posid IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_user_status.
    ls_user_status-wbs_element     = ls_item-posid.
    ls_user_status-set_user_status = 'BLKD'.
    APPEND ls_user_status TO lt_user_status.

  ENDLOOP.

  IF lt_user_status IS INITIAL.
    RETURN.
  ENDIF.

  CALL FUNCTION 'BAPI_BUS2054_SET_STATUS'
    TABLES
      i_wbs_user_status = lt_user_status
      e_result          = lt_result.

  "Required in your system
  CALL FUNCTION 'BAPI_PS_PRECOMMIT'.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  "Check result
  LOOP AT lt_result INTO ls_result.
    IF ls_result-message_id IS NOT INITIAL.
      rv_success = abap_false.
      RETURN.
    ENDIF.
  ENDLOOP.

  rv_success = abap_true.

ENDMETHOD.
ENDCLASS.
