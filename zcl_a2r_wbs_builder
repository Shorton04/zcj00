* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->CREATE_WBS_ELEMENTSTEST
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        STANDARD TABLE
* | [<---] ET_WBS_CREATED                 TYPE        STANDARD TABLE
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD create_wbs_elementstest.

    DATA: lv_pspid          TYPE ztb_a2r_wbshdr-pspid,
          ls_wbs            TYPE ztb_a2r_wbsitem,
          ls_wbs_temp       TYPE ztb_a2r_wbsitem,
          ls_wbs_created    TYPE ztb_a2r_wbsitem,
          lt_wbs_sorted     TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
          lt_return         TYPE TABLE OF bapiret2,
          ls_return         TYPE bapiret2,
          lt_wbs_celement   TYPE TABLE OF bapi_wbs_element,
          ls_wbs_celement   TYPE bapi_wbs_element,
          lt_extensionin    TYPE TABLE OF bapiparex,
          ls_extensionin    TYPE bapiparex,
          ls_te_wbs         TYPE bapi_te_wbs_element,
          lv_level1_posid   TYPE ps_posid,
          lv_level1_pspnr   TYPE ps_pspnr,
          lv_counter        TYPE i VALUE 1,
          lv_waers          TYPE waers,
          lv_parent_posid   TYPE ps_posid,
          lv_posid_internal TYPE ps_posid,
          lv_current_index  TYPE i,
          lv_parent_counter TYPE i,
          ls_project_new    TYPE bapi_bus2001_new.

    rv_success = abap_false.

    "═══════════════════════════════════════════════════════════════════
    " STEP 1: GET NEXT PROJECT NUMBER
    "═══════════════════════════════════════════════════════════════════
    lv_pspid = get_next_project_number( is_header-profl ).

    IF lv_pspid IS INITIAL.
      MESSAGE e029(zcj00) WITH 'Failed to get project number'.
      RETURN.
    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 2: GET CURRENCY FROM COMPANY CODE
    "═══════════════════════════════════════════════════════════════════
    SELECT SINGLE waers FROM t001
    INTO lv_waers
    WHERE bukrs = is_header-bukrs.

    IF sy-subrc <> 0.
      lv_waers = 'USD'.
    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 3: INITIALIZE BAPI
    "═══════════════════════════════════════════════════════════════════
    CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

    "═══════════════════════════════════════════════════════════════════
    " STEP 4: CREATE PROJECT DEFINITION (Level 1)
    " (Inline version of former FORM CHECK_PROJ_CREATE)
    "═══════════════════════════════════════════════════════════════════

    CLEAR ls_project_new.

    " Use the generated project number
    ls_project_new-project_definition = lv_pspid.

    " Map from header
    ls_project_new-description        = is_header-post1.
    ls_project_new-company_code       = is_header-bukrs.
    ls_project_new-controlling_area   = is_header-vkokr. " << Recommend VKOKR instead of BUKRS(4)
    ls_project_new-profit_ctr         = is_header-prctr.
    ls_project_new-start              = is_header-plfaz.
    ls_project_new-finish             = is_header-plsez.
    ls_project_new-plant              = is_header-werks.
    ls_project_new-project_profile    = is_header-profl.
    ls_project_new-responsible_no     = is_header-vernr.

    " Create Project Definition
    CALL FUNCTION 'BAPI_BUS2001_CREATE'
      EXPORTING
        i_project_definition = ls_project_new
      TABLES
        et_return            = lt_return.

    LOOP AT lt_return INTO ls_return WHERE type CA 'EA'.
      MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
             WITH ls_return-message_v1 ls_return-message_v2
                  ls_return-message_v3 ls_return-message_v4.
      rv_success = abap_false.
      RETURN.
    ENDLOOP.

*    " Commit project creation
*    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
*      EXPORTING
*        wait = 'X'.

    " Store Level 1 POSID (same as project)
    lv_level1_posid = lv_pspid.

    "═══════════════════════════════════════════════════════════════════
    " STEP 5: CREATE SUB-WBS ELEMENTS (Level 2+)
    "═══════════════════════════════════════════════════════════════════
    " Sort by level (ascending this time for parent tracking)
    lt_wbs_sorted = it_wbs_items.
    SORT lt_wbs_sorted BY stufe ASCENDING.

    " Build WBS element table for BAPI
    CLEAR lv_counter.
    LOOP AT lt_wbs_sorted INTO ls_wbs.


      " Skip items without budget
      IF ls_wbs-wert2 IS INITIAL.
        CONTINUE.
      ENDIF.

      " Skip Level 1 (already created as project definition)
      IF ls_wbs-stufe = 1.
        CONTINUE.
      ENDIF.

      lv_counter = lv_counter + 1.

      CLEAR ls_wbs_celement.

      " ───────────────────────────────────────────────────────────────
      " WBS ELEMENT IDENTIFICATION
      " ───────────────────────────────────────────────────────────────
      ls_wbs_celement-wbs_element = |{ lv_pspid }-{ lv_counter }|.

      " ───────────────────────────────────────────────────────────────
      " BASIC FIELDS (From Structure Browser - Image 1)
      " ───────────────────────────────────────────────────────────────
      ls_wbs_celement-description      = ls_wbs-post1.        " PS_POST1
      ls_wbs_celement-comp_code     = is_header-bukrs.     " BUKRS
      ls_wbs_celement-bus_area    = is_header-bukrs.     " GSBER (can be different)
      ls_wbs_celement-request_cctr_controlling_area = is_header-bukrs(4).  " KOKRS
      ls_wbs_celement-profit_ctr       = is_header-prctr.     " PRCTR
      ls_wbs_celement-plant            = is_header-werks.     " WERKS_D

      " ───────────────────────────────────────────────────────────────
      " PLANNING FIELDS
      " ───────────────────────────────────────────────────────────────
      ls_wbs_celement-wbs_planning_element = abap_true.       " PS_PLAKZ

      " ───────────────────────────────────────────────────────────────
      " INVESTMENT FIELDS
      " ───────────────────────────────────────────────────────────────
      ls_wbs_celement-inv_reason       = is_header-izwek.     " IZWEK
      ls_wbs_celement-invest_profile   = ls_wbs-imprf.        " IM_PROFIL

      " ───────────────────────────────────────────────────────────────
      " DATES (From Structure Browser - Image 4)
      " ───────────────────────────────────────────────────────────────
      ls_wbs_celement-wbs_basic_start_date  = sy-datum.       " PS_PSTRT
      ls_wbs_celement-wbs_basic_finish_date = is_header-plsez. " PS_PENDE

      " ───────────────────────────────────────────────────────────────
      " RESPONSIBILITY
      " ───────────────────────────────────────────────────────────────
      ls_wbs_celement-respsbl_cctr     = ls_wbs-kostl.        " PS_KOSTL
      ls_wbs_celement-responsible_no   = is_header-vernr.     " PS_VERNR

      " ───────────────────────────────────────────────────────────────
      " ACCOUNT ASSIGNMENT
      " ───────────────────────────────────────────────────────────────
      ls_wbs_celement-wbs_account_assignment_element = abap_true. " PS_BELKZ

      " ───────────────────────────────────────────────────────────────
      " HIERARCHY: Determine parent based on STUFE
      " ───────────────────────────────────────────────────────────────
      " For Level 2, parent is the project (Level 1)
      " For Level 3+, find previous element with lower STUFE

      CLEAR lv_parent_posid.

      IF ls_wbs-stufe = 2.
        " Level 2 parent is always the project
        lv_parent_posid = lv_pspid.
      ELSE.
        " Level 3+ - find parent by looking back in sorted list
        lv_current_index = sy-tabix.

        LOOP AT lt_wbs_sorted INTO ls_wbs_temp TO lv_current_index - 1.
          " Find first element with STUFE = current - 1
          IF ls_wbs_temp-stufe = ls_wbs-stufe - 1.
            " Calculate parent POSID
            IF ls_wbs_temp-stufe = 1.
              lv_parent_posid = lv_pspid.
            ELSE.
              " Find counter for this parent
              LOOP AT lt_wbs_sorted INTO DATA(ls_count) WHERE stufe > 1.
                IF ls_count-posid = ls_wbs_temp-posid.
                  EXIT.
                ENDIF.
                IF ls_count-wert2 IS NOT INITIAL.
                  lv_parent_counter = lv_parent_counter + 1.
                ENDIF.
              ENDLOOP.
              lv_parent_posid = |{ lv_pspid }-{ lv_parent_counter }|.
            ENDIF.
            EXIT.
          ENDIF.
        ENDLOOP.

        " Fallback to project if no parent found
        IF lv_parent_posid IS INITIAL.
          lv_parent_posid = lv_pspid.
        ENDIF.
      ENDIF.

      " ───────────────────────────────────────────────────────────────
      " CRITICAL: Use correct BAPI field names from Structure Browser
      " There is NO wbs_up or wbs_left in BAPI_WBS_ELEMENT!
      " Hierarchy is established through i_project_definition parameter
      " ───────────────────────────────────────────────────────────────
      " Parent is specified in separate call or via project structure

      APPEND ls_wbs_celement TO lt_wbs_celement.

      " ───────────────────────────────────────────────────────────────
      " EXTENSION FIELDS (if needed)
      " ───────────────────────────────────────────────────────────────
      IF ls_wbs-stufe = 1 AND is_header-zunifier_proj = 'X'.
        CLEAR ls_te_wbs.
        ls_te_wbs-wbs_element = ls_wbs_celement-wbs_element.
        ls_te_wbs-zunifier_proj = 'X'.

        CLEAR ls_extensionin.
        ls_extensionin-structure  = 'BAPI_TE_WBS_ELEMENT'.
        ls_extensionin-valuepart1 = ls_te_wbs.
        ls_extensionin-valuepart2+49(01) = ls_te_wbs-zunifier_proj.
        APPEND ls_extensionin TO lt_extensionin.
      ENDIF.


    ENDLOOP.

    "═══════════════════════════════════════════════════════════════════
    " STEP 6: CREATE WBS ELEMENTS VIA BAPI (if any Level 2+ exist)
    "═══════════════════════════════════════════════════════════════════
    IF lt_wbs_celement IS NOT INITIAL.


      CLEAR lt_return.

      " Use BAPI_BUS2054_CREATE_MULTI with project as parent context
      CALL FUNCTION 'BAPI_BUS2054_CREATE_MULTI'
        EXPORTING
          i_project_definition = lv_pspid
        TABLES
          it_wbs_element       = lt_wbs_celement
          et_return            = lt_return
          extensionin          = lt_extensionin.

      LOOP AT lt_return INTO ls_return WHERE type CA 'EA'.
        MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
          WITH ls_return-message_v1 ls_return-message_v2
               ls_return-message_v3 ls_return-message_v4.
        rv_success = abap_false.
        RETURN.
      ENDLOOP.


    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 7: PRE-COMMIT
    "═══════════════════════════════════════════════════════════════════
    CLEAR lt_return.

    CALL FUNCTION 'BAPI_PS_PRECOMMIT'
      TABLES
        et_return = lt_return.

    LOOP AT lt_return INTO ls_return WHERE type CA 'EA'.
      MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
      WITH ls_return-message_v1 ls_return-message_v2.
      rv_success = abap_false.
      RETURN.
    ENDLOOP.

    "═══════════════════════════════════════════════════════════════════
    " STEP 8: COMMIT WORK
    "═══════════════════════════════════════════════════════════════════
    CLEAR ls_return.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait   = 'X'
      IMPORTING
        return = ls_return.

    IF ls_return-type CA 'EA'.
      MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
      WITH ls_return-message_v1 ls_return-message_v2.
      rv_success = abap_false.
      RETURN.
    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 9: GET CREATED WBS INTERNAL NUMBERS
    "═══════════════════════════════════════════════════════════════════
    " Get Level 1 (Project) internal number
    SELECT SINGLE pspnr FROM proj
    INTO lv_level1_pspnr
    WHERE pspid = lv_pspid.

    IF sy-subrc <> 0.
      MESSAGE e029(zcj00) WITH 'Project not found after creation'.
      rv_success = abap_false.
      RETURN.
    ENDIF.

    " Build output table with created WBS elements
    CLEAR lv_counter.
    LOOP AT it_wbs_items INTO ls_wbs.


      IF ls_wbs-wert2 IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR ls_wbs_created.

      IF ls_wbs-stufe = 1.
        " Level 1 = Project
        ls_wbs_created-posid = lv_pspid.
        ls_wbs_created-posnr = lv_level1_pspnr.
      ELSE.
        " Level 2+ = Sub WBS
        lv_counter = lv_counter + 1.
        ls_wbs_created-posid = |{ lv_pspid }-{ lv_counter }|.

        " Get internal number from PRPS
        SELECT SINGLE pspnr FROM prps
          INTO ls_wbs_created-posnr
          WHERE posid = ls_wbs_created-posid.

        IF sy-subrc <> 0.
          " Try with conversion
          CALL FUNCTION 'CONVERSION_EXIT_ABPSP_INPUT'
            EXPORTING
              input  = ls_wbs_created-posid
            IMPORTING
              output = lv_posid_internal.

          SELECT SINGLE pspnr FROM prps
            INTO ls_wbs_created-posnr
            WHERE posid = lv_posid_internal.
        ENDIF.
      ENDIF.

      " Copy other fields
      ls_wbs_created-stufe = ls_wbs-stufe.
      ls_wbs_created-post1 = ls_wbs-post1.
      ls_wbs_created-kostl = ls_wbs-kostl.
      ls_wbs_created-wert2 = ls_wbs-wert2.
      ls_wbs_created-zbudget_check = ls_wbs-zbudget_check.
      ls_wbs_created-imprf = ls_wbs-imprf.
      ls_wbs_created-prart = ls_wbs-prart.
      ls_wbs_created-bukrs = is_header-bukrs.
      ls_wbs_created-werks = is_header-werks.

      APPEND ls_wbs_created TO et_wbs_created.


    ENDLOOP.

    "═══════════════════════════════════════════════════════════════════
    " STEP 10: LINK TO IM POSITION (IF POSNR PROVIDED)
    "═══════════════════════════════════════════════════════════════════
*    IF is_header-posnr IS NOT INITIAL.
*
*
*      CALL FUNCTION 'IM_ASSIGN_WBS_TO_POSITION'
*        EXPORTING
*          i_posnr = is_header-posnr
*          i_posid = lv_level1_posid
*        EXCEPTIONS
*          OTHERS  = 1.
*
*      IF sy-subrc <> 0.
*        MESSAGE w031(zcj00) WITH 'Warning: IM assignment failed'.
*      ENDIF.
*
*
*    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 11: UPDATE HEADER WITH PROJECT NUMBER
    "═══════════════════════════════════════════════════════════════════
    UPDATE ztb_a2r_wbshdr
    SET pspnr = lv_level1_pspnr
    WHERE zreq_num = is_header-zreq_num.

    COMMIT WORK.

    rv_success = abap_true.

  ENDMETHOD.
ENDCLASS.
