* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->APPEND_CAR_TEMPLATE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_PSPID_CAR                   TYPE        PROJ-PSPID
* | [--->] IV_KOSTL                       TYPE        CSKS-KOSTL
* | [<-->] CT_WBS_ITEMS                   TYPE        TT_WBS_ITEMS
* | [<-->] CT_WBS_CAR                     TYPE        TT_WBS_ITEMS
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD append_car_template.
    DATA: lt_car_template   TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
          ls_car_template   TYPE ztb_a2r_wbsitem,
          ls_esr_root       TYPE ztb_a2r_wbsitem,
          ls_new_item       TYPE ztb_a2r_wbsitem,
          lv_esr_root_posid TYPE prps-posid,
          lv_car_posid      TYPE ztb_a2r_wbsitem-posid,
          lv_suffix         TYPE string,
          lv_werks          TYPE ztb_a2r_wbsitem-werks,
          lv_mandt          TYPE ztb_a2r_wbsitem-mandt,
          lv_prart          TYPE ztb_a2r_wbsitem-prart,
          lv_bukrs          TYPE ztb_a2r_wbsitem-bukrs.

    CLEAR ct_wbs_car.

    CALL METHOD me->copy_template_structure
      EXPORTING
        iv_pspid     = iv_pspid_car
        iv_kostl     = iv_kostl
      CHANGING
        ct_wbs_items = lt_car_template.

    IF lt_car_template IS INITIAL.
      RETURN.
    ENDIF.

    READ TABLE ct_wbs_items INTO ls_esr_root WITH KEY stufe = 1.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    lv_werks = ls_esr_root-werks.
    lv_mandt = ls_esr_root-mandt.
    lv_prart = ls_esr_root-prart.
    lv_bukrs = ls_esr_root-bukrs.

    REPLACE ALL OCCURRENCES OF '.' IN ls_esr_root-posid WITH ''.

    SELECT SINGLE pspnr
      FROM prps
      INTO @DATA(lv_pspnr_esr)
      WHERE posid = @ls_esr_root-posid.

    IF sy-subrc <> 0 OR lv_pspnr_esr IS INITIAL.
      RETURN.
    ENDIF.

    SELECT SINGLE posid
      INTO @lv_esr_root_posid
      FROM prps
      WHERE pspnr = @lv_pspnr_esr.

    IF sy-subrc <> 0 OR lv_esr_root_posid IS INITIAL.
      RETURN.
    ENDIF.

    LOOP AT lt_car_template INTO ls_car_template.

      IF ls_car_template-stufe = 1.
        CONTINUE.
      ENDIF.

      CLEAR: ls_new_item, lv_car_posid, lv_suffix.

      ls_new_item = ls_car_template.
      lv_car_posid = ls_car_template-posid.

      IF lv_car_posid IS INITIAL.
        CONTINUE.
      ENDIF.

      IF strlen( lv_car_posid ) >= 9.
        lv_suffix = lv_car_posid+8.
      ELSE.
        CONTINUE.
      ENDIF.

      CONCATENATE lv_esr_root_posid lv_suffix INTO ls_new_item-posid.

      ls_new_item-kostl = iv_kostl.
      ls_new_item-werks = lv_werks.
      ls_new_item-mandt = lv_mandt.
      ls_new_item-prart = lv_prart.
      ls_new_item-bukrs = lv_bukrs.

      APPEND ls_new_item TO ct_wbs_items.
      APPEND ls_new_item TO ct_wbs_car.

    ENDLOOP.

  ENDMETHOD.


