CLASS ZCL_A2R_WBS_BUILDER IMPLEMENTATION.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->ASSIGN_PLAN_VALUES
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        TT_WBS_ITEMS
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD assign_plan_values.

    DATA: lv_errors_found TYPE oax,
          lt_bpak         TYPE STANDARD TABLE OF bpak,
          lt_wbs_db       TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
          ls_bpak         TYPE bpak,
          ls_wbs_db       TYPE ztb_a2r_wbsitem,
          lv_objnr        TYPE j_objnr,
          lv_waers        TYPE waers,
          lv_version      TYPE bp_version,
          lv_reqtype      TYPE ztb_a2r_wbshdr-z_reqtype,
          lv_delta        TYPE c,
          lv_rollup       TYPE c,
          lv_ernam        TYPE ernam,
          lt_return       TYPE STANDARD TABLE OF bapiret2,
          lv_posid_db     TYPE ps_posid,
          lv_has_error    TYPE abap_bool.

    rv_success = abap_false.
    CLEAR: lt_bpak, lt_return, lv_errors_found.

    lv_delta = ''.
    lv_rollup = ''.
    lv_version = '000'.

*---------------------------------------------------------------------*
* 1) Get Currency
*---------------------------------------------------------------------*
    SELECT SINGLE waers, z_reqtype, ernam
      INTO (@lv_waers, @lv_reqtype, @lv_ernam)
      FROM ztb_a2r_wbshdr
      WHERE zreq_num = @is_header-zreq_num.

    IF lv_waers IS INITIAL.
      lv_waers = is_header-waers.
    ENDIF.

    IF lv_waers IS INITIAL AND is_header-bukrs IS NOT INITIAL.
      SELECT SINGLE waers
        INTO @lv_waers
        FROM t001
        WHERE bukrs = @is_header-bukrs.
    ENDIF.

    IF lv_waers IS INITIAL.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* 2) Read ONLY flagged WBS from DB
*---------------------------------------------------------------------*
    SELECT *
      FROM ztb_a2r_wbsitem
      INTO TABLE @lt_wbs_db
      WHERE zreq_num      = @is_header-zreq_num
        AND wert2         > 0.

    IF lt_wbs_db IS INITIAL.
      rv_success = abap_true.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* 3) Build BPAK from DB records
*---------------------------------------------------------------------*
    LOOP AT lt_wbs_db INTO ls_wbs_db.

      CLEAR lv_objnr.

      "Convert POSID external -> internal
      lv_posid_db = ls_wbs_db-posid.

      CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
        EXPORTING
          input  = lv_posid_db
        IMPORTING
          output = lv_posid_db
        EXCEPTIONS
          OTHERS = 1.

      SELECT SINGLE objnr
        INTO @lv_objnr
        FROM prps
        WHERE posid = @lv_posid_db.

      IF lv_objnr IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR ls_bpak.
      ls_bpak-e_objnr = lv_objnr.
      ls_bpak-e_versn = lv_version.
      ls_bpak-e_perio = '001'.
      ls_bpak-e_wrttp = '01'.         "PLAN
      ls_bpak-wert    = ls_wbs_db-wert2.
      ls_bpak-twaer   = lv_waers.

      APPEND ls_bpak TO lt_bpak.

    ENDLOOP.

    IF lt_bpak IS INITIAL.
      rv_success = abap_true.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* 4) Call FM
*---------------------------------------------------------------------*
    CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
      EXPORTING
        i_budget_activity = 'KSTP'    "CJ40
        i_delta_amounts   = lv_delta
        i_rollup_data     = lv_rollup
        i_check_plan_data = 'X'
        i_application     = 'P'
        i_commit_all      = 'X'
      IMPORTING
        e_errors_found    = lv_errors_found
      TABLES
        it_bpak           = lt_bpak
        it_return         = lt_return.

    IF sy-subrc <> 0 OR lv_errors_found IS NOT INITIAL.
      rv_success = abap_false.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* 5) Check Return Messages
*---------------------------------------------------------------------*

    LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'AEX'.
      EXIT.
    ENDLOOP.

    IF sy-subrc EQ 0.
      rv_success = abap_false. " Error updating
    ELSE.
      COMMIT WORK AND WAIT.
      WAIT UP TO 2 SECONDS.
      rv_success = abap_true.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->CHECK_APPROVER_MATRIX
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BUKRS                       TYPE        BUKRS
* | [--->] IV_PROFL                       TYPE        PROFIDPROJ
* | [--->] IV_REQTYPE                     TYPE        ZTB_A2R_REQTYPE-Z_REQTYPE
* | [<---] EV_AUTO                        TYPE        CHAR1
* | [<---] EV_FOUND                       TYPE        ABAP_BOOL
* | [<---] ET_L1_APPROVERS                TYPE        HPA_T_BNAME
* | [<---] ET_L2_APPROVERS                TYPE        HPA_T_BNAME
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD check_approver_matrix.

    DATA: lv_objid   TYPE hrobjid.

    " Step 1: Get approver configuration from ZTB_A2R_CONFTAB2
    SELECT SINGLE * FROM ztb_a2r_conftab2
       INTO @DATA(ls_config)
      WHERE bukrs = @iv_bukrs
        AND profl = @iv_profl
        AND z_reqtype = @iv_reqtype.

    IF sy-subrc <> 0.
      ev_found = abap_false.
      RETURN.
    ENDIF.

    lv_objid = CONV #( ls_config-zaproval_1 ).
    " Level 1 approvers
    me->get_approvers(
      EXPORTING
        iv_pos       = lv_objid
      CHANGING
        ct_approvers = et_l1_approvers ).

    " Level 2 approvers
    lv_objid = CONV #( ls_config-zaproval_2 ).
    me->get_approvers(
      EXPORTING
        iv_pos       = lv_objid
      CHANGING
        ct_approvers = et_l2_approvers ).

    " Auto-approval logic
    IF et_l1_approvers IS INITIAL AND et_l2_approvers IS INITIAL.
      ev_auto = abap_true.
    ELSE.
      CLEAR ev_auto.
    ENDIF.

    ev_found = abap_true.


  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->COPY_TEMPLATE_STRUCTURE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_PSPID                       TYPE        PS_PSPID
* | [--->] IV_KOSTL                       TYPE        KOSTL
* | [<-->] CT_WBS_ITEMS                   TYPE        TT_WBS_ITEMS
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD copy_template_structure.

    "------------------------------------------------------------
    " Correct template sequencing using PRHIS hierarchy pointers
    "   - Read template project PSPNR (internal) from PROJS/PROJ
    "   - Read PRHIS edges (UP/DOWN/RIGHT) for that PSPHI
    "   - Traverse PRE-ORDER (node -> down subtree -> right sibling)
    "   - Fetch WBS attributes from PRPSS by PSPNR
    "------------------------------------------------------------

    TYPES: BEGIN OF ty_prhis,
             pspnr TYPE ps_pspnr,   "node (WBS internal)
             psphi TYPE ps_pspnr,   "project internal
             up    TYPE ps_pspnr,
             down  TYPE ps_pspnr,
             left  TYPE ps_pspnr,
             right TYPE ps_pspnr,
           END OF ty_prhis.

    TYPES: BEGIN OF ty_prpss,
             pspnr TYPE prpss-pspnr,
             stufe TYPE prpss-stufe,
             posid TYPE prpss-posid,
             post1 TYPE prpss-post1,
             imprf TYPE prpss-imprf,
             pkokr TYPE prpss-pkokr,
             prart TYPE prpss-prart,
             pbukr TYPE prpss-pbukr,
           END OF ty_prpss.

    DATA: lv_psphi   TYPE ps_pspnr,
          lt_prhis   TYPE STANDARD TABLE OF ty_prhis,
          ls_prhis   TYPE ty_prhis,
          lt_prhis_h TYPE HASHED TABLE OF ty_prhis WITH UNIQUE KEY pspnr,
          lt_prpss   TYPE STANDARD TABLE OF ty_prpss,
          lt_prpss_h TYPE HASHED TABLE OF ty_prpss WITH UNIQUE KEY pspnr,
          ls_prpss   TYPE ty_prpss,
          lt_stack   TYPE STANDARD TABLE OF ps_pspnr,
          lv_node    TYPE ps_pspnr,
          lv_root    TYPE ps_pspnr,
          ls_wbs     TYPE ztb_a2r_wbsitem.

    FIELD-SYMBOLS: <fs_prhis> TYPE ty_prhis,
                   <fs_prpss> TYPE ty_prpss.

    "Optional: keep clean output
    CLEAR ct_wbs_items.

    "1) Get template project internal number (PSPHI/PSPNR)
    SELECT SINGLE pspnr
      INTO @lv_psphi
      FROM projs
      WHERE pspid = @iv_pspid.

    IF sy-subrc <> 0.
      SELECT SINGLE pspnr
        INTO @lv_psphi
        FROM proj
        WHERE pspid = @iv_pspid.
    ENDIF.

    IF sy-subrc <> 0 OR lv_psphi IS INITIAL.
      RETURN.
    ENDIF.

    "2) Read PRHIS (hierarchy pointers) for this template project
    SELECT posnr, psphi, up, down, left, right
      FROM prhis
      INTO TABLE @lt_prhis
      WHERE psphi = @lv_psphi.

    IF sy-subrc <> 0 OR lt_prhis IS INITIAL.
      "Fallback: if PRHIS not maintained, keep old behavior (not ideal)
      SELECT pspnr, stufe, posid, post1, imprf, pkokr, prart, pbukr
        FROM prpss
        INTO TABLE @lt_prpss
        WHERE psphi = @lv_psphi
        ORDER BY stufe, posid.
      LOOP AT lt_prpss INTO ls_prpss.
        CLEAR ls_wbs.
        ls_wbs-stufe = ls_prpss-stufe.
        ls_wbs-posid = ls_prpss-posid.
        ls_wbs-post1 = ls_prpss-post1.
        ls_wbs-posnr = ls_prpss-pspnr.
        ls_wbs-kostl = iv_kostl.
        ls_wbs-imprf = ls_prpss-imprf.
        ls_wbs-vkokr = ls_prpss-pkokr.
        ls_wbs-prart = ls_prpss-prart.
        ls_wbs-bukrs = ls_prpss-pbukr.
        APPEND ls_wbs TO ct_wbs_items.
      ENDLOOP.
      RETURN.
    ENDIF.

    lt_prhis_h = lt_prhis.

    "3) Read PRPSS attributes for all nodes in this template
    SELECT pspnr, stufe, posid, post1, imprf, pkokr, prart, pbukr
      FROM prpss
      INTO TABLE @lt_prpss
      WHERE psphi = @lv_psphi.

    IF sy-subrc <> 0 OR lt_prpss IS INITIAL.
      RETURN.
    ENDIF.

    lt_prpss_h = lt_prpss.

    "4) Determine ROOT node (top WBS): UP is initial
    CLEAR lv_root.
    LOOP AT lt_prhis INTO ls_prhis.
      IF ls_prhis-up IS INITIAL.
        lv_root = ls_prhis-pspnr.
        EXIT.
      ENDIF.
    ENDLOOP.

    IF lv_root IS INITIAL.
      "If nothing flagged as root, just stop (or pick first)
      READ TABLE lt_prhis INTO ls_prhis INDEX 1.
      IF sy-subrc = 0.
        lv_root = ls_prhis-pspnr.
      ENDIF.
    ENDIF.

    IF lv_root IS INITIAL.
      RETURN.
    ENDIF.

    "5) Pre-order traversal using stack:
    "   pop node -> append -> push RIGHT -> push DOWN
    CLEAR lt_stack.
    APPEND lv_root TO lt_stack.

    WHILE lt_stack IS NOT INITIAL.

      "POP last
      READ TABLE lt_stack INTO lv_node INDEX lines( lt_stack ).
      DELETE lt_stack INDEX lines( lt_stack ).

      "Get PRHIS edge row for this node
      READ TABLE lt_prhis_h ASSIGNING <fs_prhis> WITH KEY pspnr = lv_node.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.

      "Get PRPSS data for this node
      READ TABLE lt_prpss_h ASSIGNING <fs_prpss> WITH KEY pspnr = lv_node.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.

      CLEAR ls_wbs.
      ls_wbs-stufe = <fs_prpss>-stufe.
      ls_wbs-posid = <fs_prpss>-posid.
      ls_wbs-post1 = <fs_prpss>-post1.
      ls_wbs-posnr = <fs_prpss>-pspnr.      "internal WBS number
      ls_wbs-kostl = iv_kostl.              "inherit from header
      ls_wbs-imprf = <fs_prpss>-imprf.
      ls_wbs-vkokr = <fs_prpss>-pkokr.
      ls_wbs-prart = <fs_prpss>-prart.
      ls_wbs-bukrs = <fs_prpss>-pbukr.

      APPEND ls_wbs TO ct_wbs_items.

      "Push sibling first, then child (so child processed first)
      IF <fs_prhis>-right IS NOT INITIAL.
        APPEND <fs_prhis>-right TO lt_stack.
      ENDIF.
      IF <fs_prhis>-down IS NOT INITIAL.
        APPEND <fs_prhis>-down TO lt_stack.
      ENDIF.

    ENDWHILE.

  ENDMETHOD.


