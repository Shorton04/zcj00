        r_stati TYPE RANGE OF jest-stat,
        r_state TYPE RANGE OF jest-stat,
        r_auart TYPE RANGE OF aufk-auart,
        r_erdat TYPE RANGE OF aufk-erdat,
        r_idat2 TYPE RANGE OF aufk-idat2,
        r_gstri TYPE RANGE OF afko-gstri,
        r_getri TYPE RANGE OF afko-getri,
        r_iwerk TYPE RANGE OF afih-iwerk,
        r_ingpr TYPE RANGE OF afih-ingpr,
        r_priok TYPE RANGE OF afih-priok,
        r_ilart TYPE RANGE OF afih-ilart,
        r_vaplz TYPE RANGE OF aufk-vaplz,
        r_kostl TYPE RANGE OF aufk-kostl,
        r_tplnr TYPE RANGE OF iloa-tplnr,
        r_warpl TYPE RANGE OF mhio-warpl,
        r_nplda TYPE RANGE OF mhis-nplda,
        v_var   TYPE slis_vari,
      END OF ts_parameter.

    "--- Removed v_pmo / v_npmo from ts_parameter ---
    "--- No longer needed since flow is combined    ---

    TYPES:
      BEGIN OF ts_aufk,
        aufnr TYPE aufk-aufnr,
        auart TYPE aufk-auart,
        erdat TYPE aufk-erdat,
        idat2 TYPE aufk-idat2,
        vaplz TYPE aufk-vaplz,
