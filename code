  "═══════════════════════════════════════════════════════════════════
  " STEP 11: ASSIGN PLAN VALUES (BAPI_BUS2054_CHANGE_BUDGET)
  "═══════════════════════════════════════════════════════════════════
  DATA: lt_plan_line TYPE TABLE OF bapi_bus2054_plan_line,
        ls_plan_line TYPE bapi_bus2054_plan_line,
        lt_return_plan TYPE TABLE OF bapiret2,
        ls_return_plan TYPE bapiret2,
        lv_wbs_objnr TYPE j_objnr.

  " Loop through created WBS elements to assign plan values
  LOOP AT et_wbs_created INTO ls_wbs_created.

    " Skip Level 1 and items without budget
    IF ls_wbs_created-stufe = 1 OR ls_wbs_created-wert2 IS INITIAL.
      CONTINUE.
    ENDIF.

    " Get WBS object number
    SELECT SINGLE objnr FROM prps
      INTO lv_wbs_objnr
      WHERE posid = ls_wbs_created-posid.

    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    CLEAR: lt_plan_line, lt_return_plan.

    " Build plan line
    CLEAR ls_plan_line.
    ls_plan_line-wbs_element = ls_wbs_created-posid.
    ls_plan_line-plan_version = '0'.              " Version 0
    ls_plan_line-fiscal_year = lv_gjahr.
    ls_plan_line-period = lv_period.
    ls_plan_line-value_type = '01'.               " Plan values
    ls_plan_line-total_value = ls_wbs_created-wert2.
    ls_plan_line-currency = is_header-waers.

    APPEND ls_plan_line TO lt_plan_line.

    " Call BAPI to assign plan values
    CALL FUNCTION 'BAPI_BUS2054_CHANGE_BUDGET'
      EXPORTING
        wbs_element = ls_wbs_created-posid
      TABLES
        plan_line   = lt_plan_line
        return      = lt_return_plan.

    " Check for errors
    LOOP AT lt_return_plan INTO ls_return_plan 
      WHERE type = 'E' OR type = 'A'.
      MESSAGE ID ls_return_plan-id TYPE 'I' NUMBER ls_return_plan-number
        WITH ls_return_plan-message_v1 ls_return_plan-message_v2
             ls_return_plan-message_v3 ls_return_plan-message_v4
        DISPLAY LIKE 'E'.
    ENDLOOP.

    " Commit if no errors
    READ TABLE lt_return_plan TRANSPORTING NO FIELDS 
      WITH KEY type = 'E'.
    IF sy-subrc <> 0.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          wait = 'X'.
    ELSE.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    ENDIF.

  ENDLOOP.




  "═══════════════════════════════════════════════════════════════════
  " STEP 12: DISTRIBUTE IM BUDGET (BAPI_IMDISTRIBUTION_CHANGE)
  "═══════════════════════════════════════════════════════════════════
  DATA: lt_im_dist TYPE TABLE OF bapi_imdist,
        ls_im_dist TYPE bapi_imdist,
        lt_return_im TYPE TABLE OF bapiret2,
        ls_return_im TYPE bapiret2,
        lv_im_objnr TYPE j_objnr.

  " Get Level 1 WBS
  READ TABLE et_wbs_created INTO ls_level1_wbs 
    WITH KEY stufe = 1.

  IF sy-subrc = 0 AND ls_level1_wbs-wert2 IS NOT INITIAL 
                  AND is_header-posnr IS NOT INITIAL.

    " Get IM object number
    SELECT SINGLE objnr FROM impr
      INTO lv_im_objnr
      WHERE posnr = is_header-posnr.

    IF sy-subrc = 0.

      CLEAR: lt_im_dist, lt_return_im.

      " Build IM distribution line
      CLEAR ls_im_dist.
      ls_im_dist-program_pos = is_header-posnr.
      ls_im_dist-wbs_element = ls_level1_wbs-posid.
      ls_im_dist-fiscal_year = lv_gjahr.
      ls_im_dist-dist_value = ls_level1_wbs-wert2.
      ls_im_dist-currency = is_header-waers.

      APPEND ls_im_dist TO lt_im_dist.

      " Call BAPI to distribute IM budget
      CALL FUNCTION 'BAPI_IMDISTRIBUTION_CHANGE'
        EXPORTING
          program_position = is_header-posnr
          fiscal_year      = lv_gjahr
        TABLES
          distribution     = lt_im_dist
          return           = lt_return_im.

      " Check for errors
      LOOP AT lt_return_im INTO ls_return_im 
        WHERE type = 'E' OR type = 'A'.
        MESSAGE ID ls_return_im-id TYPE 'I' NUMBER ls_return_im-number
          WITH ls_return_im-message_v1 ls_return_im-message_v2
               ls_return_im-message_v3 ls_return_im-message_v4
          DISPLAY LIKE 'E'.
      ENDLOOP.

      " Commit if no errors
      READ TABLE lt_return_im TRANSPORTING NO FIELDS 
        WITH KEY type = 'E'.
      IF sy-subrc <> 0.
        CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
          EXPORTING
            wait = 'X'.
      ELSE.
        CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
      ENDIF.

    ENDIF.

  ENDIF.
