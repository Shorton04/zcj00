FORM get_im_available_budget_s2
  CHANGING cv_im_budget TYPE bpge-wlges
           cv_im_waers  TYPE imtp-waers.

  DATA: lv_objnr      TYPE j_objnr,
        lv_prnam      TYPE impr-prnam,
        lv_gjahr      TYPE impr-gjahr,
        lv_sum_wtges  TYPE bpge-wtges,
        lv_sum_wtgev  TYPE bpge-wtgev,
        lv_sum_wlgev  TYPE bpge-wlgev.

  CLEAR: cv_im_budget,
         cv_im_waers,
         lv_objnr,
         lv_prnam,
         lv_gjahr,
         lv_sum_wtges,
         lv_sum_wtgev,
         lv_sum_wlgev.

  " Get IM object number / program / year
  SELECT SINGLE objnr
                prnam
                gjahr
    INTO (lv_objnr, lv_prnam, lv_gjahr)
    FROM impr
    WHERE posnr = gs_header-posnr.

  IF sy-subrc <> 0
     OR lv_objnr IS INITIAL
     OR lv_prnam IS INITIAL
     OR lv_gjahr IS INITIAL.
    RETURN.
  ENDIF.

  " Get IM currency
  SELECT SINGLE waers
    INTO cv_im_waers
    FROM imtp
    WHERE prnam = lv_prnam
      AND gjahr = lv_gjahr.

  IF sy-subrc <> 0 OR cv_im_waers IS INITIAL.
    CLEAR cv_im_waers.
    RETURN.
  ENDIF.

  " Available IM budget = WTGES - WTGEV - WLGEV
  SELECT SUM( wtges )
         SUM( wtgev )
         SUM( wlgev )
    INTO (lv_sum_wtges, lv_sum_wtgev, lv_sum_wlgev)
    FROM bpge
    WHERE objnr = lv_objnr
      AND vorga = 'KBUD'
      AND twaer = cv_im_waers.

  IF sy-subrc = 0.
    cv_im_budget = lv_sum_wtges - lv_sum_wtgev - lv_sum_wlgev.
  ENDIF.

ENDFORM.




FORM get_exchange_rate_to_im
  USING    iv_im_waers      TYPE waers
           iv_proj_waers    TYPE waers
  CHANGING cv_ukurs         TYPE tcurr-ukurs.

  DATA: lt_tcurr TYPE STANDARD TABLE OF tcurr,
        ls_tcurr TYPE tcurr.

  CLEAR cv_ukurs.

  SELECT *
    INTO TABLE lt_tcurr
    FROM tcurr
    WHERE kurst = 'M'
      AND fcurr = iv_im_waers
      AND tcurr = iv_proj_waers.

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  SORT lt_tcurr BY gdatu ASCENDING.
  READ TABLE lt_tcurr INTO ls_tcurr INDEX 1.
  IF sy-subrc = 0.
    cv_ukurs = ls_tcurr-ukurs.
  ENDIF.

ENDFORM.



DATA: lv_im_budget       TYPE bpge-wlges,
      lv_level1_budget   TYPE bpge-wlges,
      lv_budget_im_curr  TYPE bpge-wlges,
      lv_im_waers        TYPE imtp-waers,
      lv_ukurs           TYPE tcurr-ukurs.

*---------------------------------------------------------------------*
* 5. Level 1 budget vs IM available budget
*---------------------------------------------------------------------*
PERFORM get_im_available_budget_s2
  CHANGING lv_im_budget
           lv_im_waers.

PERFORM get_level1_total_budget
  CHANGING lv_level1_budget.

" Optional: no level 1 budget entered
IF lv_level1_budget IS INITIAL.
  RETURN.
ENDIF.

" Optional: cannot validate if no IM currency found
IF lv_im_waers IS INITIAL.
  RETURN.
ENDIF.

" Convert Level 1 budget to IM currency if needed
IF gv_project_currency = lv_im_waers.

  lv_budget_im_curr = lv_level1_budget.

ELSE.

  PERFORM get_exchange_rate_to_im
    USING    lv_im_waers
             gv_project_currency
    CHANGING lv_ukurs.

  IF lv_ukurs IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Unable to determine exchange rate'.
    EXIT.
  ENDIF.

  lv_budget_im_curr = lv_level1_budget / lv_ukurs.

ENDIF.

" Final comparison
IF lv_budget_im_curr > lv_im_budget.
  MESSAGE e000(zmsg_a2r) WITH 'Amount is greater than the available IM budget'.
  EXIT.
ENDIF.