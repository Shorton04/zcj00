         lt_mhio      TYPE STANDARD TABLE OF ts_mhio,
         lt_iloa      TYPE STANDARD TABLE OF ts_iloa,
         lt_mhis      TYPE STANDARD TABLE OF ts_mhis.

    ls_parameter = is_parameter.

    validations( EXPORTING is_paramater = ls_parameter
                 IMPORTING ev_success   = lv_success ).

    CHECK lv_success = abap_true.

    IF ls_parameter-v_pmo = abap_true.
      get_data_pmo( EXPORTING is_parameter = ls_parameter
                    IMPORTING et_aufk      =  lt_aufk
                              et_afih      =  lt_afih
