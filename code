DATA: gt_wbs_items TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
      gs_wbs_item  TYPE ztb_a2r_wbsitem.

" FIX: align type with gt_wbs_items
DATA: ls_items TYPE ztb_a2r_wbsitem.


FORM download.

  TYPES: BEGIN OF ty_download,
           pspid   TYPE ztb_a2r_wbsitem-pspid,
           zchange TYPE ztb_a2r_wbsitem-zchange,
           stufe   TYPE ztb_a2r_wbsitem-stufe,
           post1   TYPE ztb_a2r_wbsitem-post1,
           budget  TYPE ztb_a2r_wbsitem-zbudget_check,
         END OF ty_download,
         BEGIN OF ts_fieldnames,
           fieldname TYPE char50,
         END OF ts_fieldnames.

  DATA: ls_download   TYPE ty_download,
        lt_download   TYPE TABLE OF ty_download,
        lt_fieldnames TYPE STANDARD TABLE OF ts_fieldnames,
        ls_fieldnames TYPE ts_fieldnames.

  DATA: lv_action   TYPE i,
        lv_filename TYPE string,
        lv_fullpath TYPE string,
        lv_path     TYPE string.

  "Append header to the Excel file.
  ls_fieldnames-fieldname = 'Level'.
  APPEND ls_fieldnames TO lt_fieldnames.
  CLEAR ls_fieldnames.

  ls_fieldnames-fieldname = 'WBS Element'.
  APPEND ls_fieldnames TO lt_fieldnames.
  CLEAR ls_fieldnames.

  ls_fieldnames-fieldname = 'Description'.
  APPEND ls_fieldnames TO lt_fieldnames.
  CLEAR ls_fieldnames.

  ls_fieldnames-fieldname = 'Budget'.
  APPEND ls_fieldnames TO lt_fieldnames.
  CLEAR ls_fieldnames.

  LOOP AT gt_wbs_items INTO ls_items.
    ls_download-stufe  = ls_items-stufe.
    ls_download-post1  = ls_items-post1.
    ls_download-pspid  = ls_items-pspid.
    ls_download-budget = ls_items-zbudget_check.

    APPEND ls_download TO lt_download.
    CLEAR ls_download.
  ENDLOOP.

  CALL METHOD cl_gui_frontend_services=>file_save_dialog
    EXPORTING
      window_title      = 'Please Select the location'
      default_extension = 'XLSX'
      default_file_name = 'Capex_template.xls'
      file_filter       = '*.xls'
    CHANGING
      filename          = lv_filename
      path              = lv_path
      fullpath          = lv_fullpath
      user_action       = lv_action.

  IF NOT lv_action IS INITIAL.
    EXIT.
  ENDIF.

  CALL METHOD cl_gui_frontend_services=>gui_download
    EXPORTING
      filename              = lv_filename
      filetype              = 'ASC'
      write_field_separator = 'X'
      fieldnames            = lt_fieldnames
    CHANGING
      data_tab              = lt_download.

ENDFORM.