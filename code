  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    " ... existing public methods ...

  PRIVATE SECTION.
    " ... existing private methods ...
    
    METHODS bdc_dynpro
      IMPORTING
