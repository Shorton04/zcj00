REPORT ztr_a2r_inspec_chars_upload.

INCLUDE ztr_a2r_inspec_chars_top.
INCLUDE ztr_a2r_inspec_chars_sel.
INCLUDE ztr_a2r_inspec_chars_f01.

TYPES : BEGIN OF ts_file,
          plnty        TYPE string, "TL Type
          plnnr        TYPE string, "TL Group
          plnal        TYPE string, "TL Group Counter
          vornr        TYPE string, "Operation/Activity
          merknr       TYPE string,
          quantitat    TYPE string,   "Quantitative check
          qualitat     TYPE string,   "Qualitative check
          verwmerkm    TYPE string,     "Master Inspection Characterstics "Plant , Version fields reqd?
          kurztext     TYPE string,    "Short Text
          ltextkz      TYPE string,   "Long text exists indicator
          ltext        TYPE string,   "Long Text
          langu        TYPE string,
          pmethode     TYPE string,   "Inspection Method
          qmtb_werks   TYPE string, "Plant for Inspection Method
          pmtversion   TYPE string,     "Version Number for Inspection Method
          stichprver   TYPE string,   "Sampling Procedure in Inspection Characteristic
**********************Qualitative Characteritic and Quantitative Control Indicators***********************************
          "Type ---> Qualitative
          pruefkat     TYPE string,      "Reference to Characteristic Attribute Required check
          "Sample -->Both
          stichpr      TYPE string,    "Sampling Procedure is Required check
          addpro       TYPE string,      "Additive Sample check
          qspcmk       TYPE string,       "SPC Characteristic check
          zerstprf     TYPE string,   "Destructive Inspection check
          "Results Confirmation ---> Both
          "   Summarized recording
          " +	Single-value recording
          " -	No results recording
          " *	Classed recording
          estukz       TYPE  string,

          fehlrec      TYPE string,    "Defects Recording Automatically Called Up check
          " X	Required characteristic
          "   Optional characteristic
          " +	Required when previous required characteristic is accepted
          " -	Required when previous required characteristic is rejected
          rzwang       TYPE  string,
          "NEXT SCREEN
          "Docu. Confirmation(RB)  ---> Both
          "	  Text documentation of test values is not required
          " . The test values with valuation R (reject) must be documented
          " +	All test values must be documented with text
          dokukz       TYPE  string,
          "Insp. Scope(RB)   ---> Both
          "   Scope not fixed
          " =	Fixed inspection scope
          " <	Smaller inspection scope allowed
          " >	Larger inspection scope allowed
          pumfkz       TYPE  string,
          "Miscellaneous(CB)   ---> Both
          lzeitkz      TYPE string,    "Long-Term Inspection
          ausslos      TYPE string,     "Scrap share/ Q- score
          aendbeleg    TYPE string,    "RR change docs
          pmmzwang     TYPE string,       "Test Equipment Assignment
          "Quantitative Specific -> Miscellaneous
          messwerte    TYPE string,     "Measured values must be recorded
          "Print(RB)   ---> Both
          "   Print
          " X	Do not print
          " *	Do not print at skip
          keindruck    TYPE  string,
          "Catalog
          katab1       TYPE  string, " Catalog Entry Is a Selected Set
          katalgart1   TYPE  string, " Catalog Type of Assigned Code Group or Selected Set
          auswmenge1   TYPE  string, "  Assigned Code Group or Selected Set
          auswmgwrk1   TYPE  string,  " Plant of the Assigned Selected Set

          "Quantitative Specific
          "Type(CB)
          tolerunten   TYPE string,    "Lower limit check
          toleroben    TYPE string,    "Upper limit check
          sollpruef	   TYPE string,   "Target Value check
          "Formula(RB)
          "  	No Formula
          " 1	Input Processing
          " X	Calculated Characteristic
          formelmk     TYPE  string,
          "Quantitative Data
          sollwert_c   TYPE string,  "Target value
          toleranzun_c TYPE string,  "Lower Limit
          toleranzob_c TYPE string,  "Upper Limit
          stellen      TYPE string,  "Decimal Places
          masseinhsw   TYPE string,  "UOM
          toleranzsl   TYPE string,    "Tolerance key
          plausioben_c TYPE  string  , "Upper Plausibility Limit
          plausiunte_c TYPE  string ,  "Lower Plausibility Limit
        END OF ts_file,
        BEGIN OF ts_error,
          icon   TYPE icons-text,
          plnnr  TYPE plnnr,
          plnal  TYPE plnal,
          vornr  TYPE vornr,
          merknr TYPE qmerknrp,
          line   TYPE string, "char255,
        END OF ts_error,
        BEGIN OF ts_key,
          plnty  TYPE plnty,
          plnnr  TYPE plnnr, "TL Group
          plnal  TYPE plnal,
          vornr  TYPE vornr,
          plnkn  TYPE plnkn,   "Node
          merknr TYPE qmerknrp,
        END OF ts_key,
        BEGIN OF ts_line,
          td_line TYPE tdline,
        END OF ts_line.
DATA : lt_file          TYPE TABLE OF ts_file,
       lt_dup_chk       TYPE TABLE OF ts_file,
       ls_file          TYPE ts_file,
       lt_file_t        TYPE STANDARD TABLE OF ts_key,
       lt_file_c        TYPE TABLE OF ts_key,
       lt_split         TYPE TABLE OF ts_line,
       ls_plmkb         TYPE plmkb,
       ls_tca01_imp     LIKE tca01,
       ls_qkst          TYPE qmkst,
       lt_raw           TYPE truxs_t_text_data,
       ls_tline         TYPE tline,
       lt_tline         TYPE TABLE OF tline,
       lv_tdname        TYPE tdobname,
       lv_string        TYPE string,
       lt_thead         TYPE /merp/core_thead_tab,
       ls_thead         TYPE thead,
       lt_error         TYPE TABLE OF ts_error,
       lt_keys          TYPE STANDARD TABLE OF plmk,
       lv_file          TYPE  string,
       lt_bin           TYPE solix_tab,
       lv_fl            TYPE i,
       lv_buf           TYPE xstring,
       lv_sollwert      TYPE qsollwertc,  "Target value
       lv_toleranzun    TYPE qtolunc,     "Lower Limit
       lv_toleranzob    TYPE qtolobc,     "Upper Limit
       lv_plausioben    TYPE qplausiob, "Upper Plausibility Limit
       lv_plausiunte    TYPE qplausiun,
       lv_plnty         TYPE plnty,
       lv_plnnr         TYPE plnnr,
       lv_merknr        TYPE qmerknrp,
       lt_return        TYPE  bapiret2,
       ls_data(1000),
       lt_data          LIKE TABLE OF ls_data,
       lv_chk(1),
       lv_execute       TYPE flag,
       lo_table_descr   TYPE REF TO cl_abap_tabledescr,
       lo_struct_descr  TYPE REF TO cl_abap_structdescr,
       lo_exception     TYPE REF TO cx_root,
       lt_operation     TYPE eam_t_plpod,
       lv_vornr         TYPE vornr,
       lv_plnal         TYPE plnal,
       lt_errors        TYPE lop_tdline_tab,
       gv_zmvt0134_flag TYPE flag,
       lv_status_icon   TYPE icons-text,
       lv_icon_name(20) TYPE c,
       lv_text_start    TYPE i VALUE IS INITIAL.

CONSTANTS: lc_tdobject TYPE tdobject VALUE 'QSS',
           lc_tdid     TYPE tdid VALUE 'QM',
           lc_delim    TYPE c VALUE ';'.

FIELD-SYMBOLS:  <fs_clear> TYPE any.


PARAMETERS: p_file   TYPE localfile,
            p_bfile  TYPE localfile,
            p_cbg    AS CHECKBOX USER-COMMAND ent,
            p_header TYPE /fti/de_counter.

AT SELECTION-SCREEN ON p_cbg.
  IF p_cbg = abap_true.
    lv_chk = abap_true.
  ELSE.
    lv_chk = abap_false.
  ENDIF.

AT SELECTION-SCREEN OUTPUT.

  LOOP AT SCREEN.
    IF  screen-name  = 'P_FILE' OR screen-name = '%_P_FILE_%_APP_%-TEXT'.
      IF lv_chk = abap_false.
        screen-active = 1.
      ELSE.
        screen-active = 0.
      ENDIF.
    ELSEIF  screen-name  = 'P_BFILE' OR screen-name = '%_P_BFILE_%_APP_%-TEXT'.
      IF lv_chk = abap_true.
        screen-active = 1.
      ELSE.
        screen-active = 0.
      ENDIF.
    ENDIF.
    MODIFY SCREEN.
  ENDLOOP.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR p_file.

  CALL FUNCTION 'KD_GET_FILENAME_ON_F4'
    EXPORTING
      static    = 'X'
    CHANGING
      file_name = p_file.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR p_bfile.
  CALL FUNCTION '/SAPDMC/LSM_F4_SERVER_FILE'
    EXPORTING
      directory        = '\\CHVFS02\SAPDOWN\PM'
*     FILEMASK         = ' '
    IMPORTING
      serverfile       = p_bfile
    EXCEPTIONS
      canceled_by_user = 1
      OTHERS           = 2.
  IF sy-subrc <> 0.
    MESSAGE TEXT-t01 TYPE 'E'.
  ENDIF.


START-OF-SELECTION.
  CLEAR : lv_execute.
  " Authorization Check
  AUTHORITY-CHECK OBJECT 'I_TCODE'
  ID 'TCD' FIELD 'IA06'.
  IF sy-subrc <> 0.
    MESSAGE TEXT-t09 TYPE 'E'.
    lv_execute = abap_false.
  ELSE.
    lv_execute = abap_true.
  ENDIF.

  IF lv_execute = abap_true.
    lv_file = p_bfile.
    " Background Processing
    IF sy-batch = abap_true.
      OPEN DATASET lv_file FOR INPUT IN BINARY MODE.
      IF sy-subrc = 0.
        READ DATASET lv_file INTO lv_buf.
        IF sy-subrc <> 0 .
          MESSAGE 'File not read from Al11 folder' TYPE 'E'.
        ENDIF.
      ENDIF.
      CLOSE DATASET lv_file.
    ELSE.
      " Foreground Processing
      lv_file = p_file.
      CALL FUNCTION 'GUI_UPLOAD'
        EXPORTING
          filename   = lv_file
          filetype   = 'BIN'
        IMPORTING
          filelength = lv_fl
          header     = lv_buf
        TABLES
          data_tab   = lt_bin.
      IF sy-subrc = 0.
        CALL FUNCTION 'SCMS_BINARY_TO_XSTRING'
          EXPORTING
            input_length = lv_fl
          IMPORTING
            buffer       = lv_buf
          TABLES
            binary_tab   = lt_bin
          EXCEPTIONS
            failed       = 1
            OTHERS       = 2.
** Implement suitable error handling here
      ENDIF.
    ENDIF.

    IF lv_file IS NOT INITIAL AND lv_buf IS NOT INITIAL.
      TRY .
          DATA(lo_excel_ref) = NEW cl_fdt_xl_spreadsheet(
                                   document_name = lv_file
                                   xdocument     = lv_buf ) .
          "Get List of Worksheets
          lo_excel_ref->if_fdt_doc_spreadsheet~get_worksheet_names(
            IMPORTING
              worksheet_names = DATA(lt_worksheets) ).
        CATCH cx_fdt_excel_core.
          "Implement suitable error handling here
      ENDTRY .
      FIELD-SYMBOLS : <gt_data> TYPE STANDARD TABLE.
      IF NOT lt_worksheets IS INITIAL.
        READ TABLE lt_worksheets INTO DATA(lv_woksheetname) INDEX 1.
        DATA(lo_data_ref) = lo_excel_ref->if_fdt_doc_spreadsheet~get_itab_from_worksheet(
                                                 lv_woksheetname ).
        "Excel work sheet data in dynamic internal table
        ASSIGN lo_data_ref->* TO <gt_data>.
        TRY.
*     Use RTTI services to describe table variable
            lo_table_descr ?= cl_abap_tabledescr=>describe_by_data( p_data = <gt_data> ).
*     Use RTTI services to describe table structure
            lo_struct_descr ?= lo_table_descr->get_table_line_type( ).

*     Count number of columns in structure
            DATA(lv_data_count) = lines( lo_struct_descr->components ).

*     Use RTTI services to describe table variable
            lo_table_descr ?= cl_abap_tabledescr=>describe_by_data( p_data = lt_file ).
*     Use RTTI services to describe table structure
            lo_struct_descr ?= lo_table_descr->get_table_line_type( ).

*     Count number of columns in structure
            DATA(lv_file_count) = lines( lo_struct_descr->components ).

            IF lv_file_count = lv_data_count.
              lt_file[] = <gt_data>.
            ELSE.
              MESSAGE TEXT-t02 TYPE 'I'.
            ENDIF.
          CATCH cx_sy_move_cast_error.
        ENDTRY.
      ENDIF.
    ENDIF.


    IF lt_file IS NOT INITIAL.
      DELETE lt_file FROM 1 TO p_header.  " Header row
      SORT lt_file BY plnnr plnal vornr merknr.

      lt_file_c = VALUE #( FOR ls_files IN lt_file ( plnty = ls_files-plnty
                                             plnnr = |{ ls_files-plnnr ALPHA = IN }|
                                             plnal = |{ ls_files-plnal ALPHA = IN }|
                                             merknr = ls_files-merknr
                                             vornr = |{ ls_files-vornr ALPHA = IN }| ) ).
      IF lt_file_c IS NOT INITIAL.
        " Get node number based on operation/Activity
        LOOP AT lt_file_c ASSIGNING FIELD-SYMBOL(<fs_file_c>).
          IF <fs_file_c> IS ASSIGNED.
            CALL FUNCTION 'EAM_TASKLIST_GET_DETAIL'
              EXPORTING
                iv_plnty      = <fs_file_c>-plnty
                iv_plnnr      = <fs_file_c>-plnnr
                iv_plnal      = <fs_file_c>-plnal
                iv_date       = sy-datum
              TABLES
                et_operations = lt_operation.
            IF lt_operation IS NOT INITIAL.
              IF line_exists( lt_operation[ plnty = <fs_file_c>-plnty plnnr = <fs_file_c>-plnnr vornr = <fs_file_c>-vornr ] ).
                <fs_file_c>-plnkn = lt_operation[ plnty = <fs_file_c>-plnty plnnr = <fs_file_c>-plnnr vornr = <fs_file_c>-vornr ]-plnkn .
              ENDIF.
            ENDIF.
          ENDIF.
        ENDLOOP.
      ENDIF.

      "Object Instantiation for Validation class
      DATA(lo_validate) = NEW zcl_a2r_inspec_chars_upload( ).

      LOOP AT lt_file INTO ls_file.
        CLEAR : ls_plmkb,ls_qkst,lv_sollwert,lv_toleranzob,lv_toleranzun,lv_plausioben,lv_plausiunte,lv_vornr,lv_plnal,lt_errors.
        TRY.
            MOVE-CORRESPONDING ls_file TO ls_plmkb.
            ls_plmkb-plnnr = |{ ls_plmkb-plnnr ALPHA = IN }|.
            AT NEW plnal.
              lv_plnal = ls_file-plnal.
              lv_plnal = |{ lv_plnal ALPHA = IN }|.
              "Call the Tasklist validation method
              lo_validate->check_tasklist_details(
                EXPORTING
                  iv_plnnr  =  ls_plmkb-plnnr   " Task List Group
                  iv_plnty  =  ls_plmkb-plnty   " Task List Type
                  iv_plnal  =  lv_plnal   " Group Counter
*                  iv_vornr  =  ls_file-vornr   " Operation/Activity Number
                IMPORTING
                  et_errors =  lt_errors   " Text Line
              ).
              IF lt_errors IS NOT INITIAL.
                LOOP AT lt_errors INTO DATA(ls_errors).
                  APPEND INITIAL LINE TO lt_error ASSIGNING FIELD-SYMBOL(<fs_error>).
                  IF <fs_error> IS ASSIGNED.
                    <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'E' ).
                    <fs_error>-plnnr = ls_file-plnnr.
                    <fs_error>-plnal = ls_file-plnal.
                    <fs_error>-vornr = ls_file-vornr.
                    <fs_error>-merknr = ls_file-merknr.
                    <fs_error>-line  = ls_errors.
                  ENDIF.
                ENDLOOP.
                CONTINUE.
              ENDIF.
              " Check whether Inspection point is specified in the header
              SELECT SINGLE slwbez FROM plko INTO @DATA(lv_insp_point) WHERE plnty = @ls_plmkb-plnty AND plnnr = @ls_plmkb-plnnr AND plnal = @lv_plnal.
            ENDAT.
            IF lv_insp_point IS NOT INITIAL.
              IF ls_file-merknr IS NOT INITIAL.
                IF ( ls_file-quantitat IS NOT INITIAL OR ls_file-qualitat IS NOT INITIAL ) AND NOT ( ls_file-quantitat = abap_true AND ls_file-qualitat = abap_true ).
                  lv_sollwert = ls_file-sollwert_c.
                  ls_plmkb-sollwert = lv_sollwert.
                  IF ls_plmkb-sollwert IS NOT INITIAL.
                    ls_plmkb-sollwni = abap_true.
                  ENDIF.
                  lv_toleranzob = ls_file-toleranzob_c.
                  ls_plmkb-toleranzob = lv_toleranzob.
                  IF ls_plmkb-toleranzob IS NOT INITIAL.
                    ls_plmkb-tolobni = abap_true.
                  ENDIF.
                  lv_toleranzun = ls_file-toleranzun_c.
                  ls_plmkb-toleranzun = lv_toleranzun.
                  IF ls_plmkb-toleranzun IS NOT INITIAL.
                    ls_plmkb-tolunni = abap_true.
                  ENDIF.
                  lv_plausioben = ls_file-plausioben_c.
                  ls_plmkb-plausioben = lv_plausioben.
                  IF ls_plmkb-plausioben IS NOT INITIAL.
                    ls_plmkb-plausiobni = abap_true.
                  ENDIF.
                  lv_plausiunte = ls_file-plausiunte_c.
                  ls_plmkb-plausiunte = lv_plausiunte.
                  IF ls_plmkb-plausiunte IS NOT INITIAL.
                    ls_plmkb-plausiunni = abap_true.
                  ENDIF.
                  DATA(lv_langu) = ls_file-langu.
                  IF lv_langu IS NOT INITIAL.
                    CALL FUNCTION 'CONVERSION_EXIT_ISOLA_INPUT'
                      EXPORTING
                        input            = lv_langu
                      IMPORTING
                        output           = ls_plmkb-ltextspr
                      EXCEPTIONS
                        unknown_language = 1
                        OTHERS           = 2.
                    IF sy-subrc <> 0.
* Implement suitable error handling here
                      APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
                      IF <fs_error> IS ASSIGNED.
                        <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'E' ).
                        <fs_error>-plnnr = ls_file-plnnr.
                        <fs_error>-plnal = ls_file-plnal.
                        <fs_error>-vornr = ls_file-vornr.
                        <fs_error>-merknr = ls_file-merknr.
                        <fs_error>-line  = TEXT-t10.
                      ENDIF.
                      CONTINUE.
                    ENDIF.
                  ENDIF.
                  MOVE-CORRESPONDING ls_file TO ls_qkst.
                  CLEAR : lv_plnal.
                  lv_plnal = ls_file-plnal.
                  lv_vornr = ls_file-vornr.
                  CLEAR : ls_plmkb-plnkn.
                  IF line_exists( lt_file_c[ plnty = ls_plmkb-plnty plnnr = ls_plmkb-plnnr plnal = |{ lv_plnal ALPHA = IN }| vornr = |{ lv_vornr ALPHA = IN }| ] ).
                    ls_plmkb-plnkn = lt_file_c[ plnty = ls_plmkb-plnty plnnr = ls_plmkb-plnnr  plnal = |{ lv_plnal ALPHA = IN }| vornr = |{ lv_vornr ALPHA = IN }| ]-plnkn.
                  ENDIF.
                  ls_plmkb-steuerkz = ls_qkst.
                  ls_plmkb-gueltigab = sy-datum.
                  ls_plmkb-plnnr = |{ ls_plmkb-plnnr ALPHA = IN }|.
                  ls_plmkb-pmtversion = |{ ls_plmkb-pmtversion ALPHA = IN }|.
                  SPLIT ls_plmkb-kurztext AT cl_abap_char_utilities=>cr_lf INTO DATA(lv_text) DATA(lv_dummy).
                  ls_plmkb-kurztext = lv_text.

* Check whether Selected Set along with the plant is filled for Qualitative Characteristic if Catalog entry is selected
                  IF ls_file-qualitat =  abap_true AND ls_file-katab1 = abap_true.
                    IF ls_file-katalgart1 IS INITIAL.
                      ls_plmkb-katalgart1 = 1. "Characteristic attribute
                    ENDIF.
                    IF NOT ( ls_plmkb-auswmenge1 IS NOT INITIAL
                    AND ls_plmkb-auswmgwrk1 IS NOT INITIAL ).
                      APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
                      IF <fs_error> IS ASSIGNED.
                        <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'E' ).
                        <fs_error>-plnnr = ls_file-plnnr.
                        <fs_error>-plnal = ls_file-plnal.
                        <fs_error>-vornr = ls_file-vornr.
                        <fs_error>-merknr = ls_file-merknr.
                        <fs_error>-line  = TEXT-t12.
                      ENDIF.
                      CONTINUE.
                    ENDIF.
                  ENDIF.
* Check whether there is any duplicate key entry from the file
                  IF line_exists( lt_dup_chk[ plnnr = ls_file-plnnr plnal = ls_file-plnal vornr = ls_file-vornr merknr = ls_file-merknr ] ).
                    APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
                    IF <fs_error> IS ASSIGNED.
                      <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'E' ).
                      <fs_error>-plnnr = ls_file-plnnr.
                      <fs_error>-plnal = ls_file-plnal.
                      <fs_error>-vornr = ls_file-vornr.
                      <fs_error>-merknr = ls_file-merknr.
                      <fs_error>-line  = |{ TEXT-t13 } - { ls_plmkb-kurztext } |.
                    ENDIF.
                    CONTINUE.
                  ENDIF.
* Check whether the key Already exists in PLMK table
                  SELECT  loekz,zaehl FROM plmk UP TO 1 ROWS INTO @DATA(ls_plmk) WHERE plnty = @ls_plmkb-plnty
                                                                           AND   plnnr = @ls_plmkb-plnnr
                                                                           AND   plnkn = @ls_plmkb-plnkn
                                                                           AND   merknr = @ls_plmkb-merknr ORDER BY zaehl DESCENDING.
                  ENDSELECT.
                  " Primary key shouldn't exists or should exist with a deletion indicator
                  IF ( sy-subrc = 0 AND ls_plmk-loekz EQ abap_true ) OR sy-subrc <> 0.
                    CLEAR: lt_errors.
                    "Call the methods of Validation class to validate the values in structure PLMKB
                    lo_validate->validate_data(
                      EXPORTING
                        is_plmkb  =  ls_plmkb   " Inspection characteristic - document table
                        is_file   =  ls_file
                      IMPORTING
                        et_errors =  lt_errors   " Text Line
                    ).
                    IF lt_errors IS NOT INITIAL.
                      CLEAR : ls_errors.
                      LOOP AT lt_errors INTO ls_errors.
                        APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
                        IF <fs_error> IS ASSIGNED.
                          <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'E' ).
                          <fs_error>-plnnr = ls_file-plnnr.
                          <fs_error>-plnal = ls_file-plnal.
                          <fs_error>-vornr = ls_file-vornr.
                          <fs_error>-merknr = ls_file-merknr.
                          <fs_error>-line  = ls_errors.
                        ENDIF.
                      ENDLOOP.
                      CONTINUE.
                    ELSE.
                      " Insert the data to PLANMK ( PLMK Internal buffer table )
                      CALL FUNCTION 'CQ_BT_PLMK_INSERT'
                        EXPORTING
                          plmk_ins = ls_plmkb.
                      IF sy-subrc = 0.
                        CALL FUNCTION 'CQ_BT_QSS_UPDATE_TO_DB_SINGLE'
                          EXPORTING
                            iv_plnty = ls_plmkb-plnty
                            iv_plnnr = ls_plmkb-plnnr.
                        IF sy-subrc = 0.
                          CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
                            EXPORTING
                              wait   = 'X'
                            IMPORTING
                              return = lt_return.
                        ENDIF.
                        IF lt_return IS NOT INITIAL .
                          APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
                          IF <fs_error> IS ASSIGNED.
                            <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'E' ).
                            <fs_error>-plnnr = ls_file-plnnr.
                            <fs_error>-plnal = ls_file-plnal.
                            <fs_error>-vornr = ls_file-vornr.
                            <fs_error>-merknr = ls_file-merknr.
                            <fs_error>-line  = TEXT-t15.
                          ENDIF.
                          ROLLBACK WORK.
                        ELSE.
                          APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
                          IF <fs_error> IS ASSIGNED.
                            <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'S' ).
                            <fs_error>-plnnr = ls_file-plnnr.
                            <fs_error>-plnal = ls_file-plnal.
                            <fs_error>-vornr = ls_file-vornr.
                            <fs_error>-merknr = ls_file-merknr.
                            <fs_error>-line  = TEXT-t14.
                          ENDIF.
                        ENDIF.
                      ENDIF.
                    ENDIF.
                  ELSE.
                    APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
                    IF <fs_error> IS ASSIGNED.
                      <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'E' ).
                      <fs_error>-plnnr = ls_file-plnnr.
                      <fs_error>-plnal = ls_file-plnal.
                      <fs_error>-vornr = ls_file-vornr.
                      <fs_error>-merknr = ls_file-merknr.
                      <fs_error>-line  = TEXT-t03.
                    ENDIF.
                    CONTINUE.
                  ENDIF.
                ELSE.
                  APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
                  IF <fs_error> IS ASSIGNED.
                    <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'E' ).
                    <fs_error>-plnnr = ls_file-plnnr.
                    <fs_error>-plnal = ls_file-plnal.
                    <fs_error>-vornr = ls_file-vornr.
                    <fs_error>-merknr = ls_file-merknr.
                    <fs_error>-line  = TEXT-t11.
                  ENDIF.
                  CONTINUE.
                ENDIF.
              ELSE.
                APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
                IF <fs_error> IS ASSIGNED.
                  <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'E' ).
                  <fs_error>-plnnr = ls_file-plnnr.
                  <fs_error>-plnal = ls_file-plnal.
                  <fs_error>-vornr = ls_file-vornr.
                  <fs_error>-merknr = ls_file-merknr.
                  <fs_error>-line  = TEXT-t16.
                ENDIF.
                CONTINUE.
              ENDIF.
            ELSE.
              APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
              IF <fs_error> IS ASSIGNED.
                <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'E' ).
                <fs_error>-plnnr = ls_file-plnnr.
                <fs_error>-plnal = ls_file-plnal.
                <fs_error>-vornr = ls_file-vornr.
                <fs_error>-merknr = ls_file-merknr.
                MESSAGE ID 'QP' TYPE 'S' NUMBER '520' INTO DATA(lv_msg).
                <fs_error>-line  = lv_msg .
              ENDIF.
              CONTINUE.
            ENDIF.
          CATCH cx_root INTO lo_exception."cx_sy_open_sql_db .
            APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
            IF <fs_error> IS ASSIGNED.
              <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'E' ).
              <fs_error>-plnnr = ls_file-plnnr.
              <fs_error>-plnal = ls_file-plnal.
              <fs_error>-vornr = ls_file-vornr.
              <fs_error>-merknr = ls_file-merknr.
              <fs_error>-line  = lo_exception->get_longtext( ).
            ENDIF.
        ENDTRY.
        APPEND ls_file TO lt_dup_chk.
      ENDLOOP.

* Create Long text for inspection characteristics
      IF lt_file_c IS NOT INITIAL.
        SORT lt_file_c BY plnty plnnr plnkn merknr.
        SELECT  plnty,
                plnnr,
                plnkn,
                kzeinstell,
                merknr,
                zaehl,
                ltextkz,
                ltextspr,
                loekz
        FROM plmk
        INTO CORRESPONDING FIELDS OF TABLE @lt_keys
        FOR ALL ENTRIES IN @lt_file_c
        WHERE plnty = @lt_file_c-plnty
        AND  plnnr =  @lt_file_c-plnnr
        AND  plnkn = @lt_file_c-plnkn
        AND  merknr = @lt_file_c-merknr
        AND loekz NE @abap_true.
        IF sy-subrc <> 0.
          APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
          IF <fs_error> IS ASSIGNED.
            <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'E' ).
            <fs_error>-plnnr = ls_file-plnnr.
            <fs_error>-plnal = ls_file-plnal.
            <fs_error>-vornr = ls_file-vornr.
            <fs_error>-merknr = ls_file-merknr.
            <fs_error>-line  = TEXT-t04.
          ENDIF.
        ENDIF.
      ENDIF.
      IF lt_keys IS NOT INITIAL.
        SORT lt_keys BY  plnty plnnr plnkn merknr.
        DELETE ADJACENT DUPLICATES FROM lt_keys COMPARING ALL FIELDS.
        CLEAR: ls_file.
        LOOP AT lt_file INTO ls_file.
          /merp/cl_core_omdo_tools=>convert_string_to_text_table( EXPORTING  iv_text_string  = ls_file-ltext
                                                            IMPORTING  et_text_table = lt_tline ).
          AT END OF merknr.
            CLEAR : lv_plnnr, lv_vornr,lv_merknr.
            lv_plnnr = ls_file-plnnr.
            lv_vornr = ls_file-vornr.
            lv_merknr = ls_file-merknr.
            IF line_exists( lt_file_c[ plnty = ls_file-plnty plnnr = |{ lv_plnnr ALPHA = IN }| vornr = |{ lv_vornr ALPHA = IN }| merknr = |{ lv_merknr ALPHA = IN }| ]  ). "plnkn_o = ls_file-plnkn
              DATA(ls_file_c) =  lt_file_c[ plnty = ls_file-plnty plnnr = |{ lv_plnnr ALPHA = IN }| vornr = |{ lv_vornr ALPHA = IN }| merknr = |{ lv_merknr ALPHA = IN }| ].
              IF line_exists( lt_keys[ plnty = ls_file_c-plnty plnnr = ls_file_c-plnnr plnkn = ls_file_c-plnkn merknr = ls_file_c-merknr ]  ).
                DATA(ls_keys) = lt_keys[ plnty = ls_file_c-plnty plnnr = ls_file_c-plnnr plnkn = ls_file_c-plnkn merknr = ls_file_c-merknr ] .
                CONCATENATE sy-mandt ls_keys-plnty ls_keys-plnnr ls_keys-plnkn ls_keys-kzeinstell ls_keys-merknr ls_keys-zaehl INTO lv_string RESPECTING BLANKS.
                MOVE lv_string TO lv_tdname.
              ENDIF.
            ENDIF.
            ls_thead-tdobject = lc_tdobject.
            ls_thead-tdname = lv_tdname.
            ls_thead-tdid = lc_tdid.
            IF ls_keys-ltextspr IS NOT INITIAL.
              ls_thead-tdspras = ls_keys-ltextspr.
            ELSE.
              ls_thead-tdspras = sy-langu.
            ENDIF.

            CALL FUNCTION 'SAVE_TEXT'
              EXPORTING
                client          = sy-mandt
                header          = ls_thead
                savemode_direct = abap_true
              TABLES
                lines           = lt_tline
              EXCEPTIONS
                id              = 1
                language        = 2
                name            = 3
                object          = 4
                OTHERS          = 5.
            IF sy-subrc = 0.
              APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
              IF <fs_error> IS ASSIGNED.
                <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'S' ).
                <fs_error>-plnnr = ls_file-plnnr.
                <fs_error>-plnal = ls_file-plnal.
                <fs_error>-vornr = ls_file-vornr.
                <fs_error>-merknr = ls_file-merknr.
                <fs_error>-line  = TEXT-t06.
              ENDIF.
            ELSE.
* Implement suitable error handling here
              APPEND INITIAL LINE TO lt_error ASSIGNING <fs_error>.
              IF <fs_error> IS ASSIGNED.
                <fs_error>-icon  = lo_validate->icon_indicator( iv_msg_type = 'E' ).
                <fs_error>-plnnr = ls_file-plnnr.
                <fs_error>-plnal = ls_file-plnal.
                <fs_error>-vornr = ls_file-vornr.
                <fs_error>-merknr = ls_file-merknr.
                <fs_error>-line  = TEXT-t05.
              ENDIF.
            ENDIF.
            CLEAR : ls_tline,lt_tline.
          ENDAT.
        ENDLOOP.
      ENDIF.
      IF lt_error IS NOT INITIAL .
        " Data declaration for ABAP ALV
        "-----------------------------------------------------------"
        DATA : lo_alv              TYPE REF TO cl_salv_table,
               lo_lex_message      TYPE REF TO cx_salv_msg,
               lo_layout_settings  TYPE REF TO cl_salv_layout,
               lo_layout_key       TYPE        salv_s_layout_key,
               lo_columns          TYPE REF TO cl_salv_columns_table,
               lo_column           TYPE REF TO cl_salv_column,
               lo_lex_not_found    TYPE REF TO cx_salv_not_found,
               lo_functions        TYPE REF TO cl_salv_functions_list,
               lo_display_settings TYPE REF TO cl_salv_display_settings.

        TRY.
            cl_salv_table=>factory(
              IMPORTING
                r_salv_table = lo_alv
              CHANGING
                t_table      = lt_error ).
          CATCH cx_salv_msg INTO lo_lex_message.
        ENDTRY.

        " Set the ALV Layouts
        "-----------------------------------------------------------"
        lo_layout_settings   = lo_alv->get_layout( ).
        lo_layout_key-report = sy-repid.
        lo_layout_settings->set_key( lo_layout_key ).
        lo_layout_settings->set_save_restriction( if_salv_c_layout=>restrict_none ).

        " set the ALV Toolbars
        "-----------------------------------------------------------"
        lo_functions = lo_alv->get_functions( ).
        lo_functions->set_all( ).

        " Optimize ALV Columns size
        "-----------------------------------------------------------"
        lo_columns = lo_alv->get_columns( ).
        lo_columns->set_optimize( ).

        " Set Zebra Lines display
        "-----------------------------------------------------------"
        lo_display_settings = lo_alv->get_display_settings( ).
        lo_display_settings->set_striped_pattern( if_salv_c_bool_sap=>true ).

        " Set ALV Header title
        "-----------------------------------------------------------"
        lo_display_settings->set_list_header( 'Error log for Inspection Characteristics Long Text Upload' ).

        " Change ALV Columns Name ( Short, medium and Long text)
        "-----------------------------------------------------------"
        TRY.
            lo_column = lo_columns->get_column( 'ICON' ).
            lo_column->set_short_text( 'MSG Type' ).
            lo_column->set_medium_text( 'Message Type' ).
            lo_column->set_long_text( 'Message Type' ).

            lo_column = lo_columns->get_column( 'PLNNR' ).
            lo_column->set_short_text( 'TL Group' ).
            lo_column->set_medium_text( 'Tasklist Group' ).
            lo_column->set_long_text( 'Tasklist Group' ).

            lo_column = lo_columns->get_column( 'PLNAL' ).
            lo_column->set_short_text( 'Grp.Ctr' ).
            lo_column->set_medium_text( 'TL Group Counter' ).
            lo_column->set_long_text( 'TL Group Counter' ).

            lo_column = lo_columns->get_column( 'VORNR' ).
            lo_column->set_short_text( 'Oper.No' ).
            lo_column->set_medium_text( 'Operation Number' ).
            lo_column->set_long_text( 'Operation Number' ).

            lo_column = lo_columns->get_column( 'MERKNR' ).
            lo_column->set_short_text( 'IC.No' ).
            lo_column->set_medium_text( 'Insp.Char Number' ).
            lo_column->set_long_text( 'Inspection Characteristics Number' ).

            lo_column = lo_columns->get_column( 'LINE' ).
            lo_column->set_short_text( 'Err.Msg' ).
            lo_column->set_medium_text( 'Error Message' ).
            lo_column->set_long_text( 'Error Message' ).
          CATCH cx_salv_not_found INTO lo_lex_not_found.
        ENDTRY.

        " Display the ALV in ABAP in the whole main screen
        "-----------------------------------------------------------"
        lo_alv->display( ).
      ENDIF.
    ELSE.
      MESSAGE TEXT-t08 TYPE 'I'.
    ENDIF.
  ENDIF.
