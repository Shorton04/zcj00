      core.werks_name as werks_name,
      core.ktext      as ktext,
      core.ernam      as ernam,

      core.iwerk      as iwerk,
      core.ingpr      as ingpr,
      core.priok      as priok,
      core.ilart      as ilart,
      core.addat      as addat,
      core.lacd_date  as lacd_date,
      core.tplnr      as tplnr,

      core.gstri      as gstri,
      core.getri      as getri,
      core.gstrs      as gstrs,
      core.gltrs      as gltrs,

      conf.budat      as budat,
      conf.ernam      as conf_ernam,

