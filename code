DATA(lv_posid_db) = ls_item-posid.

SELECT SINGLE objnr
  FROM prps
  INTO @lv_objnr
  WHERE posid = @lv_posid_db.

IF sy-subrc <> 0 OR lv_objnr IS INITIAL.
  REPLACE ALL OCCURRENCES OF '.' IN lv_posid_db WITH ''.
  SELECT SINGLE objnr
    FROM prps
    INTO @lv_objnr
    WHERE posid = @lv_posid_db.
ENDIF.