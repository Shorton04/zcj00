*&---------------------------------------------------------------------*
*& Form VALIDATE_TOTAL_UP_DONE
*&---------------------------------------------------------------------*
FORM validate_total_up_done
  CHANGING cv_error TYPE abap_bool.

  DATA: lt_level1 TYPE STANDARD TABLE OF ty_wbs_display,
        lt_level2 TYPE STANDARD TABLE OF ty_wbs_display,
        lv_sum    TYPE ty_wbs_display-zapproved_budg,
        lv_len1   TYPE i,
        lv_parent TYPE ps_posid.

  FIELD-SYMBOLS: <wa1> TYPE ty_wbs_display,
                 <wa2> TYPE ty_wbs_display.

  CLEAR cv_error.

*---------------------------------------------------------------------*
* Separate Level 1 and Level 2
*---------------------------------------------------------------------*
  LOOP AT gt_wbs_display ASSIGNING FIELD-SYMBOL(<wa>).
    CASE <wa>-stufe.
      WHEN '1'.
        APPEND <wa> TO lt_level1.
      WHEN '2'.
        APPEND <wa> TO lt_level2.
    ENDCASE.
  ENDLOOP.

*---------------------------------------------------------------------*
* Validate Level 1 = sum of Level 2 children
*---------------------------------------------------------------------*
  LOOP AT lt_level1 ASSIGNING <wa1>.

    CLEAR: lv_sum, lv_parent, lv_len1.

    lv_parent = <wa1>-posid.

    CALL FUNCTION 'FTR_CORR_SWIFT_DELETE_ENDZERO'
      CHANGING
        c_value = lv_parent.

    lv_len1 = strlen( lv_parent ).

    LOOP AT lt_level2 ASSIGNING <wa2>.
      IF <wa2>-posid+0(lv_len1) = <wa1>-posid+0(lv_len1).
        lv_sum = lv_sum + <wa2>-zapproved_budg.
      ENDIF.
    ENDLOOP.

    " If parent has children, it must match total-up result
    IF lv_sum IS NOT INITIAL.
      IF <wa1>-zapproved_budg <> lv_sum.
        MESSAGE e000(zmsg_a2r) WITH 'Please trigger Total Up first.'.
        cv_error = abap_true.
        RETURN.
      ENDIF.
    ENDIF.

  ENDLOOP.

ENDFORM.