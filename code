METHOD set_rel_status_for_project_wbs.

  DATA: lv_proj_pspnr TYPE proj-pspnr,
        lv_posid_try  TYPE prps-posid,
        lv_posid_nod  TYPE prps-posid,
        lv_psphi      TYPE prps-psphi.

  "Collect all WBS OBJNRs under project
  TYPES: BEGIN OF ty_objnr,
           objnr TYPE jest-objnr,
         END OF ty_objnr.

  DATA: lt_objnr TYPE STANDARD TABLE OF ty_objnr,
        ls_objnr TYPE ty_objnr.

  "---- STATUS table line type (adjust to your system!) ----
  "In SE37: display STATUS_CHANGE_INTERN_VB -> double click table STATUS -> see Line type
  TYPES: ty_status_line TYPE bsvu_status_line. "<<< CHANGE THIS to the real type in your system

  DATA: lt_status TYPE STANDARD TABLE OF ty_status_line,
        ls_status TYPE ty_status_line.

  rv_success = abap_false.

  "1) Determine project PSPHI using any POSID from it_wbs_items (same as your BLKD method)
  CLEAR lv_proj_pspnr.

  LOOP AT it_wbs_items INTO DATA(ls_any).
    IF ls_any-posid IS INITIAL.
      CONTINUE.
    ENDIF.

    lv_posid_try = ls_any-posid.

    SELECT SINGLE psphi
      FROM prps
      INTO @lv_psphi
      WHERE posid = @lv_posid_try.

    IF sy-subrc = 0 AND lv_psphi IS NOT INITIAL.
      lv_proj_pspnr = lv_psphi.
      EXIT.
    ENDIF.

    lv_posid_nod = ls_any-posid.
    REPLACE ALL OCCURRENCES OF '.' IN lv_posid_nod WITH ''.

    IF lv_posid_nod <> lv_posid_try.
      SELECT SINGLE psphi
        FROM prps
        INTO @lv_psphi
        WHERE posid = @lv_posid_nod.

      IF sy-subrc = 0 AND lv_psphi IS NOT INITIAL.
        lv_proj_pspnr = lv_psphi.
        EXIT.
      ENDIF.
    ENDIF.

    CLEAR lv_posid_nod.
    lv_posid_nod = ls_any-posid.

    CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
      EXPORTING
        input  = lv_posid_nod
      IMPORTING
        output = lv_posid_nod
      EXCEPTIONS
        OTHERS = 1.

    IF lv_posid_nod IS NOT INITIAL.
      SELECT SINGLE psphi
        FROM prps
        INTO @lv_psphi
        WHERE posid = @lv_posid_nod.

      IF sy-subrc = 0 AND lv_psphi IS NOT INITIAL.
        lv_proj_pspnr = lv_psphi.
        EXIT.
      ENDIF.
    ENDIF.
  ENDLOOP.

  IF lv_proj_pspnr IS INITIAL.
    RETURN.
  ENDIF.

  "2) Get OBJNRs of all WBS under the project
  CLEAR lt_objnr.
  SELECT objnr
    FROM prps
    INTO TABLE @lt_objnr
    WHERE psphi = @lv_proj_pspnr
      AND objnr <> ''.

  IF lt_objnr IS INITIAL.
    rv_success = abap_true.
    RETURN.
  ENDIF.

  SORT lt_objnr BY objnr.
  DELETE ADJACENT DUPLICATES FROM lt_objnr COMPARING objnr.

  "3) Set REL (I0002) per OBJNR via STATUS_CHANGE_INTERN_VB
  LOOP AT lt_objnr INTO ls_objnr.

    CLEAR lt_status.

    CLEAR ls_status.
    ls_status-stat = 'I0002'.  "REL
    ls_status-t    = 'I'.      "I = set/insert (activate)
    APPEND ls_status TO lt_status.

    CALL FUNCTION 'STATUS_CHANGE_INTERN_VB'
      EXPORTING
        objnr = ls_objnr-objnr
      TABLES
        status = lt_status
      EXCEPTIONS
        OTHERS = 1.

    IF sy-subrc <> 0.
      rv_success = abap_false.
      RETURN.
    ENDIF.

  ENDLOOP.

  COMMIT WORK AND WAIT.

  rv_success = abap_true.

ENDMETHOD.