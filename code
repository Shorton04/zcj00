PROCESS BEFORE OUTPUT.
  MODULE STATUS_0100.
  MODULE set_header_display_values.
  CALL SUBSCREEN: wbs INCLUDING sy-repid '0300',
                  remarks INCLUDING sy-repid '0400'.

PROCESS AFTER INPUT.
  MODULE capture_user_edits.        " <-- ADD THIS AS FIRST LINE
  CALL SUBSCREEN: wbs, remarks.
  MODULE USER_COMMAND_0100.

PROCESS ON VALUE-REQUEST.
  FIELD gs_header-vernr MODULE f4_help_person_responsible.



*&---------------------------------------------------------------------*
*& Module CAPTURE_USER_EDITS INPUT
*&---------------------------------------------------------------------*
MODULE capture_user_edits INPUT.

  " Must fire BEFORE subscreen and USER_COMMAND_0100
  " Captures whatever user typed before any refresh logic runs

  IF p_post1 <> gs_header-post1 OR gv_u_post1 = abap_true.
    gs_header-post1 = p_post1.
    IF p_post1 IS NOT INITIAL.
      gv_u_post1 = abap_true.
    ENDIF.
  ENDIF.

  IF p_verna <> gs_header-vernr OR gv_u_vernr = abap_true.
    gs_header-vernr = p_verna.
    IF p_verna IS NOT INITIAL.
      gv_u_vernr = abap_true.
    ENDIF.
  ENDIF.

  IF p_plsez <> gs_header-plsez OR gv_u_plsez = abap_true.
    gs_header-plsez = p_plsez.
    IF p_plsez IS NOT INITIAL.
      gv_u_plsez = abap_true.
    ENDIF.
  ENDIF.

  IF p_prctr <> gs_header-prctr OR gv_u_prctr = abap_true.
    gs_header-prctr = p_prctr.
    IF p_prctr IS NOT INITIAL.
      gv_u_prctr = abap_true.
    ENDIF.
  ENDIF.

  IF p_kostl <> gs_header-kostl OR gv_u_kostl = abap_true.
    gs_header-kostl = p_kostl.
    IF p_kostl IS NOT INITIAL.
      gv_u_kostl = abap_true.
    ENDIF.
  ENDIF.

ENDMODULE.
