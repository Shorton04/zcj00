MODULE user_command_0100 INPUT.

  DATA lv_ok TYPE sy-ucomm.
  lv_ok = sy-ucomm.
  CLEAR sy-ucomm.

  CASE lv_ok.

    WHEN 'SUBMIT'.

      IF gv_request_type = 'B3'.

        DATA lv_success TYPE abap_bool.

        lv_success = go_builder->change_project_critical(
                        iv_pspnr   = gs_header-pspnr
                        is_header  = gs_header ).

        IF lv_success = abap_true.

          "Update Z tables
          PERFORM update_wbshdr_b3.
          PERFORM update_wbsitem_b3.

          "Trigger workflow
          PERFORM trigger_workflow_b3.

          MESSAGE s029(zcj00) WITH 'Project modification request submitted'.

        ELSE.

          MESSAGE e029(zcj00) WITH 'Project modification failed'.

        ENDIF.

      ENDIF.

  ENDCASE.

ENDMODULE.