MODULE capture_user_edits INPUT.

  " ... existing gs_header field captures ...

  " Capture gv_im_posid_display
  IF gv_posnr_display_done = abap_true.
    IF gv_im_posid_display <> gv_im_posid_user
    OR gv_u_im_posid = abap_true.
      IF gv_im_posid_display IS NOT INITIAL.

        IF gv_im_posid_display <> gv_im_posid_user.
          DATA: lv_new_posnr TYPE im_posnr.

          " STEP 1: Check if posid exists in IMPR
          SELECT SINGLE posnr, prnam, izwek, bukrs, werks, usr08
            FROM impr
            INTO @DATA(ls_impr_check)
            WHERE posid = @gv_im_posid_display.

          IF sy-subrc <> 0.
            " posid not found in IMPR at all - invalid entry
            MESSAGE e000(zmsg_a2r) WITH gv_im_posid_display
                                        'not found in Investment Program'(m30).
            " Revert to last valid value
            gv_im_posid_display = gv_im_posid_user.
            RETURN.
          ENDIF.

          " STEP 2: Check if posid belongs to the same PRNAM as gs_header-prnam
          IF gs_header-prnam IS NOT INITIAL
          AND ls_impr_check-prnam <> gs_header-prnam.
            " posid exists but belongs to different Investment Program
            MESSAGE e000(zmsg_a2r) WITH gv_im_posid_display
                                        'does not belong to program'(m31)
                                        gs_header-prnam.
            " Revert to last valid value
            gv_im_posid_display = gv_im_posid_user.
            RETURN.
          ENDIF.

          " STEP 3: Valid - update shadow and reload dependent fields
          lv_new_posnr        = ls_impr_check-posnr.
          gv_im_posid_user    = gv_im_posid_display.
          gv_u_im_posid       = abap_true.
          gs_header-posnr     = lv_new_posnr.

          " Reload IM dependent global vars
          gv_izwek  = ls_impr_check-izwek.
          gv_bukrs  = ls_impr_check-bukrs.
          gv_werks  = ls_impr_check-werks.
          gv_usr008 = ls_impr_check-usr08.
          gs_header-prnam = ls_impr_check-prnam.

        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

ENDMODULE.
