METHOD assign_im_cj02.

  DATA:
    lt_bdcdata   TYPE TABLE OF bdcdata,
    lt_bdcmsg    TYPE STANDARD TABLE OF bdcmsgcoll,
    ls_bdcmsg    TYPE bdcmsgcoll,
    lv_mode      TYPE c VALUE 'N',
    lv_update    TYPE c VALUE 'S',

    lv_posid_im  TYPE impr-posid,
    lv_gjahr_im  TYPE impr-gjahr,

    lv_wbs_char  TYPE fnam_____4.

  rv_success = abap_false.

  "------------------------------------------------------------
  " 1) Read IMPR using imported PRNAM + POSNR
  "------------------------------------------------------------
  CLEAR: lv_posid_im, lv_gjahr_im.
  SELECT SINGLE posid, gjahr
    INTO (@lv_posid_im, @lv_gjahr_im)
    FROM impr
   WHERE prnam = @iv_prnam
     AND posnr = @iv_posnr.

  IF lv_posid_im IS INITIAL OR lv_gjahr_im IS INITIAL.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " 2) Target WBS to assign
  "------------------------------------------------------------
  IF iv_posid_wbs IS INITIAL.
    RETURN.
  ENDIF.

  lv_wbs_char = iv_posid_wbs.

  "------------------------------------------------------------
  " 3) Build CJ02 BDC (keep EXACTLY your working flow)
  "------------------------------------------------------------
  CLEAR lt_bdcdata.

  bdc_dynpro(
    EXPORTING iv_program = 'SAPLCJWB'
              iv_dynpro  = '0100'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'BDC_CURSOR'
              iv_fval = '*PRPS-POSID'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'BDC_OKCODE'
              iv_fval = '=LETB'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = '*PROJ-PSPID'
              iv_fval = ''
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = '*PRPS-POSID'
              iv_fval = lv_wbs_char
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_dynpro(
    EXPORTING iv_program = 'SAPLCJWB'
              iv_dynpro  = '0901'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'BDC_OKCODE'
              iv_fval = '=AIPP'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'BDC_SUBSCR'
              iv_fval = 'SAPLCJWB                                0902LISTE'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'BDC_CURSOR'
              iv_fval = 'RCWBS-IDENT(01)'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'BDC_SUBSCR'
              iv_fval = 'SAPLCJWB                                3993BUTTONS'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_dynpro(
    EXPORTING iv_program = 'SAPLAIPP'
              iv_dynpro  = '0050'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'BDC_CURSOR'
              iv_fval = 'RAIP1-PRNAM'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'BDC_OKCODE'
              iv_fval = '=TAKE'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'RAIP1-PRNAM'
              iv_fval = CONV #( iv_prnam )
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'RAIP1-POSID'
              iv_fval = CONV #( lv_posid_im )
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'RAIP1-GJAHR'
              iv_fval = |{ lv_gjahr_im }|
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_dynpro(
    EXPORTING iv_program = 'SAPLCJWB'
              iv_dynpro  = '0901'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'BDC_OKCODE'
              iv_fval = '=BU'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'BDC_SUBSCR'
              iv_fval = 'SAPLCJWB                                0902LISTE'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'BDC_CURSOR'
              iv_fval = 'RCWBS-IDENT(01)'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  bdc_field(
    EXPORTING iv_fnam = 'BDC_SUBSCR'
              iv_fval = 'SAPLCJWB                                3993BUTTONS'
    CHANGING  ct_bdcdata = lt_bdcdata ).

  "------------------------------------------------------------
  " 4) Execute CJ02 (same error-check style as your settlement_rule)
  "------------------------------------------------------------
  CLEAR lt_bdcmsg.

  CALL TRANSACTION 'CJ02'
    USING lt_bdcdata
    MODE lv_mode
    UPDATE lv_update
    MESSAGES INTO lt_bdcmsg.

  LOOP AT lt_bdcmsg TRANSPORTING NO FIELDS WHERE msgtyp CA 'EA'.
    EXIT.
  ENDLOOP.

  IF sy-subrc EQ 0.
    "If you have a known fallback screen like your CJB2 logic,
    "you can rebuild lt_bdcdata here and call CJ02 again.
    RETURN.
  ENDIF.

  rv_success = abap_true.

ENDMETHOD.





DATA(lv_ok) = me->assign_im_cj02(
  iv_prnam     = ls_hdr-prnam
  iv_posnr     = ls_hdr-posnr
  iv_posid_wbs = lv_pspid_char     "your Level1 WBS POSID
).

IF lv_ok = abap_false.
  "handle error
ENDIF.