DATA(lv_left_int_t) = ls_phris_hier_t-wbs_left.
DATA(lv_left_check) = lv_left_int_t.

IF lv_left_check IS NOT INITIAL.

  "Normalize format (important if POSID has no dots)
  REPLACE ALL OCCURRENCES OF '.' IN lv_left_check WITH ''.

  "Check if LEFT exists in WBS items
  READ TABLE it_wbs_items TRANSPORTING NO FIELDS
    WITH KEY posid = lv_left_check.

  IF sy-subrc = 0.
    "✔ Valid → convert
    CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
      EXPORTING
        input  = lv_left_int_t
      IMPORTING
        output = lv_left_int_t.
  ELSE.
    "Invalid → clear
    CLEAR lv_left_int_t.
  ENDIF.

ENDIF.

ls_wbs_celement-wbs_left = lv_left_int_t.