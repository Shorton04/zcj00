LOOP AT lt_wbs_car INTO ls_wbs.

  CLEAR ls_wbs_celement.
  
  " ... your field assignments ...

  " Derive parent prefix from posid (e.g. PC000884023 -> PC00088402 is parent)
  " Siblings share the same length and same characters up to last digit group
  DATA lv_elem_len TYPE i.
  DATA lv_parent_prefix TYPE char24.
  
  lv_elem_len = strlen( ls_wbs-posid ).
  
  " Find last sibling: same length, less than current posid
  DATA lv_insert_idx TYPE i.
  CLEAR lv_insert_idx.

  LOOP AT lt_wbs_celement INTO DATA(ls_check).
    IF strlen( ls_check-wbs_element ) = lv_elem_len
    AND ls_check-wbs_element < ls_wbs_celement-wbs_element.
      lv_insert_idx = sy-tabix.
    ENDIF.
  ENDLOOP.

  IF lv_insert_idx = 0.
    APPEND ls_wbs_celement TO lt_wbs_celement.
  ELSE.
    INSERT ls_wbs_celement INTO lt_wbs_celement INDEX lv_insert_idx + 1.
  ENDIF.

  " extensionin
  IF is_header-zunifier_proj = 'X'.
    CLEAR: ls_te_wbs, ls_extensionin.
    ls_te_wbs-wbs_element        = ls_wbs-posid.
    ls_te_wbs-zunifier_proj      = 'X'.
    ls_extensionin-structure     = 'BAPI_TE_WBS_ELEMENT'.
    ls_extensionin-valuepart1    = ls_te_wbs.
    ls_extensionin-valuepart2+50(01) = ls_te_wbs-zunifier_proj.
    APPEND ls_extensionin TO lt_extensionin.
  ENDIF.

ENDLOOP.
