FORM submit_b3.

  DATA: lv_new_reqnum TYPE char10,
        lv_success    TYPE abap_bool,
        ls_header_old TYPE ztb_a2r_wbshdr,
        ls_header_new TYPE ztb_a2r_wbshdr,
        lt_return     TYPE bapiret2_t,
        ls_return     TYPE bapiret2,
        lv_errmsg     TYPE string.

  "------------------------------------------------------------
  " 1) Get latest screen values into gs_header
  "------------------------------------------------------------
  PERFORM sync_screen_to_header.
  PERFORM get_text.

  IF gv_pspnr_sel IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Project is required.'.
  ENDIF.

  "------------------------------------------------------------
  " 2) Read OLD request (original A1) - reference only
  "    DO NOT UPDATE THIS RECORD
  "------------------------------------------------------------
  CLEAR ls_header_old.

  IF gv_loaded_reqnum IS NOT INITIAL.
    SELECT SINGLE *
      FROM ztb_a2r_wbshdr
      INTO @ls_header_old
      WHERE zreq_num = @gv_loaded_reqnum.
  ELSEIF p_req_num IS NOT INITIAL.
    SELECT SINGLE *
      FROM ztb_a2r_wbshdr
      INTO @ls_header_old
      WHERE zreq_num = @p_req_num.
  ENDIF.

  IF sy-subrc <> 0.
    MESSAGE e000(zmsg_a2r) WITH 'Original request not found.'.
  ENDIF.

  "------------------------------------------------------------
  " 3) Generate NEW request number for B3
  "------------------------------------------------------------
  lv_new_reqnum = go_builder->get_next_request_number( ).

  IF lv_new_reqnum IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Unable to generate request number.'.
  ENDIF.

  "------------------------------------------------------------
  " 4) Build NEW header for B3
  "    - copy old header first so all old fields are retained
  "    - overlay current changed screen values
  "------------------------------------------------------------
  CLEAR ls_header_new.
  MOVE-CORRESPONDING ls_header_old TO ls_header_new.
  MOVE-CORRESPONDING gs_header     TO ls_header_new.

  ls_header_new-mandt          = sy-mandt.
  ls_header_new-zreq_num       = lv_new_reqnum.
  ls_header_new-z_reqtype      = 'B3'.
  ls_header_new-request_status = 'PENDING'.

  "new request audit fields
  ls_header_new-ernam = sy-uname.
  ls_header_new-erdat = sy-datum.
  ls_header_new-aenam = sy-uname.
  ls_header_new-aedat = sy-datum.

  "important: this is still same project, only new request record
  ls_header_new-pspnr = gv_pspnr_sel.

  "clear approval/rejection fields for new request
  CLEAR: ls_header_new-zapproved_by,
         ls_header_new-zrequest_approved_on,
         ls_header_new-zrejecte_by,
         ls_header_new-zrequest_rejected_on,
         ls_header_new-zrejectionreason.

  "------------------------------------------------------------
  " 5) Insert NEW B3 record only
  "    DO NOT TOUCH OLD A1 RECORD
  "------------------------------------------------------------
  INSERT ztb_a2r_wbshdr FROM @ls_header_new.
  IF sy-subrc <> 0.
    MESSAGE e000(zmsg_a2r) WITH 'Failed to create new B3 request.'.
  ENDIF.

  COMMIT WORK AND WAIT.

  "------------------------------------------------------------
  " 6) Call your existing method
  "    old = original A1
  "    new = new B3 request data
  "------------------------------------------------------------
  CLEAR lt_return.
  lv_success = go_builder->change_project_critical(
                 iv_pspnr      = gv_pspnr_sel
                 is_header     = ls_header_new
                 is_header_old = ls_header_old
                 et_return     = lt_return ).

  "------------------------------------------------------------
  " 7) Update ONLY the NEW B3 request row
  "------------------------------------------------------------
  IF lv_success = abap_true.

    UPDATE ztb_a2r_wbshdr
       SET request_status       = 'APPROVED'
           aenam                = @sy-uname
           aedat                = @sy-datum
           zapproved_by         = @sy-uname
           zrequest_approved_on = @sy-datum
     WHERE zreq_num = @lv_new_reqnum.

    COMMIT WORK AND WAIT.

    MESSAGE s000(zmsg_a2r) WITH
      |B3 request { lv_new_reqnum } created successfully.|.

  ELSE.

    CLEAR lv_errmsg.
    LOOP AT lt_return INTO ls_return
      WHERE type = 'E'
         OR type = 'A'
         OR type = 'X'.
      lv_errmsg = ls_return-message.
      EXIT.
    ENDLOOP.

    IF lv_errmsg IS INITIAL.
      lv_errmsg = 'Critical change failed.'.
    ENDIF.

    UPDATE ztb_a2r_wbshdr
       SET request_status = 'PENDING'
           aenam          = @sy-uname
           aedat          = @sy-datum
     WHERE zreq_num = @lv_new_reqnum.

    COMMIT WORK AND WAIT.

    MESSAGE e000(zmsg_a2r) WITH lv_errmsg.

  ENDIF.

ENDFORM.