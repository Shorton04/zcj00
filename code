DATA lv_tabix TYPE sy-tabix.

LOOP AT gt_wbs_unclose INTO gs_wbs_unclose.
  lv_tabix = sy-tabix.

  READ TABLE gt_wbs_items INTO gs_wbs_item
    WITH KEY posid = gs_wbs_unclose-wbs_element_code.
  IF sy-subrc = 0.

    IF gs_wbs_item-zstat IS NOT INITIAL.
      gs_wbs_unclose-status = gs_wbs_item-zstat.
    ENDIF.

    IF gs_wbs_item-zstat_tobe IS NOT INITIAL.
      gs_wbs_unclose-to_be = gs_wbs_item-zstat_tobe.
    ENDIF.

    MODIFY gt_wbs_unclose FROM gs_wbs_unclose INDEX lv_tabix.
  ENDIF.

ENDLOOP.