FORM get_changed_wbs_rows
  USING    it_new     TYPE STANDARD TABLE OF ztb_a2r_wbsitem
           it_old     TYPE STANDARD TABLE OF ztb_a2r_wbsitem
  CHANGING ct_changed TYPE STANDARD TABLE OF ztb_a2r_wbsitem.

  FIELD-SYMBOLS: <n> TYPE ztb_a2r_wbsitem,
                 <o> TYPE ztb_a2r_wbsitem.

  CLEAR ct_changed.

  LOOP AT it_new ASSIGNING <n>.
    READ TABLE it_old ASSIGNING <o> WITH KEY posid = <n>-posid.
    IF sy-subrc <> 0.
      APPEND <n> TO ct_changed.
      CONTINUE.
    ENDIF.

    "compare only fields you care about
    IF <n>-post1 <> <o>-post1
    OR <n>-wert2 <> <o>-wert2
    OR <n>-zbudget_check <> <o>-zbudget_check.
      APPEND <n> TO ct_changed.
    ENDIF.
  ENDLOOP.

ENDFORM.


DATA: gt_wbs_items      TYPE STANDARD TABLE OF ztb_a2r_wbsitem WITH DEFAULT KEY,
      gt_wbs_items_old  TYPE STANDARD TABLE OF ztb_a2r_wbsitem WITH DEFAULT KEY.