DATA: lv_posid_im TYPE impr-posid,
      lv_gjahr_im TYPE impr-gjahr.

CLEAR: lv_posid_im, lv_gjahr_im.

SELECT posid, gjahr
  FROM impr AS a
  WHERE a~prnam = @lv_prnam
    AND NOT EXISTS (
      SELECT 1 FROM impr AS b
        WHERE b~prnam = a~prnam
          AND b~parnr = a~posnr )   "a is not parent of any node
  INTO (@lv_posid_im, @lv_gjahr_im)
  UP TO 1 ROWS.
ENDSELECT.