DATA: gv_header_initialized TYPE abap_bool.



FORM prepare_screen2.
  " Only initialize once - don't overwrite user changes on re-entry
  CHECK gv_header_initialized = abap_false.

  PERFORM get_additional_im_data USING p_posnr.

  CALL METHOD go_builder->copy_template_structure
    EXPORTING
      iv_pspid     = p_pspid
      iv_kostl     = p_kostl
    CHANGING
      ct_wbs_items = gt_wbs_items.
  PERFORM load_template_to_wbs_items USING p_pspid p_kostl.
  PERFORM convert_to_display.
  PERFORM set_wbs_default_values.
  PERFORM populate_header_structure.

  gv_header_initialized = abap_true.  " Mark as done
ENDFORM.



FORM save_request.
  DATA: lv_reqnum TYPE char10.

  " Sync editable screen fields back to gs_header BEFORE saving
  " (Do NOT call POPULATE_HEADER_STRUCTURE here - it overwrites user input)
  PERFORM sync_screen_to_header.   " <-- new form, see below
  PERFORM convert_from_display.

  CALL METHOD go_builder->save_request
    EXPORTING
      is_header    = gs_header
      it_wbs_items = gt_wbs_items
    RECEIVING
      rv_reqnum    = lv_reqnum.

  IF lv_reqnum IS NOT INITIAL.
    gv_request_number = lv_reqnum.
    MESSAGE s000(zmsg_a2r) WITH lv_reqnum.
    COMMIT WORK.
  ELSE.
    MESSAGE e013.
  ENDIF.
ENDFORM.




FORM sync_screen_to_header.
  " Only sync fields that the user can actually edit on screen 100
  " DO NOT re-derive auto-populated fields from source tables

  " Example: if POST1, VERNR, PLSEZ, PRCTR, KOSTL are editable on screen 100
  " they must be bound to gs_header-* directly in the dynpro field list
  " If they're bound to p_* variables, sync them here:
  gs_header-post1  = p_post1.
  gs_header-vernr  = p_verna.
  gs_header-plsez  = p_plsez.
  gs_header-prctr  = p_prctr.
  gs_header-kostl  = p_kostl.
  " Add any other user-editable fields from screen 100
  " Do NOT re-set: bukrs, werks, izwek, profl, posnr, prnam
  " (those are auto-populated and should not be overwritten)
ENDFORM.




WHEN 'BACK'.
  gv_header_initialized = abap_false.  " Allow re-init if they go back and change IM
  LEAVE TO SCREEN 200.
