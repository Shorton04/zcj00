MODULE user_command_0100 INPUT.
  DATA: lv_ok_code1 TYPE sy-ucomm.

  lv_ok_code1 = sy-ucomm.
  CLEAR sy-ucomm.

  "------------------------------------------------------------
  " Sync ALL editable screen fields on every PAI
  " Store latest user-edited values into shadow structure
  "------------------------------------------------------------

  IF p_post1 <> gs_header-post1.
    gs_header-post1      = p_post1.
    gs_header_user-post1 = p_post1.
    gv_u_post1           = abap_true.
  ELSEIF gv_u_post1 = abap_true.
    gs_header-post1      = p_post1.
    gs_header_user-post1 = p_post1.
  ENDIF.

  IF p_verna <> gs_header-vernr.
    gs_header-vernr      = p_verna.
    gs_header_user-vernr = p_verna.
    gv_u_vernr           = abap_true.
  ELSEIF gv_u_vernr = abap_true.
    gs_header-vernr      = p_verna.
    gs_header_user-vernr = p_verna.
  ENDIF.

  IF p_plsez <> gs_header-plsez.
    gs_header-plsez      = p_plsez.
    gs_header_user-plsez = p_plsez.
    gv_u_plsez           = abap_true.
  ELSEIF gv_u_plsez = abap_true.
    gs_header-plsez      = p_plsez.
    gs_header_user-plsez = p_plsez.
  ENDIF.

  " IM Program
  IF p_prnam <> gs_header-prnam.
    gs_header-prnam      = p_prnam.
    gs_header_user-prnam = p_prnam.
    gv_u_prnam           = abap_true.
  ELSEIF gv_u_prnam = abap_true.
    gs_header-prnam      = p_prnam.
    gs_header_user-prnam = p_prnam.
  ENDIF.

  " Company Code
  IF gv_bukrs <> gs_header-bukrs.
    gs_header-bukrs      = gv_bukrs.
    gs_header_user-bukrs = gv_bukrs.
    gv_u_bukrs           = abap_true.
  ELSEIF gv_u_bukrs = abap_true.
    gs_header-bukrs      = gv_bukrs.
    gs_header_user-bukrs = gv_bukrs.
  ENDIF.

  " Plant
  IF gv_werks <> gs_header-werks.
    gs_header-werks      = gv_werks.
    gs_header_user-werks = gv_werks.
    gv_u_werks           = abap_true.
  ELSEIF gv_u_werks = abap_true.
    gs_header-werks      = gv_werks.
    gs_header_user-werks = gv_werks.
  ENDIF.

  " Profit Center
  IF p_prctr <> gs_header-prctr.
    gs_header-prctr      = p_prctr.
    gs_header_user-prctr = p_prctr.
    gv_u_prctr           = abap_true.
  ELSEIF gv_u_prctr = abap_true.
    gs_header-prctr      = p_prctr.
    gs_header_user-prctr = p_prctr.
  ENDIF.

  " Cost Center
  IF p_kostl <> gs_header-kostl.
    gs_header-kostl      = p_kostl.
    gs_header_user-kostl = p_kostl.
    gv_u_kostl           = abap_true.
  ELSEIF gv_u_kostl = abap_true.
    gs_header-kostl      = p_kostl.
    gs_header_user-kostl = p_kostl.
  ENDIF.

  " Investment Reason
  IF gv_izwek <> gs_header-izwek.
    gs_header-izwek      = gv_izwek.
    gs_header_user-izwek = gv_izwek.
    gv_u_izwek           = abap_true.
  ELSEIF gv_u_izwek = abap_true.
    gs_header-izwek      = gv_izwek.
    gs_header_user-izwek = gv_izwek.
  ENDIF.

  " GE Ariba WF Flag / Unifier
  IF p_usr10_c <> gs_header-zunifier_proj.
    gs_header-zunifier_proj      = p_usr10_c.
    gs_header_user-zunifier_proj = p_usr10_c.
    gv_u_zunifier_proj           = abap_true.
  ELSEIF gv_u_zunifier_proj = abap_true.
    gs_header-zunifier_proj      = p_usr10_c.
    gs_header_user-zunifier_proj = p_usr10_c.
  ENDIF.

  " CAR Approval / USR008
  IF gv_usr008 <> gs_header-usr008.
    gs_header-usr008      = gv_usr008.
    gs_header_user-usr008 = gv_usr008.
    gv_u_usr008           = abap_true.
  ELSEIF gv_u_usr008 = abap_true.
    gs_header-usr008      = gv_usr008.
    gs_header_user-usr008 = gv_usr008.
  ENDIF.

  " IM Program Position display field -> keep external value sticky
  IF gv_im_posid_display IS NOT INITIAL.
    IF gv_im_posid_display <> gv_im_posid_user.
      gv_im_posid_user = gv_im_posid_display.
      gv_u_im_posid    = abap_true.
    ELSEIF gv_u_im_posid = abap_true.
      gv_im_posid_user = gv_im_posid_display.
    ENDIF.
  ENDIF.

  CASE lv_ok_code1.
    WHEN 'ENTER' OR ''.

    WHEN 'SAVE'.
      PERFORM get_text.
      PERFORM save_request.

    WHEN 'SOP'.
      CLEAR gv_url.
      gv_url = TEXT-s04.
      PERFORM show_dms_link USING gv_url.

    WHEN 'CHECK'.
      PERFORM validate_screen2 USING abap_false.

    WHEN 'SUBMIT'.
      PERFORM get_text.
      PERFORM validate_screen2 USING abap_false.

      IF sy-uname = 'HQ75177' OR sy-uname = 'CL83960' OR sy-uname = 'KP05750'.
        IF gv_req_type = 'B3'.
          PERFORM submit_b3.
        ELSE.
          PERFORM submit_direct_creation_t.
        ENDIF.
      ELSE.
        PERFORM submit_direct_creation.
      ENDIF.

    WHEN 'UPLD'.
      PERFORM upload.

    WHEN 'DWNLD'.
      PERFORM download.

    WHEN 'TOTALUP'.
      PERFORM total_up_wbs_tc.

    WHEN 'ADDROW'.
      PERFORM add_wbs_row.

    WHEN 'DELROW'.
      PERFORM delete_wbs_rows.

    WHEN 'ATTACH'.
      PERFORM handle_attachments.

    WHEN 'BACK'.
      CLEAR: gv_im_posid_display,
             gv_im_posid_user,
             gv_u_im_posid.
      gv_header_initialized = abap_false.
      LEAVE TO TRANSACTION 'ZA2R_ZCJ00'.

    WHEN 'EXIT' OR 'CANCEL'.
      CLEAR: gv_im_posid_display,
             gv_im_posid_user,
             gv_u_im_posid.
      LEAVE TO TRANSACTION 'ZA2R_ZCJ00'.

  ENDCASE.
ENDMODULE.



FORM sync_screen_to_header.

  DATA: lv_posnr TYPE im_posnr.

  " Push shadow (user-edited) values into gs_header before save
  IF gv_u_post1 = abap_true.
    gs_header-post1 = gs_header_user-post1.
  ENDIF.

  IF gv_u_vernr = abap_true.
    gs_header-vernr = gs_header_user-vernr.
  ENDIF.

  IF gv_u_plsez = abap_true.
    gs_header-plsez = gs_header_user-plsez.
  ENDIF.

  IF gv_u_bukrs = abap_true.
    gs_header-bukrs = gs_header_user-bukrs.
  ENDIF.

  IF gv_u_werks = abap_true.
    gs_header-werks = gs_header_user-werks.
  ENDIF.

  IF gv_u_prctr = abap_true.
    gs_header-prctr = gs_header_user-prctr.
  ENDIF.

  IF gv_u_prnam = abap_true.
    gs_header-prnam = gs_header_user-prnam.
  ENDIF.

  IF gv_u_kostl = abap_true.
    gs_header-kostl = gs_header_user-kostl.
  ENDIF.

  IF gv_u_izwek = abap_true.
    gs_header-izwek = gs_header_user-izwek.
  ENDIF.

  IF gv_u_zunifier_proj = abap_true.
    gs_header-zunifier_proj = gs_header_user-zunifier_proj.
  ENDIF.

  IF gv_u_usr008 = abap_true.
    gs_header-usr008 = gs_header_user-usr008.
  ENDIF.

  " Sync IM Position display value back to internal POSNR before saving
  IF gv_u_im_posid = abap_true AND gv_im_posid_user IS NOT INITIAL.

    CLEAR lv_posnr.

    " Try direct match by POSID
    SELECT SINGLE posnr
      FROM impr
      INTO @lv_posnr
      WHERE posid = @gv_im_posid_user.

    IF sy-subrc <> 0.
      " Fallback: ALPHA conversion
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = gv_im_posid_user
        IMPORTING
          output = lv_posnr.

      SELECT SINGLE posnr
        FROM impr
        INTO @DATA(lv_check)
        WHERE posnr = @lv_posnr.

      IF sy-subrc <> 0.
        CLEAR lv_posnr.
      ENDIF.
    ENDIF.

    IF lv_posnr IS NOT INITIAL.
      gs_header-posnr = lv_posnr.
    ENDIF.

  ENDIF.

ENDFORM.

