define view ZI_WO_PMO
  as select from mhis
  inner join mhio on  mhio.warpl = mhis.warpl
                  and mhio.abnum = mhis.abnum
  inner join ZI_WO_CORE as core
                  on  core.aufnr = mhio.aufnr
  left outer join ZI_WO_CONFIRMATION as conf
               on  conf.aufnr = core.aufnr
  left outer join ZI_WO_STATUS_CHANGE as teco
               on  teco.objnr = core.objnr
               and teco.stat  = 'I0045'
  left outer join ZI_WO_STATUS_CHANGE as rel
               on  rel.objnr = core.objnr
               and rel.stat  = 'I0002'
{
  key mhis.warpl      as warpl,
  key mhis.abnum      as abnum,
      mhis.zaehl      as zaehl,
      mhis.nplda      as nplda,

      mhio.wppos      as wppos,

      core.aufnr      as aufnr,
      core.auart      as auart,
      core.erdat      as erdat,
      core.idat2      as idat2,
      core.vaplz      as vaplz,
      core.kostl      as kostl,
      core.objnr      as objnr,
      core.werks      as werks,
      core.werks_name as werks_name,
      core.ktext      as ktext,
      core.ernam      as ernam,

      core.iwerk      as iwerk,
      core.ingpr      as ingpr,
      core.priok      as priok,
      core.ilart      as ilart,
      core.addat      as addat,
      core.lacd_date  as lacd_date,
      core.tplnr      as tplnr,

      core.gstri      as gstri,
      core.getri      as getri,
      core.gstrs      as gstrs,
      core.gltrs      as gltrs,

      conf.budat      as budat,
      conf.ernam      as conf_ernam,

      teco.udate      as teco_udate,
      teco.usnam      as teco_usnam,

      rel.udate       as rel_udate,
      rel.usnam       as rel_usnam
}





METHOD get_data_npmo.

  CLEAR: et_aufk, et_afih, et_afko, et_afru,
         et_jcds, et_mhio, et_mhis, et_jest,
         et_tj02t, et_iloa, gv_missing_auth,
         et_t001w, et_jcds_rel, et_jcds_teco.

  "--------------------------------------------------------------------
  " Single CDS read replaces all individual SELECTs and JOINs.
  " Each optional range is guarded before being pushed into WHERE.
  "--------------------------------------------------------------------
  DATA lt_npmo TYPE STANDARD TABLE OF zi_wo_npmo WITH EMPTY KEY.

  SELECT aufnr, auart, erdat, idat2, vaplz, kostl, objnr,
         werks, werks_name, ktext, ernam,
         iwerk, ingpr, priok, ilart, addat, lacd_date, tplnr,
         gstri, getri, gstrs, gltrs,
         budat, conf_ernam,
         teco_udate, teco_usnam,
         rel_udate,  rel_usnam
    FROM zi_wo_npmo
    INTO TABLE @lt_npmo
    WHERE ( @is_parameter-r_aufnr IS INITIAL
            OR aufnr IN @is_parameter-r_aufnr )
      AND iwerk IN @is_parameter-r_iwerk        "mandatory
      AND ( @is_parameter-r_getri IS INITIAL
            OR getri IN @is_parameter-r_getri )
      AND ( @is_parameter-r_gstri IS INITIAL
            OR gstri IN @is_parameter-r_gstri )
      AND ( @is_parameter-r_auart IS INITIAL
            OR auart IN @is_parameter-r_auart )
      AND ( @is_parameter-r_erdat IS INITIAL
            OR erdat IN @is_parameter-r_erdat )
      AND ( @is_parameter-r_ingpr IS INITIAL
            OR ingpr IN @is_parameter-r_ingpr )
      AND ( @is_parameter-r_priok IS INITIAL
            OR priok IN @is_parameter-r_priok )
      AND ( @is_parameter-r_tplnr IS INITIAL
            OR tplnr IN @is_parameter-r_tplnr ).

  " Post-filter fields with no DB index
  IF is_parameter-r_idat2 IS NOT INITIAL.
    DELETE lt_npmo WHERE idat2 NOT IN is_parameter-r_idat2.
  ENDIF.
  IF is_parameter-r_vaplz IS NOT INITIAL.
    DELETE lt_npmo WHERE vaplz NOT IN is_parameter-r_vaplz.
  ENDIF.
  IF is_parameter-r_kostl IS NOT INITIAL.
    DELETE lt_npmo WHERE kostl NOT IN is_parameter-r_kostl.
  ENDIF.
  IF is_parameter-r_ilart IS NOT INITIAL.
    DELETE lt_npmo WHERE ilart NOT IN is_parameter-r_ilart.
  ENDIF.

  CHECK lt_npmo IS NOT INITIAL.

  "--------------------------------------------------------------------
  " Authority check
  "--------------------------------------------------------------------
  LOOP AT lt_npmo ASSIGNING FIELD-SYMBOL(<fs_npmo>).
    AUTHORITY-CHECK OBJECT 'I_IWERK'
      ID 'TCD'   FIELD 'ZIW123'
      ID 'IWERK' FIELD <fs_npmo>-iwerk.
    IF sy-subrc <> 0.
      <fs_npmo>-iwerk = ''.       "mark for delete
      gv_missing_auth = abap_true.
    ENDIF.
  ENDLOOP.
  DELETE lt_npmo WHERE iwerk = ''.

  CHECK lt_npmo IS NOT INITIAL.

  "--------------------------------------------------------------------
  " Map CDS result into existing export table structures
  " so BUILD_DATA_NPMO needs zero changes
  "--------------------------------------------------------------------
  DATA lt_aufk  TYPE STANDARD TABLE OF ts_aufk  WITH EMPTY KEY.
  DATA lt_afih  TYPE STANDARD TABLE OF ts_afih  WITH EMPTY KEY.
  DATA lt_afko  TYPE STANDARD TABLE OF ts_afko  WITH EMPTY KEY.
  DATA lt_afru  TYPE STANDARD TABLE OF ts_afru  WITH EMPTY KEY.
  DATA lt_iloa  TYPE STANDARD TABLE OF ts_iloa  WITH EMPTY KEY.
  DATA lt_t001w TYPE STANDARD TABLE OF ts_t001w WITH EMPTY KEY.
  DATA lt_jcds_teco TYPE STANDARD TABLE OF jcds WITH EMPTY KEY.
  DATA lt_jcds_rel  TYPE STANDARD TABLE OF jcds WITH EMPTY KEY.

  LOOP AT lt_npmo INTO DATA(ls_npmo).

    " AUFK
    DATA(ls_aufk) = VALUE ts_aufk(
      aufnr = ls_npmo-aufnr
      auart = ls_npmo-auart
      erdat = ls_npmo-erdat
      idat2 = ls_npmo-idat2
      vaplz = ls_npmo-vaplz
      kostl = ls_npmo-kostl
      objnr = ls_npmo-objnr
      werks = ls_npmo-werks
      ktext = ls_npmo-ktext
      ernam = ls_npmo-ernam ).
    APPEND ls_aufk TO lt_aufk.

    " AFIH
    DATA(ls_afih) = VALUE ts_afih(
      aufnr     = ls_npmo-aufnr
      iwerk     = ls_npmo-iwerk
      ingpr     = ls_npmo-ingpr
      priok     = ls_npmo-priok
      ilart     = ls_npmo-ilart
      addat     = ls_npmo-addat
      lacd_date = ls_npmo-lacd_date ).
    APPEND ls_afih TO lt_afih.

    " AFKO
    DATA(ls_afko) = VALUE ts_afko(
      aufnr = ls_npmo-aufnr
      gstri = ls_npmo-gstri
      getri = ls_npmo-getri
      gstrs = ls_npmo-gstrs
      gltrs = ls_npmo-gltrs ).
    APPEND ls_afko TO lt_afko.

    " AFRU
    IF ls_npmo-budat IS NOT INITIAL.
      DATA(ls_afru) = VALUE ts_afru(
        aufnr = ls_npmo-aufnr
        budat = ls_npmo-budat
        ernam = ls_npmo-conf_ernam ).
      APPEND ls_afru TO lt_afru.
    ENDIF.

    " ILOA
    DATA(ls_iloa) = VALUE ts_iloa(
      tplnr = ls_npmo-tplnr ).
    APPEND ls_iloa TO lt_iloa.

    " T001W
    DATA(ls_t001w) = VALUE ts_t001w(
      werks = ls_npmo-werks
      name1 = ls_npmo-werks_name ).
    COLLECT ls_t001w INTO lt_t001w.   "COLLECT avoids duplicates

    " JCDS TECO
    IF ls_npmo-teco_udate IS NOT INITIAL.
      DATA(ls_teco) = VALUE jcds(
        objnr = ls_npmo-objnr
        stat  = 'I0045'
        udate = ls_npmo-teco_udate
        usnam = ls_npmo-teco_usnam ).
      APPEND ls_teco TO lt_jcds_teco.
    ENDIF.

    " JCDS REL
    IF ls_npmo-rel_udate IS NOT INITIAL.
      DATA(ls_rel) = VALUE jcds(
        objnr = ls_npmo-objnr
        stat  = 'I0002'
        udate = ls_npmo-rel_udate
        usnam = ls_npmo-rel_usnam ).
      APPEND ls_rel TO lt_jcds_rel.
    ENDIF.

  ENDLOOP.

  et_aufk      = lt_aufk.
  et_afih      = lt_afih.
  et_afko      = lt_afko.
  et_afru      = lt_afru.
  et_iloa      = lt_iloa.
  et_t001w     = lt_t001w.
  et_jcds_teco = lt_jcds_teco.
  et_jcds_rel  = lt_jcds_rel.

ENDMETHOD.




METHOD get_data_pmo.

  CLEAR: et_aufk, et_afih, et_afko, et_afru,
         et_jcds, et_mhio, et_mhis, et_jest,
         et_tj02t, et_iloa, gv_missing_auth,
         et_t001w, et_jcds_rel, et_jcds_teco.

  DATA lt_pmo TYPE STANDARD TABLE OF zi_wo_pmo WITH EMPTY KEY.

  SELECT warpl, abnum, zaehl, nplda, wppos,
         aufnr, auart, erdat, idat2, vaplz, kostl, objnr,
         werks, werks_name, ktext, ernam,
         iwerk, ingpr, priok, ilart, addat, lacd_date, tplnr,
         gstri, getri, gstrs, gltrs,
         budat, conf_ernam,
         teco_udate, teco_usnam,
         rel_udate,  rel_usnam
    FROM zi_wo_pmo
    INTO TABLE @lt_pmo
    WHERE ( @is_parameter-r_warpl IS INITIAL
            OR warpl IN @is_parameter-r_warpl )
      AND ( @is_parameter-r_nplda IS INITIAL
            OR nplda IN @is_parameter-r_nplda )
      AND ( @is_parameter-r_aufnr IS INITIAL
            OR aufnr IN @is_parameter-r_aufnr )
      AND iwerk IN @is_parameter-r_iwerk        "mandatory
      AND ( @is_parameter-r_auart IS INITIAL
            OR auart IN @is_parameter-r_auart )
      AND ( @is_parameter-r_erdat IS INITIAL
            OR erdat IN @is_parameter-r_erdat )
      AND ( @is_parameter-r_getri IS INITIAL
            OR getri IN @is_parameter-r_getri )
      AND ( @is_parameter-r_gstri IS INITIAL
            OR gstri IN @is_parameter-r_gstri )
      AND ( @is_parameter-r_ingpr IS INITIAL
            OR ingpr IN @is_parameter-r_ingpr )
      AND ( @is_parameter-r_priok IS INITIAL
            OR priok IN @is_parameter-r_priok )
      AND ( @is_parameter-r_tplnr IS INITIAL
            OR tplnr IN @is_parameter-r_tplnr ).

  " Post-filter fields with no DB index
  IF is_parameter-r_idat2 IS NOT INITIAL.
    DELETE lt_pmo WHERE idat2 NOT IN is_parameter-r_idat2.
  ENDIF.
  IF is_parameter-r_vaplz IS NOT INITIAL.
    DELETE lt_pmo WHERE vaplz NOT IN is_parameter-r_vaplz.
  ENDIF.
  IF is_parameter-r_kostl IS NOT INITIAL.
    DELETE lt_pmo WHERE kostl NOT IN is_parameter-r_kostl.
  ENDIF.
  IF is_parameter-r_ilart IS NOT INITIAL.
    DELETE lt_pmo WHERE ilart NOT IN is_parameter-r_ilart.
  ENDIF.

  CHECK lt_pmo IS NOT INITIAL.

  "--------------------------------------------------------------------
  " Authority check
  "--------------------------------------------------------------------
  LOOP AT lt_pmo ASSIGNING FIELD-SYMBOL(<fs_pmo>).
    AUTHORITY-CHECK OBJECT 'I_IWERK'
      ID 'TCD'   FIELD 'ZIW123'
      ID 'IWERK' FIELD <fs_pmo>-iwerk.
    IF sy-subrc <> 0.
      <fs_pmo>-iwerk = ''.
      gv_missing_auth = abap_true.
    ENDIF.
  ENDLOOP.
  DELETE lt_pmo WHERE iwerk = ''.

  CHECK lt_pmo IS NOT INITIAL.

  "--------------------------------------------------------------------
  " Map into existing export structures
  "--------------------------------------------------------------------
  DATA lt_aufk  TYPE STANDARD TABLE OF ts_aufk  WITH EMPTY KEY.
  DATA lt_afih  TYPE STANDARD TABLE OF ts_afih  WITH EMPTY KEY.
  DATA lt_afko  TYPE STANDARD TABLE OF ts_afko  WITH EMPTY KEY.
  DATA lt_afru  TYPE STANDARD TABLE OF ts_afru  WITH EMPTY KEY.
  DATA lt_mhio  TYPE STANDARD TABLE OF ts_mhio  WITH EMPTY KEY.
  DATA lt_mhis  TYPE STANDARD TABLE OF ts_mhis  WITH EMPTY KEY.
  DATA lt_iloa  TYPE STANDARD TABLE OF ts_iloa  WITH EMPTY KEY.
  DATA lt_t001w TYPE STANDARD TABLE OF ts_t001w WITH EMPTY KEY.
  DATA lt_jcds_teco TYPE STANDARD TABLE OF jcds WITH EMPTY KEY.
  DATA lt_jcds_rel  TYPE STANDARD TABLE OF jcds WITH EMPTY KEY.

  LOOP AT lt_pmo INTO DATA(ls_pmo).

    " AUFK
    DATA(ls_aufk) = VALUE ts_aufk(
      aufnr = ls_pmo-aufnr
      auart = ls_pmo-auart
      erdat = ls_pmo-erdat
      idat2 = ls_pmo-idat2
      vaplz = ls_pmo-vaplz
      kostl = ls_pmo-kostl
      objnr = ls_pmo-objnr
      werks = ls_pmo-werks
      ktext = ls_pmo-ktext
      ernam = ls_pmo-ernam ).
    APPEND ls_aufk TO lt_aufk.

    " AFIH
    DATA(ls_afih) = VALUE ts_afih(
      aufnr     = ls_pmo-aufnr
      iwerk     = ls_pmo-iwerk
      ingpr     = ls_pmo-ingpr
      priok     = ls_pmo-priok
      ilart     = ls_pmo-ilart
      addat     = ls_pmo-addat
      lacd_date = ls_pmo-lacd_date ).
    APPEND ls_afih TO lt_afih.

    " AFKO
    DATA(ls_afko) = VALUE ts_afko(
      aufnr = ls_pmo-aufnr
      gstri = ls_pmo-gstri
      getri = ls_pmo-getri
      gstrs = ls_pmo-gstrs
      gltrs = ls_pmo-gltrs ).
    APPEND ls_afko TO lt_afko.

    " AFRU
    IF ls_pmo-budat IS NOT INITIAL.
      DATA(ls_afru) = VALUE ts_afru(
        aufnr = ls_pmo-aufnr
        budat = ls_pmo-budat
        ernam = ls_pmo-conf_ernam ).
      APPEND ls_afru TO lt_afru.
    ENDIF.

    " MHIO
    DATA(ls_mhio) = VALUE ts_mhio(
      warpl = ls_pmo-warpl
      abnum = ls_pmo-abnum
      wppos = ls_pmo-wppos
      aufnr = ls_pmo-aufnr ).
    APPEND ls_mhio TO lt_mhio.

    " MHIS
    DATA(ls_mhis) = VALUE ts_mhis(
      warpl = ls_pmo-warpl
      abnum = ls_pmo-abnum
      zaehl = ls_pmo-zaehl
      nplda = ls_pmo-nplda ).
    COLLECT ls_mhis INTO lt_mhis.

    " ILOA
    DATA(ls_iloa) = VALUE ts_iloa(
      tplnr = ls_pmo-tplnr ).
    APPEND ls_iloa TO lt_iloa.

    " T001W
    DATA(ls_t001w) = VALUE ts_t001w(
      werks = ls_pmo-werks
      name1 = ls_pmo-werks_name ).
    COLLECT ls_t001w INTO lt_t001w.

    " JCDS TECO
    IF ls_pmo-teco_udate IS NOT INITIAL.
      DATA(ls_teco) = VALUE jcds(
        objnr = ls_pmo-objnr
        stat  = 'I0045'
        udate = ls_pmo-teco_udate
        usnam = ls_pmo-teco_usnam ).
      APPEND ls_teco TO lt_jcds_teco.
    ENDIF.

    " JCDS REL
    IF ls_pmo-rel_udate IS NOT INITIAL.
      DATA(ls_rel) = VALUE jcds(
        objnr = ls_pmo-objnr
        stat  = 'I0002'
        udate = ls_pmo-rel_udate
        usnam = ls_pmo-rel_usnam ).
      APPEND ls_rel TO lt_jcds_rel.
    ENDIF.

  ENDLOOP.

  et_aufk      = lt_aufk.
  et_afih      = lt_afih.
  et_afko      = lt_afko.
  et_afru      = lt_afru.
  et_mhio      = lt_mhio.
  et_mhis      = lt_mhis.
  et_iloa      = lt_iloa.
  et_t001w     = lt_t001w.
  et_jcds_teco = lt_jcds_teco.
  et_jcds_rel  = lt_jcds_rel.

ENDMETHOD.
