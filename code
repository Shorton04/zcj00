INCLUDE <OBJECT>.

BEGIN_DATA OBJECT. " Do not change.. DATA is generated

DATA:
  BEGIN OF KEY,
    request LIKE ztb_a2r_wbshdr-zreq_num,
  END OF KEY,

  _ztb_a2r_wbshdr LIKE ztb_a2r_wbshdr.

END_DATA OBJECT. " Do not change.. DATA is generated

TABLES: ztb_a2r_wbshdr.

*---------------------------------------------------------------------*
* Table property
*---------------------------------------------------------------------*
GET_TABLE_PROPERTY ztb_a2r_wbshdr.

  DATA subrc LIKE sy-subrc.

  PERFORM select_table_ztb_a2r_wbshdr USING subrc.
  IF subrc NE 0.
    EXIT_OBJECT_NOT_FOUND.
  ENDIF.

END_PROPERTY.

*---------------------------------------------------------------------*
* Select header record by request number
*---------------------------------------------------------------------*
FORM select_table_ztb_a2r_wbshdr USING subrc LIKE sy-subrc.

  IF object-_ztb_a2r_wbshdr-mandt    IS INITIAL AND
     object-_ztb_a2r_wbshdr-zreq_num IS INITIAL.

    SELECT SINGLE *
      FROM ztb_a2r_wbshdr CLIENT SPECIFIED
      INTO ztb_a2r_wbshdr
      WHERE mandt    = sy-mandt
        AND zreq_num = object-key-request.

    subrc = sy-subrc.
    IF subrc NE 0.
      EXIT.
    ENDIF.

    object-_ztb_a2r_wbshdr = ztb_a2r_wbshdr.

  ELSE.
    subrc = 0.
    ztb_a2r_wbshdr = object-_ztb_a2r_wbshdr.
  ENDIF.

ENDFORM.

*---------------------------------------------------------------------*
* Method DISPLAY
*---------------------------------------------------------------------*
BEGIN_METHOD display CHANGING container.

  SET PARAMETER ID 'ZWBSREQUEST' FIELD object-key-request.
  CALL TRANSACTION 'ZCJ03' AND SKIP FIRST SCREEN.

END_METHOD.

*---------------------------------------------------------------------*
* Method CHANGE
*---------------------------------------------------------------------*
BEGIN_METHOD change CHANGING container.

  SET PARAMETER ID 'ZWBSREQUEST' FIELD object-key-request.
  CALL TRANSACTION 'ZCJ02N' AND SKIP FIRST SCREEN.

END_METHOD.

*---------------------------------------------------------------------*
* Property LV_REQUEST
*---------------------------------------------------------------------*
GET_PROPERTY lv_request CHANGING container.

  DATA lv_request_out TYPE char20.

  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
    EXPORTING
      input  = object-key-request
    IMPORTING
      output = lv_request_out.

  swc_set_element container 'LV_REQUEST' lv_request_out.

END_PROPERTY.