        iwerk     TYPE afih-iwerk,
        ingpr     TYPE afih-ingpr,
        priok     TYPE afih-priok,
        iloan     TYPE afih-iloan,
        ilart     TYPE afih-ilart,
        addat     TYPE afih-addat,
        warpl     TYPE afih-warpl,
