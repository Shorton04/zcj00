FORM refresh_gt_wbs_items_from_db USING iv_reqnum TYPE ztb_a2r_wbshdr-zreq_num.

  DATA: lt_item_db TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
        ls_item_db TYPE ztb_a2r_wbsitem.

  "Reload from DB (authoritative)
  FREE gt_wbs_items.

  SELECT *
    FROM ztb_a2r_wbsitem
    INTO TABLE @lt_item_db
    WHERE zreq_num = @iv_reqnum
    ORDER BY stufe, posid.

  IF lt_item_db IS INITIAL.
    MESSAGE e398(zcj00) WITH 'No WBS items found for this request.'.
  ENDIF.

  "If gt_wbs_items is NOT the same type as ztb_a2r_wbsitem,
  "use MOVE-CORRESPONDING to map common fields
  LOOP AT lt_item_db INTO ls_item_db.
    CLEAR gs_wbs_item.
    MOVE-CORRESPONDING ls_item_db TO gs_wbs_item.
    APPEND gs_wbs_item TO gt_wbs_items.
  ENDLOOP.

ENDFORM.

