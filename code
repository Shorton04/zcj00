*---------------------------------------------------------------------*
* Helper: get parent POSID (everything before last ".")
*---------------------------------------------------------------------*
FORM get_parent_posid  USING    iv_posid  TYPE ps_posid
                       CHANGING cv_parent TYPE ps_posid.

  DATA lv_off TYPE i.

  CLEAR cv_parent.
  IF iv_posid IS INITIAL.
    RETURN.
  ENDIF.

  FIND LAST OCCURRENCE OF '.' IN iv_posid MATCH OFFSET lv_off.
  IF sy-subrc = 0 AND lv_off > 0.
    cv_parent = iv_posid(lv_off).
  ENDIF.

ENDFORM.

*---------------------------------------------------------------------*
* TOTAL UP button logic for Screen 300 table control
* Totals GS_WBS_DISPLAY-ZAPPROVED_BUDG from deepest STUFE up to level 1
*---------------------------------------------------------------------*
FORM fcode_total_up.

  DATA: lt_work     TYPE STANDARD TABLE OF ty_wbs_display WITH DEFAULT KEY,
        lv_max      TYPE i,
        lv_level    TYPE i,
        lv_parent   TYPE ps_posid.

  FIELD-SYMBOLS: <ls>     TYPE ty_wbs_display,
                 <child>  TYPE ty_wbs_display,
                 <parent> TYPE ty_wbs_display.

  "1) Ensure current edited line is saved back to internal table
  "   (prevents losing the value the user just typed before clicking TOTAL_UP)
  IF tc_wbs-current_line > 0.
    READ TABLE gt_wbs_display ASSIGNING <ls> INDEX tc_wbs-current_line.
    IF sy-subrc = 0.
      <ls> = gs_wbs_display.
    ENDIF.
  ENDIF.

  IF gt_wbs_display IS INITIAL.
    RETURN.
  ENDIF.

  "2) Work on a copy
  lt_work = gt_wbs_display.

  "3) Determine deepest level (max STUFE)
  lv_max = 0.
  LOOP AT lt_work ASSIGNING <ls>.
    IF <ls>-stufe IS NOT INITIAL AND <ls>-stufe > lv_max.
      lv_max = <ls>-stufe.
    ENDIF.
  ENDLOOP.

  IF lv_max <= 1.
    "Nothing to total up
    gt_wbs_display = lt_work.
    RETURN.
  ENDIF.

  "4) Clear budgets for higher levels (everything above leaf level)
  "   Leaf level (lv_max) is manual input; all parents are recalculated
  LOOP AT lt_work ASSIGNING <ls> WHERE stufe < lv_max.
    CLEAR <ls>-zapproved_budg.
  ENDLOOP.

  "5) Bottom-up rollup: lv_max -> 2 (add child budget into parent)
  DO lv_max - 1 TIMES.
    lv_level = lv_max - sy-index + 1. "e.g. if max=5: 5,4,3,2

    LOOP AT lt_work ASSIGNING <child> WHERE stufe = lv_level.
      CLEAR lv_parent.
      PERFORM get_parent_posid USING <child>-posid CHANGING lv_parent.
      IF lv_parent IS INITIAL.
        CONTINUE.
      ENDIF.

      "Find parent row (by POSID). POSID is unique in your display.
      READ TABLE lt_work ASSIGNING <parent> WITH KEY posid = lv_parent.
      IF sy-subrc = 0.
        <parent>-zapproved_budg = <parent>-zapproved_budg + <child>-zapproved_budg.
      ENDIF.
    ENDLOOP.
  ENDDO.

  "6) Push results back to global table and refresh screen binding
  gt_wbs_display = lt_work.

  "Optional but recommended: rebind current line structure for correct display
  IF tc_wbs-current_line > 0.
    READ TABLE gt_wbs_display INTO gs_wbs_display INDEX tc_wbs-current_line.
  ENDIF.

ENDFORM.