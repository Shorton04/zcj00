DATA: gv_edit_mode          TYPE abap_bool,
      gv_loaded_reqnum      TYPE ztb_a2r_wbshdr-zreq_num,
      gv_header_initialized TYPE abap_bool.

CONSTANTS: gc_stat_draft TYPE ztb_a2r_wbshdr-z_reqstat VALUE 'DRAFT'. "adjust value



MODULE user_command_0500 INPUT.

  CASE ok_code.
    WHEN 'NEXT'.

      PERFORM f1_validate_reqnum USING p_zreq_num.
      PERFORM f1_load_req_to_globals USING p_zreq_num.

      "Set edit context before going to screen2
      gv_edit_mode          = abap_true.
      gv_loaded_reqnum      = p_zreq_num.
      gv_header_initialized = abap_false.

      CALL SCREEN 200.

    WHEN 'BACK' OR 'CANC' OR 'EXIT'.
      LEAVE TO SCREEN 0.
  ENDCASE.

  CLEAR ok_code.

ENDMODULE.




FORM f1_validate_reqnum USING iv_reqnum TYPE ztb_a2r_wbshdr-zreq_num.

  DATA: ls_hdr TYPE ztb_a2r_wbshdr.

  IF iv_reqnum IS INITIAL.
    MESSAGE e398(zcj00) WITH 'Please enter Request Number.'.
  ENDIF.

  SELECT SINGLE *
    FROM ztb_a2r_wbshdr
    INTO @ls_hdr
    WHERE zreq_num = @iv_reqnum.

  IF sy-subrc <> 0.
    MESSAGE e398(zcj00) WITH 'Request Number not found.'.
  ENDIF.

  IF ls_hdr-z_reqstat <> gc_stat_draft.
    MESSAGE e398(zcj00) WITH 'Request is not in draft status.'.
  ENDIF.

  IF ls_hdr-ernam <> sy-uname.
    MESSAGE e398(zcj00) WITH 'You are not allowed to edit this request.'.
  ENDIF.

ENDFORM.



FORM f1_load_req_to_globals USING iv_reqnum TYPE ztb_a2r_wbshdr-zreq_num.

  "Hard reset screen2 buffers
  CLEAR: gs_header.
  FREE:  gt_wbs_items, gt_wbs_display.

  "Load header
  SELECT SINGLE *
    FROM ztb_a2r_wbshdr
    INTO @gs_header
    WHERE zreq_num = @iv_reqnum.

  "Load items
  SELECT *
    FROM ztb_a2r_wbsitem
    INTO TABLE @gt_wbs_items
    WHERE zreq_num = @iv_reqnum
    ORDER BY stufe, posid.

  IF gt_wbs_items IS INITIAL.
    MESSAGE e398(zcj00) WITH 'No WBS items found for this request.'.
  ENDIF.

  "Align screen2 parameter-like globals (used by your forms)
  p_posnr = gs_header-posnr.
  p_prnam = gs_header-prnam.
  p_gjahr = gs_header-gjahr.
  p_kostl = gs_header-kostl.
  p_prctr = gs_header-prctr.
  p_plsez = gs_header-plsez.
  p_post1 = gs_header-post1.
  p_profl = gs_header-profl.

ENDFORM.




MODULE status_0200 OUTPUT.
  PERFORM prepare_screen2.
ENDMODULE.


FORM prepare_screen2.

  "Always get IM data (safe)
  PERFORM get_additional_im_data USING p_posnr.

  "Do not rebuild on re-entry (prevents overwriting user edits)
  IF gv_header_initialized = abap_true.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "FIRST ENTRY ONLY
  "------------------------------------------------------------
  IF gv_edit_mode = abap_true.

    "gt_wbs_items + gs_header already loaded from DB at screen 500 NEXT
    PERFORM convert_to_display.
    PERFORM set_wbs_default_values.  "optional; only fills INITIAL fields

    gv_header_initialized = abap_true.
    RETURN.

  ENDIF.

  "------------------------------------------------------------
  "CREATE MODE (A1) - original behavior
  "------------------------------------------------------------
  CLEAR gt_wbs_items.
  CALL METHOD go_builder->copy_template_structure
    EXPORTING
      iv_pspid     = p_pspid
      iv_kostl     = p_kostl
    CHANGING
      ct_wbs_items = gt_wbs_items.

  PERFORM convert_to_display.
  PERFORM set_wbs_default_values.
  PERFORM populate_header_structure.

  gv_header_initialized = abap_true.

ENDFORM.




FORM reset_edit_context.
  gv_edit_mode          = abap_false.
  gv_loaded_reqnum      = ''.
  gv_header_initialized = abap_false.
ENDFORM.



WHEN 'BACK' OR 'CANC' OR 'EXIT'.
  PERFORM reset_edit_context.
  LEAVE TO SCREEN 0.