*&---------------------------------------------------------------------*
*& Form VALIDATE_COST_CENTER
*&---------------------------------------------------------------------*
FORM validate_cost_center USING iv_kokrs TYPE kokrs
                                iv_kostl TYPE kostl
                                iv_plsez TYPE ps_plsez_chg
                          CHANGING cv_error TYPE abap_bool.

  " Check cost center validity against Finish Date
  SELECT SINGLE @abap_true
    FROM csks
    WHERE kostl = @iv_kostl
      AND kokrs = @iv_kokrs
      AND datab <= @iv_plsez
      AND datbi >= @iv_plsez
   INTO @DATA(lv_found) .
  IF sy-subrc = 0.
    CLEAR cv_error.
  ELSE.
    MESSAGE e000(zmsg_a2r) WITH 'Matrix does not exist. Approver not determined.'(m36).
    cv_error = gc_x.
  ENDIF.
ENDFORM.


*&---------------------------------------------------------------------*
*& Form VALIDATE_PROFIT_CENTER
*&---------------------------------------------------------------------*
FORM validate_profit_center USING iv_kokrs TYPE kokrs
                                  iv_prctr TYPE prctr
                                  iv_plsez TYPE ps_plsez_chg
                         CHANGING cv_error TYPE abap_bool.

  " Check profit center validity against Finish Date
  SELECT SINGLE @abap_true FROM cepc
    INTO @DATA(lv_found)
  WHERE prctr = @iv_prctr
    AND kokrs = @iv_kokrs
    AND datbi >= @iv_plsez.

  IF sy-subrc = 0.
    CLEAR cv_error.
  ELSE.
    MESSAGE e000(zmsg_a2r) WITH 'Finish Date:'(m45) iv_plsez 'is not a date scope of'(m46) iv_prctr.
    cv_error = gc_x.
  ENDIF.
ENDFORM.


*&---------------------------------------------------------------------*
*& Form VALIDATE_CC_PC_ASSIGNMENT
*&---------------------------------------------------------------------*
FORM validate_cc_pc_assignment USING iv_kokrs TYPE kokrs
                                     iv_kostl TYPE kostl
                                     iv_prctr TYPE prctr
                            CHANGING cv_error TYPE abap_bool.

  SELECT kokrs, kostl, datbi, datab, bukrs, prctr
    FROM csks
    INTO @DATA(ls_csks)
     WHERE kokrs = @iv_kokrs
     AND   kostl = @iv_kostl
     AND   prctr = @iv_prctr
     AND datab <= @sy-datum
     AND datbi >= @sy-datum
    ORDER BY datab.
  ENDSELECT.


  IF ls_csks-prctr <> iv_prctr.
    MESSAGE e000(zmsg_a2r) WITH iv_kostl 'is not assigned to'(m47) iv_prctr.
    cv_error = gc_x.
    RETURN.
  ENDIF.

  SELECT prctr, datbi, kokrs, bukrs
    FROM cepc
    INTO @DATA(ls_cepc)
    WHERE prctr = @iv_prctr
    AND kokrs = @iv_kokrs
    ORDER BY datbi.
  ENDSELECT.

  IF ls_cepc-bukrs IS NOT INITIAL AND
      ls_cepc-bukrs NE ls_csks-bukrs.
    MESSAGE e000(zmsg_a2r) WITH 'No Company Code Assigned'."ERROR ASSIGNEE
    cv_error = gc_x.
  ENDIF.

ENDFORM.

