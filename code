METHOD get_data_pmo.

  CLEAR: et_aufk, et_afih, et_afko, et_afru,
         et_jcds, et_mhio, et_mhis, et_jest,
         et_tj02t, et_iloa, gv_missing_auth,
         et_t001w, et_jcds_rel, et_jcds_teco.

  DATA lt_pmo TYPE STANDARD TABLE OF zi_wo_pmo WITH EMPTY KEY.

  "--------------------------------------------------------------------
  " Only mandatory range (r_iwerk) goes into CDS WHERE.
  " CDS cannot accept range tables — all others filtered in ABAP.
  "--------------------------------------------------------------------
  SELECT warpl, abnum, zaehl, nplda, wppos,
         aufnr, auart, erdat, idat2, vaplz, kostl, objnr,
         werks, werks_name, ktext, ernam,
         iwerk, ingpr, priok, ilart, addat, lacd_date, tplnr,
         gstri, getri, gstrs, gltrs,
         budat, conf_ernam,
         teco_udate, teco_usnam,
         rel_udate,  rel_usnam
    FROM zi_wo_pmo
    INTO TABLE @lt_pmo
    WHERE iwerk IN @is_parameter-r_iwerk.  "mandatory

  CHECK lt_pmo IS NOT INITIAL.

  "--------------------------------------------------------------------
  " Apply all optional range filters in ABAP (post-SELECT)
  "--------------------------------------------------------------------
  IF is_parameter-r_warpl IS NOT INITIAL.
    DELETE lt_pmo WHERE warpl NOT IN is_parameter-r_warpl.
  ENDIF.
  IF is_parameter-r_nplda IS NOT INITIAL.
    DELETE lt_pmo WHERE nplda NOT IN is_parameter-r_nplda.
  ENDIF.
  IF is_parameter-r_aufnr IS NOT INITIAL.
    DELETE lt_pmo WHERE aufnr NOT IN is_parameter-r_aufnr.
  ENDIF.
  IF is_parameter-r_auart IS NOT INITIAL.
    DELETE lt_pmo WHERE auart NOT IN is_parameter-r_auart.
  ENDIF.
  IF is_parameter-r_erdat IS NOT INITIAL.
    DELETE lt_pmo WHERE erdat NOT IN is_parameter-r_erdat.
  ENDIF.
  IF is_parameter-r_getri IS NOT INITIAL.
    DELETE lt_pmo WHERE getri NOT IN is_parameter-r_getri.
  ENDIF.
  IF is_parameter-r_gstri IS NOT INITIAL.
    DELETE lt_pmo WHERE gstri NOT IN is_parameter-r_gstri.
  ENDIF.
  IF is_parameter-r_ingpr IS NOT INITIAL.
    DELETE lt_pmo WHERE ingpr NOT IN is_parameter-r_ingpr.
  ENDIF.
  IF is_parameter-r_priok IS NOT INITIAL.
    DELETE lt_pmo WHERE priok NOT IN is_parameter-r_priok.
  ENDIF.
  IF is_parameter-r_tplnr IS NOT INITIAL.
    DELETE lt_pmo WHERE tplnr NOT IN is_parameter-r_tplnr.
  ENDIF.
  IF is_parameter-r_idat2 IS NOT INITIAL.
    DELETE lt_pmo WHERE idat2 NOT IN is_parameter-r_idat2.
  ENDIF.
  IF is_parameter-r_vaplz IS NOT INITIAL.
    DELETE lt_pmo WHERE vaplz NOT IN is_parameter-r_vaplz.
  ENDIF.
  IF is_parameter-r_kostl IS NOT INITIAL.
    DELETE lt_pmo WHERE kostl NOT IN is_parameter-r_kostl.
  ENDIF.
  IF is_parameter-r_ilart IS NOT INITIAL.
    DELETE lt_pmo WHERE ilart NOT IN is_parameter-r_ilart.
  ENDIF.

  CHECK lt_pmo IS NOT INITIAL.

  "--------------------------------------------------------------------
  " Authority check
  "--------------------------------------------------------------------
  DATA lt_pmo_auth TYPE STANDARD TABLE OF zi_wo_pmo WITH EMPTY KEY.

  LOOP AT lt_pmo INTO DATA(ls_pmo_auth).
    AUTHORITY-CHECK OBJECT 'I_IWERK'
      ID 'TCD'   FIELD 'ZIW123'
      ID 'IWERK' FIELD ls_pmo_auth-iwerk.
    IF sy-subrc = 0.
      APPEND ls_pmo_auth TO lt_pmo_auth.
    ELSE.
      gv_missing_auth = abap_true.
    ENDIF.
  ENDLOOP.

  lt_pmo = lt_pmo_auth.
  CHECK lt_pmo IS NOT INITIAL.

  "--------------------------------------------------------------------
  " Map CDS result into existing export structures
  "--------------------------------------------------------------------
  DATA lt_aufk      TYPE STANDARD TABLE OF ts_aufk  WITH EMPTY KEY.
  DATA lt_afih      TYPE STANDARD TABLE OF ts_afih  WITH EMPTY KEY.
  DATA lt_afko      TYPE STANDARD TABLE OF ts_afko  WITH EMPTY KEY.
  DATA lt_afru      TYPE STANDARD TABLE OF ts_afru  WITH EMPTY KEY.
  DATA lt_mhio      TYPE STANDARD TABLE OF ts_mhio  WITH EMPTY KEY.
  DATA lt_mhis      TYPE STANDARD TABLE OF ts_mhis  WITH EMPTY KEY.
  DATA lt_iloa      TYPE STANDARD TABLE OF ts_iloa  WITH EMPTY KEY.
  DATA lt_t001w     TYPE STANDARD TABLE OF ts_t001w WITH EMPTY KEY.
  DATA lt_jcds_teco TYPE STANDARD TABLE OF jcds     WITH EMPTY KEY.
  DATA lt_jcds_rel  TYPE STANDARD TABLE OF jcds     WITH EMPTY KEY.

  LOOP AT lt_pmo INTO DATA(ls_pmo).

    "--- AUFK ---
    APPEND VALUE ts_aufk(
      aufnr = ls_pmo-aufnr
      auart = ls_pmo-auart
      erdat = ls_pmo-erdat
      idat2 = ls_pmo-idat2
      vaplz = ls_pmo-vaplz
      kostl = ls_pmo-kostl
      objnr = ls_pmo-objnr
      werks = ls_pmo-werks
      ktext = ls_pmo-ktext
      ernam = ls_pmo-ernam ) TO lt_aufk.

    "--- AFIH ---
    APPEND VALUE ts_afih(
      aufnr     = ls_pmo-aufnr
      iwerk     = ls_pmo-iwerk
      ingpr     = ls_pmo-ingpr
      priok     = ls_pmo-priok
      ilart     = ls_pmo-ilart
      addat     = ls_pmo-addat
      lacd_date = ls_pmo-lacd_date ) TO lt_afih.

    "--- AFKO ---
    APPEND VALUE ts_afko(
      aufnr = ls_pmo-aufnr
      gstri = ls_pmo-gstri
      getri = ls_pmo-getri
      gstrs = ls_pmo-gstrs
      gltrs = ls_pmo-gltrs ) TO lt_afko.

    "--- AFRU (only if confirmation exists) ---
    IF ls_pmo-budat IS NOT INITIAL.
      APPEND VALUE ts_afru(
        aufnr = ls_pmo-aufnr
        budat = ls_pmo-budat
        ernam = ls_pmo-conf_ernam ) TO lt_afru.
    ENDIF.

    "--- MHIO ---
    APPEND VALUE ts_mhio(
      warpl = ls_pmo-warpl
      abnum = ls_pmo-abnum
      wppos = ls_pmo-wppos
      aufnr = ls_pmo-aufnr ) TO lt_mhio.

    "--- MHIS — deduplicate using READ TABLE ---
    READ TABLE lt_mhis WITH KEY warpl = ls_pmo-warpl
                                abnum = ls_pmo-abnum
         TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0.
      APPEND VALUE ts_mhis(
        warpl = ls_pmo-warpl
        abnum = ls_pmo-abnum
        zaehl = ls_pmo-zaehl
        nplda = ls_pmo-nplda ) TO lt_mhis.
    ENDIF.

    "--- ILOA ---
    APPEND VALUE ts_iloa(
      tplnr = ls_pmo-tplnr ) TO lt_iloa.

    "--- T001W — deduplicate using READ TABLE ---
    READ TABLE lt_t001w WITH KEY werks = ls_pmo-werks
         TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0.
      APPEND VALUE ts_t001w(
        werks = ls_pmo-werks
        name1 = ls_pmo-werks_name ) TO lt_t001w.
    ENDIF.

    "--- JCDS TECO ---
    IF ls_pmo-teco_udate IS NOT INITIAL.
      APPEND VALUE jcds(
        objnr = ls_pmo-objnr
        stat  = 'I0045'
        udate = ls_pmo-teco_udate
        usnam = ls_pmo-teco_usnam ) TO lt_jcds_teco.
    ENDIF.

    "--- JCDS REL ---
    IF ls_pmo-rel_udate IS NOT INITIAL.
      APPEND VALUE jcds(
        objnr = ls_pmo-objnr
        stat  = 'I0002'
        udate = ls_pmo-rel_udate
        usnam = ls_pmo-rel_usnam ) TO lt_jcds_rel.
    ENDIF.

  ENDLOOP.

  "--------------------------------------------------------------------
  " Export
  "--------------------------------------------------------------------
  et_aufk      = lt_aufk.
  et_afih      = lt_afih.
  et_afko      = lt_afko.
  et_afru      = lt_afru.
  et_mhio      = lt_mhio.
  et_mhis      = lt_mhis.
  et_iloa      = lt_iloa.
  et_t001w     = lt_t001w.
  et_jcds_teco = lt_jcds_teco.
  et_jcds_rel  = lt_jcds_rel.

ENDMETHOD.
