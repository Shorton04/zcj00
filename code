*&---------------------------------------------------------------------*
*& Report ZTEST_SUBP
*&---------------------------------------------------------------------*
REPORT ztest_subp.

*---------------------------------------------------------------------*
* Input
*---------------------------------------------------------------------*
PARAMETERS:
  p_aufnr TYPE aufnr OBLIGATORY,          "Maintenance Order
  p_sts   TYPE bsvx-sttxt OBLIGATORY,     "Example: RFRA / REXE
  p_stchg TYPE jest-stat OBLIGATORY.       "User status e.g. E0014

*---------------------------------------------------------------------*
* Data
*---------------------------------------------------------------------*
DATA:
  "----- Status Change
  lv_objnr          TYPE jest-objnr,

  "----- First Call : CHECK_BEFORE_SAVE
  lt_methods_1      TYPE TABLE OF bapi_alm_order_method,
  lt_header_1       TYPE TABLE OF bapi_alm_order_headers_i,
  lt_operation_1    TYPE TABLE OF bapi_alm_order_operation,
  lt_userstatus_1   TYPE TABLE OF bapi_alm_order_usrstat,
  lt_extension_1    TYPE TABLE OF bapiparex,
  lt_return_1       TYPE TABLE OF bapiret2,

  "----- Second Call : SAVE_BAPI_AND_RELEASE
  lt_methods_2      TYPE TABLE OF bapi_alm_order_method,
  lt_header_2       TYPE TABLE OF bapi_alm_order_headers_i,
  lt_header_up_2    TYPE TABLE OF bapi_alm_order_headers_up,
  lt_extension_2    TYPE TABLE OF bapiparex,
  lt_return_2       TYPE TABLE OF bapiret2,
  lt_numbers        TYPE TABLE OF bapi_alm_numbers,

  ls_method         TYPE bapi_alm_order_method,
  ls_header         TYPE bapi_alm_order_headers_i,
  ls_header_up      TYPE bapi_alm_order_headers_up,
  ls_operation      TYPE bapi_alm_order_operation,
  ls_userstatus     TYPE bapi_alm_order_usrstat,
  ls_extension      TYPE bapiparex,
  ls_return         TYPE bapiret2,

  lv_vornr          TYPE vornr.

*---------------------------------------------------------------------*
* Get first operation automatically (test purpose)
*---------------------------------------------------------------------*
SELECT SINGLE a~vornr
  INTO @lv_vornr
  FROM afvc AS a
  INNER JOIN afko AS k
    ON k~aufpl = a~aufpl
 WHERE k~aufnr = @p_aufnr.

IF sy-subrc <> 0.
  WRITE: / 'No operation found for order:', p_aufnr.
  EXIT.
ENDIF.

WRITE: / 'Operation Found:', lv_vornr.

************************************************************************
* STEP 1: SET USER STATUS VIA STATUS_CHANGE_EXTERN
************************************************************************

" Get OBJNR for the operation
SELECT SINGLE objnr
  INTO @lv_objnr
  FROM afvc AS a
  INNER JOIN afko AS k
    ON k~aufpl = a~aufpl
 WHERE k~aufnr = @p_aufnr
   AND a~vornr = @lv_vornr.

IF sy-subrc <> 0.
  WRITE: / 'Could not determine OBJNR for operation', lv_vornr.
  EXIT.
ENDIF.

CALL FUNCTION 'STATUS_CHANGE_EXTERN'
  EXPORTING
    objnr               = lv_objnr
    user_status          = p_stchg
    set_inact            = space
  EXCEPTIONS
    object_not_found     = 1
    status_inconsistent  = 2
    status_not_allowed   = 3
    OTHERS               = 4.

IF sy-subrc <> 0.
  WRITE: / 'STATUS_CHANGE_EXTERN FAILED, sy-subrc:', sy-subrc.
  ROLLBACK WORK.
  EXIT.
ENDIF.

WRITE: / 'STATUS_CHANGE_EXTERN SUCCESS:', p_stchg.

" Do NOT commit — stay in the same LUW for BAPI

************************************************************************
* STEP 2: FIRST CALL — CHECK_BEFORE_SAVE
************************************************************************

*---------------------------------------------------------------------*
* HEADER
*---------------------------------------------------------------------*
CLEAR ls_header.
ls_header-orderid = p_aufnr.
APPEND ls_header TO lt_header_1.

*---------------------------------------------------------------------*
* OPERATION
*---------------------------------------------------------------------*
CLEAR ls_operation.
ls_operation-activity = lv_vornr.
APPEND ls_operation TO lt_operation_1.

*---------------------------------------------------------------------*
* USER STATUS
*---------------------------------------------------------------------*
CLEAR ls_userstatus.
ls_userstatus-user_st_text = p_sts.
ls_userstatus-langu        = sy-langu.
APPEND ls_userstatus TO lt_userstatus_1.

*---------------------------------------------------------------------*
* METHOD : HEADER CHANGE
*---------------------------------------------------------------------*
CLEAR ls_method.
ls_method-refnumber  = '000001'.
ls_method-objecttype = 'HEADER'.
ls_method-method     = 'CHANGE'.
ls_method-objectkey  = p_aufnr.
APPEND ls_method TO lt_methods_1.

*---------------------------------------------------------------------*
* METHOD : DIALOG
*---------------------------------------------------------------------*
CLEAR ls_method.
ls_method-refnumber  = '000000'.
ls_method-method     = 'DIALOG'.
APPEND ls_method TO lt_methods_1.

*---------------------------------------------------------------------*
* EXTENSION : CHECK_BEFORE_SAVE
*---------------------------------------------------------------------*
CLEAR ls_extension.
ls_extension-structure  = 'SEOCPDNAME'.
ls_extension-valuepart1 = 'CHECK_BEFORE_SAVE'.
ls_extension-valuepart2 = 'CL_EAMS_BO_ORDER'.
APPEND ls_extension TO lt_extension_1.

*---------------------------------------------------------------------*
* Execute First BAPI Call
*---------------------------------------------------------------------*
CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
  EXPORTING
    iv_mmsrv_external_maintenace = abap_true
  TABLES
    it_methods    = lt_methods_1
    it_header     = lt_header_1
    it_operation  = lt_operation_1
    it_userstatus = lt_userstatus_1
    extension_in  = lt_extension_1
    return        = lt_return_1.

READ TABLE lt_return_1 INTO ls_return
  WITH KEY type = 'E'.

IF sy-subrc = 0.

  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.

  WRITE: / 'ERROR IN FIRST CALL (CHECK_BEFORE_SAVE):'.

  LOOP AT lt_return_1 INTO ls_return.
    WRITE: / ls_return-type, ls_return-message.
  ENDLOOP.

  EXIT.

ENDIF.

************************************************************************
* STEP 3: SECOND CALL — SAVE_BAPI_AND_RELEASE
************************************************************************

*---------------------------------------------------------------------*
* HEADER
*---------------------------------------------------------------------*
CLEAR ls_header.
ls_header-orderid = p_aufnr.
APPEND ls_header TO lt_header_2.

*---------------------------------------------------------------------*
* HEADER_UP (Very Important)
*---------------------------------------------------------------------*
CLEAR ls_header_up.
ls_header_up-orderid = p_aufnr.
APPEND ls_header_up TO lt_header_up_2.

*---------------------------------------------------------------------*
* METHOD : SAVE ONLY
*---------------------------------------------------------------------*
CLEAR ls_method.
ls_method-refnumber = '000000'.
ls_method-method    = 'SAVE'.
APPEND ls_method TO lt_methods_2.

*---------------------------------------------------------------------*
* EXTENSION : SAVE_BAPI_AND_RELEASE
*---------------------------------------------------------------------*
CLEAR ls_extension.
ls_extension-structure  = 'SEOCPDNAME'.
ls_extension-valuepart1 = 'SAVE_BAPI_AND_RELEASE'.
ls_extension-valuepart2 = 'CL_EAMS_BO_ORDER'.
APPEND ls_extension TO lt_extension_2.

*---------------------------------------------------------------------*
* Execute Second BAPI Call
*---------------------------------------------------------------------*
CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
  EXPORTING
    iv_mmsrv_external_maintenace = abap_true
  TABLES
    it_methods    = lt_methods_2
    it_header     = lt_header_2
    it_header_up  = lt_header_up_2
    extension_in  = lt_extension_2
    et_numbers    = lt_numbers
    return        = lt_return_2.

READ TABLE lt_return_2 INTO ls_return
  WITH KEY type = 'E'.

IF sy-subrc = 0.

  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.

  WRITE: / 'ERROR IN SECOND CALL (SAVE):'.

  LOOP AT lt_return_2 INTO ls_return.
    WRITE: / ls_return-type, ls_return-message.
  ENDLOOP.

ELSE.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  WRITE: / 'SUCCESS'.
  WRITE: / 'Order      :', p_aufnr.
  WRITE: / 'Operation  :', lv_vornr.
  WRITE: / 'User Status:', p_stchg.
  WRITE: / 'Phase/Sub  :', p_sts.

ENDIF.
