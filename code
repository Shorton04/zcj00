FORM validate_pc_fr_unit
  USING
    iv_gjahr TYPE gjahr
    iv_posnr TYPE impr-posnr
    iv_prnam TYPE impr-prnam.

  DATA: lv_fr_unit_screen TYPE zzfrunit,
        lv_fr_unit_im     TYPE zzfrunit,
        lv_im_bukrs       TYPE bukrs,
        lv_im_prctr       TYPE prctr.

  CLEAR: lv_fr_unit_screen,
         lv_fr_unit_im,
         lv_im_bukrs,
         lv_im_prctr.

  "---------------------------------------------------------------*
  "* 1) Read FR Unit of Profit Center entered on screen
  "*    Key: Fiscal Year + Company Code + Profit Center
  "---------------------------------------------------------------*
  SELECT SINGLE fr_unit
    INTO @lv_fr_unit_screen
    FROM ztxca_org01
    WHERE gjahr = @iv_gjahr
      AND bukrs = @gs_header-bukrs
      AND prctr = @gs_header-prctr.

  IF sy-subrc <> 0.
    MESSAGE e001(zcj00)
      WITH 'No Functional Reporting Unit found in ZTXCA_ORG01 for Screen Profit Center'
           gs_header-prctr gs_header-bukrs iv_gjahr.
    EXIT.
  ENDIF.

  "---------------------------------------------------------------*
  "* 2) Get IM values (Company Code / Profit Center)
  "*    based on selected IM Program + IM Position
  "---------------------------------------------------------------*
  SELECT SINGLE bukrs, prctr
    INTO (@lv_im_bukrs, @lv_im_prctr)
    FROM impr
    WHERE prnam = @iv_prnam
      AND posnr = @iv_posnr
      AND gjahr = @iv_gjahr.

  IF sy-subrc <> 0.
    MESSAGE e001(zcj00)
      WITH 'IM data not found in IMPR for validation'
           iv_prnam iv_posnr iv_gjahr.
    EXIT.
  ENDIF.

  "---------------------------------------------------------------*
  "* 3) Read FR Unit stored in ECC IM header custom table
  "*    Spec says IM FR Unit is in ZIMP_REQ_HEADER-FR_UNIT
  "---------------------------------------------------------------*
  SELECT SINGLE fr_unit
    INTO @lv_fr_unit_im
    FROM zimp_req_header
    WHERE gjahr = @iv_gjahr
      AND bukrs = @lv_im_bukrs
      AND prctr = @lv_im_prctr
      AND prnam = @iv_prnam.

  IF sy-subrc <> 0.
    MESSAGE e001(zcj00)
      WITH 'No FR Unit found in ZIMP_REQ_HEADER for selected IM'
           iv_prnam lv_im_prctr iv_gjahr.
    EXIT.
  ENDIF.

  "---------------------------------------------------------------*
  "* 4) Compare Screen Profit Center FR Unit vs IM FR Unit
  "---------------------------------------------------------------*
  IF lv_fr_unit_screen <> lv_fr_unit_im.
    MESSAGE e001(zcj00)
      WITH 'Functional Reporting Unit mismatch between Screen Profit Center and IM'
           gs_header-prctr lv_fr_unit_screen lv_fr_unit_im.
    EXIT.
  ENDIF.

ENDFORM.



PERFORM validate_pc_fr_unit
  USING gv_gjahr
        gs_header-posnr
        gs_header-prnam.