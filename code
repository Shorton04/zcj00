FORM save_wf_rejection_comments.

  DATA: lo_wflog   TYPE REF TO zcl_a2r_wbs_workflow_log,
        lv_success TYPE abap_bool.

  CREATE OBJECT lo_wflog.

  lv_success = lo_wflog->save_rejection_comments(
                 iv_zreq_num = gs_header-zreq_num ).

  IF lv_success = abap_true.
    MESSAGE 'Rejection reasons saved.' TYPE 'S'.
  ELSE.
    MESSAGE 'No rejection comments found.' TYPE 'I'.
  ENDIF.

ENDFORM.
