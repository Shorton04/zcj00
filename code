    "--------------------------------------------------------------------
    " Fetch 2: Full JCDS history for TECO(I0045) and REL(I0002)
    " ALL records including inactive — pick latest by date in BUILD_DATA
    " This ensures Release On/By shows even if REL was later reversed
    "--------------------------------------------------------------------
    DATA lt_jcds_history TYPE STANDARD TABLE OF ts_jcds WITH EMPTY KEY.
    DATA lt_stat_range   TYPE RANGE OF jcds-stat.

    "--- Build range for I0045 and I0002 ---
    lt_stat_range = VALUE #(
      ( sign = 'I' option = 'EQ' low = 'I0045' )
      ( sign = 'I' option = 'EQ' low = 'I0002' ) ).

    SELECT jcds~objnr, jcds~stat, jcds~udate,
           jcds~utime,  jcds~usnam, jcds~inact
      FROM jcds
      INNER JOIN @lt_aufk AS aufk ON aufk~objnr = jcds~objnr
      INTO CORRESPONDING FIELDS OF TABLE @lt_jcds_history
      WHERE jcds~stat IN @lt_stat_range.   "← IN range, not OR

    "--- Split into TECO / REL ---
    LOOP AT lt_jcds_history INTO DATA(ls_jcds_hist).
      IF ls_jcds_hist-stat = 'I0045'.
        APPEND VALUE ts_jcds(
          objnr = ls_jcds_hist-objnr
          stat  = ls_jcds_hist-stat
          udate = ls_jcds_hist-udate
          utime = ls_jcds_hist-utime
          usnam = ls_jcds_hist-usnam ) TO lt_jcds_teco.
      ELSEIF ls_jcds_hist-stat = 'I0002'.
        APPEND VALUE ts_jcds(
          objnr = ls_jcds_hist-objnr
          stat  = ls_jcds_hist-stat
          udate = ls_jcds_hist-udate
          utime = ls_jcds_hist-utime
          usnam = ls_jcds_hist-usnam ) TO lt_jcds_rel.
      ENDIF.
    ENDLOOP.





    "--------------------------------------------------------------------
    " Released By / On
    " Picks latest REL record by date+time
    " includes inactive history so even reversed REL shows last date/user
    "--------------------------------------------------------------------
    CLEAR lt_jcds_tmp.
    LOOP AT lt_jcds_rel INTO ls_jcds
      WHERE objnr = ls_aufk-objnr.
      APPEND ls_jcds TO lt_jcds_tmp.
    ENDLOOP.

    IF lt_jcds_tmp IS NOT INITIAL.
      SORT lt_jcds_tmp BY udate DESCENDING
                          utime DESCENDING.
      READ TABLE lt_jcds_tmp INTO ls_jcds INDEX 1.
      IF sy-subrc = 0.
        ls_result-usnam_rel_by = ls_jcds-usnam.
        ls_result-udate        = ls_jcds-udate.
      ENDIF.
    ENDIF.
