DATA: lt_prps TYPE SORTED TABLE OF prps
                WITH UNIQUE KEY posid,
      lt_bpge TYPE STANDARD TABLE OF bpge.

DATA: lr_posid TYPE RANGE OF prps-posid.

FIELD-SYMBOLS:
  <fs_wbs_item> TYPE ztb_a2r_wbsitem.

"------------------------------------------------------------
" Build range using POSID from GT_WBS_ITEMS
"------------------------------------------------------------
LOOP AT gt_wbs_items ASSIGNING <fs_wbs_item>.

  IF <fs_wbs_item>-posid IS NOT INITIAL.
    APPEND VALUE #(
      sign   = 'I'
      option = 'EQ'
      low    = <fs_wbs_item>-posid
    ) TO lr_posid.
  ENDIF.

ENDLOOP.

SORT lr_posid BY low.
DELETE ADJACENT DUPLICATES FROM lr_posid COMPARING low.

"------------------------------------------------------------
" Read PRPS for:
" - ZUNIFIER_PROJ
" - OBJNR (needed for BPGE)
"------------------------------------------------------------
IF lr_posid IS NOT INITIAL.

  SELECT posid,
         objnr,
         zunifier_proj
    FROM prps
    INTO TABLE @lt_prps
    WHERE posid IN @lr_posid.

ENDIF.

"------------------------------------------------------------
" Read BPGE using OBJNR from PRPS
" Need max LEDNR where GEBER is not initial
"------------------------------------------------------------
IF lt_prps IS NOT INITIAL.

  SELECT objnr,
         lednr,
         geber
    FROM bpge
    INTO TABLE @lt_bpge
    FOR ALL ENTRIES IN @lt_prps
    WHERE objnr = @lt_prps-objnr
      AND wrttp = '41'
      AND geber IS NOT INITIAL.

ENDIF.

SORT lt_bpge BY objnr lednr DESCENDING.

"------------------------------------------------------------
" Fill GT_WBS_ITEMS
"------------------------------------------------------------
LOOP AT gt_wbs_items ASSIGNING <fs_wbs_item>.

  CLEAR:
    <fs_wbs_item>-zbudget_check,
    <fs_wbs_item>-zunifier_proj.

  "------------------------------------------
  " Read PRPS using POSID
  "------------------------------------------
  READ TABLE lt_prps INTO DATA(ls_prps)
    WITH KEY posid = <fs_wbs_item>-posid
    BINARY SEARCH.

  IF sy-subrc = 0.

    "Fill ZUNIFIER_PROJ
    <fs_wbs_item>-zunifier_proj = ls_prps-zunifier_proj.

    "------------------------------------------
    " Budget Check from BPGE
    " if max LEDNR exists with GEBER not initial
    " then set X
    "------------------------------------------
    READ TABLE lt_bpge INTO DATA(ls_bpge)
      WITH KEY objnr = ls_prps-objnr
      BINARY SEARCH.

    IF sy-subrc = 0.
      <fs_wbs_item>-zbudget_check = 'X'.
    ENDIF.

  ENDIF.

ENDLOOP.