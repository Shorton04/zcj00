FORM validate_and_load_draft_req USING pv_reqnum TYPE ztb_a2r_wbshdr-zreq_num.

  DATA: ls_hdr TYPE ztb_a2r_wbshdr.

  "Basic check
  IF pv_reqnum IS INITIAL.
    MESSAGE e398(zcj00) WITH 'Please enter Request Number.'.
  ENDIF.

  "Read Header
  SELECT SINGLE *
    FROM ztb_a2r_wbshdr
    INTO @ls_hdr
    WHERE zreq_num = @pv_reqnum.

  IF sy-subrc <> 0.
    MESSAGE e398(zcj00) WITH 'Request Number not found.'.
  ENDIF.

  "Only creator can edit
  IF ls_hdr-ernam <> sy-uname.
    MESSAGE e398(zcj00) WITH 'You are not allowed to edit this request.'.
  ENDIF.

  "Must be Draft
  "Field from your table screenshot: REQUEST_STATUS
  IF ls_hdr-request_status <> 'DRAFT'.  "<<< adjust if your value is DRFT etc.
    MESSAGE e398(zcj00) WITH 'Request is not in DRAFT status.'.
  ENDIF.

  "Reset buffers (important)
  CLEAR: gs_header.
  FREE:  gt_wbs_items, gt_wbs_display.

  "Load header to screen2 structure
  MOVE-CORRESPONDING ls_hdr TO gs_header.

  "Load items to internal table used by screen2
  SELECT *
    FROM ztb_a2r_wbsitem
    INTO TABLE @gt_wbs_items
    WHERE zreq_num = @pv_reqnum
    ORDER BY stufe, posid.

  IF gt_wbs_items IS INITIAL.
    MESSAGE e398(zcj00) WITH 'No WBS items found for this request.'.
  ENDIF.

  "Align your helper PERFORMs that use p_* (posnr used by IMPR reads)
  p_posnr = gs_header-posnr.
  p_prnam = gs_header-prnam.
  p_kostl = gs_header-kostl.
  p_post1 = gs_header-post1.
  p_prctr = gs_header-prctr.
  p_plsez = gs_header-plsez.
  p_profl = gs_header-profl.

  "Mark edit mode so prepare_screen2 will NOT copy template
  gv_edit_mode          = abap_true.
  gv_loaded_reqnum      = pv_reqnum.
  gv_header_initialized = abap_false.

ENDFORM.





FORM prepare_screen2.

  "Always get IM data (safe, doesn't overwrite screen2 edits)
  PERFORM get_additional_im_data USING p_posnr.

  "Initialize screen2 ONCE only
  IF gv_header_initialized = abap_true.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "FIRST ENTRY ONLY
  "------------------------------------------------------------

  "=============================
  "EDIT SAVED REQUEST (F1)
  "=============================
  IF gv_edit_mode = abap_true.

    "At this point, caller already loaded:
    " - gs_header from ZTB_A2R_WBSHDR
    " - gt_wbs_items from ZTB_A2R_WBSITEM
    "So DO NOT rebuild anything from template.

    PERFORM convert_to_display.
    PERFORM set_wbs_default_values.  "only fills INITIAL values (safe)

    "IMPORTANT: Do NOT call populate_header_structure in edit mode
    "because it may overwrite DB header values (erdat/ernam etc.)

    gv_header_initialized = abap_true.
    RETURN.

  ENDIF.

  "=============================
  "CREATE MODE (A1)
  "=============================

  " Build WBS items in correct PRHIS order
  CLEAR gt_wbs_items.
  CALL METHOD go_builder->copy_template_structure
    EXPORTING
      iv_pspid     = p_pspid
      iv_kostl     = p_kostl
    CHANGING
      ct_wbs_items = gt_wbs_items.

  PERFORM convert_to_display.
  PERFORM set_wbs_default_values.
  PERFORM populate_header_structure.

  gv_header_initialized = abap_true.

ENDFORM.