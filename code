   "═══════════════════════════════════════════════════════════════════
    " STEP 10: CREATE SETTLEMENT RULES - DEBUG VERSION
    "═══════════════════════════════════════════════════════════════════
    DATA: lt_bdcdata     TYPE TABLE OF bdcdata,
          lt_bdcmsg      TYPE TABLE OF bdcmsgcoll,
          ls_bdcmsg      TYPE bdcmsgcoll,
          lv_pspid_char  TYPE char24,
          lv_period_char TYPE char24,
          lv_gjahr_char  TYPE char24,
          lv_mode        TYPE c VALUE 'N',  " Changed to 'A' for debugging
          lv_update      TYPE c VALUE 'S'.

    " Get current period and fiscal year
    DATA(lv_period) = sy-datum+4(2).  " Current month (MM)
    DATA(lv_gjahr) = sy-datum+0(4).   " Current year (YYYY)

    " Convert to CHAR132
    lv_period_char = lv_period.
    lv_gjahr_char = lv_gjahr.
    lv_vkokr_char  = lv_vkokr.

    " Get Level 1 WBS Element (Project Definition) from lt_wbs_celement
    READ TABLE lt_wbs_celement INTO ls_wbs_celement INDEX 1.

    IF sy-subrc = 0 AND ls_wbs_celement-wbs_element IS NOT INITIAL.

      " Convert to CHAR132
      lv_pspid_char = ls_wbs_celement-wbs_element.

*      "  DEBUG: Show what we're passing to CJB2
*      MESSAGE i025(zcj00) WITH 'Calling CJB2 with:' lv_pspid_char
*        DISPLAY LIKE 'I'.
*
*      IF sy-uname = 'EV92123'.
      CLEAR lt_bdcdata.
      bdc_dynpro(
        EXPORTING
          iv_program = 'SAPLKAZB'
          iv_dynpro  = '1000'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'BDC_OKCODE'
          iv_fval    = '/EOKKS'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).


      bdc_dynpro(
        EXPORTING
          iv_program = 'SAPLSPO4'
          iv_dynpro  = '0300'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'BDC_OKCODE'
          iv_fval    = '=FURT'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'SVALD-VALUE(01)'
          iv_fval    = CONV #( lv_vkokr_char )
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).


      bdc_dynpro(
        EXPORTING
          iv_program = 'SAPLKAZB'
          iv_dynpro  = '1000'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'BDC_OKCODE'
          iv_fval    = '=RUN'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'BDC_CURSOR'
          iv_fval    = 'RKAUF-LIST'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'RKAUF-TEST'
          iv_fval    = ''
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'BDC_SUBSCR'
          iv_fval    = 'SAPLKAOP                                0570BLOCK1'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'LKP74-PSPID'
          iv_fval    = CONV #( lv_pspid_char )
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'BDC_SUBSCR'
          iv_fval    = 'SAPLKAZB                                2100BLOCK2'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'RKAUF-FROM'
          iv_fval    = CONV #( lv_period_char )
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'RKAUF-GJAHR'
          iv_fval    = CONV #( lv_gjahr_char )
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      " Execute CJB2 in foreground
      CLEAR lt_bdcmsg.

      CALL TRANSACTION 'CJB2'
        USING lt_bdcdata
        MODE lv_mode
        UPDATE lv_update
        MESSAGES INTO lt_bdcmsg.

      "  DEBUG: Display any error messages
      LOOP AT lt_bdcmsg INTO ls_bdcmsg WHERE msgtyp = 'E' OR msgtyp = 'A'.
        MESSAGE ID ls_bdcmsg-msgid TYPE 'I' NUMBER ls_bdcmsg-msgnr
          WITH ls_bdcmsg-msgv1 ls_bdcmsg-msgv2
               ls_bdcmsg-msgv3 ls_bdcmsg-msgv4
          DISPLAY LIKE 'E'.
      ENDLOOP.

      "  DEBUG: Show success messages too
      LOOP AT lt_bdcmsg INTO ls_bdcmsg WHERE msgtyp = 'S'.
        MESSAGE ID ls_bdcmsg-msgid TYPE 'I' NUMBER ls_bdcmsg-msgnr
          WITH ls_bdcmsg-msgv1 ls_bdcmsg-msgv2
          DISPLAY LIKE 'S'.
      ENDLOOP.
