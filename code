LOOP AT it_wbs_car INTO ls_car_filter
    WHERE wert2 IS NOT INITIAL
    AND wert2 <> 0.

  READ TABLE it_phris_hier ASSIGNING <fs_phris>
  WITH KEY target_posid = ls_car_filter-posid.
  IF sy-subrc = 0.
    APPEND <fs_phris> TO lt_phris_hier_used.
  ELSE.
    " Manually inserted WBS - build hierarchy entry dynamically
    DATA lv_p_len  TYPE i.
    DATA ls_new_hier TYPE zsa2r_wbshier.

    lv_p_len = strlen( ls_car_filter-posid ) - 1.

    ls_new_hier-target_posid = ls_car_filter-posid.
    ls_new_hier-wbs_up       = ls_car_filter-posid(lv_p_len). " e.g. PC000874023 → PC00087402

    " Find left sibling
    DATA lv_left TYPE ps_posid.
    DATA lv_s_len TYPE i.
    LOOP AT it_wbs_items INTO DATA(ls_sib2).
      lv_s_len = strlen( ls_sib2-posid ) - 1.
      IF ls_sib2-posid(lv_s_len) = ls_new_hier-wbs_up
        AND ls_sib2-posid < ls_car_filter-posid.
        lv_left = ls_sib2-posid.
      ENDIF.
    ENDLOOP.

    ls_new_hier-wbs_left = lv_left.
    APPEND ls_new_hier TO lt_phris_hier_used.
  ENDIF.

ENDLOOP.
