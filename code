    DATA:ls_parameter TYPE ts_parameter,
         lv_success   TYPE flag,
         lt_aufk      TYPE STANDARD TABLE OF ts_aufk,
         lt_afih      TYPE STANDARD TABLE OF ts_afih,
         lt_afko      TYPE STANDARD TABLE OF ts_afko,
