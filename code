FORM prepare_screen2.
  IF sy-uname = 'HQ75177'.
    " Only initialize once - don't overwrite user changes on re-entry
    CHECK gv_header_initialized = abap_false.

    PERFORM get_additional_im_data USING p_posnr.

    CALL METHOD go_builder->copy_template_structure
      EXPORTING
        iv_pspid     = p_pspid
        iv_kostl     = p_kostl
      CHANGING
        ct_wbs_items = gt_wbs_items.
    PERFORM load_template_to_wbs_items USING p_pspid p_kostl.
    PERFORM convert_to_display.
    PERFORM set_wbs_default_values.
    PERFORM populate_header_structure.

    gv_header_initialized = abap_true.  " Mark as done
  ELSE.
    " Get additional IM data
    PERFORM get_additional_im_data USING p_posnr.

    " Copy template structure
    CALL METHOD go_builder->copy_template_structure
      EXPORTING
        iv_pspid     = p_pspid
        iv_kostl     = p_kostl
      CHANGING
        ct_wbs_items = gt_wbs_items.
    PERFORM load_template_to_wbs_items USING p_pspid p_kostl.
    " Convert to display format
    PERFORM convert_to_display.

    " Set default values
    PERFORM set_wbs_default_values.

    " Initialize header
    PERFORM populate_header_structure.
  ENDIF.

ENDFORM.

FORM load_template_to_wbs_items USING iv_pspid TYPE ps_pspid
                                       iv_kostl TYPE kostl.

  DATA: lt_pspnr_list TYPE STANDARD TABLE OF ps_pspnr,
        lv_level      TYPE i,
        lv_max_levels TYPE i VALUE 10.

  CLEAR gt_wbs_items[].

  " Get template pspnr
  SELECT SINGLE pspnr FROM projs
    INTO @DATA(lv_pspnr_templ)
    WHERE pspid = @iv_pspid.

  IF sy-subrc <> 0.
    SELECT SINGLE pspnr FROM proj
      INTO @lv_pspnr_templ
      WHERE pspid = @iv_pspid.
  ENDIF.

  CHECK sy-subrc = 0.

  " Get all wbs elements recursively (same logic as tree)
  SELECT imprf, pbukr, posid, post1, prart, pspnr, stufe
    FROM prpss
    INTO TABLE @DATA(lt_prpss_all)
    WHERE psphi = @lv_pspnr_templ
    ORDER BY stufe, posid.

  CHECK sy-subrc = 0.

  " Recursive fetch for children
  lv_level = 1.
  WHILE lv_level < lv_max_levels.


    LOOP AT lt_prpss_all ASSIGNING FIELD-SYMBOL(<fs_prpss>).
      APPEND <fs_prpss>-pspnr TO lt_pspnr_list.
    ENDLOOP.

    IF lt_pspnr_list IS INITIAL.
      EXIT.
    ENDIF.

    IF lt_pspnr_list IS NOT INITIAL.
      SELECT imprf, pbukr, posid, post1, prart, pspnr, stufe
        FROM prpss
        INTO TABLE @DATA(lt_prpss_level)
        FOR ALL ENTRIES IN @lt_pspnr_list
        WHERE psphi = @lt_pspnr_list-table_line.

      IF sy-subrc <> 0.
        EXIT.
      ENDIF.

      APPEND LINES OF lt_prpss_level TO lt_prpss_all.
      lv_level = lv_level + 1.
    ENDIF.
  ENDWHILE.

  SORT lt_prpss_all BY stufe posid.

  " Convert prpss to wbs items structure
  LOOP AT lt_prpss_all INTO DATA(ls_prpss).
    CLEAR gs_wbs_item.

    " ✓ FIXED: Use correct field mappings
    gs_wbs_item-stufe = ls_prpss-stufe.
    gs_wbs_item-posid = ls_prpss-posid.        " ← FIX: Use POSID not PSPNR!
    gs_wbs_item-post1 = ls_prpss-post1.
    gs_wbs_item-posnr = ls_prpss-pspnr.        " Internal number stored separately

    " ✓ FIXED: Inherit company code and plant from header
    gs_wbs_item-kostl = iv_kostl.
    gs_wbs_item-bukrs = gv_bukrs.              " ← FIX: Add company code
    gs_wbs_item-werks = gv_werks.              " ← FIX: Add plant
    gs_wbs_item-bukrs = ls_prpss-pbukr.    " PBUKR = Company Code in WBS

    " Template properties
    gs_wbs_item-imprf = ls_prpss-imprf.
    gs_wbs_item-prart = ls_prpss-prart.

    " Initialize budget fields
    gs_wbs_item-wert2 = 0.                     " Budget - user will fill
    gs_wbs_item-zbudget_check = space.

    APPEND gs_wbs_item TO gt_wbs_items.

  ENDLOOP.

ENDFORM.

FORM convert_to_display.

  DATA: lv_posid_external TYPE ps_posid.

  FREE gt_wbs_display.

  LOOP AT gt_wbs_items INTO gs_wbs_item.
    CLEAR: gs_wbs_display, lv_posid_external.

    " Map all fields
    gs_wbs_display-stufe = gs_wbs_item-stufe.
    gs_wbs_display-post1 = gs_wbs_item-post1.
    gs_wbs_display-kostl = gs_wbs_item-kostl.
    gs_wbs_display-posnr = gs_wbs_item-posnr.
    gs_wbs_display-zapproved_budg = gs_wbs_item-wert2.
    gs_wbs_display-zbudget_check = gs_wbs_item-zbudget_check.
    gs_wbs_display-bukrs = gs_wbs_item-bukrs.
    gs_wbs_display-imprf = gs_wbs_item-imprf.
    gs_wbs_display-prart = gs_wbs_item-prart.

    " Convert WBS POSID to external format
    IF gs_wbs_item-posid IS NOT INITIAL.
      PERFORM convert_wbs_posid_to_external
        USING    gs_wbs_item-posid
        CHANGING lv_posid_external.

      IF lv_posid_external IS NOT INITIAL.
        gs_wbs_display-posid = lv_posid_external.
      ELSE.
        gs_wbs_display-posid = gs_wbs_item-posid.
      ENDIF.
    ENDIF.

    "  CRITICAL FIX: Convert POSID to external format (PC.000001)
    IF gs_wbs_item-posid IS NOT INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_ABPSP_OUTPUT'
        EXPORTING
          input  = gs_wbs_item-posid
        IMPORTING
          output = lv_posid_external
        EXCEPTIONS
          OTHERS = 1.

      IF sy-subrc = 0 AND lv_posid_external IS NOT INITIAL.
        gs_wbs_display-posid = lv_posid_external.
      ELSE.
        " Fallback: use original value
        gs_wbs_display-posid = gs_wbs_item-posid.
      ENDIF.
    ENDIF.

    APPEND gs_wbs_display TO gt_wbs_display.
  ENDLOOP.

ENDFORM.

FORM set_wbs_default_values.

  LOOP AT gt_wbs_display INTO gs_wbs_display.


    " FDS Table 4.1.6: Cost Center inherited from header
    gs_wbs_display-kostl = p_kostl.

    " FDS Table 4.1.6: Budget Check activated by default if STUFE = 1
    IF gs_wbs_display-stufe = 1.
      gs_wbs_display-zbudget_check = gc_x.
      " Level 1 description comes from header
      gs_wbs_display-post1 = p_post1.
    ENDIF.

    MODIFY gt_wbs_display FROM gs_wbs_display.


  ENDLOOP.

ENDFORM.


FORM populate_header_structure.

  CLEAR gs_header.

  " FDS Table 4.1.7 - Field Mapping
  " Note: MANDT is handled automatically by SAP

  " Primary Key: ZREQ_NUM (will be generated during save)

  " IM Data (from Screen 1)
  gs_header-posnr = p_posnr.              " IM Program Position (IMPR-POSNR)
  gs_header-prnam = p_prnam.              " IM Program (IMPR-PRNAM)

  " Project Data (will be populated after project creation)
  " gs_header-pspnr = …                 " Project ID (PROJ-PSPNR) - set after creation

  " FDS Table 4.1.5: POST1 is Description, NOT PSPNR!
  gs_header-post1 = p_post1.              " Project Description (USER INPUT)

  " Responsible Person - convert with leading zeros

  gs_header-vernr = p_verna.           " Person Responsible (PROJ-VERNR)


  " Dates
  gs_header-plsez = p_plsez.              " Finish Date (PROJ-PLSEZ)
  gs_header-erdat = sy-datum.             " Request Created On (SYSTEM)

  " Organizational Data
  gs_header-bukrs = gv_bukrs.             " Company Code (IMPR-BUKRS)
  gs_header-werks = gv_werks.             " Plant (IMPR-WERKS)

  " Financial Data
  gs_header-prctr = p_prctr.              " Profit Center (IMPR-PRCTR)
  gs_header-kostl = p_kostl.              " Cost Center (IMPR-KOSTL)

  " Investment Data
  gs_header-izwek = gv_izwek.             " Investment Reason (IMPR-IZWEK)
  gs_header-profl = p_profl.              " Project Profile (ZTB_A2R_CONFTAB1)

  " Flags and Special Fields
  gs_header-zunifier_proj = p_usr10.      " GE Ariba WF Flag (IMPR-USR10)
  gs_header-usr008 = gv_usr008.           " CAR Approval Date (IMPR-USR008)

  " User and Type Information
*  PERFORM get_fullname_by_uname USING sy-uname CHANGING lv_fullname.
*  gs_header-zfullname = lv_fullname.
  gs_header-ernam = sy-uname.
  " Requestor (SYSTEM)
  gs_header-z_reqtype = gv_request_type.  " Request Type (from Screen 0)

  gs_header-z_remarks = gv_z_remarks.
  gs_header-erdat = sy-datum.
  " FDS Section 4.1.3: Status Handling
  " Status will be set during save/submit:
  " - 'DRAFT' when Save button is clicked
  " - 'PENDING' when Submit button is clicked
  " - 'APPROVED' when workflow approves
  " - 'REJECTED' when workflow rejects
  " gs_header-request_status = … (set in SAVE_REQUEST or SUBMIT_REQUEST)

  " Optional: Remarks field (if it exists in your table)
  IF gv_z_remarks IS NOT INITIAL.
    gs_header-z_remarks = gv_z_remarks.   " User remarks/notes
  ENDIF.

  " Fields that will be populated AFTER approval:
  " gs_header-zrequest_approved_on = …  " Request Approved On (set after approval)
  " gs_header-zapproved_by = …          " Approved By (set after approval)

  IF gv_im_posid_display IS INITIAL.
    PERFORM get_im_posid_for_display
      USING p_posnr
       CHANGING gv_im_posid_display.
  ENDIF.

ENDFORM.



