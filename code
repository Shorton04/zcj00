METHODS release_project_cj02
  IMPORTING
    iv_pspid TYPE proj-pspid.




METHOD release_project_cj02.
  "======================================================================
  " Release Project Definition via CJ02 (BDC)
  " Based on SHDB: ZCJ02_REL
  " 0100: =MDTB + *PROJ-PSPID
  " 0998: =STFR (Release)
  " 0998: =BU   (Save)
  "======================================================================

  DATA:
    lt_bdcdata TYPE TABLE OF bdcdata,
    lt_bdcmsg  TYPE STANDARD TABLE OF bdcmsgcoll,
    ls_bdcmsg  TYPE bdcmsgcoll,
    lv_pspid_c TYPE fnam_____4,
    lv_mode    TYPE c VALUE 'N',
    lv_update  TYPE c VALUE 'S'.

  " Convert to CHAR* for BDC field
  lv_pspid_c = iv_pspid.

  CLEAR lt_bdcdata.

  "------------------------------------------------------------
  " SAPLCJWB 0100
  "------------------------------------------------------------
  bdc_dynpro(
    EXPORTING
      iv_program = 'SAPLCJWB'
      iv_dynpro  = '0100'
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  bdc_field(
    EXPORTING
      iv_fnam = 'BDC_CURSOR'
      iv_fval = '*PROJ-PSPID'
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  bdc_field(
    EXPORTING
      iv_fnam = 'BDC_OKCODE'
      iv_fval = '=MDTB'
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  bdc_field(
    EXPORTING
      iv_fnam = '*PROJ-PSPID'
      iv_fval = CONV #( lv_pspid_c )
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  "------------------------------------------------------------
  " SAPLCJWB 0998 -> Release (=STFR)
  " Include subscreens as per SHDB (1205SUBSCR2 + 0700STATUS)
  "------------------------------------------------------------
  bdc_dynpro(
    EXPORTING
      iv_program = 'SAPLCJWB'
      iv_dynpro  = '0998'
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  bdc_field(
    EXPORTING
      iv_fnam = 'BDC_CURSOR'
      iv_fval = 'PROJ-PSPID'
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  bdc_field(
    EXPORTING
      iv_fnam = 'BDC_SUBSCR'
      iv_fval = 'SAPLCJWB                                1205SUBSCR2'
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  bdc_field(
    EXPORTING
      iv_fnam = 'BDC_SUBSCR'
      iv_fval = 'SAPLCJWB                                0700STATUS'
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  bdc_field(
    EXPORTING
      iv_fnam = 'BDC_OKCODE'
      iv_fval = '=STFR'
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  "------------------------------------------------------------
  " SAPLCJWB 0998 -> Save (=BU)
  "------------------------------------------------------------
  bdc_dynpro(
    EXPORTING
      iv_program = 'SAPLCJWB'
      iv_dynpro  = '0998'
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  bdc_field(
    EXPORTING
      iv_fnam = 'BDC_CURSOR'
      iv_fval = 'PROJ-PSPID'
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  bdc_field(
    EXPORTING
      iv_fnam = 'BDC_SUBSCR'
      iv_fval = 'SAPLCJWB                                1205SUBSCR2'
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  bdc_field(
    EXPORTING
      iv_fnam = 'BDC_SUBSCR'
      iv_fval = 'SAPLCJWB                                0700STATUS'
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  bdc_field(
    EXPORTING
      iv_fnam = 'BDC_OKCODE'
      iv_fval = '=BU'
    CHANGING
      ct_bdcdata = lt_bdcdata
  ).

  "------------------------------------------------------------
  " Execute CJ02
  "------------------------------------------------------------
  CLEAR lt_bdcmsg.

  CALL TRANSACTION 'CJ02'
    USING lt_bdcdata
    MODE  lv_mode
    UPDATE lv_update
    MESSAGES INTO lt_bdcmsg.

  "Return error if any A/E/X in messages
  LOOP AT lt_bdcmsg INTO ls_bdcmsg WHERE msgtyp CA 'AEX'.
    EXIT.
  ENDLOOP.

  IF sy-subrc = 0.
    MESSAGE e398(00) WITH 'CJ02 release failed for PSPID' iv_pspid.
  ELSE.
    COMMIT WORK AND WAIT.
    WAIT UP TO 2 SECONDS.
  ENDIF.

ENDMETHOD.