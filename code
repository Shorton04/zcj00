FORM load_tree_hierarchy.

  TYPES: BEGIN OF ty_prpss_tree,
           pspnr TYPE ps_pspnr,
           posid TYPE ps_posid,
           post1 TYPE post1,
           stufe TYPE prps-stufe,
         END OF ty_prpss_tree.

  TYPES: BEGIN OF ty_level_map,
           stufe    TYPE i,
           node_key TYPE lvc_nkey,
         END OF ty_level_map.

  DATA: lv_pspnr_templ TYPE ps_pspnr,
        ls_node        TYPE treev_node,
        ls_item        TYPE cnpb_h_treeitm,
        lv_last_key    TYPE lvc_nkey VALUE 0,
        lv_parent_key  TYPE lvc_nkey,
        lv_curr_index  TYPE sy-tabix,
        lv_next_stufe  TYPE i.

  DATA: lt_prpss_all   TYPE STANDARD TABLE OF ty_prpss_tree,
        ls_prpss       TYPE ty_prpss_tree,
        ls_next_prpss  TYPE ty_prpss_tree,
        lt_level_map   TYPE STANDARD TABLE OF ty_level_map,
        ls_level_map   TYPE ty_level_map.

  FIELD-SYMBOLS: <fs_level_map> TYPE ty_level_map.

  CHECK p_pspid IS NOT INITIAL.
  CHECK lo_tree_preview IS NOT INITIAL.

  TRY.

      CLEAR: gt_treev_node,
             gt_treeitm,
             lt_prpss_all,
             lt_level_map.

*--------------------------------------------------------------------*
* Get project template from PROJS
*--------------------------------------------------------------------*
      SELECT SINGLE pspid, post1, pspnr
        FROM projs
        INTO @DATA(ls_projs)
        WHERE pspid = @p_pspid.

      IF sy-subrc <> 0.
        DATA(lv_pspid_input) = p_pspid.

        CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
          EXPORTING
            input  = lv_pspid_input
          IMPORTING
            output = lv_pspid_input.

        SELECT SINGLE pspid, post1, pspnr
          FROM projs
          INTO @ls_projs
          WHERE pspid = @lv_pspid_input.

        IF sy-subrc <> 0.
          MESSAGE 'Template project not found in PROJS table'(m01) TYPE 'S' DISPLAY LIKE 'W'.
          RETURN.
        ENDIF.
      ENDIF.

      lv_pspnr_templ = ls_projs-pspnr.

*--------------------------------------------------------------------*
* Get all WBS elements of template project
* IMPORTANT:
* Sort by POSID so sequence stays hierarchical
*--------------------------------------------------------------------*
      SELECT pspnr, posid, post1, stufe
        FROM prps
        INTO TABLE @lt_prpss_all
        WHERE psphi = @lv_pspnr_templ
        ORDER BY posid.

      IF sy-subrc <> 0 OR lt_prpss_all IS INITIAL.
        MESSAGE 'No WBS elements found for template'(m02) TYPE 'S' DISPLAY LIKE 'W'.
        RETURN.
      ENDIF.

*--------------------------------------------------------------------*
* Root node (Project Definition)
*--------------------------------------------------------------------*
      lv_last_key = lv_last_key + 1.

      CLEAR ls_node.
      ls_node-node_key   = lv_last_key.
      ls_node-relatkey   = ''.
      ls_node-relatship  = cl_gui_column_tree=>relat_last_child.
      ls_node-hidden     = space.
      ls_node-disabled   = space.
      ls_node-isfolder   = abap_true.
      ls_node-expander   = abap_true.
      APPEND ls_node TO gt_treev_node.

      CLEAR ls_item.
      ls_item-node_key  = lv_last_key.
      ls_item-item_name = lc_hierarchy_short_text.
      ls_item-class     = cl_gui_column_tree=>item_class_text.
      CONCATENATE 'Template:' ls_projs-post1 INTO ls_item-text SEPARATED BY space.
      APPEND ls_item TO gt_treeitm.

      CLEAR ls_item.
      ls_item-node_key  = lv_last_key.
      ls_item-item_name = lc_hierarchy_technical_key.
      ls_item-class     = cl_gui_column_tree=>item_class_text.
      ls_item-text      = ls_projs-pspid.
      APPEND ls_item TO gt_treeitm.

      CLEAR ls_level_map.
      ls_level_map-stufe    = 0.
      ls_level_map-node_key = lv_last_key.
      APPEND ls_level_map TO lt_level_map.

*--------------------------------------------------------------------*
* Build tree in correct sequence
*--------------------------------------------------------------------*
      LOOP AT lt_prpss_all INTO ls_prpss.
        lv_curr_index = sy-tabix.

        CLEAR ls_next_prpss.
        CLEAR lv_next_stufe.

        READ TABLE lt_prpss_all INTO ls_next_prpss INDEX lv_curr_index + 1.
        IF sy-subrc = 0.
          lv_next_stufe = ls_next_prpss-stufe.
        ELSE.
          lv_next_stufe = 0.
        ENDIF.

*------------------------------------------------------------------*
* Determine parent node from previous level
*------------------------------------------------------------------*
        IF ls_prpss-stufe = 1.
          READ TABLE lt_level_map INTO ls_level_map WITH KEY stufe = 0.
        ELSE.
          READ TABLE lt_level_map INTO ls_level_map WITH KEY stufe = ls_prpss-stufe - 1.
        ENDIF.

        IF sy-subrc = 0.
          lv_parent_key = ls_level_map-node_key.
        ELSE.
          lv_parent_key = 1.
        ENDIF.

*------------------------------------------------------------------*
* Create node
* Parent becomes folder if next row is deeper
*------------------------------------------------------------------*
        lv_last_key = lv_last_key + 1.

        CLEAR ls_node.
        ls_node-node_key   = lv_last_key.
        ls_node-relatkey   = lv_parent_key.
        ls_node-relatship  = cl_gui_column_tree=>relat_last_child.
        ls_node-hidden     = space.
        ls_node-disabled   = space.

        IF lv_next_stufe > ls_prpss-stufe.
          ls_node-isfolder = abap_true.
          ls_node-expander = abap_true.
        ELSE.
          ls_node-isfolder = abap_false.
          ls_node-expander = space.
        ENDIF.

        APPEND ls_node TO gt_treev_node.

        CLEAR ls_item.
        ls_item-node_key  = lv_last_key.
        ls_item-item_name = lc_hierarchy_short_text.
        ls_item-class     = cl_gui_column_tree=>item_class_text.
        ls_item-text      = ls_prpss-post1.
        APPEND ls_item TO gt_treeitm.

        CLEAR ls_item.
        ls_item-node_key  = lv_last_key.
        ls_item-item_name = lc_hierarchy_technical_key.
        ls_item-class     = cl_gui_column_tree=>item_class_text.
        ls_item-text      = ls_prpss-posid.
        APPEND ls_item TO gt_treeitm.

*------------------------------------------------------------------*
* Save latest node key for this level
*------------------------------------------------------------------*
        READ TABLE lt_level_map ASSIGNING <fs_level_map>
          WITH KEY stufe = ls_prpss-stufe.
        IF sy-subrc = 0.
          <fs_level_map>-node_key = lv_last_key.
        ELSE.
          CLEAR ls_level_map.
          ls_level_map-stufe    = ls_prpss-stufe.
          ls_level_map-node_key = lv_last_key.
          APPEND ls_level_map TO lt_level_map.
        ENDIF.

*------------------------------------------------------------------*
* Remove deeper cached levels when hierarchy goes back up
*------------------------------------------------------------------*
        DELETE lt_level_map WHERE stufe > ls_prpss-stufe.

      ENDLOOP.

*--------------------------------------------------------------------*
* Display tree
*--------------------------------------------------------------------*
      CALL METHOD lo_tree_preview->delete_all_nodes.

      CALL METHOD lo_tree_preview->hierarchy_header_set_text
        EXPORTING
          text = 'Project Structure: Description'.

      CALL METHOD lo_tree_preview->add_nodes_and_items
        EXPORTING
          node_table                = gt_treev_node
          item_table                = gt_treeitm
          item_table_structure_name = 'CNPB_H_TREEITM'.

      CALL METHOD lo_tree_preview->expand_root_nodes
        EXPORTING
          level_count    = 0
          expand_subtree = abap_true.

      CALL METHOD lo_tree_preview->hierarchy_header_set_width
        EXPORTING
          width     = 50
          width_pix = space.

      CALL METHOD lo_tree_preview->column_set_width
        EXPORTING
          column_name = lc_hierarchy_technical_key
          width       = 25
          width_pix   = space.

      CALL METHOD cl_gui_cfw=>flush
        EXCEPTIONS
          cntl_system_error = 1
          cntl_error        = 2.

      IF sy-subrc = 0.
        lv_tree_loaded = abap_true.
      ENDIF.

    CATCH cx_root INTO DATA(lx_error).
      MESSAGE lx_error->get_text( ) TYPE 'S' DISPLAY LIKE 'E'.

  ENDTRY.

ENDFORM.