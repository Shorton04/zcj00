                              et_t001w     =  lt_t001w
                              et_jcds_rel  =  lt_jcds_rel
                              et_jcds_teco =  lt_jcds_teco ).

      build_data_pmo( EXPORTING  is_parameter = ls_parameter
                                 it_aufk      = lt_aufk
                                 it_afih      = lt_afih
                                 it_afko      = lt_afko
                                 it_afru      = lt_afru
                                 it_jcds      = lt_jcds
                                 it_mhio      = lt_mhio
                                 it_mhis      = lt_mhis
                                 it_jest      = lt_jest
                                 it_iloa      = lt_iloa
                                 it_tj02t     = lt_tj02t
                                 it_t001w     = lt_t001w
                                 it_jcds_rel  = lt_jcds_rel
                                 it_jcds_teco  = lt_jcds_teco
                      IMPORTING  et_result    = et_result ).
    ELSE.
      get_data_npmo( EXPORTING is_parameter  = ls_parameter
                     IMPORTING et_aufk       =  lt_aufk
                               et_afih       =  lt_afih
                               et_afko       =  lt_afko
                               et_afru       =  lt_afru
                               et_jcds       =  lt_jcds
                               et_iloa       =  lt_iloa
                               et_jest       =  lt_jest
                               et_tj02t      =  lt_tj02t
                               et_t001w      =  lt_t001w
                               et_jcds_rel   =  lt_jcds_rel
                               et_jcds_teco  =  lt_jcds_teco ).

      build_data_npmo( EXPORTING  is_parameter  = ls_parameter
                                  it_aufk       = lt_aufk
                                  it_afih       = lt_afih
                                  it_afko       = lt_afko
                                  it_afru       = lt_afru
                                  it_jcds       = lt_jcds
                                  it_jest       = lt_jest
                                  it_iloa       = lt_iloa
                                  it_tj02t      = lt_tj02t
                                  it_t001w      = lt_t001w
                                  it_jcds_rel   = lt_jcds_rel
                                  it_jcds_teco  = lt_jcds_teco
                       IMPORTING  et_result     = et_result ).

    ENDIF.

    IF gv_missing_auth = abap_true.
      MESSAGE 'Please note that Certain Records were not shown due to missing Authorizations'
             TYPE 'I'.
    ENDIF.

    sy-cprog =   zcl_a2r_mvi0123=>gv_program.
  ENDMETHOD.


