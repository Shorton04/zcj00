" Find UPPER level (parent)
CLEAR lv_upper_level.

IF ls_wbs-stufe = 1.
  " Level 1 has NO parent (wbs_up is blank)
  CLEAR ls_wbs_celement-wbs_up.

ELSE.
  " Level 2+ has parents - search BACKWARD using WHILE
  DATA(lv_back_index) = sy-tabix - 1.

  WHILE lv_back_index > 0.  " ← Use WHILE, not LOOP
    READ TABLE lt_wbs_sorted INTO ls_wbs_temp INDEX lv_back_index.
    IF sy-subrc <> 0.
      EXIT.
    ENDIF.

    " Found parent if STUFE is exactly one level less
    IF ls_wbs_temp-stufe = ls_wbs-stufe - 1.

      IF ls_wbs_temp-stufe = 1.
        " Parent is Level 1 (the project WBS element)
        lv_upper_level = lv_pspid.
        REPLACE ALL OCCURRENCES OF '.' IN lv_upper_level WITH ''.
      ELSE.
        " Parent is another WBS - rebuild its ID with new project
        lv_parent_new = ls_wbs_temp-posid.
        REPLACE lv_template_project IN lv_parent_new WITH lv_pspid.
        REPLACE ALL OCCURRENCES OF '.' IN lv_parent_new WITH ''.
        lv_upper_level = lv_parent_new.
      ENDIF.

      EXIT.  " Found parent, stop searching
    ENDIF.

    lv_back_index = lv_back_index - 1.
  ENDWHILE.  " ← Use ENDWHILE, not ENDLOOP

  ls_wbs_celement-wbs_up = lv_upper_level.
ENDIF.
