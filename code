METHOD check_before_save.

  DATA:
    lt_enq   TYPE TABLE OF seqg3,
    ls_enq   TYPE seqg3,
    lv_aufnr TYPE aufnr.

  lv_aufnr = is_buffer-aufnr.

  "========================================
  " CHECK IF ORDER IS LOCKED
  "========================================
  CALL FUNCTION 'ENQUEUE_READ'
    EXPORTING
      gclient = sy-mandt
      guname  = space
    TABLES
      enq     = lt_enq
    EXCEPTIONS
      communication_failure = 1
      system_failure        = 2
      OTHERS                = 3.

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  LOOP AT lt_enq INTO ls_enq
    WHERE garg CS lv_aufnr.

    " Ignore current user/session if needed
    IF ls_enq-guname <> sy-uname.

      MESSAGE e001(zpm)
        WITH |Order { lv_aufnr } is currently locked by user { ls_enq-guname }|.

    ENDIF.

  ENDLOOP.

ENDMETHOD.