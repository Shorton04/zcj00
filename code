DATA(lv_vkokr) = is_header-vkokr.

IF lv_vkokr IS INITIAL.
  "Take VKOKR from template-derived WBS items (from PRPSS-PKOKR)
  READ TABLE it_wbs_items INTO DATA(ls_any)
    WITH KEY stufe = 1.
  IF sy-subrc <> 0.
    READ TABLE it_wbs_items INTO ls_any INDEX 1.
  ENDIF.

  IF sy-subrc = 0 AND ls_any-vkokr IS NOT INITIAL.
    lv_vkokr = ls_any-vkokr.
  ENDIF.
ENDIF.