METHOD set_blkd_status_for_higher_wbs.

  DATA: ls_item          TYPE ztb_a2r_wbsitem,
        lv_pspnr         TYPE prps-pspnr,
        lv_parent_pspnr  TYPE prhi-psphi,
        lv_parent_posid  TYPE prps-posid.

  DATA: lt_user_status   TYPE TABLE OF bapi_wbs_mnt_user_status,
        lt_sys_status    TYPE TABLE OF bapi_wbs_mnt_system_status,
        lt_result        TYPE TABLE OF bapi_status_result.

  FIELD-SYMBOLS: <ls_us>    TYPE any,
                 <f_wbs>    TYPE any,
                 <f_stat>   TYPE any,
                 <f_set>    TYPE any,
                 <f_inact>  TYPE any.

  rv_success = abap_false.
  CLEAR: lt_user_status, lt_sys_status, lt_result.

  "Collect parent WBS to be set with BLKD
  LOOP AT it_wbs_items INTO ls_item.

    "Get PSPNR of current WBS
    CLEAR lv_pspnr.
    SELECT SINGLE pspnr
      INTO @lv_pspnr
      FROM prps
      WHERE posid = @ls_item-posid.

    IF sy-subrc <> 0 OR lv_pspnr IS INITIAL.
      CONTINUE.
    ENDIF.

    "Get parent PSPNR (higher level)
    CLEAR lv_parent_pspnr.
    SELECT SINGLE psphi
      INTO @lv_parent_pspnr
      FROM prhi
      WHERE pspnr = @lv_pspnr.

    IF sy-subrc <> 0 OR lv_parent_pspnr IS INITIAL.
      CONTINUE.
    ENDIF.

    "Get parent POSID
    CLEAR lv_parent_posid.
    SELECT SINGLE posid
      INTO @lv_parent_posid
      FROM prps
      WHERE pspnr = @lv_parent_pspnr.

    IF sy-subrc <> 0 OR lv_parent_posid IS INITIAL.
      CONTINUE.
    ENDIF.

    "Append one line to I_WBS_USER_STATUS
    APPEND INITIAL LINE TO lt_user_status ASSIGNING <ls_us>.
    IF <ls_us> IS NOT ASSIGNED.
      CONTINUE.
    ENDIF.

    "Fill WBS element field (usually WBS_ELEMENT)
    ASSIGN COMPONENT 'WBS_ELEMENT' OF STRUCTURE <ls_us> TO <f_wbs>.
    IF sy-subrc = 0 AND <f_wbs> IS ASSIGNED.
      <f_wbs> = lv_parent_posid.
    ENDIF.

    "Fill status code (some systems use USER_STATUS, some SET_USER_STATUS)
    ASSIGN COMPONENT 'USER_STATUS' OF STRUCTURE <ls_us> TO <f_stat>.
    IF sy-subrc = 0 AND <f_stat> IS ASSIGNED.
      <f_stat> = 'BLKD'.
    ELSE.
      ASSIGN COMPONENT 'SET_USER_STATUS' OF STRUCTURE <ls_us> TO <f_stat>.
      IF sy-subrc = 0 AND <f_stat> IS ASSIGNED.
        <f_stat> = 'BLKD'.
      ENDIF.
    ENDIF.

    "Tell BAPI to SET the status (field name differs by release)
    ASSIGN COMPONENT 'SET_STATUS' OF STRUCTURE <ls_us> TO <f_set>.
    IF sy-subrc = 0 AND <f_set> IS ASSIGNED.
      <f_set> = 'X'.
    ELSE.
      ASSIGN COMPONENT 'ACTIVATE' OF STRUCTURE <ls_us> TO <f_set>.
      IF sy-subrc = 0 AND <f_set> IS ASSIGNED.
        <f_set> = 'X'.
      ENDIF.
    ENDIF.

    "Ensure we are not deactivating (if a flag exists)
    ASSIGN COMPONENT 'INACT' OF STRUCTURE <ls_us> TO <f_inact>.
    IF sy-subrc = 0 AND <f_inact> IS ASSIGNED.
      CLEAR <f_inact>.
    ENDIF.

  ENDLOOP.

  "Remove duplicates so we set BLKD once per parent WBS
  SORT lt_user_status BY (1). "generic sort is ok; if you know key fields, specify them
  DELETE ADJACENT DUPLICATES FROM lt_user_status COMPARING ALL FIELDS.

  IF lt_user_status IS INITIAL.
    rv_success = abap_true.
    RETURN.
  ENDIF.

  "Call the exact BAPI shown in your screenshot
  CALL FUNCTION 'BAPI_BUS2054_SET_STATUS'
    TABLES
      em_status        = lt_sys_status
      i_wbs_user_status = lt_user_status
      e_result         = lt_result.

  "Check result table for errors
  READ TABLE lt_result TRANSPORTING NO FIELDS WITH KEY type = 'E'.
  IF sy-subrc = 0.
    rv_success = abap_false.
    RETURN.
  ENDIF.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  rv_success = abap_true.

ENDMETHOD.



METHOD assign_budget_cj30.

  DATA: lv_errors_found TYPE oax,
        lt_bpak         TYPE TABLE OF bpak,
        ls_bpak         TYPE bpak,
        ls_item         TYPE ztb_a2r_wbsitem,
        lv_objnr        TYPE j_objnr,
        lv_waers        TYPE waers,
        lt_return       TYPE TABLE OF bapiret2.

  rv_success = abap_false.
  CLEAR: lt_bpak, lt_return, lv_errors_found.

  lv_waers = get_currency_from_header( is_header ).
  IF lv_waers IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT it_wbs_items INTO ls_item.

    "If CJ30 should run only for flagged WBS, uncomment and use your real field
    "IF ls_item-zbudget_check IS INITIAL.
    "  CONTINUE.
    "ENDIF.

    IF ls_item-wert2 IS INITIAL.
      CONTINUE.
    ENDIF.

    SELECT SINGLE objnr
      FROM prps
      INTO @lv_objnr
      WHERE posid = @ls_item-posid.

    IF sy-subrc <> 0 OR lv_objnr IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_bpak.
    ls_bpak-e_objnr = lv_objnr.
    ls_bpak-e_versn = '000'.
    ls_bpak-e_perio = '001'.
    ls_bpak-e_wrttp = '41'.        "CJ30 Budget
    ls_bpak-wert    = ls_item-wert2.
    ls_bpak-twaer   = lv_waers.

    APPEND ls_bpak TO lt_bpak.

  ENDLOOP.

  IF lt_bpak IS INITIAL.
    "No budget lines, still OK
    rv_success = abap_true.
    RETURN.
  ENDIF.

  CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
    EXPORTING
      i_budget_activity = 'KBUD'   "CJ30
      i_delta_amounts   = 'X'
      i_rollup_data     = 'X'
      i_check_plan_data = 'X'
      i_application     = 'P'
      i_commit_all      = 'X'
    IMPORTING
      e_errors_found    = lv_errors_found
    TABLES
      it_bpak           = lt_bpak
      it_return         = lt_return
    EXCEPTIONS
      no_update         = 1
      OTHERS            = 2.

  IF sy-subrc <> 0 OR lv_errors_found IS NOT INITIAL.
    RETURN.
  ENDIF.

  READ TABLE lt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
  IF sy-subrc = 0.
    RETURN.
  ENDIF.

  "NEW: Call BLKD after CJ30 success
  IF set_blkd_status_for_higher_wbs( it_wbs_items = it_wbs_items ) = abap_false.
    rv_success = abap_false.
    RETURN.
  ENDIF.

  rv_success = abap_true.

ENDMETHOD.