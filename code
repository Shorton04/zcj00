METHOD append_car_template_structure_b1.

  DATA: lt_car_template TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
        ls_car_template TYPE ztb_a2r_wbsitem,
        ls_esr_root     TYPE ztb_a2r_wbsitem,
        ls_car_root     TYPE ztb_a2r_wbsitem,
        ls_new_item     TYPE ztb_a2r_wbsitem,
        lv_suffix       TYPE string,
        lv_new_posid    TYPE string,
        lv_root_len     TYPE i.

  CLEAR ct_wbs_car.

  "Get CAR template structure first
  CALL METHOD me->copy_template_structure
    EXPORTING
      iv_pspid     = iv_pspid_car
      iv_kostl     = iv_kostl
    CHANGING
      ct_wbs_items = lt_car_template.

  IF lt_car_template IS INITIAL.
    RETURN.
  ENDIF.

  "Existing ESR root from already loaded gt_wbs_items
  READ TABLE ct_wbs_items INTO ls_esr_root WITH KEY stufe = 1.
  IF sy-subrc <> 0 OR ls_esr_root-posid IS INITIAL.
    RETURN.
  ENDIF.

  "CAR template root
  READ TABLE lt_car_template INTO ls_car_root WITH KEY stufe = 1.
  IF sy-subrc <> 0 OR ls_car_root-posid IS INITIAL.
    RETURN.
  ENDIF.

  lv_root_len = strlen( ls_car_root-posid ).

  LOOP AT lt_car_template INTO ls_car_template.

    "Skip CAR root
    IF ls_car_template-stufe = 1.
      CONTINUE.
    ENDIF.

    CLEAR: ls_new_item, lv_suffix, lv_new_posid.

    ls_new_item = ls_car_template.

    "Replace CAR root with ESR root
    IF ls_car_template-posid IS NOT INITIAL
       AND strlen( ls_car_template-posid ) > lv_root_len
       AND ls_car_template-posid(lv_root_len) = ls_car_root-posid.

      lv_suffix = ls_car_template-posid+lv_root_len.

      IF lv_suffix IS NOT INITIAL AND lv_suffix(1) = '.'.
        SHIFT lv_suffix LEFT BY 1 PLACES.
      ENDIF.

      IF lv_suffix IS INITIAL.
        lv_new_posid = ls_esr_root-posid.
      ELSE.
        CONCATENATE ls_esr_root-posid lv_suffix
          INTO lv_new_posid.
      ENDIF.
    ELSE.
      lv_new_posid = ls_car_template-posid.
    ENDIF.

    "Store raw value without dots for creation
    REPLACE ALL OCCURRENCES OF '.' IN lv_new_posid WITH ''.

    ls_new_item-posid = lv_new_posid.
    ls_new_item-kostl = iv_kostl.

    "All structure shown on screen
    APPEND ls_new_item TO ct_wbs_items.

    "Only CAR rows for creation
    APPEND ls_new_item TO ct_wbs_car.

  ENDLOOP.

ENDMETHOD.