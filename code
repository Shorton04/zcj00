  "═══════════════════════════════════════════════════════════════════
  " STEP 10: CREATE SETTLEMENT RULES
  "═══════════════════════════════════════════════════════════════════
  DATA: lt_bdcdata TYPE TABLE OF bdcdata,
        lt_bdcmsg  TYPE TABLE OF bdcmsgcoll,
        lv_pspid_char TYPE char132,
        lv_period_char TYPE char132,
        lv_gjahr_char TYPE char132,
        lv_mode    TYPE c VALUE 'N',
        lv_update  TYPE c VALUE 'S'.

  " Get current period and fiscal year
  DATA(lv_period) = sy-datum+4(2).  " Current month (MM)
  DATA(lv_gjahr) = sy-datum+0(4).   " Current year (YYYY)

  " Convert to CHAR132
  lv_period_char = lv_period.
  lv_gjahr_char = lv_gjahr.

  " Get Level 1 WBS Element (Project Definition) from lt_wbs_celement
  READ TABLE lt_wbs_celement INTO ls_wbs_celement INDEX 1.

  IF sy-subrc = 0 AND ls_wbs_celement-wbs_element IS NOT INITIAL.

    " Convert to CHAR132
    lv_pspid_char = ls_wbs_celement-wbs_element.

    CLEAR lt_bdcdata.

    " BDC Screen 1: SAPLKAZB 1000
    bdc_dynpro(
      EXPORTING
        iv_program = 'SAPLKAZB'
        iv_dynpro  = '1000'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'BDC_CURSOR'
        iv_fval = 'RKAUF-LIST'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'BDC_OKCODE'
        iv_fval = '=RUN'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'RKAUF-LIST'
        iv_fval = 'X'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    " BDC Screen 2: SAPLKAOP 0570 (Settlement Rule Screen)
    bdc_dynpro(
      EXPORTING
        iv_program = 'SAPLKAOP'
        iv_dynpro  = '0570'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'LKP74-PSPID'
        iv_fval = lv_pspid_char
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    " BDC Screen 3: SAPLKAZB 2100 (Period and Year)
    bdc_dynpro(
      EXPORTING
        iv_program = 'SAPLKAZB'
        iv_dynpro  = '2100'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'RKAUF-FROM'
        iv_fval = lv_period_char
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'RKAUF-GJAHR'
        iv_fval = lv_gjahr_char
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'BDC_OKCODE'
        iv_fval = '=SICH'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    " Execute CJB2
    CLEAR lt_bdcmsg.

    CALL TRANSACTION 'CJB2'
      USING lt_bdcdata
      MODE lv_mode
      UPDATE lv_update
      MESSAGES INTO lt_bdcmsg.

  ENDIF.

  COMMIT WORK.
  MESSAGE s025(zcj00) WITH 'Project' lv_pspid 'created successfully'.

  rv_success = abap_true.

ENDMETHOD.
