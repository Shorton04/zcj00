METHOD assign_plan_values.

  DATA: lt_return        TYPE TABLE OF bapiret2,
        lv_errors_found  TYPE oax,
        lt_bpak          TYPE TABLE OF bpak,
        lt_bpak_cj40     TYPE TABLE OF bpak,
        lt_bpak_cj30     TYPE TABLE OF bpak,
        lt_bpak_cj32     TYPE TABLE OF bpak,
        ls_bpak          TYPE bpak,
        ls_item          TYPE ztb_a2r_wbsitem,
        lv_objnr         TYPE j_objnr.

  rv_success = abap_false.

  "Build BPAK from created WBS (OBJNR required)
  LOOP AT it_wbs_items INTO ls_item.
    "Skip empty amounts if needed
    IF ls_item-wert2 IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR lv_objnr.
    SELECT SINGLE objnr
      FROM prps
      INTO @lv_objnr
      WHERE posid = @ls_item-posid.

    IF sy-subrc <> 0 OR lv_objnr IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_bpak.
    ls_bpak-objnr = lv_objnr.

    "IMPORTANT:
    "Field name for the amount in BPAK differs by system customizing.
    "In many systems it is WLP00 (total), sometimes WERTN fields exist.
    "Keep it aligned with what your old system filled into lt_bpak.
    ls_bpak-wlp00 = ls_item-wert2.

    APPEND ls_bpak TO lt_bpak.
  ENDLOOP.

  IF lt_bpak IS INITIAL.
    RETURN.
  ENDIF.

  "Old system pattern: CJ30/CJ32 get lt_bpak as-is; CJ40 requires E_VERSN = '000'
  lt_bpak_cj30 = lt_bpak.
  lt_bpak_cj32 = lt_bpak.

  LOOP AT lt_bpak INTO ls_bpak.
    "MOVE-CORRESPONDING is what old code did; then set E_VERSN for CJ40
    DATA(ls_bpak_cj40) = CORRESPONDING bpak( ls_bpak ).
    ls_bpak_cj40-e_versn = '000'. "CJ40 version 000【turn11file0†Codes.txt†L5-L10】
    APPEND ls_bpak_cj40 TO lt_bpak_cj40.
  ENDLOOP.

  "------------------------------------------------------------
  "1) CJ40 (Budget in Planning Version) => KSTP
  "------------------------------------------------------------
  CLEAR: lt_return, lv_errors_found.
  CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
    EXPORTING
      i_budget_activity = 'KSTP'   "CJ40【turn11file0†Codes.txt†L12-L20】
      i_delta_amounts   = 'X'
      i_rollup_data     = 'X'
      i_check_plan_data = 'X'
      i_application     = 'P'
      i_commit_all      = 'X'
    IMPORTING
      e_errors_found    = lv_errors_found
    TABLES
      it_bpak           = lt_bpak_cj40
      it_return         = lt_return
    EXCEPTIONS
      no_update         = 1
      OTHERS            = 2.

  IF lt_return IS NOT INITIAL OR lv_errors_found IS NOT INITIAL OR sy-subrc <> 0.
    "Optionally raise / collect messages from lt_return
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "2) CJ30 (Budget) => KBUD
  "------------------------------------------------------------
  CLEAR: lt_return, lv_errors_found.
  CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
    EXPORTING
      i_budget_activity = 'KBUD'   "CJ30【turn11file0†Codes.txt†L36-L54】
      i_delta_amounts   = 'X'
      i_rollup_data     = 'X'
      i_check_plan_data = 'X'
      i_application     = 'P'
      i_commit_all      = 'X'
    IMPORTING
      e_errors_found    = lv_errors_found
    TABLES
      it_bpak           = lt_bpak_cj30
      it_return         = lt_return
    EXCEPTIONS
      no_update         = 1
      OTHERS            = 2.

  IF lt_return IS NOT INITIAL OR lv_errors_found IS NOT INITIAL OR sy-subrc <> 0.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "3) CJ32 (Budget release) => KBFR
  "------------------------------------------------------------
  CLEAR: lt_return, lv_errors_found.
  CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
    EXPORTING
      i_budget_activity = 'KBFR'   "CJ32【turn11file0†Codes.txt†L61-L79】
      i_delta_amounts   = 'X'
      i_rollup_data     = 'X'
      i_check_plan_data = 'X'
      i_application     = 'P'
      i_commit_all      = 'X'
    IMPORTING
      e_errors_found    = lv_errors_found
    TABLES
      it_bpak           = lt_bpak_cj32
      it_return         = lt_return
    EXCEPTIONS
      no_update         = 1
      OTHERS            = 2.

  IF lt_return IS NOT INITIAL OR lv_errors_found IS NOT INITIAL OR sy-subrc <> 0.
    RETURN.
  ENDIF.

  rv_success = abap_true.

ENDMETHOD.