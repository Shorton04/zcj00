fix this to 
1.	Read table CEPC where PRCTR and KOKRS value are equal to table IMPRProfit center in Header 
2.	Check the Validity Period (fields DATBI and DATAB).
3.	If DATBI ≥ today’s date (or ≥ 31.12 of the current year), the cost center is valid.
4.	WRITE: ‘Profit center is valid in current year', else WRITE: 'Profit center is not valid in current year'. 



FORM validate_profit_center USING iv_kokrs TYPE kokrs
                                  iv_prctr TYPE prctr
                                  iv_plsez TYPE ps_plsez_chg
                         CHANGING cv_error TYPE abap_bool.

  " Check profit center validity against Finish Date
  SELECT SINGLE @abap_true FROM cepc
    INTO @DATA(lv_found)
  WHERE prctr = @iv_prctr
    AND kokrs = @iv_kokrs
    AND datbi >= @iv_plsez.

  IF sy-subrc = 0.
    CLEAR cv_error.
  ELSE.
    MESSAGE e000(zmsg_a2r) WITH 'Profit center is not valid in current year'(m45) iv_plsez.
    cv_error = gc_x.
  ENDIF.
