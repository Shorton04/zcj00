MODULE user_command_0100 INPUT.
  DATA: lv_ok_code1 TYPE sy-ucomm.

  lv_ok_code1 = sy-ucomm.
  CLEAR sy-ucomm.

  " Sync ALL editable screen fields to gs_header on every PAI.
  " The gv_u_* flags are sticky - once set they prevent OUTPUT from reverting.
  IF p_post1 <> gs_header-post1.
    gs_header-post1 = p_post1.
    gv_u_post1 = abap_true.
  ELSEIF gv_u_post1 = abap_true.
    gs_header-post1 = p_post1.   " Keep user value sticky
  ENDIF.

  IF p_verna <> gs_header-vernr.
    gs_header-vernr = p_verna.
    gv_u_vernr = abap_true.
  ELSEIF gv_u_vernr = abap_true.
    gs_header-vernr = p_verna.
  ENDIF.

  IF p_plsez <> gs_header-plsez.
    gs_header-plsez = p_plsez.
    gv_u_plsez = abap_true.
  ELSEIF gv_u_plsez = abap_true.
    gs_header-plsez = p_plsez.
  ENDIF.

  IF p_posnr <> gs_header-posnr.
    gs_header-posnr = p_posnr.
    gv_u_posid = abap_true.
  ELSEIF gv_u_posid = abap_true.
    gs_header-posnr = p_posnr.
  ENDIF.

  IF p_prctr <> gs_header-prctr.
    gs_header-prctr = p_prctr.
    gv_u_prctr = abap_true.
  ELSEIF gv_u_prctr = abap_true.
    gs_header-prctr = p_prctr.
  ENDIF.

  IF p_kostl <> gs_header-kostl.
    gs_header-kostl = p_kostl.
    gv_u_kostl = abap_true.
  ELSEIF gv_u_kostl = abap_true.
    gs_header-kostl = p_kostl.
  ENDIF.


  CASE lv_ok_code1.
    WHEN 'ENTER' OR ''.

    WHEN 'SAVE'.
      PERFORM get_text.
      PERFORM save_request.

    WHEN 'SOP'.
      CLEAR gv_url.
      gv_url = TEXT-s04.
      PERFORM show_dms_link USING gv_url.

    WHEN 'CHECK'.
      PERFORM validate_screen2 USING abap_false.

    WHEN 'SUBMIT'.
      PERFORM get_text.
      PERFORM validate_screen2 USING abap_false.
*      PERFORM check_data.
      IF sy-uname = 'HQ75177' OR sy-uname = 'CL83960' OR sy-uname = 'KP05750'.
        IF gv_req_type = 'B3'.
          PERFORM submit_b3.
        ELSE.
          PERFORM submit_direct_creation_t.
        ENDIF.
      ELSE.
        PERFORM submit_direct_creation.
      ENDIF.

    WHEN 'UPLD'.
      PERFORM upload.

    WHEN 'DWNLD'.
      PERFORM download.

    WHEN 'TOTALUP'.
*      PERFORM total_up_budget.
      PERFORM total_up_wbs_tc.

    WHEN 'ADDROW'.
      PERFORM add_wbs_row.

    WHEN 'DELROW'.
      PERFORM delete_wbs_rows.

    WHEN 'ATTACH'.
      PERFORM handle_attachments.

    WHEN 'BACK'.
      CLEAR: gv_im_posid_display,
      gv_im_posid_user,
      gv_u_im_posid.
      gv_header_initialized = abap_false.
      LEAVE TO TRANSACTION 'ZA2R_ZCJ00'.

    WHEN 'EXIT' OR 'CANCEL'.
      CLEAR: gv_im_posid_display,
      gv_im_posid_user,
      gv_u_im_posid.
      LEAVE TO TRANSACTION 'ZA2R_ZCJ00'.

  ENDCASE.
ENDMODULE.
