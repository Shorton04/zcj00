METHOD append_car_template_structure_b1.

  DATA: lt_car_template   TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
        ls_car_template   TYPE ztb_a2r_wbsitem,
        ls_esr_root       TYPE ztb_a2r_wbsitem,
        ls_car_root       TYPE ztb_a2r_wbsitem,
        ls_new_item       TYPE ztb_a2r_wbsitem,
        lv_esr_root_posid TYPE prps-posid,
        lv_car_root_posid TYPE prps-posid,
        lv_car_item_posid TYPE prps-posid,
        lv_suffix         TYPE string,
        lv_root_len       TYPE i,
        lv_werks          TYPE ztb_a2r_wbsitem-werks.

  CLEAR ct_wbs_car.

  "Get CAR template structure first
  CALL METHOD me->copy_template_structure
    EXPORTING
      iv_pspid     = iv_pspid_car
      iv_kostl     = iv_kostl
    CHANGING
      ct_wbs_items = lt_car_template.

  IF lt_car_template IS INITIAL.
    RETURN.
  ENDIF.

  "Existing ESR root from already loaded structure
  READ TABLE ct_wbs_items INTO ls_esr_root WITH KEY stufe = 1.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  lv_werks = ls_esr_root-werks.

  "Get ESR root external POSID from PRPS using PSPNR
  SELECT SINGLE posid
    INTO @lv_esr_root_posid
    FROM prps
    WHERE pspnr = @ls_esr_root-posnr.

  IF sy-subrc <> 0 OR lv_esr_root_posid IS INITIAL.
    RETURN.
  ENDIF.

  "Get CAR root row
  READ TABLE lt_car_template INTO ls_car_root WITH KEY stufe = 1.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  "Get CAR root external POSID from PRPS using PSPNR
  SELECT SINGLE posid
    INTO @lv_car_root_posid
    FROM prps
    WHERE pspnr = @ls_car_root-posnr.

  IF sy-subrc <> 0 OR lv_car_root_posid IS INITIAL.
    RETURN.
  ENDIF.

  lv_root_len = strlen( lv_car_root_posid ).

  LOOP AT lt_car_template INTO ls_car_template.

    "Skip level 1 of CAR
    IF ls_car_template-stufe = 1.
      CONTINUE.
    ENDIF.

    CLEAR: ls_new_item, lv_car_item_posid, lv_suffix.

    ls_new_item = ls_car_template.

    "Get each CAR row external POSID from PRPS using PSPNR
    SELECT SINGLE posid
      INTO @lv_car_item_posid
      FROM prps
      WHERE pspnr = @ls_car_template-posnr.

    IF sy-subrc <> 0 OR lv_car_item_posid IS INITIAL.
      CONTINUE.
    ENDIF.

    "Take suffix after CAR root
    IF strlen( lv_car_item_posid ) > lv_root_len
       AND lv_car_item_posid(lv_root_len) = lv_car_root_posid.

      lv_suffix = lv_car_item_posid+lv_root_len.
      CONCATENATE lv_esr_root_posid lv_suffix INTO ls_new_item-posid.
    ELSE.
      ls_new_item-posid = lv_car_item_posid.
    ENDIF.

    ls_new_item-kostl = iv_kostl.
    ls_new_item-werks = lv_werks.

    APPEND ls_new_item TO ct_wbs_items.
    APPEND ls_new_item TO ct_wbs_car.

  ENDLOOP.

ENDMETHOD.