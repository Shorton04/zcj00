
FORM submit_direct_creation.

  DATA: lv_reqnum  TYPE char10,
        lv_success TYPE abap_bool.

  "═══════════════════════════════════════════════════════════════════
  " STEP 1: CONVERT DATA FROM DISPLAY FORMAT TO INTERNAL FORMAT
  "═══════════════════════════════════════════════════════════════════
  PERFORM sync_screen_to_header.
  PERFORM convert_from_display.
  PERFORM populate_header_structure.

  "═══════════════════════════════════════════════════════════════════
  " STEP 2: SAVE REQUEST (GET REQUEST NUMBER)
  " ✓ Using new method that doesn't interrupt flow
  "═══════════════════════════════════════════════════════════════════
  lv_reqnum = go_builder->save_request_for_submit(
    is_header    = gs_header
    it_wbs_items = gt_wbs_items
  ).

  IF lv_reqnum IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Failed to save request before submit'(m13).
    RETURN.
  ENDIF.

  " Store request number in header
  gs_header-zreq_num = lv_reqnum.

  "═══════════════════════════════════════════════════════════════════
  " STEP 3: UPDATE STATUS TO PENDING (Required for tracking)
  "═══════════════════════════════════════════════════════════════════
  UPDATE ztb_a2r_wbshdr
  SET request_status = 'PENDING'
  WHERE zreq_num = lv_reqnum.

  IF sy-subrc <> 0.
    MESSAGE e000(zmsg_a2r) WITH 'Failed to update status for'(m03) lv_reqnum.
*    ROLLBACK WORK.
    RETURN.
  ENDIF.

  " Commit the status change
  COMMIT WORK AND WAIT.

  " Update local header structure
  gs_header-request_status = 'PENDING'.

  "═══════════════════════════════════════════════════════════════════
  " STEP 4: CREATE PROJECT DIRECTLY (SKIP WORKFLOW)
  "═══════════════════════════════════════════════════════════════════
  MESSAGE i000(zmsg_a2r) WITH 'Creating project for request'(m04) lv_reqnum ##NO_TEXT.

  IF sy-uname = 'EV92123'.
    " ═══════════════════════════════════════════════════════════════════
    " STEP 3: GET APPROVERS FROM CONFIGURATION + HRP1001
    " ═══════════════════════════════════════════════════════════════════
    DATA:
      lv_appr1         TYPE char8,
      lv_appr2         TYPE char8,
      lv_auto          TYPE char1,
      lv_error_handler TYPE char8,
      lt_l1_approvers  TYPE hpa_t_bname,
      lt_l2_approvers  TYPE hpa_t_bname,
      lv_found         TYPE abap_bool.
*      lv_success       TYPE abap_bool.

    IF 1 = 0.
      lv_success = go_builder->create_project_cj20n(
        is_header = gs_header
      ).

      IF lv_success EQ abap_true.
        CALL FUNCTION 'ZFM_A2R_ZCJ00' IN UPDATE TASK
          EXPORTING
            iv_zreq_num = gs_header-zreq_num.

        UPDATE ztb_a2r_wbshdr
          SET request_status       = 'APPROVED'
              zapproved_by         = 'EV92123'
              zrequest_approved_on = sy-datum
        WHERE zreq_num             = gs_header-zreq_num.
      ENDIF.

    ELSE.

      lv_found = go_builder->check_approver_matrix(
        EXPORTING
          iv_bukrs         = gs_header-bukrs      " Company Code (e.g., 'ZX99')
          iv_profl         = gs_header-profl      " Project Profile (e.g., 'ZPC0001')
          iv_reqtype       = gs_header-z_reqtype  " Request Type (e.g., 'A1')
        IMPORTING
          ev_appr1         = lv_appr1             " Position ID L1 (e.g., '30000')
          ev_appr2         = lv_appr2             " Position ID L2
          ev_auto          = lv_auto              " 'X' if no approvers configured
          ev_error_handler = lv_error_handler
          et_l1_approvers  = lt_l1_approvers      " VARYF values (e.g., 'USHQ75177')
          et_l2_approvers  = lt_l2_approvers
      ).

      lv_found = go_builder->trigger_workflow(
        is_header   = gs_header
        iv_appr1    = lv_appr1          " Position ID for L1 (e.g., '30000')
        iv_appr2    = lv_appr2          " Position ID for L2
        it_l1_apprv = lt_l1_approvers   " VARYF values (e.g., 'USHQ75177')
        it_l2_apprv = lt_l2_approvers
      ).

    ENDIF.

    MESSAGE s000(zmsg_a2r) WITH 'Request'(m14) lv_reqnum 'submitted for approval'(m06).
  ELSE.
    IF sy-uname = 'HQ75177' OR sy-uname = 'KP05750'.
      lv_success = go_builder->create_wbs_elements(
        is_header    = gs_header
        it_wbs_items = gt_wbs_items
      ).
    ELSE.
      " Call the class method - it handles everything
      lv_success = go_builder->create_project_wbs(
        is_header    = gs_header
        it_wbs_items = gt_wbs_items
      ).
    ENDIF.


    IF lv_success = abap_true.
      "───────────────────────────────────────────────────────────────
      " PROJECT CREATED SUCCESSFULLY
      "───────────────────────────────────────────────────────────────
      " Update status to APPROVED (since no workflow)
      UPDATE ztb_a2r_wbshdr
        SET request_status       = 'APPROVED'
            zapproved_by         = sy-uname
            zrequest_approved_on = sy-datum
      WHERE zreq_num = lv_reqnum.
      IF sy-subrc = 0.
        COMMIT WORK.

        " Get project details for success message
        SELECT SINGLE pspnr FROM ztb_a2r_wbshdr
          INTO @DATA(lv_pspnr)
          WHERE zreq_num = @lv_reqnum.

        IF sy-subrc = 0 AND lv_pspnr IS NOT INITIAL.
          " Get external PSPID for display
          SELECT SINGLE pspid FROM proj
            INTO @DATA(lv_pspid)
            WHERE pspnr = @lv_pspnr.

          IF sy-subrc = 0.
            MESSAGE s000(zmsg_a2r) WITH lv_reqnum lv_pspid.
          ELSE.
            MESSAGE s000(zmsg_a2r) WITH 'Request'(m20) lv_reqnum 'approved'(m21).
          ENDIF.
        ELSE.
          MESSAGE s000(zmsg_a2r) WITH 'Request'(m20) lv_reqnum 'approved'(m21).
        ENDIF.

        " Return to main screen
        LEAVE TO SCREEN 0.

      ELSE.
        MESSAGE e000(zmsg_a2r) WITH 'Failed to update approval status'(m22).
*        ROLLBACK WORK.
      ENDIF.

    ELSE.
      "───────────────────────────────────────────────────────────────
      " PROJECT CREATION FAILED
      "───────────────────────────────────────────────────────────────

      " Mark as ERROR
      UPDATE ztb_a2r_wbshdr
      SET request_status = 'ERROR'
      WHERE zreq_num = lv_reqnum.
      IF sy-subrc EQ 0.
        COMMIT WORK.
        MESSAGE e000(zmsg_a2r) WITH 'Error creating project for request' lv_reqnum ##NO_TEXT.
        RETURN.
      ENDIF.
    ENDIF.
  ENDIF.
ENDFORM.


  METHOD save_request_for_submit.

    DATA: ls_header TYPE ztb_a2r_wbshdr,
          ls_item   TYPE ztb_a2r_wbsitem,
          ls_wbs    TYPE ztb_a2r_wbsitem,
          lv_error  TYPE abap_bool.
    DATA: lv_vkokr TYPE kokrs,
          lv_pspnr TYPE ps_spsnr.

    lv_vkokr = is_header-vkokr.

    IF lv_vkokr IS INITIAL.
      READ TABLE it_wbs_items INTO DATA(ls_any) INDEX 1.
      IF sy-subrc = 0 AND ls_any-posnr IS NOT INITIAL.
        lv_pspnr = ls_any-posnr.

        SELECT SINGLE pkokr
          INTO lv_vkokr
          FROM prpss
          WHERE pspnr = lv_pspnr.
      ENDIF.
    ENDIF.

    CLEAR: rv_reqnum, lv_error.

    "═══════════════════════════════════════════════════════════════════
    " STEP 1: GET REQUEST NUMBER
    "═══════════════════════════════════════════════════════════════════
    IF is_header-zreq_num IS INITIAL.
      rv_reqnum = get_next_request_number( ).
      IF rv_reqnum IS INITIAL.
        RETURN.
      ENDIF.
    ELSE.
      rv_reqnum = is_header-zreq_num.
    ENDIF.
    "═══════════════════════════════════════════════════════════════════
    " STEP 2: PREPARE HEADER
    "═══════════════════════════════════════════════════════════════════
    CLEAR ls_header.
    ls_header-mandt = sy-mandt.
    ls_header-zreq_num = rv_reqnum.
    ls_header-posnr = is_header-posnr.
    ls_header-prnam = is_header-prnam.
    ls_header-pspnr = is_header-pspnr.
    ls_header-post1 = is_header-post1.
    ls_header-vernr = is_header-vernr.
    ls_header-plsez = is_header-plsez.
    ls_header-bukrs = is_header-bukrs.
    ls_header-werks = is_header-werks.
    ls_header-waers = is_header-waers.
    ls_header-prctr = is_header-prctr.
    ls_header-kostl = is_header-kostl.

    ls_header-vkokr = lv_vkokr.
    ls_header-izwek = is_header-izwek.
    ls_header-zunifier_proj = is_header-zunifier_proj.
    ls_header-usr008 = is_header-usr008.
    ls_header-profl = is_header-profl.
    ls_header-z_reqtype = is_header-z_reqtype.


    IF is_header-zreq_num IS INITIAL.
      ls_header-ernam = sy-uname.
      ls_header-erdat = sy-datum.
      ls_header-request_status = 'DRAFT'.
    ELSE.
      ls_header-ernam = is_header-ernam.
      ls_header-erdat = is_header-erdat.
      " Preserve existing status if set
      IF is_header-request_status IS NOT INITIAL.
        ls_header-request_status = is_header-request_status.
      ELSE.
        ls_header-request_status = 'DRAFT'.
      ENDIF.
    ENDIF.

    IF is_header-z_remarks IS NOT INITIAL.
      ls_header-z_remarks = is_header-z_remarks.
    ENDIF.

    "═══════════════════════════════════════════════════════════════════
    " STEP 3: SAVE TO DATABASE
    "═══════════════════════════════════════════════════════════════════
    TRY.
        " Insert or update header
        IF is_header-zreq_num IS INITIAL.
          INSERT ztb_a2r_wbshdr FROM ls_header.
        ELSE.
          UPDATE ztb_a2r_wbshdr FROM ls_header.
          IF sy-subrc <> 0.
            INSERT ztb_a2r_wbshdr FROM ls_header.
          ENDIF.
        ENDIF.


        IF sy-subrc = 0.
          " Delete old items if updating
          IF is_header-zreq_num IS NOT INITIAL.
            DELETE FROM ztb_a2r_wbsitem WHERE zreq_num = rv_reqnum.
          ENDIF.

          " Insert WBS items
          LOOP AT it_wbs_items INTO ls_wbs WHERE wert2 > 0.
            CLEAR ls_item.
            ls_item-mandt = sy-mandt.
            ls_item-zreq_num = rv_reqnum.
            ls_item-bukrs = ls_header-bukrs.
            ls_item-vkokr = ls_wbs-vkokr.
            ls_item-vkokr = ls_header-vkokr.
            ls_item-posid = ls_wbs-posid.
            ls_item-stufe = ls_wbs-stufe.
            ls_item-post1 = ls_wbs-post1.
            ls_item-kostl = ls_wbs-kostl.
            ls_item-wert2 = ls_wbs-wert2.
            ls_item-vkokr = lv_vkokr.
            ls_item-zbudget_check = ls_wbs-zbudget_check.
            ls_item-imprf = ls_wbs-imprf.
            ls_item-prart = ls_wbs-prart.
            ls_item-werks = ls_header-werks.

            IF ls_wbs-posnr IS NOT INITIAL.
              ls_item-posnr = ls_wbs-posnr.
            ENDIF.

            INSERT ztb_a2r_wbsitem FROM ls_item.

            IF sy-subrc <> 0.
              lv_error = abap_true.
              EXIT.
            ENDIF.
          ENDLOOP.

          "═══════════════════════════════════════════════════════════
          " COMMIT OR ROLLBACK
          " ✓ NO MESSAGE
          " ✓ NO TRANSACTION CALL
          " ✓ Just return the request number so caller can continue
          "═══════════════════════════════════════════════════════════
          IF lv_error = abap_false.
            COMMIT WORK AND WAIT.
            " Success - just return the request number
          ELSE.
            ROLLBACK WORK.
            CLEAR rv_reqnum.
          ENDIF.

        ELSE.
          CLEAR rv_reqnum.
          ROLLBACK WORK.
        ENDIF.


      CATCH cx_root INTO DATA(lx_error).
        " Don't show message - just clear request number
        CLEAR rv_reqnum.
        ROLLBACK WORK.
    ENDTRY.

  ENDMETHOD.
