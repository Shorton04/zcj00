*&---------------------------------------------------------------------*
*& Form VALIDATE_APPROVER_MATRIX
*&---------------------------------------------------------------------*
FORM validate_approver_matrix
  CHANGING cv_error TYPE abap_bool.

  DATA: ls_conf TYPE ztb_a2r_conftab2.

  CLEAR cv_error.

  SELECT SINGLE *
    INTO @ls_conf
    FROM ztb_a2r_conftab2
   WHERE bukrs     = @gs_header-bukrs
     AND profl     = @gs_header-profl
     AND z_reqtype = @gs_header-z_reqtype.

  IF sy-subrc <> 0.
    MESSAGE e000(zmsg_a2r)
      WITH 'The combination of Company Code, Project Profile, and Request Type does not exist.'.
    cv_error = abap_true.
    RETURN.
  ENDIF.

ENDFORM.