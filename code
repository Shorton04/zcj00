METHOD create_car_wbs_b1.

  TYPES: BEGIN OF ty_prps_map,
           pspnr TYPE prps-pspnr,
           posid TYPE prps-posid,
         END OF ty_prps_map.

  DATA: lt_wbs_sorted    TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
        ls_wbs           TYPE ztb_a2r_wbsitem,
        ls_wbs_scan      TYPE ztb_a2r_wbsitem,
        ls_wbs_celement  TYPE bapi_bus2054_new,
        lt_wbs_celement  TYPE STANDARD TABLE OF bapi_bus2054_new,
        lt_return        TYPE STANDARD TABLE OF bapiret2,
        ls_return        TYPE bapiret2,
        lt_prps_map      TYPE HASHED TABLE OF ty_prps_map WITH UNIQUE KEY pspnr,
        lt_prps_sel      TYPE STANDARD TABLE OF ty_prps_map,
        ls_prps_map      TYPE ty_prps_map,
        lt_pspnr_key     TYPE SORTED TABLE OF prps-pspnr WITH UNIQUE KEY table_line,
        lv_project_def   TYPE proj-pspid,
        lv_new_posid     TYPE ps_posid,
        lv_up_posid      TYPE ps_posid,
        lv_left_posid    TYPE ps_posid,
        lv_scan_posid    TYPE ps_posid,
        lv_scan_parent   TYPE ps_posid,
        lv_idx           TYPE sy-tabix,
        lv_idx_back      TYPE sy-tabix.

  FIELD-SYMBOLS: <lv_pspnr> TYPE prps-pspnr.

  CLEAR: ev_error, et_return.
  CLEAR: lt_wbs_celement, lt_return.

  IF it_wbs_car IS INITIAL.
    RETURN.
  ENDIF.

  "Use full combined structure already prepared in PRHI order
  lt_wbs_sorted = it_wbs_all.

  "------------------------------------------------------------
  " Build PSPNR -> POSID map for existing rows
  "------------------------------------------------------------
  LOOP AT lt_wbs_sorted INTO ls_wbs WHERE posnr IS NOT INITIAL.
    INSERT ls_wbs-posnr INTO TABLE lt_pspnr_key.
  ENDLOOP.

  IF lt_pspnr_key IS NOT INITIAL.
    SELECT pspnr, posid
      FROM prps
      INTO TABLE @lt_prps_sel
      FOR ALL ENTRIES IN @lt_pspnr_key
      WHERE pspnr = @lt_pspnr_key-table_line.

    IF sy-subrc = 0.
      lt_prps_map = lt_prps_sel.
    ENDIF.
  ENDIF.

  "------------------------------------------------------------
  " Get existing ESR/project level 1 external POSID
  " This is used as BAPI project definition
  "------------------------------------------------------------
  READ TABLE lt_wbs_sorted INTO ls_wbs WITH KEY stufe = 1.
  IF sy-subrc <> 0.
    ev_error = abap_true.
    RETURN.
  ENDIF.

  CLEAR lv_project_def.
  IF ls_wbs-posnr IS NOT INITIAL.
    READ TABLE lt_prps_map INTO ls_prps_map WITH KEY pspnr = ls_wbs-posnr.
    IF sy-subrc = 0.
      lv_project_def = ls_prps_map-posid.
    ENDIF.
  ENDIF.

  IF lv_project_def IS INITIAL.
    lv_project_def = ls_wbs-posid.
  ENDIF.

  IF lv_project_def IS INITIAL.
    ev_error = abap_true.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " Build BAPI create table for CAR rows only
  "------------------------------------------------------------
  LOOP AT it_wbs_car INTO ls_wbs.

    CLEAR: ls_wbs_celement,
           lv_new_posid,
           lv_up_posid,
           lv_left_posid.

    lv_new_posid = ls_wbs-posid.

    IF lv_new_posid IS INITIAL.
      CONTINUE.
    ENDIF.

    "----------------------------------------------------------
    " Locate current CAR row inside full hierarchy
    "----------------------------------------------------------
    READ TABLE lt_wbs_sorted TRANSPORTING NO FIELDS
      WITH KEY posid = ls_wbs-posid.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    lv_idx = sy-tabix.

    "----------------------------------------------------------
    " Resolve WBS_UP
    " nearest previous row with lower STUFE
    "----------------------------------------------------------
    lv_idx_back = lv_idx - 1.
    WHILE lv_idx_back >= 1.

      READ TABLE lt_wbs_sorted INDEX lv_idx_back INTO ls_wbs_scan.
      IF sy-subrc = 0 AND ls_wbs_scan-stufe < ls_wbs-stufe.

        CLEAR lv_up_posid.

        IF ls_wbs_scan-posnr IS NOT INITIAL.
          READ TABLE lt_prps_map INTO ls_prps_map
            WITH KEY pspnr = ls_wbs_scan-posnr.
          IF sy-subrc = 0.
            lv_up_posid = ls_prps_map-posid.
          ENDIF.
        ENDIF.

        IF lv_up_posid IS INITIAL.
          lv_up_posid = ls_wbs_scan-posid.
        ENDIF.

        EXIT.
      ENDIF.

      lv_idx_back = lv_idx_back - 1.
    ENDWHILE.

    "----------------------------------------------------------
    " Resolve WBS_LEFT
    " nearest previous same-level row with same parent
    "----------------------------------------------------------
    lv_idx_back = lv_idx - 1.
    WHILE lv_idx_back >= 1.

      READ TABLE lt_wbs_sorted INDEX lv_idx_back INTO ls_wbs_scan.
      IF sy-subrc = 0 AND ls_wbs_scan-stufe = ls_wbs-stufe.

        CLEAR lv_scan_parent.

        DATA(lv_scan_back) = lv_idx_back - 1.
        WHILE lv_scan_back >= 1.

          READ TABLE lt_wbs_sorted INDEX lv_scan_back INTO DATA(ls_parent_scan).
          IF sy-subrc = 0 AND ls_parent_scan-stufe < ls_wbs_scan-stufe.

            IF ls_parent_scan-posnr IS NOT INITIAL.
              READ TABLE lt_prps_map INTO ls_prps_map
                WITH KEY pspnr = ls_parent_scan-posnr.
              IF sy-subrc = 0.
                lv_scan_parent = ls_prps_map-posid.
              ENDIF.
            ENDIF.

            IF lv_scan_parent IS INITIAL.
              lv_scan_parent = ls_parent_scan-posid.
            ENDIF.

            EXIT.
          ENDIF.

          lv_scan_back = lv_scan_back - 1.
        ENDWHILE.

        IF lv_scan_parent = lv_up_posid.

          CLEAR lv_scan_posid.

          IF ls_wbs_scan-posnr IS NOT INITIAL.
            READ TABLE lt_prps_map INTO ls_prps_map
              WITH KEY pspnr = ls_wbs_scan-posnr.
            IF sy-subrc = 0.
              lv_scan_posid = ls_prps_map-posid.
            ENDIF.
          ENDIF.

          IF lv_scan_posid IS INITIAL.
            lv_scan_posid = ls_wbs_scan-posid.
          ENDIF.

          lv_left_posid = lv_scan_posid.
          EXIT.
        ENDIF.

      ENDIF.

      lv_idx_back = lv_idx_back - 1.
    ENDWHILE.

    "----------------------------------------------------------
    " Mandatory BAPI fields
    "----------------------------------------------------------
    ls_wbs_celement-wbs_element = lv_new_posid.

    ls_wbs_celement-description      = ls_wbs-post1.
    ls_wbs_celement-company_code     = is_header-bukrs.
    ls_wbs_celement-profit_ctr       = is_header-prctr.
    ls_wbs_celement-controlling_area = is_header-vkokr.
    ls_wbs_celement-plant            = is_header-werks.

    ls_wbs_celement-wbs_planning_element           = abap_true.
    ls_wbs_celement-inv_reason                     = is_header-izwek.
    ls_wbs_celement-respsbl_cctr                   = ls_wbs-kostl.
    ls_wbs_celement-responsible_no                 = is_header-vernr.
    ls_wbs_celement-wbs_basic_start_date           = is_header-plfaz.
    ls_wbs_celement-wbs_basic_finish_date          = is_header-plsez.
    ls_wbs_celement-wbs_forecast_start_date        = is_header-plfaz.
    ls_wbs_celement-wbs_forecast_finish_date       = is_header-plsez.
    ls_wbs_celement-wbs_account_assignment_element = abap_true.

    ls_wbs_celement-wbs_up   = lv_up_posid.
    ls_wbs_celement-wbs_left = lv_left_posid.

    APPEND ls_wbs_celement TO lt_wbs_celement.

  ENDLOOP.

  IF lt_wbs_celement IS INITIAL.
    ev_error = abap_true.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " Create CAR WBS only
  "------------------------------------------------------------
  CALL FUNCTION 'BAPI_BUS2054_CREATE_MULTI'
    EXPORTING
      i_project_definition = lv_project_def
    TABLES
      it_wbs_element       = lt_wbs_celement
      et_return            = lt_return.

  LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'EA'.
    ev_error = abap_true.
    EXIT.
  ENDLOOP.

  IF ev_error = abap_true.
    et_return = lt_return.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " PRECOMMIT
  "------------------------------------------------------------
  CALL FUNCTION 'BAPI_PS_PRECOMMIT'
    TABLES
      et_return = lt_return.

  LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'EA'.
    ev_error = abap_true.
    EXIT.
  ENDLOOP.

  IF ev_error = abap_true.
    et_return = lt_return.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " COMMIT
  "------------------------------------------------------------
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait   = 'X'
    IMPORTING
      return = ls_return.

  IF ls_return-type CA 'EA'.
    ev_error = abap_true.
    APPEND ls_return TO lt_return.
  ENDIF.

  et_return = lt_return.

  WAIT UP TO 1 SECONDS.

ENDMETHOD.