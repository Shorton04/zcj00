FORM validate_and_load_b1 USING pv_reqnum TYPE ztb_a2r_wbshdr-zreq_num.

  DATA: ls_proj       TYPE proj,
        lv_objnr      TYPE jest-objnr,
        lv_stat_clsd  TYPE jest-stat VALUE 'I0046',
        lv_stat_teco  TYPE jest-stat VALUE 'I0045',
        lv_dummy      TYPE abap_bool,
        lv_proj_pspnr TYPE proj-pspnr,
        lv_lvl1_pspnr TYPE prps-pspnr,
        lv_posnr      TYPE impr-posnr,
        lv_prnam      TYPE impr-prnam,
        lv_gjahr      TYPE impr-gjahr.

  "------------------------------------------------------------
  " Mandatory inputs
  "------------------------------------------------------------
  IF p_pspid_proj IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Please enter valid project'.
  ENDIF.

  IF p_pspid_car IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Please enter valid CAR template'.
  ENDIF.

  "------------------------------------------------------------
  " Validate selected ESR project
  "------------------------------------------------------------
  SELECT SINGLE *
    FROM proj
    INTO @ls_proj
    WHERE pspid = @p_pspid_proj.

  IF sy-subrc <> 0.
    MESSAGE e000(zmsg_a2r) WITH 'Please enter valid project'.
  ENDIF.

  lv_proj_pspnr = ls_proj-pspnr.
  lv_objnr      = ls_proj-objnr.

  "------------------------------------------------------------
  " Validate project not CLSD
  "------------------------------------------------------------
  CLEAR lv_dummy.
  SELECT SINGLE @abap_true
    FROM jest
    INTO @lv_dummy
    WHERE objnr = @lv_objnr
      AND stat  = @lv_stat_clsd
      AND inact = @space.

  IF sy-subrc = 0.
    MESSAGE e000(zmsg_a2r) WITH
      'Project is already in Closed / Technically Completed status. Modification not allowed'.
  ENDIF.

  "------------------------------------------------------------
  " Validate project not TECO
  "------------------------------------------------------------
  CLEAR lv_dummy.
  SELECT SINGLE @abap_true
    FROM jest
    INTO @lv_dummy
    WHERE objnr = @lv_objnr
      AND stat  = @lv_stat_teco
      AND inact = @space.

  IF sy-subrc = 0.
    MESSAGE e000(zmsg_a2r) WITH
      'Project is already in Closed / Technically Completed status. Modification not allowed'.
  ENDIF.

  "------------------------------------------------------------
  " Validate CAR template exists
  "------------------------------------------------------------
  SELECT SINGLE pspnr
    FROM projs
    INTO @DATA(lv_car_pspnr)
    WHERE pspid = @p_pspid_car.

  IF sy-subrc <> 0 OR lv_car_pspnr IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Project Template does not exist'.
  ENDIF.

  "------------------------------------------------------------
  " Derive IM data from project level 1 WBS
  "------------------------------------------------------------
  SELECT SINGLE pspnr
    FROM prps
    INTO @lv_lvl1_pspnr
    WHERE psphi = @lv_proj_pspnr
      AND stufe = 1.

  IF sy-subrc = 0 AND lv_lvl1_pspnr IS NOT INITIAL.
    SELECT SINGLE posnr, prnam, gjahr
      FROM impr
      INTO (@lv_posnr, @lv_prnam, @lv_gjahr)
      WHERE pspnr = @lv_lvl1_pspnr.
  ENDIF.

  "------------------------------------------------------------
  " Reset buffers
  "------------------------------------------------------------
  CLEAR: gs_header.
  FREE:  gt_wbs_items, gt_wbs_display.

  "------------------------------------------------------------
  " Fill screen 2 header from selected project
  "------------------------------------------------------------
  gs_header-pspnr      = ls_proj-pspnr.
  gs_header-post1      = ls_proj-post1.
  gs_header-vernr      = ls_proj-vernr.
  gs_header-plsez      = ls_proj-plsez.
  gs_header-bukrs      = ls_proj-vbukr.
  gs_header-werks      = ls_proj-werks.
  gs_header-prctr      = ls_proj-prctr.
  gs_header-kostl      = ls_proj-kostl.
  gs_header-posnr      = lv_posnr.
  gs_header-prnam      = lv_prnam.
  gs_header-z_reqtype  = 'B1'.
  gs_header-request_status = 'DRAFT'.

  "------------------------------------------------------------
  " Helper variables used by existing routines
  "------------------------------------------------------------
  p_posnr = gs_header-posnr.
  p_prnam = gs_header-prnam.
  p_verna = gs_header-vernr.
  p_kostl = gs_header-kostl.
  p_post1 = gs_header-post1.
  p_prctr = gs_header-prctr.
  p_plsez = gs_header-plsez.
  p_profl = gs_header-profl.

  gv_gjahr              = lv_gjahr.
  gv_edit_mode          = abap_false.
  gv_loaded_reqnum      = pv_reqnum.
  gv_header_initialized = abap_false.
  gv_request_type       = 'B1'.

ENDFORM.




FORM prepare_screen2.

  "Always get IM data
  PERFORM get_additional_im_data USING p_posnr.

  "Initialize screen2 only once
  IF gv_header_initialized = abap_true.
    RETURN.
  ENDIF.

  "============================================================
  " EDIT MODE (F1 / loaded request)
  "============================================================
  IF gv_edit_mode = abap_true.

    PERFORM convert_to_display.
    PERFORM set_wbs_default_values.

    gv_header_initialized = abap_true.
    RETURN.

  ENDIF.

  "============================================================
  " B1 MODE
  "============================================================
  IF gv_request_type = 'B1'.

    PERFORM load_b1_project_and_car_wbs.

    PERFORM convert_to_display.
    PERFORM set_wbs_default_values.

    gv_header_initialized = abap_true.
    RETURN.

  ENDIF.

  "============================================================
  " CREATE MODE (A1)
  "============================================================
  CLEAR gt_wbs_items.

  CALL METHOD go_builder->copy_template_structure
    EXPORTING
      iv_pspid     = p_pspid
      iv_kostl     = p_kostl
    CHANGING
      ct_wbs_items = gt_wbs_items.

  PERFORM convert_to_display.
  PERFORM set_wbs_default_values.
  PERFORM populate_header_structure.

  gv_header_initialized = abap_true.

ENDFORM.




FORM load_b1_project_and_car_wbs.

  DATA: lt_existing_wbs TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
        lt_car_wbs      TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
        ls_wbs          TYPE ztb_a2r_wbsitem,
        lv_proj_pspnr   TYPE proj-pspnr.

  FIELD-SYMBOLS: <fs_car> TYPE ztb_a2r_wbsitem.

  CLEAR gt_wbs_items.

  "------------------------------------------------------------
  " 1) Get selected ESR project internal number
  "------------------------------------------------------------
  SELECT SINGLE pspnr
    FROM proj
    INTO @lv_proj_pspnr
    WHERE pspid = @p_pspid_proj.

  IF sy-subrc <> 0 OR lv_proj_pspnr IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Please enter valid project'.
  ENDIF.

  "------------------------------------------------------------
  " 2) Load ALL existing ESR project WBS
  "------------------------------------------------------------
  PERFORM get_existing_project_wbs
    USING    lv_proj_pspnr
    CHANGING lt_existing_wbs.

  APPEND LINES OF lt_existing_wbs TO gt_wbs_items.

  "------------------------------------------------------------
  " 3) Load CAR template WBS
  "------------------------------------------------------------
  CALL METHOD go_builder->copy_template_structure
    EXPORTING
      iv_pspid     = p_pspid_car
      iv_kostl     = gs_header-kostl
    CHANGING
      ct_wbs_items = lt_car_wbs.

  "------------------------------------------------------------
  " 4) Append CAR WBS except level 1 only
  "------------------------------------------------------------
  LOOP AT lt_car_wbs ASSIGNING <fs_car>.
    CHECK <fs_car>-stufe > 1.

    CLEAR ls_wbs.
    MOVE-CORRESPONDING <fs_car> TO ls_wbs.

    PERFORM replace_template_posid_with_project
      USING    p_pspid_car
               p_pspid_proj
               <fs_car>-posid
      CHANGING ls_wbs-posid.

    ls_wbs-bukrs = gs_header-bukrs.
    ls_wbs-kostl = gs_header-kostl.

    IF gs_header-vkokr IS NOT INITIAL.
      ls_wbs-vkokr = gs_header-vkokr.
    ENDIF.

    APPEND ls_wbs TO gt_wbs_items.
  ENDLOOP.

ENDFORM.



FORM get_existing_project_wbs
  USING    pv_proj_pspnr TYPE proj-pspnr
  CHANGING ct_wbs_items  TYPE STANDARD TABLE OF ztb_a2r_wbsitem.

  TYPES: BEGIN OF ty_prps,
           pspnr TYPE prps-pspnr,
           psphi TYPE prps-psphi,
           stufe TYPE prps-stufe,
           posid TYPE prps-posid,
           post1 TYPE prps-post1,
           pkokr TYPE prps-pkokr,
           prart TYPE prps-prart,
           pbukr TYPE prps-pbukr,
           kostl TYPE prps-kostl,
           imprf TYPE prps-imprf,
         END OF ty_prps.

  DATA: lt_prps TYPE STANDARD TABLE OF ty_prps,
        ls_prps TYPE ty_prps,
        ls_wbs  TYPE ztb_a2r_wbsitem.

  CLEAR ct_wbs_items.

  SELECT pspnr,
         psphi,
         stufe,
         posid,
         post1,
         pkokr,
         prart,
         pbukr,
         kostl,
         imprf
    FROM prps
    INTO TABLE @lt_prps
    WHERE psphi = @pv_proj_pspnr
    ORDER BY posid.

  LOOP AT lt_prps INTO ls_prps.
    CLEAR ls_wbs.
    ls_wbs-posnr = ls_prps-pspnr.
    ls_wbs-stufe = ls_prps-stufe.
    ls_wbs-posid = ls_prps-posid.
    ls_wbs-post1 = ls_prps-post1.
    ls_wbs-vkokr = ls_prps-pkokr.
    ls_wbs-prart = ls_prps-prart.
    ls_wbs-bukrs = ls_prps-pbukr.
    ls_wbs-kostl = ls_prps-kostl.
    ls_wbs-imprf = ls_prps-imprf.

    APPEND ls_wbs TO ct_wbs_items.
  ENDLOOP.

ENDFORM.



FORM replace_template_posid_with_project
  USING    pv_car_pspid   TYPE projs-pspid
           pv_proj_pspid  TYPE proj-pspid
           pv_old_posid   TYPE prps-posid
  CHANGING pv_new_posid   TYPE prps-posid.

  DATA: lv_old  TYPE string,
        lv_car  TYPE string,
        lv_proj TYPE string.

  lv_old  = pv_old_posid.
  lv_car  = pv_car_pspid.
  lv_proj = pv_proj_pspid.

  pv_new_posid = pv_old_posid.

  IF lv_old CS lv_car.
    REPLACE FIRST OCCURRENCE OF lv_car IN lv_old WITH lv_proj.
    pv_new_posid = lv_old.
  ENDIF.

ENDFORM.


