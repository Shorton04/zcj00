REPORT ztest_operation_status.

*---------------------------------------------------------------------*
* Input
*---------------------------------------------------------------------*
PARAMETERS:
  p_aufnr TYPE aufnr OBLIGATORY,   "Maintenance Order
  p_vornr TYPE vornr OBLIGATORY,   "Operation Number (example 0010)
  p_vrgng TYPE tj01-vrgng OBLIGATORY. "Business transaction / status activity

*---------------------------------------------------------------------*
* Example:
* p_vrgng =
* DSPT   -> Dispatch
* REXE   -> Ready for Execution
* RFRA   -> Ready for Release
* (depends on your system config)
*---------------------------------------------------------------------*

*---------------------------------------------------------------------*
* Data
*---------------------------------------------------------------------*
DATA:
  lv_aufpl       TYPE afko-aufpl,
  lv_objnr       TYPE jest-objnr,

  "Dummy save BAPI
  lt_methods     TYPE STANDARD TABLE OF bapi_alm_order_method,
  lt_header      TYPE STANDARD TABLE OF bapi_alm_order_headers_i,
  lt_header_up   TYPE STANDARD TABLE OF bapi_alm_order_headers_up,
  lt_return      TYPE STANDARD TABLE OF bapiret2,

  ls_return      TYPE bapiret2.

************************************************************************
* STEP 1
* Get operation OBJNR from AFVC
************************************************************************

SELECT SINGLE k~aufpl
  INTO @lv_aufpl
  FROM afko AS k
 WHERE k~aufnr = @p_aufnr.

IF sy-subrc <> 0.
  WRITE: / 'Order not found:', p_aufnr.
  EXIT.
ENDIF.

SELECT SINGLE objnr
  INTO @lv_objnr
  FROM afvc
 WHERE aufpl = @lv_aufpl
   AND vornr = @p_vornr.

IF sy-subrc <> 0.
  WRITE: / 'Operation not found:', p_vornr.
  EXIT.
ENDIF.

WRITE: / 'OBJNR Found:', lv_objnr.

************************************************************************
* STEP 2
* Update OPERATION STATUS
* (Correct FM for activity / operation)
************************************************************************

CALL FUNCTION 'STATUS_CHANGE_FOR_ACTIVITY'
  EXPORTING
    objnr                = lv_objnr
    vrgng                = p_vrgng
    set_chgkz            = abap_true
    no_authority_check   = abap_true
    check_only           = space
  EXCEPTIONS
    object_not_found     = 1
    status_inconsistent  = 2
    status_not_allowed   = 3
    OTHERS               = 4.

IF sy-subrc <> 0.
  WRITE: / 'STATUS_CHANGE_FOR_ACTIVITY failed. SY-SUBRC =', sy-subrc.
  EXIT.
ENDIF.

COMMIT WORK AND WAIT.

WRITE: / 'STEP 1 SUCCESS - Operation status updated'.

************************************************************************
* STEP 3
* Dummy SAVE to force AFVC Phase/Subphase refresh
************************************************************************

CLEAR: lt_methods, lt_header, lt_header_up, lt_return.

*---------------------------------------------------------------------*
* METHOD : HEADER CHANGE
*---------------------------------------------------------------------*
APPEND VALUE #(
  refnumber = '000001'
  objecttype = 'HEADER'
  method = 'CHANGE'
  objectkey = p_aufnr
) TO lt_methods.

*---------------------------------------------------------------------*
* METHOD : SAVE
*---------------------------------------------------------------------*
APPEND VALUE #(
  refnumber = '000001'
  method = 'SAVE'
) TO lt_methods.

*---------------------------------------------------------------------*
* HEADER
* Small harmless change to trigger derivation engine
*---------------------------------------------------------------------*
APPEND VALUE #(
  orderid    = p_aufnr
  short_text = 'REFRESH'
) TO lt_header.

*---------------------------------------------------------------------*
* HEADER_UP
*---------------------------------------------------------------------*
APPEND VALUE #(
  orderid    = p_aufnr
  short_text = 'X'
) TO lt_header_up.

*---------------------------------------------------------------------*
* Execute Dummy Save
*---------------------------------------------------------------------*
CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
  TABLES
    it_methods   = lt_methods
    it_header    = lt_header
    it_header_up = lt_header_up
    return       = lt_return.

READ TABLE lt_return INTO ls_return
  WITH KEY type = 'E'.

IF sy-subrc = 0.

  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.

  WRITE: / 'ERROR IN DUMMY SAVE:'.

  LOOP AT lt_return INTO ls_return.
    WRITE: / ls_return-type, ls_return-message.
  ENDLOOP.

ELSE.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  WRITE: / 'STEP 2 SUCCESS - AFVC refresh triggered'.
  WRITE: / 'Order     :', p_aufnr.
  WRITE: / 'Operation :', p_vornr.
  WRITE: / 'VRGNG     :', p_vrgng.
  WRITE: / 'Check AFVC phase/subphase now.'.

ENDIF.