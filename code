FORM populate_gt_wbs_car_wert2.

  TYPES: BEGIN OF ty_item_map,
           posid TYPE ps_posid,
           wert2 TYPE ztb_a2r_wbsitem-wert2,
           zbudget_check TYPE ztb_a2r_wbsitem-zbudget_check,
           post1 TYPE ztb_a2r_wbsitem-post1,
           kostl TYPE ztb_a2r_wbsitem-kostl,
           imprf TYPE ztb_a2r_wbsitem-imprf,
           prart TYPE ztb_a2r_wbsitem-prart,
           bukrs TYPE ztb_a2r_wbsitem-bukrs,
           werks TYPE ztb_a2r_wbsitem-werks,
           vkokr TYPE ztb_a2r_wbsitem-vkokr,
         END OF ty_item_map.

  DATA: lt_item_map TYPE HASHED TABLE OF ty_item_map WITH UNIQUE KEY posid,
        ls_item_map TYPE ty_item_map,
        ls_item     TYPE ztb_a2r_wbsitem,
        lv_posid    TYPE ps_posid.

  FIELD-SYMBOLS: <fs_car> TYPE ztb_a2r_wbsitem,
                 <fs_map> TYPE ty_item_map.

  CLEAR lt_item_map.

  LOOP AT gt_wbs_items INTO ls_item.
    CLEAR: ls_item_map, lv_posid.

    lv_posid = ls_item-posid.
    REPLACE ALL OCCURRENCES OF '.' IN lv_posid WITH ''.

    ls_item_map-posid         = lv_posid.
    ls_item_map-wert2         = ls_item-wert2.
    ls_item_map-zbudget_check = ls_item-zbudget_check.
    ls_item_map-post1         = ls_item-post1.
    ls_item_map-kostl         = ls_item-kostl.
    ls_item_map-imprf         = ls_item-imprf.
    ls_item_map-prart         = ls_item-prart.
    ls_item_map-bukrs         = ls_item-bukrs.
    ls_item_map-werks         = ls_item-werks.
    ls_item_map-vkokr         = ls_item-vkokr.

    INSERT ls_item_map INTO TABLE lt_item_map.
  ENDLOOP.

  LOOP AT gt_wbs_car ASSIGNING <fs_car>.
    READ TABLE lt_item_map ASSIGNING <fs_map>
      WITH TABLE KEY posid = <fs_car>-posid.
    IF sy-subrc = 0.
      <fs_car>-wert2         = <fs_map>-wert2.
      <fs_car>-zbudget_check = <fs_map>-zbudget_check.
      <fs_car>-post1         = <fs_map>-post1.
      <fs_car>-kostl         = <fs_map>-kostl.
      <fs_car>-imprf         = <fs_map>-imprf.
      <fs_car>-prart         = <fs_map>-prart.
      <fs_car>-bukrs         = <fs_map>-bukrs.
      <fs_car>-werks         = <fs_map>-werks.
      <fs_car>-vkokr         = <fs_map>-vkokr.
    ENDIF.
  ENDLOOP.

ENDFORM.