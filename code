FORM convert_from_display.

  DATA: lv_posid_internal TYPE ps_posid,
        lv_vkokr          TYPE ztb_a2r_wbsitem-vkokr.


  FREE gt_wbs_items.

  LOOP AT gt_wbs_display INTO gs_wbs_display.
    CLEAR: gs_wbs_item, lv_posid_internal.

    " Map from display table to internal table
    gs_wbs_item-stufe = gs_wbs_display-stufe.
    gs_wbs_item-post1 = gs_wbs_display-post1.
    gs_wbs_item-kostl = gs_wbs_display-kostl.
    gs_wbs_item-wert2 = gs_wbs_display-zapproved_budg.
    gs_wbs_item-zbudget_check = gs_wbs_display-zbudget_check.
    gs_wbs_item-bukrs = gs_wbs_display-bukrs.
    gs_wbs_item-vkokr = gv_vkokr.
    gs_wbs_item-posnr = gs_wbs_display-posnr.
    gs_wbs_item-imprf = gs_wbs_display-imprf.
    gs_wbs_item-prart = gs_wbs_display-prart.

    " Convert POSID from external back to internal
    IF gs_wbs_display-posid IS NOT INITIAL.
      PERFORM convert_wbs_posid_to_internal
        USING    gs_wbs_display-posid
        CHANGING lv_posid_internal.

      IF lv_posid_internal IS NOT INITIAL.
        gs_wbs_item-posid = lv_posid_internal.
      ELSE.
        gs_wbs_item-posid = gs_wbs_display-posid.
      ENDIF.
    ENDIF.

    "  CRITICAL FIX: Convert POSID from external (PC.000001) back to internal (PC000001)
    IF gs_wbs_display-posid IS NOT INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_ABPSP_INPUT'
        EXPORTING
          input  = gs_wbs_display-posid
        IMPORTING
          output = lv_posid_internal
        EXCEPTIONS
          OTHERS = 1.

      IF sy-subrc = 0 AND lv_posid_internal IS NOT INITIAL.
        gs_wbs_item-posid = lv_posid_internal.
      ELSE.
        gs_wbs_item-posid = gs_wbs_display-posid.
      ENDIF.
    ENDIF.

    APPEND gs_wbs_item TO gt_wbs_items.

  ENDLOOP.
ENDFORM.
