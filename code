  METHOD assign_plan_values.

    DATA: lv_errors_found TYPE oax,
          lt_bpak         TYPE TABLE OF bpak,
          ls_bpak         TYPE bpak,
          ls_item         TYPE ztb_a2r_wbsitem,
          lv_objnr        TYPE j_objnr,
          lv_rollup       TYPE c,
          lv_delta        TYPE c,
          lt_return       TYPE TABLE OF bapiret2.
    DATA: lv_waers        TYPE waers.

    ">>> NEW: max stufe
    DATA: lv_max_stufe    TYPE ztb_a2r_wbsitem-stufe.

    rv_success = abap_false.
    CLEAR: lt_bpak, lt_return, lv_errors_found.

    lv_rollup = 'X'.
    lv_delta  = 'X'.

    "1) Primary: read from header table
    SELECT SINGLE waers
      INTO @lv_waers
      FROM ztb_a2r_wbshdr
      WHERE zreq_num = @is_header-zreq_num.

    "2) Fallback: from is_header if already passed in
    IF lv_waers IS INITIAL.
      lv_waers = is_header-waers.
    ENDIF.

    "3) Fallback: derive from company code (T001) if still initial
    IF lv_waers IS INITIAL AND is_header-bukrs IS NOT INITIAL.
      SELECT SINGLE waers
        INTO @lv_waers
        FROM t001
        WHERE bukrs = @is_header-bukrs.
    ENDIF.

    ">>> NEW: get highest level (max STUFE) from the passed WBS items
    lv_max_stufe = 0.
    LOOP AT it_wbs_items INTO ls_item WHERE stufe IS NOT INITIAL.
      IF ls_item-stufe > lv_max_stufe.
        lv_max_stufe = ls_item-stufe.
      ENDIF.
    ENDLOOP.

    "If no stufe found, nothing to do (or you can decide to proceed as before)
    IF lv_max_stufe = 0.
      rv_success = abap_true.
      RETURN.
    ENDIF.

    LOOP AT it_wbs_items INTO ls_item.

      ">>> NEW: only highest level
      IF ls_item-stufe <> lv_max_stufe.
        CONTINUE.
      ENDIF.

      IF ls_item-wert2 IS INITIAL.
        CONTINUE.
      ENDIF.

      DATA: lv_posid_db TYPE ps_posid.
      lv_posid_db = ls_item-posid.

      CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
        EXPORTING
          input  = lv_posid_db
        IMPORTING
          output = lv_posid_db.

      SELECT SINGLE objnr
        FROM prps
        INTO @lv_objnr
        WHERE posid = @lv_posid_db.

      IF sy-subrc <> 0 OR lv_objnr IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR ls_bpak.
      ls_bpak-e_objnr = lv_objnr.
      ls_bpak-e_versn = '000'.
      ls_bpak-e_perio = '001'.
      ls_bpak-e_wrttp = '01'.         "PLAN
      ls_bpak-wert    = ls_item-wert2.
      ls_bpak-twaer   = lv_waers.     "MANDATORY

      APPEND ls_bpak TO lt_bpak.
    ENDLOOP.

    IF lt_bpak IS INITIAL.
      rv_success = abap_true.
      RETURN.
    ENDIF.

    CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
      EXPORTING
        i_budget_activity = 'KSTP'    "CJ40
        i_delta_amounts   = lv_delta
        i_rollup_data     = lv_rollup
        i_check_plan_data = 'X'
        i_application     = 'P'
        i_commit_all      = 'X'
      IMPORTING
        e_errors_found    = lv_errors_found
      TABLES
        it_bpak           = lt_bpak
        it_return         = lt_return.

    IF lv_errors_found EQ abap_false.
      rv_success = abap_true.
      COMMIT WORK AND WAIT.
    ENDIF.

  ENDMETHOD.




  METHOD assign_budget_cj30.

    DATA: lv_errors_found TYPE oax,
          lt_bpak         TYPE STANDARD TABLE OF bpak,
          lt_wbs_db       TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
          ls_bpak         TYPE bpak,
          ls_wbs_db       TYPE ztb_a2r_wbsitem,
          lv_objnr        TYPE j_objnr,
          lv_waers        TYPE waers,
          lv_delta        TYPE c,
          lv_rollup       TYPE c,
          lt_return       TYPE STANDARD TABLE OF bapiret2,
          lv_posid_db     TYPE ps_posid,
          lv_has_error    TYPE abap_bool.

    rv_success = abap_false.
    CLEAR: lt_bpak, lt_return, lv_errors_found.

    lv_delta = ''.
    lv_rollup = ''.

*---------------------------------------------------------------------*
* 1) Get Currency
*---------------------------------------------------------------------*
    SELECT SINGLE waers
      INTO @lv_waers
      FROM ztb_a2r_wbshdr
      WHERE zreq_num = @is_header-zreq_num.

    IF lv_waers IS INITIAL.
      lv_waers = is_header-waers.
    ENDIF.

    IF lv_waers IS INITIAL AND is_header-bukrs IS NOT INITIAL.
      SELECT SINGLE waers
        INTO @lv_waers
        FROM t001
        WHERE bukrs = @is_header-bukrs.
    ENDIF.

    IF lv_waers IS INITIAL.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* 2) Read ONLY flagged WBS from DB
*---------------------------------------------------------------------*
    SELECT *
      FROM ztb_a2r_wbsitem
      INTO TABLE @lt_wbs_db
      WHERE zreq_num      = @is_header-zreq_num
        AND zbudget_check = 'X'
        AND wert2         > 0.

    IF lt_wbs_db IS INITIAL.
      rv_success = abap_true.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* 3) Build BPAK from DB records
*---------------------------------------------------------------------*
    LOOP AT lt_wbs_db INTO ls_wbs_db.

      CLEAR lv_objnr.

      "Convert POSID external -> internal
      lv_posid_db = ls_wbs_db-posid.

      CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
        EXPORTING
          input  = lv_posid_db
        IMPORTING
          output = lv_posid_db
        EXCEPTIONS
          OTHERS = 1.

      SELECT SINGLE objnr
        INTO @lv_objnr
        FROM prps
        WHERE posid = @lv_posid_db.

      IF lv_objnr IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR ls_bpak.
      ls_bpak-e_objnr = lv_objnr.
      ls_bpak-e_versn = '000'.
      ls_bpak-e_perio = '001'.
      ls_bpak-e_wrttp = '41'.     "CJ30 Budget
      ls_bpak-wert    = ls_wbs_db-wert2.
      ls_bpak-twaer   = lv_waers.

      APPEND ls_bpak TO lt_bpak.

    ENDLOOP.

    IF lt_bpak IS INITIAL.
      rv_success = abap_true.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* 4) Call FM
*---------------------------------------------------------------------*
    CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
      EXPORTING
        i_budget_activity             = 'KBUD'
        i_budget_distribution_allowed = 'X'
        i_delta_amounts               = lv_delta
        i_rollup_data                 = lv_rollup
        i_check_plan_data             = 'X'
        i_application                 = 'P'
        i_commit_all                  = 'X'
      IMPORTING
        e_errors_found                = lv_errors_found
      TABLES
        it_bpak                       = lt_bpak
        it_return                     = lt_return.

    IF sy-subrc <> 0 OR lv_errors_found IS NOT INITIAL.
      rv_success = abap_false.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* 5) Check Return Messages
*---------------------------------------------------------------------*

    LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'AEX'.
      EXIT.
    ENDLOOP.

    IF sy-subrc EQ 0.
      rv_success = abap_false. " Error updating
    ELSE.
      COMMIT WORK AND WAIT.
      WAIT UP TO 2 SECONDS.
      rv_success = abap_true.
    ENDIF.
  ENDMETHOD.
