" WBS ELEMENT ID: Build from new project number + template suffix
DATA: lv_template_posid   TYPE ps_posid,
      lv_new_posid        TYPE ps_posid,
      lv_template_project TYPE ps_pspid,
      lv_suffix           TYPE string,
      lv_pspid_no_dots    TYPE string,
      lv_template_no_dots TYPE string.

lv_template_posid = ls_wbs-posid.  " e.g., PC0000100

" Get template project ID (Level 1)
READ TABLE lt_wbs_sorted INTO ls_level1 WITH KEY stufe = 1.
IF sy-subrc = 0.
  lv_template_project = ls_level1-posid.  " e.g., PC000001
ENDIF.

" Convert project to format without dots for comparison
lv_pspid_no_dots = lv_pspid.
REPLACE ALL OCCURRENCES OF '.' IN lv_pspid_no_dots WITH ''.  " PC.000023 → PC000023

" Extract suffix: everything after the template project ID
IF lv_template_project IS NOT INITIAL AND
   lv_template_posid CS lv_template_project.
  
  " Get the length of template project
  DATA(lv_prefix_len) = strlen( lv_template_project ).
  
  " Extract suffix (the part after project ID)
  lv_suffix = lv_template_posid+lv_prefix_len.  " "00" or "001" etc.
  
  " Build new POSID: new project (no dots) + suffix
  lv_new_posid = lv_pspid_no_dots && lv_suffix.  " PC00002300
  
ELSE.
  lv_new_posid = lv_template_posid.
ENDIF.

" NOW convert to external format with dots
CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
  EXPORTING
    input  = lv_new_posid
  IMPORTING
    output = lv_new_posid.

ls_wbs_celement-wbs_element = lv_new_posid.
