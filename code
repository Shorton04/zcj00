EXPORT lv_wf_flag = lv_wf_flag TO MEMORY ID 'ZWBS_WF_FLAG'.

SET PARAMETER ID 'ZWBSREQUEST' FIELD object-key-request.
CALL TRANSACTION 'ZCJ02N' AND SKIP FIRST SCREEN .

IF gv_at_capex_approver_step IS NOT INITIAL.
  IMPORT gv_capex_app_response = gv_capex_app_response
                              FROM MEMORY ID 'ZWBS_CAPEX_APPROVER_RESPONSE'.
ELSEIF gv_at_pm_approver_step IS NOT INITIAL.
  IMPORT gv_pm_app_response = gv_pm_app_response
