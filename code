FORM get_raw_data USING iv_pspid_proj TYPE ztb_a2r_wbshdr-pspid.

  "--- Local Declarations
  DATA: ls_proj        TYPE proj,
        lt_prps        TYPE STANDARD TABLE OF prps,
        ls_prps        TYPE prps,
        ls_item        TYPE ztb_a2r_wbsitem.

  DATA: lt_objnr TYPE STANDARD TABLE OF prps-objnr,
        lt_posid TYPE STANDARD TABLE OF prps-posid.

  "--- Clear outputs
  CLEAR: gs_header, gt_wbs_items.

*---------------------------------------------------------------------*
* 1) PROJ Header Read
*---------------------------------------------------------------------*
  SELECT SINGLE pspnr post1 ernam erdat vernr vbukr vkokr prctr plsez werks profl kostl
    INTO ls_proj
    FROM proj
    WHERE pspid = iv_pspid_proj.

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  gs_header-mandt = sy-mandt.
  gs_header-pspnr = ls_proj-pspnr.
  gs_header-post1 = ls_proj-post1.
  gs_header-ernam = ls_proj-ernam.
  gs_header-erdat = ls_proj-erdat.
  gs_header-vernr = ls_proj-vernr.
  gs_header-bukrs = ls_proj-vbukr.
  gs_header-vkokr = ls_proj-vkokr.
  gs_header-prctr = ls_proj-prctr.
  gs_header-plsez = ls_proj-plsez.
  gs_header-werks = ls_proj-werks.
  gs_header-profl = ls_proj-profl.
  gs_header-kostl = ls_proj-kostl.

*---------------------------------------------------------------------*
* 2) PRPS Read
*---------------------------------------------------------------------*
  SELECT posid post1 objnr pbukr pkokr pkstl werks stufe zunifier_proj
    INTO TABLE lt_prps
    FROM prps
    WHERE psphi = ls_proj-pspnr.

  IF lt_prps IS INITIAL.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* Build helper lists
*---------------------------------------------------------------------*
  LOOP AT lt_prps INTO ls_prps.
    APPEND ls_prps-objnr TO lt_objnr.
    APPEND ls_prps-posid TO lt_posid.
  ENDLOOP.

  DELETE ADJACENT DUPLICATES FROM lt_objnr.
  DELETE ADJACENT DUPLICATES FROM lt_posid.

*---------------------------------------------------------------------*
* 4) BPGE KSTP (WERT2)
*---------------------------------------------------------------------*
  TYPES: BEGIN OF ty_kstp,
           objnr TYPE bpge-objnr,
           wtges TYPE bpge-wtges,
         END OF ty_kstp.

  DATA: lt_kstp TYPE STANDARD TABLE OF ty_kstp,
        ls_kstp TYPE ty_kstp.

  SELECT objnr SUM( wtges ) AS wtges
    INTO TABLE lt_kstp
    FROM bpge
    FOR ALL ENTRIES IN lt_objnr
    WHERE objnr = lt_objnr-table_line
      AND vorga = 'KSTP'
    GROUP BY objnr.

*---------------------------------------------------------------------*
* 5) KBUD (prepare only)
*---------------------------------------------------------------------*
  TYPES: BEGIN OF ty_kbud,
           objnr TYPE bpge-objnr,
           geber TYPE bpge-geber,
         END OF ty_kbud.

  DATA: lt_kbud TYPE STANDARD TABLE OF ty_kbud.

  SELECT objnr MAX( geber ) AS geber
    INTO TABLE lt_kbud
    FROM bpge
    FOR ALL ENTRIES IN lt_objnr
    WHERE objnr = lt_objnr-table_line
      AND vorga = 'KBUD'
      AND geber <> ''
    GROUP BY objnr.

*---------------------------------------------------------------------*
* 6) V_IVP_PR
*---------------------------------------------------------------------*
  TYPES: BEGIN OF ty_ivp,
           posid TYPE v_ivp_pr-posid,
           prnam TYPE v_ivp_pr-prnam,
           gjahr TYPE v_ivp_pr-gjahr,
           posnr TYPE v_ivp_pr-posnr,
           prart TYPE v_ivp_pr-prart,
         END OF ty_ivp.

  DATA: lt_ivp TYPE STANDARD TABLE OF ty_ivp,
        ls_ivp TYPE ty_ivp.

  SELECT posid prnam gjahr posnr prart
    INTO TABLE lt_ivp
    FROM v_ivp_pr
    FOR ALL ENTRIES IN lt_posid
    WHERE posid = lt_posid-table_line.

*---------------------------------------------------------------------*
* 7) IMPR
*---------------------------------------------------------------------*
  DATA: lt_impr TYPE STANDARD TABLE OF impr,
        ls_impr TYPE impr.

  SELECT posnr izwek
    INTO TABLE lt_impr
    FROM impr
    FOR ALL ENTRIES IN lt_ivp
    WHERE posnr = lt_ivp-posnr.

*---------------------------------------------------------------------*
* 3) Populate Items
*---------------------------------------------------------------------*
  LOOP AT lt_prps INTO ls_prps.

    CLEAR ls_item.

    ls_item-mandt = sy-mandt.
    ls_item-pspid = iv_pspid_proj.
    ls_item-posid = ls_prps-posid.
    ls_item-post1 = ls_prps-post1.
    ls_item-bukrs = ls_prps-pbukr.
    ls_item-vkokr = ls_prps-pkokr.
    ls_item-stufe = ls_prps-stufe.
    ls_item-werks = ls_prps-werks.

*--- ZUNIFIER header once
    IF gs_header-zunifier_proj IS INITIAL
       AND ls_prps-zunifier_proj IS NOT INITIAL.
      gs_header-zunifier_proj = ls_prps-zunifier_proj.
    ENDIF.

*--- WERT2
    READ TABLE lt_kstp INTO ls_kstp
      WITH KEY objnr = ls_prps-objnr.
    IF sy-subrc = 0.
      ls_item-wert2 = ls_kstp-wtges.
    ENDIF.

*--- IVP
    READ TABLE lt_ivp INTO ls_ivp
      WITH KEY posid = ls_prps-posid.
    IF sy-subrc = 0.

      ls_item-gjahr = ls_ivp-gjahr.
      ls_item-prart = ls_ivp-prart.

      IF gs_header-prnam IS INITIAL.
        gs_header-prnam = ls_ivp-prnam.
        gs_header-gjahr = ls_ivp-gjahr.
        gs_header-posnr = ls_ivp-posnr.
      ENDIF.

*--- IMPR
      IF gs_header-izwek IS INITIAL.
        READ TABLE lt_impr INTO ls_impr
          WITH KEY posnr = ls_ivp-posnr.
        IF sy-subrc = 0.
          gs_header-izwek = ls_impr-izwek.
        ENDIF.
      ENDIF.

    ENDIF.

    APPEND ls_item TO gt_wbs_items.

  ENDLOOP.

ENDFORM.