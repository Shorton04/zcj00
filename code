*&---------------------------------------------------------------------*
*& Report ZRE_A2R_WORKORDER_TIME
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
REPORT ZRE_A2R_WORKORDER_TIME.

*------------------------------------------------------------------*
*                      Global Work Areas                           *
*------------------------------------------------------------------*
TABLES:aufk, afih, iloa, mhio, mhis, afko, jest, rihea.
*------------------------------------------------------------------*
*                    Global Definitions                            *
*------------------------------------------------------------------*
DATA: go_controller TYPE REF TO zcl_a2d_controller,
      go_model_view TYPE REF TO zcl_a2r_mvi0123,
      gs_parameter  TYPE        zcl_a2r_mvi0123=>ts_parameter.

SELECTION-SCREEN BEGIN OF SCREEN 0100 AS SUBSCREEN.
SELECTION-SCREEN BEGIN OF  BLOCK c WITH FRAME TITLE text-003.
PARAMETERS:v_pmo  TYPE flag RADIOBUTTON GROUP rb1 USER-COMMAND ordr,
           v_npmo TYPE flag RADIOBUTTON GROUP rb1.
SELECTION-SCREEN END OF BLOCK c.

SELECTION-SCREEN BEGIN OF  BLOCK a WITH FRAME TITLE text-001.
SELECT-OPTIONS:  r_aufnr FOR  aufk-aufnr,
                 r_stati FOR  rihea-i_vstatin MATCHCODE OBJECT i_status, " Status Include
                 r_state FOR  rihea-i_vstatin MATCHCODE OBJECT i_status, " Status Exclude
                 r_auart FOR  aufk-auart,
                 r_erdat FOR  aufk-erdat,
                 r_idat2 FOR  aufk-idat2,
                 r_gstri FOR  afko-gstri,
                 r_getri FOR  afko-getri,
                 r_iwerk FOR  afih-iwerk,
                 r_ingpr FOR  afih-ingpr,
                 r_priok FOR  afih-priok,
                 r_ilart FOR  afih-ilart,
                 r_vaplz FOR  aufk-vaplz,
                 r_kostl FOR  aufk-kostl,
                 r_tplnr FOR  iloa-tplnr,
                 r_warpl FOR  mhio-warpl MODIF ID sc1,
                 r_nplda FOR  mhis-nplda MODIF ID sc1.
SELECTION-SCREEN END OF  BLOCK a.
SELECTION-SCREEN: BEGIN OF BLOCK b WITH FRAME TITLE text-002.
PARAMETERS: v_var TYPE slis_vari.
SELECTION-SCREEN END OF BLOCK b.
SELECTION-SCREEN END OF SCREEN 0100.
*------------------------------------------------------------------*
*                 INITIALIZATION Event                             *
*------------------------------------------------------------------*
INITIALIZATION.

  sy-cprog = 'RIAFVC20'.

  zcl_a2r_mvi0123=>gv_program = sy-cprog.

  GET PARAMETER ID 'WRK' FIELD r_iwerk-low .
  r_iwerk-option = 'EQ'. r_iwerk-sign = 'I'.
  APPEND r_iwerk.

  r_nplda-low = sy-datum - 7. r_nplda-high = sy-datum.
  r_nplda-option = 'BT'. r_nplda-sign = 'I'.
  APPEND r_nplda.


  CREATE OBJECT go_model_view.

  CALL FUNCTION 'ZFM_A2D_CONTROLLER_M01_V01_L02'
    EXPORTING
      iv_parameter_struct_name = 'zcl_a2r_mvi0123=>TS_PARAMETER'
      iv_result_struct_name    = 'zcl_a2r_mvi0123=>TS_RESULT'
      io_view_report           = go_model_view
      io_view_alv              = go_model_view
      io_model_selection       = go_model_view
      iv_report_id             = sy-repid
      iv_parameter_subscr_id   = '0100'
    IMPORTING
      eo_controller            = go_controller.

  ASSERT go_controller IS BOUND.

* dynpro call backs
AT SELECTION-SCREEN OUTPUT.
  IF go_controller IS BOUND.
    go_controller->copy_option_to_parameter(   CHANGING  cs_parameter  = gs_parameter  ).
    go_controller->on_selection_screen_output( CHANGING  cs_parameter  = gs_parameter  ).
    go_controller->copy_parameter_to_option(   EXPORTING is_parameter  = gs_parameter  ).
  ENDIF.

AT SELECTION-SCREEN.
  IF go_controller IS BOUND.
    go_controller->copy_option_to_parameter( CHANGING  cs_parameter  = gs_parameter  ).
    go_controller->on_selection_screen(      CHANGING  cs_parameter  = gs_parameter  ).
    go_controller->copy_parameter_to_option( EXPORTING is_parameter  = gs_parameter  ).
  ENDIF.

  sy-cprog = 'RIAFVC20'.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR v_var.
  PERFORM manage_variant CHANGING v_var.
*&---------------------------------------------------------------------*
*&      Form  MANAGE_VARIANT
*&---------------------------------------------------------------------*
FORM manage_variant  CHANGING cv_variant TYPE disvariant-variant.
  DATA: ls_variant TYPE disvariant,
        l_exit     TYPE char1.

  ls_variant-report = sy-repid.

  CALL FUNCTION 'REUSE_ALV_VARIANT_F4'
    EXPORTING
      is_variant = ls_variant
      i_save     = 'A'
    IMPORTING
      e_exit     = l_exit
      es_variant = ls_variant
    EXCEPTIONS
      not_found  = 2.

  IF sy-subrc = 2.
    MESSAGE ID sy-msgid TYPE 'S' NUMBER sy-msgno
            WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
  ELSE.
    IF l_exit EQ space.
      cv_variant = ls_variant-variant.
    ENDIF.
  ENDIF.
ENDFORM.                    " MANAGE_VARIANT
