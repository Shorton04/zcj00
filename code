FUNCTION sap_wapi_get_attachments .
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(WORKITEM_ID) LIKE  SWR_STRUCT-WORKITEMID
*"     VALUE(USER) TYPE  SYUNAME DEFAULT SY-UNAME
*"     VALUE(LANGUAGE) TYPE  SYLANGU DEFAULT SY-LANGU
*"     VALUE(COMMENT_SEMANTIC_ONLY) TYPE  XFLAG DEFAULT SPACE
*"  EXPORTING
*"     VALUE(RETURN_CODE) LIKE  SY-SUBRC
*"  TABLES
*"      ATTACHMENTS STRUCTURE  SWR_OBJECT OPTIONAL
*"      MESSAGE_LINES STRUCTURE  SWR_MESSAG OPTIONAL
*"      MESSAGE_STRUCT STRUCTURE  SWR_MSTRUC OPTIONAL
*"----------------------------------------------------------------------
  DATA: ls_attachobj LIKE swotobjid,
        msg          TYPE REF TO cl_swf_utl_wapi_message,
        funcname     TYPE funcname VALUE 'SAP_WAPI_GET_ATTACHMENTS',
        ls_t100msg   TYPE swf_t100ms,
        lt_objects   TYPE sibflporbt,
        lv_excp      TYPE REF TO cx_swf_ifs_exception,
        hlp_lines    TYPE sytabix,
        ls_swrobj    TYPE swr_object,
        lv_wi_handle TYPE REF TO if_swf_run_wim_internal,
        lv_handle    TYPE sytabix,
        lv_wapi      TYPE REF TO if_swf_utl_wapi_framework.
  DATA: lh_trc_data TYPE REF TO if_swf_cnt_container.
  DATA: lt_message_lines TYPE sapi_msg_lines.
  DATA: lt_message_struct TYPE sapi_msg_struc.
  DATA: lt_attachments TYPE swrtobject.
  DATA: lh_container TYPE REF TO if_swf_cnt_container.
  DATA: ls_lpor TYPE sibflpor.
  DATA: ls_swwwihead TYPE swwwihead.
  DATA: lt_comment_objects TYPE sibflporbt.
  DATA: ls_object LIKE LINE OF lt_objects.

*- register to framework and get message object
  lv_wapi = cl_swf_utl_wapi_framework=>create( im_language = language ).
  lv_handle = lv_wapi->register_function( funcname ).
  msg = lv_wapi->get_message_object( ).

*~~ begin of trace specific coding ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
  IF lv_wapi->m_trace_handle IS BOUND.
    TRY.
        lh_trc_data = lv_wapi->get_initial_trace_data( ).
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'WORKITEM_ID'
            value = workitem_id.
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'USER'
            value = user.
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'LANGUAGE'
            value = language.
        CALL METHOD lh_trc_data->element_set "- 1865998
          EXPORTING
            name  = 'COMMENT_SEMANTIC_ONLY'
            value = comment_semantic_only.
        CALL METHOD lv_wapi->write_trace
          EXPORTING
            im_evt  = swwtr_api_init
            im_data = lh_trc_data.
      CATCH cx_swf_ifs_exception.                       "#EC NO_HANDLER
    ENDTRY.
  ENDIF.
*~~ end of trace specific coding ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*


*- get attachments
  TRY.
      CALL METHOD cl_swf_run_wim_factory=>find_by_wiid
        EXPORTING
          im_wiid     = workitem_id
        RECEIVING
          re_instance = lv_wi_handle.
*---- note 1519755: always get container from database
      MOVE-CORRESPONDING lv_wi_handle->m_sww_wihead TO ls_swwwihead.
      ls_lpor = cl_swf_utl_pers_profile=>get_cnt_lpor_from_header( im_header = ls_swwwihead ).
      lh_container = cl_swf_cnt_factory=>create( ibf_por = ls_lpor ).
* --- note 1865998 ---
*     lt_objects = lv_wi_handle->get_attach_objects( im_container = lh_container ).
      lt_comment_objects = lv_wi_handle->get_attach_objects(
                               im_container        = lh_container
                               im_comment_semantic = 'X' ).
      attachments[] = cl_swf_utl_wapi_services=>get_swr_object_1( lt_comment_objects ).
      ls_swrobj-object_typ = 'CM'.
      MODIFY attachments FROM ls_swrobj TRANSPORTING object_typ WHERE object_typ IS INITIAL.

      IF comment_semantic_only NE 'X'.
        lt_objects = lv_wi_handle->get_attach_objects(
                                 im_container        = lh_container
                                 im_comment_semantic = space ).
        LOOP AT lt_comment_objects INTO ls_object.
          DELETE lt_objects WHERE instid EQ ls_object-instid
                              AND typeid EQ ls_object-typeid
                              AND catid EQ ls_object-catid.
        ENDLOOP.
        lt_attachments[] = cl_swf_utl_wapi_services=>get_swr_object_1( lt_objects ).
        ls_swrobj-object_typ = 'AT'.
        MODIFY lt_attachments FROM ls_swrobj TRANSPORTING object_typ WHERE object_typ IS INITIAL.
        APPEND LINES OF lt_attachments TO attachments.
      ENDIF.

*- delete identical entries (note 2169516)
      lt_attachments = attachments[].
      clear attachments[].
      loop at lt_attachments into ls_swrobj.
        read table attachments with key object_id = ls_swrobj-object_id TRANSPORTING NO FIELDS.
        if sy-subrc ne 0.
          append ls_swrobj to attachments.
        endif.
      endloop.

      DESCRIBE TABLE attachments LINES hlp_lines.
      ls_t100msg-msgid = 'WZ'.
      ls_t100msg-msgno = 513.
      ls_t100msg-msgty = 'S'.
      ls_t100msg-msgv1 = hlp_lines.
      CALL METHOD msg->set_t100msg( ls_t100msg ).
    CATCH cx_swf_ifs_exception INTO lv_excp.
      return_code = 1.
      CALL METHOD msg->set_exception_object
        EXPORTING
          im_excp = lv_excp.
  ENDTRY.

*- set export
  message_lines[] = msg->get_message_lines( ).
  message_struct[] = msg->get_message_struct( ).

*~~ begin of trace specific coding ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
  IF lv_wapi->m_trace_handle IS BOUND.
    TRY.
        lh_trc_data = lv_wapi->get_initial_trace_data( ).
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'RETURN_CODE'
            value = return_code.
        lt_attachments = attachments[].
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'ATTACHMENTS'
            value = lt_attachments[].
        lt_message_lines = message_lines[].
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'MESSAGE_LINES'
            value = lt_message_lines.
        lt_message_struct = message_struct[].
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'MESSAGE_STRUCT'
            value = lt_message_struct.
        CALL METHOD lv_wapi->write_trace
          EXPORTING
            im_evt  = swwtr_api_result
            im_data = lh_trc_data.
      CATCH cx_swf_ifs_exception.                       "#EC NO_HANDLER
    ENDTRY.
  ENDIF.
*~~ end of trace specific coding ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*

*- unregister to framework
  CALL METHOD lv_wapi->unregister( lv_handle ).

ENDFUNCTION.
