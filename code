METHODS get_currency_from_header
  IMPORTING
    is_header TYPE ztb_a2r_wbshdr
  RETURNING
    VALUE(rv_waers) TYPE waers.



METHODS assign_plan_values
  IMPORTING
    is_header    TYPE ztb_a2r_wbshdr
    it_wbs_items TYPE STANDARD TABLE OF ztb_a2r_wbsitem
  RETURNING
    VALUE(rv_success) TYPE abap_bool.


METHODS distribute_budget_im52
  IMPORTING
    is_header    TYPE ztb_a2r_wbshdr
    it_wbs_items TYPE STANDARD TABLE OF ztb_a2r_wbsitem
  RETURNING
    VALUE(rv_success) TYPE abap_bool.


METHODS assign_budget_cj30
  IMPORTING
    is_header    TYPE ztb_a2r_wbshdr
    it_wbs_items TYPE STANDARD TABLE OF ztb_a2r_wbsitem
  RETURNING
    VALUE(rv_success) TYPE abap_bool.



METHODS post_plan_im52_cj30_flow
  IMPORTING
    is_header    TYPE ztb_a2r_wbshdr
    it_wbs_items TYPE STANDARD TABLE OF ztb_a2r_wbsitem
  RETURNING
    VALUE(rv_success) TYPE abap_bool.



METHOD assign_plan_values.

  DATA: lv_errors_found TYPE oax,
        lt_bpak         TYPE TABLE OF bpak,
        ls_bpak         TYPE bpak,
        ls_item         TYPE ztb_a2r_wbsitem,
        lv_objnr        TYPE j_objnr,
        lv_waers        TYPE waers,
        lt_return       TYPE TABLE OF bapiret2.

  rv_success = abap_false.
  CLEAR: lt_bpak, lt_return, lv_errors_found.

  lv_waers = get_currency_from_header( is_header ).
  IF lv_waers IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT it_wbs_items INTO ls_item.
    IF ls_item-wert2 IS INITIAL.
      CONTINUE.
    ENDIF.

    SELECT SINGLE objnr
      FROM prps
      INTO @lv_objnr
      WHERE posid = @ls_item-posid.

    IF sy-subrc <> 0 OR lv_objnr IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_bpak.
    ls_bpak-e_objnr = lv_objnr.
    ls_bpak-e_versn = '000'.
    ls_bpak-e_perio = '001'.
    ls_bpak-e_wrttp = '01'.         "PLAN
    ls_bpak-wert    = ls_item-wert2.
    ls_bpak-twaer   = lv_waers.     "MANDATORY

    APPEND ls_bpak TO lt_bpak.
  ENDLOOP.

  IF lt_bpak IS INITIAL.
    rv_success = abap_true.
    RETURN.
  ENDIF.

  CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
    EXPORTING
      i_budget_activity = 'KSTP'    "CJ40
      i_delta_amounts   = 'X'
      i_rollup_data     = 'X'
      i_check_plan_data = 'X'
      i_application     = 'P'
      i_commit_all      = 'X'
    IMPORTING
      e_errors_found    = lv_errors_found
    TABLES
      it_bpak           = lt_bpak
      it_return         = lt_return.

  IF sy-subrc <> 0 OR lv_errors_found IS NOT INITIAL.
    RETURN.
  ENDIF.

  READ TABLE lt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
  IF sy-subrc = 0.
    RETURN.
  ENDIF.

  rv_success = abap_true.

ENDMETHOD.



METHOD distribute_budget_im52.

  DATA: lv_errors_found TYPE oax,
        lt_bpak         TYPE TABLE OF bpak,
        ls_bpak         TYPE bpak,
        ls_item         TYPE ztb_a2r_wbsitem,
        lv_objnr        TYPE j_objnr,
        lv_waers        TYPE waers,
        lv_posnr        TYPE bp_posit,
        lt_return       TYPE TABLE OF bapiret2.

  FIELD-SYMBOLS: <fs_posnr> TYPE any.

  rv_success = abap_false.
  CLEAR: lt_bpak, lt_return, lv_errors_found, lv_posnr.

  lv_waers = get_currency_from_header( is_header ).
  IF lv_waers IS INITIAL.
    RETURN.
  ENDIF.

  "Get IM Position (POSNR) from header
  ASSIGN COMPONENT 'POSNR' OF STRUCTURE is_header TO <fs_posnr>.
  IF sy-subrc = 0 AND <fs_posnr> IS ASSIGNED AND <fs_posnr> IS NOT INITIAL.
    lv_posnr = <fs_posnr>.
  ENDIF.

  IF lv_posnr IS INITIAL.
    "No IM position => cannot do IM52 distribution
    RETURN.
  ENDIF.

  "Build distribution lines ONLY for Level 1 WBS
  LOOP AT it_wbs_items INTO ls_item.

    "Adjust this condition to your real “Level 1” logic/field
    IF ls_item-stufe <> 1.
      CONTINUE.
    ENDIF.

    IF ls_item-wert2 IS INITIAL.
      CONTINUE.
    ENDIF.

    SELECT SINGLE objnr
      FROM prps
      INTO @lv_objnr
      WHERE posid = @ls_item-posid.

    IF sy-subrc <> 0 OR lv_objnr IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_bpak.
    ls_bpak-s_posit = lv_posnr.     "IM Position (source)
    ls_bpak-e_objnr = lv_objnr.     "Receiver = Level 1 WBS
    ls_bpak-e_versn = '000'.
    ls_bpak-e_perio = '001'.
    ls_bpak-e_wrttp = '41'.         "Budget amount for distribution
    ls_bpak-wert    = ls_item-wert2.
    ls_bpak-twaer   = lv_waers.

    APPEND ls_bpak TO lt_bpak.

  ENDLOOP.

  IF lt_bpak IS INITIAL.
    rv_success = abap_true.
    RETURN.
  ENDIF.

  CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
    EXPORTING
      i_budget_activity              = 'KBUD'  "Budget update interface
      i_budget_distribution_allowed  = 'X'     "<<< IM52 trigger (per SAP note)
      i_delta_amounts                = 'X'
      i_rollup_data                  = 'X'
      i_check_plan_data              = 'X'
      i_application                  = 'P'
      i_commit_all                   = 'X'
    IMPORTING
      e_errors_found                 = lv_errors_found
    TABLES
      it_bpak                         = lt_bpak
      it_return                       = lt_return.

  IF sy-subrc <> 0 OR lv_errors_found IS NOT INITIAL.
    RETURN.
  ENDIF.

  READ TABLE lt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
  IF sy-subrc = 0.
    RETURN.
  ENDIF.

  rv_success = abap_true.

ENDMETHOD.



METHOD assign_budget_cj30.

  DATA: lv_errors_found TYPE oax,
        lt_bpak         TYPE TABLE OF bpak,
        ls_bpak         TYPE bpak,
        ls_item         TYPE ztb_a2r_wbsitem,
