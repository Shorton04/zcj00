*****           Implementation of object type Z_KOSTK              *****
INCLUDE <object>.
begin_data object. " Do not change.. DATA is generated
* only private members may be inserted into structure private
DATA:
  " begin of private,
  "   to declare private attributes remove comments and
  "   insert private attributes here ...
  " end of private,
  BEGIN OF key,
    request LIKE zwbs_header-request,
  END OF key,
  lv_wi_prefix TYPE rgrwa-indxn_pref,
  lv_location  TYPE usr03-ort01,
  lv_request   TYPE vbak-vbeln,
  lv_case      TYPE dbtablog-versno,
  _zwbs_header LIKE zwbs_header.
end_data object. " Do not change.. DATA is generated
TABLES zwbs_header.
*
get_table_property zwbs_header.
DATA subrc LIKE sy-subrc.
* Fill TABLES ZWBS_HEADER to enable Object Manager Access to Table Properties
PERFORM select_table_zwbs_header USING subrc.
IF subrc NE 0.
  exit_object_not_found.
ENDIF.
end_property.
*
* Use Form also for other(virtual) Properties to fill TABLES ZWBS_HEADER
FORM select_table_zwbs_header USING subrc LIKE sy-subrc.

* Select single * from ZWBS_HEADER, if OBJECT-ZWBS_HEADER is initial
  IF object-_zwbs_header-mandt   IS INITIAL AND
     object-_zwbs_header-request IS INITIAL.
    SELECT SINGLE * FROM zwbs_header CLIENT SPECIFIED
                    WHERE mandt   = sy-mandt AND
                          request = object-key-request.
    subrc = sy-subrc.
    IF subrc NE 0. EXIT. ENDIF.
    object-_zwbs_header = zwbs_header.
  ELSE.
    subrc = 0.
    zwbs_header = object-_zwbs_header.
  ENDIF.
ENDFORM.

begin_method display changing container.
SET PARAMETER ID 'ZWBSREQUEST' FIELD object-key-request.
CALL TRANSACTION 'ZCJ03' AND SKIP FIRST SCREEN.
end_method.




begin_method change changing container.

DATA: lv_status           TYPE char1,
      lt_reason           TYPE STANDARD TABLE OF tdline,
      lv_request          TYPE zwbs_header-request,
      lv_finalstep        TYPE char1,
      lv_wi_agent         TYPE char15,
      lv_return           LIKE bapiret1,
      lv_accept           TYPE char1,
      lv_reject           TYPE char1,
      lv_wf_flag          TYPE flag,
      gv_mdm_app_response TYPE flag,
      gv_capex            TYPE flag.

** write current agent to memory
lv_wf_flag = abap_true.
FREE MEMORY ID 'ZWBS_WF_FLAG'.
EXPORT lv_wf_flag = lv_wf_flag TO MEMORY ID 'ZWBS_WF_FLAG'.

swc_get_element container 'IV_CAPEX' gv_capex .

IF gv_capex IS NOT INITIAL.
  EXPORT gv_capex = gv_capex TO MEMORY ID 'ZWBS_CAPEX'.
ENDIF.

SET PARAMETER ID 'ZWBSREQUEST' FIELD object-key-request.
CALL TRANSACTION 'ZCJ02N' AND SKIP FIRST SCREEN.

IMPORT:
lv_status           = lv_status           FROM MEMORY ID 'ZWBS_WF_STATUS',
gv_mdm_app_response = gv_mdm_app_response FROM MEMORY ID 'ZWBS_MDM_APPROVER_RESPONSE'.

FREE MEMORY ID: 'ZWBS_WF_STATUS',
                'ZWBS_MDM_APPROVER_RESPONSE'.

swc_set_element container 'EvMdmAprResponse' gv_mdm_app_response.
swc_set_element container 'Ev_Status' lv_status.
end_method.

get_property lv_wi_prefix changing container.
DATA: lv_prefix      TYPE char6,
      lv_case        TYPE char2,
      ls_wbs_header  TYPE zwbs_header,
      lv_user        TYPE syst_uname,
      es_userdetails TYPE qisrsuser_data,
      ls_usr03       TYPE usr03,
      lv_location    TYPE xuort01,
      lv_fullname    TYPE ad_namtext.

CONCATENATE 'WBS_' object-_zwbs_header-proj_type INTO lv_prefix.
swc_set_element container 'LV_WI_PREFIX' lv_prefix.
end_property.

get_property lv_location changing container.
DATA ls_usr03 TYPE usr03.
* // get city of user
CLEAR ls_usr03.
CALL FUNCTION 'SUSR_USER_ADDRESS_READ'
  EXPORTING
    user_name              = object-_zwbs_header-created_by
  IMPORTING
    user_usr03             = ls_usr03
  EXCEPTIONS
    user_address_not_found = 0
    OTHERS                 = 0.

swc_set_element container 'LV_LOCATION' ls_usr03-ort01.
end_property.

get_property lv_case changing container.
DATA lv_case TYPE char2.
CASE object-_zwbs_header-type.
  WHEN '1'.
    lv_case = 'CR'.
  WHEN '2'.
    lv_case = 'MO'.
  WHEN '3'.
    lv_case = 'CL'.
  WHEN '4'.
    lv_case = 'UC'.
ENDCASE.
swc_set_element container 'LV_CASE' lv_case.
end_property.

get_property lv_request changing container.
CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
  EXPORTING
    input  = object-key-request
  IMPORTING
    output = object-lv_request.

swc_set_element container 'LV_REQUEST' object-lv_request.
end_property.

begin_method change_approvers changing container.

DATA: lv_status                   TYPE char1,
      lt_reason                   TYPE STANDARD TABLE OF tdline,
      lv_request                  TYPE zwbs_header-request,
      lv_finalstep                TYPE char1,
      lv_wi_agent                 TYPE char15,
      lv_return                   LIKE bapiret1,
      lv_accept                   TYPE char1,
      lv_reject                   TYPE char1,
      lv_wf_flag                  TYPE flag,
      gv_pm_app_response          TYPE flag,
      gv_capex_app_response       TYPE flag,
      gv_co_app_response          TYPE flag,
      gv_r2r_acc_app_response     TYPE flag,
      gv_r2r_sr_app_response      TYPE flag,
      gv_at_pm_approver_step      TYPE swp_agent,
      gv_at_capex_approver_step   TYPE swp_agent,
      gv_at_co_approver_step      TYPE swp_agent,
      gv_at_r2r_acc_approver_step TYPE swp_agent,
