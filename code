  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_REQUEST_FLEXWF->SUBMIT
* +-------------------------------------------------------------------------------------------------+
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD submit.
    DATA:
      lv_event            TYPE        sibfevent,
      lv_objkey           TYPE        sibfinstid,
      lr_event_parameters TYPE REF TO cl_swf_cnt_container.


    CREATE OBJECT lr_event_parameters.

    lv_event  = me->mv_event_id.
    lv_objkey = me->ms_header-zreq_num.
    DATA(lv_typeid) = 'ZCL_A2R_WBS_REQUEST_FLEXWF'.

    " Set the header details
    TRY.
        CALL METHOD lr_event_parameters->if_swf_cnt_element_access_1~element_set_value
          EXPORTING
            name  = 'IV_HEADER'
            value = me->ms_header.
      CATCH cx_root ##NO_HANDLER ##CATCH_ALL.
    ENDTRY.

    " Set the auto approval indicator
    TRY.
        CALL METHOD lr_event_parameters->if_swf_cnt_element_access_1~element_set_value
          EXPORTING
            name  = 'IV_AUTO'
            value = me->mv_auto.
      CATCH cx_root ##NO_HANDLER ##CATCH_ALL.
    ENDTRY.

    " Set the approval level 1
    TRY.
        CALL METHOD lr_event_parameters->if_swf_cnt_element_access_1~element_set_value
          EXPORTING
            name  = 'IT_L1APPROVER'
            value = me->mt_l1approver.
      CATCH cx_root ##NO_HANDLER ##CATCH_ALL.
    ENDTRY.


    " Set the approval level 2
    TRY.
        CALL METHOD lr_event_parameters->if_swf_cnt_element_access_1~element_set_value
          EXPORTING
            name  = 'IT_L2APPROVER'
            value = me->mt_l2approver.
      CATCH cx_root ##NO_HANDLER ##CATCH_ALL.
    ENDTRY.

    " Set the Hierarchy pointers
    TRY.
        CALL METHOD lr_event_parameters->if_swf_cnt_element_access_1~element_set_value
          EXPORTING
            name  = 'IT_WBS_HIER'
            value = me->mt_wbshier.
      CATCH cx_root ##NO_HANDLER ##CATCH_ALL.
    ENDTRY.

    " Set the WBS Items
    TRY.
        CALL METHOD lr_event_parameters->if_swf_cnt_element_access_1~element_set_value
          EXPORTING
            name  = 'IT_WBSCAR'
            value = me->mt_wbscar.
      CATCH cx_root ##NO_HANDLER ##CATCH_ALL.
    ENDTRY.

    " Set the WBS Items
    TRY.
        CALL METHOD lr_event_parameters->if_swf_cnt_element_access_1~element_set_value
          EXPORTING
            name  = 'IT_WBSUNCLOSE'
            value = me->mt_wbsunclose.
      CATCH cx_root ##NO_HANDLER ##CATCH_ALL.
    ENDTRY.

    " Event riase to trigger the WF
    TRY.
        CALL METHOD cl_swf_evt_event=>raise
          EXPORTING
            im_objcateg        = cl_swf_evt_event=>mc_objcateg_cl
            im_objtype         = lv_typeid
            im_event           = lv_event
            im_objkey          = lv_objkey
            im_event_container = lr_event_parameters.
        COMMIT WORK.
      CATCH cx_swf_evt_invalid_objtype  ##NO_HANDLER.
      CATCH cx_swf_evt_invalid_event  ##NO_HANDLER.
    ENDTRY.
  ENDMETHOD.
