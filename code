MODULE f4_help_person_responsible INPUT.

  " Get IM responsible persons
  SELECT DISTINCT vernr, verna
    FROM prps
    WHERE vernr IS NOT INITIAL
    ORDER BY verna
    INTO TABLE @lt_personnel.
  IF sy-subrc <> 0.
    MESSAGE i000(zmsg_a2r) WITH 'No IM Responsible Persons Found'(m17).
    RETURN.
  ENDIF.


  " Display F4
  CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
    EXPORTING
      retfield        = 'VERNR'
      dynpprog        = sy-cprog
      dynpnr          = sy-dynnr
      dynprofield     = 'GS_HEADER-VERNR'
      value_org       = 'S'
      window_title    = 'Select Person Responsible' ##NO_TEXT
    TABLES
      value_tab       = lt_personnel
      return_tab      = lt_return
    EXCEPTIONS
      parameter_error = 1
      no_values_found = 2
      OTHERS          = 3.

  IF sy-subrc = 0.
    READ TABLE lt_return INTO ls_return INDEX 1.
    IF sy-subrc = 0.
      gs_header-vernr  = ls_return-fieldval.
      p_verna          = gs_header-vernr.
      gv_
