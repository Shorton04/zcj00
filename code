      CLEAR: lv_left_new, lv_left_level.
      lv_forward_index = lv_index + 1.

      WHILE lv_forward_index <= lines( lt_wbs_sorted ).
        READ TABLE lt_wbs_sorted INDEX lv_forward_index INTO ls_wbs_temp.
        IF sy-subrc = 0 AND ls_wbs_temp-stufe = ls_wbs-stufe.

          " Found the next sibling - rebuild with new project id
          lv_left_new = ls_wbs_temp-posid.
          IF lv_template_project IS NOT INITIAL.
            REPLACE lv_template_project IN lv_left_new WITH lv_pspid.
          ENDIF.
          REPLACE ALL OCCURRENCES OF '.' IN lv_left_new WITH ''.
          lv_left_level = lv_left_new.
          EXIT.

        ENDIF.
        lv_forward_index = lv_forward_index + 1.
      ENDWHILE.


      "------------------------------------------------------------
      " WBS_UP: Search BACKWARD for parent (nearest upper level)
      "   from the previous row (lv_index - 1) up to the top
      "------------------------------------------------------------

      CLEAR: lv_parent_new, lv_upper_level.
      lv_backward_index = lv_index - 1.

      WHILE lv_backward_index >= 1.
        READ TABLE lt_wbs_sorted INDEX lv_backward_index INTO ls_wbs_temp.
        IF sy-subrc = 0 AND ls_wbs_temp-stufe < ls_wbs-stufe.

          IF ls_wbs_temp-stufe = 1.
            lv_parent_new = lv_pspid.
          ELSE.
            lv_parent_new = ls_wbs_temp-posid.
            IF lv_template_project IS NOT INITIAL.
              REPLACE lv_template_project IN lv_parent_new WITH lv_pspid.
            ENDIF.
          ENDIF.

          REPLACE ALL OCCURRENCES OF '.' IN lv_parent_new WITH ''.
          lv_upper_level = lv_parent_new.
          EXIT.

        ENDIF.
        lv_backward_index = lv_backward_index - 1.
      ENDWHILE.

      ls_wbs_celement-proj_type  = ls_wbs-prart.
      " Set results to the current element
      ls_wbs_celement-wbs_up   = lv_upper_level.
      ls_wbs_celement-wbs_left = lv_left_level.
      CLEAR: ls_wbs_celement-wbs_left, lv_left_level.
      APPEND ls_wbs_celement TO lt_wbs_celement.
