*&---------------------------------------------------------------------*
*& Form VALIDATE_TOTAL_UP_DONE
*&---------------------------------------------------------------------*
FORM validate_total_up_done
  CHANGING cv_error TYPE abap_bool.

  DATA: lt_table5 TYPE STANDARD TABLE OF ty_wbs_display,
        lt_table4 TYPE STANDARD TABLE OF ty_wbs_display,
        lt_table3 TYPE STANDARD TABLE OF ty_wbs_display,
        lt_table2 TYPE STANDARD TABLE OF ty_wbs_display,
        lv_sum4   TYPE ty_wbs_display-zapproved_budg,
        lv_sum3   TYPE ty_wbs_display-zapproved_budg,
        lv_sum2   TYPE ty_wbs_display-zapproved_budg,
        lv_len4   TYPE i,
        lv_len3   TYPE i,
        lv_len2   TYPE i.

  FIELD-SYMBOLS: <wa2> TYPE ty_wbs_display,
                 <wa3> TYPE ty_wbs_display,
                 <wa4> TYPE ty_wbs_display,
                 <wa5> TYPE ty_wbs_display.

  DATA: lv_posid_4 TYPE ps_posid,
        lv_posid_3 TYPE ps_posid,
        lv_posid_2 TYPE ps_posid.

  CLEAR cv_error.

*---------------------------------------------------------------------*
* Prepare child tables
*---------------------------------------------------------------------*
  LOOP AT gt_wbs_display ASSIGNING FIELD-SYMBOL(<wa>).

    IF <wa>-stufe = '5'.
      APPEND <wa> TO lt_table5.

    ELSEIF <wa>-stufe = '4'.
      APPEND <wa> TO lt_table4.

    ELSEIF <wa>-stufe = '3'.
      APPEND <wa> TO lt_table3.

    ELSEIF <wa>-stufe = '2'.
      APPEND <wa> TO lt_table2.
    ENDIF.

  ENDLOOP.

*---------------------------------------------------------------------*
* Validate Level 4 = sum of Level 5
*---------------------------------------------------------------------*
  LOOP AT gt_wbs_display ASSIGNING <wa4> WHERE stufe = '4'.

    CLEAR: lv_sum4, lv_posid_4, lv_len4.
    lv_posid_4 = <wa4>-posid.

    CALL FUNCTION 'FTR_CORR_SWIFT_DELETE_ENDZERO'
      CHANGING
        c_value = lv_posid_4.

    lv_len4 = strlen( lv_posid_4 ).

    LOOP AT lt_table5 ASSIGNING <wa5>.
      IF <wa5>-posid+0(lv_len4) = <wa4>-posid+0(lv_len4).
        lv_sum4 = lv_sum4 + <wa5>-zapproved_budg.
      ENDIF.
    ENDLOOP.

    IF lv_sum4 <> <wa4>-zapproved_budg.
      MESSAGE e000(zmsg_a2r)
        WITH 'Please trigger Total Up first. Budget mismatch in Level 4 WBS'
             <wa4>-posid.
      cv_error = abap_true.
      RETURN.
    ENDIF.

  ENDLOOP.

*---------------------------------------------------------------------*
* Validate Level 3 = sum of Level 4
*---------------------------------------------------------------------*
  LOOP AT gt_wbs_display ASSIGNING <wa3> WHERE stufe = '3'.

    CLEAR: lv_sum3, lv_posid_3, lv_len3.
    lv_posid_3 = <wa3>-posid.

    CALL FUNCTION 'FTR_CORR_SWIFT_DELETE_ENDZERO'
      CHANGING
        c_value = lv_posid_3.

    lv_len3 = strlen( lv_posid_3 ).

    LOOP AT lt_table4 ASSIGNING <wa4>.
      IF <wa4>-posid+0(lv_len3) = <wa3>-posid+0(lv_len3).
        lv_sum3 = lv_sum3 + <wa4>-zapproved_budg.
      ENDIF.
    ENDLOOP.

    IF lv_sum3 <> <wa3>-zapproved_budg.
      MESSAGE e000(zmsg_a2r)
        WITH 'Please trigger Total Up first. Budget mismatch in Level 3 WBS'
             <wa3>-posid.
      cv_error = abap_true.
      RETURN.
    ENDIF.

  ENDLOOP.

*---------------------------------------------------------------------*
* Validate Level 2 = sum of Level 3
*---------------------------------------------------------------------*
  LOOP AT gt_wbs_display ASSIGNING <wa2> WHERE stufe = '2'.

    CLEAR: lv_sum2, lv_posid_2, lv_len2.
    lv_posid_2 = <wa2>-posid.

    CALL FUNCTION 'FTR_CORR_SWIFT_DELETE_ENDZERO'
      CHANGING
        c_value = lv_posid_2.

    lv_len2 = strlen( lv_posid_2 ).

    LOOP AT lt_table3 ASSIGNING <wa3>.
      IF <wa3>-posid+0(lv_len2) = <wa2>-posid+0(lv_len2).
        lv_sum2 = lv_sum2 + <wa3>-zapproved_budg.
      ENDIF.
    ENDLOOP.

    IF lv_sum2 <> <wa2>-zapproved_budg.
      MESSAGE e000(zmsg_a2r)
        WITH 'Please trigger Total Up first. Budget mismatch in Level 2 WBS'
             <wa2>-posid.
      cv_error = abap_true.
      RETURN.
    ENDIF.

  ENDLOOP.

ENDFORM.