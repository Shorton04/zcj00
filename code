* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_MVI0123->VALIDATIONS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_PARAMATER                   TYPE        TS_PARAMETER
* | [<---] EV_SUCCESS                     TYPE        FLAG
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD validations.
  CLEAR ev_success.
  ev_success = abap_true.
*--------------------------------------------------------------------*
* Planning Plant Mandatory
*--------------------------------------------------------------------*
  IF is_paramAter-r_iwerk IS INITIAL.
    CLEAR ev_success.
    MESSAGE 'Planning Plant is a Mandatory Field'
      TYPE 'I'.
    EXIT.
  ENDIF.
*--------------------------------------------------------------------*
* At least one Date field mandatory
*--------------------------------------------------------------------*
  IF is_paramater-r_nplda IS INITIAL
     AND is_paramater-r_getri IS INITIAL
     AND is_paramater-r_gstri IS INITIAL
     AND is_paramater-r_erdat IS INITIAL
     AND is_paramater-r_idat2 IS INITIAL.
    CLEAR ev_success.
    MESSAGE 'At least one Date field must be entered'
      TYPE 'I'.
    EXIT.
  ENDIF.
ENDMETHOD.


