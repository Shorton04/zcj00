METHOD create_settlement_rules.
*&---------------------------------------------------------------------*
*& Create Settlement Rules via CJB2 Transaction (BDC)
*& Reference: SHDB Recording from user
*&---------------------------------------------------------------------*

  DATA: lt_bdcdata TYPE TABLE OF bdcdata,
        ls_bdcdata TYPE bdcdata,
        lt_bdcmsg  TYPE TABLE OF bdcmsgcoll,
        ls_wbs     TYPE ztb_a2r_wbsitem,
        lv_pspid   TYPE ps_pspid,
        lv_posid   TYPE ps_posid,
        lv_sender_objnr   TYPE j_objnr,
        lv_receiver_objnr TYPE j_objnr,
        lv_parent_posid   TYPE ps_posid,
        lv_mode    TYPE c VALUE 'N',  " Background mode
        lv_update  TYPE c VALUE 'S'.  " Synchronous update

  rv_success = abap_false.

  LOOP AT it_wbs_items INTO ls_wbs.

    " Skip Level 1 (no settlement needed)
    IF ls_wbs-stufe = 1.
      CONTINUE.
    ENDIF.

    " Skip items without budget
    IF ls_wbs-wert2 IS INITIAL.
      CONTINUE.
    ENDIF.

    " Get sender WBS object number
    SELECT SINGLE p~objnr, p~posid, p~psphi
      FROM prps AS p
      INTO (@lv_sender_objnr, @lv_posid, @DATA(lv_psphi))
      WHERE p~posid = @ls_wbs-posid.

    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    " Get parent (receiver) WBS from hierarchy
    SELECT SINGLE objnr, posid
      FROM prps
      INTO (@lv_receiver_objnr, @lv_parent_posid)
      WHERE pspnr = @lv_psphi.

    IF sy-subrc <> 0 OR lv_receiver_objnr IS INITIAL.
      CONTINUE.
    ENDIF.

    " Convert POSID to PSPID format for BDC
    CALL FUNCTION 'CONVERSION_EXIT_ABPSP_OUTPUT'
      EXPORTING
        input  = lv_posid
      IMPORTING
        output = lv_posid.

    CALL FUNCTION 'CONVERSION_EXIT_ABPSP_OUTPUT'
      EXPORTING
        input  = lv_parent_posid
      IMPORTING
        output = lv_parent_posid.

    CLEAR lt_bdcdata.

    " Screen 1: CJB2 Initial Screen
    PERFORM bdc_dynpro USING 'SAPLKAZB' '1000'
                       CHANGING lt_bdcdata.
    PERFORM bdc_field  USING 'BDC_CURSOR' 'RKAUF-TEST'
                       CHANGING lt_bdcdata.
    PERFORM bdc_field  USING 'BDC_OKCODE' 'RUN'
                       CHANGING lt_bdcdata.
    PERFORM bdc_field  USING 'RKAUF-TEST' lv_posid  " Sender WBS
                       CHANGING lt_bdcdata.

    " Screen 2: Settlement Rule Details (SAPLKAOP 0570)
    PERFORM bdc_dynpro USING 'SAPLKAOP' '0570'
                       CHANGING lt_bdcdata.
    PERFORM bdc_field  USING 'BDC_CURSOR' 'LKP74-PSPID'
                       CHANGING lt_bdcdata.
    PERFORM bdc_field  USING 'LKP74-PSPID' lv_parent_posid  " Receiver WBS
                       CHANGING lt_bdcdata.
    PERFORM bdc_field  USING 'BDC_OKCODE' '=SICH'  " Save
                       CHANGING lt_bdcdata.

    " Execute BDC
    CALL TRANSACTION 'CJB2'
      USING lt_bdcdata
      MODE lv_mode
      UPDATE lv_update
      MESSAGES INTO lt_bdcmsg.

    " Check for errors
    READ TABLE lt_bdcmsg TRANSPORTING NO FIELDS
      WITH KEY msgtyp = 'E'.

    IF sy-subrc = 0.
      " Error occurred
      rv_success = abap_false.
      MESSAGE e024(zcj00).  " Settlement rule creation failed
      RETURN.
    ENDIF.

    " Activate SETC status
    CALL FUNCTION 'STATUS_CHANGE_INTERN'
      EXPORTING
        client              = sy-mandt
        objnr               = lv_sender_objnr
        user_stat           = 'SETC'
        set_inact           = ''
      EXCEPTIONS
        object_not_found    = 1
        status_inconsistent = 2
        OTHERS              = 3.

  ENDLOOP.

  COMMIT WORK AND WAIT.
  rv_success = abap_true.

ENDMETHOD.





*&---------------------------------------------------------------------*
*&      Form  BDC_DYNPRO
*&---------------------------------------------------------------------*
FORM bdc_dynpro USING p_program TYPE bdcdata-program
                      p_dynpro  TYPE bdcdata-dynpro
              CHANGING ct_bdcdata TYPE STANDARD TABLE.

  DATA: ls_bdcdata TYPE bdcdata.

  CLEAR ls_bdcdata.
  ls_bdcdata-program  = p_program.
  ls_bdcdata-dynpro   = p_dynpro.
  ls_bdcdata-dynbegin = 'X'.
  APPEND ls_bdcdata TO ct_bdcdata.

ENDFORM.

*&---------------------------------------------------------------------*
*&      Form  BDC_FIELD
*&---------------------------------------------------------------------*
FORM bdc_field USING p_fnam TYPE bdcdata-fnam
                     p_fval TYPE bdcdata-fval
             CHANGING ct_bdcdata TYPE STANDARD TABLE.

  DATA: ls_bdcdata TYPE bdcdata.

  IF p_fval IS NOT INITIAL.
    CLEAR ls_bdcdata.
    ls_bdcdata-fnam = p_fnam.
    ls_bdcdata-fval = p_fval.
    APPEND ls_bdcdata TO ct_bdcdata.
  ENDIF.

ENDFORM.
