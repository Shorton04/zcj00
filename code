METHOD get_next_project_number.
*&---------------------------------------------------------------------*
*& METHOD: GET_NEXT_PROJECT_NUMBER
*& FDS: "Incorporate standard functionality to check the next available
*&       running number (similar to 'Check next open number' in CJ20N)"
*& Uses: CN_SUCHE_FREIE_NUMMER with exact parameter names from SE37
*&---------------------------------------------------------------------*

  DATA: lv_proj_e_imp    TYPE proj-pspid,   " Final value from FM
        lv_proj_s_imp    TYPE proj-pspid,   " Start value for FM
        lv_template_pspid TYPE proj-pspid.  " Template from config

  CLEAR rv_pspid.

  " ═══════════════════════════════════════════════════════════════
  " Step 1: Get starting pattern - Priority order:
  " 1st: Last project from this profile
  " 2nd: Template project from config table
  " ═══════════════════════════════════════════════════════════════
  
  " Try to get last project from this profile
  SELECT pspid FROM proj
    WHERE profl = @iv_profl
    ORDER BY pspid DESCENDING
    UP TO 1 ROWS
    INTO @lv_proj_s_imp.
  ENDSELECT.

  " If no existing projects, use template as pattern
  IF sy-subrc <> 0 OR lv_proj_s_imp IS INITIAL.
    
    " Get template project PSPID from config table
    SELECT SINGLE pspid FROM ztb_a2r_conftab1
      INTO @lv_template_pspid
      WHERE profl = @iv_profl.
    
    IF sy-subrc = 0 AND lv_template_pspid IS NOT INITIAL.
      lv_proj_s_imp = lv_template_pspid.
    ELSE.
      MESSAGE e029(zcj00) WITH 'No starting pattern found for profile' iv_profl.
      RETURN.
    ENDIF.
  ENDIF.

  " ═══════════════════════════════════════════════════════════════
  " Step 2: Call CN_SUCHE_FREIE_NUMMER with exact parameters
  " Same function used by CJ20N "Check next open number" button
  " ═══════════════════════════════════════════════════════════════
  CALL FUNCTION 'CN_SUCHE_FREIE_NUMMER'
    EXPORTING
      search_imp      = '1'              " Search type: 1 = Project
      proj_s_imp      = lv_proj_s_imp    " Start value - project definition
      refresh         = abap_true        " Refresh search
      no_dialog       = abap_true        " No selection popup
    IMPORTING
      proj_e_imp      = lv_proj_e_imp    " Final value - project definition
    EXCEPTIONS
      wrong_search    = 1
      search_canceled = 2
      OTHERS          = 3.

  IF sy-subrc <> 0.
    MESSAGE e029(zcj00) WITH 'CN_SUCHE_FREIE_NUMMER failed' sy-subrc.
    RETURN.
  ENDIF.

  " ═══════════════════════════════════════════════════════════════
  " Step 3: Validate result
  " ═══════════════════════════════════════════════════════════════
  IF lv_proj_e_imp IS INITIAL.
    MESSAGE e029(zcj00) WITH 'No next project number returned'.
    RETURN.
  ENDIF.

  " ═══════════════════════════════════════════════════════════════
  " Step 4: Return the generated project number
  " ═══════════════════════════════════════════════════════════════
  rv_pspid = lv_proj_e_imp.

ENDMETHOD.
