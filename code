"Identify parents: a POSID is parent if any other POSID starts with parent + '.'
DATA: lv_pattern TYPE string.

LOOP AT lt_all_posid INTO DATA(lv_posid).

  LOOP AT lt_all_posid INTO DATA(lv_child)
       WHERE table_line <> lv_posid.

    CLEAR lv_pattern.
    CONCATENATE lv_posid '.' '*' INTO lv_pattern.   " => e.g. PC.000114.00.*

    IF lv_child CP lv_pattern.
      INSERT lv_posid INTO TABLE lt_parent_posid.
      EXIT.
    ENDIF.

  ENDLOOP.

ENDLOOP.