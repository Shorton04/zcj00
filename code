@AbapCatalog.sqlViewName: 'ZV_WO_CORE'
@AbapCatalog.compiler.compareFilter: true
@AbapCatalog.preserveKey: true
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Work Order Core - AUFK/AFIH/AFKO/ILOA'

define view ZI_WO_CORE
  as select from aufk
  inner join afih  on afih.aufnr  = aufk.aufnr
  inner join afko  on afko.aufnr  = aufk.aufnr
  inner join iloa  on iloa.iloan  = afih.iloan
  inner join t001w on t001w.werks = aufk.werks
{
  key aufk.aufnr   as aufnr,
      aufk.auart   as auart,
      aufk.erdat   as erdat,
      aufk.idat2   as idat2,
      aufk.vaplz   as vaplz,
      aufk.kostl   as kostl,
      aufk.objnr   as objnr,
      aufk.werks   as werks,
      aufk.ktext   as ktext,
      aufk.ernam   as ernam,

      afih.iwerk   as iwerk,
      afih.ingpr   as ingpr,
      afih.priok   as priok,
      afih.iloan   as iloan,
      afih.ilart   as ilart,
      afih.addat   as addat,
      afih.warpl   as warpl,
      afih.abnum   as abnum,
      afih.wapos   as wapos,
      afih.lacd_date as lacd_date,

      afko.gstri   as gstri,
      afko.getri   as getri,
      afko.gstrs   as gstrs,
      afko.gltrs   as gltrs,
      afko.rueck   as rueck,
      afko.rmzhl   as rmzhl,

      iloa.tplnr   as tplnr,

      t001w.name1  as werks_name
}




