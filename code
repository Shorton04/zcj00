begin_method auto_approval changing container.
DATA:lt_bdc                      TYPE STANDARD TABLE OF bdcdata,
     lt_log                      TYPE STANDARD TABLE OF bdcmsgcoll,
     ls_header                   TYPE zwbs_header,
     ls_params                   TYPE ctu_params,
     ls_log                      TYPE bdcmsgcoll,
     lv_wf_flag                  TYPE flag,
     gv_auto_approver_step       TYPE flag,
     gv_auto_approver_step_error TYPE flag,
     ls_bdc                      TYPE bdcdata,
     lv_error                    TYPE char1,
     lv_start                    TYPE ps_pspid,
     lv_finish                   TYPE ps_pspid.

* Begin of changes by LCHENNA for CR
DATA : lv_msg           TYPE string,
       lt_err_tab       TYPE TABLE OF bapiret2,
       ls_err           TYPE bapiret2,
       gv_err_mail_flag TYPE flag.
* End of changes by LCHENNA for CR
*Header Data
SELECT SINGLE * FROM zwbs_header INTO ls_header
                WHERE request = object-key-request.

*ZCJ02N Initial Screen
ls_bdc-program  = 'SAPMZWBS'.
ls_bdc-dynpro   = '0700'.
ls_bdc-dynbegin = 'X'.
APPEND ls_bdc TO lt_bdc.

CLEAR ls_bdc.
ls_bdc-fnam     = 'BDC_CURSOR'.
ls_bdc-fval     = 'ZWBS_HEADER-REQUEST'.
APPEND ls_bdc TO lt_bdc.

CLEAR ls_bdc.
ls_bdc-fnam     = 'BDC_OKCODE'.
ls_bdc-fval     = '=ENTER'.
APPEND ls_bdc TO lt_bdc.

CLEAR ls_bdc.
ls_bdc-fnam     = 'ZWBS_HEADER-REQUEST'.
ls_bdc-fval     = object-key-request.
APPEND ls_bdc TO lt_bdc.

*Header and Detail Screen with Approve Action
CLEAR ls_bdc.
ls_bdc-program  = 'SAPMZWBS'.
ls_bdc-dynpro   = '0400'.
ls_bdc-dynbegin = 'X'.
APPEND ls_bdc TO lt_bdc.

CLEAR ls_bdc.
ls_bdc-fnam     = 'BDC_OKCODE'.
ls_bdc-fval     = '=APPROVE'.
APPEND ls_bdc TO lt_bdc.

*Create Project Scenario
IF ls_header-type = 1.
*Values for Number Proposal
  lv_start  = ls_header-proj_type.
  CONCATENATE ls_header-proj_type '99999' INTO lv_finish.

*Pop-up for Project Number Assignment
  CLEAR ls_bdc.
  ls_bdc-program  = 'SAPLCN00'.
  ls_bdc-dynpro   = '1000'.
  ls_bdc-dynbegin = 'X'.
  APPEND ls_bdc TO lt_bdc.

  CLEAR ls_bdc.
  ls_bdc-fnam     = 'BDC_CURSOR'.
  ls_bdc-fval     = '*PROJ-PSPID'.
  APPEND ls_bdc TO lt_bdc.

  CLEAR ls_bdc.
  ls_bdc-fnam     = 'BDC_OKCODE'.
  ls_bdc-fval     = '=SUCH'.
  APPEND ls_bdc TO lt_bdc.

  CLEAR ls_bdc.
  ls_bdc-fnam     = 'PROJ-PSPID'.
  ls_bdc-fval     = lv_start.
  APPEND ls_bdc TO lt_bdc.

  CLEAR ls_bdc.
  ls_bdc-fnam     = '*PROJ-PSPID'.
  ls_bdc-fval     = lv_finish.
  APPEND ls_bdc TO lt_bdc.

  CLEAR ls_bdc.
  ls_bdc-fnam     = 'CN00-GAP'.
  ls_bdc-fval     = 'X'.
  APPEND ls_bdc TO lt_bdc.

  CLEAR ls_bdc.
  ls_bdc-program  = 'SAPLCN00'.
  ls_bdc-dynpro   = '1000'.
  ls_bdc-dynbegin = 'X'.
  APPEND ls_bdc TO lt_bdc.

  CLEAR ls_bdc.
  ls_bdc-fnam     = 'BDC_CURSOR'.
  ls_bdc-fval     = 'PROJ-PSPID'.
  APPEND ls_bdc TO lt_bdc.

  CLEAR ls_bdc.
  ls_bdc-fnam     = 'BDC_OKCODE'.
  ls_bdc-fval     = '=UEBN'.
  APPEND ls_bdc TO lt_bdc.
ENDIF.

ls_params-updmode  = 'A'.
ls_params-dismode  = 'N'.
ls_params-defsize  = 'X'.
ls_params-racommit = 'X'.

gv_auto_approver_step = abap_true.
EXPORT gv_auto_approver_step = gv_auto_approver_step
     TO MEMORY ID 'ZWBS_AUTO_APPROVER_STEP'.

*Workflow Flag
lv_wf_flag = abap_true.
FREE MEMORY ID 'ZWBS_WF_FLAG'.
EXPORT lv_wf_flag = lv_wf_flag TO MEMORY ID 'ZWBS_WF_FLAG'.

CALL TRANSACTION 'ZCJ02N' USING lt_bdc
                          MESSAGES INTO lt_log
                          OPTIONS FROM ls_params.
IF sy-subrc <> 0.
  lv_error = 'E'.
ELSEIF NOT lt_log IS INITIAL.
  CLEAR ls_log.
  READ TABLE lt_log INTO ls_log
                    WITH KEY msgtyp = 'I'
                             msgid  = '00'
                             msgnr  = '368'.
  IF ls_log-msgv1 CS 'Approved'.
  ELSE.
    lv_error = 'E'.
  ENDIF.
ENDIF.

*Check for Errors from WBS Processing
IMPORT gv_err_mail_flag = gv_err_mail_flag
                    FROM MEMORY ID 'ZWBS_ERR_MAIL'.
FREE MEMORY ID 'ZWBS_ERR_MAIL'.
*Send Email in case of Screen Validation Errors - PV Cases
IF NOT ls_header-zprj_code_pv IS INITIAL AND
   NOT lt_log                 IS INITIAL AND
   NOT lv_error               IS INITIAL AND
   gv_err_mail_flag           IS INITIAL.
  LOOP AT lt_log INTO ls_log.
    CALL FUNCTION 'FORMAT_MESSAGE'
      EXPORTING
        id        = ls_log-msgid
        lang      = ls_log-msgspra
        no        = ls_log-msgnr
        v1        = ls_log-msgv1
        v2        = ls_log-msgv2
        v3        = ls_log-msgv3
        v4        = ls_log-msgv4
      IMPORTING
        msg       = lv_msg
      EXCEPTIONS
        not_found = 1
        OTHERS    = 2.
    IF sy-subrc = 0.
      ls_err-message = lv_msg.
      APPEND ls_err TO lt_err_tab.
    ENDIF.
  ENDLOOP.

  CALL FUNCTION 'ZWBS_SEND_EMAIL'
    EXPORTING
      iv_type    = 'E'
      iv_req_no  = object-key-request
      iv_express = 'X'
      iv_user    = sy-uname
    TABLES
      lt_error   = lt_err_tab.
ENDIF.

IF lv_error IS INITIAL.
  IMPORT gv_auto_approver_step_error = gv_auto_approver_step_error
                    FROM MEMORY ID 'ZWBS_AUTO_APPROVER_STEP_ERROR'.
  IF gv_auto_approver_step_error = abap_true.
    lv_error = 'E'.
  ENDIF.
ENDIF.

FREE MEMORY ID:'ZWBS_AUTO_APPROVER_STEP',
               'ZWBS_AUTO_APPROVER_STEP_ERROR',
               'ZWBS_WF_FLAG'.

swc_set_element container 'EvError' lv_error.
swc_set_table container 'Error_Tab' lt_log.

end_method.
