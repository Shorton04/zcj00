swc_set_element container 'EvCAPEXaprResponse'  gv_capex_app_response.
swc_set_element container 'EvCoAprResponse'  gv_co_app_response.
swc_set_element container 'EvR2RAccResponse' gv_r2r_acc_app_response.
swc_set_element container 'EvR2RSRResponse'  gv_r2r_sr_app_response.
