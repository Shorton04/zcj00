FUNCTION sap_wapi_get_child_workitems ##RFC_PERFORMANCE_OK.
*"----------------------------------------------------------------------
*"*"Lokale Schnittstelle:
*"  IMPORTING
*"     VALUE(WORKITEM_ID) TYPE  SWR_STRUCT-WORKITEMID OPTIONAL
*"     VALUE(USER) TYPE  SYUNAME DEFAULT SY-UNAME
*"     VALUE(TEXT) TYPE  XFELD DEFAULT 'X'
*"     VALUE(LANGUAGE) TYPE  SYLANGU DEFAULT SY-LANGU
*"     VALUE(STATUS) TYPE  SWFARTWISTA OPTIONAL
*"  EXPORTING
*"     VALUE(RETURN_CODE) LIKE  SY-SUBRC
*"  TABLES
*"      WORKLIST STRUCTURE  SWR_WIHDR
*"      MESSAGE_LINES STRUCTURE  SWR_MESSAG OPTIONAL
*"      MESSAGE_STRUCT STRUCTURE  SWR_MSTRUC OPTIONAL
*"----------------------------------------------------------------------
  DATA: hlp_lines LIKE sy-tabix,
        msg TYPE REF TO cl_swf_utl_wapi_message,
        lh_wi_handle TYPE REF TO if_swf_run_wim_internal,
        funcname TYPE funcname VALUE 'SAP_WAPI_GET_CHILD_WORKITEMS',
        ls_t100msg TYPE swf_t100ms,
        lv_handle TYPE sytabix,
        lv_wapi TYPE REF TO if_swf_utl_wapi_framework.
  DATA: lh_trc_data TYPE REF TO if_swf_cnt_container.
  DATA: lt_message_lines TYPE sapi_msg_lines.
  DATA: lt_message_struct TYPE sapi_msg_struc.
  DATA: l_count TYPE sytabix.
  DATA: lt_worklist TYPE swrtwihdr.
  DATA: lh_instance_mgr TYPE REF TO cl_swf_utl_gen_instance_mgr.
  DATA: lt_workitems TYPE sww_wi_header_arc.
  DATA: lh_excp TYPE REF TO cx_swf_run_wim.
  DATA: lh_wapi_services TYPE REF TO cl_swf_utl_wapi_services.
  DATA: ls_workitem TYPE swr_wihdr.
  FIELD-SYMBOLS: <header> TYPE LINE OF sww_wi_header_arc.

*- register to framework and get message object
  lv_wapi = cl_swf_utl_wapi_framework=>create( im_language = language ).
  lv_handle = lv_wapi->register_function( funcname ).
  msg = lv_wapi->get_message_object( ).

*~~ begin of trace specific coding ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
  IF lv_wapi->m_trace_handle IS BOUND.
    TRY.
        lh_trc_data = lv_wapi->get_initial_trace_data( ).
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'WORKITEM_ID'
            value = workitem_id.
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'STATUS'
            value = status.
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'LANGUAGE'
            value = language.
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'TEXT'
            value = text.
        CALL METHOD lv_wapi->write_trace
          EXPORTING
            im_evt  = swwtr_api_init
            im_data = lh_trc_data.
      CATCH cx_swf_ifs_exception.                       "#EC NO_HANDLER
    ENDTRY.
  ENDIF.
*~~ end of trace specific coding ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*

*- initialize export
  CLEAR worklist.  REFRESH worklist.
  CLEAR message_lines. REFRESH message_lines.
  CLEAR message_struct. REFRESH message_struct.

  TRY.
      CREATE OBJECT lh_instance_mgr.
      CALL METHOD cl_swf_run_wim_factory=>find_by_wiid
        EXPORTING
          im_wiid         = workitem_id
          im_instance_mgr = lh_instance_mgr
        RECEIVING
          re_instance     = lh_wi_handle.

*- check workitem
      IF lh_wi_handle->m_sww_wihead-wi_chckwi IS NOT INITIAL.
        ls_t100msg-msgid = 'WZ'.
        ls_t100msg-msgno = '589'.
        ls_t100msg-msgty = 'E'.
        ls_t100msg-msgv1 = workitem_id.
        CREATE OBJECT lh_excp
          EXPORTING
            t100_msg = ls_t100msg.

        CALL METHOD cl_swf_utl_exception_services=>raise_cx_swf_run_wim
          EXPORTING
            im_exception = lh_excp.
      ENDIF.

*- get all child items
      lt_workitems = lh_wi_handle->get_dependant_wis( im_direct_dependants_only = space im_status = status ).

*- translate to SWR_WIHDR
      CREATE OBJECT lh_wapi_services
        EXPORTING
          im_language = language
          im_user     = user.
      LOOP AT lt_workitems ASSIGNING <header>.
        ls_workitem = lh_wapi_services->get_swr_wihdr_via_swwwihead( im_swwwihead = <header>
                                                                     im_user = user
                                                                     im_language = language ).
        APPEND ls_workitem TO worklist.
        hlp_lines = hlp_lines + 1.
      ENDLOOP.

*- set export parameter
      return_code = 0.
      ls_t100msg-msgid = 'WZ'.
      ls_t100msg-msgno = '523'.
      ls_t100msg-msgty = 'S'.
      ls_t100msg-msgv1 = hlp_lines.
      CALL METHOD msg->set_t100msg( ls_t100msg ).

    CATCH cx_swf_run_wim INTO lh_excp.
      IF lh_excp->t100_msg-msgno EQ '589'.
        return_code = 1.
      ELSE.
        return_code = 2.
      ENDIF.
      CALL METHOD msg->set_exception_object
        EXPORTING
          im_excp = lh_excp.
  ENDTRY.

*- set export
  message_lines[] = msg->get_message_lines( ).
  message_struct[] = msg->get_message_struct( ).

*~~ begin of trace specific coding ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
  IF lv_wapi->m_trace_handle IS BOUND.
    TRY.
        lh_trc_data = lv_wapi->get_initial_trace_data( ).
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'RETURN_CODE'
            value = return_code.
        DESCRIBE TABLE worklist LINES l_count.
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'COUNT_WORKLIST'
            value = l_count.
        lt_message_lines = message_lines[].
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'MESSAGE_LINES'
            value = lt_message_lines.
        lt_message_struct = message_struct[].
        CALL METHOD lh_trc_data->element_set
          EXPORTING
            name  = 'MESSAGE_STRUCT'
            value = lt_message_struct.
        CALL METHOD lv_wapi->write_trace
          EXPORTING
            im_evt  = swwtr_api_result
            im_data = lh_trc_data.
        IF lv_wapi->m_trace_handle->get_trace_level( ) EQ swftr_trace_level_high.
          lh_trc_data = lv_wapi->get_initial_trace_data( ).
          lt_worklist = worklist[].
          CALL METHOD lh_trc_data->element_set
            EXPORTING
              name  = 'WORKLIST'
              value = lt_worklist.
          CALL METHOD lv_wapi->write_trace
            EXPORTING
              im_evt  = swwtr_api_result_extended
              im_data = lh_trc_data.
        ENDIF.
      CATCH cx_swf_ifs_exception.                       "#EC NO_HANDLER
    ENDTRY.
  ENDIF.
*~~ end of trace specific coding ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*

*- unregister to framework
  CALL METHOD lv_wapi->unregister( lv_handle ).

ENDFUNCTION.
