METHOD get_data_npmo.

  CLEAR: et_aufk, et_afih, et_afko, et_afru,
         et_jcds, et_mhio, et_mhis, et_jest,
         et_tj02t, et_iloa, gv_missing_auth,
         et_t001w, et_jcds_rel, et_jcds_teco.

  "--------------------------------------------------------------------
  " GUARD: r_iwerk is mandatory (enforced in VALIDATIONS).
  " At least one date range is also mandatory. Both are safe to use
  " directly. All other ranges below are optional and guarded.
  "--------------------------------------------------------------------

  "--------------------------------------------------------------------
  " 1. AFKO — only fetch if date ranges are provided (mandatory by
  "    validation, but we guard getri/gstri as they are optional)
  "--------------------------------------------------------------------
  DATA lt_afko TYPE STANDARD TABLE OF ts_afko WITH EMPTY KEY.

  " Build WHERE dynamically based on which ranges are filled
  IF is_parameter-r_aufnr IS NOT INITIAL
     AND is_parameter-r_getri IS NOT INITIAL
     AND is_parameter-r_gstri IS NOT INITIAL.

    SELECT aufnr, gstri, getri, rueck, rmzhl, gstrs, gltrs
      FROM afko
      INTO TABLE @lt_afko
      WHERE aufnr IN @is_parameter-r_aufnr
        AND getri IN @is_parameter-r_getri
        AND gstri IN @is_parameter-r_gstri.

  ELSEIF is_parameter-r_aufnr IS NOT INITIAL
         AND is_parameter-r_getri IS NOT INITIAL.

    SELECT aufnr, gstri, getri, rueck, rmzhl, gstrs, gltrs
      FROM afko
      INTO TABLE @lt_afko
      WHERE aufnr IN @is_parameter-r_aufnr
        AND getri IN @is_parameter-r_getri.

  ELSEIF is_parameter-r_aufnr IS NOT INITIAL
         AND is_parameter-r_gstri IS NOT INITIAL.

    SELECT aufnr, gstri, getri, rueck, rmzhl, gstrs, gltrs
      FROM afko
      INTO TABLE @lt_afko
      WHERE aufnr IN @is_parameter-r_aufnr
        AND gstri IN @is_parameter-r_gstri.

  ELSEIF is_parameter-r_getri IS NOT INITIAL
         AND is_parameter-r_gstri IS NOT INITIAL.

    SELECT aufnr, gstri, getri, rueck, rmzhl, gstrs, gltrs
      FROM afko
      INTO TABLE @lt_afko
      WHERE getri IN @is_parameter-r_getri
        AND gstri IN @is_parameter-r_gstri.

  ELSEIF is_parameter-r_aufnr IS NOT INITIAL.

    SELECT aufnr, gstri, getri, rueck, rmzhl, gstrs, gltrs
      FROM afko
      INTO TABLE @lt_afko
      WHERE aufnr IN @is_parameter-r_aufnr.

  ELSEIF is_parameter-r_getri IS NOT INITIAL.

    SELECT aufnr, gstri, getri, rueck, rmzhl, gstrs, gltrs
      FROM afko
      INTO TABLE @lt_afko
      WHERE getri IN @is_parameter-r_getri.

  ELSEIF is_parameter-r_gstri IS NOT INITIAL.

    SELECT aufnr, gstri, getri, rueck, rmzhl, gstrs, gltrs
      FROM afko
      INTO TABLE @lt_afko
      WHERE gstri IN @is_parameter-r_gstri.

  ENDIF.
  " If all three are initial, lt_afko stays empty — CHECK below exits.

  CHECK lt_afko IS NOT INITIAL.

  "--------------------------------------------------------------------
  " 2. AFIH joined to AFKO
  "    r_iwerk / r_ingpr / r_priok: iwerk is mandatory, others guarded
  "--------------------------------------------------------------------
  DATA lt_afih TYPE STANDARD TABLE OF ts_afih WITH EMPTY KEY.

  IF is_parameter-r_ingpr IS NOT INITIAL
     AND is_parameter-r_priok IS NOT INITIAL.

    SELECT afih~aufnr, afih~iwerk, afih~ingpr, afih~priok,
           afih~iloan,  afih~ilart,  afih~addat,
           afih~warpl,  afih~abnum,  afih~wapos, afih~lacd_date
      FROM afih
      INNER JOIN @lt_afko AS afko ON afko~aufnr = afih~aufnr
      INTO TABLE @lt_afih
      WHERE afih~iwerk IN @is_parameter-r_iwerk
        AND afih~ingpr IN @is_parameter-r_ingpr
        AND afih~priok IN @is_parameter-r_priok.

  ELSEIF is_parameter-r_ingpr IS NOT INITIAL.

    SELECT afih~aufnr, afih~iwerk, afih~ingpr, afih~priok,
           afih~iloan,  afih~ilart,  afih~addat,
           afih~warpl,  afih~abnum,  afih~wapos, afih~lacd_date
      FROM afih
      INNER JOIN @lt_afko AS afko ON afko~aufnr = afih~aufnr
      INTO TABLE @lt_afih
      WHERE afih~iwerk IN @is_parameter-r_iwerk
        AND afih~ingpr IN @is_parameter-r_ingpr.

  ELSEIF is_parameter-r_priok IS NOT INITIAL.

    SELECT afih~aufnr, afih~iwerk, afih~ingpr, afih~priok,
           afih~iloan,  afih~ilart,  afih~addat,
           afih~warpl,  afih~abnum,  afih~wapos, afih~lacd_date
      FROM afih
      INNER JOIN @lt_afko AS afko ON afko~aufnr = afih~aufnr
      INTO TABLE @lt_afih
      WHERE afih~iwerk IN @is_parameter-r_iwerk.

  ELSE.

    SELECT afih~aufnr, afih~iwerk, afih~ingpr, afih~priok,
           afih~iloan,  afih~ilart,  afih~addat,
           afih~warpl,  afih~abnum,  afih~wapos, afih~lacd_date
      FROM afih
      INNER JOIN @lt_afko AS afko ON afko~aufnr = afih~aufnr
      INTO TABLE @lt_afih
      WHERE afih~iwerk IN @is_parameter-r_iwerk.

  ENDIF.

  " ILART: no secondary index — post-filter
  IF is_parameter-r_ilart IS NOT INITIAL.
    DELETE lt_afih WHERE ilart NOT IN is_parameter-r_ilart.
  ENDIF.

  CHECK lt_afih IS NOT INITIAL.

  "--------------------------------------------------------------------
  " 3. Authority check
  "--------------------------------------------------------------------
  DATA lt_afih_auth TYPE STANDARD TABLE OF ts_afih WITH EMPTY KEY.

  LOOP AT lt_afih INTO DATA(ls_afih_chk).
    AUTHORITY-CHECK OBJECT 'I_IWERK'
      ID 'TCD'   FIELD 'ZIW123'
      ID 'IWERK' FIELD ls_afih_chk-iwerk.
    IF sy-subrc = 0.
      APPEND ls_afih_chk TO lt_afih_auth.
    ELSE.
      gv_missing_auth = abap_true.
    ENDIF.
  ENDLOOP.

  lt_afih = lt_afih_auth.
  CHECK lt_afih IS NOT INITIAL.

  "--------------------------------------------------------------------
  " 4. AUFK joined on AFIH
  "    r_auart / r_erdat: both optional — guarded
  "--------------------------------------------------------------------
  DATA lt_aufk TYPE STANDARD TABLE OF ts_aufk WITH EMPTY KEY.

  IF is_parameter-r_auart IS NOT INITIAL
     AND is_parameter-r_erdat IS NOT INITIAL.

    SELECT aufk~aufnr, aufk~auart, aufk~erdat, aufk~idat2,
           aufk~vaplz,  aufk~kostl,  aufk~objnr,
           aufk~werks,  aufk~ktext,  aufk~ernam
      FROM aufk
      INNER JOIN @lt_afih AS afih ON afih~aufnr = aufk~aufnr
      INTO TABLE @lt_aufk
      WHERE aufk~auart IN @is_parameter-r_auart
        AND aufk~erdat IN @is_parameter-r_erdat.

  ELSEIF is_parameter-r_auart IS NOT INITIAL.

    SELECT aufk~aufnr, aufk~auart, aufk~erdat, aufk~idat2,
           aufk~vaplz,  aufk~kostl,  aufk~objnr,
           aufk~werks,  aufk~ktext,  aufk~ernam
      FROM aufk
      INNER JOIN @lt_afih AS afih ON afih~aufnr = aufk~aufnr
      INTO TABLE @lt_aufk
      WHERE aufk~auart IN @is_parameter-r_auart.

  ELSEIF is_parameter-r_erdat IS NOT INITIAL.

    SELECT aufk~aufnr, aufk~auart, aufk~erdat, aufk~idat2,
           aufk~vaplz,  aufk~kostl,  aufk~objnr,
           aufk~werks,  aufk~ktext,  aufk~ernam
      FROM aufk
      INNER JOIN @lt_afih AS afih ON afih~aufnr = aufk~aufnr
      INTO TABLE @lt_aufk
      WHERE aufk~erdat IN @is_parameter-r_erdat.

  ELSE.

    SELECT aufk~aufnr, aufk~auart, aufk~erdat, aufk~idat2,
           aufk~vaplz,  aufk~kostl,  aufk~objnr,
           aufk~werks,  aufk~ktext,  aufk~ernam
      FROM aufk
      INNER JOIN @lt_afih AS afih ON afih~aufnr = aufk~aufnr
      INTO TABLE @lt_aufk.

  ENDIF.

  " Post-filter fields with no secondary index
  IF is_parameter-r_idat2 IS NOT INITIAL.
    DELETE lt_aufk WHERE idat2 NOT IN is_parameter-r_idat2.
  ENDIF.
  IF is_parameter-r_vaplz IS NOT INITIAL.
    DELETE lt_aufk WHERE vaplz NOT IN is_parameter-r_vaplz.
  ENDIF.
  IF is_parameter-r_kostl IS NOT INITIAL.
    DELETE lt_aufk WHERE kostl NOT IN is_parameter-r_kostl.
  ENDIF.

  CHECK lt_aufk IS NOT INITIAL.

  "--------------------------------------------------------------------
  " 5. ILOA joined on AFIH
  "    r_tplnr: optional — guarded
  "--------------------------------------------------------------------
  DATA lt_iloa TYPE STANDARD TABLE OF ts_iloa WITH EMPTY KEY.

  IF is_parameter-r_tplnr IS NOT INITIAL.
    SELECT iloa~iloan, iloa~tplnr
      FROM iloa
      INNER JOIN @lt_afih AS afih ON afih~iloan = iloa~iloan
      INTO TABLE @lt_iloa
      WHERE iloa~tplnr IN @is_parameter-r_tplnr.
  ELSE.
    SELECT iloa~iloan, iloa~tplnr
      FROM iloa
      INNER JOIN @lt_afih AS afih ON afih~iloan = iloa~iloan
      INTO TABLE @lt_iloa.
  ENDIF.

  "--------------------------------------------------------------------
  " 6. T001W joined on AUFK — no optional ranges, always needed
  "--------------------------------------------------------------------
  SELECT t001w~werks, t001w~name1
    FROM t001w
    INNER JOIN @lt_aufk AS aufk ON aufk~werks = t001w~werks
    INTO TABLE @DATA(lt_t001w).

  "--------------------------------------------------------------------
  " 7. JCDS — one SELECT; split TECO/REL in ABAP
  "--------------------------------------------------------------------
  SELECT jcds~objnr, jcds~stat, jcds~udate,
         jcds~utime,  jcds~usnam, jcds~inact
    FROM jcds
    INNER JOIN @lt_aufk AS aufk ON aufk~objnr = jcds~objnr
    INTO TABLE @DATA(lt_jcds_all)
    WHERE jcds~inact = @abap_false.

  DATA lt_jcds_teco TYPE STANDARD TABLE OF jcds WITH EMPTY KEY.
  DATA lt_jcds_rel  TYPE STANDARD TABLE OF jcds WITH EMPTY KEY.

  LOOP AT lt_jcds_all INTO DATA(ls_jcds_split).
    CASE ls_jcds_split-stat.
      WHEN 'I0045'. APPEND ls_jcds_split TO lt_jcds_teco.
      WHEN 'I0002'. APPEND ls_jcds_split TO lt_jcds_rel.
    ENDCASE.
  ENDLOOP.

  "--------------------------------------------------------------------
  " 8. TJ02T — status texts (both logon language and English fallback)
  "--------------------------------------------------------------------
  DATA lt_tj02t TYPE STANDARD TABLE OF tj02t WITH EMPTY KEY.

  IF lt_jcds_all IS NOT INITIAL.
    SELECT DISTINCT tj02t~istat, tj02t~spras, tj02t~txt04
      FROM tj02t
      INNER JOIN @lt_jcds_all AS jcds ON jcds~stat = tj02t~istat
      INTO TABLE @lt_tj02t
      WHERE tj02t~spras IN ( @sy-langu, 'E' ).
  ENDIF.

  "--------------------------------------------------------------------
  " 9. AFRU — final confirmations only
  "--------------------------------------------------------------------
  SELECT afru~rueck, afru~rmzhl, afru~budat,
         afru~ernam,  afru~aufnr, afru~aueru, afru~learr
    FROM afru
    INNER JOIN @lt_afih AS afih ON afih~aufnr = afru~aufnr
    INTO TABLE @DATA(lt_afru)
    WHERE afru~aueru  = @abap_true
      AND afru~skostl = ' '.

  "--------------------------------------------------------------------
  " 10. Export all tables
  "--------------------------------------------------------------------
  et_aufk      = lt_aufk.
  et_afih      = lt_afih.
  et_afko      = lt_afko.
  et_afru      = lt_afru.
  et_jcds_rel  = lt_jcds_rel.
  et_jcds_teco = lt_jcds_teco.
  et_iloa      = lt_iloa.
  et_tj02t     = lt_tj02t.
  et_t001w     = lt_t001w.

ENDMETHOD.






METHOD get_data_pmo.

  CLEAR: et_aufk, et_afih, et_afko, et_afru,
         et_jcds, et_mhio, et_mhis, et_jest,
         et_tj02t, et_iloa, gv_missing_auth,
         et_t001w, et_jcds_rel, et_jcds_teco.

  "--------------------------------------------------------------------
  " 1. MHIS — r_warpl and r_nplda both optional but at least one date
  "    is mandatory (VALIDATIONS). Guard each combination.
  "--------------------------------------------------------------------
  DATA lt_mhis TYPE STANDARD TABLE OF ts_mhis WITH EMPTY KEY.

  IF is_parameter-r_warpl IS NOT INITIAL
     AND is_parameter-r_nplda IS NOT INITIAL.

    SELECT warpl, abnum, zaehl, nplda
      FROM mhis
      INTO TABLE @lt_mhis
      WHERE warpl IN @is_parameter-r_warpl
        AND nplda IN @is_parameter-r_nplda.

  ELSEIF is_parameter-r_warpl IS NOT INITIAL.

    SELECT warpl, abnum, zaehl, nplda
      FROM mhis
      INTO TABLE @lt_mhis
      WHERE warpl IN @is_parameter-r_warpl.

  ELSEIF is_parameter-r_nplda IS NOT INITIAL.

    SELECT warpl, abnum, zaehl, nplda
      FROM mhis
      INTO TABLE @lt_mhis
      WHERE nplda IN @is_parameter-r_nplda.

  ENDIF.
  " If both initial, lt_mhis is empty — CHECK below exits cleanly.

  CHECK lt_mhis IS NOT INITIAL.

  "--------------------------------------------------------------------
  " 2. MHIO joined on MHIS — r_aufnr optional, guarded
  "--------------------------------------------------------------------
  DATA lt_mhio TYPE STANDARD TABLE OF ts_mhio WITH EMPTY KEY.

  IF is_parameter-r_aufnr IS NOT INITIAL.

    SELECT mhio~warpl, mhio~abnum, mhio~wppos, mhio~aufnr
      FROM mhio
      INNER JOIN @lt_mhis AS mhis
             ON  mhis~warpl = mhio~warpl
            AND  mhis~abnum = mhio~abnum
      INTO TABLE @lt_mhio
      WHERE mhio~aufnr IN @is_parameter-r_aufnr.

  ELSE.

    SELECT mhio~warpl, mhio~abnum, mhio~wppos, mhio~aufnr
      FROM mhio
      INNER JOIN @lt_mhis AS mhis
             ON  mhis~warpl = mhio~warpl
            AND  mhis~abnum = mhio~abnum
      INTO TABLE @lt_mhio.

  ENDIF.

  CHECK lt_mhio IS NOT INITIAL.

  "--------------------------------------------------------------------
  " 3. AUFK joined on MHIO — r_auart / r_erdat optional, guarded
  "--------------------------------------------------------------------
  DATA lt_aufk TYPE STANDARD TABLE OF ts_aufk WITH EMPTY KEY.

  IF is_parameter-r_auart IS NOT INITIAL
     AND is_parameter-r_erdat IS NOT INITIAL.

    SELECT aufk~aufnr, aufk~auart, aufk~erdat, aufk~idat2,
           aufk~vaplz,  aufk~kostl,  aufk~objnr,
           aufk~werks,  aufk~ktext,  aufk~ernam
      FROM aufk
      INNER JOIN @lt_mhio AS mhio ON mhio~aufnr = aufk~aufnr
      INTO TABLE @lt_aufk
      WHERE aufk~auart IN @is_parameter-r_auart
        AND aufk~erdat IN @is_parameter-r_erdat.

  ELSEIF is_parameter-r_auart IS NOT INITIAL.

    SELECT aufk~aufnr, aufk~auart, aufk~erdat, aufk~idat2,
           aufk~vaplz,  aufk~kostl,  aufk~objnr,
           aufk~werks,  aufk~ktext,  aufk~ernam
      FROM aufk
      INNER JOIN @lt_mhio AS mhio ON mhio~aufnr = aufk~aufnr
      INTO TABLE @lt_aufk
      WHERE aufk~auart IN @is_parameter-r_auart.

  ELSEIF is_parameter-r_erdat IS NOT INITIAL.

    SELECT aufk~aufnr, aufk~auart, aufk~erdat, aufk~idat2,
           aufk~vaplz,  aufk~kostl,  aufk~objnr,
           aufk~werks,  aufk~ktext,  aufk~ernam
      FROM aufk
      INNER JOIN @lt_mhio AS mhio ON mhio~aufnr = aufk~aufnr
      INTO TABLE @lt_aufk
      WHERE aufk~erdat IN @is_parameter-r_erdat.

  ELSE.

    SELECT aufk~aufnr, aufk~auart, aufk~erdat, aufk~idat2,
           aufk~vaplz,  aufk~kostl,  aufk~objnr,
           aufk~werks,  aufk~ktext,  aufk~ernam
      FROM aufk
      INNER JOIN @lt_mhio AS mhio ON mhio~aufnr = aufk~aufnr
      INTO TABLE @lt_aufk.

  ENDIF.

  CHECK lt_aufk IS NOT INITIAL.

  "--------------------------------------------------------------------
  " 4. Authority check — filter AUFK, then re-align MHIO and MHIS
  "--------------------------------------------------------------------
  DATA lt_aufk_auth TYPE STANDARD TABLE OF ts_aufk WITH EMPTY KEY.
  DATA lt_mhio_auth TYPE STANDARD TABLE OF ts_mhio WITH EMPTY KEY.
  DATA lt_mhis_auth TYPE STANDARD TABLE OF ts_mhis WITH EMPTY KEY.

  LOOP AT lt_aufk INTO DATA(ls_aufk_chk).
    AUTHORITY-CHECK OBJECT 'I_IWERK'
      ID 'TCD'   FIELD 'ZIW123'
      ID 'IWERK' FIELD ls_aufk_chk-werks.
    IF sy-subrc = 0.
      APPEND ls_aufk_chk TO lt_aufk_auth.
    ELSE.
      gv_missing_auth = abap_true.
    ENDIF.
  ENDLOOP.

  lt_aufk = lt_aufk_auth.
  CHECK lt_aufk IS NOT INITIAL.

  " Re-align MHIO to authorised orders only
  SORT lt_aufk BY aufnr.
  LOOP AT lt_mhio INTO DATA(ls_mhio_chk).
    READ TABLE lt_aufk WITH KEY aufnr = ls_mhio_chk-aufnr
         BINARY SEARCH TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      APPEND ls_mhio_chk TO lt_mhio_auth.
    ENDIF.
  ENDLOOP.
  lt_mhio = lt_mhio_auth.

  " Re-align MHIS to remaining MHIO entries only
  SORT lt_mhio BY warpl abnum.
  LOOP AT lt_mhis INTO DATA(ls_mhis_chk).
    READ TABLE lt_mhio WITH KEY warpl = ls_mhis_chk-warpl
                                abnum = ls_mhis_chk-abnum
         BINARY SEARCH TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      APPEND ls_mhis_chk TO lt_mhis_auth.
    ENDIF.
  ENDLOOP.
  lt_mhis = lt_mhis_auth.

  "--------------------------------------------------------------------
  " 5. Post-filter fields with no secondary index
  "--------------------------------------------------------------------
  IF is_parameter-r_idat2 IS NOT INITIAL.
    DELETE lt_aufk WHERE idat2 NOT IN is_parameter-r_idat2.
  ENDIF.
  IF is_parameter-r_vaplz IS NOT INITIAL.
    DELETE lt_aufk WHERE vaplz NOT IN is_parameter-r_vaplz.
  ENDIF.
  IF is_parameter-r_kostl IS NOT INITIAL.
    DELETE lt_aufk WHERE kostl NOT IN is_parameter-r_kostl.
  ENDIF.

  CHECK lt_aufk IS NOT INITIAL.

  "--------------------------------------------------------------------
  " 6. T001W — plant descriptions
  "--------------------------------------------------------------------
  SELECT t001w~werks, t001w~name1
    FROM t001w
    INNER JOIN @lt_aufk AS aufk ON aufk~werks = t001w~werks
    INTO TABLE @DATA(lt_t001w).

  "--------------------------------------------------------------------
  " 7. JCDS — all active statuses; split TECO/REL in ABAP
  "--------------------------------------------------------------------
  SELECT jcds~objnr, jcds~stat, jcds~udate,
         jcds~utime,  jcds~usnam, jcds~inact
    FROM jcds
    INNER JOIN @lt_aufk AS aufk ON aufk~objnr = jcds~objnr
    INTO TABLE @DATA(lt_jcds_all)
    WHERE jcds~inact = @abap_false.

  DATA lt_jcds_teco TYPE STANDARD TABLE OF jcds WITH EMPTY KEY.
  DATA lt_jcds_rel  TYPE STANDARD TABLE OF jcds WITH EMPTY KEY.

  LOOP AT lt_jcds_all INTO DATA(ls_jcds_split).
    CASE ls_jcds_split-stat.
      WHEN 'I0045'. APPEND ls_jcds_split TO lt_jcds_teco.
      WHEN 'I0002'. APPEND ls_jcds_split TO lt_jcds_rel.
    ENDCASE.
  ENDLOOP.

  "--------------------------------------------------------------------
  " 8. TJ02T — status texts; DISTINCT avoids duplicates from the JOIN
  "--------------------------------------------------------------------
  DATA lt_tj02t TYPE STANDARD TABLE OF tj02t WITH EMPTY KEY.

  IF lt_jcds_all IS NOT INITIAL.
    SELECT DISTINCT tj02t~istat, tj02t~spras, tj02t~txt04
      FROM tj02t
      INNER JOIN @lt_jcds_all AS jcds ON jcds~stat = tj02t~istat
      INTO TABLE @lt_tj02t
      WHERE tj02t~spras IN ( @sy-langu, 'E' ).
  ENDIF.

  "--------------------------------------------------------------------
  " 9. AFIH joined on AUFK — r_iwerk mandatory, r_ingpr/r_priok guarded
  "--------------------------------------------------------------------
  DATA lt_afih TYPE STANDARD TABLE OF ts_afih WITH EMPTY KEY.

  IF is_parameter-r_ingpr IS NOT INITIAL
     AND is_parameter-r_priok IS NOT INITIAL.

    SELECT afih~aufnr, afih~iwerk, afih~ingpr, afih~priok,
           afih~iloan,  afih~ilart,  afih~addat,
           afih~warpl,  afih~abnum,  afih~wapos, afih~lacd_date
      FROM afih
      INNER JOIN @lt_aufk AS aufk ON aufk~aufnr = afih~aufnr
      INTO TABLE @lt_afih
      WHERE afih~iwerk IN @is_parameter-r_iwerk
        AND afih~ingpr IN @is_parameter-r_ingpr
        AND afih~priok IN @is_parameter-r_priok.

  ELSEIF is_parameter-r_ingpr IS NOT INITIAL.

    SELECT afih~aufnr, afih~iwerk, afih~ingpr, afih~priok,
           afih~iloan,  afih~ilart,  afih~addat,
           afih~warpl,  afih~abnum,  afih~wapos, afih~lacd_date
      FROM afih
      INNER JOIN @lt_aufk AS aufk ON aufk~aufnr = afih~aufnr
      INTO TABLE @lt_afih
      WHERE afih~iwerk IN @is_parameter-r_iwerk
        AND afih~ingpr IN @is_parameter-r_ingpr.

  ELSEIF is_parameter-r_priok IS NOT INITIAL.

    SELECT afih~aufnr, afih~iwerk, afih~ingpr, afih~priok,
           afih~iloan,  afih~ilart,  afih~addat,
           afih~warpl,  afih~abnum,  afih~wapos, afih~lacd_date
      FROM afih
      INNER JOIN @lt_aufk AS aufk ON aufk~aufnr = afih~aufnr
      INTO TABLE @lt_afih
      WHERE afih~iwerk IN @is_parameter-r_iwerk
        AND afih~priok IN @is_parameter-r_priok.

  ELSE.

    SELECT afih~aufnr, afih~iwerk, afih~ingpr, afih~priok,
           afih~iloan,  afih~ilart,  afih~addat,
           afih~warpl,  afih~abnum,  afih~wapos, afih~lacd_date
      FROM afih
      INNER JOIN @lt_aufk AS aufk ON aufk~aufnr = afih~aufnr
      INTO TABLE @lt_afih
      WHERE afih~iwerk IN @is_parameter-r_iwerk.

  ENDIF.

  IF is_parameter-r_ilart IS NOT INITIAL.
    DELETE lt_afih WHERE ilart NOT IN is_parameter-r_ilart.
  ENDIF.

  CHECK lt_afih IS NOT INITIAL.

  "--------------------------------------------------------------------
  " 10. ILOA — r_tplnr optional, guarded
  "--------------------------------------------------------------------
  DATA lt_iloa TYPE STANDARD TABLE OF ts_iloa WITH EMPTY KEY.

  IF is_parameter-r_tplnr IS NOT INITIAL.
    SELECT iloa~iloan, iloa~tplnr
      FROM iloa
      INNER JOIN @lt_afih AS afih ON afih~iloan = iloa~iloan
      INTO TABLE @lt_iloa
      WHERE iloa~tplnr IN @is_parameter-r_tplnr.
  ELSE.
    SELECT iloa~iloan, iloa~tplnr
      FROM iloa
      INNER JOIN @lt_afih AS afih ON afih~iloan = iloa~iloan
      INTO TABLE @lt_iloa.
  ENDIF.

  "--------------------------------------------------------------------
  " 11. AFKO — r_getri / r_gstri optional, guarded
  "--------------------------------------------------------------------
  DATA lt_afko TYPE STANDARD TABLE OF ts_afko WITH EMPTY KEY.

  IF is_parameter-r_getri IS NOT INITIAL
     AND is_parameter-r_gstri IS NOT INITIAL.

    SELECT afko~aufnr, afko~gstri, afko~getri,
           afko~rueck,  afko~rmzhl, afko~gstrs, afko~gltrs
      FROM afko
      INNER JOIN @lt_afih AS afih ON afih~aufnr = afko~aufnr
      INTO TABLE @lt_afko
      WHERE afko~getri IN @is_parameter-r_getri
        AND afko~gstri IN @is_parameter-r_gstri.

  ELSEIF is_parameter-r_getri IS NOT INITIAL.

    SELECT afko~aufnr, afko~gstri, afko~getri,
           afko~rueck,  afko~rmzhl, afko~gstrs, afko~gltrs
      FROM afko
      INNER JOIN @lt_afih AS afih ON afih~aufnr = afko~aufnr
      INTO TABLE @lt_afko
      WHERE afko~getri IN @is_parameter-r_getri.

  ELSEIF is_parameter-r_gstri IS NOT INITIAL.

    SELECT afko~aufnr, afko~gstri, afko~getri,
           afko~rueck,  afko~rmzhl, afko~gstrs, afko~gltrs
      FROM afko
      INNER JOIN @lt_afih AS afih ON afih~aufnr = afko~aufnr
      INTO TABLE @lt_afko
      WHERE afko~gstri IN @is_parameter-r_gstri.

  ELSE.

    SELECT afko~aufnr, afko~gstri, afko~getri,
           afko~rueck,  afko~rmzhl, afko~gstrs, afko~gltrs
      FROM afko
      INNER JOIN @lt_afih AS afih ON afih~aufnr = afko~aufnr
      INTO TABLE @lt_afko.

  ENDIF.

  "--------------------------------------------------------------------
  " 12. AFRU — final confirmations only
  "--------------------------------------------------------------------
  SELECT afru~rueck, afru~rmzhl, afru~budat,
         afru~ernam,  afru~aufnr, afru~aueru, afru~learr
    FROM afru
    INNER JOIN @lt_afih AS afih ON afih~aufnr = afru~aufnr
    INTO TABLE @DATA(lt_afru)
    WHERE afru~aueru  = @abap_true
      AND afru~skostl = ' '.

  "--------------------------------------------------------------------
  " 13. Export
  "--------------------------------------------------------------------
  et_aufk      = lt_aufk.
  et_afih      = lt_afih.
  et_afko      = lt_afko.
  et_afru      = lt_afru.
  et_jcds_rel  = lt_jcds_rel.
  et_jcds_teco = lt_jcds_teco.
  et_mhio      = lt_mhio.
  et_mhis      = lt_mhis.
  et_iloa      = lt_iloa.
  et_tj02t     = lt_tj02t.
  et_t001w     = lt_t001w.

ENDMETHOD.
