METHOD set_auc_status_for_level1_wbs.

  DATA: lv_proj_pspnr TYPE proj-pspnr,   "this is PRPS-PSPHI / PROJ-PSPNR internal
        lv_posid_try  TYPE prps-posid,
        lv_posid_nod  TYPE prps-posid,
        lv_psphi      TYPE prps-psphi.

  DATA: lt_user_stat  TYPE STANDARD TABLE OF bapi_wbs_mnt_user_status,
        ls_user_stat  TYPE bapi_wbs_mnt_user_status,
        lt_result     TYPE STANDARD TABLE OF bapi_status_result,
        ls_result     TYPE bapi_status_result.

  "Level 1 WBS candidates (external POSID) that have IMPRF
  TYPES: BEGIN OF ty_lvl1,
           posid TYPE prps-posid,
           imprf TYPE prps-imprf,
         END OF ty_lvl1.

  DATA: lt_lvl1 TYPE STANDARD TABLE OF ty_lvl1,
        ls_lvl1 TYPE ty_lvl1.

  rv_success = abap_false.

  "Mandatory PS init in your system
  CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

  "------------------------------------------------------------
  "Step 1: Determine Project internal key (PRPS-PSPHI)
  "Same approach as your BLKD: derive PSPHI using any POSID from it_wbs_items
  "------------------------------------------------------------
  CLEAR lv_proj_pspnr.

  LOOP AT it_wbs_items INTO DATA(ls_any).
    IF ls_any-posid IS INITIAL.
      CONTINUE.
    ENDIF.

    "Try exact POSID first
    lv_posid_try = ls_any-posid.

    SELECT SINGLE psphi
      FROM prps
      INTO @lv_psphi
      WHERE posid = @lv_posid_try.

    IF sy-subrc = 0 AND lv_psphi IS NOT INITIAL.
      lv_proj_pspnr = lv_psphi.
      EXIT.
    ENDIF.

    "Try without dots
    lv_posid_nod = ls_any-posid.
    REPLACE ALL OCCURRENCES OF '.' IN lv_posid_nod WITH ''.

    IF lv_posid_nod <> lv_posid_try.
      SELECT SINGLE psphi
        FROM prps
        INTO @lv_psphi
        WHERE posid = @lv_posid_nod.

      IF sy-subrc = 0 AND lv_psphi IS NOT INITIAL.
        lv_proj_pspnr = lv_psphi.
        EXIT.
      ENDIF.
    ENDIF.

    "Last try: conversion exit ABPSN
    CLEAR lv_posid_nod.
    lv_posid_nod = ls_any-posid.

    CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
      EXPORTING
        input  = lv_posid_nod
      IMPORTING
        output = lv_posid_nod
      EXCEPTIONS
        OTHERS = 1.

    IF lv_posid_nod IS NOT INITIAL.
      SELECT SINGLE psphi
        FROM prps
        INTO @lv_psphi
        WHERE posid = @lv_posid_nod.

      IF sy-subrc = 0 AND lv_psphi IS NOT INITIAL.
        lv_proj_pspnr = lv_psphi.
        EXIT.
      ENDIF.
    ENDIF.

  ENDLOOP.

  IF lv_proj_pspnr IS INITIAL.
    "Can't determine project => cannot set AUC
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "Step 2 (FDS): Identify Level 1 WBS with Investment Profile (IMPRF not initial)
  "PRPS-STUFE = 1 under that project
  "------------------------------------------------------------
  CLEAR lt_lvl1.

  SELECT posid, imprf
    FROM prps
    INTO TABLE @lt_lvl1
    WHERE psphi = @lv_proj_pspnr
      AND stufe = 1
      AND imprf <> ''.

  IF lt_lvl1 IS INITIAL.
    "No level 1 wbs with investment profile => nothing to set
    rv_success = abap_true.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "Step 3: Set AUC user status on those Level 1 WBS
  "------------------------------------------------------------
  CLEAR lt_user_stat.

  LOOP AT lt_lvl1 INTO ls_lvl1.
    IF ls_lvl1-posid IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_user_stat.
    ls_user_stat-wbs_element     = ls_lvl1-posid.
    ls_user_stat-set_user_status = 'AUC'.        "must match your status short code in config
    APPEND ls_user_stat TO lt_user_stat.
  ENDLOOP.

  SORT lt_user_stat BY wbs_element.
  DELETE ADJACENT DUPLICATES FROM lt_user_stat COMPARING wbs_element.

  IF lt_user_stat IS INITIAL.
    rv_success = abap_true.
    RETURN.
  ENDIF.

  CLEAR lt_result.

  CALL FUNCTION 'BAPI_BUS2054_SET_STATUS'
    TABLES
      i_wbs_user_status = lt_user_stat
      e_result          = lt_result.

  CALL FUNCTION 'BAPI_PS_PRECOMMIT'.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  "Success rule:
  " - if E_RESULT is empty => success
  " - if E_RESULT has any error/abort => fail
  LOOP AT lt_result INTO ls_result.
    IF ls_result-message_type CA 'AEX'
       OR ls_result-message_id IS NOT INITIAL.
      rv_success = abap_false.
      RETURN.
    ENDIF.
  ENDLOOP.

  rv_success = abap_true.

ENDMETHOD.




METHOD set_rel_status_for_project_wbs.

  DATA: lv_proj_pspnr TYPE proj-pspnr,   "PRPS-PSPHI / PROJ-PSPNR internal
        lv_posid_try  TYPE prps-posid,
        lv_posid_nod  TYPE prps-posid,
        lv_psphi      TYPE prps-psphi.

  "All WBS OBJNRs under project
  TYPES: BEGIN OF ty_objnr,
           objnr TYPE jest-objnr,
         END OF ty_objnr.

  DATA: lt_objnr TYPE STANDARD TABLE OF ty_objnr,
        ls_objnr TYPE ty_objnr.

  rv_success = abap_false.

  "------------------------------------------------------------
  "Step 1: Determine Project internal key (PRPS-PSPHI)
  "Same technique as your BLKD: derive PSPHI using any POSID
  "------------------------------------------------------------
  CLEAR lv_proj_pspnr.

  LOOP AT it_wbs_items INTO DATA(ls_any).
    IF ls_any-posid IS INITIAL.
      CONTINUE.
    ENDIF.

    "Try as-is
    lv_posid_try = ls_any-posid.

    SELECT SINGLE psphi
      FROM prps
      INTO @lv_psphi
      WHERE posid = @lv_posid_try.

    IF sy-subrc = 0 AND lv_psphi IS NOT INITIAL.
      lv_proj_pspnr = lv_psphi.
      EXIT.
    ENDIF.

    "Try without dots
    lv_posid_nod = ls_any-posid.
    REPLACE ALL OCCURRENCES OF '.' IN lv_posid_nod WITH ''.

    IF lv_posid_nod <> lv_posid_try.
      SELECT SINGLE psphi
        FROM prps
        INTO @lv_psphi
        WHERE posid = @lv_posid_nod.

      IF sy-subrc = 0 AND lv_psphi IS NOT INITIAL.
        lv_proj_pspnr = lv_psphi.
        EXIT.
      ENDIF.
    ENDIF.

    "Last try: conversion exit ABPSN
    CLEAR lv_posid_nod.
    lv_posid_nod = ls_any-posid.

    CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
      EXPORTING
        input  = lv_posid_nod
      IMPORTING
        output = lv_posid_nod
      EXCEPTIONS
        OTHERS = 1.

    IF lv_posid_nod IS NOT INITIAL.
      SELECT SINGLE psphi
        FROM prps
        INTO @lv_psphi
        WHERE posid = @lv_posid_nod.

      IF sy-subrc = 0 AND lv_psphi IS NOT INITIAL.
        lv_proj_pspnr = lv_psphi.
        EXIT.
      ENDIF.
    ENDIF.

  ENDLOOP.

  IF lv_proj_pspnr IS INITIAL.
    "Can't determine project => cannot release
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "Step 2: Collect all WBS OBJNR under this project (PSPHI)
  "------------------------------------------------------------
  CLEAR lt_objnr.

  SELECT objnr
    FROM prps
    INTO TABLE @lt_objnr
    WHERE psphi = @lv_proj_pspnr
      AND objnr <> ''.

  IF lt_objnr IS INITIAL.
    "Nothing to release
    rv_success = abap_true.
    RETURN.
  ENDIF.

  SORT lt_objnr BY objnr.
  DELETE ADJACENT DUPLICATES FROM lt_objnr COMPARING objnr.

  "------------------------------------------------------------
  "Step 3: Set system status REL (I0002) using STATUS_CHANGE_INTERN_VB
  "------------------------------------------------------------
  LOOP AT lt_objnr INTO ls_objnr.

    CALL FUNCTION 'STATUS_CHANGE_INTERN_VB'
      EXPORTING
        objnr               = ls_objnr-objnr
        status              = 'I0002'   "REL - Released (system status)
        set_inact           = space
        flg_user_stat       = space     "system status
      EXCEPTIONS
        object_not_found    = 1
        status_inconsistent = 2
        status_not_allowed  = 3
        OTHERS              = 4.

    IF sy-subrc <> 0.
      rv_success = abap_false.
      RETURN.
    ENDIF.

  ENDLOOP.

  "Optional commit to be consistent with your other methods
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  rv_success = abap_true.

ENDMETHOD.