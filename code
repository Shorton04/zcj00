METHODS append_car_template_structure_b1
  IMPORTING
    iv_pspid_car TYPE proj-pspid
    iv_pspid_esr TYPE proj-pspid
    iv_kostl     TYPE csks-kostl
  CHANGING
    ct_wbs_items TYPE STANDARD TABLE.



METHOD append_car_template_structure_b1.

  DATA: lt_car_items TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
        ls_car_item  TYPE ztb_a2r_wbsitem,
        ls_new_item  TYPE ztb_a2r_wbsitem,
        ls_esr_root  TYPE ztb_a2r_wbsitem,
        ls_car_root  TYPE ztb_a2r_wbsitem,
        lv_suffix    TYPE string,
        lv_root_len  TYPE i.

  FIELD-SYMBOLS: <fs_item> TYPE ztb_a2r_wbsitem.

  "------------------------------------------------------------
  " 1) Get CAR template structure into temp table
  "------------------------------------------------------------
  CALL METHOD me->copy_template_structure
    EXPORTING
      iv_pspid     = iv_pspid_car
      iv_kostl     = iv_kostl
    CHANGING
      ct_wbs_items = lt_car_items.

  IF lt_car_items IS INITIAL.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " 2) Determine ESR level 1 root from existing structure
  "------------------------------------------------------------
  READ TABLE ct_wbs_items INTO ls_esr_root WITH KEY stufe = 1.
  IF sy-subrc <> 0 OR ls_esr_root-posid IS INITIAL.
    ls_esr_root-posid = iv_pspid_esr.
  ENDIF.

  "------------------------------------------------------------
  " 3) Determine CAR template root (level 1)
  "------------------------------------------------------------
  READ TABLE lt_car_items INTO ls_car_root WITH KEY stufe = 1.
  IF sy-subrc <> 0 OR ls_car_root-posid IS INITIAL.
    RETURN.
  ENDIF.

  lv_root_len = strlen( ls_car_root-posid ).

  "------------------------------------------------------------
  " 4) Append CAR rows except level 1
  "    Replace CAR root with ESR root
  "------------------------------------------------------------
  LOOP AT lt_car_items INTO ls_car_item.

    "Skip level 1 of CAR template
    IF ls_car_item-stufe = 1.
      CONTINUE.
    ENDIF.

    CLEAR: ls_new_item, lv_suffix.

    ls_new_item = ls_car_item.

    "--------------------------------------------
    "Build new POSID
    "Example:
    " CAR : PC.000001.04.1
    " ESR : PC.000003
    " NEW : PC.000003.04.1
    "--------------------------------------------
    IF ls_car_item-posid IS NOT INITIAL
       AND strlen( ls_car_item-posid ) > lv_root_len
       AND ls_car_item-posid(lv_root_len) = ls_car_root-posid.

      lv_suffix = ls_car_item-posid+lv_root_len.

      IF lv_suffix IS NOT INITIAL AND lv_suffix(1) = '.'.
        SHIFT lv_suffix LEFT BY 1 PLACES.
      ENDIF.

      IF lv_suffix IS INITIAL.
        ls_new_item-posid = ls_esr_root-posid.
      ELSE.
        CONCATENATE ls_esr_root-posid lv_suffix
          INTO ls_new_item-posid
          SEPARATED BY '.'.
      ENDIF.

    ELSE.
      "Fallback
      ls_new_item-posid = ls_car_item-posid.
    ENDIF.

    "New CAR rows inherit screen/header cost center
    ls_new_item-kostl = iv_kostl.

    "Keep template attributes
    "stufe / post1 / imprf / vkokr / prart / bukrs already copied

    APPEND ls_new_item TO ct_wbs_items.

  ENDLOOP.

ENDMETHOD.