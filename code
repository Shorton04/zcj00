MODULE status_dropdown OUTPUT.

  DATA: lt_values TYPE vrm_values,
        ls_value  TYPE vrm_value.

  CLEAR lt_values.

  ls_value-key  = 'REL'.
  ls_value-text = 'REL'.
  APPEND ls_value TO lt_values.

  ls_value-key  = 'TECO'.
  ls_value-text = 'TECO'.
  APPEND ls_value TO lt_values.

  CALL FUNCTION 'VRM_SET_VALUES'
    EXPORTING
      id     = 'GT_WBS_UNCLOSE-TO_BE'
      values = lt_values.

ENDMODULE.