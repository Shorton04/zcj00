METHOD set_blkd_status_for_higher_wbs.

  DATA: lv_proj_pspnr TYPE proj-pspnr, "this is PROJ-PSPNR / PRPS-PSPHI
        lv_posid_try  TYPE prps-posid,
        lv_posid_nod  TYPE prps-posid,
        lv_psphi      TYPE prps-psphi.

  DATA: lt_user_stat  TYPE STANDARD TABLE OF bapi_wbs_mnt_user_status,
        ls_user_stat  TYPE bapi_wbs_mnt_user_status,
        lt_result     TYPE STANDARD TABLE OF bapi_status_result,
        ls_result     TYPE bapi_status_result.

  "For FDS step: PRHI-UP must be resolved to external POSID via PRPS
  TYPES: BEGIN OF ty_up_posid,
           up    TYPE prhi-up,
           posid TYPE prps-posid,
         END OF ty_up_posid.

  DATA: lt_up_posid TYPE STANDARD TABLE OF ty_up_posid,
        ls_up_posid TYPE ty_up_posid.

  rv_success = abap_false.

  "Mandatory PS init in your system
  CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

  "------------------------------------------------------------
  "FDS Step 1: Determine PROJ-PSPNR (same as PRPS-PSPHI)
  "We do NOT rely on PSPID in it_wbs_items (yours is blank).
  "Instead: take any POSID from it_wbs_items -> PRPS-PSPHI.
  "------------------------------------------------------------
  CLEAR lv_proj_pspnr.

  LOOP AT it_wbs_items INTO DATA(ls_any).
    IF ls_any-posid IS INITIAL.
      CONTINUE.
    ENDIF.

    "Try exact as-is first (some systems store dotted)
    lv_posid_try = ls_any-posid.

    SELECT SINGLE psphi
      FROM prps
      INTO @lv_psphi
      WHERE posid = @lv_posid_try.

    IF sy-subrc = 0 AND lv_psphi IS NOT INITIAL.
      lv_proj_pspnr = lv_psphi.
      EXIT.
    ENDIF.

    "Try without dots (some of your tables show PC00014301 etc.)
    lv_posid_nod = ls_any-posid.
    REPLACE ALL OCCURRENCES OF '.' IN lv_posid_nod WITH ''.

    IF lv_posid_nod <> lv_posid_try.
      SELECT SINGLE psphi
        FROM prps
        INTO @lv_psphi
        WHERE posid = @lv_posid_nod.

      IF sy-subrc = 0 AND lv_psphi IS NOT INITIAL.
        lv_proj_pspnr = lv_psphi.
        EXIT.
      ENDIF.
    ENDIF.

    "Last try: apply conversion exit for WBS element (ABPSN)
    "This matches your SE37 test: PC.000114 -> PC000114
    CLEAR lv_posid_nod.
    lv_posid_nod = ls_any-posid.

    CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
      EXPORTING
        input  = lv_posid_nod
      IMPORTING
        output = lv_posid_nod
      EXCEPTIONS
        OTHERS = 1.

    IF lv_posid_nod IS NOT INITIAL.
      SELECT SINGLE psphi
        FROM prps
        INTO @lv_psphi
        WHERE posid = @lv_posid_nod.

      IF sy-subrc = 0 AND lv_psphi IS NOT INITIAL.
        lv_proj_pspnr = lv_psphi.
        EXIT.
      ENDIF.
    ENDIF.

  ENDLOOP.

  IF lv_proj_pspnr IS INITIAL.
    "Can't determine project -> nothing to set
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "FDS Step 1 continued:
  "Get higher level WBS: PRHI-UP where PRHI-PSPHI = PROJ-PSPNR
  "
  "IMPORTANT:
  "PRHI-UP is INTERNAL key -> must be resolved to external POSID
  "by joining PRHI-UP = PRPS-PSPNR and taking PRPS-POSID.
  "------------------------------------------------------------
  SELECT prhi~up,
         prps~posid
    FROM prhi
    INNER JOIN prps
      ON prps~pspnr = prhi~up
    INTO TABLE @lt_up_posid
    WHERE prhi~psphi = @lv_proj_pspnr
      AND prhi~up    <> '00000000'.  "avoid top node UP=0

  IF lt_up_posid IS INITIAL.
    "No higher nodes -> treat as ok (nothing to block)
    rv_success = abap_true.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "FDS Step 2: Set BLKD for WBS_ELEMENT = PRHI-UP (external -> PRPS-POSID)
  "------------------------------------------------------------
  CLEAR lt_user_stat.

  LOOP AT lt_up_posid INTO ls_up_posid.
    IF ls_up_posid-posid IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_user_stat.
    ls_user_stat-wbs_element     = ls_up_posid-posid.
    ls_user_stat-set_user_status = 'BLKD'.
    APPEND ls_user_stat TO lt_user_stat.
  ENDLOOP.

  SORT lt_user_stat BY wbs_element.
  DELETE ADJACENT DUPLICATES FROM lt_user_stat COMPARING wbs_element.

  IF lt_user_stat IS INITIAL.
    rv_success = abap_true.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "Execute status set
  "NOTE: In success case, E_RESULT is often EMPTY.
  "Do NOT rely on SY-SUBRC after the BAPI call.
  "------------------------------------------------------------
  CLEAR lt_result.

  CALL FUNCTION 'BAPI_BUS2054_SET_STATUS'
    TABLES
      i_wbs_user_status = lt_user_stat
      e_result          = lt_result.

  CALL FUNCTION 'BAPI_PS_PRECOMMIT'.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  "Success rule:
  " - if E_RESULT is empty => success
  " - if E_RESULT has any error/abort => fail
  LOOP AT lt_result INTO ls_result.
    "Some systems fill MESSAGE_TYPE; others fill MESSAGE_ID/NUMBER
    IF ls_result-message_type CA 'AEX'
       OR ls_result-message_id IS NOT INITIAL.
      rv_success = abap_false.
      RETURN.
    ENDIF.
  ENDLOOP.

  rv_success = abap_true.

ENDMETHOD.