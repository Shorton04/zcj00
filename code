FORM sync_screen_to_header.

  " Push shadow (user-edited) values into gs_header before save
  IF gv_u_post1 = abap_true.
    gs_header-post1 = gs_header_user-post1.
  ENDIF.

  IF gv_u_vernr = abap_true.
    gs_header-vernr = gs_header_user-vernr.
  ENDIF.

  IF gv_u_plsez = abap_true.
    gs_header-plsez = gs_header_user-plsez.
  ENDIF.

  IF gv_u_prctr = abap_true.
    gs_header-prctr = gs_header_user-prctr.
  ENDIF.

  IF gv_u_kostl = abap_true.
    gs_header-kostl = gs_header_user-kostl.
  ENDIF.

  " Sync gv_im_posid_display back to gs_header-posnr
  " Convert display value back to internal POSNR before saving
  IF gv_u_im_posid = abap_true AND gv_im_posid_user IS NOT INITIAL.
    DATA: lv_posnr TYPE im_posnr.

    " Try to find POSNR by POSID (user may have typed external format)
    SELECT posnr FROM impr
      INTO lv_posnr
      WHERE posid = gv_im_posid_user
      ORDER BY gjahr.
    ENDSELECT.


    IF sy-subrc = 0.
      gs_header-posnr = lv_posnr.
    ELSE.
      " Try with ALPHA conversion (user typed numeric)
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = gv_im_posid_user
        IMPORTING
          output = lv_posnr.

      SELECT SINGLE posnr FROM impr
        INTO @DATA(lv_check)
        WHERE posnr = @lv_posnr.

      IF sy-subrc = 0.
        gs_header-posnr = lv_posnr.
      ENDIF.
    ENDIF.
  ENDIF.

ENDFORM.
