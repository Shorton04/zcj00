"═══════════════════════════════════════════════════════════════════
" STEP XX: RELEASE PROJECT (CJ02 BDC)
" Based on SHDB: ZCJ02_REL
" 0100: =MDTB + *PROJ-PSPID
" 0998: =STFR (Release)
" 0998: =BU   (Save)
"═══════════════════════════════════════════════════════════════════

DATA: lt_bdc_rel TYPE STANDARD TABLE OF bdcdata,
      lt_msg_rel TYPE STANDARD TABLE OF bdcmsgcoll,
      ls_msg_rel TYPE bdcmsgcoll.

DATA: lv_pspid        TYPE proj-pspid,
      lv_pspid_c      TYPE fnam_____4,
      lv_rel_error    TYPE abap_bool.

CLEAR: lt_bdc_rel, lt_msg_rel, lv_rel_error.

"<<< set your created project definition id here
lv_pspid   = is_header-pspid.    "or lv_created_pspid / ls_proj-pspid etc.
lv_pspid_c = lv_pspid.

"------------------------------------------------------------
" SAPLCJWB 0100  (enter project)
"------------------------------------------------------------
bdc_dynpro( EXPORTING iv_program = 'SAPLCJWB'
                      iv_dynpro  = '0100'
            CHANGING  ct_bdcdata = lt_bdc_rel ).

bdc_field( EXPORTING iv_fnam = 'BDC_CURSOR'
                     iv_fval = '*PROJ-PSPID'
           CHANGING  ct_bdcdata = lt_bdc_rel ).

bdc_field( EXPORTING iv_fnam = 'BDC_OKCODE'
                     iv_fval = '=MDTB'
           CHANGING  ct_bdcdata = lt_bdc_rel ).

bdc_field( EXPORTING iv_fnam = '*PROJ-PSPID'
                     iv_fval = lv_pspid_c
           CHANGING  ct_bdcdata = lt_bdc_rel ).

"------------------------------------------------------------
" SAPLCJWB 0998 (Release)
"------------------------------------------------------------
bdc_dynpro( EXPORTING iv_program = 'SAPLCJWB'
                      iv_dynpro  = '0998'
            CHANGING  ct_bdcdata = lt_bdc_rel ).

bdc_field( EXPORTING iv_fnam = 'BDC_CURSOR'
                     iv_fval = 'PROJ-PSPID'
           CHANGING  ct_bdcdata = lt_bdc_rel ).

"Subscreens from SHDB
bdc_field( EXPORTING iv_fnam = 'BDC_SUBSCR'
                     iv_fval = 'SAPLCJWB                                1205SUBSCR2'
           CHANGING  ct_bdcdata = lt_bdc_rel ).

bdc_field( EXPORTING iv_fnam = 'BDC_SUBSCR'
                     iv_fval = 'SAPLCJWB                                0700STATUS'
           CHANGING  ct_bdcdata = lt_bdc_rel ).

"<<< RELEASE OKCODE from your SHDB
bdc_field( EXPORTING iv_fnam = 'BDC_OKCODE'
                     iv_fval = '=STFR'
           CHANGING  ct_bdcdata = lt_bdc_rel ).

"------------------------------------------------------------
" SAPLCJWB 0998 (Save)
"------------------------------------------------------------
bdc_dynpro( EXPORTING iv_program = 'SAPLCJWB'
                      iv_dynpro  = '0998'
            CHANGING  ct_bdcdata = lt_bdc_rel ).

bdc_field( EXPORTING iv_fnam = 'BDC_CURSOR'
                     iv_fval = 'PROJ-PSPID'
           CHANGING  ct_bdcdata = lt_bdc_rel ).

bdc_field( EXPORTING iv_fnam = 'BDC_SUBSCR'
                     iv_fval = 'SAPLCJWB                                1205SUBSCR2'
           CHANGING  ct_bdcdata = lt_bdc_rel ).

bdc_field( EXPORTING iv_fnam = 'BDC_SUBSCR'
                     iv_fval = 'SAPLCJWB                                0700STATUS'
           CHANGING  ct_bdcdata = lt_bdc_rel ).

bdc_field( EXPORTING iv_fnam = 'BDC_OKCODE'
                     iv_fval = '=BU'
           CHANGING  ct_bdcdata = lt_bdc_rel ).

"------------------------------------------------------------
" Execute CJ02
"------------------------------------------------------------
CALL TRANSACTION 'CJ02'
  USING lt_bdc_rel
  MODE  lv_mode
  UPDATE lv_update
  MESSAGES INTO lt_msg_rel.

lv_rel_error = abap_false.
LOOP AT lt_msg_rel INTO ls_msg_rel WHERE msgtyp CA 'AEX'.
  lv_rel_error = abap_true.
  EXIT.
ENDLOOP.

IF lv_rel_error = abap_true.
  MESSAGE e398(00) WITH 'CJ02 RELEASE failed for PSPID' lv_pspid.
ELSE.
  COMMIT WORK AND WAIT.
  WAIT UP TO 2 SECONDS.
ENDIF.