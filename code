MODULE build_im_dropdown OUTPUT.

  DATA: ls_value TYPE vrm_value,
        lt_impr  TYPE STANDARD TABLE OF ty_impr,
        ls_impr  TYPE ty_impr,
        lt_parts TYPE STANDARD TABLE OF string,
        lv_dummy TYPE string,
        lv_pr01  TYPE string.

  CHECK gt_im_dropdown IS INITIAL.

  " Get IM positions that have config entries
  SELECT
    i~posnr AS posnr,
    i~gjahr AS gjahr,
    i~posid AS posid,
    i~prnam AS prnam,
    i~izwek AS izwek
    FROM impr AS i
    INNER JOIN ztb_a2r_conftab1 AS c
      ON c~izwek = i~izwek
      INTO TABLE @lt_impr
  ORDER BY i~posid DESCENDING.
  IF sy-subrc EQ 0.
    LOOP AT lt_impr INTO ls_impr.
      CLEAR ls_value.
      " Internal value (hidden)
      ls_value-key = ls_impr-posnr.

      SPLIT ls_impr-prnam AT space INTO TABLE lt_parts.
      READ TABLE lt_parts INDEX lines( lt_parts ) INTO ls_value-text.

      APPEND ls_value TO gt_im_dropdown.
    ENDLOOP.


    CALL FUNCTION 'VRM_SET_VALUES'
      EXPORTING
        id              = 'P_POSNR'
        values          = gt_im_dropdown
      EXCEPTIONS
        id_illegal_name = 1
        OTHERS          = 2.
    IF sy-subrc <> 0.
      CLEAR gt_im_dropdown.
    ENDIF.
  ENDIF.
ENDMODULE.
