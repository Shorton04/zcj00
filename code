* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_MVI0123->ZIF_A2D_VIEW_ALV~HANDLE_HOTSPOT_CLICK
* +-------------------------------------------------------------------------------------------------+
* | [--->] IO_CONTROLLER                  TYPE REF TO ZIF_A2D_CONTROLLER
* | [--->] IO_PROGRESS                    TYPE REF TO ZIF_A2D_PROGRESS
* | [--->] IV_COLUMN_NAME                 TYPE        STRING
* | [--->] IV_VALUE                       TYPE        DATA
* | [--->] IS_RESULT                      TYPE        DATA
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD zif_a2d_view_alv~handle_hotspot_click.
    DATA:ls_result TYPE ts_result.
    ls_result = is_result.

    IF iv_column_name = 'AUFNR_WO'    AND ls_result-aufnr_wo
                                              IS NOT INITIAL.
      SET PARAMETER ID: 'ANR' FIELD ls_result-aufnr_wo.
      CALL TRANSACTION 'IW33' AND SKIP FIRST SCREEN.
    ENDIF.

    IF iv_column_name = 'TPLNR'    AND ls_result-tplnr
                                             IS NOT INITIAL.
      SET PARAMETER ID: 'IFL' FIELD ls_result-tplnr.
      CALL TRANSACTION 'IL03' AND SKIP FIRST SCREEN.
    ENDIF.

    IF iv_column_name = 'WARPL'    AND ls_result-warpl
                                            IS NOT INITIAL.
      SET PARAMETER ID: 'MPL' FIELD ls_result-warpl.
      CALL TRANSACTION 'IP03' AND SKIP FIRST SCREEN.
    ENDIF.
  ENDMETHOD.


