MODULE status_0100 OUTPUT.
  SET PF-STATUS 'STATUS_100'.
  SET TITLEBAR 'TITLE_100' ##TITL_UNDEF.

  " Gray out all header information fields (read-only in Screen 2)
  LOOP AT SCREEN.

    " Make all header fields non-editable
    IF screen-name = 'P_POST1'
    OR screen-name = 'P_VERNA'
    OR screen-name = 'P_PLSEZ'
    OR screen-name = 'P_PRNAM'
    "OR screen-name = 'GV_IM_POSID_DISPLAY'
    OR screen-name = 'GV_AVAILABLE_BUDGET'
    OR screen-name = 'GV_AVAIL_BUDGET_TEXT'
    OR screen-name = 'GV_BUKRS'
    OR screen-name = 'GV_WERKS'
    OR screen-name = 'GV_PROJECT_CURRENCY'
    OR screen-name = 'P_PRCTR'
    OR screen-name = 'GV_IZWEK'
    OR screen-name = 'P_USR10_C'
    OR screen-name = 'GV_USR008'
    OR screen-name = 'GV_REQUESTOR_DISPLAY'
    OR screen-name = 'GS_HEADER-REQUEST_STATUS'
    OR screen-name = 'GV_REQTYPE_DISPLAY'.

      screen-input = 0.           " Disable input
      screen-intensified = 0.     " Gray out appearance
      MODIFY SCREEN.
    ENDIF.

  ENDLOOP.

ENDMODULE.
