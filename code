* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2D_REVENUE_RECOG_CONSMAT->ZIF_A2D_VIEW_ALV~HANDLE_HOTSPOT_CLICK
* +-------------------------------------------------------------------------------------------------+
* | [--->] IO_CONTROLLER                  TYPE REF TO ZIF_A2D_CONTROLLER
* | [--->] IO_PROGRESS                    TYPE REF TO ZIF_A2D_PROGRESS
* | [--->] IV_COLUMN_NAME                 TYPE        STRING
* | [--->] IV_VALUE                       TYPE        DATA
* | [--->] IS_RESULT                      TYPE        DATA
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD zif_a2d_view_alv~handle_hotspot_click.

    DATA:ls_result     TYPE ts_result,
         lv_pspnr_proj TYPE ps_intnr,
         lv_pspnr_prps TYPE ps_posnr.

    ls_result = is_result.

    CHECK NOT iv_value IS INITIAL.

    CASE iv_column_name.
      WHEN 'PSPNR_PRJ'.
        lv_pspnr_proj = iv_value.
        SET PARAMETER ID 'PSP' FIELD lv_pspnr_proj.
        SET PARAMETER ID 'PRO' FIELD space.
        CALL TRANSACTION 'CJ20N' AND SKIP FIRST SCREEN.
      WHEN 'PSPNR_WBS' OR 'PSPNR_NEW'.
        lv_pspnr_prps = iv_value.
        SET PARAMETER ID 'PSP' FIELD space.
        SET PARAMETER ID 'PRO' FIELD lv_pspnr_prps.
        CALL TRANSACTION 'CJ20N' AND SKIP FIRST SCREEN.
      WHEN 'AUFNR'.
        SET PARAMETER ID 'BR1' FIELD iv_value.
        CALL TRANSACTION 'COR3' AND SKIP FIRST SCREEN.
      WHEN 'MATNR_PRD'.
        SET PARAMETER ID 'MAT' FIELD iv_value.
        CALL TRANSACTION 'MM03' AND SKIP FIRST SCREEN.
      WHEN 'MBLNR'.
        SET PARAMETER ID 'MBN' FIELD iv_value.
        SET PARAMETER ID 'MJA' FIELD ls_result-mjahr.
        CALL TRANSACTION 'MB03' AND SKIP FIRST SCREEN.
      WHEN OTHERS.
        CALL METHOD super->zif_a2d_view_alv~handle_hotspot_click
          EXPORTING
            io_controller  = io_controller
            io_progress    = io_progress
            iv_column_name = iv_column_name
            iv_value       = iv_value
            is_result      = is_result.
    ENDCASE.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2D_REVENUE_RECOG_CONSMAT->ZIF_A2D_VIEW_REPORT~GET_REPORT_ATTRIBUTE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IO_CONTROLLER                  TYPE REF TO ZIF_A2D_CONTROLLER
* | [--->] IO_PROGRESS                    TYPE REF TO ZIF_A2D_PROGRESS
* | [--->] IS_PARAMETER                   TYPE        ANY
* | [--->] IV_SCREEN_TYPE                 TYPE        ZIF_A2D_VIEW_REPORT=>TV_SCREEN_TYPE
* | [<-->] CV_REPORT_TITLE                TYPE        STRING
* | [<-->] CV_DESCRIPTION                 TYPE        STRING
* | [<-->] CV_DEFAULT_MAX_HITS            TYPE        ZIF_A2D_VIEW_REPORT=>TV_DEFAULT_MAX_HITS
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD zif_a2d_view_report~get_report_attribute.

    DATA lv_title TYPE string.

    FIELD-SYMBOLS <fs_parameter> TYPE ts_parameter.

    ASSIGN is_parameter TO <fs_parameter>.

    CASE iv_screen_type.
      WHEN 1.
        cv_report_title = text-001.
      WHEN 2.
        CASE abap_true.
          WHEN <fs_parameter>-p_rb1.
            lv_title = text-001.
          WHEN <fs_parameter>-p_rb2.
            CONCATENATE text-001 text-010 INTO lv_title SEPARATED BY ' - '.
          WHEN <fs_parameter>-p_rb3.
            CONCATENATE text-001 text-009 INTO lv_title SEPARATED BY ' - '.
        ENDCASE.
        cv_report_title = lv_title.
    ENDCASE.
    cv_description  = text-002.

  ENDMETHOD.
ENDCLASS.
