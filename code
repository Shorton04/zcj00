FORM map_unclose_status_to_items.

  DATA: ls_unclose TYPE ty_wbs_unclose,
        lv_posid   TYPE ps_posid.

  FIELD-SYMBOLS: <fs_item> TYPE ztb_a2r_wbsitem.

  IF gt_wbs_unclose IS INITIAL
     OR gt_wbs_items   IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT gt_wbs_unclose INTO ls_unclose
       WHERE to_be IS NOT INITIAL.

    lv_posid = ls_unclose-wbs_element_code.
    REPLACE ALL OCCURRENCES OF '.' IN lv_posid WITH ''.

    READ TABLE gt_wbs_items ASSIGNING <fs_item>
      WITH KEY posid = lv_posid.

    IF sy-subrc = 0.
      <fs_item>-zstat_tobe = ls_unclose-to_be.
    ENDIF.

  ENDLOOP.

ENDFORM.