FORM check_b3_header_changed CHANGING cv_changed TYPE abap_bool.

  cv_changed = abap_false.

  IF gs_header-post1 <> gs_header_old-post1
  OR gs_header-vernr <> gs_header_old-vernr
  OR gs_header-plsez <> gs_header_old-plsez
  OR gs_header-posnr <> gs_header_old-posnr
  OR gs_header-prnam <> gs_header_old-prnam
  OR gs_header-bukrs <> gs_header_old-bukrs
  OR gs_header-werks <> gs_header_old-werks
  OR gs_header-prctr <> gs_header_old-prctr
  OR gs_header-izwek <> gs_header_old-izwek.
    cv_changed = abap_true.
  ENDIF.

ENDFORM.