        del   TYPE flag,
      END OF ts_mhio.

    TYPES:
      BEGIN OF ts_mhis,
        warpl TYPE mhis-warpl,
        abnum TYPE mhis-abnum,
        zaehl TYPE mhis-zaehl,
        nplda TYPE mhis-nplda,
