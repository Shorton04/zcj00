        priok            TYPE afih-priok,
        gstrs            TYPE afko-gstrs,
        gltrs            TYPE afko-gltrs,
        gstri            TYPE afko-gstri,
        getri            TYPE afko-getri,
        udate            TYPE jcds-udate,
        usnam            TYPE jcds-usnam,
        budat            TYPE afru-budat,
        ernam            TYPE afru-ernam,
        addat            TYPE afih-addat,
        idat2            TYPE aufk-idat2,
        usnam_rel_by     TYPE jcds-usnam,
        ingpr            TYPE afih-ingpr,
        ilart            TYPE afih-ilart,
        vaplz            TYPE aufk-vaplz,
        kostl_wo         TYPE aufk-kostl,
        tplnr            TYPE iloa-tplnr,
        nplda            TYPE mhis-nplda,
        warpl            TYPE mhio-warpl,
        abnum            TYPE mhis-abnum,
        zaehl            TYPE mhis-zaehl,
