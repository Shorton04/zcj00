"═══════════════════════════════════════════════════════════════════
" STEP XX: RELEASE PROJECT (CJ02 BDC)
" - Releases Project Definition (System Status REL)
" - Uses CJ02 -> Project Definition -> Status Subscreen
"═══════════════════════════════════════════════════════════════════

DATA: lt_bdc_rel TYPE STANDARD TABLE OF bdcdata,
      lt_msg_rel TYPE STANDARD TABLE OF bdcmsgcoll,
      ls_msg_rel TYPE bdcmsgcoll.

DATA: lv_proj_pspid      TYPE proj-pspid,
      lv_proj_pspid_c    TYPE fnam_____4, "same type you used for POSID char passing
      lv_rel_error        TYPE abap_bool.

CLEAR: lt_bdc_rel, lt_msg_rel, lv_rel_error.

"Project definition ID (PSPID) you want to release
"Use the created project's PSPID (example: is_header-pspid or returned project)
lv_proj_pspid   = is_header-pspid. "<<< adjust to your variable
lv_proj_pspid_c = lv_proj_pspid.

"------------------------------------------------------------
" CJ02 initial: enter PSPID then go in
"------------------------------------------------------------
bdc_dynpro( EXPORTING iv_program = 'SAPLCJWB'
                      iv_dynpro  = '0100'
            CHANGING  ct_bdcdata = lt_bdc_rel ).
bdc_field(  EXPORTING iv_fnam = 'BDC_CURSOR'  iv_fval = '*PROJ-PSPID'
            CHANGING  ct_bdcdata = lt_bdc_rel ).
bdc_field(  EXPORTING iv_fnam = 'BDC_OKCODE'  iv_fval = '=LETB'
            CHANGING  ct_bdcdata = lt_bdc_rel ).
bdc_field(  EXPORTING iv_fnam = '*PROJ-PSPID' iv_fval = lv_proj_pspid_c
            CHANGING  ct_bdcdata = lt_bdc_rel ).

"------------------------------------------------------------
" Go to Status area (matches your SHDB: SAPLCJWB 0998 with 0700STATUS)
" Some systems land on 0901 first; we drive it to 0998 by forcing subscreen.
"------------------------------------------------------------
bdc_dynpro( EXPORTING iv_program = 'SAPLCJWB'
                      iv_dynpro  = '0998'
            CHANGING  ct_bdcdata = lt_bdc_rel ).

"Important: the Status subscreen you recorded
bdc_field(  EXPORTING iv_fnam = 'BDC_SUBSCR'
                     iv_fval = 'SAPLCJWB                                0700STATUS'
            CHANGING  ct_bdcdata = lt_bdc_rel ).

bdc_field(  EXPORTING iv_fnam = 'BDC_CURSOR'
                     iv_fval = 'PROJ-PSPID'
            CHANGING  ct_bdcdata = lt_bdc_rel ).

"------------------------------------------------------------
" Trigger RELEASE
"   >>> Replace =REL with the exact OKCODE from your SHDB if different
"------------------------------------------------------------
bdc_field(  EXPORTING iv_fnam = 'BDC_OKCODE'
                     iv_fval = '=REL'
            CHANGING  ct_bdcdata = lt_bdc_rel ).

"------------------------------------------------------------
" Optional: confirm popup (some systems ask "Release? Yes/No")
"------------------------------------------------------------
bdc_dynpro( EXPORTING iv_program = 'SAPLSPO1'
                      iv_dynpro  = '0100'
            CHANGING  ct_bdcdata = lt_bdc_rel ).
bdc_field(  EXPORTING iv_fnam = 'BDC_OKCODE'
                     iv_fval = '=YES'
            CHANGING  ct_bdcdata = lt_bdc_rel ).

"------------------------------------------------------------
" Save (like your SHDB uses =BU)
"------------------------------------------------------------
bdc_dynpro( EXPORTING iv_program = 'SAPLCJWB'
                      iv_dynpro  = '0998'
            CHANGING  ct_bdcdata = lt_bdc_rel ).
bdc_field(  EXPORTING iv_fnam = 'BDC_SUBSCR'
                     iv_fval = 'SAPLCJWB                                0700STATUS'
            CHANGING  ct_bdcdata = lt_bdc_rel ).
bdc_field(  EXPORTING iv_fnam = 'BDC_OKCODE'
                     iv_fval = '=BU'
            CHANGING  ct_bdcdata = lt_bdc_rel ).

"------------------------------------------------------------
" Execute
"------------------------------------------------------------
CALL TRANSACTION 'CJ02'
  USING lt_bdc_rel
  MODE  lv_mode
  UPDATE lv_update
  MESSAGES INTO lt_msg_rel.

lv_rel_error = abap_false.
LOOP AT lt_msg_rel INTO ls_msg_rel WHERE msgtyp CA 'AEX'.
  lv_rel_error = abap_true.
  EXIT.
ENDLOOP.

IF lv_rel_error = abap_true.
  MESSAGE e398(00) WITH 'CJ02 Project release failed for PSPID' lv_proj_pspid.
ELSE.
  COMMIT WORK AND WAIT.
  WAIT UP TO 2 SECONDS.
ENDIF.