  DATA lv_ok TYPE sy-ucomm.
  lv_ok = sy-ucomm.
  CLEAR sy-ucomm.

  CASE lv_ok.

    WHEN 'SUBM'.

      "Run B3 submit flow ONLY when request type is B3
      IF gv_request_type = 'B3'.

        ">>> your B3 submit logic here
        "PERFORM get_changed_wbs_rows ...
        "PERFORM validate_b3_only_changed ...
        "PERFORM save_request_b3 ...
        "PERFORM trigger_workflow_b3 ...
