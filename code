FORM load_tree_hierarchy.

  TYPES: BEGIN OF ty_prhis,
           pspnr TYPE ps_pspnr,
           psphi TYPE ps_pspnr,
           up    TYPE ps_pspnr,
           down  TYPE ps_pspnr,
           left  TYPE ps_pspnr,
           right TYPE ps_pspnr,
         END OF ty_prhis.

  TYPES: BEGIN OF ty_prpss,
           pspnr TYPE ps_pspnr,
           psphi TYPE ps_pspnr,
           stufe TYPE ps_stufe,
           posid TYPE ps_posid,
           post1 TYPE ps_post1,
         END OF ty_prpss.

  TYPES: BEGIN OF ty_node_map,
           pspnr    TYPE ps_pspnr,
           node_key TYPE lvc_nkey,
         END OF ty_node_map.

  DATA:
    lv_pspnr_templ TYPE ps_pspnr,
    lv_root_pspnr  TYPE ps_pspnr,
    lv_parent_key  TYPE lvc_nkey,
    lv_last_key    TYPE lvc_nkey VALUE 0,
    lv_posid_disp  TYPE ps_posid,

    lt_prhis       TYPE STANDARD TABLE OF ty_prhis,
    lt_prhis_h     TYPE HASHED TABLE OF ty_prhis WITH UNIQUE KEY pspnr,
    lt_prpss       TYPE STANDARD TABLE OF ty_prpss,
    lt_prpss_h     TYPE HASHED TABLE OF ty_prpss WITH UNIQUE KEY pspnr,

    lt_has_child   TYPE HASHED TABLE OF ps_pspnr WITH UNIQUE KEY table_line,
    lt_stack       TYPE STANDARD TABLE OF ps_pspnr,
    lv_node        TYPE ps_pspnr,

    lt_node_map    TYPE STANDARD TABLE OF ty_node_map,
    ls_node_map    TYPE ty_node_map,

    ls_node        TYPE treev_node,
    ls_item        TYPE cnpb_h_treeitm.

  FIELD-SYMBOLS:
    <fs_prhis> TYPE ty_prhis,
    <fs_prpss> TYPE ty_prpss.

  CHECK p_pspid IS NOT INITIAL.
  CHECK lo_tree_preview IS NOT INITIAL.

  TRY.
      CLEAR: gt_treev_node, gt_treeitm, lt_node_map.

      "------------------------------------------------------------
      " 1) Get template project internal number (PROJS-PSPNR)
      "------------------------------------------------------------
      SELECT SINGLE pspid, post1, pspnr
        FROM projs
        INTO @DATA(ls_projs)
        WHERE pspid = @p_pspid.

      IF sy-subrc <> 0.
        CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
          EXPORTING input  = p_pspid
          IMPORTING output = p_pspid.

        SELECT SINGLE pspid, post1, pspnr
          FROM projs
          INTO @ls_projs
          WHERE pspid = @p_pspid.

        IF sy-subrc <> 0.
          MESSAGE 'Template project not found in PROJS table'(m01) TYPE 'S' DISPLAY LIKE 'W'.
          RETURN.
        ENDIF.
      ENDIF.

      lv_pspnr_templ = ls_projs-pspnr.

      "------------------------------------------------------------
      " 2) Read PRHIS edges for correct ordering
      "------------------------------------------------------------
      SELECT pspnr, psphi, up, down, left, right
        FROM prhis
        INTO TABLE @lt_prhis
        WHERE psphi = @lv_pspnr_templ.

      IF lt_prhis IS INITIAL.
        MESSAGE 'No PRHIS edges found for template'(m02) TYPE 'S' DISPLAY LIKE 'W'.
        RETURN.
      ENDIF.

      lt_prhis_h = lt_prhis.

      "Root WBS = record with UP initial
      CLEAR lv_root_pspnr.
      LOOP AT lt_prhis ASSIGNING FIELD-SYMBOL(<l_prhis>).
        IF <l_prhis>-up IS INITIAL.
          lv_root_pspnr = <l_prhis>-pspnr.
          EXIT.
        ENDIF.
      ENDLOOP.

      IF lv_root_pspnr IS INITIAL.
        READ TABLE lt_prhis INTO DATA(ls_prhis_any) INDEX 1.
        lv_root_pspnr = ls_prhis_any-pspnr.
      ENDIF.

      "------------------------------------------------------------
      " 3) Read PRPSS attributes (text, posid, stufe)
      "------------------------------------------------------------
      SELECT pspnr, psphi, stufe, posid, post1
        FROM prpss
        INTO TABLE @lt_prpss
        WHERE psphi = @lv_pspnr_templ.

      IF lt_prpss IS INITIAL.
        MESSAGE 'No WBS elements found for template'(m03) TYPE 'S' DISPLAY LIKE 'W'.
        RETURN.
      ENDIF.

      lt_prpss_h = lt_prpss.

      "------------------------------------------------------------
      " 4) Determine which nodes have children (DOWN not initial)
      "------------------------------------------------------------
      CLEAR lt_has_child.
      LOOP AT lt_prhis ASSIGNING <l_prhis>.
        IF <l_prhis>-down IS NOT INITIAL.
          INSERT <l_prhis>-pspnr INTO TABLE lt_has_child.
        ENDIF.
      ENDLOOP.

      "------------------------------------------------------------
      " 5) Create ROOT node: "Template: <desc>"
      "------------------------------------------------------------
      lv_last_key = lv_last_key + 1.

      CLEAR ls_node.
      ls_node-node_key  = lv_last_key.
      ls_node-relatkey  = ''.
      ls_node-relatship = cl_gui_column_tree=>relat_last_child.
      ls_node-isfolder  = abap_true.
      ls_node-expander  = abap_true.
      APPEND ls_node TO gt_treev_node.

      CLEAR ls_item.
      ls_item-node_key  = lv_last_key.
      ls_item-item_name = lc_hierarchy_short_text.
      ls_item-class     = cl_gui_column_tree=>item_class_text.
      CONCATENATE 'Template:'(m04) ls_projs-post1 INTO ls_item-text SEPARATED BY space.
      APPEND ls_item TO gt_treeitm.

      CLEAR ls_item.
      ls_item-node_key  = lv_last_key.
      ls_item-item_name = lc_hierarchy_technical_key.
      ls_item-class     = cl_gui_column_tree=>item_class_text.
      ls_item-text      = ls_projs-pspid.
      APPEND ls_item TO gt_treeitm.

      "Map template project as parent anchor
      ls_node_map-pspnr    = lv_pspnr_templ.
      ls_node_map-node_key = lv_last_key.
      APPEND ls_node_map TO lt_node_map.

      "------------------------------------------------------------
      " 6) Traverse WBS in correct order (preorder): node -> down -> right
      "     Use stack: push RIGHT then DOWN
      "------------------------------------------------------------
      CLEAR lt_stack.
      APPEND lv_root_pspnr TO lt_stack.

      WHILE lt_stack IS NOT INITIAL.

        READ TABLE lt_stack INTO lv_node INDEX lines( lt_stack ).
        DELETE lt_stack INDEX lines( lt_stack ).

        READ TABLE lt_prhis_h ASSIGNING <fs_prhis> WITH KEY pspnr = lv_node.
        IF sy-subrc <> 0.
          CONTINUE.
        ENDIF.

        READ TABLE lt_prpss_h ASSIGNING <fs_prpss> WITH KEY pspnr = lv_node.
        IF sy-subrc <> 0.
          CONTINUE.
        ENDIF.

        "Find parent key by UP (or template if top)
        CLEAR lv_parent_key.
        IF <fs_prhis>-up IS INITIAL.
          READ TABLE lt_node_map INTO ls_node_map WITH KEY pspnr = lv_pspnr_templ.
        ELSE.
          READ TABLE lt_node_map INTO ls_node_map WITH KEY pspnr = <fs_prhis>-up.
        ENDIF.

        IF sy-subrc = 0.
          lv_parent_key = ls_node_map-node_key.
        ELSE.
          lv_parent_key = 1.
        ENDIF.

        lv_last_key = lv_last_key + 1.

        "Folder if node has children (DOWN exists)
        DATA(lv_is_folder) = abap_false.
        READ TABLE lt_has_child WITH KEY table_line = lv_node TRANSPORTING NO FIELDS.
        IF sy-subrc = 0.
          lv_is_folder = abap_true.
        ENDIF.

        CLEAR ls_node.
        ls_node-node_key  = lv_last_key.
        ls_node-relatkey  = lv_parent_key.
        ls_node-relatship = cl_gui_column_tree=>relat_last_child.
        ls_node-isfolder  = lv_is_folder.
        ls_node-expander  = lv_is_folder.
        APPEND ls_node TO gt_treev_node.

        "Short text
        CLEAR ls_item.
        ls_item-node_key  = lv_last_key.
        ls_item-item_name = lc_hierarchy_short_text.
        ls_item-class     = cl_gui_column_tree=>item_class_text.
        ls_item-text      = <fs_prpss>-post1.
        APPEND ls_item TO gt_treeitm.

        "Tech key (POSID) - display-friendly
        CLEAR lv_posid_disp.
        CALL FUNCTION 'CONVERSION_EXIT_ABPSP_OUTPUT'
          EXPORTING input  = <fs_prpss>-posid
          IMPORTING output = lv_posid_disp
          EXCEPTIONS OTHERS = 1.

        CLEAR ls_item.
        ls_item-node_key  = lv_last_key.
        ls_item-item_name = lc_hierarchy_technical_key.
        ls_item-class     = cl_gui_column_tree=>item_class_text.
        ls_item-text      = COND #( WHEN sy-subrc = 0 AND lv_posid_disp IS NOT INITIAL
                                    THEN lv_posid_disp
                                    ELSE <fs_prpss>-posid ).
        APPEND ls_item TO gt_treeitm.

        "Map this WBS PSPNR to node key (so children can find parent)
        CLEAR ls_node_map.
        ls_node_map-pspnr    = lv_node.
        ls_node_map-node_key = lv_last_key.
        APPEND ls_node_map TO lt_node_map.

        "Push sibling then child (so child processed first)
        IF <fs_prhis>-right IS NOT INITIAL.
          APPEND <fs_prhis>-right TO lt_stack.
        ENDIF.
        IF <fs_prhis>-down IS NOT INITIAL.
          APPEND <fs_prhis>-down TO lt_stack.
        ENDIF.

      ENDWHILE.

      "------------------------------------------------------------
      " 7) Display tree
      "------------------------------------------------------------
      lo_tree_preview->delete_all_nodes( ).

      lo_tree_preview->hierarchy_header_set_text(
        EXPORTING text = 'Project Structure: Description' ##NO_TEXT ).

      lo_tree_preview->add_nodes_and_items(
        EXPORTING
          node_table                = gt_treev_node
          item_table                = gt_treeitm
          item_table_structure_name = 'CNPB_H_TREEITM' ##NO_TEXT ).

      lo_tree_preview->expand_root_nodes(
        EXPORTING level_count = 0 expand_subtree = abap_true ).

      lo_tree_preview->hierarchy_header_set_width(
        EXPORTING width = 50 width_pix = space ).

      lo_tree_preview->column_set_width(
        EXPORTING column_name = lc_hierarchy_technical_key width = 25 width_pix = space ).

      cl_gui_cfw=>flush( ).

      lv_tree_loaded = abap_true.

    CATCH cx_root INTO DATA(lx_error).
      MESSAGE lx_error->get_text( ) TYPE 'S' DISPLAY LIKE 'E'.
  ENDTRY.

ENDFORM.