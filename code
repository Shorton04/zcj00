  METHOD settlement_rule.
    DATA:
      lt_bdcdata     TYPE TABLE OF bdcdata,
      lt_bdcmsg      TYPE STANDARD TABLE OF bdcmsgcoll,
      ls_bdcmsg      TYPE bdcmsgcoll,
      lv_period_char TYPE char24,
      lv_gjahr_char  TYPE char24,
      lv_mode        TYPE c VALUE 'N',
      lv_update      TYPE c VALUE 'S'
      .

    " Get current period and fiscal year
    DATA(lv_period) = sy-datum+4(2).  " Current month (MM)
    DATA(lv_gjahr) = sy-datum+0(4).   " Current year (YYYY)

    " Convert to CHAR132
    lv_period_char = lv_period.
    lv_gjahr_char = lv_gjahr.


    CLEAR lt_bdcdata.
    bdc_dynpro(
      EXPORTING
        iv_program = 'SAPLKAZB'
        iv_dynpro  = '1000'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam    = 'BDC_OKCODE'
        iv_fval    = '/EOKKS'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).


    bdc_dynpro(
      EXPORTING
        iv_program = 'SAPLSPO4'
        iv_dynpro  = '0300'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam    = 'BDC_OKCODE'
        iv_fval    = '=FURT'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam    = 'SVALD-VALUE(01)'
        iv_fval    = CONV #( iv_vkokr )
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).


    bdc_dynpro(
      EXPORTING
        iv_program = 'SAPLKAZB'
        iv_dynpro  = '1000'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam    = 'BDC_OKCODE'
        iv_fval    = '=RUN'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam    = 'BDC_CURSOR'
        iv_fval    = 'RKAUF-LIST'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam    = 'RKAUF-TEST'
        iv_fval    = ''
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam    = 'BDC_SUBSCR'
        iv_fval    = 'SAPLKAOP                                0570BLOCK1'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam    = 'LKP74-PSPID'
        iv_fval    = CONV #( iv_pspid )
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam    = 'LKP74-POSID'
        iv_fval    = ''
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam    = 'BDC_SUBSCR'
        iv_fval    = 'SAPLKAZB                                2100BLOCK2'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam    = 'RKAUF-FROM'
        iv_fval    = CONV #( lv_period_char )
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam    = 'RKAUF-GJAHR'
        iv_fval    = CONV #( lv_gjahr_char )
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    " Execute CJB2 in foreground
    CLEAR lt_bdcmsg.

    CALL TRANSACTION 'CJB2'
      USING lt_bdcdata
      MODE lv_mode
      UPDATE lv_update
      MESSAGES INTO lt_bdcmsg.

*    CLEAR lv_error.
    LOOP AT lt_bdcmsg TRANSPORTING NO FIELDS WHERE msgtyp CA 'EA'.
      EXIT.
    ENDLOOP.

    IF sy-subrc EQ 0.
      CLEAR lt_bdcdata.

      bdc_dynpro(
        EXPORTING
          iv_program = 'SAPLSPO4'
          iv_dynpro  = '0300'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'BDC_CURSOR'
          iv_fval    = 'SVALD-VALUE(01)'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'BDC_OKCODE'
          iv_fval    = '=FURT'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'SVALD-VALUE(01)'
          iv_fval    = CONV #( iv_vkokr )
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).


      bdc_dynpro(
        EXPORTING
          iv_program = 'SAPLKAZB'
          iv_dynpro  = '1000'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'BDC_OKCODE'
          iv_fval    = '=RUN'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'BDC_CURSOR'
          iv_fval    = 'RKAUF-LIST'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'RKAUF-TEST'
          iv_fval    = ''
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'BDC_SUBSCR'
          iv_fval    = 'SAPLKAOP                                0570BLOCK1'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'LKP74-PSPID'
          iv_fval    = CONV #( iv_pspid )
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'LKP74-POSID'
          iv_fval    = ''
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'BDC_SUBSCR'
          iv_fval    = 'SAPLKAZB                                2100BLOCK2'
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'RKAUF-FROM'
          iv_fval    = CONV #( lv_period_char )
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      bdc_field(
        EXPORTING
          iv_fnam    = 'RKAUF-GJAHR'
          iv_fval    = CONV #( lv_gjahr_char )
        CHANGING
          ct_bdcdata = lt_bdcdata
      ).

      " Execute CJB2 in foreground
      CLEAR lt_bdcmsg.

      CALL TRANSACTION 'CJB2'
        USING lt_bdcdata
        MODE lv_mode
        UPDATE lv_update
        MESSAGES INTO lt_bdcmsg.

    ENDIF.

  ENDMETHOD.
