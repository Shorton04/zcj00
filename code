FORM release_locks USING p_aufnr TYPE aufk-aufnr.

  DATA(lv_aufnr) = CONV aufk-aufnr( |{ p_aufnr ALPHA = IN }| ).

  TRY.
      CALL FUNCTION 'DEQUEUE_ESORDER'
        EXPORTING
          aufnr = lv_aufnr.
##NO_HANDLER    CATCH cx_root.
      " no action needed
  ENDTRY.

ENDFORM.
