FORM total_up_wbs_tc.

  DATA: lt_table5     TYPE STANDARD TABLE OF ty_wbs_display,
        lt_table4     TYPE STANDARD TABLE OF ty_wbs_display,
        lt_table3     TYPE STANDARD TABLE OF ty_wbs_display,
        lt_table2     TYPE STANDARD TABLE OF ty_wbs_display,
        lt_table1     TYPE STANDARD TABLE OF ty_wbs_display,
        lv_sum4       TYPE ty_wbs_display-zapproved_budg,
        lv_sum3       TYPE ty_wbs_display-zapproved_budg,
        lv_sum2       TYPE ty_wbs_display-zapproved_budg,
        lv_sum1       TYPE ty_wbs_display-zapproved_budg,
        lv_index4     TYPE sy-tabix,
        lv_index3     TYPE sy-tabix,
        lv_index2     TYPE sy-tabix.

  DATA: lv_pspid_len4 TYPE i,
        lv_pspid_len3 TYPE i,
        lv_pspid_len2 TYPE i,
        lv_pspid_len1 TYPE i.

  DATA: lv_parent_posid TYPE ps_posid,
        lv_child_posid  TYPE ps_posid,
        lv_budget_flag  TYPE c LENGTH 1.

  FIELD-SYMBOLS:
    <wa0> TYPE ty_wbs_display,
    <wa>  TYPE ty_wbs_display,
    <wa1> TYPE ty_wbs_display,
    <wa2> TYPE ty_wbs_display,
    <wa3> TYPE ty_wbs_display,
    <wa4> TYPE ty_wbs_display,
    <wa5> TYPE ty_wbs_display.

  " Auto-populate blank budget = 0
  LOOP AT gt_wbs_display ASSIGNING <wa0>.
    IF <wa0>-zapproved_budg IS INITIAL.
      <wa0>-zapproved_budg = 0.
    ENDIF.
  ENDLOOP.

  CLEAR: lt_table1, lt_table2, lt_table3, lt_table4, lt_table5.

  LOOP AT gt_wbs_display ASSIGNING <wa>.
    CASE <wa>-stufe.
      WHEN '5'.
        APPEND <wa> TO lt_table5.
      WHEN '4'.
        APPEND <wa> TO lt_table4.
      WHEN '3'.
        APPEND <wa> TO lt_table3.
      WHEN '2'.
        APPEND <wa> TO lt_table2.
      WHEN '1'.
        APPEND <wa> TO lt_table1.
    ENDCASE.
  ENDLOOP.

*--------------------------------------------------------------------*
* Build the Total + Budget Check for Level 4 from Level 5
*--------------------------------------------------------------------*
  CLEAR lv_index4.
  LOOP AT gt_wbs_display ASSIGNING <wa4> WHERE stufe = '4'.

    CLEAR: lv_sum4, lv_budget_flag.
    lv_parent_posid = <wa4>-posid.

    CALL FUNCTION 'FTR_CORR_SWIFT_DELETE_ENDZERO'
      CHANGING
        c_value = lv_parent_posid.

    lv_pspid_len4 = strlen( lv_parent_posid ).

    LOOP AT lt_table5 ASSIGNING <wa5>.
      lv_child_posid = <wa5>-posid.

      CALL FUNCTION 'FTR_CORR_SWIFT_DELETE_ENDZERO'
        CHANGING
          c_value = lv_child_posid.

      IF lv_child_posid+0(lv_pspid_len4) = lv_parent_posid+0(lv_pspid_len4).
        lv_sum4 = lv_sum4 + <wa5>-zapproved_budg.

        IF <wa5>-zbudget_check IS NOT INITIAL.
          lv_budget_flag = 'X'.
        ENDIF.
      ENDIF.
    ENDLOOP.

    <wa4>-zapproved_budg = lv_sum4.
    IF lv_budget_flag = 'X'.
      <wa4>-zbudget_check = 'X'.
    ELSE.
      CLEAR <wa4>-zbudget_check.
    ENDIF.

    lv_index4 = lv_index4 + 1.
    MODIFY gt_wbs_display FROM <wa4> TRANSPORTING zapproved_budg zbudget_check.
    MODIFY lt_table4      FROM <wa4> INDEX lv_index4.
  ENDLOOP.

*--------------------------------------------------------------------*
* Build the Total + Budget Check for Level 3 from Level 4
*--------------------------------------------------------------------*
  CLEAR lv_index3.
  LOOP AT gt_wbs_display ASSIGNING <wa3> WHERE stufe = '3'.

    CLEAR: lv_sum3, lv_budget_flag.
    lv_parent_posid = <wa3>-posid.

    CALL FUNCTION 'FTR_CORR_SWIFT_DELETE_ENDZERO'
      CHANGING
        c_value = lv_parent_posid.

    lv_pspid_len3 = strlen( lv_parent_posid ).

    LOOP AT lt_table4 ASSIGNING <wa4>.
      lv_child_posid = <wa4>-posid.

      CALL FUNCTION 'FTR_CORR_SWIFT_DELETE_ENDZERO'
        CHANGING
          c_value = lv_child_posid.

      IF lv_child_posid+0(lv_pspid_len3) = lv_parent_posid+0(lv_pspid_len3).
        lv_sum3 = lv_sum3 + <wa4>-zapproved_budg.

        IF <wa4>-zbudget_check IS NOT INITIAL.
          lv_budget_flag = 'X'.
        ENDIF.
      ENDIF.
    ENDLOOP.

    <wa3>-zapproved_budg = lv_sum3.
    IF lv_budget_flag = 'X'.
      <wa3>-zbudget_check = 'X'.
    ELSE.
      CLEAR <wa3>-zbudget_check.
    ENDIF.

    lv_index3 = lv_index3 + 1.
    MODIFY gt_wbs_display FROM <wa3> TRANSPORTING zapproved_budg zbudget_check.
    MODIFY lt_table3      FROM <wa3> INDEX lv_index3.
  ENDLOOP.

*--------------------------------------------------------------------*
* Build the Total + Budget Check for Level 2 from Level 3
*--------------------------------------------------------------------*
  CLEAR lv_index2.
  LOOP AT gt_wbs_display ASSIGNING <wa2> WHERE stufe = '2'.

    CLEAR: lv_sum2, lv_budget_flag.
    lv_parent_posid = <wa2>-posid.

    CALL FUNCTION 'FTR_CORR_SWIFT_DELETE_ENDZERO'
      CHANGING
        c_value = lv_parent_posid.

    lv_pspid_len2 = strlen( lv_parent_posid ).

    LOOP AT lt_table3 ASSIGNING <wa3>.
      lv_child_posid = <wa3>-posid.

      CALL FUNCTION 'FTR_CORR_SWIFT_DELETE_ENDZERO'
        CHANGING
          c_value = lv_child_posid.

      IF lv_child_posid+0(lv_pspid_len2) = lv_parent_posid+0(lv_pspid_len2).
        lv_sum2 = lv_sum2 + <wa3>-zapproved_budg.

        IF <wa3>-zbudget_check IS NOT INITIAL.
          lv_budget_flag = 'X'.
        ENDIF.
      ENDIF.
    ENDLOOP.

    <wa2>-zapproved_budg = lv_sum2.
    IF lv_budget_flag = 'X'.
      <wa2>-zbudget_check = 'X'.
    ELSE.
      CLEAR <wa2>-zbudget_check.
    ENDIF.

    lv_index2 = lv_index2 + 1.
    MODIFY gt_wbs_display FROM <wa2> TRANSPORTING zapproved_budg zbudget_check.
    MODIFY lt_table2      FROM <wa2> INDEX lv_index2.
  ENDLOOP.

*--------------------------------------------------------------------*
* Build the Total + Budget Check for Level 1 from Level 2
*--------------------------------------------------------------------*
  LOOP AT gt_wbs_display ASSIGNING <wa1> WHERE stufe = '1'.

    CLEAR: lv_sum1, lv_budget_flag.
    lv_parent_posid = <wa1>-posid.

    CALL FUNCTION 'FTR_CORR_SWIFT_DELETE_ENDZERO'
      CHANGING
        c_value = lv_parent_posid.

    lv_pspid_len1 = strlen( lv_parent_posid ).

    LOOP AT lt_table2 ASSIGNING <wa2>.
      lv_child_posid = <wa2>-posid.

      CALL FUNCTION 'FTR_CORR_SWIFT_DELETE_ENDZERO'
        CHANGING
          c_value = lv_child_posid.

      IF lv_child_posid+0(lv_pspid_len1) = lv_parent_posid+0(lv_pspid_len1).
        lv_sum1 = lv_sum1 + <wa2>-zapproved_budg.

        IF <wa2>-zbudget_check IS NOT INITIAL.
          lv_budget_flag = 'X'.
        ENDIF.
      ENDIF.
    ENDLOOP.

    <wa1>-zapproved_budg = lv_sum1.
    IF lv_budget_flag = 'X'.
      <wa1>-zbudget_check = 'X'.
    ELSE.
      CLEAR <wa1>-zbudget_check.
    ENDIF.

    MODIFY gt_wbs_display FROM <wa1> TRANSPORTING zapproved_budg zbudget_check.
  ENDLOOP.

ENDFORM.