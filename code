FUNCTION z_a2r_trigger_bdc_3step.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(iv_pspid)     TYPE ps_pspid
*"     VALUE(iv_vkokr)     TYPE kokrs
*"     VALUE(iv_prnam)     TYPE im_prnam
*"     VALUE(iv_posnr)     TYPE im_posnr
*"     VALUE(iv_posid_wbs) TYPE ps_posid
*"  EXPORTING
*"     VALUE(ev_success)   TYPE abap_bool
*"  TABLES
*"     et_return           TYPE bapiret2 OPTIONAL
*"----------------------------------------------------------------------
  DATA: lo_builder TYPE REF TO zcl_a2r_wbs_builder,
        lv_ok      TYPE abap_bool.

  ev_success = abap_false.
  CLEAR et_return[].

  "Basic input checks (keep it simple)
  IF iv_pspid IS INITIAL OR iv_vkokr IS INITIAL.
    APPEND VALUE #( type = 'E'
                    id   = '00'
                    number = '398'
                    message = 'Missing required input: PSPID/VKOKR' ) TO et_return.
    RETURN.
  ENDIF.

  "Instantiate your class (adjust constructor if you have one)
  CREATE OBJECT lo_builder.

  "------------------------------------------------------------
  " 1) Assign IM to WBS (CJ02) - your method reads IMPR by PRNAM+POSNR
  "    and assigns to iv_posid_wbs
  "------------------------------------------------------------
  TRY.
      lv_ok = lo_builder->assign_im_cj02(
                iv_prnam     = iv_prnam
                iv_posnr     = iv_posnr
                iv_posid_wbs = iv_posid_wbs ).

      IF lv_ok <> abap_true.
        APPEND VALUE #( type = 'E'
                        id   = '00'
                        number = '398'
                        message = |Step 1 failed: CJ02 assign IM (PRNAM={ iv_prnam } POSNR={ iv_posnr } WBS={ iv_posid_wbs })| ) TO et_return.
        RETURN.
      ENDIF.

    CATCH cx_root INTO DATA(lx1).
      APPEND VALUE #( type = 'E'
                      id   = '00'
                      number = '398'
                      message = |Step 1 exception: { lx1->get_text( ) }| ) TO et_return.
      RETURN.
  ENDTRY.

  "------------------------------------------------------------
  " 2) Settlement Rule (CJB2)
  "------------------------------------------------------------
  TRY.
      lo_builder->settlement_rule(
        iv_vkokr = iv_vkokr
        iv_pspid = iv_pspid ).

    CATCH cx_root INTO DATA(lx2).
      APPEND VALUE #( type = 'E'
                      id   = '00'
                      number = '398'
                      message = |Step 2 exception: { lx2->get_text( ) }| ) TO et_return.
      RETURN.
  ENDTRY.

  "------------------------------------------------------------
  " 3) Release Project (CJ02)
  "------------------------------------------------------------
  TRY.
      lo_builder->release_project_cj02(
        iv_pspid = iv_pspid ).

    CATCH cx_root INTO DATA(lx3).
      APPEND VALUE #( type = 'E'
                      id   = '00'
                      number = '398'
                      message = |Step 3 exception: { lx3->get_text( ) }| ) TO et_return.
      RETURN.
  ENDTRY.

  ev_success = abap_true.
  APPEND VALUE #( type = 'S'
                  id   = '00'
                  number = '398'
                  message = 'BDC steps executed successfully (Assign IM, Settlement Rule, Release).' ) TO et_return.

ENDFUNCTION.