FORM prepare_screen2.

  "Always get IM data (safe, doesn't overwrite screen2 edits)
  PERFORM get_additional_im_data USING p_posnr.

  "✅ Initialize screen2 ONCE only
  IF gv_header_initialized = abap_true.
    "Screen2 re-entry: DO NOT rebuild template, DO NOT reset defaults, DO NOT clear header
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "FIRST ENTRY ONLY
  "------------------------------------------------------------

  "✅ Build WBS items in correct PRHIS order
  CLEAR gt_wbs_items.
  CALL METHOD go_builder->copy_template_structure
    EXPORTING
      iv_pspid     = p_pspid
      iv_kostl     = p_kostl
    CHANGING
      ct_wbs_items = gt_wbs_items.

  "🚫 IMPORTANT: Do NOT call load_template_to_wbs_items anymore
  "PERFORM load_template_to_wbs_items USING p_pspid p_kostl.

  PERFORM convert_to_display.
  PERFORM set_wbs_default_values.      "will be fixed below to not overwrite user edits
  PERFORM populate_header_structure.   "will be fixed below to not clear on re-entry

  gv_header_initialized = abap_true.

ENDFORM.



FORM set_wbs_default_values.

  LOOP AT gt_wbs_display INTO gs_wbs_display.

    "Default KOSTL only if empty (don't overwrite user edit)
    IF gs_wbs_display-kostl IS INITIAL.
      gs_wbs_display-kostl = p_kostl.
    ENDIF.

    "Budget check default for STUFE=1 only if initial
    IF gs_wbs_display-stufe = 1 AND gs_wbs_display-zbudget_check IS INITIAL.
      gs_wbs_display-zbudget_check = gc_x.
    ENDIF.

    "Level 1 description default only if user didn't type anything
    IF gs_wbs_display-stufe = 1 AND gs_wbs_display-post1 IS INITIAL.
      gs_wbs_display-post1 = p_post1.
    ENDIF.

    MODIFY gt_wbs_display FROM gs_wbs_display.

  ENDLOOP.

ENDFORM.



FORM populate_header_structure.

  "🚫 Do NOT CLEAR gs_header here

  "IM Data
  IF gs_header-posnr IS INITIAL. gs_header-posnr = p_posnr. ENDIF.
  IF gs_header-prnam IS INITIAL. gs_header-prnam = p_prnam. ENDIF.

  "Project description (user input)
  IF gs_header-post1 IS INITIAL. gs_header-post1 = p_post1. ENDIF.

  "Responsible
  IF gs_header-vernr IS INITIAL. gs_header-vernr = p_verna. ENDIF.

  "Dates
  IF gs_header-plsez IS INITIAL. gs_header-plsez = p_plsez. ENDIF.
  IF gs_header-erdat IS INITIAL. gs_header-erdat = sy-datum. ENDIF.

  "Org
  IF gs_header-bukrs IS INITIAL. gs_header-bukrs = gv_bukrs. ENDIF.
  IF gs_header-werks IS INITIAL. gs_header-werks = gv_werks. ENDIF.

  "Finance
  IF gs_header-prctr IS INITIAL. gs_header-prctr = p_prctr. ENDIF.
  IF gs_header-kostl IS INITIAL. gs_header-kostl = p_kostl. ENDIF.

  "Investment
  IF gs_header-izwek IS INITIAL. gs_header-izwek = gv_izwek. ENDIF.
  IF gs_header-profl IS INITIAL. gs_header-profl = p_profl. ENDIF.

  "Flags
  IF gs_header-zunifier_proj IS INITIAL. gs_header-zunifier_proj = p_usr10. ENDIF.
  IF gs_header-usr008 IS INITIAL. gs_header-usr008 = gv_usr008. ENDIF.

  "User/type
  IF gs_header-ernam IS INITIAL. gs_header-ernam = sy-uname. ENDIF.
  IF gs_header-z_reqtype IS INITIAL. gs_header-z_reqtype = gv_request_type. ENDIF.

  IF gv_z_remarks IS NOT INITIAL AND gs_header-z_remarks IS INITIAL.
    gs_header-z_remarks = gv_z_remarks.
  ENDIF.

  IF gv_im_posid_display IS INITIAL.
    PERFORM get_im_posid_for_display USING p_posnr CHANGING gv_im_posid_display.
  ENDIF.

ENDFORM.



FORM enrich_wbs_items USING iv_kostl TYPE kostl.

  LOOP AT gt_wbs_items INTO gs_wbs_item.
    IF gs_wbs_item-kostl IS INITIAL.
      gs_wbs_item-kostl = iv_kostl.
    ENDIF.
    IF gs_wbs_item-bukrs IS INITIAL.
      gs_wbs_item-bukrs = gv_bukrs.
    ENDIF.
    IF gs_wbs_item-werks IS INITIAL.
      gs_wbs_item-werks = gv_werks.
    ENDIF.
    MODIFY gt_wbs_items FROM gs_wbs_item.
  ENDLOOP.

ENDFORM.



FORM convert_to_display.

  DATA lv_posid_external TYPE ps_posid.

  FREE gt_wbs_display.

  LOOP AT gt_wbs_items INTO gs_wbs_item.
    CLEAR: gs_wbs_display, lv_posid_external.

    gs_wbs_display-stufe = gs_wbs_item-stufe.
    gs_wbs_display-post1 = gs_wbs_item-post1.
    gs_wbs_display-kostl = gs_wbs_item-kostl.
    gs_wbs_display-posnr = gs_wbs_item-posnr.
    gs_wbs_display-zapproved_budg = gs_wbs_item-wert2.
    gs_wbs_display-zbudget_check = gs_wbs_item-zbudget_check.
    gs_wbs_display-bukrs = gs_wbs_item-bukrs.
    gs_wbs_display-imprf = gs_wbs_item-imprf.
    gs_wbs_display-prart = gs_wbs_item-prart.

    IF gs_wbs_item-posid IS NOT INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_ABPSP_OUTPUT'
        EXPORTING input  = gs_wbs_item-posid
        IMPORTING output = lv_posid_external
        EXCEPTIONS OTHERS = 1.

      gs_wbs_display-posid = COND #( WHEN sy-subrc = 0 AND lv_posid_external IS NOT INITIAL
                                     THEN lv_posid_external
                                     ELSE gs_wbs_item-posid ).
    ENDIF.

    APPEND gs_wbs_display TO gt_wbs_display.
  ENDLOOP.

ENDFORM.