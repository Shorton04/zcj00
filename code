    DATA:ls_custom_button TYPE zif_a2d_view_alv=>ts_custom_button,
         lv_lookup_name   TYPE zde_lookup_name.

    FIELD-SYMBOLS <fs_parameter>  TYPE ts_parameter.

    ASSIGN is_parameter TO <fs_parameter>.
