         lt_tj02            TYPE STANDARD TABLE OF tj02,
         lt_tj02t_i         TYPE STANDARD TABLE OF tj02t,
         lt_tj02t_e         TYPE STANDARD TABLE OF tj02t,
         rt_tj02t           TYPE RANGE OF tj02t-istat,
         lrs_tj02t          LIKE LINE OF  rt_tj02t,
         ls_status          TYPE jstat,
         ls_status_tmp      TYPE jstat,
         ls_aufk            TYPE ts_aufk,
         ls_t001w           TYPE ts_t001w,
         ls_afru            TYPE ts_afru,
         ls_jcds            TYPE jcds,
         ls_jcds_tmp        TYPE jcds,
         ls_mhio            TYPE ts_mhio,
         ls_jest            TYPE jest,
         ls_mhis            TYPE ts_mhis,
         ls_iloa            TYPE ts_iloa,
         lv_excl_status     TYPE flag,
         lv_incl_status     TYPE flag,
         lt_iloa            TYPE STANDARD TABLE OF ts_iloa,
         lt_result          TYPE STANDARD TABLE OF ts_result,
         lt_t001w           TYPE STANDARD TABLE OF ts_t001w,
         ls_result          TYPE ts_result,
         lv_valid_syst_stat TYPE flag.

    CLEAR et_result.

    lt_aufk = it_aufk.
    lt_afih = it_afih.
    lt_afko = it_afko.
    lt_afru = it_afru.
    lt_jcds = it_jcds.
    lt_mhio = it_mhio.
    lt_mhis = it_mhis.
    lt_jest = it_jest.
    lt_iloa = it_iloa.
    lt_tj02t = it_tj02t.
    lt_t001w = it_t001w.
    lt_jcds_rel = it_jcds_rel.
    lt_jcds_teco = it_jcds_teco.


    SORT: lt_aufk BY aufnr,
          lt_afih BY aufnr,
          lt_afko BY aufnr,
          lt_afru BY aufnr,
          lt_mhio BY aufnr,
          lt_jest BY objnr,
          lt_jcds BY objnr stat,
          lt_iloa BY iloan,
          lt_t001w BY werks,
          lt_tj02t BY spras istat,
          lt_mhis BY warpl abnum.


    IF is_parameter-r_stati IS NOT INITIAL.
      SELECT * FROM tj02t INTO TABLE lt_tj02t_i
               WHERE txt04 IN is_parameter-r_stati
                AND  spras = 'E'.
    ENDIF.
    IF is_parameter-r_state IS NOT INITIAL.
      SELECT * FROM tj02t INTO TABLE lt_tj02t_e
               WHERE txt04 IN is_parameter-r_state
                AND  spras = 'E'.
    ENDIF.

    LOOP AT lt_tj02t_i INTO DATA(ls_tj02t_tmp).
      lrs_tj02t-sign   = 'I'.
      lrs_tj02t-option = 'EQ'.
      TRANSLATE ls_tj02t_tmp-istat TO UPPER CASE.
      lrs_tj02t-low = ls_tj02t_tmp-istat.
      APPEND lrs_tj02t TO rt_tj02t.
    ENDLOOP.

    LOOP AT lt_mhis INTO ls_mhis.
      LOOP AT lt_mhio INTO ls_mhio
            WHERE warpl = ls_mhis-warpl
             AND  abnum = ls_mhis-abnum.

        CLEAR:lt_jcds_tmp, ls_result, ls_afih,
              ls_afko,     ls_afru,   ls_jcds,
              ls_iloa,     ls_jest,   ls_aufk,
              ls_tj02t,    ls_t001w,  lt_jcds_tmp.
* Maintenance Plan data
        ls_result-warpl            = ls_mhio-warpl.
        ls_result-abnum            = ls_mhis-abnum.
        ls_result-zaehl            = ls_mhis-zaehl.
        ls_result-final_due_date       = ls_afih-lacd_date.
*        ls_result-zz_ext_late_date = ls_mhio-zz_ext_late_date.
        ls_result-nplda            = ls_mhis-nplda.
* Fill AUFNR / IDAT2 / VAPLZ / KOSTL
        READ TABLE lt_aufk INTO ls_aufk
              WITH KEY aufnr = ls_mhio-aufnr BINARY SEARCH.

        CHECK sy-subrc = 0.

        ls_result-aufnr_wo  = ls_aufk-aufnr.
        ls_result-auart     = ls_aufk-auart.
        ls_result-idat2     = ls_aufk-idat2. " TECO date
        ls_result-vaplz     = ls_aufk-vaplz.
        ls_result-kostl_wo  = ls_aufk-kostl.
        ls_result-ktext     = ls_aufk-ktext.
        ls_result-werks     = ls_aufk-werks.
        ls_result-ernam_entered_by = ls_aufk-ernam.
        ls_result-erdat_created_on = ls_aufk-erdat.

        READ TABLE lt_t001w INTO ls_t001w
                WITH KEY werks = ls_aufk-werks BINARY SEARCH.
        IF sy-subrc = 0.
          ls_result-werks_dec     = ls_t001w-name1.
        ENDIF.

* Fill PRIOK / ADDAT / INGPR / ILART
        READ TABLE lt_afih INTO ls_afih
            WITH KEY aufnr = ls_aufk-aufnr BINARY SEARCH.

        CHECK sy-subrc = 0.

        ls_result-priok = ls_afih-priok.
        ls_result-addat = ls_afih-addat.
        ls_result-ingpr = ls_afih-ingpr.
        ls_result-ilart = ls_afih-ilart.

* TPLNR
        READ TABLE lt_iloa INTO ls_iloa
            WITH KEY iloan = ls_afih-iloan   BINARY SEARCH.

        CHECK sy-subrc = 0.

        CALL FUNCTION 'CONVERSION_EXIT_TPLNR_OUTPUT'
          EXPORTING
            input  = ls_iloa-tplnr
          IMPORTING
            output = ls_result-tplnr.

* Fill GETRI / GSTRI
        READ TABLE lt_afko INTO ls_afko
            WITH KEY aufnr = ls_afih-aufnr BINARY SEARCH.

        CHECK sy-subrc = 0.

        ls_result-getri = ls_afko-getri.
        ls_result-gstri = ls_afko-gstri.
        ls_result-gstrs = ls_afko-gstrs.
        ls_result-gltrs = ls_afko-gltrs.

        IF rt_tj02t IS NOT INITIAL.
          SELECT COUNT(*) FROM jcds
               WHERE objnr = ls_aufk-objnr
                AND  stat IN rt_tj02t.

          CHECK sy-dbcnt > 0.
        ENDIF.
* System status( Validation + Result List )
        CLEAR:lt_status,    lv_objnr,   lt_jcds_tmp,
              lt_status_tmp.
        lv_objnr = ls_aufk-objnr.
        CALL FUNCTION 'STATUS_READ'
          EXPORTING
            client           = sy-mandt
            objnr            = lv_objnr
            only_active      = abap_true
          TABLES
            status           = lt_status_tmp
          EXCEPTIONS
            object_not_found = 1
            OTHERS           = 2.
        IF sy-subrc <> 0.
* Implement suitable error handling here
        ELSE.
          LOOP AT lt_status_tmp INTO ls_status.
            IF ls_status-stat+0(1) = 'I'. " Only System status
              APPEND ls_status TO lt_status.
            ENDIF.
          ENDLOOP.
          IF lt_status IS NOT INITIAL.
            IF lt_status IS NOT INITIAL.
              SELECT * FROM tj02 INTO TABLE lt_tj02
                   FOR ALL ENTRIES IN lt_status
                        WHERE istat = lt_status-stat
                         AND  nodis = abap_false.
            ENDIF.
* Table LT_STATUS would have System status alone
            CLEAR:lv_incl_status, lv_excl_status.
            LOOP AT lt_status INTO ls_status.

              CLEAR:ls_status_tmp, ls_tj02t.

              READ TABLE lt_tj02 WITH KEY istat = ls_status-stat
                        TRANSPORTING NO FIELDS.

              CHECK sy-subrc = 0.

              IF is_parameter-r_stati IS NOT INITIAL.
                READ TABLE lt_tj02t_i WITH KEY istat = ls_status-stat
                                        TRANSPORTING NO FIELDS.
                IF sy-subrc = 0.
                  lv_incl_status = abap_true.
                ENDIF.
              ELSE.
                lv_incl_status = abap_true.
              ENDIF.

              IF is_parameter-r_state IS NOT INITIAL.
                READ TABLE lt_tj02t_e WITH KEY istat = ls_status-stat
                                        TRANSPORTING NO FIELDS.
                IF sy-subrc = 0.
                  lv_excl_status = abap_true.
                  EXIT.
                ENDIF.
              ENDIF.
              READ TABLE lt_tj02t INTO ls_tj02t
               WITH KEY spras = sy-langu
                        istat = ls_status-stat BINARY SEARCH.
              IF sy-subrc <> 0.
                READ TABLE lt_tj02t INTO ls_tj02t
                         WITH KEY spras = 'E'
                                  istat = ls_status-stat BINARY SEARCH.
              ENDIF.
* System status text
              CHECK ls_tj02t-txt04 IS NOT INITIAL.
              CONCATENATE  ls_tj02t-txt04
                           ls_result-txt04 INTO ls_result-txt04
                                   SEPARATED BY '/'.
            ENDLOOP.
          ENDIF.
        ENDIF.

        CHECK lv_incl_status = abap_true AND lv_excl_status = abap_false.
* Fill BUDAT / ERNAM
*        READ TABLE lt_afru INTO ls_afru
*          WITH KEY aufnr = ls_afih-aufnr BINARY SEARCH .
*        IF sy-subrc = 0.
*          ls_result-budat = ls_afru-budat.
*          ls_result-ernam = ls_afru-ernam.
*        ENDIF.

*--------------------------------------------------------------------*
* Fill BUDAT / ERNAM
*--------------------------------------------------------------------*
        READ TABLE lt_afru INTO ls_afru
         WITH KEY aufnr = ls_afih-aufnr BINARY SEARCH.
        IF sy-subrc = 0.
          ls_result-budat = ls_afru-budat.
          ls_result-ernam = ls_afru-ernam.
        ENDIF.
*--------------------------------------------------------------------*
* Final Due Date
*--------------------------------------------------------------------*
        ls_result-final_due_date = ls_afih-lacd_date.
*--------------------------------------------------------------------*
* Ref<>Act Start
*--------------------------------------------------------------------*
        IF ls_afih-addat <> ls_afko-gstri.
          ls_result-ref_act_start = 'Yes'.
        ELSE.
          ls_result-ref_act_start = 'No'.
        ENDIF.
*--------------------------------------------------------------------*
* Act<>Planned
*--------------------------------------------------------------------*
        IF ls_afko-getri IS INITIAL
          OR ls_afko-getri > ls_mhis-nplda.
          ls_result-act_planned = 'Yes'.
        ELSE.
          ls_result-act_planned = 'No'.
        ENDIF.
*--------------------------------------------------------------------*
* CNF<>Act End
*--------------------------------------------------------------------*
        CLEAR ls_result-cnf_act_end.
        IF ls_afru-budat IS NOT INITIAL
          AND ls_afko-getri IS NOT INITIAL.
          ls_result-cnf_act_end =
              ls_afru-budat - ls_afko-getri.
        ENDIF.
*--------------------------------------------------------------------*
* TECO<>Actual End
*--------------------------------------------------------------------*
        CLEAR ls_result-teco_actual_end.
        IF ls_aufk-idat2 IS NOT INITIAL
          AND ls_afko-getri IS NOT INITIAL.
          ls_result-teco_actual_end =
              ls_aufk-idat2 - ls_afko-getri.
        ENDIF.

        CLEAR:lt_jcds_tmp, ls_jcds.
        LOOP AT lt_jcds_teco INTO ls_jcds
                 WHERE objnr = ls_aufk-objnr.
          APPEND ls_jcds TO lt_jcds_tmp.
        ENDLOOP.
* Fill USNAM(TECO BY) - Pick the record with latest date & time
        SORT lt_jcds_tmp BY udate DESCENDING
                            utime DESCENDING.
        READ TABLE lt_jcds_tmp INTO ls_jcds INDEX 1.
        IF sy-subrc = 0.
*   TECO By
          ls_result-usnam = ls_jcds-usnam.
        ENDIF.

* USNAM_REL_BY(Released By) / UDATE( Released On)
        CLEAR:lt_jcds_tmp,ls_jcds.
        LOOP AT lt_jcds_rel INTO ls_jcds
                 WHERE objnr = ls_aufk-objnr.
          APPEND ls_jcds TO lt_jcds_tmp.
        ENDLOOP.
        SORT lt_jcds_tmp BY udate DESCENDING
                            utime DESCENDING.
        READ TABLE lt_jcds_tmp INTO ls_jcds INDEX 1.
        IF sy-subrc = 0.
*   Released By
          ls_result-usnam_rel_by = ls_jcds-usnam.
*   Released On
          ls_result-udate        = ls_jcds-udate.
        ENDIF.
        APPEND ls_result TO et_result.
      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_MVI0123->GET_DATA_NPMO
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_PARAMETER                   TYPE        TS_PARAMETER
* | [<---] ET_AUFK                        TYPE        STANDARD TABLE
* | [<---] ET_AFIH                        TYPE        STANDARD TABLE
* | [<---] ET_AFKO                        TYPE        STANDARD TABLE
* | [<---] ET_AFRU                        TYPE        STANDARD TABLE
* | [<---] ET_JCDS                        TYPE        STANDARD TABLE
* | [<---] ET_MHIO                        TYPE        STANDARD TABLE
* | [<---] ET_MHIS                        TYPE        STANDARD TABLE
* | [<---] ET_JEST                        TYPE        STANDARD TABLE
* | [<---] ET_TJ02T                       TYPE        STANDARD TABLE
* | [<---] ET_ILOA                        TYPE        STANDARD TABLE
* | [<---] ET_T001W                       TYPE        STANDARD TABLE
* | [<---] ET_JCDS_REL                    TYPE        STANDARD TABLE
* | [<---] ET_JCDS_TECO                   TYPE        STANDARD TABLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_data_npmo.
    DATA:lt_aufk      TYPE STANDARD TABLE OF ts_aufk,
         lt_aufk_tmp  TYPE STANDARD TABLE OF ts_aufk,
         lt_afih      TYPE STANDARD TABLE OF ts_afih,
         lt_afih_tmp  TYPE STANDARD TABLE OF ts_afih,
         lt_afko      TYPE STANDARD TABLE OF ts_afko,
         lt_afru      TYPE STANDARD TABLE OF ts_afru,
         lt_jcds      TYPE STANDARD TABLE OF jcds,
         lt_jcds_rel  TYPE STANDARD TABLE OF jcds,
         lt_jcds_teco TYPE STANDARD TABLE OF jcds,
         lt_jest      TYPE STANDARD TABLE OF jest,
         lt_mhio      TYPE STANDARD TABLE OF ts_mhio,
         lt_mhis      TYPE STANDARD TABLE OF ts_mhis,
         lt_aufnr     TYPE STANDARD TABLE OF afko-aufnr,
         lt_tj02t     TYPE STANDARD TABLE OF tj02t,
         lt_t001w     TYPE STANDARD TABLE OF ts_t001w,
         lt_iloa      TYPE STANDARD TABLE OF ts_iloa,
         ls_aufnr     LIKE LINE OF lt_aufnr.

    CLEAR: et_aufk,  et_afih, et_afko,    et_afru,
           et_jcds,  et_mhio, et_mhis,    et_jest,
           et_tj02t, et_iloa, gv_missing_auth, et_t001w,
           et_jcds_rel.

    SELECT aufnr
           gstri
           getri
           rueck
           rmzhl
           gstrs
           gltrs
           FROM afko
        INTO TABLE lt_afko
          WHERE aufnr IN is_parameter-r_aufnr
           AND  getri IN is_parameter-r_getri
           AND  gstri IN is_parameter-r_gstri.

    CHECK lt_afko IS NOT INITIAL.

    SELECT aufnr
           iwerk
           ingpr
           priok
           iloan
           ilart
           addat
           warpl
           abnum
           wapos
           lacd_date FROM afih
         INTO TABLE lt_afih
           FOR ALL ENTRIES IN lt_afko
             WHERE aufnr = lt_afko-aufnr
              AND  priok IN is_parameter-r_priok
              AND  iwerk IN is_parameter-r_iwerk
              AND  ingpr IN is_parameter-r_ingpr.
* Delete on ILART is written separately as this
* field is many fields are far away from primary key and has
* no secondary index on it. Including this in 'Where' caluse
* would be a performance deterrant!! and hence this approach.
    IF is_parameter-r_ilart IS NOT INITIAL.
      DELETE lt_afih WHERE ilart NOT IN is_parameter-r_ilart.
    ENDIF.

    LOOP AT lt_afih INTO DATA(ls_afih).
      AUTHORITY-CHECK OBJECT 'I_IWERK'
               ID 'TCD'   FIELD 'ZIW123'
               ID 'IWERK' FIELD ls_afih-iwerk.
      IF sy-subrc <> 0.
        CONTINUE.
        gv_missing_auth = abap_true.
      ELSE.
        APPEND ls_afih TO lt_afih_tmp.
      ENDIF.
    ENDLOOP.

    CLEAR lt_afih.
    lt_afih = lt_afih_tmp.
    CLEAR lt_afih_tmp.

    IF lt_afih IS NOT INITIAL.

      SELECT iloan tplnr FROM iloa INTO TABLE lt_iloa
            FOR ALL ENTRIES IN lt_afih
             WHERE iloan = lt_afih-iloan
              AND  tplnr IN is_parameter-r_tplnr.

      SELECT aufnr
             auart
             erdat
             idat2
             vaplz
             kostl
             objnr
             werks
             ktext
             ernam
        FROM aufk
        INTO TABLE lt_aufk
         FOR ALL ENTRIES IN lt_afih
           WHERE aufnr = lt_afih-aufnr
            AND  auart IN is_parameter-r_auart
            AND  erdat IN is_parameter-r_erdat.

* Delete on IDAT2/VAPLZ/KOSTL is written separately as this
* field is 28 fields are far away from primary key and has
* no secondary index on them. Including these in 'Where' caluse
* would be a performance deterrant!! and hence this approach.
      IF is_parameter-r_idat2 IS NOT INITIAL.
        DELETE lt_aufk WHERE idat2 NOT IN is_parameter-r_idat2.
      ENDIF.
      IF is_parameter-r_vaplz IS NOT INITIAL.
        DELETE lt_aufk WHERE vaplz NOT IN is_parameter-r_vaplz.
      ENDIF.
      IF is_parameter-r_kostl IS NOT INITIAL.
        DELETE lt_aufk WHERE kostl NOT IN is_parameter-r_kostl.
      ENDIF.

      IF lt_aufk IS NOT INITIAL.
        SELECT * FROM jcds INTO TABLE lt_jcds
              FOR ALL ENTRIES IN lt_aufk
               WHERE objnr = lt_aufk-objnr.

        IF sy-subrc = 0.
          DELETE lt_jcds WHERE inact = abap_true.
        ENDIF.

        LOOP AT lt_jcds INTO DATA(ls_jcds).
          IF ls_jcds-stat = 'I0045'.  " TECO(Techniaclly Completed)
            APPEND ls_jcds TO lt_jcds_teco.
          ELSEIF ls_jcds-stat = 'I0002'.  " REL(released)
            APPEND ls_jcds TO lt_jcds_rel.
          ENDIF.
        ENDLOOP.

        IF lt_jcds IS NOT INITIAL.
          SELECT * FROM tj02t INTO TABLE lt_tj02t
              FOR ALL ENTRIES IN lt_jcds
                 WHERE istat = lt_jcds-stat
                  AND  spras IN ( sy-langu, 'E' ).
        ENDIF.
        CLEAR lt_jcds.

        SELECT rueck
               rmzhl
               budat
               ernam
               aufnr
               aueru
               learr
       FROM afru INTO TABLE lt_afru
            FOR ALL ENTRIES IN lt_afih
             WHERE aufnr = lt_afih-aufnr
              AND  aueru = abap_true
              AND  skostl = ' '.
*                AND  pernr = 00000000.



        SELECT werks name1 FROM t001w INTO TABLE lt_t001w
           FOR ALL ENTRIES IN lt_aufk
             WHERE werks = lt_aufk-werks.


      ENDIF.
    ENDIF.
    et_aufk  = lt_aufk.
    et_afih  = lt_afih.
    et_afko  = lt_afko.
    et_afru  = lt_afru.
    et_jcds  = lt_jcds.
    et_jcds_rel  = lt_jcds_rel.
    et_jcds_teco  = lt_jcds_teco.
    et_mhio  = lt_mhio.
    et_mhis  = lt_mhis.
    et_jest  = lt_jest.
    et_iloa  = lt_iloa.
    et_tj02t = lt_tj02t.
    et_t001w = lt_t001w.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_MVI0123->GET_DATA_PMO
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_PARAMETER                   TYPE        TS_PARAMETER
* | [<---] ET_AUFK                        TYPE        STANDARD TABLE
* | [<---] ET_AFIH                        TYPE        STANDARD TABLE
* | [<---] ET_AFKO                        TYPE        STANDARD TABLE
* | [<---] ET_AFRU                        TYPE        STANDARD TABLE
* | [<---] ET_JCDS                        TYPE        STANDARD TABLE
* | [<---] ET_MHIO                        TYPE        STANDARD TABLE
* | [<---] ET_MHIS                        TYPE        STANDARD TABLE
* | [<---] ET_JEST                        TYPE        STANDARD TABLE
* | [<---] ET_TJ02T                       TYPE        STANDARD TABLE
* | [<---] ET_ILOA                        TYPE        STANDARD TABLE
* | [<---] ET_T001W                       TYPE        STANDARD TABLE
* | [<---] ET_JCDS_REL                    TYPE        STANDARD TABLE
* | [<---] ET_JCDS_TECO                   TYPE        STANDARD TABLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_data_pmo.
    DATA:lt_aufk      TYPE STANDARD TABLE OF ts_aufk,
         lt_t001w     TYPE STANDARD TABLE OF ts_t001w,
         lt_aufk_tmp  TYPE STANDARD TABLE OF ts_aufk,
         lt_afih      TYPE STANDARD TABLE OF ts_afih,
         lt_afih_tmp  TYPE STANDARD TABLE OF ts_afih,
         lt_afko      TYPE STANDARD TABLE OF ts_afko,
         lt_afru      TYPE STANDARD TABLE OF ts_afru,
         lt_stat_r    TYPE RANGE OF jcds-stat,
         ls_stat_r    LIKE LINE OF lt_stat_r,
         lt_jcds      TYPE STANDARD TABLE OF jcds,
         lt_jcds_rel  TYPE STANDARD TABLE OF jcds,
         lt_jcds_teco TYPE STANDARD TABLE OF jcds,
         lt_jcds_tmp  TYPE STANDARD TABLE OF jcds,
         lt_jest      TYPE STANDARD TABLE OF jest,
         lt_mhio      TYPE STANDARD TABLE OF ts_mhio,
         lt_mhio_tmp  TYPE STANDARD TABLE OF ts_mhio,
         lt_mhis      TYPE STANDARD TABLE OF ts_mhis,
         lt_mhis_tmp  TYPE STANDARD TABLE OF ts_mhis,
         lt_aufnr     TYPE STANDARD TABLE OF afko-aufnr,
         lt_tj02t     TYPE STANDARD TABLE OF tj02t,
         lt_iloa      TYPE STANDARD TABLE OF ts_iloa,
         ls_aufnr     LIKE LINE OF lt_aufnr.

    CLEAR: et_aufk,  et_afih, et_afko,    et_afru,
           et_jcds,  et_mhio, et_mhis,    et_jest,
           et_tj02t, et_iloa, gv_missing_auth,
           et_t001w, et_jcds_rel, et_jcds_teco.

    SELECT warpl
           abnum
           zaehl
           nplda FROM mhis
      INTO CORRESPONDING FIELDS OF TABLE lt_mhis
        WHERE warpl IN is_parameter-r_warpl
         AND  nplda IN is_parameter-r_nplda.

    CHECK lt_mhis IS NOT INITIAL.

    SELECT warpl
           abnum
           wppos
           aufnr
*           zzlate_date
*           zz_ext_late_date
      FROM mhio
    INTO CORRESPONDING FIELDS OF TABLE lt_mhio
      FOR ALL ENTRIES IN lt_mhis
        WHERE warpl = lt_mhis-warpl
         AND  abnum = lt_mhis-abnum
         AND  aufnr IN is_parameter-r_aufnr.

    IF lt_mhio IS NOT INITIAL.
      SELECT aufnr
             auart
             erdat
             idat2
             vaplz
             kostl
             objnr
             werks
             ktext
             ernam
             FROM aufk
        INTO CORRESPONDING FIELDS OF TABLE lt_aufk
         FOR ALL ENTRIES IN lt_mhio
            WHERE aufnr  = lt_mhio-aufnr
             AND  auart IN is_parameter-r_auart
             AND  erdat IN is_parameter-r_erdat.
    ENDIF.
* Filter Invalid data
    LOOP AT lt_aufk ASSIGNING FIELD-SYMBOL(<fs_aufk>).
      AUTHORITY-CHECK OBJECT 'I_IWERK'
               ID 'TCD'   FIELD 'ZIW123'
               ID 'IWERK' FIELD <fs_aufk>-werks.
      IF sy-subrc <> 0.
        <fs_aufk>-del = abap_true.
      ELSE.
* Now filter MHIS & MHIO tables
        LOOP AT lt_mhio INTO DATA(ls_mhio)
                      WHERE aufnr = <fs_aufk>-aufnr.
          APPEND ls_mhio TO  lt_mhio_tmp.
        ENDLOOP.
      ENDIF.
    ENDLOOP.

    DELETE lt_aufk WHERE del = abap_true.
    IF sy-subrc = 0.
      gv_missing_auth = abap_true.
    ENDIF.

    IF lt_mhio_tmp IS NOT INITIAL.
      CLEAR lt_mhio.
      lt_mhio = lt_mhio_tmp.
      CLEAR lt_mhio_tmp.
    ENDIF.

    LOOP AT lt_aufk ASSIGNING <fs_aufk>.
      LOOP AT lt_mhio INTO ls_mhio
                WHERE aufnr = <fs_aufk>-aufnr.
        LOOP AT lt_mhis INTO DATA(ls_mhis)
            WHERE warpl = ls_mhio-warpl
             AND  abnum = ls_mhio-abnum.
          APPEND ls_mhis TO  lt_mhis_tmp.
        ENDLOOP.
      ENDLOOP.
    ENDLOOP.

    IF lt_mhis_tmp IS NOT INITIAL.
      CLEAR lt_mhis.
      lt_mhis = lt_mhis_tmp.
      CLEAR lt_mhis_tmp.
    ENDIF.

    CHECK lt_aufk IS NOT INITIAL.
* Delete on IDAT2/VAPLZ/KOSTL is written separately as this
* field is 28 fields are far away from primary key and has
* no secondary index on them. Including these in 'Where' caluse
* would be a performance deterrant!! and hence this approach.
    IF is_parameter-r_idat2 IS NOT INITIAL.
      DELETE lt_aufk WHERE idat2 NOT IN is_parameter-r_idat2.
    ENDIF.
    IF is_parameter-r_vaplz IS NOT INITIAL.
      DELETE lt_aufk WHERE vaplz NOT IN is_parameter-r_vaplz.
    ENDIF.
    IF is_parameter-r_kostl IS NOT INITIAL.
      DELETE lt_aufk WHERE kostl NOT IN is_parameter-r_kostl.
    ENDIF.

    SELECT werks name1 FROM t001w INTO TABLE lt_t001w
        FOR ALL ENTRIES IN lt_aufk
          WHERE werks = lt_aufk-werks.


    SELECT * FROM jcds INTO TABLE lt_jcds
            FOR ALL ENTRIES IN lt_aufk
             WHERE objnr = lt_aufk-objnr.

    IF sy-subrc = 0.
      DELETE lt_jcds WHERE inact = abap_true.
    ENDIF.

    LOOP AT lt_jcds INTO DATA(ls_jcds).
      IF ls_jcds-stat = 'I0045'.  " TECO(Techniaclly Completed)
        APPEND ls_jcds TO lt_jcds_teco.
      ELSEIF ls_jcds-stat = 'I0002'.  " REL(released)
        APPEND ls_jcds TO lt_jcds_rel.
      ENDIF.
    ENDLOOP.


    IF lt_jcds IS NOT INITIAL.
      SELECT * FROM tj02t INTO TABLE lt_tj02t
          FOR ALL ENTRIES IN lt_jcds
             WHERE istat = lt_jcds-stat
              AND  spras IN ( sy-langu, 'E' ).
    ENDIF.

    CLEAR lt_jcds.

    SELECT aufnr
           iwerk
           ingpr
           priok
           iloan
           ilart
           addat
           warpl
           abnum
           wapos
           lacd_date FROM afih
        INTO TABLE lt_afih
          FOR ALL ENTRIES IN lt_aufk
            WHERE aufnr = lt_aufk-aufnr
             AND  priok IN is_parameter-r_priok
             AND  iwerk IN is_parameter-r_iwerk
             AND  ingpr IN is_parameter-r_ingpr.

* Delete on ILART is written separately as this
* field is many fields are far away from primary key and has
* no secondary index on it. Including this in 'Where' caluse
* would be a performance deterrant!! and hence this approach.
    IF is_parameter-r_ilart IS NOT INITIAL.
      DELETE lt_afih WHERE ilart NOT IN is_parameter-r_ilart.
    ENDIF.

    IF lt_afih IS NOT INITIAL.
      SELECT iloan tplnr FROM iloa INTO TABLE lt_iloa
        FOR ALL ENTRIES IN lt_afih
          WHERE iloan = lt_afih-iloan
           AND  tplnr IN is_parameter-r_tplnr.

      SELECT aufnr gstri getri rueck rmzhl gstrs gltrs FROM afko
           INTO TABLE lt_afko
             FOR ALL ENTRIES IN lt_afih
                WHERE aufnr = lt_afih-aufnr
                 AND  getri IN is_parameter-r_getri
                 AND  gstri IN is_parameter-r_gstri.

      SELECT rueck
             rmzhl
             budat
             ernam
             aufnr
             aueru
             learr
         FROM afru INTO TABLE lt_afru
              FOR ALL ENTRIES IN lt_afih
               WHERE aufnr = lt_afih-aufnr
                AND  aueru = abap_true
                AND  skostl = ' '.
*                AND  pernr = 00000000.
      " AUERU --> Final Confirmation
    ENDIF.

    et_aufk  = lt_aufk.
    et_afih  = lt_afih.
    et_afko  = lt_afko.
    et_afru  = lt_afru.
    et_jcds  = lt_jcds.
    et_jcds_rel  = lt_jcds_rel.
    et_jcds_teco  = lt_jcds_teco.
    et_mhio  = lt_mhio.
    et_mhis  = lt_mhis.
    et_jest  = lt_jest.
    et_iloa  = lt_iloa.
    et_tj02t = lt_tj02t.
    et_t001w = lt_t001w.
  ENDMETHOD.


