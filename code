  METHOD if_swf_flex_ifs_run_appl_step~before_creation_callback.
    DATA: lt_l1 TYPE hpa_t_bname,
          lt_l2 TYPE hpa_t_bname.
    DATA(lo_container) = io_context->get_workflow_container( ).
    CHECK lo_container IS BOUND.
    "set the approver based from config table -> level 1 and 2
    CASE to_upper( io_next_activity->get_name( ) ).
      WHEN 'APPROVAL_LEVEL 1'.
        TRY.
            lo_container->get( EXPORTING name = 'appr_level1'(t01) IMPORTING value = lt_l1 ).
            lo_container->set( EXPORTING name = 'APPROVER_T' value = lt_l1 ).
          CATCH cx_swf_cnt_cont_access_denied " Container Must Not Be Changed
                cx_swf_cnt_elem_access_denied " Element Must Not Be Changed
                cx_swf_cnt_elem_not_found     " Element does not exist
                cx_swf_cnt_container.         " Exception in the Container Service
            RAISE EXCEPTION TYPE cx_swf_flex_ifs_run_exception
              EXPORTING
                textid = VALUE scx_t100key( msgid = sy-msgid msgno = sy-msgno attr1 = sy-msgv1 attr2 = sy-msgv2 ).
        ENDTRY.
      WHEN 'APPROVAL_LEVEL 2'.
        TRY.
            lo_container->get( EXPORTING name = 'appr_level2'(t02) IMPORTING value = lt_l2 ).
            lo_container->set( EXPORTING name = 'APPROVER_T' value = lt_l2 ).
          CATCH cx_swf_cnt_cont_access_denied " Container Must Not Be Changed
                cx_swf_cnt_elem_access_denied " Element Must Not Be Changed
                cx_swf_cnt_elem_not_found     " Element does not exist
                cx_swf_cnt_container.         " Exception in the Container Service
            RAISE EXCEPTION TYPE cx_swf_flex_ifs_run_exception
              EXPORTING
                textid = VALUE scx_t100key( msgid = sy-msgid msgno = sy-msgno attr1 = sy-msgv1 attr2 = sy-msgv2 ).
        ENDTRY.
      WHEN OTHERS.
        RETURN.
    ENDCASE.
  ENDMETHOD.


