DATA: lt_parts TYPE STANDARD TABLE OF string,
      lv_part  TYPE string,
      lv_lines TYPE i.

SPLIT lv_child AT '.' INTO TABLE lt_parts.

DESCRIBE TABLE lt_parts LINES lv_lines.

IF lv_lines <= 1.
  CONTINUE.
ENDIF.

"Remove last segment
DELETE lt_parts INDEX lv_lines.

CLEAR lv_parent.

LOOP AT lt_parts INTO lv_part.
  IF lv_parent IS INITIAL.
    lv_parent = lv_part.
  ELSE.
    CONCATENATE lv_parent lv_part INTO lv_parent SEPARATED BY '.'.
  ENDIF.
ENDLOOP.