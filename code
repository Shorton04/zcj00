FORM get_text.

  DATA: lv_remarks TYPE ztb_a2r_wbshdr-z_remarks.

  CHECK sy-batch IS INITIAL AND sy-binpt IS INITIAL.

  CLEAR: ls_text, lt_text.

*---------------------------------------------------------------------*
* DISPLAY REQUEST MODE
*---------------------------------------------------------------------*
  IF gv_disp_req = abap_true.

    SELECT SINGLE z_remarks
      INTO lv_remarks
      FROM ztb_a2r_wbshdr
      WHERE zreq_num = gs_header-zreq_num.

    IF sy-subrc = 0 AND lv_remarks IS NOT INITIAL.
      CLEAR ls_text.
      ls_text-text = lv_remarks.
      APPEND ls_text TO lt_text.
    ENDIF.

    CALL METHOD lo_editor->set_text_as_r3table
      EXPORTING
        table = lt_text.

*--- statusbar in text-control
    CALL METHOD lo_editor->set_statusbar_mode
      EXPORTING
        statusbar_mode = lc_true.

*--- toolbar in text-control
    CALL METHOD lo_editor->set_toolbar_mode
      EXPORTING
        toolbar_mode = lc_true.

*--- display only
    CALL METHOD lo_editor->set_readonly_mode
      EXPORTING
        readonly_mode          = lc_true
      EXCEPTIONS
        error_cntl_call_method = 1
        invalid_parameter      = 2
        OTHERS                 = 3.

    CALL METHOD lo_editor->flush.

    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* INPUT / EDIT MODE
*---------------------------------------------------------------------*
  CALL METHOD lo_editor->get_text_as_r3table
    IMPORTING
      table = lt_text.

*--- statusbar in text-control
  CALL METHOD lo_editor->set_statusbar_mode
    EXPORTING
      statusbar_mode = lc_true.

*--- toolbar in text-control
  CALL METHOD lo_editor->set_toolbar_mode
    EXPORTING
      toolbar_mode = lc_true.

  CALL METHOD lo_editor->flush.

  CLEAR gv_z_remarks.

  LOOP AT lt_text INTO ls_text.
    IF gv_z_remarks IS INITIAL.
      gv_z_remarks = ls_text-text.
    ELSE.
      CONCATENATE gv_z_remarks
                  ls_text-text
             INTO gv_z_remarks
        SEPARATED BY cl_abap_char_utilities=>newline.
    ENDIF.
  ENDLOOP.

*---------------------------------------------------------------------*
* Additional Lines Check
*---------------------------------------------------------------------*
  IF lines( lt_text ) > lv_rlines.
    READ TABLE lt_text INTO ls_text INDEX ( lv_rlines + 1 ).
    IF ls_text IS INITIAL.
      DELETE lt_text INDEX ( lv_rlines + 1 ).
    ENDIF.
  ENDIF.

ENDFORM.