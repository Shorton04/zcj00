DATA: lt_bpge TYPE SORTED TABLE OF bpge
                WITH UNIQUE KEY objnr wrttp versn gjahr lednr.

FIELD-SYMBOLS:
  <fs_wbs_item> TYPE ztb_a2r_wbsitem.

"Get BPGE records only for WBS entries with OBJNR
IF gt_wbs_items IS NOT INITIAL.

  SELECT objnr,
         wrttp,
         versn,
         gjahr,
         lednr,
         geber
    FROM bpge
    INTO TABLE @lt_bpge
    FOR ALL ENTRIES IN @gt_wbs_items
    WHERE objnr = @gt_wbs_items-objnr
      AND wrttp = '41'.   "budget values

  IF sy-subrc = 0.

    LOOP AT gt_wbs_items ASSIGNING <fs_wbs_item>.

      CLEAR <fs_wbs_item>-zbudget_check.

      "Find max LEDNR with GEBER not initial
      DATA(lv_max_lednr) = VALUE bpge-lednr( ).

      LOOP AT lt_bpge INTO DATA(ls_bpge)
        WHERE objnr = <fs_wbs_item>-objnr
          AND geber IS NOT INITIAL.

        IF lv_max_lednr IS INITIAL
           OR ls_bpge-lednr > lv_max_lednr.
          lv_max_lednr = ls_bpge-lednr.
        ENDIF.

      ENDLOOP.

      IF lv_max_lednr IS NOT INITIAL.
        <fs_wbs_item>-zbudget_check = 'X'.
      ENDIF.

    ENDLOOP.

  ENDIF.

ENDIF.