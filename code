*---------------------------------------------------------------------*
* Workflow Log
*---------------------------------------------------------------------*
TYPES: BEGIN OF ty_wflog,
         wi_id         TYPE sww_wiid,
         top_wi_id     TYPE sww_wiid,
         wi_text       TYPE char80,
         agent         TYPE syuname,
         status        TYPE char30,
         created_on    TYPE sydatum,
         created_at    TYPE syuzeit,
         completed_on  TYPE sydatum,
         completed_at  TYPE syuzeit,
       END OF ty_wflog.

DATA: gt_wflog TYPE STANDARD TABLE OF ty_wflog,
      gs_wflog TYPE ty_wflog.

DATA: gv_top_wi_id TYPE sww_wiid.





MODULE user_command_0200 INPUT.

  CASE sy-ucomm.
    WHEN 'WFLOG'.
      PERFORM show_workflow_log.
  ENDCASE.

ENDMODULE.




FORM show_workflow_log.

  DATA: lv_top_wi_id TYPE sww_wiid.

  CLEAR: gt_wflog, gv_top_wi_id.

*---------------------------------------------------------------------*
* Read saved top workflow ID from request header
*---------------------------------------------------------------------*
  SELECT SINGLE ztop_wi_id
    INTO @lv_top_wi_id
    FROM ztb_a2r_wbshdr
    WHERE zreq_num = @gs_header-zreq_num.

  IF sy-subrc <> 0 OR lv_top_wi_id IS INITIAL.
    MESSAGE 'No workflow log found for this request' TYPE 'I'.
    RETURN.
  ENDIF.

  gv_top_wi_id = lv_top_wi_id.

*---------------------------------------------------------------------*
* Build workflow log
*---------------------------------------------------------------------*
  PERFORM get_workflow_log USING    gv_top_wi_id
                           CHANGING gt_wflog.

  IF gt_wflog IS INITIAL.
    MESSAGE 'Workflow log is empty' TYPE 'I'.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* Display popup ALV
*---------------------------------------------------------------------*
  PERFORM display_workflow_log_popup.

ENDFORM.




FORM get_workflow_log USING    iv_top_wi_id TYPE sww_wiid
                      CHANGING ct_wflog     TYPE STANDARD TABLE.

  DATA: lt_worklist      TYPE STANDARD TABLE OF swr_wihdr,
        ls_worklist      TYPE swr_wihdr,
        lt_message_lines TYPE STANDARD TABLE OF swr_messag,
        lt_message_struc TYPE STANDARD TABLE OF swr_mstruc,
        lv_return_code   TYPE sy-subrc,
        ls_wflog         TYPE ty_wflog.

  FIELD-SYMBOLS: <lv_workitemid> TYPE any.

  CLEAR ct_wflog.

*---------------------------------------------------------------------*
* Read top workitem itself
*---------------------------------------------------------------------*
  CLEAR ls_wflog.
  PERFORM read_single_wi_log USING    iv_top_wi_id
                             CHANGING ls_wflog.

  IF ls_wflog-wi_id IS NOT INITIAL.
    APPEND ls_wflog TO ct_wflog.
  ENDIF.

*---------------------------------------------------------------------*
* Read child workitems
*---------------------------------------------------------------------*
  CALL FUNCTION 'SAP_WAPI_GET_CHILD_WORKITEMS'
    EXPORTING
      workitem_id = iv_top_wi_id
      user        = sy-uname
      text        = abap_true
      language    = sy-langu
    IMPORTING
      return_code = lv_return_code
    TABLES
      worklist       = lt_worklist
      message_lines  = lt_message_lines
      message_struct = lt_message_struc.

  IF lv_return_code <> 0.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* Read each child workitem log
*---------------------------------------------------------------------*
  LOOP AT lt_worklist INTO ls_worklist.

    UNASSIGN <lv_workitemid>.
    ASSIGN COMPONENT 'WORKITEMID' OF STRUCTURE ls_worklist TO <lv_workitemid>.
    IF sy-subrc <> 0 OR <lv_workitemid> IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_wflog.

    PERFORM read_single_wi_log USING    <lv_workitemid>
                               CHANGING ls_wflog.

    IF ls_wflog-wi_id IS NOT INITIAL.
      APPEND ls_wflog TO ct_wflog.
    ENDIF.

  ENDLOOP.

*---------------------------------------------------------------------*
* Remove duplicate top WI if ever returned again
*---------------------------------------------------------------------*
  SORT ct_wflog BY wi_id.
  DELETE ADJACENT DUPLICATES FROM ct_wflog COMPARING wi_id.

  SORT ct_wflog BY created_on created_at wi_id.

ENDFORM.




FORM read_single_wi_log USING    iv_wi_id   TYPE sww_wiid
                        CHANGING cs_wflog   TYPE ty_wflog.

  DATA: ls_header        TYPE swr_wihdr,
        lt_message_lines TYPE STANDARD TABLE OF swr_messag,
        lt_message_struc TYPE STANDARD TABLE OF swr_mstruc,
        lv_return_code   TYPE sy-subrc,
        lt_wiids         TYPE swrtwiid,
        lt_wi_agents     TYPE swrtwiagent,
        lv_timestamp     TYPE timestampl.

  FIELD-SYMBOLS: <lv_val>   TYPE any,
                 <ls_agent> TYPE any,
                 <lv_objid> TYPE any,
                 <lv_user>  TYPE any.

  CLEAR cs_wflog.

*---------------------------------------------------------------------*
* Get header of one workitem
*---------------------------------------------------------------------*
  CALL FUNCTION 'SAP_WAPI_GET_HEADER'
    EXPORTING
      workitem_id       = iv_wi_id
      user              = sy-uname
      language          = sy-langu
      translate_texts   = abap_true
    IMPORTING
      workitem_attributes = ls_header
      return_code         = lv_return_code
    TABLES
      message_lines       = lt_message_lines
      message_struct      = lt_message_struc.

  IF lv_return_code <> 0.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* Move header values dynamically from SWR_WIHDR
*---------------------------------------------------------------------*
  UNASSIGN <lv_val>.
  ASSIGN COMPONENT 'WORKITEMID' OF STRUCTURE ls_header TO <lv_val>.
  IF sy-subrc = 0.
    cs_wflog-wi_id = <lv_val>.
  ELSE.
    cs_wflog-wi_id = iv_wi_id.
  ENDIF.

  cs_wflog-top_wi_id = iv_wi_id.

  UNASSIGN <lv_val>.
  ASSIGN COMPONENT 'WI_TEXT' OF STRUCTURE ls_header TO <lv_val>.
  IF sy-subrc = 0.
    cs_wflog-wi_text = <lv_val>.
  ENDIF.

  UNASSIGN <lv_val>.
  ASSIGN COMPONENT 'WI_STAT' OF STRUCTURE ls_header TO <lv_val>.
  IF sy-subrc = 0.
    PERFORM get_wi_status_text USING    <lv_val>
                               CHANGING cs_wflog-status.
  ENDIF.

  UNASSIGN <lv_val>.
  ASSIGN COMPONENT 'WI_CD' OF STRUCTURE ls_header TO <lv_val>.
  IF sy-subrc = 0.
    cs_wflog-created_on = <lv_val>.
  ENDIF.

  UNASSIGN <lv_val>.
  ASSIGN COMPONENT 'WI_CT' OF STRUCTURE ls_header TO <lv_val>.
  IF sy-subrc = 0.
    cs_wflog-created_at = <lv_val>.
  ENDIF.

  UNASSIGN <lv_val>.
  ASSIGN COMPONENT 'WI_AED' OF STRUCTURE ls_header TO <lv_val>.
  IF sy-subrc = 0.
    cs_wflog-completed_on = <lv_val>.
  ENDIF.

  UNASSIGN <lv_val>.
  ASSIGN COMPONENT 'WI_AET' OF STRUCTURE ls_header TO <lv_val>.
  IF sy-subrc = 0.
    cs_wflog-completed_at = <lv_val>.
  ENDIF.

*---------------------------------------------------------------------*
* Get top workitem id from header if available
*---------------------------------------------------------------------*
  UNASSIGN <lv_val>.
  ASSIGN COMPONENT 'TOP_WI_ID' OF STRUCTURE ls_header TO <lv_val>.
  IF sy-subrc = 0 AND <lv_val> IS NOT INITIAL.
    cs_wflog-top_wi_id = <lv_val>.
  ENDIF.

*---------------------------------------------------------------------*
* Get agent of one workitem
*---------------------------------------------------------------------*
  CLEAR lt_wiids.
  APPEND iv_wi_id TO lt_wiids.

  CLEAR: lt_message_lines, lt_message_struc, lv_return_code, lt_wi_agents, lv_timestamp.

  CALL FUNCTION 'SAP_WAPI_GET_WI_AGENTS'
    EXPORTING
      language         = sy-langu
      workitems        = lt_wiids
      user             = sy-uname
      with_substitutes = abap_false
      do_commit        = abap_false
    IMPORTING
      return_code      = lv_return_code
      timestamp        = lv_timestamp
      wi_agents        = lt_wi_agents
    TABLES
      message_lines    = lt_message_lines
      message_struct   = lt_message_struc.

  IF lv_return_code = 0.
    READ TABLE lt_wi_agents ASSIGNING <ls_agent> INDEX 1.
    IF sy-subrc = 0.

      UNASSIGN <lv_objid>.
      ASSIGN COMPONENT 'OBJID' OF STRUCTURE <ls_agent> TO <lv_objid>.
      IF sy-subrc = 0 AND <lv_objid> IS NOT INITIAL.
        cs_wflog-agent = <lv_objid>.
      ELSE.
        UNASSIGN <lv_user>.
        ASSIGN COMPONENT 'USER_ID' OF STRUCTURE <ls_agent> TO <lv_user>.
        IF sy-subrc = 0 AND <lv_user> IS NOT INITIAL.
          cs_wflog-agent = <lv_user>.
        ENDIF.
      ENDIF.

    ENDIF.
  ENDIF.

ENDFORM.




FORM get_wi_status_text USING    iv_stat TYPE any
                        CHANGING cv_text TYPE char30.

  CASE iv_stat.
    WHEN 'READY'.
      cv_text = 'Ready'.
    WHEN 'STARTED'.
      cv_text = 'In Process'.
    WHEN 'COMPLETED'.
      cv_text = 'Completed'.
    WHEN 'CANCELLED'.
      cv_text = 'Cancelled'.
    WHEN 'ERROR'.
      cv_text = 'Error'.
    WHEN OTHERS.
      cv_text = iv_stat.
  ENDCASE.

ENDFORM.



FORM display_workflow_log_popup.

  DATA: lt_fcat   TYPE slis_t_fieldcat_alv,
        ls_layout TYPE slis_layout_alv.

  PERFORM build_wflog_fieldcat CHANGING lt_fcat.

  ls_layout-zebra             = abap_true.
  ls_layout-colwidth_optimize = abap_true.

  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
    EXPORTING
      i_callback_program    = sy-repid
      is_layout             = ls_layout
      it_fieldcat           = lt_fcat
      i_screen_start_column = 10
      i_screen_start_line   = 5
      i_screen_end_column   = 180
      i_screen_end_line     = 25
    TABLES
      t_outtab              = gt_wflog
    EXCEPTIONS
      program_error         = 1
      OTHERS                = 2.

ENDFORM.




FORM build_wflog_fieldcat CHANGING ct_fcat TYPE slis_t_fieldcat_alv.

  DATA: ls_fcat TYPE slis_fieldcat_alv.

  CLEAR ct_fcat.

  DEFINE add_fcat.
    CLEAR ls_fcat.
    ls_fcat-fieldname = &1.
    ls_fcat-seltext_l = &2.
    ls_fcat-seltext_m = &2.
    ls_fcat-seltext_s = &2.
    ls_fcat-outputlen = &3.
    APPEND ls_fcat TO ct_fcat.
  END-OF-DEFINITION.

  add_fcat 'WI_ID'         'Workitem'      12.
  add_fcat 'TOP_WI_ID'     'Top WI'        12.
  add_fcat 'WI_TEXT'       'Step Text'     40.
  add_fcat 'AGENT'         'Agent'         15.
  add_fcat 'STATUS'        'Status'        20.
  add_fcat 'CREATED_ON'    'Created On'    10.
  add_fcat 'CREATED_AT'    'Created At'    8.
  add_fcat 'COMPLETED_ON'  'Completed On'  10.
  add_fcat 'COMPLETED_AT'  'Completed At'  8.

ENDFORM.




ZTOP_WI_ID TYPE SWW_WIID


UPDATE ztb_a2r_wbshdr
   SET ztop_wi_id = @lv_top_wi_id
 WHERE zreq_num   = @gs_header-zreq_num.