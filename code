  METHOD save_bapi_and_release.

* Call the Order save BAPI for an order
* Check release flag and release order as well.
* When the release fails, try again to save the order
* without releasing it
*
    DATA lt_method                TYPE bapi_alm_order_method_t.
    DATA lt_return                TYPE bapirettab.
    DATA lt_message               TYPE /plmb/t_spi_msg.
    DATA lv_failed                TYPE xfeld.
    DATA lv_message               TYPE c LENGTH 1.          "#EC NEEDED
    DATA lo_requirements_api      TYPE REF TO cl_eamws_requirements_api.
    DATA ls_caufvd                TYPE caufvd. " EAMS4 note 2084700

    DATA lv_counter               TYPE i.                                           " note  2156528

    FIELD-SYMBOLS <ls_method>     TYPE bapi_alm_order_method.                                         "MFLE CHECKED
    FIELD-SYMBOLS <ls_node_id>    LIKE LINE OF it_node_id.

* init:
    CLEAR: et_message, et_saved_ord, et_saved_ntf.

    cl_eam_usage=>set_fiori_state( iv_active = abap_true ).                         "n3561841

    IF iv_release NE space.
      LOOP AT it_node_id ASSIGNING <ls_node_id>.
* EAMS4 note 2084700
        CALL FUNCTION 'CO_BT_CAUFV_READ_WITH_KEY'
          EXPORTING
            aufnr_act      = <ls_node_id>-eams_aufnr
            no_dialog_info = space
            flg_stat       = 'X'
          IMPORTING
            caufvd_exp     = ls_caufvd
          EXCEPTIONS
            not_found      = 1
            OTHERS         = 2.
        IF sy-subrc EQ 0.
          CALL FUNCTION 'STATUS_CHECK'
            EXPORTING
              objnr             = ls_caufvd-objnr
              status            = 'I0045'
            EXCEPTIONS
              object_not_found  = 1
              status_not_active = 2
              OTHERS            = 3.

          IF sy-subrc EQ 0.
            " Order has status technically completed
*<note 2156528>
            READ TABLE mt_add_teco_data_before_save INTO ms_teco_data_before_save
            WITH KEY aufnr = ls_caufvd-aufnr.
            IF sy-subrc EQ 0.
              DELETE TABLE mt_add_teco_data_before_save FROM ms_teco_data_before_save.
            ENDIF.
*</note 2156528>
            CONTINUE.
          ENDIF.

          CALL FUNCTION 'STATUS_CHECK'
            EXPORTING
              objnr             = ls_caufvd-objnr
              status            = 'I0002'
            EXCEPTIONS
              object_not_found  = 1
              status_not_active = 2
              OTHERS            = 3.

          IF sy-subrc EQ 0.
            " Order has status released
            CONTINUE.
          ENDIF.

        ENDIF.
* /EAMS4 note 2084700
        APPEND INITIAL LINE TO lt_method ASSIGNING <ls_method>.
        <ls_method>-method     = if_eams_bo_const=>gc_bapi_ord_method-release.
        <ls_method>-objecttype = if_eams_bo_const=>gc_bapi_ord_obj_type-header.
        <ls_method>-objectkey  = <ls_node_id>-eams_aufnr.
      ENDLOOP.
    ENDIF.

*<note 2156528>
*    IF mt_add_teco_data_before_save IS NOT INITIAL.
*      LOOP AT it_node_id ASSIGNING <ls_node_id>.
*
*        CLEAR ms_teco_data_before_save.
*        READ TABLE mt_add_teco_data_before_save INTO ms_teco_data_before_save
*          WITH KEY aufnr = <ls_node_id>-eams_aufnr.
*        IF sy-subrc EQ 0.
*          CALL FUNCTION 'CO_BT_CAUFV_READ_WITH_KEY'
*            EXPORTING
*              aufnr_act      = <ls_node_id>-eams_aufnr
*              no_dialog_info = space
*              flg_stat       = 'X'
*            IMPORTING
*              caufvd_exp     = ls_caufvd
*            EXCEPTIONS
*              not_found      = 1
*              OTHERS         = 2.
*          IF sy-subrc EQ 0.
*            CALL FUNCTION 'STATUS_CHECK'
*              EXPORTING
*                objnr             = ls_caufvd-objnr
*                status            = 'I0045'
*              EXCEPTIONS
*                object_not_found  = 1
*                status_not_active = 2
*                OTHERS            = 3.
*            IF sy-subrc EQ 0.
*              " Order has status technically completed
*              DELETE TABLE mt_add_teco_data_before_save FROM ms_teco_data_before_save.
*              CONTINUE.
*            ENDIF.
**<note 2299689>
** check if object is not release on DB => unplanned confirmation
*            CALL FUNCTION 'STATUS_CHECK'
*              EXPORTING
*                bypass_buffer     = abap_true
*                objnr             = ls_caufvd-objnr
*                status            = 'I0002'
*              EXCEPTIONS
*                object_not_found  = 1
*                status_not_active = 2
*                OTHERS            = 3.
*            IF sy-subrc <> 0.
** Order is not released on DB -> unplanned confirmation
** now we check if a technical completion is possible by status handling
*              CALL FUNCTION 'STATUS_CHANGE_FOR_ACTIVITY'
*                EXPORTING
*                  check_only = abap_true
*                  objnr      = ls_caufvd-objnr
*                  vrgng      = 'BTAB'
*                EXCEPTIONS
*                  OTHERS     = 1.
*              IF sy-subrc <> 0.
*                DELETE TABLE mt_add_teco_data_before_save FROM ms_teco_data_before_save.
*                APPEND INITIAL LINE TO et_message ASSIGNING FIELD-SYMBOL(<fs_message>).
*                "Order &1 could not be technically completed
*                MESSAGE w166(iwo_bapi) WITH space INTO <fs_message>-msgv1.
*                <fs_message>-msgty = sy-msgty.
*                <fs_message>-msgid = sy-msgid.
*                <fs_message>-msgno = sy-msgno.
*                <fs_message>-msgv1 = sy-msgv1.
*                CONTINUE.
*              ENDIF.
*            ENDIF.
**</note 2299689>
*          ENDIF.
*
*          APPEND INITIAL LINE TO lt_method ASSIGNING <ls_method>.
*          <ls_method>-method     = ms_teco_data_before_save-method.
*          <ls_method>-objecttype = ms_teco_data_before_save-objecttype.
*          <ls_method>-objectkey  = ms_teco_data_before_save-objectkey.
*
*          IF ms_teco_data_before_save-ref_date IS NOT INITIAL
*          OR ms_teco_data_before_save-ref_time IS NOT INITIAL.
*            ADD 1 TO lv_counter.
*            <ls_method>-refnumber  = lv_counter.
*            APPEND INITIAL LINE TO lt_header ASSIGNING <ls_header>.
*            <ls_header>-teco_ref_date = ms_teco_data_before_save-ref_date.
*            <ls_header>-teco_ref_time = ms_teco_data_before_save-ref_time.
*            <ls_header>-orderid = ms_teco_data_before_save-aufnr.
*
*            DELETE TABLE mt_add_teco_data_before_save FROM ms_teco_data_before_save.
*          ENDIF.
*        ENDIF.
*      ENDLOOP.
*    ENDIF.
*</note 2156528>


    APPEND INITIAL LINE TO lt_method ASSIGNING <ls_method>.
    <ls_method>-method = if_eams_bo_const=>gc_bapi_ord_method-save.

    DATA(lt_extension_in) = VALUE bapiparextab( ( structure  = if_eams_bo_order=>ext_in_save_structure
                                                  valuepart1 = if_eams_bo_order=>ext_in_save_save
                                                  valuepart2 = if_eams_bo_order=>ext_in_save_class ) ).

    DATA lt_header    TYPE STANDARD TABLE OF  bapi_alm_order_headers_i.
    DATA lt_header_up TYPE STANDARD TABLE OF  bapi_alm_order_headers_up.

    LOOP AT it_node_id ASSIGNING <ls_node_id>.
      APPEND INITIAL LINE TO lt_header REFERENCE INTO DATA(header).
      header->orderid = <ls_node_id>-eams_aufnr.
      APPEND INITIAL LINE TO lt_header_up REFERENCE INTO DATA(header_update).
      header_update->orderid = <ls_node_id>-eams_aufnr.
    ENDLOOP.

* Save the order
    CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
      EXPORTING
        iv_mmsrv_external_maintenace = abap_true "changes LE for MMSRV
      TABLES
        it_methods                   = lt_method
        it_header                    = lt_header
        it_header_up                 = lt_header_up
        extension_in                 = lt_extension_in
        et_numbers                   = et_saved_ord
        et_notification_numbers      = et_saved_ntf
        return                       = lt_return.
*>>> Start of note 3279402
* Do not ignore budget check warning message BP 614 (see customizing V_TBPFD_P)
    DATA lt_msgprot TYPE STANDARD TABLE OF cmfmsg.
    DATA ls_message LIKE LINE OF et_message.
    FIELD-SYMBOLS <ls_msgprot>    LIKE LINE OF lt_msgprot.
    CALL FUNCTION 'CM_F_MESSAGES_GET'
      TABLES
        e_msgprot  = lt_msgprot
      EXCEPTIONS
        not_active = 1
        OTHERS     = 2.
    IF sy-subrc EQ 0.
* Get the budget check message unless it is a hard error (MSGTY = 'E').
* Hard errors are always handled by the lower API, they can be ignored here.
      LOOP AT lt_msgprot ASSIGNING <ls_msgprot> WHERE arbgb EQ 'BP'
                                                  AND msgnr BETWEEN '600' AND '650' "n3319874
*                                                 AND msgnr EQ '614'                "rem3319874
                                                  AND msgty NE 'E'.
        MOVE-CORRESPONDING <ls_msgprot> TO ls_message.
        MOVE <ls_msgprot>-arbgb TO ls_message-msgid.
        MOVE <ls_msgprot>-msgnr TO ls_message-msgno.
        APPEND ls_message TO lt_message.
*       EXIT.                                                                       "rem3319874
      ENDLOOP.
    ENDIF.
*<<< End of note 3279402
    IF lt_return IS NOT INITIAL.
      me->clean_bapiret_order_maintain(
        CHANGING
          ct_return = lt_return ).
      cl_eams_bo_misc_factory=>get_eams_bo_srv_class( )->set_bapiret2_message(
        EXPORTING it_bapiret = lt_return
                  iv_msg_index = 0
        CHANGING  ct_message = lt_message ). " save does not need ID -> index 0
      cl_eams_bo_misc_factory=>get_eams_bo_srv_class( )->get_severity_level(
        EXPORTING
          it_message       = lt_message
        IMPORTING
          ev_has_abort_msg = lv_failed ).

      IF lv_failed EQ abap_true.
* Special case 'Release rejected'
        READ TABLE lt_return TRANSPORTING NO FIELDS
        WITH KEY number = '009'
                 id     = 'C2'
                 type   = 'E'.
        IF sy-subrc NE 0.
          APPEND LINES OF lt_message TO et_message.
          RETURN.
        ELSE.
* Release rejected->Try to save again without release
          DELETE lt_method
            WHERE method = if_eams_bo_const=>gc_bapi_ord_method-release.
          CLEAR lt_return.
          CLEAR et_saved_ord.
          CLEAR et_saved_ntf.
          CLEAR lt_message.
          CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
            TABLES
              it_methods              = lt_method
              et_numbers              = et_saved_ord
              et_notification_numbers = et_saved_ntf
              return                  = lt_return.
          IF lt_return IS NOT INITIAL.
            me->clean_bapiret_order_maintain(
              CHANGING
                ct_return = lt_return ).
            cl_eams_bo_misc_factory=>get_eams_bo_srv_class( )->set_bapiret2_message(
              EXPORTING it_bapiret = lt_return
                        iv_msg_index = 0
              CHANGING  ct_message = lt_message ). " save does not need ID -> index 0
            cl_eams_bo_misc_factory=>get_eams_bo_srv_class( )->get_severity_level(
              EXPORTING
                it_message       = lt_message
              IMPORTING
                ev_has_abort_msg = lv_failed ).
            IF lv_failed EQ abap_true.
* Special case 'Release rejected'
              APPEND LINES OF lt_message TO et_message.
              RETURN.
            ENDIF.
          ENDIF. "Second try has messages
* Order was saved successful without release. Add warning for one of the orders
          IF lines( it_node_id ) = 1.
            MESSAGE w129(eams_bo) WITH <ls_node_id>-eams_aufnr INTO lv_message.
          ELSE.
            MESSAGE w129(eams_bo) WITH space INTO lv_message.
          ENDIF.
          cl_eams_bo_misc_factory=>get_eams_bo_srv_class( )->set_message(
            EXPORTING
              iv_msg_index = 0
            CHANGING
              ct_message   = et_message ).
        ENDIF. "Release rejected detected
      ENDIF. "BAPI save failed
    ENDIF. "BAPI save has return messages

    IF et_message IS INITIAL AND lt_message IS NOT INITIAL.  " EAMS4 note 2084700
      et_message = lt_message.                               " EAMS4 note 2084700
    ENDIF.                                                   " EAMS4 note 2084700

* Save requirements. Call save API without OBJNR -> Save all data
    lo_requirements_api = cl_eamws_requirements_api=>s_get_instance( ).
    lo_requirements_api->save(
      IMPORTING
        et_return = lt_return ).

* Messages handling
    IF lt_return IS NOT INITIAL.
      cl_eams_bo_misc_factory=>get_eams_bo_srv_class( )->set_bapiret2_message(
        EXPORTING
          it_bapiret = lt_return
        CHANGING
          ct_message = et_message ).
    ENDIF.

* Note 2203440 *******************************************************
    LOOP AT et_saved_ord ASSIGNING FIELD-SYMBOL(<_fs_saved_ord>).
      CHECK <_fs_saved_ord>-aufnr_in <> <_fs_saved_ord>-aufnr_new.

      CALL FUNCTION 'CO_BT_CAUFV_READ_WITH_KEY'
        EXPORTING
          aufnr_act  = <_fs_saved_ord>-aufnr_new
        IMPORTING
          caufvd_exp = ls_caufvd
        EXCEPTIONS
          OTHERS     = 9.

      CHECK ls_caufvd-adrnra IS NOT INITIAL.

      cl_eams_bo_misc_factory=>get_eams_bo_address_class( )->update_reference(
        EXPORTING
          is_addr_id      = VALUE #( eams_adrnr = ls_caufvd-adrnra )
          is_old_addr_ref = VALUE #( appl_table = 'AUFK' appl_field = 'ADRNR' appl_key = sy-mandt && <_fs_saved_ord>-aufnr_in  addr_group = 'PM01' )
          is_new_addr_ref = VALUE #( appl_table = 'AUFK' appl_field = 'ADRNR' appl_key = sy-mandt && <_fs_saved_ord>-aufnr_new addr_group = 'PM01' )
      ).
    ENDLOOP.
*/Note 2203440 *******************************************************


  ENDMETHOD.


  METHOD check_before_save.
* Dummy modify of Order to check data consistency:
* Do an order change header BAPI call before save to make
* sure the header data are transferred to the backend and
* are checked when no field has beed changed by the user on
* the screen.

    DATA lt_return          TYPE bapirettab.
    DATA lt_message         LIKE et_message.
    DATA lt_method          TYPE bapi_alm_order_method_t.    "MFLE CHECKED
    DATA lt_order_headers   TYPE bapi_alm_order_headers_i_t. "MFLE CHECKED
    DATA lt_operations      TYPE bapi_alm_order_operation_t. "MFLE CHECKED
    DATA lv_failed          TYPE abap_bool.
    DATA lv_ntf_header_chg  TYPE abap_bool.
    DATA lt_node_id         TYPE eams_t_bo_ord_id.
    DATA lt_node_data       TYPE eams_t_bo_ord_header.
    DATA lt_node_id_ntf     TYPE eams_t_bo_ntf_id.
    DATA lt_node_data_ntf   TYPE eams_t_bo_ntf_header.
    DATA lv_onw_handle      TYPE cl_eams_bo_interop=>ty_onw_handle. " handle for Order Network processing
    DATA lv_onw_id          TYPE cl_eams_bo_interop=>ty_onw_id. " ID of an Order Network
    DATA lv_objnr           TYPE j_objnr.
    DATA ls_caufvd          TYPE caufvd.                   "note 2753103
    DATA lv_refnr           TYPE ifrefnum.                 "note 2753103
    DATA ls_t350            TYPE t350.                      "3293406
    DATA continue           TYPE xfeld.                     "3293406
    DATA lv_trtyp           TYPE tc10-trtyp.                "3293406
    DATA lv_continue_saving TYPE abap_bool.
    DATA lv_is_modifiable   TYPE abap_bool.
    DATA lt_msg             TYPE tsmesg.                    "3554286

* variables for MES check
    DATA lr_mes           TYPE REF TO cl_im_co_mes_integrat_pm.
    DATA ls_header        TYPE cobai_s_header_dialog.

    DATA: lt_caufvdg TYPE STANDARD TABLE OF caufvdget,
          lt_caufvbo TYPE STANDARD TABLE OF caufvdb.

    FIELD-SYMBOLS <ls_method>        LIKE LINE OF lt_method.
    FIELD-SYMBOLS <ls_order_headers> LIKE LINE OF lt_order_headers. "MFLE CHECKED
    FIELD-SYMBOLS <ls_node_id>       LIKE LINE OF lt_node_id.
    FIELD-SYMBOLS <ls_node_data>     LIKE LINE OF lt_node_data.
    FIELD-SYMBOLS <ls_node_id_ntf>   LIKE LINE OF lt_node_id_ntf.
    FIELD-SYMBOLS <ls_node_data_ntf> LIKE LINE OF lt_node_data_ntf.
    FIELD-SYMBOLS <ls_message>       TYPE /plmb/s_spi_msg. "note 2753103
    FIELD-SYMBOLS <ls_msg>           TYPE mesg.                "3554286


    CLEAR lt_return.
    CLEAR et_node_data.

* Add the order header change with detail table
    lv_onw_handle = cl_eams_bo_misc_factory=>get_eams_bo_interop_class( )->get_onw_handle( ). " get handle for Order Network processing

* process all networks with modified Order:
    WHILE cl_eams_bo_misc_factory=>get_eams_bo_interop_class( )->get_next_onw_w_modified_order( lv_onw_handle ) IS NOT INITIAL.

      TEST-SEAM temp_check_before_save01.
        lv_onw_id = cl_eams_bo_misc_factory=>get_eams_bo_interop_class( )->get_current_onw( lv_onw_handle ). " get current network of handle

*   check whether current Order can be modified:
        lv_is_modifiable = abap_true.
        cl_eams_bo_misc_factory=>get_eams_bo_interop_class( )->get_order_attr(
          EXPORTING iv_order_id = cl_eams_bo_misc_factory=>get_eams_bo_interop_class( )->get_onw_order_id( lv_onw_id )
          IMPORTING ev_objnr    = lv_objnr
        ).
        IF
            has_object_status( iv_objnr  = lv_objnr iv_status = if_eams_bo_const=>gc_status-lkd ) = abap_true OR " Order is locked * EAMS3 NOTE 2010961
          has_object_status( iv_objnr  = lv_objnr iv_status = if_eams_bo_const=>gc_status-teco ) = abap_true OR " Order is technically completed
            has_object_status( iv_objnr  = lv_objnr iv_status = if_eams_bo_const=>gc_status-clsd ) = abap_true OR   " Order is business completed
            has_object_status( iv_objnr  = lv_objnr iv_status = if_eams_bo_const=>gc_status-dlt ) = abap_true.  " Order has set deletion indicator * EAMS3 NOTE 2010961
*     if the Order is completed or Locked, it can not be modified any longer:
          lv_is_modifiable = abap_false.
        ENDIF.
      END-TEST-SEAM.
*   if the Order is not modifiable, it has not to be checked, because it was already checked during completion:
      IF lv_is_modifiable = abap_true.
        TEST-SEAM temp_check_before_save02.
*     set up BAPI data to modify Order Header:
          APPEND INITIAL LINE TO lt_method ASSIGNING <ls_method>.
          <ls_method>-method     = if_eams_bo_const=>gc_bapi_ord_method-change.
          <ls_method>-objecttype = if_eams_bo_const=>gc_bapi_ord_obj_type-header.
          <ls_method>-objectkey  = cl_eams_bo_misc_factory=>get_eams_bo_interop_class( )->get_onw_order_id( lv_onw_id ).
          APPEND INITIAL LINE TO lt_order_headers ASSIGNING <ls_order_headers>.
          <ls_method>-refnumber  = sy-tabix.
          <ls_method>-objecttype = if_eams_bo_const=>gc_bapi_ord_obj_type-header.
          <ls_order_headers>-orderid = cl_eams_bo_misc_factory=>get_eams_bo_interop_class( )->get_onw_order_id( lv_onw_id ).
*     save new order in node table:
          APPEND INITIAL LINE TO lt_node_id ASSIGNING <ls_node_id>.
          <ls_node_id>-eams_aufnr = cl_eams_bo_misc_factory=>get_eams_bo_interop_class( )->get_onw_order_id( lv_onw_id ).

* start note 2753103 ********************
          "Get header data to check, if WBS-Element is filled
          CALL FUNCTION 'CO_BT_CAUFV_READ_WITH_KEY'
            EXPORTING
              aufnr_act  = <ls_order_headers>-orderid
            IMPORTING
              caufvd_exp = ls_caufvd
            EXCEPTIONS
              not_found  = 1
              OTHERS     = 2.

          IF  sy-subrc IS INITIAL
          AND ls_caufvd-pspel IS NOT INITIAL
          AND ls_caufvd-autyp EQ if_eams_bo_const=>gc_order_category. "'30'
            "Insert method for calculation as a prerequisition for the budget check
            lv_refnr = <ls_method>-refnumber.
            APPEND INITIAL LINE TO lt_method ASSIGNING <ls_method>.
            <ls_method>-method     = if_eams_bo_const=>gc_bapi_ord_method-calculate.
            <ls_method>-objecttype = if_eams_bo_const=>gc_bapi_ord_obj_type-header.
            <ls_method>-objectkey  = cl_eams_bo_misc_factory=>get_eams_bo_interop_class( )->get_onw_order_id( lv_onw_id ).
            <ls_method>-refnumber  = lv_refnr + 1.
          ENDIF.
* end note 2753103 **********************
        END-TEST-SEAM.
        "Start: Check if relationships with cycles exist (existing check during save in CO_ZF_ORDER_SCHEDULE is too late)
        IF sy-subrc IS INITIAL.
          DATA: caufvd_exp TYPE  caufvd,
                tcx00      TYPE tcx00.

          TEST-SEAM temp_check_before_save03.

            CALL FUNCTION 'TCX00_READ'
              EXPORTING
                i_werks           = ls_caufvd-werks
                i_autyp           = ls_caufvd-autyp
                i_aufta           = ls_caufvd-auart
                i_vagrp           = ls_caufvd-fevor
              IMPORTING
                tcx00_exp         = tcx00
              EXCEPTIONS
                no_entry          = 01
                missing_parameter = 2
                OTHERS            = 3.

* Validate requirement date change for components which has an existive delivery document
            IF ls_caufvd-autyp EQ if_eams_bo_const=>gc_order_category.
              CALL METHOD cl_eam_ewm_integration_util=>validate_requirement_date
                EXPORTING
                  is_caufvd              = ls_caufvd
                  iv_skip_check_for_date = abap_true
                IMPORTING
                  ev_rspos               = DATA(lv_rspos)
                EXCEPTIONS
                  update_reject          = 1
                  OTHERS                 = 2.
              IF sy-subrc NE 0.
                CALL FUNCTION 'CO_BH_GET_ORDERS'
                  EXPORTING
                    no_dialog_info = 'X'
                    get_old        = 'X'
                    flg_rueck      = ' '                              "915964
                    aufnr          = ls_caufvd-aufnr
                  TABLES
                    caufvb_old     = lt_caufvbo
                    caufvd_get     = lt_caufvdg.
                DO 1 TIMES.
                  READ TABLE lt_caufvbo INDEX sy-index INTO DATA(ls_caufvbo) .
                ENDDO.
                MESSAGE e001(eam_ewm_integ) WITH lv_rspos ls_caufvbo-gstrp ls_caufvbo-gltrp
                INTO DATA(lv_msg).
                et_message = VALUE #( BASE et_message
                                      ( msgid = sy-msgid
                                        msgty = sy-msgty
                                        msgno = sy-msgno
                                        msgv1 = sy-msgv1
                                        msgv2 = sy-msgv2
                                        msgv3 = sy-msgv3
                                        msgv4 = sy-msgv4 ) ).
                RETURN.
              ENDIF.
            ENDIF.
          END-TEST-SEAM.

          CALL FUNCTION 'NW_BT_AFAB_CHECK_VBKZ'
            EXCEPTIONS
              vbkz_changed = 1.
          IF sy-subrc = 1 AND ls_caufvd-auterm = abap_true.
            CALL FUNCTION 'CX_ORDER_SCHEDULE'
              EXPORTING
                caufvd_imp            = ls_caufvd
                tcx00_imp             = tcx00
                i_flg_capacities_det  = 'X'
                i_flg_dates_det       = 'X'
                i_flg_overall_network = space
                i_flg_protocol        = 'X'
                i_autyp_to_schedule   = ls_caufvd-autyp
                i_no_log_init         = space
              IMPORTING
                caufvd_exp            = caufvd_exp
              EXCEPTIONS
                cycle_found           = 01
                no_operations         = 02
                no_start_date         = 03
                no_end_date           = 04
                no_sched_parameters   = 05.

            IF sy-subrc = 01.
              sy-msgty = 'E'.  "message CN 611 is raised as info message in CX_ORDER_SCHEDULE,
              "but we need an error message here to stop save processing
              /plmb/cl_spi_appl_access_utils=>add_syst_message(
                CHANGING
                  ct_message = lt_message ).
              APPEND LINES OF lt_message TO et_message.
            ELSEIF sy-subrc EQ 5.
              et_message = VALUE #( BASE et_message
                                    ( msgid = sy-msgid
                                      msgty = sy-msgty
                                      msgno = sy-msgno
                                      msgv1 = sy-msgv1 ) ).
