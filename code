REPORT ztest_set_blkd_wbs.

PARAMETERS:
  p_wbs TYPE ps_posid OBLIGATORY,
  p_set TYPE c LENGTH 4 DEFAULT 'BLKD'.

DATA:
  lt_user_status TYPE TABLE OF bapi_wbs_mnt_user_status,
  ls_user_status TYPE bapi_wbs_mnt_user_status,
  lt_result      TYPE TABLE OF bapi_status_result,
  ls_result      TYPE bapi_status_result.

START-OF-SELECTION.

  "Initialize PS BAPI context
  CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

  CLEAR ls_user_status.
  ls_user_status-wbs_element    = p_wbs.
  ls_user_status-set_user_status = p_set.
  APPEND ls_user_status TO lt_user_status.

  CALL FUNCTION 'BAPI_BUS2054_SET_STATUS'
    TABLES
      i_wbs_user_status = lt_user_status
      e_result          = lt_result.

  "Precommit required in your system
  CALL FUNCTION 'BAPI_PS_PRECOMMIT'.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  ULINE.
  WRITE: / 'Result:'.
  ULINE.

  IF lt_result IS INITIAL.
    WRITE: / 'No messages returned - check CJ20N status.'.
  ELSE.
    LOOP AT lt_result INTO ls_result.
      WRITE: / 'Object:',        ls_result-objectkey,
               'Action:',        ls_result-status_action,
               'Type:',          ls_result-status_type,
               'MsgID:',         ls_result-message_id,
               'MsgNo:',         ls_result-message_number.
    ENDLOOP.
  ENDIF.




METHOD set_blkd_status_for_higher_wbs.

  DATA:
    lt_user_status TYPE TABLE OF bapi_wbs_mnt_user_status,
    ls_user_status TYPE bapi_wbs_mnt_user_status,
    lt_result      TYPE TABLE OF bapi_status_result,
    ls_result      TYPE bapi_status_result.

  rv_success = abap_false.

  "Initialize PS context (MANDATORY in your system)
  CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

  LOOP AT it_wbs_items INTO DATA(ls_item).

    IF ls_item-posid IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_user_status.
    ls_user_status-wbs_element     = ls_item-posid.
    ls_user_status-set_user_status = 'BLKD'.
    APPEND ls_user_status TO lt_user_status.

  ENDLOOP.

  IF lt_user_status IS INITIAL.
    RETURN.
  ENDIF.

  CALL FUNCTION 'BAPI_BUS2054_SET_STATUS'
    TABLES
      i_wbs_user_status = lt_user_status
      e_result          = lt_result.

  "Required in your system
  CALL FUNCTION 'BAPI_PS_PRECOMMIT'.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  "Check result
  LOOP AT lt_result INTO ls_result.
    IF ls_result-message_id IS NOT INITIAL.
      rv_success = abap_false.
      RETURN.
    ENDIF.
  ENDLOOP.

  rv_success = abap_true.

ENDMETHOD.