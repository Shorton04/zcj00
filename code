METHOD assign_plan_values.

  DATA: lv_errors_found TYPE oax,
        lt_bpak         TYPE TABLE OF bpak,
        lt_bpak_cj40    TYPE TABLE OF bpak,
        lt_bpak_cj30    TYPE TABLE OF bpak,
        lt_bpak_cj32    TYPE TABLE OF bpak,
        ls_bpak         TYPE bpak,
        ls_item         TYPE ztb_a2r_wbsitem,
        lv_objnr        TYPE j_objnr,
        lv_waers        TYPE waers,
        lt_return       TYPE TABLE OF bapiret2.

  FIELD-SYMBOLS: <fs_curr> TYPE any.

  rv_success = abap_false.
  CLEAR: lt_bpak, lt_bpak_cj40, lt_bpak_cj30, lt_bpak_cj32, lt_return, lv_errors_found, lv_waers.

  "------------------------------------------------------------
  " Get currency from header (try common field names)
  "------------------------------------------------------------
  ASSIGN COMPONENT 'WAERS' OF STRUCTURE is_header TO <fs_curr>.
  IF sy-subrc = 0 AND <fs_curr> IS ASSIGNED AND <fs_curr> IS NOT INITIAL.
    lv_waers = <fs_curr>.
  ENDIF.

  IF lv_waers IS INITIAL.
    ASSIGN COMPONENT 'TWAER' OF STRUCTURE is_header TO <fs_curr>.
    IF sy-subrc = 0 AND <fs_curr> IS ASSIGNED AND <fs_curr> IS NOT INITIAL.
      lv_waers = <fs_curr>.
    ENDIF.
  ENDIF.

  IF lv_waers IS INITIAL.
    "No currency in header => FM will fail because BPAK-TWAER is mandatory
    rv_success = abap_false.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " Build BPAK lines from your WBS items
  "------------------------------------------------------------
  LOOP AT it_wbs_items INTO ls_item.

    IF ls_item-wert2 IS INITIAL.
      CONTINUE.
    ENDIF.

    "Get WBS object number
    CLEAR lv_objnr.
    SELECT SINGLE objnr
      FROM prps
      INTO @lv_objnr
      WHERE posid = @ls_item-posid.

    IF sy-subrc <> 0 OR lv_objnr IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_bpak.

    "Receiver object (WBS)
    ls_bpak-e_objnr  = lv_objnr.

    "Planning/Budgeting version for CJ40 logic
    ls_bpak-e_versn  = '000'.

    "Period (put all in period 001)
    ls_bpak-e_perio  = '001'.

    "Value type (01 = Plan)
    ls_bpak-e_wrttp  = '01'.

    "Amount
    ls_bpak-wert     = ls_item-wert2.

    "Currency (MANDATORY in your system)
    ls_bpak-twaer    = lv_waers.

    APPEND ls_bpak TO lt_bpak.

  ENDLOOP.

  IF lt_bpak IS INITIAL.
    rv_success = abap_true.
    RETURN.
  ENDIF.

  lt_bpak_cj40 = lt_bpak.
  lt_bpak_cj30 = lt_bpak.
  lt_bpak_cj32 = lt_bpak.

  "------------------------------------------------------------
  " 1) CJ40 equivalent => KSTP
  "------------------------------------------------------------
  CLEAR: lt_return, lv_errors_found.
  CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
    EXPORTING
      i_budget_activity = 'KSTP'
      i_delta_amounts   = 'X'
      i_rollup_data     = 'X'
      i_check_plan_data = 'X'
      i_application     = 'P'
      i_commit_all      = 'X'
    IMPORTING
      e_errors_found    = lv_errors_found
    TABLES
      it_bpak           = lt_bpak_cj40
      it_return         = lt_return
    EXCEPTIONS
      no_update         = 1
      OTHERS            = 2.

  IF sy-subrc <> 0 OR lv_errors_found IS NOT INITIAL.
    rv_success = abap_false.
    RETURN.
  ENDIF.
  READ TABLE lt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
  IF sy-subrc = 0.
    rv_success = abap_false.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " 2) CJ30 equivalent => KBUD
  "------------------------------------------------------------
  CLEAR: lt_return, lv_errors_found.
  CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
    EXPORTING
      i_budget_activity = 'KBUD'
      i_delta_amounts   = 'X'
      i_rollup_data     = 'X'
      i_check_plan_data = 'X'
      i_application     = 'P'
      i_commit_all      = 'X'
    IMPORTING
      e_errors_found    = lv_errors_found
    TABLES
      it_bpak           = lt_bpak_cj30
      it_return         = lt_return
    EXCEPTIONS
      no_update         = 1
      OTHERS            = 2.

  IF sy-subrc <> 0 OR lv_errors_found IS NOT INITIAL.
    rv_success = abap_false.
    RETURN.
  ENDIF.
  READ TABLE lt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
  IF sy-subrc = 0.
    rv_success = abap_false.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " 3) CJ32 equivalent => KBFR
  "------------------------------------------------------------
  CLEAR: lt_return, lv_errors_found.
  CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
    EXPORTING
      i_budget_activity = 'KBFR'
      i_delta_amounts   = 'X'
      i_rollup_data     = 'X'
      i_check_plan_data = 'X'
      i_application     = 'P'
      i_commit_all      = 'X'
    IMPORTING
      e_errors_found    = lv_errors_found
    TABLES
      it_bpak           = lt_bpak_cj32
      it_return         = lt_return
    EXCEPTIONS
      no_update         = 1
      OTHERS            = 2.

  IF sy-subrc <> 0 OR lv_errors_found IS NOT INITIAL.
    rv_success = abap_false.
    RETURN.
  ENDIF.
  READ TABLE lt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
  IF sy-subrc = 0.
    rv_success = abap_false.
    RETURN.
  ENDIF.

  rv_success = abap_true.

ENDMETHOD.