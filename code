FORM load_b3_project_data USING iv_pspnr TYPE proj-pspnr.

  DATA: lv_post1 TYPE proj-post1,
        lv_vernr TYPE proj-vernr,
        lv_plsez TYPE proj-plsez,
        lv_vbukr TYPE proj-vbukr,
        lv_werks TYPE proj-werks,
        lv_prctr TYPE proj-prctr.

  CLEAR gs_header.

  "Read PROJ (note VBUKR)
  SELECT SINGLE
         post1
         vernr
         plsez
         vbukr
         werks
         prctr
    INTO ( @lv_post1,
           @lv_vernr,
           @lv_plsez,
           @lv_vbukr,
           @lv_werks,
           @lv_prctr )
    FROM proj
    WHERE pspnr = @iv_pspnr.

  IF sy-subrc <> 0.
    MESSAGE e029(zcj00) WITH 'Project not found in PROJ'.
    RETURN.
  ENDIF.

  "Map to your header structure
  gs_header-pspnr = iv_pspnr.
  gs_header-post1 = lv_post1.     "Description
  gs_header-vernr = lv_vernr.     "Person Responsible
  gs_header-plsez = lv_plsez.     "Finish Date
  gs_header-bukrs = lv_vbukr.     "Company Code (PROJ-VBUKR -> BUKRS)
  gs_header-werks = lv_werks.     "Plant
  gs_header-prctr = lv_prctr.     "Profit Center

ENDFORM.