DATA: lv_assign_ok TYPE abap_bool.

"------------------------------------------------------------
"1) Read PRNAM + POSNR from header (you already do this)
"------------------------------------------------------------
SELECT SINGLE prnam, posnr
  INTO (@lv_prnam, @lv_posnr_im)
  FROM ztb_a2r_wbshdr
 WHERE zreq_num = @is_header-zreq_num.

"------------------------------------------------------------
"2) Get Level 1 WBS POSID (Project Definition)
"------------------------------------------------------------
lv_pspid_char = ls_wbs_celement-wbs_element.

"------------------------------------------------------------
"3) Call separated CJ02 method
"------------------------------------------------------------
lv_assign_ok = me->assign_im_cj02(
  iv_prnam     = lv_prnam
  iv_posnr     = lv_posnr_im
  iv_posid_wbs = lv_pspid_char
).

IF lv_assign_ok = abap_false.
  MESSAGE e398(00) WITH 'CJ02 IM assignment failed for WBS' lv_pspid_char.
  RETURN.
ENDIF.

COMMIT WORK AND WAIT.
WAIT UP TO 2 SECONDS.