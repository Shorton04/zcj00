DATA: lv_posid_im TYPE impr-posnr,
      lv_prnam    TYPE impr-prnam,
      lv_gjahr_im TYPE impr-gjahr.

"1) Read POSNR + PRNAM from your request header (ZCJ00 source of truth)
SELECT SINGLE posnr, prnam
  INTO (@lv_posid_im, @lv_prnam)
  FROM ztb_a2r_wbshdr
 WHERE zreq_num = @iv_zreq_num.   " <-- use your request number / key

IF sy-subrc <> 0.
  MESSAGE 'Header (ZTB_A2R_WBSHDR) not found for request' TYPE 'E'.
ENDIF.

"2) Read GJAHR from IMPR (still from IM master, as requested)
SELECT SINGLE gjahr
  INTO @lv_gjahr_im
  FROM impr
 WHERE posnr = @lv_posid_im.

IF sy-subrc <> 0 OR lv_gjahr_im IS INITIAL.
  MESSAGE 'IM Approval Year (IMPR-GJAHR) not found for POSNR' TYPE 'E'.
ENDIF.