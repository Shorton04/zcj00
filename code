REPORT ztest_pm_operation_status.

*---------------------------------------------------------------------*
* Input
*---------------------------------------------------------------------*
PARAMETERS:
  p_aufnr TYPE aufnr OBLIGATORY,          "Maintenance Order
  p_sts   TYPE bsvx-sttxt OBLIGATORY.     "Example: RFRA / REXE / W_LA

*---------------------------------------------------------------------*
* Data
*---------------------------------------------------------------------*
DATA:
  "Step 1 : User Status Update
  lt_methods      TYPE STANDARD TABLE OF bapi_alm_order_method,
  lt_userstatus   TYPE STANDARD TABLE OF bapi_alm_order_usrstat,
  lt_return       TYPE STANDARD TABLE OF bapiret2,

  "Step 2 : Dummy Save for AFVC sync
  lt_header       TYPE STANDARD TABLE OF bapi_alm_order_headers_i,
  lt_header_up    TYPE STANDARD TABLE OF bapi_alm_order_headers_up,

  ls_method       TYPE bapi_alm_order_method,
  ls_userstatus   TYPE bapi_alm_order_usrstat,
  ls_header       TYPE bapi_alm_order_headers_i,
  ls_header_up    TYPE bapi_alm_order_headers_up,
  ls_return       TYPE bapiret2.

************************************************************************
* STEP 1
* USER STATUS UPDATE
************************************************************************

CLEAR: lt_methods, lt_userstatus, lt_return.

*---------------------------------------------------------------------*
* METHOD : USERSTATUS CHANGE
*---------------------------------------------------------------------*
APPEND VALUE #(
  refnumber = '000001'
  objecttype = 'USERSTATUS'
  method = 'CHANGE'
  objectkey = p_aufnr
) TO lt_methods.

*---------------------------------------------------------------------*
* METHOD : SAVE
*---------------------------------------------------------------------*
APPEND VALUE #(
  refnumber = '000001'
  method = 'SAVE'
) TO lt_methods.

*---------------------------------------------------------------------*
* USER STATUS
*---------------------------------------------------------------------*
APPEND VALUE #(
  user_st_text = p_sts
  langu        = sy-langu
  change_event = '01'
) TO lt_userstatus.

*---------------------------------------------------------------------*
* Execute BAPI - Status Update
*---------------------------------------------------------------------*
CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
  TABLES
    it_methods    = lt_methods
    it_userstatus = lt_userstatus
    return        = lt_return.

READ TABLE lt_return INTO ls_return
  WITH KEY type = 'E'.

IF sy-subrc = 0.

  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.

  WRITE: / 'ERROR IN STEP 1 - USER STATUS UPDATE'.

  LOOP AT lt_return INTO ls_return.
    WRITE: / ls_return-type, ls_return-message.
  ENDLOOP.

  EXIT.

ELSE.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  WRITE: / 'STEP 1 SUCCESS - USER STATUS UPDATED'.

ENDIF.

************************************************************************
* STEP 2
* DUMMY SAVE TO FORCE AFVC PHASE/SUBPHASE REFRESH
************************************************************************

CLEAR: lt_methods, lt_return, lt_header, lt_header_up.

*---------------------------------------------------------------------*
* METHOD : HEADER CHANGE
*---------------------------------------------------------------------*
APPEND VALUE #(
  refnumber = '000001'
  objecttype = 'HEADER'
  method = 'CHANGE'
  objectkey = p_aufnr
) TO lt_methods.

*---------------------------------------------------------------------*
* METHOD : SAVE
*---------------------------------------------------------------------*
APPEND VALUE #(
  refnumber = '000001'
  method = 'SAVE'
) TO lt_methods.

*---------------------------------------------------------------------*
* HEADER
* Re-pass same value or minor text change to trigger save logic
*---------------------------------------------------------------------*
APPEND VALUE #(
  orderid    = p_aufnr
  short_text = 'REFRESH'
) TO lt_header.

*---------------------------------------------------------------------*
* HEADER_UP
*---------------------------------------------------------------------*
APPEND VALUE #(
  orderid    = p_aufnr
  short_text = 'X'
) TO lt_header_up.

*---------------------------------------------------------------------*
* Execute BAPI - Dummy Save
*---------------------------------------------------------------------*
CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
  TABLES
    it_methods   = lt_methods
    it_header    = lt_header
    it_header_up = lt_header_up
    return       = lt_return.

READ TABLE lt_return INTO ls_return
  WITH KEY type = 'E'.

IF sy-subrc = 0.

  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.

  WRITE: / 'ERROR IN STEP 2 - DUMMY SAVE'.

  LOOP AT lt_return INTO ls_return.
    WRITE: / ls_return-type, ls_return-message.
  ENDLOOP.

ELSE.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  WRITE: / 'STEP 2 SUCCESS - AFVC REFRESH TRIGGERED'.
  WRITE: / 'Order  :', p_aufnr.
  WRITE: / 'Status :', p_sts.
  WRITE: / 'Check AFVC phase/subphase after execution.'.

ENDIF.