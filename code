*---------------------------------------------------------------------*
* FORM: init_defaults
*---------------------------------------------------------------------*
FORM init_defaults.
  gv_user = sy-uname.
  gv_now  = sy-datum.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: get_kcmp_status
*---------------------------------------------------------------------*
FORM get_kcmp_status.
  "Resolve ESTAT for the user status text (KCMP)
  SELECT j~estat
    INTO @gc_estat
    FROM tj30 AS j
    INNER JOIN tj30t AS t
      ON j~estat = t~estat
    UP TO 1 ROWS
   WHERE t~txt04 = @p_estat
     AND t~spras = @p_spras.
  ENDSELECT.

  IF sy-subrc <> 0 OR gc_estat IS INITIAL.
    MESSAGE e005 WITH p_estat p_spras.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: validate_selection
*---------------------------------------------------------------------*
FORM validate_selection.
  IF s_aufnr[] IS INITIAL AND s_iwerk[] IS INITIAL.
    MESSAGE e001.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: fetch_orders
*---------------------------------------------------------------------*
FORM fetch_orders.

  DATA: lsr_orders TYPE REF TO data,
        lv_count   TYPE i.

  FIELD-SYMBOLS: <lt_result> TYPE STANDARD TABLE.

  "-----------------------------------------------------------
  " Clear any previous runtime info and IW39 memory IDs
  "-----------------------------------------------------------
  cl_salv_bs_runtime_info=>clear_all( ).
  FREE MEMORY ID 'RIAUFK20'.
  FREE MEMORY ID 'G_VARIANT_SAVE'.

  EXPORT no_list_display = abap_true  TO MEMORY ID 'RIAUFK20'.
  EXPORT g_variant_save  = abap_true  TO MEMORY ID 'G_VARIANT_SAVE'.

  cl_salv_bs_runtime_info=>set(
    EXPORTING
      display  = abap_false
      metadata = abap_false
      data     = abap_true ).

  SUBMIT riaufk20
      WITH dy_iar = 'X'
      WITH aufnr  IN s_aufnr
      WITH auart  IN s_auart
      WITH iwerk  IN s_iwerk
      WITH erdat  IN s_erdat
      WITH stai1  IN s_statin
      WITH stae1  IN s_statex
      WITH gstrp  IN s_gstrp
      WITH gltrp  IN s_gltrp
      WITH datuv  EQ '00000000'
      WITH datub  EQ '00000000'
      AND RETURN.

  TRY.
      cl_salv_bs_runtime_info=>get_data_ref( IMPORTING r_data = lsr_orders ).
      ASSIGN lsr_orders->* TO <lt_result>.
    CATCH cx_salv_bs_sc_runtime_info.
      MESSAGE e000(zmsg_a2r) WITH 'Unable to retrieve IW39 data'(m01).
      RETURN.
  ENDTRY.

  cl_salv_bs_runtime_info=>clear_all( ).
  FREE MEMORY ID 'RIAUFK20'.
  FREE MEMORY ID 'G_VARIANT_SAVE'.

  IF <lt_result> IS ASSIGNED AND <lt_result> IS NOT INITIAL.
    MOVE-CORRESPONDING <lt_result>[] TO gt_orders[].
  ELSE.
    MESSAGE s006(za2r_kcmpmsg).
    STOP.
  ENDIF.

  "-----------------------------------------------------------
  "  Fill RSNUM from VIAUFKST
  "-----------------------------------------------------------
  DATA: lt_aufnr    TYPE SORTED TABLE OF aufk-aufnr WITH UNIQUE KEY table_line,
        lt_viaufkst TYPE STANDARD TABLE OF viaufkst,
        ls_viaufkst TYPE viaufkst.

* Collect AUFNR
  LOOP AT gt_orders ASSIGNING FIELD-SYMBOL(<fs_order>).
    INSERT <fs_order>-aufnr INTO TABLE lt_aufnr.
  ENDLOOP.

* Read once
  IF lt_aufnr IS NOT INITIAL.
    SELECT aufnr, rsnum
      INTO TABLE @lt_viaufkst
      FROM viaufkst
      FOR ALL ENTRIES IN @lt_aufnr
      WHERE aufnr = @lt_aufnr-table_line.
  ENDIF.

  SORT lt_viaufkst BY aufnr.
  DELETE ADJACENT DUPLICATES FROM lt_viaufkst COMPARING aufnr.

  LOOP AT gt_orders ASSIGNING <fs_order>.

    READ TABLE lt_viaufkst INTO ls_viaufkst
      WITH KEY aufnr = <fs_order>-aufnr
      BINARY SEARCH.

    IF sy-subrc = 0.
      <fs_order>-rsnum = ls_viaufkst-rsnum.
    ELSE.
      CLEAR <fs_order>-rsnum.
    ENDIF.

  ENDLOOP.


  "-----------------------------------------------------------
  " Filter only released orders (IPHAS = 2)
  "-----------------------------------------------------------
  DELETE gt_orders WHERE iphas NE '2'.

  IF gt_orders IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'User does not have authorization to update.'(m02) DISPLAY LIKE 'E'.
    LEAVE LIST-PROCESSING.
  ENDIF.


  TYPES: BEGIN OF ty_afko_map,
           aufnr TYPE aufk-aufnr,
           gltrp TYPE afko-gltrp,
         END OF ty_afko_map.

  DATA: lt_afko TYPE STANDARD TABLE OF ty_afko_map,
        ls_afko TYPE ty_afko_map.


* Collect only needed AUFNR (optional: only those missing GLTRP)
  LOOP AT gt_orders ASSIGNING <fs_order>
       WHERE gltrp IS INITIAL.

    INSERT <fs_order>-aufnr INTO TABLE lt_aufnr.

  ENDLOOP.

* Read AFKO once
  IF lt_aufnr IS NOT INITIAL.
    SELECT aufnr, gltrp
      INTO TABLE @lt_afko
      FROM afko
      FOR ALL ENTRIES IN @lt_aufnr
      WHERE aufnr = @lt_aufnr-table_line.
  ENDIF.

  SORT lt_afko BY aufnr.

  LOOP AT gt_orders ASSIGNING <fs_order>.

    IF <fs_order>-gltrp IS INITIAL.

      READ TABLE lt_afko INTO ls_afko
        WITH KEY aufnr = <fs_order>-aufnr
        BINARY SEARCH.

      IF sy-subrc = 0.
        <fs_order>-gltrp = ls_afko-gltrp.
      ENDIF.

    ENDIF.

  ENDLOOP.

  DESCRIBE TABLE gt_orders LINES lv_count.
  IF lv_count > 0.
    MESSAGE s021 WITH lv_count.
  ELSE.
    MESSAGE e000(zmsg_a2r) WITH 'User does not have authorization to update.'(m02) DISPLAY LIKE 'E'.
    LEAVE LIST-PROCESSING.
  ENDIF.

ENDFORM.


*---------------------------------------------------------------------*
* FORM: filter has components
*---------------------------------------------------------------------*
FORM filter_has_components.

  TYPES: BEGIN OF ty_resb_comp,
           rsnum TYPE resb-rsnum,
           aufnr TYPE resb-aufnr,
           postp TYPE resb-postp,
           enmng TYPE resb-enmng,
           bdmng TYPE resb-bdmng,
         END OF ty_resb_comp.

  TYPES: BEGIN OF ty_afko_rsnum,
           aufnr TYPE afko-aufnr,
           rsnum TYPE afko-rsnum,
         END OF ty_afko_rsnum.

  DATA: lt_resb         TYPE SORTED TABLE OF ty_resb_comp
                          WITH NON-UNIQUE KEY rsnum aufnr,
        lt_resb_tmp     TYPE STANDARD TABLE OF ty_resb_comp,
        lt_resb_order   TYPE STANDARD TABLE OF ty_resb_comp,
        ls_resb         TYPE ty_resb_comp,

        lt_jest_raw     TYPE STANDARD TABLE OF jest,
        lt_jest         TYPE HASHED TABLE OF jest
                          WITH UNIQUE KEY objnr stat,

        lt_rsnum        TYPE SORTED TABLE OF resb-rsnum WITH UNIQUE KEY table_line,
        lt_aufnr        TYPE SORTED TABLE OF aufk-aufnr WITH UNIQUE KEY table_line,
        lt_objnr        TYPE SORTED TABLE OF jest-objnr WITH UNIQUE KEY table_line,

        lt_keep         TYPE TABLE OF lty_order,
        ls_order        TYPE lty_order,

        lv_kcmp_active  TYPE abap_bool,
        ##NEEDED lv_stat         TYPE jest-stat,
        lv_l_complete   TYPE abap_bool,
        lv_n_complete   TYPE abap_bool,
        lv_l_incomplete TYPE abap_bool,
        lv_n_incomplete TYPE abap_bool,
        lv_has_l        TYPE abap_bool,
        lv_has_n        TYPE abap_bool.

*--------------------------------------------------------------------*
* Collect keys from gt_orders
*--------------------------------------------------------------------*
  LOOP AT gt_orders INTO ls_order.
    IF ls_order-rsnum IS NOT INITIAL.
      INSERT ls_order-rsnum INTO TABLE lt_rsnum.
    ELSE.
      INSERT ls_order-aufnr INTO TABLE lt_aufnr.
    ENDIF.
    INSERT ls_order-objnr INTO TABLE lt_objnr.
  ENDLOOP.

*--------------------------------------------------------------------*
* Prefetch RESB by RSNUM (5 fields only)
*--------------------------------------------------------------------*
  IF lt_rsnum IS NOT INITIAL.
    SELECT rsnum, aufnr, postp, enmng, bdmng
      FROM resb
      INTO TABLE @lt_resb_tmp
      FOR ALL ENTRIES IN @lt_rsnum
      WHERE rsnum = @lt_rsnum-table_line
        AND xloek = @space.

    INSERT LINES OF lt_resb_tmp INTO TABLE lt_resb.
  ENDIF.

*--------------------------------------------------------------------*
* Prefetch RESB by AUFNR (5 fields only)
*--------------------------------------------------------------------*
  IF lt_aufnr IS NOT INITIAL.
    CLEAR lt_resb_tmp.

*   Resolve AUFNR -> RSNUM via AFKO (AUFNR is indexed in AFKO)
    DATA lt_afko_rsnum TYPE STANDARD TABLE OF ty_afko_rsnum.

    SELECT aufnr, rsnum
      FROM afko
      INTO TABLE @lt_afko_rsnum
      FOR ALL ENTRIES IN @lt_aufnr
      WHERE aufnr = @lt_aufnr-table_line.

*   Collect resolved RSNUMs
    DATA lt_rsnum2 TYPE SORTED TABLE OF resb-rsnum WITH UNIQUE KEY table_line.

    LOOP AT lt_afko_rsnum INTO DATA(ls_afko_rs).
      IF ls_afko_rs-rsnum IS NOT INITIAL.
        INSERT ls_afko_rs-rsnum INTO TABLE lt_rsnum2.
      ENDIF.
    ENDLOOP.

*   Select RESB by RSNUM (uses primary key)
    IF lt_rsnum2 IS NOT INITIAL.
      SELECT rsnum, aufnr, postp, enmng, bdmng
        FROM resb
        INTO TABLE @lt_resb_tmp
        FOR ALL ENTRIES IN @lt_rsnum2
        WHERE rsnum = @lt_rsnum2-table_line
          AND xloek = @space.

      INSERT LINES OF lt_resb_tmp INTO TABLE lt_resb.
    ENDIF.
  ENDIF.

*--------------------------------------------------------------------*
* Prefetch JEST (KCMP status check)
*--------------------------------------------------------------------*
  IF lt_objnr IS NOT INITIAL.
    SELECT objnr, stat, inact
      FROM jest
      INTO TABLE @lt_jest_raw
      FOR ALL ENTRIES IN @lt_objnr
      WHERE objnr = @lt_objnr-table_line
        AND stat  = @gc_estat
        AND inact = @space.

    INSERT LINES OF lt_jest_raw INTO TABLE lt_jest.
  ENDIF.

*--------------------------------------------------------------------*
* Main processing loop (NO SELECT inside)
*--------------------------------------------------------------------*
  ##INTO_OK  LOOP AT gt_orders INTO ls_order.

    CLEAR: lv_kcmp_active, lv_stat,
           lv_l_complete, lv_n_complete,
           lv_l_incomplete, lv_n_incomplete,
           lv_has_l, lv_has_n,
           lt_resb_order.

    "-----------------------------------------------------------------
    " Get RESB from buffer
    "-----------------------------------------------------------------
    IF ls_order-rsnum IS NOT INITIAL.
      LOOP AT lt_resb INTO ls_resb
        WHERE rsnum = ls_order-rsnum.
        APPEND ls_resb TO lt_resb_order.
      ENDLOOP.
    ELSE.
      LOOP AT lt_resb INTO ls_resb
        WHERE aufnr = ls_order-aufnr.
        APPEND ls_resb TO lt_resb_order.
      ENDLOOP.
    ENDIF.

    IF lt_resb_order IS INITIAL.
      CONTINUE.
    ENDIF.

    "-----------------------------------------------------------------
    " KCMP active check from buffer
    "-----------------------------------------------------------------
    READ TABLE lt_jest WITH TABLE KEY objnr = ls_order-objnr
                                      stat  = gc_estat
                       TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      lv_kcmp_active = abap_true.
    ENDIF.

    "-----------------------------------------------------------------
    " Determine component completeness
    "-----------------------------------------------------------------
    ##INTO_OK    LOOP AT lt_resb_order INTO ls_resb.
      CASE ls_resb-postp.
        WHEN gc_postp_l.
          lv_has_l = abap_true.
          IF ls_resb-enmng < ls_resb-bdmng.
            lv_l_incomplete = abap_true.
          ELSE.
            lv_l_complete = abap_true.
          ENDIF.
        WHEN gc_postp_n.
          lv_has_n = abap_true.
          IF ls_resb-enmng < ls_resb-bdmng.
            lv_n_incomplete = abap_true.
          ELSE.
            lv_n_complete = abap_true.
          ENDIF.
      ENDCASE.
    ENDLOOP.

    "-----------------------------------------------------------------
    " Ignore if both L and N have no posted and no not-posted
    "-----------------------------------------------------------------
    IF lv_has_l IS INITIAL AND lv_has_n IS INITIAL.
      CONTINUE.
    ENDIF.

*---------------------------------------------------------------------*
* HANDLE SET STATUS
*---------------------------------------------------------------------*
    IF p_set = abap_true.

      IF lv_kcmp_active = abap_true.
        CONTINUE.
      ENDIF.

      "---------------------------------------------------------------
      " BOTH L AND N EXIST
      "---------------------------------------------------------------
      IF lv_has_l = abap_true AND lv_has_n = abap_true.

        IF lv_l_complete = abap_true AND lv_n_complete = abap_true.
          APPEND ls_order TO lt_keep.
        ELSEIF lv_l_complete = abap_true AND lv_n_incomplete = abap_true.
          IF ( p_reserv = abap_true AND p_preq = abap_false )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSEIF lv_l_incomplete = abap_true AND lv_n_complete = abap_true.
          IF ( p_reserv = abap_false AND p_preq = abap_true )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSEIF lv_l_incomplete = abap_true AND lv_n_incomplete = abap_true.
          IF p_reserv IS INITIAL AND p_preq IS INITIAL.
            APPEND ls_order TO lt_keep.
          ENDIF.
        ENDIF.

        "---------------------------------------------------------------
        " L ONLY
        "---------------------------------------------------------------
      ELSEIF lv_has_l = abap_true AND lv_has_n = abap_false.

        IF lv_l_complete = abap_true.
          IF ( p_reserv = abap_true )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSE.
          IF p_reserv IS INITIAL AND p_preq IS INITIAL.
            APPEND ls_order TO lt_keep.
          ENDIF.
        ENDIF.

        "---------------------------------------------------------------
        " N ONLY
        "---------------------------------------------------------------
      ELSEIF lv_has_l = abap_false AND lv_has_n = abap_true.

        IF lv_n_complete = abap_true.
          IF ( p_preq = abap_true )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSE.
          IF p_reserv IS INITIAL AND p_preq IS INITIAL.
            APPEND ls_order TO lt_keep.
          ENDIF.
        ENDIF.

      ENDIF.

      CONTINUE.

*---------------------------------------------------------------------*
* HANDLE RESET STATUS
*---------------------------------------------------------------------*
    ELSEIF p_reset = abap_true.

      IF lv_kcmp_active = abap_false.
        CONTINUE.
      ENDIF.

      "---------------------------------------------------------------
      " BOTH L AND N EXIST
      "---------------------------------------------------------------
      IF lv_has_l = abap_true AND lv_has_n = abap_true.

        IF lv_l_complete = abap_true AND lv_n_complete = abap_true.
          IF p_reserv IS INITIAL AND p_preq IS INITIAL.
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSEIF lv_l_complete = abap_true AND lv_n_incomplete = abap_true.
          IF ( p_reserv = abap_true AND p_preq = abap_true )
             OR ( p_preq = abap_true AND p_reserv IS INITIAL )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSEIF lv_l_incomplete = abap_true AND lv_n_complete = abap_true.
          IF ( p_reserv = abap_true AND p_preq = abap_true )
             OR ( p_preq IS INITIAL AND p_reserv = abap_true )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSEIF lv_l_incomplete = abap_true AND lv_n_incomplete = abap_true.
          APPEND ls_order TO lt_keep.
        ENDIF.

        "---------------------------------------------------------------
        " L ONLY
        "---------------------------------------------------------------
      ELSEIF lv_has_l = abap_true AND lv_has_n = abap_false.

        IF lv_l_complete = abap_true.
          IF p_reserv IS INITIAL AND p_preq IS INITIAL.
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSE.
          IF ( p_reserv = abap_true AND p_preq = abap_true )
             OR ( p_reserv = abap_true AND p_preq IS INITIAL )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ENDIF.

        "---------------------------------------------------------------
        " N ONLY
        "---------------------------------------------------------------
      ELSEIF lv_has_l = abap_false AND lv_has_n = abap_true.

        IF lv_n_complete = abap_true.
          IF p_reserv IS INITIAL AND p_preq IS INITIAL.
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSE.
          IF ( p_reserv = abap_true AND p_preq = abap_true )
             OR ( p_preq = abap_true AND p_reserv IS INITIAL )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ENDIF.

      ENDIF.

      CONTINUE.

    ENDIF.

  ENDLOOP.

  gt_orders = lt_keep.

ENDFORM.


*---------------------------------------------------------------------*
* FORM: evaluate_kitting
*---------------------------------------------------------------------*
FORM evaluate_kitting.

  DATA: lv_msg         TYPE string,
        lv_kcmp_active TYPE abap_bool,
##NEEDED lv_stat        TYPE jest-stat.

*--------------------------------------------------------------------*
* Prefetch JEST (KCMP status)
*--------------------------------------------------------------------*
  DATA: lt_objnr    TYPE SORTED TABLE OF jest-objnr WITH UNIQUE KEY table_line,
        lt_jest_raw TYPE STANDARD TABLE OF jest,
        lt_jest     TYPE HASHED TABLE OF jest
                      WITH UNIQUE KEY objnr stat.

  LOOP AT gt_orders INTO DATA(ls_tmp).
    INSERT ls_tmp-objnr INTO TABLE lt_objnr.
  ENDLOOP.

  IF lt_objnr IS NOT INITIAL.
    SELECT objnr, stat, inact
      FROM jest
      INTO TABLE @lt_jest_raw
      FOR ALL ENTRIES IN @lt_objnr
      WHERE objnr = @lt_objnr-table_line
        AND stat  = @gc_estat
        AND inact = @space.

    INSERT LINES OF lt_jest_raw INTO TABLE lt_jest.
  ENDIF.

*--------------------------------------------------------------------*
* Main loop (NO SELECT inside)
*--------------------------------------------------------------------*
  ##INTO_OK  LOOP AT gt_orders INTO DATA(ls_order).

    CLEAR: lv_kcmp_active, lv_stat.

    "---------------------------------------------------------------
    " Determine if KCMP is currently active (from buffer)
    "---------------------------------------------------------------
    READ TABLE lt_jest WITH TABLE KEY objnr = ls_order-objnr
                                      stat  = gc_estat
                       TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      lv_kcmp_active = abap_true.
    ENDIF.

    "---------------------------------------------------------------
    " Log only actionable entries (gt_orders already filtered)
    "---------------------------------------------------------------
    IF p_set = abap_true.
      MESSAGE s016 WITH ls_order-aufnr INTO lv_msg.
      APPEND VALUE #(
        aufnr        = ls_order-aufnr
        auart        = ls_order-auart
        iwerk        = ls_order-iwerk
        erdat        = ls_order-erdat
        gstrp        = ls_order-gstrp
        gltrp        = ls_order-gltrp
        msgtxt       = lv_msg
        light        = gc_light_green_code
        kcmp_active  = COND #( WHEN lv_kcmp_active = abap_true THEN 'X' ELSE space )
      ) TO gt_log.

    ELSEIF p_reset = abap_true.
      MESSAGE s015 WITH ls_order-aufnr INTO lv_msg.
      APPEND VALUE #(
        aufnr        = ls_order-aufnr
        auart        = ls_order-auart
        iwerk        = ls_order-iwerk
        erdat        = ls_order-erdat
        gstrp        = ls_order-gstrp
        gltrp        = ls_order-gltrp
        msgtxt       = lv_msg
        light        = gc_light_green_code
        kcmp_active  = 'X'
      ) TO gt_log.
    ENDIF.

  ENDLOOP.

ENDFORM.



*---------------------------------------------------------------------*
* FORM: check_authorizations
*---------------------------------------------------------------------*
FORM check_authorizations.
  AUTHORITY-CHECK OBJECT 'C_AFKO_ACT' ID 'PS_ACTVT' FIELD '02'.
  IF sy-subrc <> 0.
    CLEAR gs_log.
    gs_log-msgno = '001'.
    gs_log-msgid = gc_msgid.
    gs_log-msgtp = 'E'.
    gs_log-light = 'R'.
    gv_user_authorized = abap_false.
    MESSAGE ID gc_msgid TYPE 'E' NUMBER '001'.
    PERFORM display_execution_log.
    EXIT.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: update_user_status
*---------------------------------------------------------------------*
FORM update_user_status.

  DATA: lt_aufnr       TYPE SORTED TABLE OF aufk-aufnr WITH UNIQUE KEY table_line,
        lt_aufk        TYPE STANDARD TABLE OF aufk,
        lt_jest        TYPE STANDARD TABLE OF jest,
        ls_aufk        TYPE aufk,
##NEEDED        ls_jest        TYPE jest,
        lv_kcmp_active TYPE abap_bool,

        lt_header      TYPE TABLE OF bapi_alm_order_headers_i,
        lt_status      TYPE TABLE OF bapi_alm_order_usrstat,
        lt_methods     TYPE TABLE OF bapi_alm_order_method,
        lt_return      TYPE TABLE OF bapiret2,
        ls_return      TYPE bapiret2.

*--------------------------------------------------------------------*
* Collect AUFNR (only needed ones)
*--------------------------------------------------------------------*
  LOOP AT gt_log INTO DATA(ls_log) WHERE light = 'G'.
    INSERT ls_log-aufnr INTO TABLE lt_aufnr.
  ENDLOOP.

*--------------------------------------------------------------------*
* Read AUFK (1 DB hit)
*--------------------------------------------------------------------*
  IF lt_aufnr IS NOT INITIAL.
    SELECT aufnr objnr
      INTO TABLE lt_aufk
      FROM aufk
      FOR ALL ENTRIES IN lt_aufnr
      WHERE aufnr = lt_aufnr-table_line.
  ENDIF.

*--------------------------------------------------------------------*
* Read JEST (1 DB hit)
*--------------------------------------------------------------------*
  IF lt_aufk IS NOT INITIAL.
    SELECT objnr stat inact
      INTO TABLE lt_jest
      FROM jest
      FOR ALL ENTRIES IN lt_aufk
      WHERE objnr = lt_aufk-objnr
        AND stat  = gc_estat
        AND inact = space.
  ENDIF.

*--------------------------------------------------------------------*
* Main Loop (NO MORE SELECT)
*--------------------------------------------------------------------*
  LOOP AT gt_log INTO ls_log WHERE light = 'G'.

    CLEAR: lv_kcmp_active,
           lt_header, lt_status, lt_methods, lt_return, ls_return.

*--------------------------------------------------------------------*
* Get OBJNR from buffer
*--------------------------------------------------------------------*
    READ TABLE lt_aufk INTO ls_aufk WITH KEY aufnr = ls_log-aufnr.
    IF sy-subrc = 0.

*--------------------------------------------------------------------*
* Check status from buffer
*--------------------------------------------------------------------*
      READ TABLE lt_jest INTO ls_jest WITH KEY objnr = ls_aufk-objnr.
      lv_kcmp_active = xsdbool( sy-subrc = 0 ).

    ENDIF.

*--------------------------------------------------------------------*
* Validation (unchanged)
*--------------------------------------------------------------------*
    IF p_set = abap_true AND lv_kcmp_active = abap_true.
      MESSAGE ID gc_msgid TYPE 'I' NUMBER '018' WITH ls_log-aufnr INTO ls_log-msgtxt.
      ls_log-msgid = gc_msgid.
      ls_log-msgno = '018'.
      ls_log-msgtp = 'I'.
      ls_log-light = 'O'.
      MODIFY gt_log FROM ls_log.
      CONTINUE.
    ENDIF.

    IF p_reset = abap_true AND lv_kcmp_active = abap_false.
      MESSAGE ID gc_msgid TYPE 'I' NUMBER '019' WITH ls_log-aufnr INTO ls_log-msgtxt.
      ls_log-msgid = gc_msgid.
      ls_log-msgno = '019'.
      ls_log-msgtp = 'I'.
      ls_log-light = 'O'.
      MODIFY gt_log FROM ls_log.
      CONTINUE.
    ENDIF.

*--------------------------------------------------------------------*
* Authorization (unchanged)
*--------------------------------------------------------------------*
    AUTHORITY-CHECK OBJECT 'I_IWERK'
      ID 'IWERK' FIELD ls_log-iwerk
      ID 'TCD'   FIELD sy-tcode.

    IF sy-subrc <> 0.
      MESSAGE ID gc_msgid TYPE 'E' NUMBER '002' WITH ls_log-iwerk INTO ls_log-msgtxt.
      ls_log-msgid = gc_msgid.
      ls_log-msgno = '002'.
      ls_log-msgtp = 'E'.
      ls_log-light = 'R'.
      MODIFY gt_log FROM ls_log.
      CONTINUE.
    ENDIF.

*--------------------------------------------------------------------*
* BAPI Build + Execute (same as yours)
*--------------------------------------------------------------------*
    APPEND VALUE #( orderid = ls_log-aufnr ) TO lt_header.

    IF p_reset = abap_true.
      APPEND VALUE #( user_st_text = p_estat inactive = 'X' langu = p_spras ) TO lt_status.
    ELSE.
      APPEND VALUE #( user_st_text = p_estat langu = p_spras ) TO lt_status.
    ENDIF.

    APPEND VALUE #( refnumber = '00001' objecttype = 'HEADER'
                    method = 'CHANGE' objectkey = ls_log-aufnr ) TO lt_methods.
    APPEND VALUE #( refnumber = '00001' objecttype = 'USERSTATUS'
                    method = 'CHANGE' objectkey = ls_log-aufnr ) TO lt_methods.
    APPEND VALUE #( refnumber = '00003' objecttype = 'ORDER'
                    method = 'SAVE' objectkey = ls_log-aufnr ) TO lt_methods.

    CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
      TABLES
        it_header     = lt_header
        it_methods    = lt_methods
        it_userstatus = lt_status
        return        = lt_return.

*--------------------------------------------------------------------*
* Result handling (same)
*--------------------------------------------------------------------*
    READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
    IF sy-subrc = 0.
      ls_log-msgtxt = ls_return-message.
      ls_log-msgid  = ls_return-id.
      ls_log-msgno  = ls_return-number.
      ls_log-msgtp  = ls_return-type.
      ls_log-light  = 'R'.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    ELSE.
      IF p_reset = abap_true.
        MESSAGE ID gc_msgid TYPE 'I' NUMBER '004' WITH p_estat INTO ls_log-msgtxt.
        CLEAR ls_log-kcmp_active.
      ELSE.
        MESSAGE ID gc_msgid TYPE 'I' NUMBER '003' WITH p_estat INTO ls_log-msgtxt.
        ls_log-kcmp_active = 'X'.
      ENDIF.
      ls_log-light = 'G'.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING wait = 'X'.
    ENDIF.

    PERFORM release_locks USING ls_log-aufnr.
    MODIFY gt_log FROM ls_log.

  ENDLOOP.

ENDFORM.




*---------------------------------------------------------------------*
* FORM: display_execution_log
*---------------------------------------------------------------------*
FORM display_execution_log.

  DATA: lo_alv  TYPE REF TO cl_salv_table,
        lo_cols TYPE REF TO cl_salv_columns_table,
        lo_col  TYPE REF TO cl_salv_column,
        lx_msg  TYPE REF TO cx_salv_msg.

  "---------------------------------------------------------------
  " Exit if no log entries
  "---------------------------------------------------------------
  IF gt_log IS INITIAL.
    MESSAGE s006(za2r_kcmpmsg).
    STOP.
  ENDIF.

  "---------------------------------------------------------------
  " Remove ignored ('O') rows (non-actionable)
  "---------------------------------------------------------------
  DELETE gt_log WHERE light = icon_led_inactive OR light = 'O'.

  IF gt_log IS INITIAL.
    MESSAGE s006(za2r_kcmpmsg).
    STOP.
  ENDIF.

  "---------------------------------------------------------------
  " Map traffic light indicator codes
  "---------------------------------------------------------------
  LOOP AT gt_log ASSIGNING FIELD-SYMBOL(<fs_log>).
    CASE <fs_log>-light.
      WHEN 'G' OR icon_led_green.
        <fs_log>-light = icon_led_green.
      WHEN 'R' OR icon_led_red.
        <fs_log>-light = icon_led_red.
      WHEN OTHERS.
        <fs_log>-light = icon_led_inactive.
    ENDCASE.
  ENDLOOP.

  "---------------------------------------------------------------
  " Build and display ALV
  "---------------------------------------------------------------
  TRY.
      cl_salv_table=>factory(
        IMPORTING
          r_salv_table = lo_alv
        CHANGING
          t_table      = gt_log ).
    CATCH cx_salv_msg INTO lx_msg.
      MESSAGE lx_msg->get_text( ) TYPE 'I'.
      RETURN.
  ENDTRY.

  lo_cols = lo_alv->get_columns( ).
  lo_cols->set_optimize( abap_true ).

  "---------------------------------------------------------------
  " Define readable column headers
  "---------------------------------------------------------------
  TRY.
      lo_col = lo_cols->get_column( 'AUFNR' ).
      lo_col->set_short_text( CONV scrtext_s( TEXT-c01 ) ).
      lo_col->set_medium_text( CONV scrtext_m( TEXT-c02 ) ).
      lo_col->set_long_text( CONV scrtext_l( TEXT-c03 ) ).
    CATCH cx_salv_not_found.
      CLEAR lo_col.
  ENDTRY.

  TRY.
      lo_col = lo_cols->get_column( 'AUART' ).
      lo_col->set_short_text( CONV scrtext_s( TEXT-c04 ) ).
      lo_col->set_medium_text( CONV scrtext_m( TEXT-c05 ) ).
      lo_col->set_long_text( CONV scrtext_l( TEXT-c05 ) ).
    CATCH cx_salv_not_found.
      CLEAR lo_col.
  ENDTRY.

  TRY.
      lo_col = lo_cols->get_column( 'IWERK' ).
      lo_col->set_short_text( CONV scrtext_s( TEXT-c07 ) ).
      lo_col->set_medium_text( CONV scrtext_m( TEXT-c07 ) ).
      lo_col->set_long_text( CONV scrtext_l( TEXT-c09 ) ).
    CATCH cx_salv_not_found.
      CLEAR lo_col.
  ENDTRY.

  TRY.
      lo_col = lo_cols->get_column( 'ERDAT' ).
      lo_col->set_short_text( CONV scrtext_s( TEXT-c10 ) ).
      lo_col->set_medium_text( CONV scrtext_m( TEXT-c11 ) ).
      lo_col->set_long_text( CONV scrtext_l( TEXT-c11 ) ).
    CATCH cx_salv_not_found.
      CLEAR lo_col.
  ENDTRY.

  TRY.
      lo_col = lo_cols->get_column( 'GSTRP' ).
      lo_col->set_short_text( CONV scrtext_s( TEXT-c13 ) ).
      lo_col->set_medium_text( CONV scrtext_m( TEXT-c14 ) ).
      lo_col->set_long_text( CONV scrtext_l( TEXT-c15 ) ).
    CATCH cx_salv_not_found.
      CLEAR lo_col.
  ENDTRY.

  TRY.
      lo_col = lo_cols->get_column( 'GLTRP' ).
      lo_col->set_short_text( CONV scrtext_s( TEXT-c16 ) ).
      lo_col->set_medium_text( CONV scrtext_m( TEXT-c17 ) ).
      lo_col->set_long_text( CONV scrtext_l( TEXT-c18 ) ).
    CATCH cx_salv_not_found.
      CLEAR lo_col.
  ENDTRY.

  TRY.
      lo_col = lo_cols->get_column( 'MSGTP' ).
      lo_col->set_short_text( CONV scrtext_s( TEXT-c19 ) ).
      lo_col->set_medium_text( CONV scrtext_m( TEXT-c19 ) ).
      lo_col->set_long_text( CONV scrtext_l( TEXT-c21 ) ).
    CATCH cx_salv_not_found.
      CLEAR lo_col.
  ENDTRY.

  TRY.
      lo_col = lo_cols->get_column( 'MSGID' ).
      lo_col->set_short_text( CONV scrtext_s( TEXT-c22 ) ).
      lo_col->set_medium_text( CONV scrtext_m( TEXT-c22 ) ).
      lo_col->set_long_text( CONV scrtext_l( TEXT-c24 ) ).
    CATCH cx_salv_not_found.
      CLEAR lo_col.
  ENDTRY.

  TRY.
      lo_col = lo_cols->get_column( 'MSGNO' ).
      lo_col->set_short_text( CONV scrtext_s( TEXT-c25 ) ).
      lo_col->set_medium_text( CONV scrtext_m( TEXT-c25 ) ).
      lo_col->set_long_text( CONV scrtext_l( TEXT-c27 ) ).
    CATCH cx_salv_not_found.
      CLEAR lo_col.
  ENDTRY.

  TRY.
      lo_col = lo_cols->get_column( 'MSGTXT' ).
      lo_col->set_short_text( CONV scrtext_s( TEXT-c31 ) ).
      lo_col->set_medium_text( CONV scrtext_m( TEXT-c32 ) ).
      lo_col->set_long_text( CONV scrtext_l( TEXT-c32 ) ).
    CATCH cx_salv_not_found.
      CLEAR lo_col.
  ENDTRY.

  TRY.
      lo_col = lo_cols->get_column( 'LIGHT' ).
      lo_col->set_short_text( CONV scrtext_s( TEXT-c28 ) ).
      lo_col->set_medium_text( CONV scrtext_m( TEXT-c28 ) ).
      lo_col->set_long_text( CONV scrtext_l( TEXT-c30 ) ).
    CATCH cx_salv_not_found.
      CLEAR lo_col.
  ENDTRY.

  "---------------------------------------------------------------
  " Hide technical/internal fields
  "---------------------------------------------------------------
  TRY.
      lo_col = lo_cols->get_column( 'KCMP_ACTIVE' ).
      lo_col->set_visible( abap_false ).
    CATCH cx_salv_not_found.
      CLEAR lo_col.
  ENDTRY.

  "---------------------------------------------------------------
  " Enable standard ALV functions
  "---------------------------------------------------------------
  lo_alv->get_functions( )->set_all( abap_true ).

  lo_alv->get_display_settings( )->set_list_header( 'Set/Reset Kitting Complete Status (for Lonza)'(c34) ).
  lo_alv->get_display_settings( )->set_striped_pattern( abap_true ).

  "---------------------------------------------------------------
  " Display the ALV
  "---------------------------------------------------------------
  lo_alv->display( ).

ENDFORM.



