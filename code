METHOD create_settlement_rules.
*&---------------------------------------------------------------------*
*& Create Settlement Rules via CJB2 Transaction (BDC)
*& Reference: SHDB Recording - No FORM routines in class pool
*&---------------------------------------------------------------------*

  DATA: lt_bdcdata TYPE TABLE OF bdcdata,
        lt_bdcmsg  TYPE TABLE OF bdcmsgcoll,
        ls_bdcmsg  TYPE bdcmsgcoll,
        ls_wbs     TYPE ztb_a2r_wbsitem,
        lv_posid   TYPE ps_posid,
        lv_sender_objnr   TYPE j_objnr,
        lv_receiver_objnr TYPE j_objnr,
        lv_parent_posid   TYPE ps_posid,
        lv_parent_pspnr   TYPE ps_pspnr,
        lv_mode    TYPE c VALUE 'N',  " Background mode
        lv_update  TYPE c VALUE 'S'.  " Synchronous update

  rv_success = abap_false.

  LOOP AT it_wbs_items INTO ls_wbs.

    " Skip Level 1 (no settlement needed)
    IF ls_wbs-stufe = 1.
      CONTINUE.
    ENDIF.

    " Skip items without budget
    IF ls_wbs-wert2 IS INITIAL.
      CONTINUE.
    ENDIF.

    " Get sender WBS details
    SELECT SINGLE p~objnr, p~posid, p~psphi
      FROM prps AS p
      INTO (@lv_sender_objnr, @lv_posid, @lv_parent_pspnr)
      WHERE p~posid = @ls_wbs-posid.

    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    " Get parent (receiver) WBS
    SELECT SINGLE objnr, posid
      FROM prps
      INTO (@lv_receiver_objnr, @lv_parent_posid)
      WHERE pspnr = @lv_parent_pspnr.

    IF sy-subrc <> 0 OR lv_receiver_objnr IS INITIAL.
      CONTINUE.
    ENDIF.

    " Convert POSID to external format for BDC
    CALL FUNCTION 'CONVERSION_EXIT_ABPSP_OUTPUT'
      EXPORTING
        input  = lv_posid
      IMPORTING
        output = lv_posid.

    CALL FUNCTION 'CONVERSION_EXIT_ABPSP_OUTPUT'
      EXPORTING
        input  = lv_parent_posid
      IMPORTING
        output = lv_parent_posid.

    CLEAR lt_bdcdata.

    "═══════════════════════════════════════════════════════════════
    " BDC Screen 1: CJB2 Initial Screen (SAPLKAZB 1000)
    "═══════════════════════════════════════════════════════════════
    bdc_dynpro(
      EXPORTING
        iv_program = 'SAPLKAZB'
        iv_dynpro  = '1000'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'BDC_CURSOR'
        iv_fval = 'RKAUF-TEST'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'BDC_OKCODE'
        iv_fval = 'RUN'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'RKAUF-TEST'
        iv_fval = lv_posid  " Sender WBS
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    "═══════════════════════════════════════════════════════════════
    " BDC Screen 2: Settlement Rule Details (SAPLKAOP 0570)
    "═══════════════════════════════════════════════════════════════
    bdc_dynpro(
      EXPORTING
        iv_program = 'SAPLKAOP'
        iv_dynpro  = '0570'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'BDC_CURSOR'
        iv_fval = 'LKP74-PSPID'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'LKP74-PSPID'
        iv_fval = lv_parent_posid  " Receiver WBS
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'BDC_OKCODE'
        iv_fval = '=SICH'  " Save
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    "═══════════════════════════════════════════════════════════════
    " Execute BDC Transaction
    "═══════════════════════════════════════════════════════════════
    CLEAR lt_bdcmsg.

    CALL TRANSACTION 'CJB2'
      USING lt_bdcdata
      MODE lv_mode
      UPDATE lv_update
      MESSAGES INTO lt_bdcmsg.

    "═══════════════════════════════════════════════════════════════
    " Check for Errors
    "═══════════════════════════════════════════════════════════════
    LOOP AT lt_bdcmsg INTO ls_bdcmsg WHERE msgtyp = 'E' OR msgtyp = 'A'.
      MESSAGE ID ls_bdcmsg-msgid TYPE 'E' NUMBER ls_bdcmsg-msgnr
        WITH ls_bdcmsg-msgv1 ls_bdcmsg-msgv2 
             ls_bdcmsg-msgv3 ls_bdcmsg-msgv4.
      rv_success = abap_false.
      RETURN.
    ENDLOOP.

    "═══════════════════════════════════════════════════════════════
    " Activate SETC Status
    "═══════════════════════════════════════════════════════════════
    CALL FUNCTION 'STATUS_CHANGE_INTERN'
      EXPORTING
        client              = sy-mandt
        objnr               = lv_sender_objnr
        user_stat           = 'SETC'
        set_inact           = ''
      EXCEPTIONS
        object_not_found    = 1
        status_inconsistent = 2
        OTHERS              = 3.

    IF sy-subrc <> 0.
      MESSAGE e024(zcj00).  " Settlement rule error
      rv_success = abap_false.
      RETURN.
    ENDIF.

  ENDLOOP.

  COMMIT WORK AND WAIT.
  rv_success = abap_true.

ENDMETHOD.






METHOD bdc_dynpro.
*&---------------------------------------------------------------------*
*& Add screen to BDC data table
*&---------------------------------------------------------------------*

  DATA: ls_bdcdata TYPE bdcdata.

  CLEAR ls_bdcdata.
  ls_bdcdata-program  = iv_program.
  ls_bdcdata-dynpro   = iv_dynpro.
  ls_bdcdata-dynbegin = 'X'.
  APPEND ls_bdcdata TO ct_bdcdata.

ENDMETHOD.


METHOD bdc_field.
*&---------------------------------------------------------------------*
*& Add field to BDC data table
*&---------------------------------------------------------------------*

  DATA: ls_bdcdata TYPE bdcdata.

  IF iv_fval IS NOT INITIAL.
    CLEAR ls_bdcdata.
    ls_bdcdata-fnam = iv_fnam.
    ls_bdcdata-fval = iv_fval.
    APPEND ls_bdcdata TO ct_bdcdata.
  ENDIF.

ENDMETHOD.
