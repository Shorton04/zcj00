      END OF ts_mhis.

    TYPES:
      BEGIN OF ts_iloa,
        iloan TYPE iloa-iloan,
        tplnr TYPE iloa-tplnr,
      END OF ts_iloa.

    TYPES:
      BEGIN OF ts_t001w,
        werks TYPE t001w-werks,
        name1 TYPE t001w-name1,
      END OF ts_t001w.

    CLASS-DATA gs_variant TYPE disvariant.
    CLASS-DATA gv_program TYPE sy-cprog.

