*&---------------------------------------------------------------------*
*& Form VALIDATE_SCREEN1
*&---------------------------------------------------------------------*
FORM validate_screen1.

  DATA: lv_error TYPE abap_bool,
        lv_kokrs TYPE kokrs.

  SELECT SINGLE kokrs
    INTO @lv_kokrs
    FROM impr
    WHERE posnr = @p_posnr.

  " Cost Center validation
  PERFORM validate_cost_center USING lv_kokrs p_kostl p_plsez
  CHANGING lv_error.

  " Profit Center validation
  PERFORM validate_profit_center USING lv_kokrs p_prctr p_plsez
  CHANGING lv_error.

  " CC to PC assignment
  PERFORM validate_cc_pc_assignment USING lv_kokrs p_kostl p_prctr
  CHANGING lv_error.

  " FR Unit validation
  PERFORM validate_fr_unit USING p_posnr p_prctr
  CHANGING lv_error.

  IF lv_error = abap_true.
    MESSAGE e004. " Validation errors found
  ENDIF.

ENDFORM.


*&---------------------------------------------------------------------*
*& Form VALIDATE_COST_CENTER
*&---------------------------------------------------------------------*
FORM validate_cost_center USING iv_kokrs TYPE kokrs
                                iv_kostl TYPE kostl
                                iv_plsez TYPE ps_plsez_chg
                          CHANGING cv_error TYPE abap_bool.

  " Check cost center validity against Finish Date
  SELECT SINGLE @abap_true
    FROM csks
    WHERE kostl = @iv_kostl
      AND kokrs = @iv_kokrs
      AND datab <= @iv_plsez
      AND datbi >= @iv_plsez
   INTO @DATA(lv_found) .
  IF sy-subrc = 0.
    CLEAR cv_error.
  ELSE.
    MESSAGE e000(zmsg_a2r) WITH iv_kostl iv_plsez.
    cv_error = gc_x.
  ENDIF.
ENDFORM.


*&---------------------------------------------------------------------*
*& Form VALIDATE_PROFIT_CENTER
*&---------------------------------------------------------------------*
FORM validate_profit_center USING iv_kokrs TYPE kokrs
                                  iv_prctr TYPE prctr
                                  iv_plsez TYPE ps_plsez_chg
                         CHANGING cv_error TYPE abap_bool.

  " Check profit center validity against Finish Date
  SELECT SINGLE @abap_true FROM cepc
    INTO @DATA(lv_found)
  WHERE prctr = @iv_prctr
    AND kokrs = @iv_kokrs
    AND datbi >= @iv_plsez.

  IF sy-subrc = 0.
    CLEAR cv_error.
  ELSE.
    MESSAGE e000(zmsg_a2r) WITH iv_prctr iv_plsez.
    cv_error = gc_x.
  ENDIF.
ENDFORM.


*&---------------------------------------------------------------------*
*& Form VALIDATE_CC_PC_ASSIGNMENT
*&---------------------------------------------------------------------*
FORM validate_cc_pc_assignment USING iv_kokrs TYPE kokrs
                                     iv_kostl TYPE kostl
                                     iv_prctr TYPE prctr
                            CHANGING cv_error TYPE abap_bool.

  SELECT kokrs, kostl, datbi, datab, bukrs, prctr
    FROM csks
    INTO @DATA(ls_csks)
     WHERE kokrs = @iv_kokrs
     AND   kostl = @iv_kostl
     AND   prctr = @iv_prctr
     AND datab <= @sy-datum
     AND datbi >= @sy-datum
    ORDER BY datab.
  ENDSELECT.


  IF ls_csks-prctr <> iv_prctr.
    MESSAGE e000(zmsg_a2r) WITH iv_kostl.
    cv_error = gc_x.
    RETURN.
  ENDIF.

  SELECT prctr, datbi, kokrs, bukrs
    FROM cepc
    INTO @DATA(ls_cepc)
    WHERE prctr = @iv_prctr
    AND kokrs = @iv_kokrs
    ORDER BY datbi.
  ENDSELECT.

  IF ls_cepc-bukrs IS NOT INITIAL AND
      ls_cepc-bukrs NE ls_csks-bukrs.
    MESSAGE e010.
    cv_error = gc_x.
  ENDIF.

ENDFORM.

