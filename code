METHODS set_blkd_status_for_higher_wbs
  IMPORTING
    it_wbs_items TYPE tt_wbs_items
  RETURNING
    VALUE(rv_success) TYPE abap_bool.



METHOD set_blkd_status_for_higher_wbs.

  DATA: ls_item        TYPE ztb_a2r_wbsitem,
        lv_pspnr       TYPE prps-pspnr,
        lv_parent_pspnr TYPE prhi-psphi,
        lv_parent_posid TYPE prps-posid,
        lt_status      TYPE TABLE OF bapi_bus2054_user_status,
        ls_status      TYPE bapi_bus2054_user_status,
        lt_return      TYPE TABLE OF bapiret2.

  rv_success = abap_false.
  CLEAR: lt_status, lt_return.

  LOOP AT it_wbs_items INTO ls_item.

    "Get PSPNR of current WBS
    SELECT SINGLE pspnr
      INTO @lv_pspnr
      FROM prps
      WHERE posid = @ls_item-posid.

    IF sy-subrc <> 0 OR lv_pspnr IS INITIAL.
      CONTINUE.
    ENDIF.

    "Get higher level WBS (parent)
    SELECT SINGLE psphi
      INTO @lv_parent_pspnr
      FROM prhi
      WHERE pspnr = @lv_pspnr.

    IF sy-subrc <> 0 OR lv_parent_pspnr IS INITIAL.
      CONTINUE.
    ENDIF.

    "Get parent POSID
    SELECT SINGLE posid
      INTO @lv_parent_posid
      FROM prps
      WHERE pspnr = @lv_parent_pspnr.

    IF sy-subrc <> 0 OR lv_parent_posid IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_status.
    ls_status-wbs_element = lv_parent_posid.
    ls_status-user_status = 'BLKD'.
    ls_status-set_status  = 'X'.

    APPEND ls_status TO lt_status.

  ENDLOOP.

  IF lt_status IS INITIAL.
    rv_success = abap_true.
    RETURN.
  ENDIF.

  CALL FUNCTION 'BAPI_BUS2054_SET_STATUS'
    TABLES
      i_wbs_user_status = lt_status
      return            = lt_return.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  READ TABLE lt_return WITH KEY type = 'E' TRANSPORTING NO FIELDS.
  IF sy-subrc = 0.
    RETURN.
  ENDIF.

  rv_success = abap_true.

ENDMETHOD.



METHOD assign_budget_cj30.

  DATA: lv_errors_found TYPE oax,
        lt_bpak         TYPE TABLE OF bpak,
        ls_bpak         TYPE bpak,
        ls_item         TYPE ztb_a2r_wbsitem,
        lv_objnr        TYPE j_objnr,
        lv_waers        TYPE waers,
        lt_return       TYPE TABLE OF bapiret2.

  rv_success = abap_false.
  CLEAR: lt_bpak, lt_return, lv_errors_found.

  "Currency from header (mandatory for your system)
  lv_waers = get_currency_from_header( is_header ).
  IF lv_waers IS INITIAL.
    RETURN.
  ENDIF.

  "Build CJ30 budget lines (only for flagged WBS if needed)
  LOOP AT it_wbs_items INTO ls_item.

    ">>> If you must budget only flagged WBS, uncomment and replace field name
    "IF ls_item-zbudget_check IS INITIAL.
    "  CONTINUE.
    "ENDIF.

    IF ls_item-wert2 IS INITIAL.
      CONTINUE.
    ENDIF.

    SELECT SINGLE objnr
      FROM prps
      INTO @lv_objnr
      WHERE posid = @ls_item-posid.

    IF sy-subrc <> 0 OR lv_objnr IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_bpak.
    ls_bpak-e_objnr = lv_objnr.
    ls_bpak-e_versn = '000'.
    ls_bpak-e_perio = '001'.
    ls_bpak-e_wrttp = '41'.        "CJ30 Budget value type
    ls_bpak-wert    = ls_item-wert2.
    ls_bpak-twaer   = lv_waers.

    APPEND ls_bpak TO lt_bpak.

  ENDLOOP.

  "Nothing to budget => still ok, but BLKD can still be applied if you want.
  IF lt_bpak IS INITIAL.
    "Option A: still set BLKD even if no budget posted (based on FDS)
    rv_success = set_blkd_status_for_higher_wbs( it_wbs_items = it_wbs_items ).
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "CJ30 equivalent (Budget) => KBUD
  "------------------------------------------------------------
  CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
    EXPORTING
      i_budget_activity = 'KBUD'   "CJ30
      i_delta_amounts   = 'X'
      i_rollup_data     = 'X'
      i_check_plan_data = 'X'
      i_application     = 'P'
      i_commit_all      = 'X'
    IMPORTING
      e_errors_found    = lv_errors_found
    TABLES
      it_bpak           = lt_bpak
      it_return         = lt_return
    EXCEPTIONS
      no_update         = 1
      OTHERS            = 2.

  IF sy-subrc <> 0 OR lv_errors_found IS NOT INITIAL.
    RETURN.
  ENDIF.

  READ TABLE lt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
  IF sy-subrc = 0.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  "After successful CJ30: set BLKD on higher-level WBS
  "------------------------------------------------------------
  IF set_blkd_status_for_higher_wbs( it_wbs_items = it_wbs_items ) = abap_false.
    "Budget posted but BLKD failed => treat as failure (per FDS)
    rv_success = abap_false.
    RETURN.
  ENDIF.

  rv_success = abap_true.

ENDMETHOD.