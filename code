METHOD set_blkd_status_for_higher_wbs.

  DATA: lv_pspid      TYPE ps_pspid,
        lv_proj_pspnr TYPE proj-pspnr,
        lt_prhi       TYPE TABLE OF prhi,
        ls_prhi       TYPE prhi,
        lt_user_stat  TYPE TABLE OF bapi_wbs_mnt_user_status,
        ls_user_stat  TYPE bapi_wbs_mnt_user_status,
        lt_result     TYPE TABLE OF bapi_status_result,
        ls_result     TYPE bapi_status_result.

  rv_success = abap_false.

  "Get PSPID from first item
  READ TABLE it_wbs_items INTO DATA(ls_any) INDEX 1.
  IF sy-subrc <> 0 OR ls_any-pspid IS INITIAL.
    RETURN.
  ENDIF.
  lv_pspid = ls_any-pspid.

  CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

  "FDS Step 1: Get PROJ-PSPNR using PSPID
  SELECT SINGLE pspnr
    INTO @lv_proj_pspnr
    FROM proj
    WHERE pspid = @lv_pspid.

  IF sy-subrc <> 0 OR lv_proj_pspnr IS INITIAL.
    RETURN.
  ENDIF.

  "FDS Step 1: Get PRHI-UP where PRHI-PSPHI = PROJ-PSPNR
  SELECT *
    FROM prhi
    INTO TABLE @lt_prhi
    WHERE psphi = @lv_proj_pspnr.

  IF lt_prhi IS INITIAL.
    rv_success = abap_true.
    RETURN.
  ENDIF.

  "FDS Step 2: Set BLKD for PRHI-UP
  LOOP AT lt_prhi INTO ls_prhi.
    CLEAR ls_user_stat.
    ls_user_stat-wbs_element     = ls_prhi-up.     "WBS_ELEMENT = PRHI-UP
    ls_user_stat-set_user_status = 'BLKD'.
    APPEND ls_user_stat TO lt_user_stat.
  ENDLOOP.

  SORT lt_user_stat BY wbs_element.
  DELETE ADJACENT DUPLICATES FROM lt_user_stat COMPARING wbs_element.

  CALL FUNCTION 'BAPI_BUS2054_SET_STATUS'
    TABLES
      i_wbs_user_status = lt_user_stat
      e_result          = lt_result.

  CALL FUNCTION 'BAPI_PS_PRECOMMIT'.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  "Check results
  LOOP AT lt_result INTO ls_result.
    IF ls_result-message_type = 'E'
    OR ls_result-message_type = 'A'
    OR ls_result-message_type = 'X'.
      rv_success = abap_false.
      RETURN.
    ENDIF.
  ENDLOOP.

  rv_success = abap_true.

ENDMETHOD.