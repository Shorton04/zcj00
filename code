*&---------------------------------------------------------------------*
*& METHOD: GET_NEXT_PROJECT_NUMBER (Fixed - Use CN_SUCHE_FREIE_NUMMER)
*& Based on old system reference - uses SAP standard PS function
*&---------------------------------------------------------------------*

METHOD get_next_project_number.

  DATA: lv_project_st  TYPE ps_posid,
        lv_project_new TYPE ps_posid,
        lv_pspid_int   TYPE ps_pspid.

  CLEAR: rv_pspid.

  " ═══════════════════════════════════════════════════════════════
  " Get Project Type Prefix (first 2 characters)
  " ═══════════════════════════════════════════════════════════════
  " For CAPEX: Use conversion to get proper format
  " For OPEX: Use direct prefix from configuration or default 'P'
  
  IF iv_profl IS NOT INITIAL.
    " Get project type from profile or use default 'P'
    lv_project_st = 'P'.
  ELSE.
    lv_project_st = 'P'.
  ENDIF.

  " ═══════════════════════════════════════════════════════════════
  " Call SAP Standard Function to Find Next Free Number
  " This respects the project profile's numbering configuration
  " ═══════════════════════════════════════════════════════════════
  CALL FUNCTION 'CN_SUCHE_FREIE_NUMMER'
    EXPORTING
      search_imp      = '1'           " Search for project definition
      refresh         = abap_true     " Refresh number buffer
      proj_s_imp      = lv_project_st " Project type prefix
    IMPORTING
      proj_exp        = lv_project_new " Returns external format (masked)
    EXCEPTIONS
      wrong_search    = 1
      search_canceled = 2
      OTHERS          = 3.

  IF sy-subrc <> 0.
    " Error handling
    MESSAGE ID sy-msgid TYPE 'E' NUMBER sy-msgno
      WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    RETURN.
  ENDIF.

  " ═══════════════════════════════════════════════════════════════
  " Check if number was generated
  " ═══════════════════════════════════════════════════════════════
  IF lv_project_new IS INITIAL.
    MESSAGE ID 'CJ' TYPE 'E' NUMBER '132'.
    RETURN.
  ENDIF.

  " ═══════════════════════════════════════════════════════════════
  " Convert to Internal Format (PSPID for database)
  " Note: Uses ABPSN (Project) not ABPSP (WBS)!
  " ═══════════════════════════════════════════════════════════════
  CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
    EXPORTING
      input  = lv_project_new   " External: P-2026-000123
    IMPORTING
      output = lv_pspid_int.    " Internal: stored format

  " ═══════════════════════════════════════════════════════════════
  " Check if Project Already Exists
  " ═══════════════════════════════════════════════════════════════
  CALL FUNCTION 'CJDW_PROJ_SELECT_SINGLE'
    EXPORTING
      pspid     = lv_pspid_int
    EXCEPTIONS
      not_found = 1.

  IF sy-subrc <> 1.
    " Project already exists - error
    MESSAGE ID 'CJ' TYPE 'E' NUMBER '010' WITH lv_project_new.
    RETURN.
  ENDIF.

  " ═══════════════════════════════════════════════════════════════
  " Return the INTERNAL format for storage
  " The calling method will convert to external for BAPI
  " ═══════════════════════════════════════════════════════════════
  rv_pspid = lv_pspid_int.

ENDMETHOD.
