FORM convert_wbs_posid_to_external.

  TYPES: BEGIN OF ty_pspnr,
           pspnr TYPE prps-pspnr,
         END OF ty_pspnr.

  TYPES: BEGIN OF ty_prps_map,
           pspnr TYPE prps-pspnr,
           posid TYPE prps-posid,
         END OF ty_prps_map.

  DATA: lt_pspnr    TYPE SORTED TABLE OF ty_pspnr WITH UNIQUE KEY pspnr,
        lt_prps_raw TYPE STANDARD TABLE OF ty_prps_map,
        lt_prps_map TYPE HASHED TABLE OF ty_prps_map WITH UNIQUE KEY pspnr,
        ls_pspnr    TYPE ty_pspnr,
        ls_prps_map TYPE ty_prps_map.

  FIELD-SYMBOLS: <fs_wbs> TYPE ztb_a2r_wbsitem.

* Collect all internal PSPNR values from gt_wbs_items-posid
  LOOP AT gt_wbs_items ASSIGNING <fs_wbs>.
    IF <fs_wbs>-posid IS NOT INITIAL.
      ls_pspnr-pspnr = <fs_wbs>-posid.
      INSERT ls_pspnr INTO TABLE lt_pspnr.
    ENDIF.
  ENDLOOP.

  IF lt_pspnr IS INITIAL.
    RETURN.
  ENDIF.

* Read PRPS once
  SELECT pspnr, posid
    INTO TABLE @lt_prps_raw
    FROM prps
    FOR ALL ENTRIES IN @lt_pspnr
    WHERE pspnr = @lt_pspnr-pspnr.

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

* Move to hashed table for fast lookup
  lt_prps_map = CORRESPONDING #( lt_prps_raw ).

* Replace internal posid with external posid
  LOOP AT gt_wbs_items ASSIGNING <fs_wbs>.
    READ TABLE lt_prps_map INTO ls_prps_map
      WITH TABLE KEY pspnr = CONV prps-pspnr( <fs_wbs>-posid ).

    IF sy-subrc = 0 AND ls_prps_map-posid IS NOT INITIAL.
      <fs_wbs>-posid = ls_prps_map-posid.
    ENDIF.
  ENDLOOP.

ENDFORM.