METHOD save_request_for_submit_b3.

  IMPORTING
    is_header    TYPE ztb_a2r_wbshdr
    it_wbs_items TYPE STANDARD TABLE OF ztb_a2r_wbsitem

  RETURNING
    VALUE(rv_reqnum) TYPE ztb_a2r_wbshdr-zreq_num.

ENDMETHOD.



METHOD save_request_for_submit_b3.

  DATA: ls_header TYPE ztb_a2r_wbshdr,
        ls_item   TYPE ztb_a2r_wbsitem,
        ls_wbs    TYPE ztb_a2r_wbsitem,
        lv_error  TYPE abap_bool.

  DATA: lv_vkokr TYPE kokrs,
        lv_pspnr TYPE ps_pspnr.

*---------------------------------------------------------------------*
* Determine controlling area
*---------------------------------------------------------------------*

  lv_vkokr = is_header-vkokr.

  IF lv_vkokr IS INITIAL.

    READ TABLE it_wbs_items INTO DATA(ls_any) INDEX 1.

    IF sy-subrc = 0 AND ls_any-posnr IS NOT INITIAL.

      lv_pspnr = ls_any-posnr.

      SELECT SINGLE pkokr
        INTO lv_vkokr
        FROM prpss
        WHERE pspnr = lv_pspnr.

    ENDIF.

  ENDIF.

*---------------------------------------------------------------------*
* STEP 1 : ALWAYS GENERATE NEW REQUEST NUMBER
*---------------------------------------------------------------------*

  rv_reqnum = get_next_request_number( ).

  IF rv_reqnum IS INITIAL.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* STEP 2 : PREPARE HEADER
*---------------------------------------------------------------------*

  CLEAR ls_header.

  ls_header-mandt = sy-mandt.
  ls_header-zreq_num = rv_reqnum.

  ls_header-posnr = is_header-posnr.
  ls_header-prnam = is_header-prnam.
  ls_header-pspnr = is_header-pspnr.
  ls_header-post1 = is_header-post1.
  ls_header-vernr = is_header-vernr.
  ls_header-plsez = is_header-plsez.
  ls_header-bukrs = is_header-bukrs.
  ls_header-werks = is_header-werks.
  ls_header-waers = is_header-waers.
  ls_header-prctr = is_header-prctr.
  ls_header-kostl = is_header-kostl.

  ls_header-vkokr = lv_vkokr.

  ls_header-izwek = is_header-izwek.
  ls_header-zunifier_proj = is_header-zunifier_proj.
  ls_header-usr008 = is_header-usr008.
  ls_header-profl = is_header-profl.

*---------------------------------------------------------------------*
* B3 specific
*---------------------------------------------------------------------*

  ls_header-z_reqtype = 'B3'.
  ls_header-request_status = 'PENDING'.

  ls_header-ernam = sy-uname.
  ls_header-erdat = sy-datum.

  IF is_header-z_remarks IS NOT INITIAL.
    ls_header-z_remarks = is_header-z_remarks.
  ENDIF.

*---------------------------------------------------------------------*
* STEP 3 : INSERT HEADER
*---------------------------------------------------------------------*

  INSERT ztb_a2r_wbshdr FROM ls_header.

  IF sy-subrc <> 0.
    CLEAR rv_reqnum.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* STEP 4 : INSERT ITEMS
*---------------------------------------------------------------------*

  LOOP AT it_wbs_items INTO ls_wbs WHERE wert2 > 0.

    CLEAR ls_item.

    ls_item-mandt = sy-mandt.
    ls_item-zreq_num = rv_reqnum.
    ls_item-bukrs = ls_header-bukrs.

    ls_item-vkokr = lv_vkokr.

    ls_item-posid = ls_wbs-posid.
    ls_item-stufe = ls_wbs-stufe.
    ls_item-post1 = ls_wbs-post1.
    ls_item-kostl = ls_wbs-kostl.
    ls_item-wert2 = ls_wbs-wert2.

    ls_item-zbudget_check = ls_wbs-zbudget_check.

    ls_item-imprf = ls_wbs-imprf.
    ls_item-prart = ls_wbs-prart.

    ls_item-werks = ls_header-werks.

    IF ls_wbs-posnr IS NOT INITIAL.
      ls_item-posnr = ls_wbs-posnr.
    ENDIF.

    INSERT ztb_a2r_wbsitem FROM ls_item.

    IF sy-subrc <> 0.
      lv_error = abap_true.
      EXIT.
    ENDIF.

  ENDLOOP.

*---------------------------------------------------------------------*
* COMMIT
*---------------------------------------------------------------------*

  IF lv_error = abap_false.
    COMMIT WORK AND WAIT.
  ELSE.
    ROLLBACK WORK.
    CLEAR rv_reqnum.
  ENDIF.

ENDMETHOD.




FORM submit_b3.

  DATA: lv_reqnum  TYPE ztb_a2r_wbshdr-zreq_num,
        lv_success TYPE abap_bool.

*---------------------------------------------------------------------*
* STEP 1 : Sync screen
*---------------------------------------------------------------------*

  PERFORM sync_screen_to_header.
  PERFORM convert_from_display.

  IF go_builder IS INITIAL.
    CREATE OBJECT go_builder.
  ENDIF.

*---------------------------------------------------------------------*
* STEP 2 : SAVE B3 REQUEST
*---------------------------------------------------------------------*

  lv_reqnum = go_builder->save_request_for_submit_b3(
                is_header    = gs_header
                it_wbs_items = gt_wbs_items ).

  IF lv_reqnum IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'Failed to create B3 request'.
    RETURN.
  ENDIF.

  gs_header-zreq_num = lv_reqnum.

*---------------------------------------------------------------------*
* STEP 3 : Execute Critical Change
*---------------------------------------------------------------------*

  lv_success = go_builder->change_project_critical(
                 iv_pspnr     = gs_header-pspnr
                 is_header    = gs_header
                 is_header_old = gs_header ).

*---------------------------------------------------------------------*
* STEP 4 : Update Status
*---------------------------------------------------------------------*

  IF lv_success = abap_true.

    UPDATE ztb_a2r_wbshdr
      SET request_status       = 'APPROVED',
          zapproved_by         = @sy-uname,
          zrequest_approved_on = @sy-datum
      WHERE zreq_num = @lv_reqnum.

    COMMIT WORK AND WAIT.

    MESSAGE s000(zmsg_a2r) WITH 'B3 request approved'(m21) lv_reqnum.

  ELSE.

    UPDATE ztb_a2r_wbshdr
      SET request_status = 'ERROR'
      WHERE zreq_num = @lv_reqnum.

    COMMIT WORK AND WAIT.

    MESSAGE e000(zmsg_a2r) WITH 'Critical change failed'.

  ENDIF.

ENDFORM.