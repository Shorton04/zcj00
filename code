    CLEAR ls_bpak.
    ls_bpak-e_objnr = lv_objnr.
    ls_bpak-e_versn = '000'.
    ls_bpak-e_perio = '001'.
    ls_bpak-e_wrttp = '41'.        "BUDGET (CJ30)
    ls_bpak-wert    = ls_item-wert2.
    ls_bpak-twaer   = lv_waers.

    APPEND ls_bpak TO lt_bpak.

  ENDLOOP.

  IF lt_bpak IS INITIAL.
    rv_success = abap_true.
    RETURN.
  ENDIF.

  CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
    EXPORTING
      i_budget_activity = 'KBUD'   "CJ30
      i_delta_amounts   = 'X'
      i_rollup_data     = 'X'
      i_check_plan_data = 'X'
      i_application     = 'P'
      i_commit_all      = 'X'
    IMPORTING
      e_errors_found    = lv_errors_found
    TABLES
      it_bpak           = lt_bpak
      it_return         = lt_return.

  IF sy-subrc <> 0 OR lv_errors_found IS NOT INITIAL.
    RETURN.
  ENDIF.

  READ TABLE lt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
  IF sy-subrc = 0.
    RETURN.
  ENDIF.

  rv_success = abap_true.

ENDMETHOD.


METHOD post_plan_im52_cj30_flow.

  rv_success = abap_false.

  IF assign_plan_values(
       is_header    = is_header
       it_wbs_items = it_wbs_items ) = abap_false.
    RETURN.
  ENDIF.

  IF distribute_budget_im52(
       is_header    = is_header
       it_wbs_items = it_wbs_items ) = abap_false.
    RETURN.
  ENDIF.

  IF assign_budget_cj30(
       is_header    = is_header
       it_wbs_items = it_wbs_items ) = abap_false.
    RETURN.
  ENDIF.

  rv_success = abap_true.

ENDMETHOD.