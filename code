FORM get_raw_data USING iv_pspid_proj TYPE ztb_a2r_wbshdr-pspid.

*---------------------------------------------------------------------*
* 1. HEADER
*---------------------------------------------------------------------*
  DATA: ls_header TYPE proj.

  SELECT SINGLE pspnr post1 ernam erdat vernr
                vbukr vkokr prctr plsez werks profl kostl
    INTO ls_header
    FROM proj
    WHERE pspid = iv_pspid_proj.

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  CLEAR: gs_header, gt_wbs_items.

  MOVE-CORRESPONDING ls_header TO gs_header.
  gs_header-bukrs = ls_header-vbukr.

*---------------------------------------------------------------------*
* 2. PRPS
*---------------------------------------------------------------------*
  DATA: lt_prps TYPE STANDARD TABLE OF prps.

  SELECT pspnr posid post1 objnr
         pbukr pkokr fkstl werks stufe zunifier_proj
    INTO TABLE lt_prps
    FROM prps
    WHERE psphi = ls_header-pspnr.

  IF lt_prps IS INITIAL.
    RETURN.
  ENDIF.

*---------------------------------------------------------------------*
* 3. V_IVP_PR
*---------------------------------------------------------------------*
  DATA: lt_ivp   TYPE STANDARD TABLE OF v_ivp_pr,
        lt_ivp_h TYPE HASHED TABLE OF v_ivp_pr WITH UNIQUE KEY posid.

  SELECT posid prnam gjahr posnr prart
    INTO TABLE lt_ivp
    FROM v_ivp_pr
    FOR ALL ENTRIES IN lt_prps
    WHERE posid = lt_prps-posid.

  IF lt_ivp IS NOT INITIAL.
    lt_ivp_h = lt_ivp.
  ENDIF.

*---------------------------------------------------------------------*
* 4. IMPR
*---------------------------------------------------------------------*
  DATA: lt_posnr TYPE SORTED TABLE OF impr-posnr WITH UNIQUE KEY table_line,
        lt_impr  TYPE STANDARD TABLE OF impr,
        lt_impr_h TYPE HASHED TABLE OF impr WITH UNIQUE KEY posnr.

  FIELD-SYMBOLS: <ls_ivp> TYPE v_ivp_pr.

  LOOP AT lt_ivp ASSIGNING <ls_ivp>.
    INSERT <ls_ivp>-posnr INTO TABLE lt_posnr.
  ENDLOOP.

  IF lt_posnr IS NOT INITIAL.

    SELECT posnr izwek
      INTO TABLE lt_impr
      FROM impr
      WHERE posnr IN lt_posnr.

    IF lt_impr IS NOT INITIAL.
      lt_impr_h = lt_impr.
    ENDIF.

  ENDIF.

*---------------------------------------------------------------------*
* 5. OBJNR
*---------------------------------------------------------------------*
  DATA: lt_objnr TYPE SORTED TABLE OF bpge-objnr WITH UNIQUE KEY table_line.

  FIELD-SYMBOLS: <ls_prps> TYPE prps.

  LOOP AT lt_prps ASSIGNING <ls_prps>.
    INSERT <ls_prps>-objnr INTO TABLE lt_objnr.
  ENDLOOP.

*---------------------------------------------------------------------*
* 6. BPGE KSTP
*---------------------------------------------------------------------*
  TYPES: BEGIN OF ty_max_led,
           objnr TYPE bpge-objnr,
           lednr TYPE bpge-lednr,
         END OF ty_max_led.

  DATA: lt_max_kstp TYPE STANDARD TABLE OF ty_max_led,
        lt_kstp     TYPE STANDARD TABLE OF bpge,
        lt_wtges_h  TYPE HASHED TABLE OF bpge WITH UNIQUE KEY objnr.

  IF lt_objnr IS NOT INITIAL.

    SELECT objnr MAX( lednr ) AS lednr
      INTO TABLE lt_max_kstp
      FROM bpge
      WHERE objnr IN lt_objnr
        AND vorga = 'KSTP'
      GROUP BY objnr.

    IF lt_max_kstp IS NOT INITIAL.

      SELECT objnr SUM( wtges ) AS wtges
        INTO TABLE lt_kstp
        FROM bpge
        FOR ALL ENTRIES IN lt_max_kstp
        WHERE objnr = lt_max_kstp-objnr
          AND lednr = lt_max_kstp-lednr
          AND vorga = 'KSTP'
        GROUP BY objnr.

      lt_wtges_h = lt_kstp.

    ENDIF.

  ENDIF.

*---------------------------------------------------------------------*
* 7. BPGE KBUD
*---------------------------------------------------------------------*
  DATA: lt_max_kbud TYPE STANDARD TABLE OF ty_max_led,
        lt_kbud     TYPE STANDARD TABLE OF bpge,
        lt_geber_h  TYPE HASHED TABLE OF bpge WITH UNIQUE KEY objnr.

  IF lt_objnr IS NOT INITIAL.

    SELECT objnr MAX( lednr ) AS lednr
      INTO TABLE lt_max_kbud
      FROM bpge
      WHERE objnr IN lt_objnr
        AND vorga = 'KBUD'
        AND geber IS NOT INITIAL
      GROUP BY objnr.

    IF lt_max_kbud IS NOT INITIAL.

      SELECT objnr MAX( geber ) AS geber
        INTO TABLE lt_kbud
        FROM bpge
        FOR ALL ENTRIES IN lt_max_kbud
        WHERE objnr = lt_max_kbud-objnr
          AND lednr = lt_max_kbud-lednr
          AND vorga = 'KBUD'
          AND geber IS NOT INITIAL
        GROUP BY objnr.

      lt_geber_h = lt_kbud.

    ENDIF.

  ENDIF.

*---------------------------------------------------------------------*
* 8. BUILD OUTPUT
*---------------------------------------------------------------------*
  DATA: ls_wbs_item TYPE ztb_a2r_wbsitem,
        ls_wt       TYPE bpge,
        ls_ivp      TYPE v_ivp_pr,
        ls_impr     TYPE impr,
        ls_gb       TYPE bpge.

  LOOP AT lt_prps INTO ls_prps.

    CLEAR ls_wbs_item.

    ls_wbs_item-mandt = sy-mandt.
    ls_wbs_item-posid = ls_prps-posid.
    ls_wbs_item-post1 = ls_prps-post1.
    ls_wbs_item-bukrs = ls_prps-pbukr.
    ls_wbs_item-vkokr = ls_prps-pkokr.
    ls_wbs_item-stufe = ls_prps-stufe.
    ls_wbs_item-werks = ls_prps-werks.
    ls_wbs_item-pspid = iv_pspid_proj.

    IF gs_header-zunifier_proj IS INITIAL
       AND ls_prps-zunifier_proj IS NOT INITIAL.
      gs_header-zunifier_proj = ls_prps-zunifier_proj.
    ENDIF.

    READ TABLE lt_wtges_h INTO ls_wt WITH KEY objnr = ls_prps-objnr.
    IF sy-subrc = 0.
      ls_wbs_item-wert2 = ls_wt-wtges.
    ENDIF.

    READ TABLE lt_ivp_h INTO ls_ivp WITH KEY posid = ls_prps-posid.
    IF sy-subrc = 0.

      ls_wbs_item-gjahr = ls_ivp-gjahr.
      ls_wbs_item-prart = ls_ivp-prart.

      IF gs_header-prnam IS INITIAL.
        gs_header-prnam = ls_ivp-prnam.
      ENDIF.

      IF gs_header-gjahr IS INITIAL.
        gs_header-gjahr = ls_ivp-gjahr.
      ENDIF.

      IF gs_header-posnr IS INITIAL.
        gs_header-posnr = ls_ivp-posnr.
      ENDIF.

      IF gs_header-izwek IS INITIAL.
        READ TABLE lt_impr_h INTO ls_impr WITH KEY posnr = ls_ivp-posnr.
        IF sy-subrc = 0.
          gs_header-izwek = ls_impr-izwek.
        ENDIF.
      ENDIF.

    ENDIF.

    READ TABLE lt_geber_h INTO ls_gb WITH KEY objnr = ls_prps-objnr.
    IF sy-subrc = 0.
      ls_wbs_item-zbudget_check = ls_gb-geber.
    ENDIF.

    APPEND ls_wbs_item TO gt_wbs_items.

  ENDLOOP.

ENDFORM.