MODULE user_command_0100 INPUT.
  DATA: lv_ok_code1 TYPE sy-ucomm.

  lv_ok_code1 = sy-ucomm.
  CLEAR sy-ucomm.

  " Sync ALL editable screen fields to gs_header on every PAI.
  " The gv_u_* flags are sticky - once set they prevent OUTPUT from reverting.
  IF p_post1 <> gs_header-post1.
    gs_header-post1 = p_post1.
    gv_u_post1 = abap_true.
  ELSEIF gv_u_post1 = abap_true.
    gs_header-post1 = p_post1.   " Keep user value sticky
  ENDIF.

  IF p_verna <> gs_header-vernr.
    gs_header-vernr = p_verna.
    gv_u_vernr = abap_true.
  ELSEIF gv_u_vernr = abap_true.
    gs_header-vernr = p_verna.
  ENDIF.

  IF p_plsez <> gs_header-plsez.
    gs_header-plsez = p_plsez.
    gv_u_plsez = abap_true.
  ELSEIF gv_u_plsez = abap_true.
    gs_header-plsez = p_plsez.
  ENDIF.

  IF p_posnr <> gs_header-posnr.
    gs_header-posnr = p_posnr.
    gv_u_posid = abap_true.
  ELSEIF gv_u_posid = abap_true.
    gs_header-posnr = p_posnr.
  ENDIF.

  IF p_prctr <> gs_header-prctr.
    gs_header-prctr = p_prctr.
    gv_u_prctr = abap_true.
  ELSEIF gv_u_prctr = abap_true.
    gs_header-prctr = p_prctr.
  ENDIF.

  IF p_kostl <> gs_header-kostl.
    gs_header-kostl = p_kostl.
    gv_u_kostl = abap_true.
  ELSEIF gv_u_kostl = abap_true.
    gs_header-kostl = p_kostl.
  ENDIF.

  " ... rest of CASE lv_ok_code1 unchanged




MODULE set_header_display_values OUTPUT.

  DATA: lv_reqtype_text TYPE char20.

  " Only set p_* screen fields from gs_header if user has NOT manually edited them.
  " Once gv_u_* is set, the user owns that field - do NOT touch it.
  IF gv_u_post1 IS INITIAL.
    p_post1  = gs_header-post1.
  ENDIF.

  IF gv_u_vernr IS INITIAL.
    p_verna  = gs_header-vernr.
  ENDIF.

  IF gv_u_plsez IS INITIAL.
    p_plsez  = gs_header-plsez.
  ENDIF.

  IF gv_u_prctr IS INITIAL.
    p_prctr  = gs_header-prctr.
  ENDIF.

  IF gv_u_kostl IS INITIAL.
    p_kostl  = gs_header-kostl.
  ENDIF.

  " Display-only fields (non-editable) - always re-derive, no risk of overwrite
  IF gs_header-ernam IS NOT INITIAL.
    PERFORM get_user_fullname
      USING    gs_header-ernam
      CHANGING lv_fullname.
    gv_requestor_display = lv_fullname.
  ELSE.
    PERFORM get_user_fullname
      USING    sy-uname
      CHANGING lv_fullname.
    gv_requestor_display = lv_fullname.
  ENDIF.

  IF gs_header-z_reqtype IS NOT INITIAL.
    PERFORM get_request_type_text
      USING    gs_header-z_reqtype
      CHANGING lv_reqtype_text.
    gv_reqtype_display = lv_reqtype_text.
  ELSE.
    gv_reqtype_display = 'Create'(c01).
  ENDIF.

  IF gs_header-posnr IS NOT INITIAL.
    PERFORM get_im_posid_for_display
      USING    gs_header-posnr
      CHANGING gv_im_posid_display.
  ENDIF.

  IF gs_header-posnr IS NOT INITIAL.
    PERFORM get_available_budget_display
      USING    gs_header-posnr
      CHANGING gv_avail_budget_text
               gv_available_budget.
  ELSE.
    gv_avail_budget_text = 'No'.
    CLEAR gv_available_budget.
  ENDIF.

  IF gs_header-pspnr IS NOT INITIAL.
    PERFORM get_project_currency
      USING    gs_header-pspnr
      CHANGING gv_project_currency.
  ELSE.
    IF gv_bukrs IS NOT INITIAL.
      SELECT SINGLE waers FROM t001
        INTO gv_project_currency
        WHERE bukrs = gv_bukrs.
    ENDIF.
  ENDIF.

ENDMODULE.



