START-OF-SELECTION.

  DATA: lv_reqtype TYPE ztb_a2r_reqtype-z_reqtype,
        lv_dynnr   TYPE sydynnr.

  PERFORM get_request_type CHANGING lv_reqtype.

  CASE lv_reqtype.
    WHEN 'A1'.
      lv_dynnr = '0200'.
    WHEN 'F1'.
      lv_dynnr = '0500'.
  ENDCASE.

  EXPORT gv_request_type = lv_reqtype
         gv_start_dynnr  = lv_dynnr
    TO MEMORY ID 'ZCJ00_NAV'.

  CALL TRANSACTION 'ZA2R_ZCJ01' AND SKIP FIRST SCREEN.


DATA: gv_request_type TYPE ztb_a2r_reqtype-z_reqtype,
      gv_start_dynnr  TYPE sydynnr.


INITIALIZATION.

  IMPORT gv_request_type = gv_request_type
         gv_start_dynnr  = gv_start_dynnr
    FROM MEMORY ID 'ZCJ00_NAV'.

  IF gv_start_dynnr IS INITIAL.
    gv_start_dynnr = '0200'.
  ENDIF.

  FREE MEMORY ID 'ZCJ00_NAV'.


START-OF-SELECTION.

  CREATE OBJECT go_builder.

  CASE gv_start_dynnr.
    WHEN '0200'.
      CALL SCREEN 200.
    WHEN '0500'.
      CALL SCREEN 500.
    WHEN OTHERS.
      CALL SCREEN 200.
  ENDCASE.