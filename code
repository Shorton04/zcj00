  METHOD unclose_wbs_status.

    DATA: lt_return     TYPE TABLE OF bapiret2,
          ls_return     TYPE bapiret2,
          lt_sys_status TYPE TABLE OF bapi_wbs_mnt_system_status,
          ls_sys_status TYPE bapi_wbs_mnt_system_status,
          ls_unclose    TYPE ty_wbs_unclose,
          lv_has_error  TYPE abap_bool.

    rv_success = abap_false.
    CLEAR: lt_sys_status, lt_return, lv_has_error.

    CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

*---------------------------------------------------------------------*
* Build BAPI input based on current status and target status
*---------------------------------------------------------------------*
    LOOP AT it_wbs_unclose INTO ls_unclose
         WHERE to_be IS NOT INITIAL.

      CLEAR ls_sys_status.

*-------------------------------------------------------------------*
* CLSD -> TECO
*-------------------------------------------------------------------*
      IF ls_unclose-status = 'CLSD'
         AND ls_unclose-to_be = 'TECO'.

        ls_sys_status-wbs_element        = ls_unclose-wbs_element_code.
        ls_sys_status-undo_system_status = 'CLSD'.
        APPEND ls_sys_status TO lt_sys_status.

*-------------------------------------------------------------------*
* TECO -> REL
*-------------------------------------------------------------------*
      ELSEIF ls_unclose-status = 'TECO'
         AND ls_unclose-to_be = 'REL'.

        ls_sys_status-wbs_element        = ls_unclose-wbs_element_code.
        ls_sys_status-undo_system_status = 'TECO'.
        APPEND ls_sys_status TO lt_sys_status.

*-------------------------------------------------------------------*
* CLSD -> REL
* Standard sequence: CLSD -> TECO -> REL
*-------------------------------------------------------------------*
      ELSEIF ls_unclose-status = 'CLSD'
         AND ls_unclose-to_be = 'REL'.

        ls_sys_status-wbs_element        = ls_unclose-wbs_element_code.
        ls_sys_status-undo_system_status = 'CLSD'.
        APPEND ls_sys_status TO lt_sys_status.

        CLEAR ls_sys_status.
        ls_sys_status-wbs_element        = ls_unclose-wbs_element_code.
        ls_sys_status-undo_system_status = 'TECO'.
        APPEND ls_sys_status TO lt_sys_status.

      ENDIF.

    ENDLOOP.

*---------------------------------------------------------------------*
* Nothing to process
*---------------------------------------------------------------------*
    IF lt_sys_status IS INITIAL.
      RETURN.
    ENDIF.

*---------------------------------------------------------------------*
* Call BAPI
*---------------------------------------------------------------------*
    CALL FUNCTION 'BAPI_BUS2054_SET_STATUS'
      TABLES
        i_wbs_system_status = lt_sys_status
        e_result            = lt_return.

    CALL FUNCTION 'BAPI_PS_PRECOMMIT'
      TABLES
        et_return = lt_return.

    CLEAR lt_return.

    LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'EA'.
      lv_has_error = 'X'.
      EXIT.
    ENDLOOP.

    IF lv_has_error = 'X'.
      MESSAGE e029(zcj00) WITH 'BLKD precommit failed'.
      RETURN.
    ENDIF.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = 'X'.

    "Success rule:
    " - if E_RESULT is empty => success
    " - if E_RESULT has any error/abort => fail
    LOOP AT lt_return INTO ls_return.
      "Some systems fill MESSAGE_TYPE; others fill MESSAGE_ID/NUMBER
      IF ls_return-type CA 'AEX'
         OR ls_return-id IS NOT INITIAL.
        rv_success = abap_false.
        RETURN.
      ENDIF.
    ENDLOOP.

    rv_success = abap_true.

  ENDMETHOD.
