          DATA lt_update TYPE STANDARD TABLE OF ztt_a2d_wbs_rec.
*End of modification - A2D_ATC Prio 1 29June2026 UH83030- TR:D30K936762
          LOOP AT lt_data_tot INTO ls_data.
            CLEAR:ls_data_log,lv_error.
            MOVE-CORRESPONDING ls_data TO ls_data_log.
            billing_plan_update( EXPORTING is_data    = ls_data
                                 IMPORTING ev_error   = lv_error
                                           ev_message = ls_data_log-message ).
            IF lv_error IS INITIAL.
              LOOP AT lt_data_db INTO DATA(ls_data_db)
                                 WHERE pspnr = ls_data-pspnr.
*Start of modification - A2D_ATC Prio 1 29June2026 UH83030- TR:D30K936762
*                MODIFY ztt_a2d_wbs_rec FROM ls_data_db.
                 APPEND ls_data_db TO lt_update.
*End of modification - A2D_ATC Prio 1 29June2026 UH83030- TR:D30K936762
              ENDLOOP.
            ENDIF.
            APPEND ls_data_log TO lt_data_log.
          ENDLOOP.
*Start of modification - A2D_ATC Prio 1 29June2026 UH83030- TR:D30K936762
          IF lt_update IS NOT INITIAL.
            MODIFY ztt_a2d_wbs_rec FROM TABLE lt_update.
          ENDIF.
*End of modification - A2D_ATC Prio 1 29June2026 UH83030- TR:D30K936762
          IF sy-subrc = 0.
            " show log popup
            CALL FUNCTION 'ZLONZA_ALV_POPUP_TABLE'
              EXPORTING
                iv_start_col   = 25
                iv_start_line  = 1
                iv_end_col     = 150
                iv_end_line    = 20
                iv_title       = 'Log Details'
                it_field_names = lt_names
              IMPORTING
                ev_choice      = lv_choice
              CHANGING
                it_table       = lt_data_log.
*Re-Select Result
            IF lv_source = 'T'.
              REFRESH:lt_result,ct_result.
              CALL METHOD me->zif_a2d_model_selection~select_result
                EXPORTING
                  io_controller = io_controller
