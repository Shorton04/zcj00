FORM load_tree_hierarchy.

  DATA:
    lv_pspnr_templ TYPE ps_pspnr,
    lv_parent_key  TYPE lvc_nkey,
    ls_node        TYPE treev_node,
    ls_item        TYPE cnpb_h_treeitm,
    lv_last_key    TYPE lvc_nkey VALUE 0,
    lt_pspnr_list  TYPE STANDARD TABLE OF ps_pspnr,
    lv_level       TYPE i,
    lv_max_levels  TYPE i VALUE 10.

  TYPES: BEGIN OF ty_node_map,
           pspnr    TYPE ps_pspnr,
           node_key TYPE lvc_nkey,
         END OF ty_node_map.

  DATA: lt_node_map TYPE STANDARD TABLE OF ty_node_map,
        ls_node_map TYPE ty_node_map.

  ">>> NEW: helper tables for ordering + folder detection
  DATA: lt_children_map TYPE HASHED TABLE OF ps_pspnr WITH UNIQUE KEY table_line.
  DATA: lt_prpss_ordered TYPE STANDARD TABLE OF prpss.
  DATA: lv_posid_out TYPE ps_posid.

  FIELD-SYMBOLS: <fs_prpss> TYPE prpss.

  CHECK p_pspid IS NOT INITIAL.
  CHECK lo_tree_preview IS NOT INITIAL.

  TRY.
      CLEAR: gt_treev_node, gt_treeitm, lt_node_map.

      " Get template from PROJS
      SELECT SINGLE pspid, post1, pspnr
         FROM projs
         INTO @DATA(ls_projs)
        WHERE pspid = @p_pspid.

      IF sy-subrc <> 0.
        CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
          EXPORTING
            input  = p_pspid
          IMPORTING
            output = p_pspid.

        SELECT SINGLE pspid, post1, pspnr
          FROM projs
          INTO @ls_projs
          WHERE pspid = @p_pspid.

        IF sy-subrc <> 0.
          MESSAGE 'Template project not found in PROJS table'(m01) TYPE 'S' DISPLAY LIKE 'W'.
          RETURN.
        ENDIF.
      ENDIF.

      lv_pspnr_templ = ls_projs-pspnr.

      " Step 1: Direct children
      SELECT pspnr, posid, post1, psphi, stufe
        FROM prpss
        INTO TABLE @DATA(lt_prpss_all)
        WHERE psphi = @lv_pspnr_templ.

      IF sy-subrc <> 0.
        MESSAGE 'No WBS elements found for template'(m02) TYPE 'S' DISPLAY LIKE 'W'.
        RETURN.
      ENDIF.

      " Step 2: Get children of children recursively (Level 3+)
      lv_level = 1.
      WHILE lv_level < lv_max_levels.

        CLEAR lt_pspnr_list.
        LOOP AT lt_prpss_all ASSIGNING <fs_prpss>.
          APPEND <fs_prpss>-pspnr TO lt_pspnr_list.
        ENDLOOP.

        IF lt_pspnr_list IS INITIAL.
          EXIT.
        ENDIF.

        SELECT pspnr, posid, post1, psphi, stufe
          FROM prpss
          INTO TABLE @DATA(lt_prpss_level)
          FOR ALL ENTRIES IN @lt_pspnr_list
          WHERE psphi = @lt_pspnr_list-table_line.

        IF sy-subrc <> 0 OR lt_prpss_level IS INITIAL.
          EXIT.
        ENDIF.

        APPEND LINES OF lt_prpss_level TO lt_prpss_all.
        lv_level = lv_level + 1.

      ENDWHILE.

      "=========================================================
      " ✅ FIX 1: DO NOT SORT globally by stufe/posid (breaks tree)
      "=========================================================

      "=========================================================
      " ✅ FIX 2: Build child-exists map (for folder/expander)
      "   If any row has psphi = <parent pspnr> then parent has child
      "=========================================================
      CLEAR lt_children_map.
      LOOP AT lt_prpss_all ASSIGNING <fs_prpss>.
        " mark parent (PSPHI) as having children
        IF <fs_prpss>-psphi IS NOT INITIAL.
          INSERT <fs_prpss>-psphi INTO TABLE lt_children_map.
        ENDIF.
      ENDLOOP.

      "=========================================================
      " ✅ FIX 3: Build ORDERED list: parent -> children
      "    (simple recursive-like expansion using a queue)
      "=========================================================
      CLEAR lt_prpss_ordered.

      "Start from template project as root parent
      DATA: lt_queue TYPE STANDARD TABLE OF ps_pspnr,
            lv_parent TYPE ps_pspnr.

      CLEAR lt_queue.
      APPEND lv_pspnr_templ TO lt_queue.

      WHILE lt_queue IS NOT INITIAL.
        READ TABLE lt_queue INTO lv_parent INDEX 1.
        DELETE lt_queue INDEX 1.

        "Collect direct children of this parent, keep stable order by POSID
        DATA(lt_children) = VALUE prpss_t( ). "may not exist in your release; use normal table below

        DATA: lt_children2 TYPE STANDARD TABLE OF prpss.
        CLEAR lt_children2.

        LOOP AT lt_prpss_all INTO DATA(ls_child) WHERE psphi = lv_parent.
          APPEND ls_child TO lt_children2.
        ENDLOOP.

        SORT lt_children2 BY stufe posid. "sort siblings only (safe)

        LOOP AT lt_children2 INTO ls_child.
          APPEND ls_child TO lt_prpss_ordered.
          "push this child as next parent candidate (so its children come after it)
          APPEND ls_child-pspnr TO lt_queue.
        ENDLOOP.

      ENDWHILE.

      "----------------------------
      " Build tree root node
      "----------------------------
      lv_last_key = lv_last_key + 1.
      CLEAR ls_node.
      ls_node-node_key    = lv_last_key.
      ls_node-relatkey    = ''.
      ls_node-relatship   = cl_gui_column_tree=>relat_last_child.
      ls_node-hidden      = space.
      ls_node-disabled    = space.
      ls_node-isfolder    = abap_true.
      ls_node-expander    = abap_true.
      APPEND ls_node TO gt_treev_node.

      CLEAR ls_item.
      ls_item-node_key  = lv_last_key.
      ls_item-item_name = lc_hierarchy_short_text.
      ls_item-class     = cl_gui_column_tree=>item_class_text.
      CONCATENATE 'Template:'(m04) ls_projs-post1 INTO ls_item-text SEPARATED BY space.
      APPEND ls_item TO gt_treeitm.

      CLEAR ls_item.
      ls_item-node_key  = lv_last_key.
      ls_item-item_name = lc_hierarchy_technical_key.
      ls_item-class     = cl_gui_column_tree=>item_class_text.
      ls_item-text      = ls_projs-pspid.
      APPEND ls_item TO gt_treeitm.

      ls_node_map-pspnr = lv_pspnr_templ.
      ls_node_map-node_key = lv_last_key.
      APPEND ls_node_map TO lt_node_map.

      "=========================================================
      " Add WBS nodes using ORDERED list (parent always exists)
      "=========================================================
      LOOP AT lt_prpss_ordered INTO DATA(ls_prpss).

        lv_last_key = lv_last_key + 1.

        " Find parent by PSPHI
        CLEAR lv_parent_key.
        READ TABLE lt_node_map INTO ls_node_map WITH KEY pspnr = ls_prpss-psphi.
        IF sy-subrc = 0.
          lv_parent_key = ls_node_map-node_key.
        ELSE.
          lv_parent_key = 1.
        ENDIF.

        "folder if this node has children
        DATA(lv_is_folder) = abap_false.
        READ TABLE lt_children_map WITH KEY table_line = ls_prpss-pspnr TRANSPORTING NO FIELDS.
        IF sy-subrc = 0.
          lv_is_folder = abap_true.
        ENDIF.

        CLEAR ls_node.
        ls_node-node_key    = lv_last_key.
        ls_node-relatkey    = lv_parent_key.
        ls_node-relatship   = cl_gui_column_tree=>relat_last_child.
        ls_node-hidden      = space.
        ls_node-disabled    = space.
        ls_node-isfolder    = lv_is_folder.
        ls_node-expander    = lv_is_folder.
        APPEND ls_node TO gt_treev_node.

        CLEAR ls_item.
        ls_item-node_key  = lv_last_key.
        ls_item-item_name = lc_hierarchy_short_text.
        ls_item-class     = cl_gui_column_tree=>item_class_text.
        ls_item-text      = ls_prpss-post1.
        APPEND ls_item TO gt_treeitm.

        "show external POSID
        CLEAR lv_posid_out.
        CALL FUNCTION 'CONVERSION_EXIT_ABPSP_OUTPUT'
          EXPORTING input  = ls_prpss-posid
          IMPORTING output = lv_posid_out
          EXCEPTIONS OTHERS = 1.

        CLEAR ls_item.
        ls_item-node_key  = lv_last_key.
        ls_item-item_name = lc_hierarchy_technical_key.
        ls_item-class     = cl_gui_column_tree=>item_class_text.
        IF sy-subrc = 0 AND lv_posid_out IS NOT INITIAL.
          ls_item-text = lv_posid_out.
        ELSE.
          ls_item-text = ls_prpss-posid.
        ENDIF.
        APPEND ls_item TO gt_treeitm.

        ls_node_map-pspnr = ls_prpss-pspnr.
        ls_node_map-node_key = lv_last_key.
        APPEND ls_node_map TO lt_node_map.

      ENDLOOP.

      " Display tree (unchanged)
      CALL METHOD lo_tree_preview->delete_all_nodes.

      CALL METHOD lo_tree_preview->hierarchy_header_set_text
        EXPORTING
          text = 'Project Structure: Description' ##NO_TEXT.

      CALL METHOD lo_tree_preview->add_nodes_and_items
        EXPORTING
          node_table                = gt_treev_node
          item_table                = gt_treeitm
          item_table_structure_name = 'CNPB_H_TREEITM' ##NO_TEXT.

      CALL METHOD lo_tree_preview->expand_root_nodes
        EXPORTING
          level_count    = 0
          expand_subtree = abap_true.

      CALL METHOD lo_tree_preview->hierarchy_header_set_width
        EXPORTING
          width     = 50
          width_pix = space.

      CALL METHOD lo_tree_preview->column_set_width
        EXPORTING
          column_name = lc_hierarchy_technical_key
          width       = 25
          width_pix   = space.

      CALL METHOD cl_gui_cfw=>flush
        EXCEPTIONS
          cntl_system_error = 1
          cntl_error        = 2.

      IF sy-subrc = 0.
        lv_tree_loaded = abap_true.
      ENDIF.

    CATCH cx_root INTO DATA(lx_error).
      MESSAGE lx_error->get_text( ) TYPE 'S' DISPLAY LIKE 'E'.
  ENDTRY.

ENDFORM.