SELECT DISTINCT
       a~posnr,
       a~psphi,
       a~up,
       a~down,
       a~left,
       a~right,
       b~pspnr,
       b~posid,
       b~stufe
  INTO TABLE @DATA(lt_hier_join)
  FROM phris AS a
  INNER JOIN prpss AS b
    ON b~pspnr = a~posnr
    OR b~pspnr = a~up
    OR b~pspnr = a~left
    OR b~pspnr = a~down
    OR b~pspnr = a~right
 WHERE a~psphi = @lv_psphi.