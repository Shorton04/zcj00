      gv_capex                    TYPE flag.

CLEAR:gv_at_pm_approver_step,gv_at_co_approver_step,
      gv_at_r2r_acc_approver_step,gv_at_r2r_sr_approver_step.

swc_get_element container 'IvPmApprover'     gv_at_pm_approver_step.
swc_get_element container 'IvCAPEXApprover'     gv_at_capex_approver_step.
swc_get_element container 'IvCoApprover'     gv_at_co_approver_step.
swc_get_element container 'IvR2RAccApprover' gv_at_r2r_acc_approver_step.
swc_get_element container 'IvR2RSRApprover'  gv_at_r2r_sr_approver_step.
swc_get_element container 'ItPVPM_Admin_Appr' gt_pvpm_admin_approver_step.
swc_get_element container 'IV_CAPEX'          gv_capex .

IF  gv_at_capex_approver_step IS NOT INITIAL.
  EXPORT gv_at_capex_approver_step = gv_at_capex_approver_step
                                  TO MEMORY ID 'ZWBS_AT_CAPEX_APPROVER_STEP'.
ELSEIF gv_at_pm_approver_step IS NOT INITIAL.
  EXPORT gv_at_pm_approver_step = gv_at_pm_approver_step
                                  TO MEMORY ID 'ZWBS_AT_PM_APPROVER_STEP'.
ELSEIF gv_at_co_approver_step IS NOT INITIAL.
  EXPORT gv_at_co_approver_step = gv_at_co_approver_step
                                  TO MEMORY ID 'ZWBS_AT_CO_APPROVER_STEP'.
ELSEIF gv_at_r2r_acc_approver_step IS NOT INITIAL.
  EXPORT gv_at_r2r_acc_approver_step = gv_at_r2r_acc_approver_step
                                       TO MEMORY ID 'ZWBS_AT_R2R_ACC_APPROVER_STEP'.
ELSEIF gv_at_r2r_sr_approver_step IS NOT INITIAL.
  EXPORT gv_at_r2r_sr_approver_step = gv_at_r2r_sr_approver_step
                                      TO MEMORY ID 'ZWBS_AT_R2R_SR_APPROVER_STEP'.
ELSEIF gt_pvpm_admin_approver_step[] IS NOT INITIAL.
  EXPORT gt_pvpm_admin_approver_step = gt_pvpm_admin_approver_step
