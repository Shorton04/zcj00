FORM save_request.

  DATA: lv_reqnum TYPE ztb_a2r_wbshdr-zreq_num.

  "Bring screen values back into gs_header/gt_wbs_display
  PERFORM sync_screen_to_header.
  PERFORM convert_from_display.  "gt_wbs_display -> gt_wbs_items (must fill WERT2 etc.)

  "DO NOT call populate_header_structure in edit mode (can overwrite DB audit fields)
  IF gv_edit_mode <> abap_true.
    PERFORM populate_header_structure.
  ENDIF.

  "=========================
  "F1: EDIT SAVED REQUEST
  "=========================
  IF gv_edit_mode = abap_true.

    lv_reqnum = gs_header-zreq_num.
    IF lv_reqnum IS INITIAL.
      MESSAGE e398(zcj00) WITH 'Request number missing.'.
    ENDIF.

    PERFORM update_draft_request_db USING lv_reqnum.

    gv_request_number = lv_reqnum.
    MESSAGE s000(zmsg_a2r) WITH lv_reqnum.
    COMMIT WORK AND WAIT.
    EXIT.

  ENDIF.

  "=========================
  "A1: CREATE/SAVE REQUEST
  "=========================
  IF go_builder IS INITIAL.
    "if you normally create it elsewhere, keep this defensive guard
    CREATE OBJECT go_builder.  "adjust constructor if needed
  ENDIF.

  CALL METHOD go_builder->save_request
    EXPORTING
      is_header    = gs_header
      it_wbs_items = gt_wbs_items
    RECEIVING
      rv_reqnum    = lv_reqnum.

  IF lv_reqnum IS NOT INITIAL.
    gv_request_number = lv_reqnum.
    MESSAGE s000(zmsg_a2r) WITH lv_reqnum.
    COMMIT WORK AND WAIT.
  ELSE.
    MESSAGE e013.
  ENDIF.

ENDFORM.




FORM update_draft_request_db USING iv_reqnum TYPE ztb_a2r_wbshdr-zreq_num.

  DATA: ls_hdr_db TYPE ztb_a2r_wbshdr,
        ls_item   TYPE ztb_a2r_wbsitem,
        ls_wbs    TYPE ztb_a2r_wbsitem.

  "Lock header (optional but recommended)
  "ENQUEUE_EZTB_A2R_WBSHDR ... (if you have lock object)

  "Read existing header to keep audit fields (ernam/erdat)
  SELECT SINGLE *
    FROM ztb_a2r_wbshdr
    INTO @ls_hdr_db
    WHERE zreq_num = @iv_reqnum.

  IF sy-subrc <> 0.
    MESSAGE e398(zcj00) WITH 'Request not found for update.'.
  ENDIF.

  "Security: only creator
  IF ls_hdr_db-ernam <> sy-uname.
    MESSAGE e398(zcj00) WITH 'You are not allowed to edit this request.'.
  ENDIF.

  "Must still be draft
  IF ls_hdr_db-request_status <> 'DRAFT'.  "adjust if different
    MESSAGE e398(zcj00) WITH 'Request is not in DRAFT status.'.
  ENDIF.

  "Update ONLY editable fields, keep original ernam/erdat
  ls_hdr_db-profl        = gs_header-profl.
  ls_hdr_db-kostl        = gs_header-kostl.
  ls_hdr_db-post1        = gs_header-post1.
  ls_hdr_db-vernr        = gs_header-vernr.
  ls_hdr_db-plsez        = gs_header-plsez.
  ls_hdr_db-prctr        = gs_header-prctr.
  ls_hdr_db-z_remarks    = gs_header-z_remarks.
  ls_hdr_db-zunifier_proj = gs_header-zunifier_proj.

  "keep these from db or refresh from IM if you want:
  ls_hdr_db-posnr        = gs_header-posnr.
  ls_hdr_db-prnam        = gs_header-prnam.
  ls_hdr_db-bukrs        = gs_header-bukrs.
  ls_hdr_db-werks        = gs_header-werks.
  ls_hdr_db-izwek        = gs_header-izwek.
  ls_hdr_db-usr008       = gs_header-usr008.
  ls_hdr_db-z_reqtype    = gs_header-z_reqtype.

  UPDATE ztb_a2r_wbshdr FROM ls_hdr_db.
  IF sy-subrc <> 0.
    MESSAGE e398(zcj00) WITH 'Header update failed.'.
  ENDIF.

  "Replace items
  DELETE FROM ztb_a2r_wbsitem WHERE zreq_num = @iv_reqnum.

  LOOP AT gt_wbs_items INTO ls_wbs.
    CLEAR ls_item.
    ls_item-mandt         = sy-mandt.
    ls_item-zreq_num      = iv_reqnum.
    ls_item-bukrs         = ls_hdr_db-bukrs.
    ls_item-posid         = ls_wbs-posid.
    ls_item-stufe         = ls_wbs-stufe.
    ls_item-post1         = ls_wbs-post1.
    ls_item-kostl         = ls_wbs-kostl.
    ls_item-wert2         = ls_wbs-wert2.
    ls_item-zbudget_check = ls_wbs-zbudget_check.
    ls_item-imprf         = ls_wbs-imprf.
    ls_item-prart         = ls_wbs-prart.
    ls_item-gjahr         = ls_wbs-gjahr.
    ls_item-posnr         = ls_wbs-posnr.

    INSERT ztb_a2r_wbsitem FROM ls_item.
    IF sy-subrc <> 0.
      MESSAGE e398(zcj00) WITH 'Item save failed for' ls_item-posid.
    ENDIF.
  ENDLOOP.

ENDFORM.