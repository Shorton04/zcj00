  DATA: lv_reqnum  TYPE ztb_a2r_wbshdr-zreq_num,
        lv_success TYPE abap_bool.

  "STEP 1: Sync + convert
  PERFORM sync_screen_to_header.
  PERFORM convert_from_display.

  "Only A1: allow auto-defaults
  IF gv_edit_mode <> abap_true.
    PERFORM populate_header_structure.
  ENDIF.

  "Ensure builder exists ONLY if we will call it
  IF go_builder IS INITIAL.
    CREATE OBJECT go_builder. "adjust if constructor requires params
  ENDIF.

  "STEP 2: Save request / get request number
  IF gv_edit_mode = abap_true.

    "Edit mode: request number must already exist
    lv_reqnum = gs_header-zreq_num.
    IF lv_reqnum IS INITIAL.
      MESSAGE e000(zmsg_a2r) WITH 'Missing request number for submit'(m13).
      RETURN.
    ENDIF.

    "Update Z tables (no builder dependency)
    PERFORM update_draft_request_db USING lv_reqnum.

  ELSE.

    "Create mode: use your existing builder method
    lv_reqnum = go_builder->save_request_for_submit(
      is_header    = gs_header
      it_wbs_items = gt_wbs_items
    ).

    IF lv_reqnum IS INITIAL.
      MESSAGE e000(zmsg_a2r) WITH 'Failed to save request before submit'(m13).
      RETURN.
    ENDIF.

    gs_header-zreq_num = lv_reqnum.

  ENDIF.

  "STEP 3: Set PENDING
  UPDATE ztb_a2r_wbshdr
    SET request_status = 'PENDING'
    WHERE zreq_num = @lv_reqnum.

  IF sy-subrc <> 0.
    MESSAGE e000(zmsg_a2r) WITH 'Failed to update status for'(m03) lv_reqnum.
    RETURN.
  ENDIF.

  COMMIT WORK AND WAIT.
  gs_header-request_status = 'PENDING'.

  "STEP 4: Create project (keep your logic)
  MESSAGE i000(zmsg_a2r) WITH 'Creating project for request'(m04) lv_reqnum ##NO_TEXT.


  "==========================================================
  " BRANCH B: others -> direct create wbs/project (your logic)
  "==========================================================

    lv_success = go_builder->create_wbs_elements(
      is_header    = gs_header
      it_wbs_items = gt_wbs_car
    ).


  IF lv_success = abap_true.

    UPDATE ztb_a2r_wbshdr
      SET request_status       = 'APPROVED',
          zapproved_by         = @sy-uname,
          zrequest_approved_on = @sy-datum
      WHERE zreq_num = @lv_reqnum.

    IF sy-subrc = 0.
      COMMIT WORK AND WAIT.

      SELECT SINGLE pspnr
        FROM ztb_a2r_wbshdr
        INTO @DATA(lv_pspnr)
        WHERE zreq_num = @lv_reqnum.

      IF sy-subrc = 0 AND lv_pspnr IS NOT INITIAL.
        SELECT SINGLE pspid
          FROM proj
          INTO @DATA(lv_pspid)
          WHERE pspnr = @lv_pspnr.

        IF sy-subrc = 0.
          MESSAGE s000(zmsg_a2r) WITH lv_reqnum lv_pspid.
        ELSE.
          MESSAGE s000(zmsg_a2r) WITH 'Request'(m20) lv_reqnum 'approved'(m21).
        ENDIF.
      ELSE.
        MESSAGE s000(zmsg_a2r) WITH 'Request'(m20) lv_reqnum 'approved'(m21).
      ENDIF.

      LEAVE TO SCREEN 0.

    ELSE.
      MESSAGE e000(zmsg_a2r) WITH 'Failed to update approval status'(m22).
    ENDIF.

  ELSE.
    PERFORM mark_request_error USING lv_reqnum.
    RETURN.
  ENDIF.
