FORM get_im_available_budget_s2
  CHANGING cv_im_budget TYPE bpge-wlges
           cv_im_waers  TYPE imtp-waers.

  TYPES: BEGIN OF ty_bpge_sum,
           wlges TYPE bpge-wlges,
           wlgev TYPE bpge-wlgev,
         END OF ty_bpge_sum.

  DATA: lv_objnr      TYPE j_objnr,
        lv_prnam      TYPE impr-prnam,
        lv_gjahr      TYPE impr-gjahr,
        lt_bpge       TYPE STANDARD TABLE OF ty_bpge_sum,
        lv_sum_wlges  TYPE bpge-wlges,
        lv_sum_wlgev  TYPE bpge-wlgev.

  FIELD-SYMBOLS: <fs_bpge> TYPE ty_bpge_sum.

  CLEAR: cv_im_budget,
         cv_im_waers,
         lv_objnr,
         lv_prnam,
         lv_gjahr,
         lv_sum_wlges,
         lv_sum_wlgev.

  SELECT SINGLE objnr
                prnam
                gjahr
    INTO (@lv_objnr, @lv_prnam, @lv_gjahr)
    FROM impr
    WHERE posnr = @gs_header-posnr.

  IF sy-subrc <> 0 OR lv_objnr IS INITIAL.
    RETURN.
  ENDIF.

  SELECT SINGLE waers
    INTO @cv_im_waers
    FROM imtp
    WHERE prnam = @lv_prnam
      AND gjahr = @lv_gjahr.

  IF sy-subrc <> 0 OR cv_im_waers IS INITIAL.
    RETURN.
  ENDIF.

  SELECT wlges,
         wlgev
    INTO TABLE @lt_bpge
    FROM bpge
    WHERE objnr = @lv_objnr
      AND vorga = 'KBUD'
      AND twaer = @cv_im_waers.

  IF lt_bpge IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT lt_bpge ASSIGNING <fs_bpge>.
    lv_sum_wlges = lv_sum_wlges + <fs_bpge>-wlges.
    lv_sum_wlgev = lv_sum_wlgev + <fs_bpge>-wlgev.
  ENDLOOP.

  cv_im_budget = lv_sum_wlges - lv_sum_wlgev.

ENDFORM.