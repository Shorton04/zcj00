"------------------------------------------------------------
" Build 2 variants of BDCDATA:
"   A) With popup 0300 (new session behavior)
"   B) Without popup 0300 (already-open behavior)
" Then try A first, if error -> try B
"------------------------------------------------------------
DATA: lt_bdcdata_with_popup TYPE TABLE OF bdcdata,
      lt_bdcdata_no_popup   TYPE TABLE OF bdcdata,
      lt_bdcmsg_try         TYPE TABLE OF bdcmsgcoll,
      lv_has_error          TYPE abap_bool.

"============================================================
" Variant A: WITH popup 0300 (your current recording)
"============================================================
CLEAR lt_bdcdata_with_popup.

bdc_dynpro( EXPORTING iv_program = 'SAPLKAZB'  iv_dynpro = '1000'
           CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).

bdc_field( EXPORTING iv_fnam = 'BDC_OKCODE' iv_fval = '/EOKKS'
          CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).

bdc_dynpro( EXPORTING iv_program = 'SAPLSPO4' iv_dynpro = '0300'
           CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).

bdc_field( EXPORTING iv_fnam = 'BDC_OKCODE' iv_fval = '=FURT'
          CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).

bdc_field( EXPORTING iv_fnam = 'SVALD-VALUE(01)' iv_fval = CONV #( lv_vkokr_char )
          CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).

bdc_dynpro( EXPORTING iv_program = 'SAPLKAZB'  iv_dynpro = '1000'
           CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).

bdc_field( EXPORTING iv_fnam = 'BDC_OKCODE' iv_fval = '=RUN'
          CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).

bdc_field( EXPORTING iv_fnam = 'BDC_CURSOR' iv_fval = 'RKAUF-LIST'
          CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).

bdc_field( EXPORTING iv_fnam = 'RKAUF-TEST' iv_fval = ''
          CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).

bdc_field( EXPORTING iv_fnam = 'BDC_SUBSCR'
                    iv_fval = 'SAPLKAOP                                0570BLOCK1'
          CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).

bdc_field( EXPORTING iv_fnam = 'LKP74-PSPID' iv_fval = CONV #( lv_pspid_char )
          CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).

bdc_field( EXPORTING iv_fnam = 'BDC_SUBSCR'
                    iv_fval = 'SAPLKAZB                                2100BLOCK2'
          CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).

bdc_field( EXPORTING iv_fnam = 'RKAUF-FROM'  iv_fval = CONV #( lv_period_char )
          CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).

bdc_field( EXPORTING iv_fnam = 'RKAUF-GJAHR' iv_fval = CONV #( lv_gjahr_char )
          CHANGING  ct_bdcdata = lt_bdcdata_with_popup ).


"============================================================
" Variant B: NO popup 0300 (when screen 1000 comes first)
"============================================================
CLEAR lt_bdcdata_no_popup.

bdc_dynpro( EXPORTING iv_program = 'SAPLKAZB'  iv_dynpro = '1000'
           CHANGING  ct_bdcdata = lt_bdcdata_no_popup ).

" NOTE: still keep /EOKKS if it is needed to reach controlling area logic;
" but if /EOKKS is what triggers the popup, it's OK—if popup doesn't show,
" system remains on 1000 and BDC continues fine.
bdc_field( EXPORTING iv_fnam = 'BDC_OKCODE' iv_fval = '/EOKKS'
          CHANGING  ct_bdcdata = lt_bdcdata_no_popup ).

bdc_dynpro( EXPORTING iv_program = 'SAPLKAZB'  iv_dynpro = '1000'
           CHANGING  ct_bdcdata = lt_bdcdata_no_popup ).

bdc_field( EXPORTING iv_fnam = 'BDC_OKCODE' iv_fval = '=RUN'
          CHANGING  ct_bdcdata = lt_bdcdata_no_popup ).

bdc_field( EXPORTING iv_fnam = 'BDC_CURSOR' iv_fval = 'RKAUF-LIST'
          CHANGING  ct_bdcdata = lt_bdcdata_no_popup ).

bdc_field( EXPORTING iv_fnam = 'RKAUF-TEST' iv_fval = ''
          CHANGING  ct_bdcdata = lt_bdcdata_no_popup ).

bdc_field( EXPORTING iv_fnam = 'BDC_SUBSCR'
                    iv_fval = 'SAPLKAOP                                0570BLOCK1'
          CHANGING  ct_bdcdata = lt_bdcdata_no_popup ).

bdc_field( EXPORTING iv_fnam = 'LKP74-PSPID' iv_fval = CONV #( lv_pspid_char )
          CHANGING  ct_bdcdata = lt_bdcdata_no_popup ).

bdc_field( EXPORTING iv_fnam = 'BDC_SUBSCR'
                    iv_fval = 'SAPLKAZB                                2100BLOCK2'
          CHANGING  ct_bdcdata = lt_bdcdata_no_popup ).

bdc_field( EXPORTING iv_fnam = 'RKAUF-FROM'  iv_fval = CONV #( lv_period_char )
          CHANGING  ct_bdcdata = lt_bdcdata_no_popup ).

bdc_field( EXPORTING iv_fnam = 'RKAUF-GJAHR' iv_fval = CONV #( lv_gjahr_char )
          CHANGING  ct_bdcdata = lt_bdcdata_no_popup ).


"============================================================
" Execute: try WITH popup first, then fallback to NO popup
"============================================================
CLEAR lt_bdcmsg_try.
CALL TRANSACTION 'CJB2'
  USING lt_bdcdata_with_popup
  MODE lv_mode
  UPDATE lv_update
  MESSAGES INTO lt_bdcmsg_try.

lv_has_error = abap_false.
LOOP AT lt_bdcmsg_try INTO ls_bdcmsg WHERE msgtyp = 'E' OR msgtyp = 'A'.
  lv_has_error = abap_true.
  EXIT.
ENDLOOP.

IF lv_has_error = abap_true.
  " Fallback attempt
  CLEAR lt_bdcmsg_try.
  CALL TRANSACTION 'CJB2'
    USING lt_bdcdata_no_popup
    MODE lv_mode
    UPDATE lv_update
    MESSAGES INTO lt_bdcmsg_try.
ENDIF.

" Finally: show messages from the attempt that actually ran last
LOOP AT lt_bdcmsg_try INTO ls_bdcmsg WHERE msgtyp = 'E' OR msgtyp = 'A'.
  MESSAGE ID ls_bdcmsg-msgid TYPE 'I' NUMBER ls_bdcmsg-msgnr
    WITH ls_bdcmsg-msgv1 ls_bdcmsg-msgv2 ls_bdcmsg-msgv3 ls_bdcmsg-msgv4
    DISPLAY LIKE 'E'.
ENDLOOP.

LOOP AT lt_bdcmsg_try INTO ls_bdcmsg WHERE msgtyp = 'S'.
  MESSAGE ID ls_bdcmsg-msgid TYPE 'I' NUMBER ls_bdcmsg-msgnr
    WITH ls_bdcmsg-msgv1 ls_bdcmsg-msgv2 ls_bdcmsg-msgv3 ls_bdcmsg-msgv4
    DISPLAY LIKE 'S'.
ENDLOOP.