    "--------------------------------------------------------------------
    " Latest TECO <> Actual End  (renamed from teco_actual_end)
    "--------------------------------------------------------------------
    CLEAR ls_result-latest_teco_act_end.
    IF ls_aufk-idat2    IS NOT INITIAL
      AND ls_afko-getri IS NOT INITIAL.
      ls_result-latest_teco_act_end =
          ls_aufk-idat2 - ls_afko-getri.
    ENDIF.

    "--------------------------------------------------------------------
    " Latest TECO By / Earliest TECO Date / Earliest TECO By
    "--------------------------------------------------------------------
    CLEAR lt_jcds_tmp.
    LOOP AT lt_jcds_teco INTO ls_jcds
      WHERE objnr = ls_aufk-objnr.
      APPEND ls_jcds TO lt_jcds_tmp.
    ENDLOOP.

    IF lt_jcds_tmp IS NOT INITIAL.

      "--- Latest TECO By (renamed from usnam) ---
      SORT lt_jcds_tmp BY udate DESCENDING
                          utime DESCENDING.
      READ TABLE lt_jcds_tmp INTO ls_jcds INDEX 1.
      IF sy-subrc = 0.
        ls_result-latest_teco_by = ls_jcds-usnam.
      ENDIF.

      "--- Earliest TECO Date and By ---
      SORT lt_jcds_tmp BY udate ASCENDING
                          utime ASCENDING.
      READ TABLE lt_jcds_tmp INTO ls_jcds INDEX 1.
      IF sy-subrc = 0.
        ls_result-earliest_teco_date = ls_jcds-udate.
        ls_result-earliest_teco_by   = ls_jcds-usnam.
      ENDIF.

      "--- Earliest TECO <> Actual End ---
      CLEAR ls_result-earliest_teco_act_end.
      IF ls_result-earliest_teco_date IS NOT INITIAL
        AND ls_afko-getri             IS NOT INITIAL.
        ls_result-earliest_teco_act_end =
            ls_result-earliest_teco_date - ls_afko-getri.
      ENDIF.

    ENDIF.




