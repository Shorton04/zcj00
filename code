FORM get_budgetchk.

  DATA: lt_wbs_db TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
        lt_wbs_map TYPE HASHED TABLE OF ztb_a2r_wbsitem
                     WITH UNIQUE KEY posid.

  "-------------------------------------------------------
  " Validate input
  "-------------------------------------------------------
  IF gv_pspnr IS INITIAL.
    RETURN. " no project -> nothing to fetch
  ENDIF.

  "-------------------------------------------------------
  " Get all WBS items for the project
  "-------------------------------------------------------
  SELECT posid,
         zbudget_check
    FROM ztb_a2r_wbsitem
    INTO TABLE @lt_wbs_db
    WHERE pspnr = @gv_pspnr.

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  "-------------------------------------------------------
  " Convert to hashed table for fast lookup
  "-------------------------------------------------------
  lt_wbs_map = lt_wbs_db.

  "-------------------------------------------------------
  " Update gt_wbs_items
  "-------------------------------------------------------
  LOOP AT gt_wbs_items ASSIGNING FIELD-SYMBOL(<fs_wbs>).

    READ TABLE lt_wbs_map ASSIGNING FIELD-SYMBOL(<fs_db>)
      WITH TABLE KEY posid = <fs_wbs>-posid.

    IF sy-subrc = 0.
      <fs_wbs>-zbudget_check = <fs_db>-zbudget_check.
    ENDIF.

  ENDLOOP.

ENDFORM.