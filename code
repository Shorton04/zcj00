CLASS zcl_a2r_wbs_workflow_log DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.

    METHODS save_rejection_comments
      IMPORTING iv_zreq_num  TYPE zta2r_wbshdr-zreq_num
      RETURNING VALUE(rv_success) TYPE abap_bool.

  PRIVATE SECTION.

    TYPES:
      BEGIN OF ty_wflog,
        wi_id      TYPE sww_wiid,
        top_wi_id  TYPE sww_wiid,
        wi_text    TYPE swr_wihdr-wi_text,
        agent      TYPE string,
        status     TYPE string,
        created_on TYPE sww_cd,
        created_at TYPE sww_ct,
        comment    TYPE string,
      END OF ty_wflog,
      ty_t_wflog TYPE STANDARD TABLE OF ty_wflog WITH DEFAULT KEY.

    METHODS get_top_wi_id
      IMPORTING iv_zreq_num     TYPE zta2r_wbshdr-zreq_num
      RETURNING VALUE(rv_wi_id) TYPE sww_wiid.

    METHODS get_workflow_log
      IMPORTING iv_top_wi_id  TYPE sww_wiid
      RETURNING VALUE(rt_log) TYPE ty_t_wflog.

    METHODS read_single_wi_log
      IMPORTING iv_wi_id          TYPE sww_wiid
                iv_top_wi_id      TYPE sww_wiid
      RETURNING VALUE(rs_wflog)   TYPE ty_wflog.

    METHODS get_wi_comment
      IMPORTING iv_wi_id            TYPE sww_wiid
      RETURNING VALUE(rv_comment)   TYPE string.

ENDCLASS.


CLASS zcl_a2r_wbs_workflow_log IMPLEMENTATION.

  METHOD save_rejection_comments.

    DATA: lt_wflog     TYPE ty_t_wflog,
          lv_top_wi_id TYPE sww_wiid,
          lv_reason1   TYPE zde_rej_reason,
          lv_reason2   TYPE zde_rej_reason,
          lv_count     TYPE i.

    rv_success = abap_false.

    lv_top_wi_id = get_top_wi_id( iv_zreq_num ).
    IF lv_top_wi_id IS INITIAL.
      RETURN.
    ENDIF.

    lt_wflog = get_workflow_log( lv_top_wi_id ).
    IF lt_wflog IS INITIAL.
      RETURN.
    ENDIF.

    lv_count = 0.

    LOOP AT lt_wflog ASSIGNING FIELD-SYMBOL(<ls_log>)
      WHERE comment IS NOT INITIAL.

      lv_count = lv_count + 1.

      CASE lv_count.
        WHEN 1.
          lv_reason1 = <ls_log>-comment(255).
        WHEN 2.
          lv_reason2 = <ls_log>-comment(255).
        WHEN OTHERS.
          EXIT.
      ENDCASE.

    ENDLOOP.

    IF lv_count = 0.
      RETURN.
    ENDIF.

    UPDATE zta2r_wbshdr
      SET rej_reason1 = lv_reason1,
          rej_reason2 = lv_reason2
      WHERE zreq_num = iv_zreq_num.

    IF sy-subrc = 0.
      rv_success = abap_true.
    ENDIF.

  ENDMETHOD.


  METHOD get_top_wi_id.

    CLEAR rv_wi_id.

    SELECT SINGLE top_wi_id
      FROM sww_wi2obj
      INTO @rv_wi_id
      WHERE instid = @iv_zreq_num
        AND typeid = 'ZCL_A2R_WBS_REQUEST_FLEXWF'
        AND catid  = 'CL'.

  ENDMETHOD.


  METHOD get_workflow_log.

    DATA: lt_worklist      TYPE STANDARD TABLE OF swr_wihdr,
          ls_worklist      TYPE swr_wihdr,
          lt_message_lines TYPE STANDARD TABLE OF swr_messag,
          lt_message_struc TYPE STANDARD TABLE OF swr_mstruc,
          lv_return_code   TYPE sy-subrc,
          ls_wflog         TYPE ty_wflog.

    CLEAR rt_log.

    ls_wflog = read_single_wi_log(
                 iv_wi_id     = iv_top_wi_id
                 iv_top_wi_id = iv_top_wi_id ).

    IF ls_wflog-wi_id IS NOT INITIAL.
      APPEND ls_wflog TO rt_log.
    ENDIF.

    CALL FUNCTION 'SAP_WAPI_GET_CHILD_WORKITEMS'
      EXPORTING
        workitem_id    = iv_top_wi_id
        user           = sy-uname
        text           = abap_true
        language       = sy-langu
      IMPORTING
        return_code    = lv_return_code
      TABLES
        worklist       = lt_worklist
        message_lines  = lt_message_lines
        message_struct = lt_message_struc.

    LOOP AT lt_worklist INTO ls_worklist.

      CLEAR ls_wflog.

      ls_wflog = read_single_wi_log(
                   iv_wi_id     = ls_worklist-wi_id
                   iv_top_wi_id = iv_top_wi_id ).

      IF ls_wflog-wi_id IS NOT INITIAL.
        APPEND ls_wflog TO rt_log.
      ENDIF.

    ENDLOOP.

    SORT rt_log BY wi_id.
    DELETE ADJACENT DUPLICATES FROM rt_log COMPARING wi_id.
    SORT rt_log BY created_on created_at wi_id.

  ENDMETHOD.


  METHOD read_single_wi_log.

    DATA: ls_header        TYPE swr_wihdr,
          lt_message_lines TYPE STANDARD TABLE OF swr_messag,
          lt_message_struc TYPE STANDARD TABLE OF swr_mstruc,
          lv_return_code   TYPE sy-subrc.

    CLEAR rs_wflog.

    CALL FUNCTION 'SAP_WAPI_GET_HEADER'
      EXPORTING
        workitem_id         = iv_wi_id
        user                = sy-uname
        language            = sy-langu
        translate_texts     = abap_true
      IMPORTING
        workitem_attributes = ls_header
        return_code         = lv_return_code
      TABLES
        message_lines       = lt_message_lines
        message_struct      = lt_message_struc.

    IF lv_return_code <> 0.
      RETURN.
    ENDIF.

    rs_wflog-wi_id      = ls_header-wi_id.
    rs_wflog-top_wi_id  = iv_top_wi_id.
    rs_wflog-wi_text    = ls_header-wi_text.
    rs_wflog-created_on = ls_header-wi_cd.
    rs_wflog-created_at = ls_header-wi_ct.

    IF ls_header-wi_aa_name IS NOT INITIAL.
      rs_wflog-agent = ls_header-wi_aa_name.
    ELSEIF ls_header-wi_aagent IS NOT INITIAL.
      rs_wflog-agent = ls_header-wi_aagent.
    ENDIF.

    IF ls_header-statustext IS NOT INITIAL.
      rs_wflog-status = ls_header-statustext.
    ELSE.
      rs_wflog-status = ls_header-wi_stat.
    ENDIF.

    IF rs_wflog-wi_text    CP 'WBS Approval*'
   AND rs_wflog-agent      IS NOT INITIAL
   AND rs_wflog-agent      NS 'IF On-prem'
   AND rs_wflog-agent      NS 'Workflow'
   AND rs_wflog-agent      NS 'RFC'
   AND rs_wflog-agent      NS 'S/4HANA'.

      rs_wflog-comment = get_wi_comment( iv_wi_id ).

    ENDIF.

  ENDMETHOD.


  METHOD get_wi_comment.

    DATA: lt_attachments   TYPE STANDARD TABLE OF swr_object,
          ls_attachment    TYPE swr_object,
          lt_message_lines TYPE STANDARD TABLE OF swr_messag,
          lt_message_struc TYPE STANDARD TABLE OF swr_mstruc,
          lv_return_code   TYPE sy-subrc.

    DATA: lt_objcont TYPE STANDARD TABLE OF soli,
          ls_objcont TYPE soli,
          lt_objhead TYPE STANDARD TABLE OF soli,
          lv_text    TYPE string,
          lv_doc_id  TYPE sofolenti1-doc_id.

    DATA: lt_parts TYPE STANDARD TABLE OF string,
          lv_part  TYPE string.

    DATA: ls_filter TYPE sofilteri1.

    CLEAR rv_comment.

    CALL FUNCTION 'SAP_WAPI_GET_ATTACHMENTS'
      EXPORTING
        workitem_id           = iv_wi_id
        user                  = sy-uname
        language              = sy-langu
        comment_semantic_only = 'X'
      IMPORTING
        return_code           = lv_return_code
      TABLES
        attachments           = lt_attachments
        message_lines         = lt_message_lines
        message_struct        = lt_message_struc.

    IF lv_return_code <> 0 OR lt_attachments IS INITIAL.
      RETURN.
    ENDIF.

    LOOP AT lt_attachments INTO ls_attachment
      WHERE def_attrib = 'Approver Comments'
         OR object_typ = 'CM'.

      CLEAR: lt_parts, lv_part, lv_doc_id,
             lt_objhead, lt_objcont, lv_text.

      SPLIT ls_attachment-object_id AT space INTO TABLE lt_parts.
      DELETE lt_parts WHERE table_line IS INITIAL.

      READ TABLE lt_parts INTO lv_part INDEX 2.
      IF sy-subrc <> 0 OR lv_part IS INITIAL.
        CONTINUE.
      ENDIF.

      lv_doc_id = lv_part.

      ls_filter-send_info  = space.
      ls_filter-no_content = space.
      ls_filter-rec_list   = space.

      CALL FUNCTION 'SO_DOCUMENT_READ_API1'
        EXPORTING
          document_id                = lv_doc_id
          filter                     = ls_filter
        TABLES
          object_header              = lt_objhead
          object_content             = lt_objcont
        EXCEPTIONS
          document_id_not_exist      = 1
          operation_no_authorization = 2
          x_error                    = 3
          OTHERS                     = 4.

      IF sy-subrc <> 0 OR lt_objcont IS INITIAL.
        CONTINUE.
      ENDIF.

      LOOP AT lt_objcont INTO ls_objcont
        WHERE line IS NOT INITIAL.

        IF lv_text IS INITIAL.
          lv_text = ls_objcont-line.
        ELSE.
          lv_text = lv_text
                 && cl_abap_char_utilities=>newline
                 && ls_objcont-line.
        ENDIF.

      ENDLOOP.

      IF lv_text IS NOT INITIAL.
        rv_comment = lv_text.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.

ENDCLASS.
