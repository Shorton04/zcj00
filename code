METHOD create_car_wbs_b1.

  TYPES: BEGIN OF ty_prps_map,
           pspnr TYPE prps-pspnr,
           posid TYPE prps-posid,
         END OF ty_prps_map.

  DATA: lt_wbs_all      TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
        ls_wbs_car      TYPE ztb_a2r_wbsitem,
        ls_wbs_scan     TYPE ztb_a2r_wbsitem,
        ls_esr_root     TYPE ztb_a2r_wbsitem,
        ls_wbs_celement TYPE bapi_bus2054_new,
        lt_wbs_celement TYPE STANDARD TABLE OF bapi_bus2054_new,
        lt_return       TYPE STANDARD TABLE OF bapiret2,
        ls_return       TYPE bapiret2,
        lt_prps_map     TYPE HASHED TABLE OF ty_prps_map WITH UNIQUE KEY pspnr,
        lt_prps_sel     TYPE STANDARD TABLE OF ty_prps_map,
        lt_pspnr_key    TYPE SORTED TABLE OF prps-pspnr WITH UNIQUE KEY table_line,
        ls_prps_map     TYPE ty_prps_map,
        lv_project_def  TYPE proj-pspid,
        lv_new_posid    TYPE ps_posid,
        lv_up_posid     TYPE ps_posid,
        lv_idx          TYPE sy-tabix,
        lv_idx_back     TYPE sy-tabix.

  FIELD-SYMBOLS: <lv_pspnr> TYPE prps-pspnr.

  CLEAR: ev_error, et_return.
  CLEAR: lt_wbs_celement, lt_return.

  IF it_wbs_car IS INITIAL.
    RETURN.
  ENDIF.

  lt_wbs_all = it_wbs_all.

  "------------------------------------------------------------
  " Build PRPS map for existing ESR rows
  "------------------------------------------------------------
  LOOP AT lt_wbs_all INTO DATA(ls_all) WHERE posnr IS NOT INITIAL.
    INSERT ls_all-posnr INTO TABLE lt_pspnr_key.
  ENDLOOP.

  IF lt_pspnr_key IS NOT INITIAL.
    SELECT pspnr, posid
      FROM prps
      INTO TABLE @lt_prps_sel
      FOR ALL ENTRIES IN @lt_pspnr_key
      WHERE pspnr = @lt_pspnr_key-table_line.

    IF sy-subrc = 0.
      lt_prps_map = lt_prps_sel.
    ENDIF.
  ENDIF.

  "------------------------------------------------------------
  " ESR level 1 root
  "------------------------------------------------------------
  READ TABLE lt_wbs_all INTO ls_esr_root WITH KEY stufe = 1.
  IF sy-subrc <> 0.
    ev_error = abap_true.
    RETURN.
  ENDIF.

  "Use existing ESR external POSID from PRPS
  IF ls_esr_root-posnr IS NOT INITIAL.
    READ TABLE lt_prps_map INTO ls_prps_map WITH KEY pspnr = ls_esr_root-posnr.
    IF sy-subrc = 0.
      lv_project_def = ls_prps_map-posid.
    ENDIF.
  ENDIF.

  IF lv_project_def IS INITIAL.
    lv_project_def = ls_esr_root-posid.
  ENDIF.

  IF lv_project_def IS INITIAL.
    ev_error = abap_true.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " Create only CAR rows
  "------------------------------------------------------------
  LOOP AT it_wbs_car INTO ls_wbs_car.

    CLEAR: ls_wbs_celement,
           lv_new_posid,
           lv_up_posid.

    lv_new_posid = ls_wbs_car-posid.
    IF lv_new_posid IS INITIAL.
      CONTINUE.
    ENDIF.

    "Find current CAR row position in full hierarchy
    READ TABLE lt_wbs_all TRANSPORTING NO FIELDS
      WITH KEY posid = ls_wbs_car-posid.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    lv_idx = sy-tabix.

    "----------------------------------------------------------
    " WBS_UP only
    " nearest previous row with lower STUFE
    " - if CAR level 2 => finds ESR level 1
    " - if CAR level 3 => finds CAR level 2
    "----------------------------------------------------------
    lv_idx_back = lv_idx - 1.
    WHILE lv_idx_back >= 1.

      READ TABLE lt_wbs_all INDEX lv_idx_back INTO ls_wbs_scan.
      IF sy-subrc = 0 AND ls_wbs_scan-stufe < ls_wbs_car-stufe.

        CLEAR lv_up_posid.

        "Existing ESR row: get external POSID from PRPS using PSPNR
        IF ls_wbs_scan-posnr IS NOT INITIAL.
          READ TABLE lt_prps_map INTO ls_prps_map
            WITH KEY pspnr = ls_wbs_scan-posnr.
          IF sy-subrc = 0.
            lv_up_posid = ls_prps_map-posid.
          ENDIF.
        ENDIF.

        "CAR row already has the future POSID built in gt_wbs_car/gt_wbs_items
        IF lv_up_posid IS INITIAL.
          lv_up_posid = ls_wbs_scan-posid.
        ENDIF.

        EXIT.
      ENDIF.

      lv_idx_back = lv_idx_back - 1.
    ENDWHILE.

    "----------------------------------------------------------
    " Mandatory fields
    "----------------------------------------------------------
    ls_wbs_celement-wbs_element = lv_new_posid.

    ls_wbs_celement-description      = ls_wbs_car-post1.
    ls_wbs_celement-company_code     = is_header-bukrs.
    ls_wbs_celement-profit_ctr       = is_header-prctr.
    ls_wbs_celement-controlling_area = is_header-vkokr.
    ls_wbs_celement-plant            = is_header-werks.

    ls_wbs_celement-wbs_planning_element = abap_true.
    ls_wbs_celement-inv_reason           = is_header-izwek.
    ls_wbs_celement-respsbl_cctr         = ls_wbs_car-kostl.
    ls_wbs_celement-responsible_no       = is_header-vernr.

    ls_wbs_celement-wbs_basic_start_date     = is_header-plfaz.
    ls_wbs_celement-wbs_basic_finish_date    = is_header-plsez.
    ls_wbs_celement-wbs_forecast_start_date  = is_header-plfaz.
    ls_wbs_celement-wbs_forecast_finish_date = is_header-plsez.

    ls_wbs_celement-wbs_account_assignment_element = abap_true.

    "Only UP, no LEFT
    ls_wbs_celement-wbs_up = lv_up_posid.
    CLEAR ls_wbs_celement-wbs_left.

    APPEND ls_wbs_celement TO lt_wbs_celement.

  ENDLOOP.

  IF lt_wbs_celement IS INITIAL.
    ev_error = abap_true.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " BAPI create
  "------------------------------------------------------------
  CALL FUNCTION 'BAPI_BUS2054_CREATE_MULTI'
    EXPORTING
      i_project_definition = lv_project_def
    TABLES
      it_wbs_element       = lt_wbs_celement
      et_return            = lt_return.

  LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'EA'.
    ev_error = abap_true.
    EXIT.
  ENDLOOP.

  IF ev_error = abap_true.
    et_return = lt_return.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " PRECOMMIT
  "------------------------------------------------------------
  CALL FUNCTION 'BAPI_PS_PRECOMMIT'
    TABLES
      et_return = lt_return.

  LOOP AT lt_return TRANSPORTING NO FIELDS WHERE type CA 'EA'.
    ev_error = abap_true.
    EXIT.
  ENDLOOP.

  IF ev_error = abap_true.
    et_return = lt_return.
    RETURN.
  ENDIF.

  "------------------------------------------------------------
  " COMMIT
  "------------------------------------------------------------
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait   = 'X'
    IMPORTING
      return = ls_return.

  IF ls_return-type CA 'EA'.
    ev_error = abap_true.
    APPEND ls_return TO lt_return.
  ENDIF.

  et_return = lt_return.

  WAIT UP TO 1 SECONDS.

ENDMETHOD.