  "═══════════════════════════════════════════════════════════════════
  " STEP 10: CREATE SETTLEMENT RULES
  "═══════════════════════════════════════════════════════════════════
  DATA: lt_bdcdata TYPE TABLE OF bdcdata,
        lt_bdcmsg  TYPE TABLE OF bdcmsgcoll,
        ls_bdcmsg  TYPE bdcmsgcoll,
        lv_posid_external TYPE ps_posid,
        lv_posid_char TYPE char132,
        lv_parent_posid_external TYPE ps_posid,
        lv_parent_posid_char TYPE char132,
        lv_sender_objnr   TYPE j_objnr,
        lv_receiver_objnr TYPE j_objnr,
        lv_parent_pspnr   TYPE ps_pspnr,
        lv_mode    TYPE c VALUE 'N',
        lv_update  TYPE c VALUE 'S'.

  " Loop through created WBS elements to create settlement rules
  LOOP AT et_wbs_created INTO ls_wbs_created.

    " Skip Level 1 and items without budget
    IF ls_wbs_created-stufe = 1 OR ls_wbs_created-wert2 IS INITIAL.
      CONTINUE.
    ENDIF.

    " Get sender WBS details
    SELECT SINGLE p~objnr, p~psphi
      FROM prps AS p
      INTO (@lv_sender_objnr, @lv_parent_pspnr)
      WHERE p~posid = @ls_wbs_created-posid.

    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    " Get parent (receiver) WBS
    SELECT SINGLE objnr, posid
      FROM prps
      INTO (@lv_receiver_objnr, @lv_parent_posid_external)
      WHERE pspnr = @lv_parent_pspnr.

    IF sy-subrc <> 0 OR lv_receiver_objnr IS INITIAL.
      CONTINUE.
    ENDIF.

    " Convert to external format
    lv_posid_external = ls_wbs_created-posid.

    CALL FUNCTION 'CONVERSION_EXIT_ABPSP_OUTPUT'
      EXPORTING
        input  = lv_posid_external
      IMPORTING
        output = lv_posid_external.

    CALL FUNCTION 'CONVERSION_EXIT_ABPSP_OUTPUT'
      EXPORTING
        input  = lv_parent_posid_external
      IMPORTING
        output = lv_parent_posid_external.

    " Convert to CHAR132
    lv_posid_char = lv_posid_external.
    lv_parent_posid_char = lv_parent_posid_external.

    CLEAR lt_bdcdata.

    " BDC Screen 1: SAPLKAZB 1000
    bdc_dynpro(
      EXPORTING
        iv_program = 'SAPLKAZB'
        iv_dynpro  = '1000'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'BDC_CURSOR'
        iv_fval = 'RKAUF-TEST'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'BDC_OKCODE'
        iv_fval = 'RUN'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'RKAUF-TEST'
        iv_fval = lv_posid_char
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    " BDC Screen 2: SAPLKAOP 0570
    bdc_dynpro(
      EXPORTING
        iv_program = 'SAPLKAOP'
        iv_dynpro  = '0570'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'BDC_CURSOR'
        iv_fval = 'LKP74-PSPID'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'LKP74-PSPID'
        iv_fval = lv_parent_posid_char
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    bdc_field(
      EXPORTING
        iv_fnam = 'BDC_OKCODE'
        iv_fval = '=SICH'
      CHANGING
        ct_bdcdata = lt_bdcdata
    ).

    " Execute BDC
    CLEAR lt_bdcmsg.

    CALL TRANSACTION 'CJB2'
      USING lt_bdcdata
      MODE lv_mode
      UPDATE lv_update
      MESSAGES INTO lt_bdcmsg.

  ENDLOOP.

  COMMIT WORK.
  MESSAGE s025(zcj00) WITH 'Project' lv_pspid 'created successfully'.

  rv_success = abap_true.

ENDMETHOD.
