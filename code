*&---------------------------------------------------------------------*
*& Form VALIDATE_APPROVER_MATRIX
*&---------------------------------------------------------------------*
FORM validate_approver_matrix
  CHANGING cv_error TYPE abap_bool.

  DATA: ls_conf TYPE ztb_a2r_conftab2.

  CLEAR cv_error.

  SELECT SINGLE *
    INTO @ls_conf
    FROM ztb_a2r_conftab2
   WHERE bukrs     = @gs_header-bukrs
     AND profl     = @gs_header-profl
     AND z_reqtype = @gs_header-z_reqtype.

  IF sy-subrc <> 0.
    MESSAGE e000(zmsg_a2r)
      WITH 'The combination of Company Code, Project Profile, and Request Type does not exist.'.
    cv_error = abap_true.
    RETURN.
  ENDIF.

ENDFORM.



*&---------------------------------------------------------------------*
*& Form GET_IM_AVAILABLE_BUDGET
*&---------------------------------------------------------------------*
FORM get_im_available_budget
  CHANGING cv_im_budget TYPE bpge-wlges.

  DATA: lv_objnr TYPE j_objnr,
        lv_wlges TYPE bpge-wlges,
        lv_wtgev TYPE bpge-wtgev.

  CLEAR: cv_im_budget, lv_objnr, lv_wlges, lv_wtgev.

  SELECT SINGLE objnr
    INTO @lv_objnr
    FROM impr
   WHERE posnr = @gs_header-posnr.

  IF sy-subrc <> 0 OR lv_objnr IS INITIAL.
    RETURN.
  ENDIF.

  SELECT SINGLE wlges wtgev
    INTO (@lv_wlges, @lv_wtgev)
    FROM bpge
   WHERE objnr = @lv_objnr.

  IF sy-subrc = 0.
    cv_im_budget = lv_wlges - lv_wtgev.
  ENDIF.

ENDFORM.