DATA: lv_vkokr TYPE kokrs,
      lv_pspnr TYPE pspnr.

"1) If header already has it, use it
lv_vkokr = is_header-vkokr.

"2) Else try to get from item table field directly
IF lv_vkokr IS INITIAL.
  READ TABLE it_wbs_items INTO DATA(ls_any_item) INDEX 1.
  IF sy-subrc = 0 AND ls_any_item-vkokr IS NOT INITIAL.
    lv_vkokr = ls_any_item-vkokr.
  ENDIF.
ENDIF.

"3) Else derive from PRPSS using PSPNR (POSNR) from item table (most reliable)
IF lv_vkokr IS INITIAL.
  IF ls_any_item IS INITIAL.
    READ TABLE it_wbs_items INTO ls_any_item INDEX 1.
  ENDIF.

  IF sy-subrc = 0.

    "POSNR in your table is PSPNR (internal WBS number)
    IF ls_any_item-posnr IS NOT INITIAL.
      lv_pspnr = ls_any_item-posnr.
    ENDIF.

    IF lv_pspnr IS NOT INITIAL.
      SELECT SINGLE pkokr
        INTO lv_vkokr
        FROM prpss
        WHERE pspnr = lv_pspnr.
    ENDIF.

  ENDIF.
ENDIF.



IF lv_vkokr IS INITIAL AND ls_any_item-posid IS NOT INITIAL.

  DATA: lv_posid_db TYPE ps_posid,
        lv_pspnr2   TYPE pspnr.

  lv_posid_db = ls_any_item-posid.

  "Normalize POSID (PC000001 -> PC.000001)
  TRY.
      CALL FUNCTION 'CONVERSION_EXIT_ABPSP_INPUT'
        EXPORTING  input  = lv_posid_db
        IMPORTING  output = lv_posid_db.
    CATCH cx_root.
  ENDTRY.

  SELECT SINGLE pspnr
    INTO lv_pspnr2
    FROM prps
    WHERE posid = lv_posid_db.

  IF lv_pspnr2 IS NOT INITIAL.
    SELECT SINGLE pkokr
      INTO lv_vkokr
      FROM prpss
      WHERE pspnr = lv_pspnr2.
  ENDIF.

ENDIF.