    IF sy-langu = 'E'.
      DATA(lv_text1) = 'This report will help to analyze duration between Actual End to Confirmation Date, Confirmation to TECO date,'.
      DATA(lv_text2) = 'error in entering Reference Date, work order completed after  Planned or Late Date.'.
      CONCATENATE lv_text1
                  lv_text2 INTO cv_description SEPARATED BY space.
    ELSEIF sy-langu = 'D'.
      lv_text1 = 'Bericht für Analyse von tatsächlichen Ende und dem Bestätigungsdatum, dem Bestätigungs- und'.
      lv_text2 = 'dem TECO-Datum, der Diff. Von Eingabe- / Referenzdatum und Datum Auftragsabschluss.'.

      CONCATENATE lv_text1
                  lv_text2 INTO cv_description SEPARATED BY space.
    ENDIF.
    cv_report_title = 'WO Confirmation & TECO Cycle Time (for Lonza)'.
  ENDMETHOD.


