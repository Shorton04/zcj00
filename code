*---------------------------------------------------------------------*
* Helper: parent POSID without last ".segment"
* Compatible (no "LAST OCCURRENCE")
*---------------------------------------------------------------------*
FORM get_parent_posid
  USING    iv_posid  TYPE ps_posid
  CHANGING cv_parent TYPE ps_posid.

  DATA: lt_parts TYPE STANDARD TABLE OF string WITH DEFAULT KEY,
        lv_last  TYPE string,
        lv_out   TYPE string.

  CLEAR cv_parent.
  IF iv_posid IS INITIAL.
    RETURN.
  ENDIF.

  "Split by dot and remove last segment
  SPLIT iv_posid AT '.' INTO TABLE lt_parts.
  IF lines( lt_parts ) <= 1.
    RETURN.
  ENDIF.

  "Delete last part
  DELETE lt_parts INDEX lines( lt_parts ).

  "Rebuild parent
  LOOP AT lt_parts INTO lv_last.
    IF lv_out IS INITIAL.
      lv_out = lv_last.
    ELSE.
      CONCATENATE lv_out lv_last INTO lv_out SEPARATED BY '.'.
    ENDIF.
  ENDLOOP.

  cv_parent = lv_out.

ENDFORM.


*---------------------------------------------------------------------*
* TOTALUP: roll up ZAPPROVED_BUDG using POSID parent-child hierarchy
* Triggered by OKCODE 'TOTALUP' in USER_COMMAND_0100
*---------------------------------------------------------------------*
FORM total_up_wbs_tc.

  FIELD-SYMBOLS: <child>  TYPE ty_wbs_display,
                 <parent> TYPE ty_wbs_display.

  DATA: lv_max_level TYPE i,
        lv_level     TYPE i,
        lv_parent_id TYPE ps_posid.

  "Find max level in current table
  lv_max_level = 0.
  LOOP AT gt_wbs_display ASSIGNING <child>.
    IF <child>-stufe IS NOT INITIAL AND <child>-stufe > lv_max_level.
      lv_max_level = <child>-stufe.
    ENDIF.
  ENDLOOP.

  IF lv_max_level <= 1.
    RETURN.
  ENDIF.

  "Clear all parent budgets first (we re-calc); keep leaf level as user input
  LOOP AT gt_wbs_display ASSIGNING <parent> WHERE stufe < lv_max_level.
    CLEAR <parent>-zapproved_budg.
  ENDLOOP.

  "Roll up from deepest -> level 2
  lv_level = lv_max_level.
  WHILE lv_level > 1.

    LOOP AT gt_wbs_display ASSIGNING <child> WHERE stufe = lv_level.
      IF <child>-zapproved_budg IS INITIAL OR <child>-posid IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR lv_parent_id.
      PERFORM get_parent_posid USING <child>-posid CHANGING lv_parent_id.
      IF lv_parent_id IS INITIAL.
        CONTINUE.
      ENDIF.

      "Add child budget into its parent row (identified by POSID)
      READ TABLE gt_wbs_display ASSIGNING <parent>
        WITH KEY posid = lv_parent_id.
      IF sy-subrc = 0.
        <parent>-zapproved_budg = <parent>-zapproved_budg + <child>-zapproved_budg.
      ENDIF.

    ENDLOOP.

    lv_level = lv_level - 1.
  ENDWHILE.

ENDFORM.