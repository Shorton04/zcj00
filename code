MODULE user_command_0100 INPUT.

  DATA: lv_ok          TYPE sy-ucomm,
        lt_changed_wbs TYPE STANDARD TABLE OF ztb_a2r_wbsitem WITH DEFAULT KEY.

  lv_ok = sy-ucomm.
  CLEAR sy-ucomm.

  CASE lv_ok.

    WHEN 'SUBM' OR 'SUBMIT'.

      "Run only for B3
      IF gv_request_type <> 'B3'.
        MESSAGE e029(zcj00) WITH 'Submit is not allowed for this request type.'.
        EXIT.
      ENDIF.

      "1) Get changed WBS rows only
      PERFORM get_changed_wbs_rows
        USING    gt_wbs_items
                 gt_wbs_items_old
        CHANGING lt_changed_wbs.

      "2) If nothing changed, block submit (optional but recommended)
      IF lt_changed_wbs IS INITIAL
         AND gs_header = gs_header_old.
        MESSAGE e029(zcj00) WITH 'No changes detected. Nothing to submit.'.
        EXIT.
      ENDIF.

      "3) Validate ONLY changed rows (your Table 4.1.6 logic)
      PERFORM validate_b3_only_changed USING gs_header lt_changed_wbs.

      "4) Update Z tables (HDR/ITEM) for B3 submit
      PERFORM update_wbshdr_b3 USING gs_header.
      PERFORM update_wbsitem_b3 USING gt_wbs_items.

      "5) Trigger workflow B3
      PERFORM trigger_workflow_b3 USING gs_header.

      MESSAGE s029(zcj00) WITH 'B3 request submitted for approval.'.

  ENDCASE.

ENDMODULE.