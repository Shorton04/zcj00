            ENDIF.
          ENDIF.
        ELSE.
          MESSAGE 'Update cancelled by user.' TYPE 'I'.
        ENDIF.
      ELSE.
        MESSAGE 'Popup cancelled by user.' TYPE 'I'.
      ENDIF.
    ELSE.
      MESSAGE 'No relevant data for updation' TYPE 'I'.
    ENDIF.

    ct_result = lt_result.

