"═══════════════════════════════════════════════════════════════════
" STEP 9: GET CREATED PROJECT INTERNAL NUMBER FROM BAPI MESSAGES
"═══════════════════════════════════════════════════════════════════

DATA: lv_created_pspid TYPE ps_pspid.

CLEAR lv_level1_pspnr.

" ───────────────────────────────────────────────────────────────
" Extract project ID from BAPI return parameter (cleaner approach)
" The PARAMETER field contains the created project ID
" ───────────────────────────────────────────────────────────────
READ TABLE lt_return INTO ls_return 
  WITH KEY type   = 'S'
           id     = 'CNIF_PI'
           number = '004'.

IF sy-subrc = 0.
  " PARAMETER field contains the external project ID
  IF ls_return-parameter IS NOT INITIAL.
    lv_created_pspid = ls_return-parameter.
  ELSEIF ls_return-message_v2 IS NOT INITIAL.
    " Fallback to MESSAGE_V2 if PARAMETER is empty
    lv_created_pspid = ls_return-message_v2.
  ENDIF.
  
  " Convert external PSPID to internal PSPNR
  IF lv_created_pspid IS NOT INITIAL.
    CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
      EXPORTING
        input  = lv_created_pspid
      IMPORTING
        output = lv_level1_pspnr.
  ENDIF.
ENDIF.

" ───────────────────────────────────────────────────────────────
" Fallback: If message extraction failed, SELECT from database
" ───────────────────────────────────────────────────────────────
IF lv_level1_pspnr IS INITIAL.
  
  " Wait for database update
  WAIT UP TO 2 SECONDS.
  
  " Convert input PSPID to internal format
  DATA(lv_pspid_internal) TYPE ps_pspid.
  
  CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
    EXPORTING
      input  = lv_pspid
    IMPORTING
      output = lv_pspid_internal.
  
  " Try SELECT with internal format
  SELECT SINGLE pspnr 
    FROM proj
    INTO lv_level1_pspnr
    WHERE pspid = lv_pspid_internal.
  
  IF sy-subrc <> 0.
    " Try with external format
    SELECT SINGLE pspnr 
      FROM proj
      INTO lv_level1_pspnr
      WHERE pspid = lv_pspid.
  ENDIF.
ENDIF.

" ───────────────────────────────────────────────────────────────
" Final validation
" ───────────────────────────────────────────────────────────────
IF lv_level1_pspnr IS INITIAL.
  MESSAGE e029(zcj00) WITH 'Could not determine project internal number'.
  rv_success = abap_false.
  RETURN.
ENDIF.
