METHOD set_blkd_status_for_higher_wbs.

  DATA: lv_pspid       TYPE proj-pspid,
        lv_pspid_int   TYPE proj-pspid,
        lv_proj_pspnr  TYPE proj-pspnr.

  DATA: lt_prhi        TYPE TABLE OF prhi,
        lt_up_pspnr    TYPE SORTED TABLE OF prhi-up WITH UNIQUE KEY table_line,
        lt_up_posid    TYPE SORTED TABLE OF prps-posid WITH UNIQUE KEY table_line,
        lt_user_status TYPE TABLE OF bapi_wbs_mnt_user_status,
        ls_user_status TYPE bapi_wbs_mnt_user_status,
        lt_result      TYPE TABLE OF bapi_status_result,
        ls_result      TYPE bapi_status_result.

  rv_success = abap_false.

  "-----------------------------
  "0) Derive PSPID (Project Definition) from Level-1 WBS POSID
  "   In your data PSPID column can be blank, but POSID exists.
  "-----------------------------
  READ TABLE it_wbs_items INTO DATA(ls_lvl1) WITH KEY stufe = 1.
  IF sy-subrc <> 0 OR ls_lvl1-posid IS INITIAL.
    "Fallback: first row
    READ TABLE it_wbs_items INTO ls_lvl1 INDEX 1.
    IF sy-subrc <> 0 OR ls_lvl1-posid IS INITIAL.
      RETURN.
    ENDIF.
  ENDIF.

  lv_pspid = ls_lvl1-posid.

  "Normalize PSPID like old style (CJ20N internal search expects normalized key)
  "Example: 'PC.000143' -> 'PC000143'
  lv_pspid_int = lv_pspid.
  CALL FUNCTION 'CONVERSION_EXIT_ABPSP_INPUT'
    EXPORTING
      input  = lv_pspid
    IMPORTING
      output = lv_pspid_int
    EXCEPTIONS
      OTHERS = 0.

  "Use PS context (MANDATORY in your system)
  CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

  "-----------------------------
  "1) Get PROJ-PSPNR using PSPID (FDS Step 1)
  "-----------------------------
  SELECT SINGLE pspnr
    INTO @lv_proj_pspnr
    FROM proj
    WHERE pspid = @lv_pspid_int.

  IF sy-subrc <> 0 OR lv_proj_pspnr IS INITIAL.
    "Try again with external (some systems store dotted PSPID)
    SELECT SINGLE pspnr
      INTO @lv_proj_pspnr
      FROM proj
      WHERE pspid = @lv_pspid.
    IF sy-subrc <> 0 OR lv_proj_pspnr IS INITIAL.
      RETURN.
    ENDIF.
  ENDIF.

  "-----------------------------
  "2) Get PRHI entries where PSPHI = PROJ-PSPNR (FDS Step 1)
  "   Collect unique UP (higher-level WBS internal numbers)
  "-----------------------------
  SELECT *
    FROM prhi
    INTO TABLE @lt_prhi
    WHERE psphi = @lv_proj_pspnr.

  IF lt_prhi IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT lt_prhi ASSIGNING FIELD-SYMBOL(<ls_prhi>).
    "Ignore top marker / empty parents
    IF <ls_prhi>-up IS INITIAL OR <ls_prhi>-up = '00000000'.
      CONTINUE.
    ENDIF.
    INSERT <ls_prhi>-up INTO TABLE lt_up_pspnr.
  ENDLOOP.

  IF lt_up_pspnr IS INITIAL.
    RETURN.
  ENDIF.

  "-----------------------------
  "3) Map each UP (PSPNR) -> POSID via PRPS, then set BLKD only for these parents
  "-----------------------------
  LOOP AT lt_up_pspnr INTO DATA(lv_up_pspnr).
    DATA(lv_up_posid) = VALUE prps-posid( ).

    SELECT SINGLE posid
      INTO @lv_up_posid
      FROM prps
      WHERE pspnr = @lv_up_pspnr.

    IF sy-subrc <> 0 OR lv_up_posid IS INITIAL.
      CONTINUE.
    ENDIF.

    INSERT lv_up_posid INTO TABLE lt_up_posid.
  ENDLOOP.

  IF lt_up_posid IS INITIAL.
    RETURN.
  ENDIF.

  LOOP AT lt_up_posid INTO DATA(lv_parent_posid).
    CLEAR ls_user_status.
    ls_user_status-wbs_element     = lv_parent_posid.
    ls_user_status-set_user_status = 'BLKD'.
    APPEND ls_user_status TO lt_user_status.
  ENDLOOP.

  IF lt_user_status IS INITIAL.
    RETURN.
  ENDIF.

  "-----------------------------
  "4) Set BLKD status for higher-level WBS only (FDS Step 2)
  "-----------------------------
  CALL FUNCTION 'BAPI_BUS2054_SET_STATUS'
    TABLES
      i_wbs_user_status = lt_user_status
      e_result          = lt_result.

  "Required in your system
  CALL FUNCTION 'BAPI_PS_PRECOMMIT'.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  "-----------------------------
  "5) Result handling:
  "   In your system, success => lt_result can be EMPTY.
  "   Error => lt_result has entries.
  "-----------------------------
  IF lt_result IS INITIAL.
    rv_success = abap_true.
    RETURN.
  ENDIF.

  LOOP AT lt_result INTO ls_result.
    "Treat any message with ID/TYPE as error (be strict)
    IF ls_result-message_id IS NOT INITIAL
       OR ls_result-message_type = 'E'
       OR ls_result-message_type = 'A'
       OR ls_result-message_type = 'X'.
      rv_success = abap_false.
      RETURN.
    ENDIF.
  ENDLOOP.

  rv_success = abap_true.

ENDMETHOD.