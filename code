  METHOD if_swf_flex_ifs_run_appl~result_callback.
    DATA:
      lo_instance   TYPE REF TO zcl_a2r_wbs_builder,
      ls_header     TYPE zta2r_wbshdr,
      lt_wbsitem    TYPE STANDARD TABLE OF zta2r_wbsitem WITH DEFAULT KEY,
      lt_wbscar     TYPE ztt_a2r_wbsitem,
      lt_wbshier    TYPE ztt_a2r_wbshier,
      lt_wbsunclose TYPE ztt_a2r_wbsunclose,
      lv_response   TYPE char1.

    CONSTANTS:
      lc_appr   TYPE char7 VALUE 'APPROVE',
      lc_apprd  TYPE char8 VALUE 'APPROVED',
      lc_reject TYPE char6 VALUE 'REJECT',
      lc_rejctd TYPE char8 VALUE 'REJECTED',
      lc_a1     TYPE char2 VALUE 'A1', "Create Project
      lc_b1     TYPE char2 VALUE 'B1', "CAR
      lc_b2     TYPE char2 VALUE 'B2', "Budget Distribution
      lc_b3     TYPE char2 VALUE 'B3', "Critical Changes
      lc_e1     TYPE char2 VALUE 'E1'  "UNClose
      .

    ev_decision_reason = VALUE #( ).
    ev_outcome = VALUE #( ).

* get WF result
    DATA(ls_result) = io_result->get_result( ).

    TRY.
        DATA(lv_appr_result) = to_upper( ls_result-result ).
      CATCH cx_sy_itab_line_not_found.
        RAISE EXCEPTION TYPE cx_swf_flex_ifs_run_exception
          EXPORTING
            textid = VALUE scx_t100key( msgid = sy-msgid msgno = sy-msgno attr1 = sy-msgv1 attr2 = sy-msgv2 ).
    ENDTRY.

* get WF container
    DATA(lo_container) = io_context->get_workflow_container( ).

    TRY.
        lo_container->get( EXPORTING name = 'WBSHeader' IMPORTING value = ls_header ).
        DATA(lv_request_type) = ls_header-z_reqtype.

      CATCH cx_swf_cnt_cont_access_denied " Container Must Not Be Changed
            cx_swf_cnt_elem_access_denied " Element Must Not Be Changed
            cx_swf_cnt_elem_not_found     " Element does not exist
            cx_swf_cnt_container.         " Exception in the Container Service
        RAISE EXCEPTION TYPE cx_swf_flex_ifs_run_exception
          EXPORTING
            textid = VALUE scx_t100key( msgid = sy-msgid msgno = sy-msgno attr1 = sy-msgv1 attr2 = sy-msgv2 ).
    ENDTRY.

*        IF leading_object->result = c_approved.
*
*    ENDIF.

    IF lv_appr_result = lc_appr. "'APPROVE'
      lo_instance = NEW zcl_a2r_wbs_builder( ).
      CASE lv_request_type.
        WHEN lc_b1. "'B1'   "CAR
          TRY.
              lo_container->get( EXPORTING name = 'WBSCar' IMPORTING value = lt_wbscar ).
              lo_container->get( EXPORTING name = 'WBSHier' IMPORTING value = lt_wbshier ).

            CATCH cx_swf_cnt_cont_access_denied " Container Must Not Be Changed
                  cx_swf_cnt_elem_access_denied " Element Must Not Be Changed
                  cx_swf_cnt_elem_not_found     " Element does not exist
                  cx_swf_cnt_container.         " Exception in the Container Service
              RAISE EXCEPTION TYPE cx_swf_flex_ifs_run_exception
                EXPORTING
                  textid = VALUE scx_t100key( msgid = sy-msgid msgno = sy-msgno attr1 = sy-msgv1 attr2 = sy-msgv2 ).
          ENDTRY.

          SELECT * FROM zta2r_wbsitem
            INTO TABLE @lt_wbsitem
            WHERE zreq_num EQ @ls_header-zreq_num.
          IF sy-subrc EQ 0.
            lo_instance->create_car_wbs_b1(
              EXPORTING
                is_header     = ls_header
                it_wbs_items  = lt_wbsitem
                it_wbs_car    = lt_wbscar
                it_phris_hier = lt_wbshier
              IMPORTING
                rv_success    = lv_response
            ).
            IF lv_response EQ abap_true.
              UPDATE zta2r_wbshdr
                  SET request_status       = lc_apprd
                      zapproved_by         = ls_result-actor
                      zrequest_approved_on = sy-datum
                      pspid                = ls_header-pspid
                  WHERE zreq_num = ls_header-zreq_num.
              CLEAR lv_response.
            ENDIF.
          ENDIF.

        WHEN lc_b2. "'B2'   "Budget Distribution
          lv_response = lo_instance->budget_distribution( is_header = ls_header ).
          IF lv_response EQ abap_true.
            UPDATE zta2r_wbshdr
                SET request_status       = lc_apprd
                    zapproved_by         = ls_result-actor
                    zrequest_approved_on = sy-datum
                    pspid                = ls_header-pspid
                WHERE zreq_num = ls_header-zreq_num.
            CLEAR lv_response.
          ENDIF.

        WHEN lc_b3. "'B3'.   "Critical Changes
          lv_response = lo_instance->crit_change( is_header = ls_header ).
          IF lv_response EQ abap_true.
            UPDATE zta2r_wbshdr
                SET request_status       = lc_apprd
                    zapproved_by         = ls_result-actor
                    zrequest_approved_on = sy-datum
                    pspid                = ls_header-pspid
                WHERE zreq_num = ls_header-zreq_num.
            CLEAR lv_response.
          ENDIF.

        WHEN lc_a1. "Project Creation
          lv_response = lo_instance->create_project_cj20n(
            EXPORTING
              is_header = ls_header
          ).

        WHEN lc_e1. "Project Creation

          TRY.
              lo_container->get( EXPORTING name = 'WBSUnclose' IMPORTING value = lt_wbsunclose ).

              lv_response = lo_instance->unclose_wbs_status(
                iv_req_num     = ls_header-zreq_num
                it_wbs_unclose = lt_wbsunclose ).

            CATCH cx_swf_cnt_cont_access_denied " Container Must Not Be Changed
                  cx_swf_cnt_elem_access_denied " Element Must Not Be Changed
                  cx_swf_cnt_elem_not_found     " Element does not exist
                  cx_swf_cnt_container.         " Exception in the Container Service
              RAISE EXCEPTION TYPE cx_swf_flex_ifs_run_exception
                EXPORTING
                  textid = VALUE scx_t100key( msgid = sy-msgid msgno = sy-msgno attr1 = sy-msgv1 attr2 = sy-msgv2 ).
          ENDTRY.

        WHEN OTHERS.
          RETURN.
      ENDCASE.

      " update table for the approver decision -> approved
      IF lv_response EQ abap_true.
        UPDATE zta2r_wbshdr
            SET request_status       = lc_apprd
                zapproved_by         = ls_result-actor
                zrequest_approved_on = sy-datum
            WHERE zreq_num = ls_header-zreq_num.
      ENDIF.

      ev_outcome = 'Approve'.

    ELSEIF lv_appr_result = lc_reject. "'REJECT'
      " update table for the approver decision -> rejected
      UPDATE zta2r_wbshdr
        SET request_status       = lc_rejctd
            zrejected_by         = ls_result-actor
            zrequest_rejected_on = sy-datum
      WHERE zreq_num = ls_header-zreq_num.

        ev_outcome = 'Rejected'.
    ENDIF.
  ENDMETHOD.
