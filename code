*&---------------------------------------------------------------------*
*& Report ZTEST_SUBP
*&---------------------------------------------------------------------*
REPORT ztest_subp.

*---------------------------------------------------------------------*
* PARAMETERS
*---------------------------------------------------------------------*
PARAMETERS:
  p_aufnr TYPE aufnr       OBLIGATORY, "Order
  p_sts   TYPE bsvx-sttxt OBLIGATORY, "RFRA / REXE
  p_stchg TYPE jest-stat  OBLIGATORY. "E000X

*---------------------------------------------------------------------*
* DATA
*---------------------------------------------------------------------*
DATA:
  lv_objnr    TYPE jest-objnr,
  lv_vornr    TYPE vornr,

  lt_methods  TYPE TABLE OF bapi_alm_order_method,
  lt_header   TYPE TABLE OF bapi_alm_order_headers_i,
  lt_header_up TYPE TABLE OF bapi_alm_order_headers_up,
  lt_extension TYPE TABLE OF bapiparex,
  lt_return   TYPE TABLE OF bapiret2,

  ls_return   TYPE bapiret2.

*---------------------------------------------------------------------*
* GET FIRST OPERATION
*---------------------------------------------------------------------*
SELECT SINGLE a~vornr
  INTO @lv_vornr
  FROM afvc AS a
  INNER JOIN afko AS k
    ON k~aufpl = a~aufpl
 WHERE k~aufnr = @p_aufnr.

IF sy-subrc <> 0.
  WRITE: / 'No operation found.'.
  EXIT.
ENDIF.

WRITE: / 'Operation:', lv_vornr.

*---------------------------------------------------------------------*
* GET OBJNR
*---------------------------------------------------------------------*
SELECT SINGLE a~objnr
  INTO @lv_objnr
  FROM afvc AS a
  INNER JOIN afko AS k
    ON k~aufpl = a~aufpl
 WHERE k~aufnr = @p_aufnr
   AND a~vornr = @lv_vornr.

IF sy-subrc <> 0.
  WRITE: / 'OBJNR not found.'.
  EXIT.
ENDIF.

WRITE: / 'OBJNR:', lv_objnr.

************************************************************************
* STEP 1 : SET USER STATUS
************************************************************************
CALL FUNCTION 'STATUS_CHANGE_EXTERN'
  EXPORTING
    objnr       = lv_objnr
    user_status = p_stchg
    set_inact   = space
  EXCEPTIONS
    object_not_found    = 1
    status_inconsistent = 2
    status_not_allowed  = 3
    OTHERS              = 4.

IF sy-subrc <> 0.
  WRITE: / 'STATUS_CHANGE_EXTERN FAILED:', sy-subrc.
  ROLLBACK WORK.
  EXIT.
ENDIF.

WRITE: / 'STATUS_CHANGE_EXTERN SUCCESS'.

************************************************************************
* STEP 2 : CHECK_BEFORE_SAVE
************************************************************************
CLEAR:
  lt_methods,
  lt_header,
  lt_extension,
  lt_return.

*---------------------------------------------------------------------*
* METHOD : CHANGE
*---------------------------------------------------------------------*
APPEND VALUE #(
  refnumber  = '000001'
  objecttype = 'HEADER'
  method     = 'CHANGE'
  objectkey  = p_aufnr
) TO lt_methods.

*---------------------------------------------------------------------*
* METHOD : DIALOG
*---------------------------------------------------------------------*
APPEND VALUE #(
  method = 'DIALOG'
) TO lt_methods.

*---------------------------------------------------------------------*
* HEADER
*---------------------------------------------------------------------*
APPEND VALUE #(
  orderid = p_aufnr
) TO lt_header.

*---------------------------------------------------------------------*
* EXTENSION
*---------------------------------------------------------------------*
APPEND VALUE #(
  structure  = 'SEOCPDNAME'
  valuepart1 = 'CHECK_BEFORE_SAVE'
  valuepart2 = 'CL_EAMS_BO_ORDER'
) TO lt_extension.

*---------------------------------------------------------------------*
* RUN BAPI
*---------------------------------------------------------------------*
CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
  EXPORTING
    iv_mmsrv_external_maintenace = abap_true
  TABLES
    it_methods   = lt_methods
    it_header    = lt_header
    extension_in = lt_extension
    return       = lt_return.

LOOP AT lt_return INTO ls_return.
  WRITE: / ls_return-type,
           ls_return-id,
           ls_return-number,
           ls_return-message.
ENDLOOP.

READ TABLE lt_return INTO ls_return
  WITH KEY type = 'E'.

IF sy-subrc = 0.
  WRITE: / 'CHECK_BEFORE_SAVE FAILED'.
  ROLLBACK WORK.
  EXIT.
ENDIF.

WRITE: / 'CHECK_BEFORE_SAVE SUCCESS'.

************************************************************************
* STEP 3 : SAVE_BAPI_AND_RELEASE
************************************************************************
CLEAR:
  lt_methods,
  lt_header,
  lt_header_up,
  lt_extension,
  lt_return.

*---------------------------------------------------------------------*
* METHOD : SAVE
*---------------------------------------------------------------------*
APPEND VALUE #(
  method = 'SAVE'
) TO lt_methods.

*---------------------------------------------------------------------*
* HEADER
*---------------------------------------------------------------------*
APPEND VALUE #(
  orderid = p_aufnr
) TO lt_header.

*---------------------------------------------------------------------*
* HEADER UPDATE
*---------------------------------------------------------------------*
APPEND VALUE #(
  orderid = p_aufnr
) TO lt_header_up.

*---------------------------------------------------------------------*
* EXTENSION
*---------------------------------------------------------------------*
APPEND VALUE #(
  structure  = 'SEOCPDNAME'
  valuepart1 = 'SAVE_BAPI_AND_RELEASE'
  valuepart2 = 'CL_EAMS_BO_ORDER'
) TO lt_extension.

*---------------------------------------------------------------------*
* RUN SAVE BAPI
*---------------------------------------------------------------------*
CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
  EXPORTING
    iv_mmsrv_external_maintenace = abap_true
  TABLES
    it_methods   = lt_methods
    it_header    = lt_header
    it_header_up = lt_header_up
    extension_in = lt_extension
    return       = lt_return.

LOOP AT lt_return INTO ls_return.
  WRITE: / ls_return-type,
           ls_return-id,
           ls_return-number,
           ls_return-message.
ENDLOOP.

READ TABLE lt_return INTO ls_return
  WITH KEY type = 'E'.

IF sy-subrc = 0.

  WRITE: / 'SAVE FAILED'.

  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.

  EXIT.

ENDIF.

************************************************************************
* COMMIT
************************************************************************
CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
  EXPORTING
    wait = 'X'.

WRITE: / 'SUCCESS'.
WRITE: / 'ORDER      :', p_aufnr.
WRITE: / 'OPERATION  :', lv_vornr.
WRITE: / 'USERSTATUS :', p_stchg.
WRITE: / 'PHASE TEST :', p_sts.

************************************************************************
* VERIFY RESULT
************************************************************************
DATA:
  lv_phase    TYPE char10,
  lv_subphase TYPE char10.

SELECT SINGLE
       maintordopprocessphasecode,
       maintordopprocesssubphasecode
  INTO (@lv_phase, @lv_subphase)
  FROM afvc AS a
  INNER JOIN afko AS k
    ON k~aufpl = a~aufpl
 WHERE k~aufnr = @p_aufnr
   AND a~vornr = @lv_vornr.

WRITE: / '----------------------------------'.
WRITE: / 'AFVC PHASE    :', lv_phase.
WRITE: / 'AFVC SUBPHASE :', lv_subphase.
WRITE: / '----------------------------------'.