                                                METHOD get_approvers.

                                                  DATA:
                                                    lv_objid TYPE hrobjid.

                                                  IF iv_pos IS INITIAL.
                                                    RETURN.
                                                  ENDIF.

                                                  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
                                                    EXPORTING
                                                      input  = iv_pos
                                                    IMPORTING
                                                      output = lv_objid.

                                                  " Read only needed field (VARYF)
                                                  SELECT varyf
                                                    FROM hrp1001
                                                    WHERE objid = @lv_objid
                                                      AND otype = 'S'
                                                      AND plvar = '01'
                                                      AND rsign = 'A'
                                                      AND relat = '008'
                                                      AND sclas = 'US'
                                                      AND endda >= @sy-datum
                                                      AND begda <= @sy-datum
                                                    INTO TABLE @DATA(lt_users).

                                                    " Exit early if nothing found
                                                    IF lt_users IS INITIAL.
                                                      RETURN.
                                                    ENDIF.

                                                    " Remove duplicates and empty values
                                                    DELETE lt_users WHERE varyf IS INITIAL.
                                                    SORT lt_users BY varyf.
                                                    DELETE ADJACENT DUPLICATES FROM lt_users COMPARING varyf.

                                                    " Append to output table
                                                    ct_approvers = VALUE #( FOR ls IN lt_users ( CONV #( ls-varyf ) ) ).
                                                  ENDMETHOD.
