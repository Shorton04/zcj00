MODULE user_command_0100 INPUT.

  "------------------------------------------------------------------
  "1) Persist user input into GS_HEADER and mark user overrides
  "   (Put this BEFORE CASE sy-ucomm / validations)
  "------------------------------------------------------------------

  IF p_post1 <> gs_header-post1.
    gs_header-post1 = p_post1.
    gv_u_post1 = abap_true.
  ENDIF.

  IF p_vernr <> gs_header-vernr.
    gs_header-vernr = p_vernr.
    gv_u_vernr = abap_true.
  ENDIF.

  IF p_plsez <> gs_header-plsez.
    gs_header-plsez = p_plsez.
    gv_u_plsez = abap_true.
  ENDIF.

  "IM Position: if your input is POSNR keep it here; if user edits POSID field, adapt accordingly
  "Example if user edits POSNR:
  IF p_posnr <> gs_header-posnr.
    gs_header-posnr = p_posnr.
    gv_u_posid = abap_true.
  ENDIF.

  IF p_prctr <> gs_header-prctr.
    gs_header-prctr = p_prctr.
    gv_u_prctr = abap_true.
  ENDIF.

  IF p_kostl <> gs_header-kostl.
    gs_header-kostl = p_kostl.
    gv_u_kostl = abap_true.
  ENDIF.

  "------------------------------------------------------------------
  "2) Your existing OKCODE logic continues here
  "------------------------------------------------------------------
  " ok_code = sy-ucomm.
  " CASE sy-ucomm.
  " ...
  " ENDCASE.

ENDMODULE.



MODULE set_header_display_values OUTPUT.

  "------------------------------------------------------------------
  "0) Derive defaults (example variables)
  "   - put your existing derivation PERFORMs/SELECTs here if you have them
  "------------------------------------------------------------------
  "DATA: lv_post1_def TYPE ...
  "      lv_vernr_def TYPE ...
  "      lv_plsez_def TYPE ...
  "      lv_prctr_def TYPE ...
  "      lv_kostl_def TYPE ...

  "------------------------------------------------------------------
  "1) Protect user-entered fields: only default if not overridden
  "------------------------------------------------------------------
  IF gv_u_post1 IS INITIAL AND gs_header-post1 IS INITIAL.
    gs_header-post1 = lv_post1_def.
  ENDIF.

  IF gv_u_vernr IS INITIAL AND gs_header-vernr IS INITIAL.
    gs_header-vernr = lv_vernr_def.
  ENDIF.

  IF gv_u_plsez IS INITIAL AND gs_header-plsez IS INITIAL.
    gs_header-plsez = lv_plsez_def.
  ENDIF.

  "IM Position protection:
  "If auto-fill sets POSNR, guard it similarly:
  IF gv_u_posid IS INITIAL AND gs_header-posnr IS INITIAL.
    gs_header-posnr = lv_posnr_def.
  ENDIF.

  IF gv_u_prctr IS INITIAL AND gs_header-prctr IS INITIAL.
    gs_header-prctr = lv_prctr_def.
  ENDIF.

  IF gv_u_kostl IS INITIAL AND gs_header-kostl IS INITIAL.
    gs_header-kostl = lv_kostl_def.
  ENDIF.

  "------------------------------------------------------------------
  "2) Your existing display-only logic stays as-is (requestor, reqtype,
  "   gv_im_posid_display, available budget, currency)
  "------------------------------------------------------------------
  "... existing code you already have ...
ENDMODULE.



