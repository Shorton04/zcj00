METHOD assign_plan_values.

  "------------------------------------------------------------
  " CJ40-equivalent posting via KBPP_EXTERN_UPDATE_CO
  "------------------------------------------------------------
  DATA: ls_wbs   TYPE ztb_a2r_wbsitem,
        lv_objnr TYPE j_objnr,
        lv_kokrs TYPE kokrs,
        lv_gjahr TYPE gjahr,
        lt_kbpp0 TYPE TABLE OF kbpp0,
        ls_kbpp0 TYPE kbpp0,
        lt_return TYPE TABLE OF bapiret2.

  CONSTANTS: lc_versn TYPE versn VALUE '0',
             lc_wrttp TYPE wrttp VALUE '01',        " Plan
             lc_kstar TYPE kstar VALUE '400000'.    " <<< TODO: replace with your planning cost element

  rv_success = abap_false.
  CLEAR: lt_kbpp0, lt_return.

  " Fiscal year from header start date (fallback: current year)
  IF is_header-plfaz IS NOT INITIAL.
    lv_gjahr = is_header-plfaz(4).
  ELSE.
    lv_gjahr = sy-datum(4).
  ENDIF.

  LOOP AT it_wbs_items INTO ls_wbs.

    " Skip if no plan value
    IF ls_wbs-wert2 IS INITIAL.
      CONTINUE.
    ENDIF.

    " Get WBS OBJNR + KOKRS from PRPS (best source)
    SELECT SINGLE objnr pkokr
      FROM prps
      INTO (lv_objnr, lv_kokrs)
      WHERE posid = @ls_wbs-posid.

    IF sy-subrc <> 0 OR lv_objnr IS INITIAL OR lv_kokrs IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_kbpp0.

    " KBPP0 key fields (common in S/4)
    ls_kbpp0-objnr = lv_objnr.
    ls_kbpp0-kstar = lc_kstar.
    ls_kbpp0-gjahr = lv_gjahr.
    ls_kbpp0-versn = lc_versn.
    ls_kbpp0-wrttp = lc_wrttp.

    " Distribute plan across periods 1..12 (even)
    DATA(lv_monthly) = ls_wbs-wert2 / 12.

    " Most systems have WTG001..WTG012 in KBPP0
    ls_kbpp0-wtg001 = lv_monthly.
    ls_kbpp0-wtg002 = lv_monthly.
    ls_kbpp0-wtg003 = lv_monthly.
    ls_kbpp0-wtg004 = lv_monthly.
    ls_kbpp0-wtg005 = lv_monthly.
    ls_kbpp0-wtg006 = lv_monthly.
    ls_kbpp0-wtg007 = lv_monthly.
    ls_kbpp0-wtg008 = lv_monthly.
    ls_kbpp0-wtg009 = lv_monthly.
    ls_kbpp0-wtg010 = lv_monthly.
    ls_kbpp0-wtg011 = lv_monthly.
    ls_kbpp0-wtg012 = lv_monthly.

    APPEND ls_kbpp0 TO lt_kbpp0.

  ENDLOOP.

  IF lt_kbpp0 IS INITIAL.
    rv_success = abap_true.
    RETURN.
  ENDIF.

  " Post in one call (Version 0, Plan)
  CALL FUNCTION 'KBPP_EXTERN_UPDATE_CO'
    EXPORTING
      i_kokrs = lv_kokrs
      i_gjahr = lv_gjahr
      i_versn = lc_versn
    TABLES
      t_kbpp0 = lt_kbpp0
      t_return = lt_return
    EXCEPTIONS
      OTHERS  = 1.

  IF sy-subrc <> 0.
    rv_success = abap_false.
    ROLLBACK WORK.
    RETURN.
  ENDIF.

  " Check return messages
  READ TABLE lt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
  IF sy-subrc = 0.
    rv_success = abap_false.
    ROLLBACK WORK.
    RETURN.
  ENDIF.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = abap_true.

  rv_success = abap_true.

ENDMETHOD.