*&---------------------------------------------------------------------*
*& Form GET_REQUEST_TYPE_TEXT
*&---------------------------------------------------------------------*
*& Convert request type code to display text (hardcoded mapping)
*&---------------------------------------------------------------------*
FORM get_request_type_text USING    iv_reqtype      TYPE char2
                           CHANGING cv_reqtype_text TYPE char20.

  CLEAR cv_reqtype_text.

  " ★ HARDCODED MAPPING: Request Type Code → Description
  CASE iv_reqtype.
    WHEN 'A1'.
      cv_reqtype_text = 'Create'.
    WHEN 'A2'.
      cv_reqtype_text = 'Modify'.
    WHEN 'A3'.
      cv_reqtype_text = 'Close'.
    WHEN 'A4'.
      cv_reqtype_text = 'Delete'.
    WHEN OTHERS.
      " Fallback: show the code if unmapped
      cv_reqtype_text = iv_reqtype.
  ENDCASE.

ENDFORM.


*&---------------------------------------------------------------------*
*& Form GET_REQUEST_TYPE_TEXT
*&---------------------------------------------------------------------*
FORM get_request_type_text USING    iv_reqtype      TYPE char2
                           CHANGING cv_reqtype_text TYPE char20.

  CLEAR cv_reqtype_text.

  " Use constants for cleaner code
  CASE iv_reqtype.
    WHEN gc_reqtype_create.
      cv_reqtype_text = gc_reqtype_create_txt.  " 'Create'
    WHEN gc_reqtype_modify.
      cv_reqtype_text = gc_reqtype_modify_txt.  " 'Modify'
    WHEN gc_reqtype_close.
      cv_reqtype_text = gc_reqtype_close_txt.   " 'Close'
    WHEN gc_reqtype_delete.
      cv_reqtype_text = gc_reqtype_delete_txt.  " 'Delete'
    WHEN OTHERS.
      cv_reqtype_text = iv_reqtype.             " Fallback
  ENDCASE.

ENDFORM.



*&---------------------------------------------------------------------*
*& Module SET_HEADER_DISPLAY_VALUES OUTPUT
*&---------------------------------------------------------------------*
MODULE set_header_display_values OUTPUT.

  DATA: lv_fullname     TYPE char50,
        lv_reqtype_text TYPE char20.

  " ★ Convert username to full name
  IF gs_header-ernam IS NOT INITIAL.
    PERFORM get_user_fullname 
      USING    gs_header-ernam
      CHANGING lv_fullname.
    
    gv_requestor_display = lv_fullname.
  ELSE.
    gv_requestor_display = sy-uname.  " Default to current user
  ENDIF.

  " ★ Convert request type code to description (hardcoded)
  IF gs_header-z_reqtype IS NOT INITIAL.
    PERFORM get_request_type_text
      USING    gs_header-z_reqtype
      CHANGING lv_reqtype_text.
    
    gv_reqtype_display = lv_reqtype_text.
  ELSE.
    " Default to 'Create' if not set
    gv_reqtype_display = gc_reqtype_create_txt.
  ENDIF.

ENDMODULE.




*&---------------------------------------------------------------------*
*& Module STATUS_0100 OUTPUT
*&---------------------------------------------------------------------*
MODULE status_0100 OUTPUT.
  SET PF-STATUS 'STATUS_100'.
  SET TITLEBAR 'TITLE_100'.

  " ★ Gray out all header information fields
  LOOP AT SCREEN.
    
    " Header fields on the left side
    IF screen-name = 'P_POST1'          " Description
    OR screen-name = 'P_VERNA'          " Person Responsible
    OR screen-name = 'P_PLSEZ'          " Finish Date
    OR screen-name = 'P_PRNAM'          " IM Program
    OR screen-name = 'P_POSNR'          " IM Number
    OR screen-name = 'GV_AVAILABLE_BUDGET'  " Available Budget
    
    " Header fields on the right side
    OR screen-name = 'GV_BUKRS'         " Company Code
    OR screen-name = 'GV_WERKS'         " Plant
    OR screen-name = 'P_PRCTR'          " Profit Center
    OR screen-name = 'P_KOSTL'          " Cost Center
    OR screen-name = 'GV_IZWEK'         " Investment Reason
    OR screen-name = 'P_USR10'          " GE Ariba WF Flag
    OR screen-name = 'GV_USR008'        " CAR Approval Date
    
    " Status/Request info (always read-only)
    OR screen-name = 'GV_REQUESTOR_DISPLAY'   " Requestor (full name)
    OR screen-name = 'GS_HEADER-REQUEST_STATUS'  " Request Status
    OR screen-name = 'GV_REQTYPE_DISPLAY'.    " Request Type (Create/Modify)
    
      screen-input = 0.           " Disable input
      screen-intensified = 0.     " Gray out
      MODIFY SCREEN.
    ENDIF.
    
  ENDLOOP.

ENDMODULE.



