* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_A2R_WBS_BUILDER->CHECK_APPROVER_MATRIX
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BUKRS                       TYPE        BUKRS
* | [--->] IV_PROFL                       TYPE        PROFIDPROJ
* | [--->] IV_REQTYPE                     TYPE        ZTB_A2R_REQTYPE-Z_REQTYPE
* | [<---] EV_APPR1                       TYPE        CHAR8
* | [<---] EV_APPR2                       TYPE        CHAR8
* | [<---] EV_AUTO                        TYPE        CHAR1
* | [<---] EV_ERROR_HANDLER               TYPE        CHAR8
* | [<---] ET_L1_APPROVERS                TYPE        HPA_T_BNAME
* | [<---] ET_L2_APPROVERS                TYPE        HPA_T_BNAME
* | [<-()] RV_FOUND                       TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD check_approver_matrix.

    DATA: ls_config  TYPE ztb_a2r_conftab2,
          lt_hrp1001 TYPE TABLE OF hrp1001,
          ls_hrp1001 TYPE hrp1001,
          lv_uname   TYPE xubname.

    CLEAR: ev_appr1, ev_appr2, ev_auto, ev_error_handler, et_l1_approvers, et_l2_approvers.

    " Get approver configuration from config table
    SELECT SINGLE * FROM ztb_a2r_conftab2
      INTO ls_config
      WHERE bukrs = iv_bukrs
        AND profl = iv_profl
        AND z_reqtype = iv_reqtype.

    IF sy-subrc = 0.
      ev_appr1 = ls_config-zaproval_1.
      ev_appr2 = ls_config-zaproval_2.
      ev_error_handler = ls_config-zerror_handling.

      " ★ Get Level 1 Approvers from HRP1001
      IF ev_appr1 IS NOT INITIAL.
        SELECT * FROM hrp1001
          INTO TABLE lt_hrp1001
          WHERE objid = ev_appr1
            AND otype = 'S'           " Position/Org unit
            AND plvar = '01'          " Plan version
            AND rsign = 'A'           " A-Relationship
            AND relat = '008'         " User assignment
            AND sclas = 'US'          " User class
            AND endda >= sy-datum     " Valid to date
            AND begda <= sy-datum.    " Valid from date

        IF sy-subrc = 0.
          LOOP AT lt_hrp1001 INTO ls_hrp1001.
            " Remove 'US' prefix if present (SOBID might be 'USEV92123')
            lv_uname = ls_hrp1001-sobid.
            IF lv_uname(2) = 'US'.
              lv_uname = lv_uname+2.  " Remove 'US' prefix
            ENDIF.
            APPEND lv_uname TO et_l1_approvers.
          ENDLOOP.
        ENDIF.
      ENDIF.

      " ★ Get Level 2 Approvers from HRP1001
      IF ev_appr2 IS NOT INITIAL.
        CLEAR lt_hrp1001.
        SELECT * FROM hrp1001
          INTO TABLE lt_hrp1001
          WHERE objid = ev_appr2
            AND otype = 'S'
            AND plvar = '01'
            AND rsign = 'A'
            AND relat = '008'
            AND sclas = 'US'
            AND endda >= sy-datum
            AND begda <= sy-datum.

        IF sy-subrc = 0.
          LOOP AT lt_hrp1001 INTO ls_hrp1001.
            lv_uname = ls_hrp1001-sobid.
            IF lv_uname(2) = 'US'.
              lv_uname = lv_uname+2.  " Remove 'US' prefix
            ENDIF.
            APPEND lv_uname TO et_l2_approvers.
          ENDLOOP.
        ENDIF.
      ENDIF.

      " Check for auto-approval (both approver lists empty)
      IF et_l1_approvers IS INITIAL AND et_l2_approvers IS INITIAL.
        ev_auto = 'X'.
      ELSE.
        CLEAR ev_auto.
      ENDIF.

      rv_found = abap_true.
    ELSE.
      rv_found = abap_false.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_A2R_WBS_BUILDER->SUBMIT_REQUEST
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEADER                      TYPE        ZTB_A2R_WBSHDR
* | [--->] IT_WBS_ITEMS                   TYPE        STANDARD TABLE
* | [<-()] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD submit_request.

    DATA: lv_reqnum        TYPE char10,
          lv_appr1         TYPE char8,
          lv_appr2         TYPE char8,
          lv_auto          TYPE char1,
          lv_error_handler TYPE char8,
          lv_found         TYPE abap_bool,
          ls_header        TYPE ztb_a2r_wbshdr,
          lt_l1_approvers  TYPE hpa_t_bname,
          lt_l2_approvers  TYPE hpa_t_bname.

    rv_success = abap_false.

    " Step 1: Save the request
    lv_reqnum = save_request(
      is_header    = is_header
      it_wbs_items = it_wbs_items
    ).

    IF lv_reqnum IS INITIAL.
      MESSAGE e013(zcj00) WITH 'Error saving request'.
      RETURN.
    ENDIF.

    " Step 2: Get approvers from configuration and HRP1001
    lv_found = check_approver_matrix(
      EXPORTING
        iv_bukrs   = is_header-bukrs
        iv_profl   = is_header-profl
        iv_reqtype = is_header-z_reqtype
      IMPORTING
        ev_appr1         = lv_appr1
        ev_appr2         = lv_appr2
        ev_auto          = lv_auto
        ev_error_handler = lv_error_handler
        et_l1_approvers  = lt_l1_approvers
        et_l2_approvers  = lt_l2_approvers
    ).

    IF lv_found = abap_false.
      MESSAGE e008(zcj00) WITH 'No approver configuration found'.
      rv_success = abap_false.
      RETURN.
    ENDIF.

    " Step 3: Update header
    ls_header = is_header.
    ls_header-zreq_num = lv_reqnum.
    ls_header-request_status = 'PENDING'.

    UPDATE ztb_a2r_wbshdr
      SET request_status = 'PENDING'
      WHERE zreq_num = lv_reqnum.

    " Step 4: Auto-approval or Workflow
    IF lv_auto = 'X'.
      " Auto-approve if no approvers configured
      MESSAGE i035(zcj00) WITH 'Request' lv_reqnum 'auto-approved'.

      rv_success = create_project(
        is_header    = ls_header
        it_wbs_items = it_wbs_items
      ).

      IF rv_success = abap_true.
        UPDATE ztb_a2r_wbshdr
          SET request_status = 'APPROVED'
              zapproved_by = sy-uname
              zrequest_approved_on = sy-datum
          WHERE zreq_num = lv_reqnum.
        COMMIT WORK.
        MESSAGE s033(zcj00) WITH 'Request' lv_reqnum 'approved'.
      ELSE.
        UPDATE ztb_a2r_wbshdr
          SET request_status = 'ERROR'
          WHERE zreq_num = lv_reqnum.
        COMMIT WORK.
        MESSAGE e034(zcj00) WITH 'Error for request' lv_reqnum.
      ENDIF.

    ELSE.
      " Trigger workflow with approver lists
      rv_success = trigger_workflow(
        is_header   = ls_header
        it_l1_apprv = lt_l1_approvers
        it_l2_apprv = lt_l2_approvers
      ).

      IF rv_success = abap_true.
        COMMIT WORK.
        MESSAGE s015(zcj00) WITH 'Request' lv_reqnum 'submitted'.
      ELSE.
        ROLLBACK WORK.
        MESSAGE e016(zcj00) WITH 'Workflow error for' lv_reqnum.
      ENDIF.
    ENDIF.

  ENDMETHOD.

