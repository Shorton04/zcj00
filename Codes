*----------------------------------------------------------------------*
* Tree Control Objects for Preview (Screen 200)
*----------------------------------------------------------------------*
DATA: lo_cont_preview TYPE REF TO cl_gui_custom_container,
      lo_tree_preview TYPE REF TO cl_gui_column_tree,
      lv_tree_loaded  TYPE abap_bool.

*----------------------------------------------------------------------*
* Tree Control Data Structures (matching reference system)
*----------------------------------------------------------------------*
DATA: lt_treeitm_u              TYPE cnpb_h_t_treeitm_upd,
      lt_treev_node_u           TYPE treev_upno,
      ls_hierarchy_header       TYPE treev_hhdr,
      gt_treev_node             TYPE cnpb_h_t_treev_node,
      gt_treeitm                TYPE TABLE OF cnpb_h_treeitm,
      ls_objects_in_hierarchy   TYPE cnpb_h_objects_in_hierarchy,
      gs_objects_in_tree        TYPE cnpb_h_objects_in_hierarchy.

*----------------------------------------------------------------------*
* Additional Tree Variables
*----------------------------------------------------------------------*
DATA: lv_enqueue          TYPE char1,
      lv_drag_drop_handle TYPE i,
      lv_hier_col_is_key  TYPE char1.

*----------------------------------------------------------------------*
* Constants for Tree
*----------------------------------------------------------------------*
CONSTANTS: lc_hierarchy_short_text    TYPE char12 VALUE 'SHORT_TEXT',
           lc_hierarchy_technical_key TYPE char12 VALUE 'TECHN_KEY'.

*----------------------------------------------------------------------*
* Custom Container Name
*----------------------------------------------------------------------*
CONSTANTS: gc_tree_container TYPE scrfname VALUE 'CC_TREE_PREVIEW'.

*----------------------------------------------------------------------*
* Tracking Variables
*----------------------------------------------------------------------*
DATA: gv_posnr_old TYPE im_posnr,
      gv_pspid_old TYPE ps_pspid.




*&---------------------------------------------------------------------*
*& Form FREE_TREE_CONTROL
*&---------------------------------------------------------------------*
FORM free_tree_control.

  " Clear hierarchy cache
  CALL FUNCTION 'CNPB_H_PROJ_HIER_REFRESH'.

  " Free tree control
  IF lo_tree_preview IS NOT INITIAL.
    CALL METHOD lo_tree_preview->free
      EXCEPTIONS
        cntl_error        = 1
        cntl_system_error = 2
        OTHERS            = 3.
    FREE lo_tree_preview.
    CLEAR lo_tree_preview.
  ENDIF.

  " Free container
  IF lo_cont_preview IS NOT INITIAL.
    CALL METHOD lo_cont_preview->free
      EXCEPTIONS
        cntl_error        = 1
        cntl_system_error = 2
        OTHERS            = 3.
    FREE lo_cont_preview.
    CLEAR lo_cont_preview.
  ENDIF.

  " Clear all tree-related data
  lv_tree_loaded = abap_false.
  CLEAR: gt_treev_node, 
         gt_treeitm, 
         lt_treev_node_u, 
         lt_treeitm_u,
         ls_hierarchy_header,
         ls_objects_in_hierarchy,
         gs_objects_in_tree.

ENDFORM.
