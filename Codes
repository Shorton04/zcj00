METHOD check_approver_matrix.

  DATA: ls_config  TYPE ztb_a2r_conftab2,
        lt_hrp1001 TYPE TABLE OF hrp1001,
        ls_hrp1001 TYPE hrp1001,
        lv_uname   TYPE xubname.

  CLEAR: ev_appr1, ev_appr2, ev_auto, ev_error_handler, 
         et_l1_approvers, et_l2_approvers.

  " ★ Get approver configuration from ZTB_A2R_CONFTAB2
  " Based on Image 2: CoCode (BUKRS), Proj.Prof. (PROFL), Req Type
  SELECT SINGLE * FROM ztb_a2r_conftab2
    INTO ls_config
    WHERE bukrs = iv_bukrs          " Company Code (ZX99 in image)
      AND profl = iv_profl          " Project Profile (ZPC0001 in image)
      AND z_reqtype = iv_reqtype.   " Request Type (A1 in image)

  IF sy-subrc <> 0.
    " No configuration found
    rv_found = abap_false.
    RETURN.
  ENDIF.

  " ★ Store approver positions and error handler
  " From Image 2: Approval 1 = 30000, Approval 2 = 30001
  ev_appr1 = ls_config-zaproval_1.          " Level 1 approver position
  ev_appr2 = ls_config-zaproval_2.          " Level 2 approver position
  ev_error_handler = ls_config-zerror_handling.  " Error handler position

  " ★★★ LEVEL 1 APPROVERS ★★★
  " Get users assigned to Level 1 approver position from HRP1001
  IF ev_appr1 IS NOT INITIAL.
    CLEAR lt_hrp1001.
    
    " From Image 1: Query HRP1001 where OBJID = 30000, SCLAS = 'US'
    SELECT * FROM hrp1001
      INTO TABLE lt_hrp1001
      WHERE objid = ev_appr1        " Position ID (e.g., 30000)
        AND otype = 'S'             " Object type = Position/Org unit
        AND plvar = '01'            " Plan version = Current
        AND rsign = 'A'             " Relationship sign = A
        AND relat = '008'           " Relationship = User assignment
        AND sclas = 'US'            " Object class = User (SOBID contains username)
        AND endda >= sy-datum       " Valid to date >= today
        AND begda <= sy-datum.      " Valid from date <= today

    IF sy-subrc = 0.
      LOOP AT lt_hrp1001 INTO ls_hrp1001.
        " ★ Extract username from SOBID
        " From Image 1: SOBID format can be:
        " - 'USRG33000' (with US prefix) → extract 'USRG33000'
        " - 'EV92123' (without prefix) → use as-is
        lv_uname = ls_hrp1001-sobid.
        
        " Remove 'US' prefix if present (first 2 characters)
        IF lv_uname(2) = 'US'.
          lv_uname = lv_uname+2.  " Skip first 2 chars
        ENDIF.
        
        " Add to Level 1 approver list
        APPEND lv_uname TO et_l1_approvers.
      ENDLOOP.
    ENDIF.
  ENDIF.

  " ★★★ LEVEL 2 APPROVERS ★★★
  " Get users assigned to Level 2 approver position from HRP1001
  IF ev_appr2 IS NOT INITIAL.
    CLEAR lt_hrp1001.
    
    " From Image 1: Query HRP1001 where OBJID = 30001, SCLAS = 'US'
    SELECT * FROM hrp1001
      INTO TABLE lt_hrp1001
      WHERE objid = ev_appr2        " Position ID (e.g., 30001)
        AND otype = 'S'
        AND plvar = '01'
        AND rsign = 'A'
        AND relat = '008'
        AND sclas = 'US'
        AND endda >= sy-datum
        AND begda <= sy-datum.

    IF sy-subrc = 0.
      LOOP AT lt_hrp1001 INTO ls_hrp1001.
        lv_uname = ls_hrp1001-sobid.
        
        " Remove 'US' prefix if present
        IF lv_uname(2) = 'US'.
          lv_uname = lv_uname+2.
        ENDIF.
        
        " Add to Level 2 approver list
        APPEND lv_uname TO et_l2_approvers.
      ENDLOOP.
    ENDIF.
  ENDIF.

  " ★★★ AUTO-APPROVAL LOGIC ★★★
  " If BOTH approver lists are empty, mark as auto-approval
  IF et_l1_approvers IS INITIAL AND et_l2_approvers IS INITIAL.
    ev_auto = 'X'.
  ELSE.
    CLEAR ev_auto.
  ENDIF.

  rv_found = abap_true.

ENDMETHOD.




METHOD submit_request.

  DATA: lv_reqnum        TYPE char10,
        lv_appr1         TYPE char8,
        lv_appr2         TYPE char8,
        lv_auto          TYPE char1,
        lv_error_handler TYPE char8,
        lv_found         TYPE abap_bool,
        ls_header        TYPE ztb_a2r_wbshdr,
        lt_l1_approvers  TYPE hpa_t_bname,    " ★ Will hold L1 usernames
        lt_l2_approvers  TYPE hpa_t_bname.    " ★ Will hold L2 usernames

  rv_success = abap_false.

  " ★ Step 1: Save the request (get request number)
  lv_reqnum = save_request(
    is_header    = is_header
    it_wbs_items = it_wbs_items
  ).

  IF lv_reqnum IS INITIAL.
    MESSAGE e013(zcj00) WITH 'Error saving request'.
    RETURN.
  ENDIF.

  " ★ Step 2: Get approvers from config + HRP1001
  lv_found = check_approver_matrix(
    EXPORTING
      iv_bukrs   = is_header-bukrs      " ZX99
      iv_profl   = is_header-profl      " ZPC0001
      iv_reqtype = is_header-z_reqtype  " A1
    IMPORTING
      ev_appr1         = lv_appr1             " Position 30000
      ev_appr2         = lv_appr2             " Position 30001
      ev_auto          = lv_auto              " 'X' if no approvers
      ev_error_handler = lv_error_handler
      et_l1_approvers  = lt_l1_approvers      " ★ Usernames from HRP1001
      et_l2_approvers  = lt_l2_approvers      " ★ Usernames from HRP1001
  ).

  IF lv_found = abap_false.
    MESSAGE e008(zcj00) WITH 'No approver configuration found'.
    RETURN.
  ENDIF.

  " ★ Step 3: Update header with pending status
  ls_header = is_header.
  ls_header-zreq_num = lv_reqnum.
  ls_header-request_status = 'PENDING'.

  UPDATE ztb_a2r_wbshdr
    SET request_status = 'PENDING'
    WHERE zreq_num = lv_reqnum.

  " ★ Step 4: Auto-approval or Workflow
  IF lv_auto = 'X'.
    " ★ AUTO-APPROVE: No approvers configured
    MESSAGE i035(zcj00) WITH 'Request' lv_reqnum 'auto-approved'.

    rv_success = create_project(
      is_header    = ls_header
      it_wbs_items = it_wbs_items
    ).

    IF rv_success = abap_true.
      UPDATE ztb_a2r_wbshdr
        SET request_status = 'APPROVED'
            zapproved_by = sy-uname
            zrequest_approved_on = sy-datum
        WHERE zreq_num = lv_reqnum.
      COMMIT WORK.
      MESSAGE s033(zcj00) WITH 'Request' lv_reqnum 'approved'.
    ELSE.
      UPDATE ztb_a2r_wbshdr
        SET request_status = 'ERROR'
        WHERE zreq_num = lv_reqnum.
      COMMIT WORK.
      MESSAGE e034(zcj00) WITH 'Error for request' lv_reqnum.
    ENDIF.

  ELSE.
    " ★★★ TRIGGER WORKFLOW WITH APPROVER LISTS ★★★
    rv_success = trigger_workflow(
      is_header   = ls_header
      it_l1_apprv = lt_l1_approvers    " ★ Pass L1 usernames
      it_l2_apprv = lt_l2_approvers    " ★ Pass L2 usernames
    ).

    IF rv_success = abap_true.
      COMMIT WORK.
      MESSAGE s015(zcj00) WITH 'Request' lv_reqnum 'submitted'.
    ELSE.
      ROLLBACK WORK.
      MESSAGE e016(zcj00) WITH 'Workflow error for' lv_reqnum.
    ENDIF.
  ENDIF.

ENDMETHOD.






METHOD copy_template_structure.

  DATA: lt_prpss TYPE TABLE OF prpss,
        ls_prpss TYPE prpss,
        ls_wbs   TYPE ztb_a2r_wbsitem,
        lv_pspnr TYPE ps_pspnr.

  " Get project internal number from template PSPID
  SELECT SINGLE pspnr FROM projs
    INTO lv_pspnr
    WHERE pspid = iv_pspid.

  IF sy-subrc <> 0.
    " Fallback to PROJ
    SELECT SINGLE pspnr FROM proj
      INTO lv_pspnr
      WHERE pspid = iv_pspid.
  ENDIF.

  IF sy-subrc = 0.
    " Get all WBS elements using PRPSS
    SELECT * FROM prpss
      INTO TABLE lt_prpss
      WHERE psphi = lv_pspnr
      ORDER BY stufe posid.

    IF sy-subrc = 0.
      LOOP AT lt_prpss INTO ls_prpss.
        CLEAR ls_wbs.

        ls_wbs-stufe = ls_prpss-stufe.
        ls_wbs-posid = ls_prpss-posid.
        ls_wbs-post1 = ls_prpss-post1.
        ls_wbs-posnr = ls_prpss-pspnr.    " PSPNR = internal WBS number
        ls_wbs-kostl = iv_kostl.          " Inherit from header
        ls_wbs-imprf = ls_prpss-imprf.
        ls_wbs-prart = ls_prpss-prart.
        
        " ★★★ FIX: Get Company Code from template WBS (PRPSS-PBUKR) ★★★
        ls_wbs-bukrs = ls_prpss-pbukr.    " PBUKR = Company Code in WBS

        APPEND ls_wbs TO ct_wbs_items.
      ENDLOOP.
    ENDIF.
  ENDIF.

ENDMETHOD.





FORM load_template_to_wbs_items USING iv_pspid TYPE ps_pspid
                                       iv_kostl TYPE kostl.

  DATA: lv_pspnr_templ TYPE ps_pspnr,
        lt_prpss_all   TYPE TABLE OF prpss,
        lt_prpss_level TYPE TABLE OF prpss,
        ls_prpss       TYPE prpss,
        lt_pspnr_list  TYPE TABLE OF ps_pspnr,
        lv_level       TYPE i,
        lv_max_levels  TYPE i VALUE 10.

  FIELD-SYMBOLS: <fs_prpss> TYPE prpss.

  REFRESH gt_wbs_items.

  " Get template pspnr
  SELECT SINGLE pspnr FROM projs
    INTO lv_pspnr_templ
    WHERE pspid = iv_pspid.

  IF sy-subrc <> 0.
    SELECT SINGLE pspnr FROM proj
      INTO lv_pspnr_templ
      WHERE pspid = iv_pspid.
  ENDIF.

  CHECK sy-subrc = 0.

  " Get all WBS elements recursively
  SELECT * FROM prpss
    INTO TABLE lt_prpss_all
    WHERE psphi = lv_pspnr_templ
    ORDER BY stufe posid.

  CHECK sy-subrc = 0.

  " Recursive fetch for children
  lv_level = 1.
  WHILE lv_level < lv_max_levels.

    CLEAR lt_pspnr_list.
    LOOP AT lt_prpss_all ASSIGNING <fs_prpss>.
      APPEND <fs_prpss>-pspnr TO lt_pspnr_list.
    ENDLOOP.

    IF lt_pspnr_list IS INITIAL.
      EXIT.
    ENDIF.

    CLEAR lt_prpss_level.
    SELECT * FROM prpss
      INTO TABLE lt_prpss_level
      FOR ALL ENTRIES IN lt_pspnr_list
      WHERE psphi = lt_pspnr_list-table_line.

    IF sy-subrc <> 0.
      EXIT.
    ENDIF.

    APPEND LINES OF lt_prpss_level TO lt_prpss_all.
    lv_level = lv_level + 1.

  ENDWHILE.

  SORT lt_prpss_all BY stufe posid.

  " Convert prpss to wbs items structure
  LOOP AT lt_prpss_all INTO ls_prpss.
    CLEAR gs_wbs_item.

    " Field mappings
    gs_wbs_item-stufe = ls_prpss-stufe.
    gs_wbs_item-posid = ls_prpss-posid.
    gs_wbs_item-post1 = ls_prpss-post1.
    gs_wbs_item-posnr = ls_prpss-pspnr.        " Internal number

    " ★★★ FIX: Get Company Code from template (PRPSS-PBUKR) ★★★
    gs_wbs_item-bukrs = ls_prpss-pbukr.        " Company Code from template WBS
    
    gs_wbs_item-kostl = iv_kostl.              " Cost Center from header
    gs_wbs_item-werks = gv_werks.              " Plant from header (IMPR)

    " Template properties
    gs_wbs_item-imprf = ls_prpss-imprf.
    gs_wbs_item-prart = ls_prpss-prart.

    " Initialize budget fields
    gs_wbs_item-wert2 = 0.                     " Budget - user will fill
    gs_wbs_item-zbudget_check = space.

    APPEND gs_wbs_item TO gt_wbs_items.

  ENDLOOP.

ENDFORM.




FORM get_im_data USING iv_posnr TYPE im_posnr.

  DATA: ls_impr TYPE impr.

  " Validate posnr exists and get data
  SELECT SINGLE * FROM impr
    INTO ls_impr
    WHERE posnr = iv_posnr.

  IF sy-subrc = 0.

    " FDS Table 4.1 Row 5: Get IM Program (PRNAM)
    p_prnam = ls_impr-prnam.

    " FDS Table 4.1 Row 6: Get Approval Year (GJAHR)
    p_gjahr = ls_impr-gjahr.

    " FDS Table 4.1 Row 10: Get Profit Center (PRCTR)
    p_prctr = ls_impr-prctr.

    " FDS Table 4.1 Row 11: Get Cost Center (KOSTL)
    p_kostl = ls_impr-kostl.

    " ★★★ CHANGE: Store BUKRS for validation ONLY, not for WBS ★★★
    " WBS BUKRS will come from template (PRPSS-PBUKR)
    gv_bukrs = ls_impr-bukrs.        " Used for validation/approver matrix
    gv_werks = ls_impr-werks.        " Plant
    gv_izwek = ls_impr-izwek.        " Investment Reason
    gv_usr008 = ls_impr-usr08.       " CAR Approval Date

    " Get Project Profile and Template from config
    PERFORM get_profile_template USING ls_impr-izwek
                                 CHANGING p_profl p_pspid.

    " Check GE Ariba flag
    PERFORM check_ge_ariba USING ls_impr CHANGING p_usr10.

    " Set finish date for lumpsum
    IF ls_impr-izwek = 'LS'.
      p_plsez = sy-datum.
      p_plsez+4(4) = '1231'.
    ENDIF.

  ELSE.
    MESSAGE e002 WITH iv_posnr.
  ENDIF.

ENDFORM.





FORM prepare_screen2.

  " Get additional IM data (for validation and header only)
  PERFORM get_additional_im_data USING p_posnr.

  " ★★★ IMPORTANT: Copy template structure FIRST ★★★
  " This will populate BUKRS from PRPSS-PBUKR
  CALL METHOD go_builder->copy_template_structure
    EXPORTING
      iv_pspid     = p_pspid
      iv_kostl     = p_kostl
    CHANGING
      ct_wbs_items = gt_wbs_items.

  " Alternative: Use the form instead
  " PERFORM load_template_to_wbs_items USING p_pspid p_kostl.

  " Convert to display format
  PERFORM convert_to_display.

  " Set default values
  PERFORM set_wbs_default_values.

  " Populate header (BUKRS in header still comes from IMPR for validation)
  PERFORM populate_header_structure.

ENDFORM.





FORM populate_header_structure.

  CLEAR gs_header.

  " IM Data
  gs_header-posnr = p_posnr.
  gs_header-prnam = p_prnam.
  gs_header-post1 = p_post1.
  gs_header-vernr = p_verna.
  gs_header-plsez = p_plsez.
  gs_header-erdat = sy-datum.

  " ★★★ IMPORTANT: Header BUKRS vs WBS BUKRS ★★★
  " Header BUKRS: From IMPR (for approver matrix and validation)
  gs_header-bukrs = gv_bukrs.        " IMPR-BUKRS
  
  " ★★★ NOTE: Individual WBS items may have DIFFERENT BUKRS ★★★
  " Each WBS item's BUKRS comes from PRPSS-PBUKR (template)
  " This allows multi-company projects if needed

  gs_header-werks = gv_werks.
  gs_header-prctr = p_prctr.
  gs_header-kostl = p_kostl.
  gs_header-izwek = gv_izwek.
  gs_header-profl = p_profl.
  gs_header-zunifier_proj = p_usr10.
  gs_header-usr008 = gv_usr008.
  gs_header-ernam = sy-uname.
  gs_header-z_reqtype = gv_request_type.
  gs_header-z_remarks = gv_z_remarks.

ENDFORM.




