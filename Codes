* Display-Only Fields (Screen 2)
*----------------------------------------------------------------------*
DATA: gv_requestor_display TYPE char50,      " Full name of requestor
      gv_reqtype_display   TYPE char20,      " Request type description
      gv_posnr_display     TYPE im_posid.    " IM POSNR (external format)





MODULE set_header_display_values OUTPUT.

  DATA: lv_fullname     TYPE char50,
        lv_reqtype_text TYPE char20,
        lv_im_posid     TYPE im_posid.

  " Convert username to full name
  IF gs_header-ernam IS NOT INITIAL.
    PERFORM get_user_fullname 
      USING    gs_header-ernam
      CHANGING lv_fullname.
    gv_requestor_display = lv_fullname.
  ELSE.
    gv_requestor_display = sy-uname.
  ENDIF.

  " Convert request type code to description
  IF gs_header-z_reqtype IS NOT INITIAL.
    PERFORM get_request_type_text
      USING    gs_header-z_reqtype
      CHANGING lv_reqtype_text.
    gv_reqtype_display = lv_reqtype_text.
  ELSE.
    gv_reqtype_display = 'Create'.
  ENDIF.

  " ★ Convert POSNR to external POSID (3 → PR01)
  IF gs_header-posnr IS NOT INITIAL.
    SELECT SINGLE posid
      FROM impr
      INTO lv_im_posid
      WHERE posnr = gs_header-posnr.
    
    IF sy-subrc = 0 AND lv_im_posid IS NOT INITIAL.
      gv_posnr_display = lv_im_posid.
    ELSE.
      gv_posnr_display = gs_header-posnr.  " Fallback
    ENDIF.
  ELSE.
    CLEAR gv_posnr_display.
  ENDIF.

ENDMODULE.




