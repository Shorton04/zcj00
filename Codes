- FDS says: “Selected by user”
- Show both POSID (user-friendly) and POSNR in dropdown
  *&———————————————————————*
  FORM f4_im_number CHANGING cv_posnr TYPE im_posnr.
  
  TYPES: BEGIN OF ty_im_display,
  posid TYPE im_posid,
  posnr TYPE im_posnr,
  prnam TYPE im_prnam,
  gjahr TYPE im_gnjhr,
  END OF ty_im_display.
  
  DATA: lt_impr   TYPE TABLE OF ty_im_display,
  lt_return TYPE TABLE OF ddshretval,
  ls_return TYPE ddshretval.
  
  “ Get IM positions with config check
  SELECT i~posid i~posnr i~prnam i~gjahr
  FROM impr AS i
  INNER JOIN ztb_a2r_conftab1 AS c
  ON c~izwek = i~izwek
  INTO CORRESPONDING FIELDS OF TABLE lt_impr
  UP TO 500 ROWS
  ORDER BY i~posid DESCENDING.
  
  “ Display F4 help
  CALL FUNCTION ‘F4IF_INT_TABLE_VALUE_REQUEST’
  EXPORTING
  retfield        = ‘POSNR’
  dynpprog        = sy-repid
  dynpnr          = sy-dynnr
  dynprofield     = ‘P_POSNR’
  value_org       = ‘S’
  window_title    = ‘Select IM Program Position’
  TABLES
  value_tab       = lt_impr
  return_tab      = lt_return
  EXCEPTIONS
  parameter_error = 1
  no_values_found = 2
  OTHERS          = 3.
  
  IF sy-subrc = 0.
  READ TABLE lt_return INTO ls_return INDEX 1.
  IF sy-subrc = 0.
  cv_posnr = ls_return-fieldval.
  ENDIF.
  ENDIF.

ENDFORM.

