*&---------------------------------------------------------------------*
*& Form LOAD_TREE_HIERARCHY
*&---------------------------------------------------------------------*
FORM load_tree_hierarchy.

  DATA: ls_proj           TYPE proj,
        lv_pspid_template TYPE ps_pspid.

  " Prerequisites check
  CHECK p_pspid IS NOT INITIAL.
  CHECK lo_tree_preview IS NOT INITIAL.

  TRY.
      " Clear previous data
      CLEAR: gt_treev_node, gt_treeitm, gs_objects_in_tree.

      " Refresh hierarchy cache (CRITICAL!)
      CALL FUNCTION 'CNPB_H_PROJ_HIER_REFRESH'.

      lv_pspid_template = p_pspid.

      " Get project template data - try PROJ first
      SELECT SINGLE * FROM proj INTO ls_proj
        WHERE pspid = lv_pspid_template.

      IF sy-subrc <> 0.
        " Try with conversion exit
        CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
          EXPORTING
            input  = lv_pspid_template
          IMPORTING
            output = lv_pspid_template.

        SELECT SINGLE * FROM proj INTO ls_proj
          WHERE pspid = lv_pspid_template.

        IF sy-subrc <> 0.
          MESSAGE 'Template project not found in PROJ table' TYPE 'S' DISPLAY LIKE 'W'.
          RETURN.
        ENDIF.
      ENDIF.

      " Set objects to display in hierarchy
      CLEAR ls_objects_in_hierarchy.
      ls_objects_in_hierarchy-proj = abap_true.
      ls_objects_in_hierarchy-prps = abap_true.
      ls_objects_in_hierarchy-pstx = abap_true.

      " Call SAP standard function to get project hierarchy
      CALL FUNCTION 'CNPB_H_PROJ_HIER_SELECT'
        EXPORTING
          i_objects_in_hierarchy = ls_objects_in_hierarchy
          i_vsnmr                = ''
          i_pspid                = lv_pspid_template
          i_aufnr                = ''
          i_flg_enqueue          = space
          i_expand_levels        = 06
        IMPORTING
          et_treeitm             = gt_treeitm
          et_treev_node          = gt_treev_node
          e_objects_in_hierarchy = gs_objects_in_tree
        EXCEPTIONS
          OTHERS                 = 1.

      IF sy-subrc <> 0 OR gt_treev_node IS INITIAL.
        MESSAGE 'Error loading project hierarchy' TYPE 'S' DISPLAY LIKE 'W'.
        RETURN.
      ENDIF.

      " Delete existing nodes before adding new ones
      CALL METHOD lo_tree_preview->delete_all_nodes.

      " Set hierarchy header
      CALL METHOD lo_tree_preview->hierarchy_header_set_text
        EXPORTING
          text = 'Project Structure: Description'.

      " Add nodes and items to tree
      CALL METHOD lo_tree_preview->add_nodes_and_items
        EXPORTING
          node_table                = gt_treev_node
          item_table                = gt_treeitm
          item_table_structure_name = 'CNPB_H_TREEITM'.

      " Expand root nodes
      CALL METHOD lo_tree_preview->expand_root_nodes
        EXPORTING
          level_count    = 0
          expand_subtree = space.

      " Set column widths
      CALL METHOD lo_tree_preview->hierarchy_header_set_width
        EXPORTING
          width     = 40
          width_pix = space.

      CALL METHOD lo_tree_preview->column_set_width
        EXPORTING
          column_name = lc_hierarchy_technical_key
          width       = 21
          width_pix   = space.

      " Flush to frontend (CRITICAL!)
      CALL METHOD cl_gui_cfw=>flush.

      lv_tree_loaded = abap_true.

    CATCH cx_root INTO DATA(lx_error).
      MESSAGE lx_error->get_text( ) TYPE 'S' DISPLAY LIKE 'E'.
  ENDTRY.

ENDFORM.
