*&---------------------------------------------------------------------*
*& Module SET_TABLE_FIELD_ATTRIBUTES OUTPUT
*&---------------------------------------------------------------------*
MODULE set_table_field_attributes OUTPUT.

  DATA: lv_read_only TYPE abap_bool.

  " Determine if entire row should be read-only
  " (e.g., for approved requests or specific statuses)
  IF gs_header-request_status = 'APPROVED'
  OR gs_header-request_status = 'REJECTED'.
    lv_read_only = abap_true.
  ENDIF.

  LOOP AT SCREEN.
    
    " ★ ALWAYS GRAYED OUT (Template-derived fields)
    IF screen-name = 'GS_WBS_DISPLAY-STUFE'        " Level - from template
    OR screen-name = 'GS_WBS_DISPLAY-POSID'        " WBS Code - from template
    OR screen-name = 'GS_WBS_DISPLAY-POSNR'        " Internal number
    OR screen-name = 'GS_WBS_DISPLAY-BUKRS'        " Company Code - from header
    OR screen-name = 'GS_WBS_DISPLAY-IMPRF'        " Investment Profile - from template
    OR screen-name = 'GS_WBS_DISPLAY-PRART'.       " Project Type - from template
    
      screen-input = 0.
      screen-intensified = 0.
      MODIFY SCREEN.
    ENDIF.
    
    " ★ CONDITIONALLY EDITABLE (based on level and status)
    
    " Description: Editable for Level 2/3, grayed for Level 1
    IF screen-name = 'GS_WBS_DISPLAY-POST1'.
      IF gs_wbs_display-stufe = 1 OR lv_read_only = abap_true.
        screen-input = 0.
        screen-intensified = 0.
        MODIFY SCREEN.
      ENDIF.
    ENDIF.
    
    " Budget fields: Editable only in DRAFT status
    IF screen-name = 'GS_WBS_DISPLAY-ZAPPROVED_BUDG'
    OR screen-name = 'GS_WBS_DISPLAY-ZBUDGET_CHECK'.
      IF lv_read_only = abap_true.
        screen-input = 0.
        screen-intensified = 0.
        MODIFY SCREEN.
      ENDIF.
    ENDIF.
    
    " Cost Center: Always editable (can be changed per WBS)
    " No restriction needed
    
  ENDLOOP.

ENDMODULE.




PROCESS BEFORE OUTPUT.
  MODULE status_0100.
  MODULE set_header_display_values.
  
  " Table control modules
  LOOP AT gt_wbs_display INTO gs_wbs_display 
       WITH CONTROL tc_wbs CURSOR tc_wbs-current_line.
    MODULE tc_wbs_get_lines.
    MODULE set_table_field_attributes.   " ← Add this line
  ENDLOOP.
