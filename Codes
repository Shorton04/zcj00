*&---------------------------------------------------------------------*
*& Form VALIDATE_COST_CENTER
*&---------------------------------------------------------------------*
FORM validate_cost_center USING iv_kokrs TYPE kokrs
      iv_kostl TYPE kostl
      iv_plsez TYPE ps_plsez_chg
CHANGING cv_error TYPE abap_bool.

  DATA: ls_csks TYPE csks.

  " Check cost center validity against Finish Date
  SELECT SINGLE * FROM csks
  INTO ls_csks
  WHERE kostl = iv_kostl
  AND kokrs = iv_kokrs
  AND datab <= iv_plsez
  AND datbi >= iv_plsez.

  IF sy-subrc = 0.
    CLEAR cv_error.
  ELSE.
    MESSAGE e005 WITH iv_kostl iv_plsez.
    cv_error = gc_x.
  ENDIF.
ENDFORM.


