METHOD create_wbs_elements.

  "-------------------------
  "  Declarations
  "-------------------------
  DATA: lv_pspid         TYPE ps_pspid,
        lv_currency      TYPE waers,
        lt_return        TYPE TABLE OF bapiret2,
        ls_return        TYPE bapiret2,
        lv_counter       TYPE i,
        lt_wbs_element   TYPE TABLE OF bapi_wbs_element,
        ls_wbs_element   TYPE bapi_wbs_element,
        lt_items_sorted  TYPE TABLE OF ztb_a2r_wbsitem,
        ls_item          TYPE ztb_a2r_wbsitem,
        ls_created       TYPE ztb_a2r_wbsitem.

  DATA: ls_proj_new TYPE bapi_bus2001_new.

  " Stack (by level) to remember last-created external POSID per level
  TYPES: BEGIN OF ty_level_anchor,
           level TYPE ps_stufe,
           posid TYPE ps_posid,
         END OF ty_level_anchor.
  DATA: lt_level_anchor TYPE SORTED TABLE OF ty_level_anchor
                         WITH UNIQUE KEY level,
        ls_level_anchor TYPE ty_level_anchor.

  rv_success = abap_false.
  CLEAR et_wbs_created.

  "-------------------------
  "  Determine project number & currency
  "-------------------------
  lv_pspid = get_next_project_number( is_header-profl ).
  IF lv_pspid IS INITIAL.
    MESSAGE e029(zcj00).
    RETURN.
  ENDIF.

  lv_currency = COND waers(
                   WHEN is_header-pwhie IS NOT INITIAL THEN is_header-pwhie
                   ELSE 'USD' ).

  "-------------------------
  "  Initialize PS buffers
  "-------------------------
  CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

  "-------------------------
  "  Build Project Definition structure
  "-------------------------
  CLEAR ls_proj_new.
  ls_proj_new-project_definition   = lv_pspid.
  ls_proj_new-description          = is_header-post1.
  ls_proj_new-start                = sy-datum.
  ls_proj_new-finish               = is_header-plsez.
  ls_proj_new-company_code         = is_header-bukrs.
  ls_proj_new-plant                = is_header-werks.
  ls_proj_new-profit_ctr           = is_header-prctr.
  ls_proj_new-responsible_no       = is_header-vernr.
  ls_proj_new-project_currency     = lv_currency.
  ls_proj_new-project_profile      = is_header-profl.

  CLEAR lt_return.
  CALL FUNCTION 'BAPI_BUS2001_CREATE'
    EXPORTING
      i_project_definition = ls_proj_new
    TABLES
      et_return            = lt_return.

  READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
  IF sy-subrc = 0.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
      WITH ls_return-message_v1 ls_return-message_v2 ls_return-message_v3 ls_return-message_v4.
    RETURN.
  ENDIF.

  READ TABLE lt_return INTO ls_return WITH KEY type = 'A'.
  IF sy-subrc = 0.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
      WITH ls_return-message_v1 ls_return-message_v2 ls_return-message_v3 ls_return-message_v4.
    RETURN.
  ENDIF.

  "-------------------------
  "  Prepare WBS items (bulk)
  "  Strategy:
  "   - Sort by level ascending
  "   - Level=1 → external POSID = project id
  "   - Level>1 → POSID = <project>-<counter>, parent via last anchor of (level-1)
  "   - Skip items with WERT2 initial (as per your original logic)
  "-------------------------
  lt_items_sorted = it_wbs_items.
  SORT lt_items_sorted BY stufe ASCENDING.

  CLEAR: lt_wbs_element, lt_level_anchor.
  lv_counter = 1.

  LOOP AT lt_items_sorted INTO ls_item.

    IF ls_item-wert2 IS INITIAL.
      CONTINUE.
    ENDIF.

    CLEAR ls_wbs_element.

    " External WBS ID
    IF ls_item-stufe = 1.
      ls_wbs_element-wbs_element = lv_pspid.   " top-level WBS id == project id
    ELSE.
      ls_wbs_element-wbs_element = |{ lv_pspid }-{ lv_counter }|.
      lv_counter += 1.
    ENDIF.

    " Text & org/costing basics
    ls_wbs_element-description                 = ls_item-post1.
    ls_wbs_element-company_code                = is_header-bukrs.
    ls_wbs_element-plant                       = is_header-werks.
    ls_wbs_element-profit_ctr                  = is_header-prctr.
    ls_wbs_element-respsbl_cctr                = ls_item-kostl.
    ls_wbs_element-wbs_planning_element        = abap_true.

    " Parent linkage (WBS_UP)
    IF ls_item-stufe > 1.
      READ TABLE lt_level_anchor INTO ls_level_anchor
           WITH KEY level = ls_item-stufe - 1.
      IF sy-subrc = 0 AND ls_level_anchor-posid IS NOT INITIAL.
        ls_wbs_element-wbs_up = ls_level_anchor-posid.
      ENDIF.
    ENDIF.

    APPEND ls_wbs_element TO lt_wbs_element.

    " Maintain/refresh current anchor at this level
    ls_level_anchor-level = ls_item-stufe.
    ls_level_anchor-posid = ls_wbs_element-wbs_element.
    DELETE lt_level_anchor WHERE level = ls_level_anchor-level.
    INSERT ls_level_anchor INTO TABLE lt_level_anchor.

  ENDLOOP.

  " If nothing to create, just commit the project and exit
  IF lt_wbs_element IS INITIAL.
    " Precommit & commit the project
    CLEAR lt_return.
    CALL FUNCTION 'BAPI_PS_PRECOMMIT'
      TABLES
        et_return = lt_return.

    READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
    IF sy-subrc = 0.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
      MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
        WITH ls_return-message_v1 ls_return-message_v2 ls_return-message_v3 ls_return-message_v4.
      RETURN.
    ENDIF.

    READ TABLE lt_return INTO ls_return WITH KEY type = 'A'.
    IF sy-subrc = 0.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
      MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
        WITH ls_return-message_v1 ls_return-message_v2 ls_return-message_v3 ls_return-message_v4.
      RETURN.
    ENDIF.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = 'X'.

    rv_success = abap_true.
    RETURN.
  ENDIF.

  "-------------------------
  "  Create all WBS (bulk)
  "-------------------------
  CLEAR lt_return.
  CALL FUNCTION 'BAPI_BUS2054_CREATE_MULTI'
    EXPORTING
      i_project_definition = lv_pspid
    TABLES
      it_wbs_element       = lt_wbs_element
      et_return            = lt_return.

  READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
  IF sy-subrc = 0.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
      WITH ls_return-message_v1 ls_return-message_v2 ls_return-message_v3 ls_return-message_v4.
    RETURN.
  ENDIF.

  READ TABLE lt_return INTO ls_return WITH KEY type = 'A'.
  IF sy-subrc = 0.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
      WITH ls_return-message_v1 ls_return-message_v2 ls_return-message_v3 ls_return-message_v4.
    RETURN.
  ENDIF.

  "-------------------------
  "  Precommit (PS) then Commit
  "-------------------------
  CLEAR lt_return.
  CALL FUNCTION 'BAPI_PS_PRECOMMIT'
    TABLES
      et_return = lt_return.

  READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
  IF sy-subrc = 0.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
      WITH ls_return-message_v1 ls_return-message_v2 ls_return-message_v3 ls_return-message_v4.
    RETURN.
  ENDIF.

  READ TABLE lt_return INTO ls_return WITH KEY type = 'A'.
  IF sy-subrc = 0.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
      WITH ls_return-message_v1 ls_return-message_v2 ls_return-message_v3 ls_return-message_v4.
    RETURN.
  ENDIF.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.

  "-------------------------
  "  Build et_wbs_created with internal numbers (PRPS-PSPNR)
  "  Recompute the external POSID used during creation to read back PRPS
  "-------------------------
  LOOP AT lt_items_sorted INTO ls_item WHERE wert2 IS NOT INITIAL.

    CLEAR ls_created.
    ls_created-stufe          = ls_item-stufe.
    ls_created-post1          = ls_item-post1.
    ls_created-kostl          = ls_item-kostl.
    ls_created-wert2          = ls_item-wert2.
    ls_created-zbudget_check  = ls_item-zbudget_check.
    ls_created-imprf          = ls_item-imprf.
    ls_created-prart          = ls_item-prart.
    ls_created-bukrs          = is_header-bukrs.

    " External POSID reconstruction
    IF ls_item-stufe = 1.
      ls_created-posid = lv_pspid.
    ELSE.
      " Sequence of eligible (wert2 NOT INITIAL and stufe>1) items up to current
      DATA(lv_seq) = 0.
      DATA(ls_item2) = VALUE ztb_a2r_wbsitem( ).
      LOOP AT lt_items_sorted INTO ls_item2 WHERE wert2 IS NOT INITIAL AND stufe > 1.
        lv_seq += 1.
        IF ls_item2 = ls_item.
          EXIT.
        ENDIF.
      ENDLOOP.
      ls_created-posid = |{ lv_pspid }-{ lv_seq }|.
    ENDIF.

    " Read internal number (PRPS-PSPNR)
    SELECT SINGLE pspnr
      FROM prps
      INTO ls_created-posnr
      WHERE posid = ls_created-posid.

    APPEND ls_created TO et_wbs_created.

  ENDLOOP.

  rv_success = abap_true.

ENDMETHOD.
