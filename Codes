*& Form CONVERT_TO_DISPLAY - CORRECTED VERSION
*& Based on FDS Table 4.1.8 - ZTB_A2R_WBSITEM
*&———————————————————————*
FORM convert_to_display.

REFRESH gt_wbs_display.

LOOP AT gt_wbs_items INTO gs_wbs_item.
CLEAR gs_wbs_display.

```
" Map from internal table (ZTB_A2R_WBSITEM) to display table
gs_wbs_display-stufe = gs_wbs_item-stufe.              " WBS Level
gs_wbs_display-posid = gs_wbs_item-posid.              " WBS Element Code
gs_wbs_display-post1 = gs_wbs_item-post1.              " Description
gs_wbs_display-kostl = gs_wbs_item-kostl.              " Cost Center
gs_wbs_display-zapproved_budg = gs_wbs_item-wert2.     " Approved Budget (WERT2)
gs_wbs_display-zbudget_check = gs_wbs_item-zbudget_check.  " Budget Check
gs_wbs_display-imprf = gs_wbs_item-imprf.              " Investment Profile
gs_wbs_display-prart = gs_wbs_item-prart.              " Project Type
gs_wbs_display-bukrs = gs_wbs_item-bukrs.              " Company Code

" POSNR is internal number - may need to be populated
IF gs_wbs_item-posnr IS NOT INITIAL.
  gs_wbs_display-posnr = gs_wbs_item-posnr.
ENDIF.

APPEND gs_wbs_display TO gt_wbs_display.
```

ENDLOOP.

ENDFORM.

*&———————————————————————*
*& Form CONVERT_FROM_DISPLAY - CORRECTED VERSION
*& Based on FDS Table 4.1.8
*&———————————————————————*
FORM convert_from_display.

REFRESH gt_wbs_items.

LOOP AT gt_wbs_display INTO gs_wbs_display.
CLEAR gs_wbs_item.

```
" Map from display table to internal table (ZTB_A2R_WBSITEM)
gs_wbs_item-stufe = gs_wbs_display-stufe.
gs_wbs_item-posid = gs_wbs_display-posid.
gs_wbs_item-post1 = gs_wbs_display-post1.
gs_wbs_item-kostl = gs_wbs_display-kostl.
gs_wbs_item-wert2 = gs_wbs_display-zapproved_budg.      " Budget field is WERT2
gs_wbs_item-zbudget_check = gs_wbs_display-zbudget_check.
gs_wbs_item-imprf = gs_wbs_display-imprf.
gs_wbs_item-prart = gs_wbs_display-prart.
gs_wbs_item-bukrs = gv_bukrs.                            " From header

" Internal number if available
IF gs_wbs_display-posnr IS NOT INITIAL.
  gs_wbs_item-posnr = gs_wbs_display-posnr.
ENDIF.

APPEND gs_wbs_item TO gt_wbs_items.
```

ENDLOOP.

ENDFORM.

*&———————————————————————*
*& Form SET_WBS_DEFAULT_VALUES - CORRECTED VERSION
*& Based on FDS Table 4.1.6 - Field Mapping Rules
*&———————————————————————*
FORM set_wbs_default_values.

LOOP AT gt_wbs_display INTO gs_wbs_display.

```
" FDS Table 4.1.6: Cost Center inherited from header
gs_wbs_display-kostl = p_kostl.

" FDS Table 4.1.6: Budget Check activated by default if STUFE = 1
IF gs_wbs_display-stufe = 1.
  gs_wbs_display-zbudget_check = gc_x.
  " Level 1 description comes from header
  gs_wbs_display-post1 = p_post1.
ENDIF.

MODIFY gt_wbs_display FROM gs_wbs_display.
```

ENDLOOP.

ENDFORM.




