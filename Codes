METHOD copy_template_structure.

  DATA: lt_prps  TYPE TABLE OF prps,
        ls_prps  TYPE prps,
        ls_wbs   TYPE ztb_a2r_wbsitem,
        lv_pspnr TYPE ps_pspnr.  " ✅ Changed to PSPNR (internal number)

  " Get project internal number from template ID
  SELECT SINGLE pspnr FROM projs
    INTO lv_pspnr
    WHERE pspid = iv_pspid.

  IF sy-subrc <> 0.
    " Fallback to PROJ table
    SELECT SINGLE pspnr FROM proj
      INTO lv_pspnr
      WHERE pspid = iv_pspid.
  ENDIF.

  IF sy-subrc = 0.
    " Get all WBS elements from template
    SELECT * FROM prps
      INTO TABLE lt_prps
      WHERE psphi = lv_pspnr
      ORDER BY stufe posid.

    IF sy-subrc = 0.
      LOOP AT lt_prps INTO ls_prps.
        CLEAR ls_wbs.

        ls_wbs-stufe = ls_prps-stufe.
        ls_wbs-posid = ls_prps-posid.
        ls_wbs-post1 = ls_prps-post1.
        ls_wbs-posnr = ls_prps-pospnr.  " ✅ WBS internal number
        ls_wbs-kostl = iv_kostl.         " From header (FDS requirement)
        ls_wbs-imprf = ls_prps-imprf.
        ls_wbs-prart = ls_prps-prart.
        ls_wbs-bukrs = ls_prps-pbukr.
        
        " ✅ CRITICAL: Get budget from template
        " Budget should come from BPGE table for the template WBS
        PERFORM get_wbs_budget USING ls_prps-objnr
                              CHANGING ls_wbs-wert2.
        
        " ✅ Set budget check flag for Level 1
        IF ls_wbs-stufe = 1.
          ls_wbs-zbudget_check = 'X'.
        ENDIF.

        APPEND ls_wbs TO ct_wbs_items.
      ENDLOOP.
    ENDIF.
  ENDIF.

ENDMETHOD.




*&---------------------------------------------------------------------*
*& Form GET_WBS_BUDGET
*&---------------------------------------------------------------------*
*& Get budget value from BPGE table for WBS element
*&---------------------------------------------------------------------*
FORM get_wbs_budget USING iv_objnr TYPE j_objnr
                    CHANGING cv_budget TYPE bp_wert2.

  DATA: ls_bpge TYPE bpge.

  CLEAR cv_budget.

  " Get plan budget from BPGE (Budget Planning and Execution)
  SELECT SINGLE wlges
    FROM bpge
    INTO cv_budget
    WHERE objnr = iv_objnr
      AND versn = '0'      " Version 0 (current plan)
      AND wrttp = '01'.    " Value type: Plan

  " If no plan budget, try to get from BPJA (annual values)
  IF sy-subrc <> 0 OR cv_budget IS INITIAL.
    SELECT SINGLE wkgbtr
      FROM bpja
      INTO cv_budget
      WHERE objnr = iv_objnr
        AND versn = '0'
        AND wrttp = '01'
        AND gjahr = sy-datum(4).  " Current year
  ENDIF.

ENDFORM.





*&---------------------------------------------------------------------*
*& Form CONVERT_TO_DISPLAY
*&---------------------------------------------------------------------*
FORM convert_to_display.

  REFRESH gt_wbs_display.

  LOOP AT gt_wbs_items INTO gs_wbs_item.
    CLEAR gs_wbs_display.
    
    gs_wbs_display-stufe = gs_wbs_item-stufe.
    gs_wbs_display-posid = gs_wbs_item-posid.
    gs_wbs_display-post1 = gs_wbs_item-post1.
    gs_wbs_display-kostl = gs_wbs_item-kostl.
    gs_wbs_display-posnr = gs_wbs_item-posnr.
    gs_wbs_display-imprf = gs_wbs_item-imprf.
    gs_wbs_display-prart = gs_wbs_item-prart.
    gs_wbs_display-bukrs = gs_wbs_item-bukrs.
    gs_wbs_display-zbudget_check = gs_wbs_item-zbudget_check.
    
    " ✅ CRITICAL: Map budget field correctly
    gs_wbs_display-zapproved_budg = gs_wbs_item-wert2.
    
    " ✅ DEBUG: Add temporary write statement to verify
    " WRITE: / 'WBS:', gs_wbs_item-posid, 'Budget:', gs_wbs_item-wert2.
    
    APPEND gs_wbs_display TO gt_wbs_display.
  ENDLOOP.

  " ✅ DEBUG: Check if table is populated
  " DESCRIBE TABLE gt_wbs_display LINES DATA(lv_lines).
  " WRITE: / 'Total WBS lines:', lv_lines.

ENDFORM.



*&---------------------------------------------------------------------*
*& Form PREPARE_SCREEN2
*&---------------------------------------------------------------------*
FORM prepare_screen2.

  " Get additional IM data
  PERFORM get_additional_im_data USING p_posnr.

  " Copy template structure
  CALL METHOD go_builder->copy_template_structure
    EXPORTING
      iv_pspid     = p_pspid
      iv_kostl     = p_kostl
    CHANGING
      ct_wbs_items = gt_wbs_items.

  " ✅ DEBUG: Check if budget values exist
  DATA: lv_count TYPE i.
  LOOP AT gt_wbs_items INTO gs_wbs_item.
    IF gs_wbs_item-wert2 IS NOT INITIAL.
      lv_count = lv_count + 1.
    ENDIF.
  ENDLOOP.
  
  " ✅ Temporary message to verify
  IF lv_count = 0.
    MESSAGE 'Warning: No budget values found in template' TYPE 'I'.
  ELSE.
    MESSAGE |Found { lv_count } WBS elements with budget| TYPE 'I'.
  ENDIF.

  " Convert to display format
  PERFORM convert_to_display.

  " Set default values
  PERFORM set_wbs_default_values.

  " Initialize header
  PERFORM populate_header_structure.

ENDFORM.




MODULE fill_table_control OUTPUT.
  
  READ TABLE gt_wbs_display INTO gs_wbs_display INDEX tc_wbs-current_line.
  
  IF sy-subrc = 0.
    " ✅ DEBUG: Display budget value in status bar
    " MESSAGE |Line: { tc_wbs-current_line } Budget: { gs_wbs_display-zapproved_budg }| TYPE 'I'.
  ENDIF.
  
ENDMODULE.
