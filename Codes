FORM total_up_wbs.

  DATA: lv_parent_len TYPE i,
        lv_sum        TYPE gs_wbs_display-wert2,
        lv_pspid_norm TYPE string.

  FIELD-SYMBOLS:
    <fs_parent> TYPE gs_wbs_display,
    <fs_child>  TYPE gs_wbs_display.

  " Process from lowest parent to top
  DO 4 TIMES.
    DATA(lv_level) = 5 - sy-index.

    LOOP AT gt_wbs_display ASSIGNING <fs_parent>
      WHERE stufe = lv_level.

      CLEAR lv_sum.

      lv_pspid_norm = <fs_parent>-pspid.
      PERFORM normalize_pspid CHANGING lv_pspid_norm.
      lv_parent_len = strlen( lv_pspid_norm ).

      LOOP AT gt_wbs_display ASSIGNING <fs_child>
        WHERE stufe = lv_level + 1.

        DATA(lv_child_pspid) = <fs_child>-pspid.
        PERFORM normalize_pspid CHANGING lv_child_pspid.

        IF lv_child_pspid+0(lv_parent_len)
           = lv_pspid_norm.
          lv_sum += <fs_child>-wert2.
        ENDIF.

      ENDLOOP.

      IF lv_sum IS NOT INITIAL.
        <fs_parent>-wert2 = lv_sum.
      ENDIF.

    ENDLOOP.

  ENDDO.

ENDFORM.



FORM normalize_pspid CHANGING cv_pspid TYPE string.

  WHILE cv_pspid CP '*0'.
    cv_pspid = cv_pspid( strlen( cv_pspid ) - 1 ).
  ENDWHILE.

ENDFORM.



WHEN 'CHECK'.
  PERFORM check_data_only.
  IF sy-subrc = 0.
    PERFORM total_up_wbs.
  ENDIF.