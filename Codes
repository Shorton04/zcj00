*&———————————————————————*
*& Form SUBMIT_REQUEST
*&———————————————————————*

- Called when user clicks SUBMIT button in Screen 100 (Screen 2)
- This form handles the complete submission flow including:
- 1. Data conversion and validation
- 1. Saving the request
- 1. Getting approvers from config
- 1. Updating status to PENDING
- 1. Triggering workflow or auto-approving
   *&———————————————————————*
   FORM submit_request.

DATA: lv_reqnum        TYPE char10,
lv_appr1         TYPE char8,
lv_appr2         TYPE char8,
lv_auto          TYPE char1,
lv_error_handler TYPE char8,
lt_l1_approvers  TYPE hpa_t_bname,
lt_l2_approvers  TYPE hpa_t_bname,
lv_found         TYPE abap_bool,
lv_success       TYPE abap_bool.

“ ═══════════════════════════════════════════════════════════════════
“ STEP 1: CONVERT DATA FROM DISPLAY FORMAT TO INTERNAL FORMAT
“ ═══════════════════════════════════════════════════════════════════
PERFORM convert_from_display.
PERFORM populate_header_structure.

“ ═══════════════════════════════════════════════════════════════════
“ STEP 2: SAVE REQUEST (GETS REQUEST NUMBER)
“ ═══════════════════════════════════════════════════════════════════
lv_reqnum = go_builder->save_request(
is_header    = gs_header
it_wbs_items = gt_wbs_items
).

IF lv_reqnum IS INITIAL.
MESSAGE e013 WITH ‘Failed to save request before submit’.
RETURN.
ENDIF.

“ Store request number in header
gs_header-zreq_num = lv_reqnum.

“ ═══════════════════════════════════════════════════════════════════
“ STEP 3: GET APPROVERS FROM CONFIGURATION + HRP1001
“ ═══════════════════════════════════════════════════════════════════
lv_found = go_builder->check_approver_matrix(
EXPORTING
iv_bukrs   = gs_header-bukrs      “ Company Code (e.g., ‘ZX99’)
iv_profl   = gs_header-profl      “ Project Profile (e.g., ‘ZPC0001’)
iv_reqtype = gs_header-z_reqtype  “ Request Type (e.g., ‘A1’)
IMPORTING
ev_appr1         = lv_appr1             “ Position ID L1 (e.g., ‘30000’)
ev_appr2         = lv_appr2             “ Position ID L2
ev_auto          = lv_auto              “ ‘X’ if no approvers configured
ev_error_handler = lv_error_handler
et_l1_approvers  = lt_l1_approvers      “ VARYF values (e.g., ‘USHQ75177’)
et_l2_approvers  = lt_l2_approvers
).

IF lv_found = abap_false.
MESSAGE e008 WITH ‘No approver configuration found for’ gs_header-bukrs gs_header-profl.
RETURN.
ENDIF.

“ ═══════════════════════════════════════════════════════════════════
“ STEP 4: UPDATE STATUS TO PENDING (CRITICAL!)
“ ═══════════════════════════════════════════════════════════════════
“ This MUST happen BEFORE workflow trigger so the database shows PENDING
UPDATE ztb_a2r_wbshdr
SET request_status = ‘PENDING’
WHERE zreq_num = lv_reqnum.

IF sy-subrc <> 0.
MESSAGE e016 WITH ‘Failed to update status to PENDING for’ lv_reqnum.
ROLLBACK WORK.
RETURN.
ENDIF.

“ ✅ CRITICAL: Commit the status change BEFORE triggering workflow
“ This ensures workflow can query the request and see status = ‘PENDING’
COMMIT WORK AND WAIT.

“ Update local header structure
gs_header-request_status = ‘PENDING’.

“ ═══════════════════════════════════════════════════════════════════
“ STEP 5: TRIGGER WORKFLOW OR AUTO-APPROVE
“ ═══════════════════════════════════════════════════════════════════

IF lv_auto = ‘X’.
“ ───────────────────────────────────────────────────────────────
“ AUTO-APPROVAL PATH: No approvers configured
“ ───────────────────────────────────────────────────────────────
MESSAGE i035 WITH ‘Request’ lv_reqnum ‘has no approvers - auto-approving’.

```
" Call create_project directly
lv_success = go_builder->create_project(
  is_header    = gs_header
  it_wbs_items = gt_wbs_items
).

IF lv_success = abap_true.
  " Project created successfully - mark as APPROVED
  UPDATE ztb_a2r_wbshdr
    SET request_status = 'APPROVED'
        zapproved_by = sy-uname
        zrequest_approved_on = sy-datum
    WHERE zreq_num = lv_reqnum.

  COMMIT WORK.
  MESSAGE s033 WITH 'Request' lv_reqnum 'approved and project created'.
  LEAVE TO SCREEN 0.

ELSE.
  " Project creation failed - mark as ERROR
  UPDATE ztb_a2r_wbshdr
    SET request_status = 'ERROR'
    WHERE zreq_num = lv_reqnum.

  COMMIT WORK.
  MESSAGE e034 WITH 'Error creating project for request' lv_reqnum.
  RETURN.
ENDIF.
```

ELSE.
“ ───────────────────────────────────────────────────────────────
“ WORKFLOW PATH: Approvers exist, trigger workflow
“ ───────────────────────────────────────────────────────────────
lv_success = go_builder->trigger_workflow(
is_header   = gs_header
iv_appr1    = lv_appr1          “ Position ID for L1 (e.g., ‘30000’)
iv_appr2    = lv_appr2          “ Position ID for L2
it_l1_apprv = lt_l1_approvers   “ VARYF values (e.g., ‘USHQ75177’)
it_l2_apprv = lt_l2_approvers
).

```
IF lv_success = abap_true.
  COMMIT WORK.
  MESSAGE s015 WITH 'Request' lv_reqnum 'submitted for approval'.
  LEAVE TO SCREEN 0.

ELSE.
  " Workflow trigger failed - rollback and show error
  ROLLBACK WORK.
  MESSAGE e020 WITH 'Workflow trigger failed for request' lv_reqnum.
  RETURN.
ENDIF.
```

ENDIF.

ENDFORM.

