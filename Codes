*&---------------------------------------------------------------------*
*& Module STATUS_0100 OUTPUT
*&---------------------------------------------------------------------*
MODULE status_0100 OUTPUT.
  SET PF-STATUS 'STATUS_100'.
  SET TITLEBAR 'TITLE_100'.

  " ★ FIX: Gray out header information fields (not editable in Screen 2)
  LOOP AT SCREEN.
    
    " Make header fields display-only (grayed out)
    " These are shown for reference but cannot be changed in Screen 2
    CASE screen-name.
      " Right side header fields - all read-only
      WHEN 'GS_HEADER-BUKRS'        " Company Code
        OR 'GS_HEADER-WERKS'        " Plant
        OR 'GS_HEADER-PRCTR'        " Profit Center
        OR 'GS_HEADER-KOSTL'        " Cost Center
        OR 'GS_HEADER-IZWEK'        " Investment Reason
        OR 'GS_HEADER-ZUNIFIER_PROJ' " GE Ariba WF Flag
        OR 'GS_HEADER-USR008'       " CAR Approval Date
        
        " Left side header fields - also read-only in Screen 2
        OR 'GS_HEADER-POST1'        " Description
        OR 'GS_HEADER-VERNR'        " Person Responsible
        OR 'GS_HEADER-PLSEZ'        " Finish Date
        OR 'P_PRNAM'                " IM Program
        OR 'P_POSNR'                " IM Number
        OR 'GV_AVAILABLE_BUDGET'    " Available Budget
        
        " Request info fields - always read-only
        OR 'GS_HEADER-ERNAM'        " Requestor (username converted to full name)
        OR 'GS_HEADER-REQUEST_STATUS' " Request Status
        OR 'GS_HEADER-Z_REQTYPE'.   " Request Type (A1 → Create)
        
        screen-input = 0.           " Make non-editable
        screen-intensified = 0.     " Gray out appearance
        MODIFY SCREEN.
    ENDCASE.
    
  ENDLOOP.

ENDMODULE.




*&---------------------------------------------------------------------*
*& Form GET_USER_FULLNAME
*&---------------------------------------------------------------------*
FORM get_user_fullname USING    iv_uname      TYPE xubname
                       CHANGING cv_fullname   TYPE char50.

  DATA: ls_usr21 TYPE usr21,
        ls_adrp  TYPE adrp.

  CLEAR cv_fullname.

  " Get person number from username
  SELECT SINGLE * FROM usr21
    INTO ls_usr21
    WHERE bname = iv_uname.

  IF sy-subrc = 0 AND ls_usr21-persnumber IS NOT INITIAL.
    
    " Get full name from address data
    SELECT SINGLE * FROM adrp
      INTO ls_adrp
      WHERE persnumber = ls_usr21-persnumber.

    IF sy-subrc = 0.
      " Build full name: First Name Last Name
      IF ls_adrp-name_first IS NOT INITIAL OR ls_adrp-name_last IS NOT INITIAL.
        CONCATENATE ls_adrp-name_first ls_adrp-name_last
          INTO cv_fullname SEPARATED BY space.
        CONDENSE cv_fullname.
      ELSE.
        " Fallback to username if no name found
        cv_fullname = iv_uname.
      ENDIF.
    ELSE.
      cv_fullname = iv_uname.
    ENDIF.
    
  ELSE.
    " If user not found, use username
    cv_fullname = iv_uname.
  ENDIF.

ENDFORM.





*&---------------------------------------------------------------------*
*& Form GET_REQUEST_TYPE_TEXT
*&---------------------------------------------------------------------*
FORM get_request_type_text USING    iv_reqtype      TYPE ztb_a2r_reqtype-z_reqtype
                           CHANGING cv_reqtype_text TYPE char20.

  DATA: ls_reqtype TYPE ztb_a2r_reqtype.

  CLEAR cv_reqtype_text.

  " Get request type description from config table
  SELECT SINGLE * FROM ztb_a2r_reqtype
    INTO ls_reqtype
    WHERE z_reqtype = iv_reqtype.

  IF sy-subrc = 0.
    cv_reqtype_text = ls_reqtype-z_reqtype_desc.  " e.g., "Create"
  ELSE.
    " Fallback: use code if description not found
    cv_reqtype_text = iv_reqtype.
  ENDIF.

ENDFORM.




*&---------------------------------------------------------------------*
*& Module SET_HEADER_DISPLAY_VALUES OUTPUT
*&---------------------------------------------------------------------*
MODULE set_header_display_values OUTPUT.

  DATA: lv_fullname     TYPE char50,
        lv_reqtype_text TYPE char20.

  " ★ FIX 1: Convert username to full name for display
  IF gs_header-ernam IS NOT INITIAL.
    PERFORM get_user_fullname 
      USING    gs_header-ernam
      CHANGING lv_fullname.
    
    " Store in a display-only field (create new field in TOP if needed)
    " Or overwrite the field for display purposes
    " For now, we'll use a global variable
    DATA: gv_requestor_display TYPE char50.
    gv_requestor_display = lv_fullname.
  ENDIF.

  " ★ FIX 2: Convert request type code to text
  IF gs_header-z_reqtype IS NOT INITIAL.
    PERFORM get_request_type_text
      USING    gs_header-z_reqtype
      CHANGING lv_reqtype_text.
    
    DATA: gv_reqtype_display TYPE char20.
    gv_reqtype_display = lv_reqtype_text.
  ENDIF.

ENDMODULE.




