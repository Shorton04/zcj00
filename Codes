" ★ Convert BOTH IM fields to external POSID format
  " Get the POSNR value (could be in header or screen variable)
  DATA(lv_posnr) = COND im_posnr( 
    WHEN gs_header-posnr IS NOT INITIAL 
    THEN gs_header-posnr 
    ELSE p_posnr 
  ).
  
  IF lv_posnr IS NOT INITIAL.
    PERFORM get_im_posid_external
      USING    lv_posnr
      CHANGING lv_im_posid.
    
    " Store in display variable
    gv_im_posid_display = lv_im_posid.
    
    " ★ CRITICAL: Also update the screen fields directly
    " This ensures both "IM Number" and "IM" fields show external format
    p_posnr = lv_im_posid.              " IM Number field
    gs_header-posnr = lv_im_posid.      " IM field (the one showing "3")
  ELSE.
    CLEAR: gv_im_posid_display, p_posnr, gs_header-posnr.
  ENDIF.



*&---------------------------------------------------------------------*
*& Form GET_IM_POSID_EXTERNAL
*&---------------------------------------------------------------------*
*& Convert IM internal POSNR to external POSID (e.g., 00000003 → PR01)
*&---------------------------------------------------------------------*
FORM get_im_posid_external USING    iv_posnr         TYPE im_posnr
                           CHANGING cv_posid_external TYPE im_posid.

  CLEAR cv_posid_external.

  IF iv_posnr IS NOT INITIAL.
    " Get external POSID from IMPR table
    SELECT SINGLE posid
      FROM impr
      INTO cv_posid_external
      WHERE posnr = iv_posnr.

    IF sy-subrc <> 0.
      " Fallback: try with leading zeros removed
      DATA(lv_posnr_alpha) = |{ iv_posnr ALPHA = OUT }|.
      SELECT SINGLE posid
        FROM impr
        INTO cv_posid_external
        WHERE posnr = lv_posnr_alpha.
      
      IF sy-subrc <> 0.
        " Last resort: use the input value
        cv_posid_external = iv_posnr.
      ENDIF.
    ENDIF.
  ENDIF.

ENDFORM.




