FORM load_template_to_wbs_items USING iv_pspid TYPE ps_pspid
                                       iv_kostl TYPE kostl.

  DATA: lv_pspnr_templ TYPE ps_pspnr,
        lt_prpss_all   TYPE TABLE OF prpss,
        lt_prpss_level TYPE TABLE OF prpss,
        ls_prpss       TYPE prpss,
        lt_pspnr_list  TYPE TABLE OF ps_pspnr,
        lv_level       TYPE i,
        lv_max_levels  TYPE i VALUE 10.

  FIELD-SYMBOLS: <fs_prpss> TYPE prpss.

  REFRESH gt_wbs_items.

  " Get template pspnr
  SELECT SINGLE pspnr FROM projs
    INTO lv_pspnr_templ
    WHERE pspid = iv_pspid.

  IF sy-subrc <> 0.
    SELECT SINGLE pspnr FROM proj
      INTO lv_pspnr_templ
      WHERE pspid = iv_pspid.
  ENDIF.

  CHECK sy-subrc = 0.

  " Get all wbs elements recursively (same logic as tree)
  SELECT * FROM prpss
    INTO TABLE lt_prpss_all
    WHERE psphi = lv_pspnr_templ
    ORDER BY stufe posid.

  CHECK sy-subrc = 0.

  " Recursive fetch for children
  lv_level = 1.
  WHILE lv_level < lv_max_levels.

    CLEAR lt_pspnr_list.
    LOOP AT lt_prpss_all ASSIGNING <fs_prpss>.
      APPEND <fs_prpss>-pspnr TO lt_pspnr_list.
    ENDLOOP.

    IF lt_pspnr_list IS INITIAL.
      EXIT.
    ENDIF.

    CLEAR lt_prpss_level.
    SELECT * FROM prpss
      INTO TABLE lt_prpss_level
      FOR ALL ENTRIES IN lt_pspnr_list
      WHERE psphi = lt_pspnr_list-table_line.

    IF sy-subrc <> 0.
      EXIT.
    ENDIF.

    APPEND LINES OF lt_prpss_level TO lt_prpss_all.
    lv_level = lv_level + 1.

  ENDWHILE.

  SORT lt_prpss_all BY stufe posid.

  " Convert prpss to wbs items structure
  LOOP AT lt_prpss_all INTO ls_prpss.
    CLEAR gs_wbs_item.

    " ✓ FIXED: Use correct field mappings
    gs_wbs_item-stufe = ls_prpss-stufe.
    gs_wbs_item-posid = ls_prpss-posid.        " ← FIX: Use POSID not PSPNR!
    gs_wbs_item-post1 = ls_prpss-post1.
    gs_wbs_item-posnr = ls_prpss-pspnr.        " Internal number stored separately
    
    " ✓ FIXED: Inherit company code and plant from header
    gs_wbs_item-kostl = iv_kostl.
    gs_wbs_item-bukrs = gv_bukrs.              " ← FIX: Add company code
    gs_wbs_item-werks = gv_werks.              " ← FIX: Add plant
    
    " Template properties
    gs_wbs_item-imprf = ls_prpss-imprf.
    gs_wbs_item-prart = ls_prpss-prart.
    
    " Initialize budget fields
    gs_wbs_item-wert2 = 0.                     " Budget - user will fill
    gs_wbs_item-zbudget_check = space.

    APPEND gs_wbs_item TO gt_wbs_items.

  ENDLOOP.

ENDFORM.




*&---------------------------------------------------------------------*
*&      Form  GET_TEXT
*&---------------------------------------------------------------------*
FORM get_text.

  CHECK sy-batch IS INITIAL AND sy-binpt IS INITIAL.

  CLEAR: ls_text, lt_text.

  CALL METHOD lo_editor->get_text_as_r3table
    IMPORTING
      table = lt_text.

  CALL METHOD lo_editor->flush.

  " ✓ FIXED: Store remarks in global variable
  CLEAR gv_z_remarks.
  LOOP AT lt_text INTO ls_text.
    IF gv_z_remarks IS INITIAL.
      gv_z_remarks = ls_text-text.
    ELSE.
      CONCATENATE gv_z_remarks ls_text-text INTO gv_z_remarks
        SEPARATED BY cl_abap_char_utilities=>newline.
    ENDIF.
  ENDLOOP.

  " Additional Lines Check
  IF lines( lt_text ) > lv_rlines.
    READ TABLE lt_text INTO ls_text INDEX ( lv_rlines + 1 ).
    IF ls_text IS INITIAL.
      DELETE lt_text INDEX ( lv_rlines + 1 ).
    ENDIF.
  ENDIF.

ENDFORM.




*&---------------------------------------------------------------------*
*& Module USER_COMMAND_0100 INPUT
*&---------------------------------------------------------------------*
MODULE user_command_0100 INPUT.
  DATA: lv_ok_code1 TYPE sy-ucomm.

  lv_ok_code1 = sy-ucomm.
  CLEAR sy-ucomm.

  CASE lv_ok_code1.
    WHEN 'SAVE'.
      " ✓ FIXED: Get remarks before saving
      PERFORM get_text.
      PERFORM save_request.

    WHEN 'CHECK'.
      PERFORM get_text.              " ← Added
      PERFORM check_data.

    WHEN 'SUBMIT'.
      PERFORM get_text.              " ← Added
      PERFORM check_data.
      IF sy-subrc = 0.
        PERFORM submit_request.
      ENDIF.

    WHEN 'UPLD'.
      PERFORM upload.

    WHEN 'DWNLD'.
      PERFORM download.

    WHEN 'TOTALUP'.
      PERFORM total_up_budget.

    WHEN 'ADDROW'.
      PERFORM add_wbs_row.

    WHEN 'DELROW'.
      PERFORM delete_wbs_rows.

    WHEN 'ATTACH'.
      PERFORM handle_attachments.

    WHEN 'BACK'.
      LEAVE TO SCREEN 200.

    WHEN 'EXIT' OR 'CANCEL'.
      LEAVE TO SCREEN 0.

  ENDCASE.
ENDMODULE.




METHOD copy_template_structure.

  DATA: lt_prpss TYPE TABLE OF prpss,
        ls_prpss TYPE prpss,
        ls_wbs   TYPE ztb_a2r_wbsitem,
        lv_pspnr TYPE ps_pspnr.

  " Get project internal number from template PSPID
  SELECT SINGLE pspnr FROM projs
    INTO lv_pspnr
    WHERE pspid = iv_pspid.

  IF sy-subrc <> 0.
    SELECT SINGLE pspnr FROM proj
      INTO lv_pspnr
      WHERE pspid = iv_pspid.
  ENDIF.

  IF sy-subrc = 0.
    SELECT * FROM prpss
      INTO TABLE lt_prpss
      WHERE psphi = lv_pspnr
      ORDER BY stufe posid.

    IF sy-subrc = 0.
      LOOP AT lt_prpss INTO ls_prpss.
        CLEAR ls_wbs.

        " ✓ FIXED: Correct field mappings
        ls_wbs-stufe = ls_prpss-stufe.
        ls_wbs-posid = ls_prpss-posid.        " ← Use POSID not PSPNR
        ls_wbs-post1 = ls_prpss-post1.
        ls_wbs-posnr = ls_prpss-pspnr.        " Internal number
        ls_wbs-kostl = iv_kostl.
        ls_wbs-imprf = ls_prpss-imprf.
        ls_wbs-prart = ls_prpss-prart.
        ls_wbs-bukrs = ls_prpss-pbukr.
        
        " Note: WERKS needs to come from header, not template
        " It will be set when called from prepare_screen2

        APPEND ls_wbs TO ct_wbs_items.
      ENDLOOP.
    ENDIF.

  ENDIF.

ENDMETHOD.




