*& Form F4_IM_NUMBER
*&---------------------------------------------------------------------*
FORM f4_im_number CHANGING cv_posnr TYPE im_posnr.

  TYPES: BEGIN OF ty_im_display,
           posid TYPE im_posid,
           posnr TYPE im_posnr,
           prnam TYPE im_prnam,
           gjahr TYPE im_gnjhr,
         END OF ty_im_display.

  DATA: lt_impr   TYPE TABLE OF ty_im_display,
        lt_return TYPE TABLE OF ddshretval,
        ls_return TYPE ddshretval.

  " Get IM positions with config check
  SELECT i~posid i~posnr i~prnam i~gjahr
  FROM impr AS i
  INNER JOIN ztb_a2r_conftab1 AS c
  ON c~izwek = i~izwek
  INTO CORRESPONDING FIELDS OF TABLE lt_impr
  UP TO 500 ROWS
  ORDER BY i~posid DESCENDING.

  " Display F4 help
  CALL FUNCTION 'f4if_int_table_value_request'
    EXPORTING
      retfield        = 'posnr'
      dynpprog        = sy-repid
      dynpnr          = sy-dynnr
      dynprofield     = 'p_posnr'
      value_org       = 's'
      window_title    = 'Select im PROGRAM Position'
    TABLES
      value_tab       = lt_impr
      return_tab      = lt_return
    EXCEPTIONS
      parameter_error = 1
      no_values_found = 2
      OTHERS          = 3.

  IF sy-subrc = 0.
    READ TABLE lt_return INTO ls_return INDEX 1.
    IF sy-subrc = 0.
      cv_posnr = ls_return-fieldval.
    ENDIF.
  ENDIF.

ENDFORM.


*&---------------------------------------------------------------------*
*& Form GET_IM_DATA
*&---------------------------------------------------------------------*
FORM get_im_data USING iv_posnr TYPE im_posnr.

  DATA: ls_impr TYPE impr.

  " Validate posnr exists and get data
  SELECT SINGLE * FROM impr
  INTO ls_impr
  WHERE posnr = iv_posnr.

  IF sy-subrc = 0.


    " FDS Table 4.1 Row 5: Get IM Program (PRNAM)
    " Population: Get IMPR-POSID where IMPR-POSNR = selected POSNR
    p_prnam = ls_impr-prnam.

    " FDS Table 4.1 Row 6: Get Approval Year (GJAHR)
    " Population: Get IMPR-GJAHR where IMPR-POSNR = selected POSNR
    p_gjahr = ls_impr-gjahr.

    " FDS Table 4.1 Row 10: Get Profit Center (PRCTR)
    " Population: Get IMPR-PRCTR where IMPR-POSNR = selected POSNR
    p_prctr = ls_impr-prctr.

    " FDS Table 4.1 Row 11: Get Cost Center (KOSTL)
    " Population: Get IMPR-KOSTL where IMPR-POSNR = selected POSNR
    p_kostl = ls_impr-kostl.

    " Store additional fields for Screen 2
    gv_bukrs = ls_impr-bukrs.
    gv_werks = ls_impr-werks.
    gv_izwek = ls_impr-izwek.
    gv_usr008 = ls_impr-usr08.

    " FDS Table 4.1 Row 2 & 3: Get Project Profile and Template
    " Population: From IMPR-POSNR, get IMPR-IZWEK, then query config table
    PERFORM get_profile_template USING ls_impr-izwek
                                 CHANGING p_profl p_pspid.

    " FDS Table 4.1 Row 12: Check GE Ariba flag
    " Population: Auto-selected if IM Project management field = "GE"
    PERFORM check_ge_ariba USING ls_impr CHANGING p_usr10.

    " FDS Table 4.1 Row 9: Set finish date for lumpsum
    " Population: For Lumpsum, auto-populate with last day of current year
    IF ls_impr-izwek = 'LS'.
      p_plsez = sy-datum.
      p_plsez+4(4) = '1231'. " Last day of year (e.g., 31.12.2025)
    ENDIF.


  ELSE.
    MESSAGE e002 WITH iv_posnr. " im Number not found
  ENDIF.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form GET_PROFILE_TEMPLATE
*&---------------------------------------------------------------------*
FORM get_profile_template USING iv_izwek TYPE izwek
CHANGING cv_profl TYPE profidproj
cv_pspid TYPE ps_pspid.

  DATA: ls_config TYPE ztb_a2r_conftab1,
        lv_pspnr  TYPE ps_pspnr.

  " CRITICAL FIX: PSPNR in config table is INTERNAL number, not PSPID!
  " From screenshot: PSPNR = PC.000001 (display), 00000008 (internal)

  SELECT SINGLE profl pspnr FROM ztb_a2r_conftab1
  INTO (cv_profl, lv_pspnr)
  WHERE izwek = iv_izwek.

  IF sy-subrc = 0.
    " NOW get the PSPID (external ID) from PSPNR (internal number)
    " Use PROJS table (standard WBS structure table from screenshot 4)
    SELECT SINGLE pspid FROM projs
    INTO cv_pspid
    WHERE pspnr = lv_pspnr.


    IF sy-subrc <> 0.
      " Fallback to PROJ table if not found in PROJS
      SELECT SINGLE pspid FROM proj
        INTO cv_pspid
        WHERE pspnr = lv_pspnr.
    ENDIF.

    IF cv_pspid IS INITIAL.
      MESSAGE w003 WITH 'Template PSPID not found for PSPNR' lv_pspnr.
      CLEAR: cv_profl, cv_pspid.
    ENDIF.


  ELSE.
    MESSAGE w003 WITH 'No configuration found for IZWEK' iv_izwek.
    CLEAR: cv_profl, cv_pspid.
  ENDIF.

ENDFORM.

