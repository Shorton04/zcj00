*&---------------------------------------------------------------------*
*& Module DISPLAY_TREE_PREVIEW OUTPUT
*&---------------------------------------------------------------------*
MODULE display_tree_preview OUTPUT.

  " Reload tree when template changes
  IF p_pspid IS NOT INITIAL AND 
     ( lo_tree_preview IS INITIAL OR p_pspid NE gv_pspid_old ).
    
    " Free existing tree if template changed
    IF p_pspid NE gv_pspid_old AND lo_tree_preview IS NOT INITIAL.
      PERFORM free_tree_control.
    ENDIF.
    
    " Create tree control
    IF lo_tree_preview IS INITIAL.
      PERFORM create_tree_control.
    ENDIF.
    
    " Load hierarchy
    PERFORM load_tree_hierarchy.
    
    " Store current template
    gv_pspid_old = p_pspid.
    
  ENDIF.

ENDMODULE.




*&---------------------------------------------------------------------*
*& Include          ZTR_A2R_WBSZCJ01_PAI
*&---------------------------------------------------------------------*

*&---------------------------------------------------------------------*
*& Module USER_COMMAND_0200 INPUT
*&---------------------------------------------------------------------*
MODULE user_command_0200 INPUT.

  DATA: lv_okcode TYPE sy-ucomm.
  
  lv_okcode = sy-ucomm.
  CLEAR sy-ucomm.

  CASE lv_okcode.
    WHEN 'BACK' OR 'EXIT' OR 'CANCEL'.
      PERFORM free_tree_control.
      LEAVE TO SCREEN 0.
      
    WHEN 'NEXT'.
      PERFORM validate_screen1.
      " Proceed to next screen
      
    WHEN OTHERS.
      " Handle other commands
  ENDCASE.

ENDMODULE.

*&---------------------------------------------------------------------*
*& Module POSNR_CHANGED INPUT
*&---------------------------------------------------------------------*
MODULE posnr_changed INPUT.

  " Check if IM Number changed
  IF p_posnr NE gv_posnr_old.
    
    " Get new IM data
    PERFORM get_im_data USING p_posnr.
    
    " Free existing tree to force refresh
    IF lo_tree_preview IS NOT INITIAL.
      PERFORM free_tree_control.
    ENDIF.
    
    " Store new value
    gv_posnr_old = p_posnr.
    
  ENDIF.

ENDMODULE.




PROCESS AFTER INPUT.
  MODULE user_command_0200.
  
  FIELD p_posnr MODULE posnr_changed ON REQUEST.




FORM load_tree_hierarchy.

  DATA: ls_proj           TYPE proj,
        lv_pspid_template TYPE ps_pspid,
        lv_msg            TYPE string.

  " Clear previous data
  CLEAR: gt_treev_node, gt_treeitm.

  " Validate input
  CHECK p_pspid IS NOT INITIAL.
  
  lv_pspid_template = p_pspid.

  " Get project template data
  SELECT SINGLE * FROM proj INTO ls_proj
    WHERE pspid = lv_pspid_template.

  IF sy-subrc <> 0.
    " Template not found - show message and use fallback
    MESSAGE i001 WITH 'Template not found:' p_pspid.
    PERFORM load_simple_preview_fallback.
    RETURN.
  ENDIF.

  " Set objects to display in hierarchy
  CLEAR ls_objects_in_hierarchy.
  ls_objects_in_hierarchy-proj = abap_true.
  ls_objects_in_hierarchy-prps = abap_true.
  ls_objects_in_hierarchy-pstx = abap_true.

  " Call SAP standard function
  CALL FUNCTION 'CNPB_H_PROJ_HIER_SELECT'
    EXPORTING
      i_objects_in_hierarchy = ls_objects_in_hierarchy
      i_vsnmr                = ''
      i_pspid                = lv_pspid_template
      i_aufnr                = ''
      i_flg_enqueue          = space
      i_expand_levels        = 06
    IMPORTING
      et_treeitm             = gt_treeitm
      et_treev_node          = gt_treev_node
      e_objects_in_hierarchy = gs_objects_in_tree
    EXCEPTIONS
      OTHERS                 = 1.

  IF sy-subrc <> 0 OR gt_treev_node IS INITIAL.
    MESSAGE i001 WITH 'PS hierarchy function unavailable, using list view'.
    PERFORM load_simple_preview_fallback.
    RETURN.
  ENDIF.

  " Delete existing nodes before adding new ones
  IF lo_tree_preview IS NOT INITIAL.
    CALL METHOD lo_tree_preview->delete_all_nodes
      EXCEPTIONS
        failed = 1
        OTHERS = 2.
  ENDIF.

  " Add nodes and items to tree
  CALL METHOD lo_tree_preview->add_nodes_and_items
    EXPORTING
      node_table                     = gt_treev_node
      item_table                     = gt_treeitm
      item_table_structure_name      = 'CNPB_H_TREEITM'
    EXCEPTIONS
      failed                         = 1
      cntl_system_error              = 3
      error_in_tables                = 4
      dp_error                       = 5
      table_structure_name_not_found = 6
      OTHERS                         = 7.

  IF sy-subrc <> 0.
    lv_msg = 'Error adding tree nodes'.
    MESSAGE i001 WITH lv_msg.
    RETURN.
  ENDIF.

  " Expand root nodes
  CALL METHOD lo_tree_preview->expand_root_nodes
    EXPORTING
      level_count         = 2
      expand_subtree      = abap_true
    EXCEPTIONS
      failed              = 1
      illegal_level_count = 2
      cntl_system_error   = 3
      OTHERS              = 4.

  " Frontend update
  CALL METHOD cl_gui_cfw=>flush
    EXCEPTIONS
      cntl_system_error = 1
      OTHERS            = 2.

  lv_tree_loaded = abap_true.

ENDFORM.
