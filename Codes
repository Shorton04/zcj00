*&---------------------------------------------------------------------*
*& Form CONVERT_TO_DISPLAY
*&---------------------------------------------------------------------*
FORM convert_to_display.

  DATA: lv_posid_external TYPE ps_posid.

  REFRESH gt_wbs_display.

  LOOP AT gt_wbs_items INTO gs_wbs_item.
    CLEAR: gs_wbs_display, lv_posid_external.
    
    " Map all fields
    gs_wbs_display-stufe = gs_wbs_item-stufe.
    gs_wbs_display-post1 = gs_wbs_item-post1.
    gs_wbs_display-kostl = gs_wbs_item-kostl.
    gs_wbs_display-posnr = gs_wbs_item-posnr.
    gs_wbs_display-zapproved_budg = gs_wbs_item-wert2.
    gs_wbs_display-zbudget_check = gs_wbs_item-zbudget_check.
    gs_wbs_display-bukrs = gs_wbs_item-bukrs.
    gs_wbs_display-imprf = gs_wbs_item-imprf.
    gs_wbs_display-prart = gs_wbs_item-prart.
    
    " ★ CRITICAL FIX: Convert POSID to external format (PC.000001)
    IF gs_wbs_item-posid IS NOT INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_ABPSP_OUTPUT'
        EXPORTING
          input  = gs_wbs_item-posid
        IMPORTING
          output = lv_posid_external
        EXCEPTIONS
          OTHERS = 1.
      
      IF sy-subrc = 0 AND lv_posid_external IS NOT INITIAL.
        gs_wbs_display-posid = lv_posid_external.
      ELSE.
        " Fallback: use original value
        gs_wbs_display-posid = gs_wbs_item-posid.
      ENDIF.
    ENDIF.
    
    APPEND gs_wbs_display TO gt_wbs_display.
  ENDLOOP.

ENDFORM.




*&---------------------------------------------------------------------*
*& Form CONVERT_FROM_DISPLAY
*&---------------------------------------------------------------------*
FORM convert_from_display.

  DATA: lv_posid_internal TYPE ps_posid.

  REFRESH gt_wbs_items.

  LOOP AT gt_wbs_display INTO gs_wbs_display.
    CLEAR: gs_wbs_item, lv_posid_internal.

    " Map from display table to internal table
    gs_wbs_item-stufe = gs_wbs_display-stufe.
    gs_wbs_item-post1 = gs_wbs_display-post1.
    gs_wbs_item-kostl = gs_wbs_display-kostl.
    gs_wbs_item-wert2 = gs_wbs_display-zapproved_budg.
    gs_wbs_item-zbudget_check = gs_wbs_display-zbudget_check.
    gs_wbs_item-bukrs = gs_wbs_display-bukrs.
    gs_wbs_item-posnr = gs_wbs_display-posnr.
    gs_wbs_item-imprf = gs_wbs_display-imprf.
    gs_wbs_item-prart = gs_wbs_display-prart.
    
    " ★ CRITICAL FIX: Convert POSID from external (PC.000001) back to internal (PC000001)
    IF gs_wbs_display-posid IS NOT INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_ABPSP_INPUT'
        EXPORTING
          input  = gs_wbs_display-posid
        IMPORTING
          output = lv_posid_internal
        EXCEPTIONS
          OTHERS = 1.
      
      IF sy-subrc = 0 AND lv_posid_internal IS NOT INITIAL.
        gs_wbs_item-posid = lv_posid_internal.
      ELSE.
        gs_wbs_item-posid = gs_wbs_display-posid.
      ENDIF.
    ENDIF.

    APPEND gs_wbs_item TO gt_wbs_items.

  ENDLOOP.

ENDFORM.
