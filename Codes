*&———————————————————————*
*& Form SHOW_TEMPLATE_PREVIEW - CORRECTED
*&———————————————————————*
FORM show_template_preview USING iv_pspid TYPE ps_pspid.

  DATA: lt_prpss TYPE TABLE OF prpss,
        lv_pspnr TYPE ps_pspnr.

  " CORRECTED: Get project internal number from PSPID
  " Use PROJS table (as shown in screenshot 4)
  SELECT SINGLE pspnr FROM projs
  INTO lv_pspnr
  WHERE pspid = iv_pspid.

  IF sy-subrc <> 0.
    " Fallback to PROJ if not found in PROJS
    SELECT SINGLE pspnr FROM proj
    INTO lv_pspnr
    WHERE pspid = iv_pspid.
  ENDIF.

  IF sy-subrc = 0.
    " Get WBS elements using PRPSS (screenshot 5 shows this is correct)
    SELECT * FROM prpss
    INTO TABLE lt_prpss
    WHERE psphi = lv_pspnr
    ORDER BY stufe posid.


    IF sy-subrc = 0.
      CALL FUNCTION 'REUSE_ALV_POPUP_TO_SELECT'
        EXPORTING
          i_title       = 'Project Template Preview'
          i_tabname     = 'PRPSS'
        TABLES
          t_outtab      = lt_prpss
        EXCEPTIONS
          program_error = 1
          OTHERS        = 2.
    ENDIF.


  ELSE.
    MESSAGE i011 WITH iv_pspid. " Template not found
  ENDIF.

ENDFORM.

*&———————————————————————*
*& Form GET_AVAILABLE_IM_BUDGET
*&———————————————————————*
FORM get_available_im_budget USING iv_posnr TYPE im_posnr
CHANGING cv_budget TYPE bpge-wlges.

  DATA: lv_objnr TYPE j_objnr,
        ls_bpge  TYPE bpge.

  SELECT SINGLE objnr FROM impr
  INTO lv_objnr
  WHERE posnr = iv_posnr.

  IF sy-subrc = 0.
    SELECT SINGLE wlges wtgev
    FROM bpge
    INTO (ls_bpge-wlges, ls_bpge-wtgev)
    WHERE objnr = lv_objnr.


    cv_budget = ls_bpge-wlges - ls_bpge-wtgev.

    IF cv_budget > 0.
      gv_available_budget = cv_budget.
    ELSE.
      CLEAR gv_available_budget.
    ENDIF.


  ENDIF.

ENDFORM.

*&———————————————————————*
*& MODULE VALIDATE_POSNR INPUT - CORRECTED
*&———————————————————————*
MODULE validate_posnr INPUT.

  IF p_posnr IS NOT INITIAL.


    " CRITICAL FIX: IMPR-POSNR is already stored with leading zeros
    " From screenshot 2: POSNR = 00000011 (8 digits)
    " NO CONVERSION NEEDED - just ensure it's 8 digits

    " Pad with leading zeros if needed (for manual entry)
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        input  = p_posnr
      IMPORTING
        output = p_posnr.

    " Validate that IM position exists
    SELECT SINGLE posnr FROM impr
      INTO @DATA(lv_check)
      WHERE posnr = @p_posnr.

    IF sy-subrc <> 0.
      MESSAGE e002 WITH p_posnr. " IM Number not found
      RETURN.
    ENDIF.

    " Load data if changed
    IF p_posnr <> gv_posnr_old.
      PERFORM get_im_data USING p_posnr.
      gv_posnr_old = p_posnr.
    ENDIF.


  ENDIF.

ENDMODULE.

*&———————————————————————*
*& CLASS METHOD: COPY_TEMPLATE_STRUCTURE - CORRECTED
*&———————————————————————*
METHOD copy_template_structure.

  DATA: lt_prpss TYPE TABLE OF prpss,
        ls_prpss TYPE prpss,
        ls_wbs   TYPE ztb_a2r_wbsitem,
        lv_pspnr TYPE ps_pspnr.

  " CORRECTED: Get project internal number from template PSPID
  " Use PROJS table (screenshot 4 shows standard structure)
  SELECT SINGLE pspnr FROM projs
  INTO lv_pspnr
  WHERE pspid = iv_pspid.

  IF sy-subrc <> 0.
    " Fallback to PROJ
    SELECT SINGLE pspnr FROM proj
    INTO lv_pspnr
    WHERE pspid = iv_pspid.
  ENDIF.

  IF sy-subrc = 0.
    " Get all WBS elements using PRPSS (screenshot 5 confirms this)
    SELECT * FROM prpss
    INTO TABLE lt_prpss
    WHERE psphi = lv_pspnr
    ORDER BY stufe posid.


    IF sy-subrc = 0.
      LOOP AT lt_prpss INTO ls_prpss.
        CLEAR ls_wbs.

        ls_wbs-stufe = ls_prpss-stufe.
        ls_wbs-posid = ls_prpss-posid.
        ls_wbs-post1 = ls_prpss-post1.
        ls_wbs-posnr = ls_prpss-pspnr.    " PSPNR = internal WBS number
        ls_wbs-kostl = iv_kostl.          " Inherit from header
        ls_wbs-imprf = ls_prpss-imprf.
        ls_wbs-prart = ls_prpss-prart.
        ls_wbs-bukrs = ls_prpss-pbukr.

        APPEND ls_wbs TO ct_wbs_items.
      ENDLOOP.
    ENDIF.


  ENDIF.

ENDMETHOD.

