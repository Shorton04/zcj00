- CRITICAL FINDING: FDS says use POSNR (not POSID)!
  *–––––––––––––––––––––––––––––––––––*
- However, your screenshot shows you entering “PR02” which is POSID.
- 
- PROBLEM: Screen field is defined as type IM_POSNR (NUMC 8)
- ```
       But you're entering POSID format (CHAR like "PR02")
  ```
- 
- SOLUTION: We need to handle BOTH formats in validation
  *–––––––––––––––––––––––––––––––––––*

*&———————————————————————*
*& Include          ZTR_A2R_WBSZCJ01_TOP - DECLARATIONS
*&———————————————————————*

DATA: p_posnr TYPE im_posnr.  “ As per FDS: Data Element IM_POSNR

*&———————————————————————*
*& MODULE VALIDATE_POSNR INPUT - CORRECTED PER FDS
*&———————————————————————*
MODULE validate_posnr INPUT.

DATA: lv_posnr_numeric TYPE im_posnr,
lv_input_char    TYPE char20,
lv_posid         TYPE im_posid.

IF p_posnr IS NOT INITIAL.

```
" Save original input
lv_input_char = p_posnr.

" Remove leading spaces and convert to uppercase
CONDENSE lv_input_char NO-GAPS.
TRANSLATE lv_input_char TO UPPER CASE.

" STEP 1: Try to find as POSID (user-friendly format like "PR02")
" This handles when user types PR02 instead of 00000011
lv_posid = lv_input_char.

SELECT SINGLE posnr FROM impr
  INTO lv_posnr_numeric
  WHERE posid = lv_posid.

IF sy-subrc = 0.
  " Found via POSID - use the POSNR we got
  p_posnr = lv_posnr_numeric.
ELSE.
  " STEP 2: Not found as POSID, try as POSNR with leading zeros
  " Apply ALPHA conversion to add leading zeros
  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING
      input  = lv_input_char
    IMPORTING
      output = lv_posnr_numeric.

  " Validate this POSNR exists
  SELECT SINGLE posnr FROM impr
    INTO @DATA(lv_check)
    WHERE posnr = lv_posnr_numeric.

  IF sy-subrc = 0.
    " Found as POSNR
    p_posnr = lv_posnr_numeric.
  ELSE.
    " Not found in either format
    MESSAGE e002 WITH lv_input_char. " IM Number not found
    RETURN.
  ENDIF.
ENDIF.

" Load data if POSNR changed
IF p_posnr <> gv_posnr_old.
  PERFORM get_im_data USING p_posnr.
  gv_posnr_old = p_posnr.
ENDIF.
```

ENDIF.

ENDMODULE.

