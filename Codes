MODULE validate_posnr INPUT.
  
  DATA: lv_input TYPE char20.
  
  IF p_posnr IS NOT INITIAL.
    
    lv_input = p_posnr.
    
    " Try as POSID first (PR02)
    SELECT SINGLE posnr FROM impr
      INTO p_posnr
      WHERE posid = lv_input.
    
    IF sy-subrc <> 0.
      " Try as POSNR (00000011)
      SELECT SINGLE posnr FROM impr
        INTO p_posnr
        WHERE posnr = lv_input.
      
      IF sy-subrc <> 0.
        MESSAGE e002 WITH lv_input.
        RETURN.
      ENDIF.
    ENDIF.
    
    " Load data
    IF p_posnr <> gv_posnr_old.
      PERFORM get_im_data USING p_posnr.
      gv_posnr_old = p_posnr.
    ENDIF.
    
  ENDIF.
  
ENDMODULE.
