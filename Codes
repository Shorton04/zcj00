*&---------------------------------------------------------------------*
*& Form LOAD_IM_DATA
*&---------------------------------------------------------------------*
*& Load IM position data and auto-populate fields
*&---------------------------------------------------------------------*
FORM load_im_data.

  DATA: ls_impr TYPE impr.

  CLEAR: p_prnam, p_post1, gv_izwek, gv_bukrs, gv_werks, gv_usr008.

  " Get IM position data
  SELECT SINGLE * FROM impr INTO ls_impr WHERE posnr = p_posnr.

  IF sy-subrc = 0.
    " Auto-populate fields
    p_prnam = ls_impr-prnam.       " IM Program
    p_post1 = ls_impr-post1.       " Description
    gv_izwek = ls_impr-izwek.      " Investment Reason
    gv_usr008 = ls_impr-usr008.    " CAR Approval Date
    
    " ★ CRITICAL: Store Company Code from PBUKR
    gv_bukrs = ls_impr-pbukr.
    
    " Get Plant from Cost Center
    IF ls_impr-kostl IS NOT INITIAL.
      SELECT SINGLE werks FROM csks INTO gv_werks
        WHERE kokrs = ls_impr-kokrs
          AND kostl = ls_impr-kostl
          AND datbi >= sy-datum
          AND datab <= sy-datum.
    ENDIF.
    
    " Get Project Profile and Template from configuration
    SELECT SINGLE profl, pspnr FROM ztb_a2r_conftab1
      INTO (p_profl, p_pspnr)
      WHERE izwek = gv_izwek.
    
    IF sy-subrc <> 0.
      MESSAGE e010(zcj00) WITH 'No template for investment reason' gv_izwek.
      CLEAR: p_profl, p_pspnr.
    ENDIF.
    
  ELSE.
    MESSAGE e009(zcj00) WITH 'IM Position not found:' p_posnr.
  ENDIF.

ENDFORM.



*&---------------------------------------------------------------------*
*& Form POPULATE_HEADER_STRUCTURE
*&---------------------------------------------------------------------*
*& Populate header structure from screen fields
*&---------------------------------------------------------------------*
FORM populate_header_structure.

  CLEAR gs_header.

  " ★ CRITICAL: Ensure Company Code is populated
  IF gv_bukrs IS INITIAL.
    SELECT SINGLE pbukr FROM impr
      INTO gv_bukrs
      WHERE posnr = p_posnr.
  ENDIF.

  " Validate Company Code exists
  IF gv_bukrs IS INITIAL.
    MESSAGE e046(zcj00) WITH 'Company Code not found for IM position' p_posnr.
    RETURN.
  ENDIF.

  " Populate header structure
  gs_header-bukrs = gv_bukrs.          " Company Code (from IMPR-PBUKR)
  gs_header-posnr = p_posnr.           " IM Position Number
  gs_header-prnam = p_prnam.           " IM Program
  gs_header-post1 = p_post1.           " Description
  gs_header-vernr = p_verna;           " Person Responsible
  gs_header-plsez = p_plsez.           " Finish Date
  gs_header-werks = gv_werks.          " Plant
  gs_header-prctr = p_prctr.           " Profit Center
  gs_header-kostl = p_kostl.           " Cost Center
  gs_header-izwek = gv_izwek.          " Investment Reason
  gs_header-zunifier_proj = p_usr10.   " GE Ariba Flag
  gs_header-usr008 = gv_usr008.        " CAR Approval Date
  gs_header-z_reqtype = gc_reqtype_a1. " Request Type (A1)
  gs_header-z_remarks = gv_z_remarks.  " Remarks

  " Get Project Profile from configuration
  IF gs_header-profl IS INITIAL.
    SELECT SINGLE profl FROM ztb_a2r_conftab1
      INTO gs_header-profl
      WHERE izwek = gs_header-izwek.
    
    IF sy-subrc <> 0.
      MESSAGE e045(zcj00) WITH 'No project profile for investment reason' gs_header-izwek.
      RETURN.
    ENDIF.
  ENDIF.

ENDFORM.




*&---------------------------------------------------------------------*
*& Form LOAD_TEMPLATE_TO_WBS_ITEMS
*&---------------------------------------------------------------------*
FORM load_template_to_wbs_items.

  DATA: ls_wbs TYPE ztb_a2r_wbsitem.

  " ★ Get Company Code from IMPR before loading template
  IF gv_bukrs IS INITIAL.
    SELECT SINGLE pbukr FROM impr
      INTO gv_bukrs
      WHERE posnr = p_posnr.
  ENDIF.

  " Clear existing table
  REFRESH gt_wbs_items.

  " Load template structure
  CALL METHOD go_builder->copy_template_structure
    EXPORTING
      iv_pspid = p_pspnr
      iv_kostl = p_kostl
    CHANGING
      ct_wbs_items = gt_wbs_items.

  " ★ Assign Company Code and Plant to all WBS items
  LOOP AT gt_wbs_items INTO ls_wbs.
    ls_wbs-bukrs = gv_bukrs.    " From IMPR-PBUKR
    ls_wbs-werks = gv_werks.    " From CSKS
    MODIFY gt_wbs_items FROM ls_wbs.
  ENDLOOP.

  " Convert and display
  PERFORM convert_to_display.

ENDFORM.




*&---------------------------------------------------------------------*
*& Form VALIDATE_APPROVER_MATRIX
*&---------------------------------------------------------------------*
*& Validate that approver configuration exists
*&---------------------------------------------------------------------*
FORM validate_approver_matrix USING    iv_bukrs   TYPE bukrs
                                       iv_profl   TYPE profidproj
                                       iv_reqtype TYPE ztb_a2r_reqtype-z_reqtype
                              CHANGING cv_error   TYPE abap_bool.

  DATA: lv_appr1         TYPE char8,
        lv_appr2         TYPE char8,
        lv_auto          TYPE char1,
        lv_error_handler TYPE char8,
        lv_found         TYPE abap_bool,
        lt_l1_approvers  TYPE hpa_t_bname,
        lt_l2_approvers  TYPE hpa_t_bname.

  CLEAR cv_error.

  " Use the class method to check approver matrix
  lv_found = go_builder->check_approver_matrix(
    EXPORTING
      iv_bukrs   = iv_bukrs
      iv_profl   = iv_profl
      iv_reqtype = iv_reqtype
    IMPORTING
      ev_appr1         = lv_appr1
      ev_appr2         = lv_appr2
      ev_auto          = lv_auto
      ev_error_handler = lv_error_handler
      et_l1_approvers  = lt_l1_approvers
      et_l2_approvers  = lt_l2_approvers
  ).

  IF lv_found = abap_false.
    MESSAGE e023(zcj00) WITH 'No approver config for' iv_bukrs iv_profl iv_reqtype.
    cv_error = abap_true.
    RETURN.
  ENDIF.

  " Check for auto-approval
  IF lv_auto = 'X'.
    MESSAGE w042(zcj00) WITH 'No approvers - request will be auto-approved'.
    CLEAR cv_error.
    RETURN.
  ENDIF.

  " Validate that we found actual users
  IF lt_l1_approvers IS INITIAL AND lt_l2_approvers IS INITIAL.
    MESSAGE e043(zcj00) WITH 'Approvers configured but no users in HRP1001'.
    cv_error = abap_true.
    RETURN.
  ENDIF.

  " Success
  MESSAGE s044(zcj00) WITH lines( lt_l1_approvers ) 'L1 and' 
                           lines( lt_l2_approvers ) 'L2 approvers found'.
  CLEAR cv_error.

ENDFORM.




*&---------------------------------------------------------------------*
*& Form GET_USER_FULLNAME
*&---------------------------------------------------------------------*
*& Convert SAP username to full name
*&---------------------------------------------------------------------*
FORM get_user_fullname USING    iv_uname      TYPE xubname
                       CHANGING cv_fullname   TYPE char50.

  DATA: ls_usr21 TYPE usr21,
        ls_adrp  TYPE adrp.

  CLEAR cv_fullname.

  " Get person number from username
  SELECT SINGLE * FROM usr21
    INTO ls_usr21
    WHERE bname = iv_uname.

  IF sy-subrc = 0 AND ls_usr21-persnumber IS NOT INITIAL.
    
    " Get full name from address data
    SELECT SINGLE * FROM adrp
      INTO ls_adrp
      WHERE persnumber = ls_usr21-persnumber.

    IF sy-subrc = 0.
      " Build full name: First Name Last Name
      IF ls_adrp-name_first IS NOT INITIAL OR ls_adrp-name_last IS NOT INITIAL.
        CONCATENATE ls_adrp-name_first ls_adrp-name_last
          INTO cv_fullname SEPARATED BY space.
        CONDENSE cv_fullname.
      ELSE.
        cv_fullname = iv_uname.
      ENDIF.
    ELSE.
      cv_fullname = iv_uname.
    ENDIF.
    
  ELSE.
    cv_fullname = iv_uname.
  ENDIF.

ENDFORM.




*&---------------------------------------------------------------------*
*& Form GET_IM_POSID_EXTERNAL
*&---------------------------------------------------------------------*
*& Convert IM internal POSNR to external POSID
*&---------------------------------------------------------------------*
FORM get_im_posid_external USING    iv_posnr         TYPE im_posnr
                           CHANGING cv_posid_external TYPE im_posid.

  CLEAR cv_posid_external.

  IF iv_posnr IS NOT INITIAL.
    SELECT SINGLE posid
      FROM impr
      INTO cv_posid_external
      WHERE posnr = iv_posnr.

    IF sy-subrc <> 0.
      cv_posid_external = iv_posnr.
    ENDIF.
  ENDIF.

ENDFORM.




*&---------------------------------------------------------------------*
*& Module SET_HEADER_DISPLAY_VALUES OUTPUT
*&---------------------------------------------------------------------*
MODULE set_header_display_values OUTPUT.

  DATA: lv_fullname     TYPE char50,
        lv_reqtype_text TYPE char20,
        lv_im_posid     TYPE im_posid.

  " ★ CRITICAL: Get Company Code from IMPR if not already set
  IF gv_bukrs IS INITIAL.
    SELECT SINGLE pbukr FROM impr
      INTO gv_bukrs
      WHERE posnr = p_posnr.
    
    IF sy-subrc <> 0 OR gv_bukrs IS INITIAL.
      MESSAGE e046(zcj00) WITH 'Cannot determine Company Code for IM' p_posnr.
    ENDIF.
  ENDIF.

  " Convert username to full name
  IF gs_header-ernam IS NOT INITIAL.
    PERFORM get_user_fullname 
      USING    gs_header-ernam
      CHANGING lv_fullname.
    gv_requestor_display = lv_fullname.
  ELSE.
    gv_requestor_display = sy-uname.
  ENDIF.

  " Convert request type
  IF gs_header-z_reqtype IS NOT INITIAL.
    PERFORM get_request_type_text
      USING    gs_header-z_reqtype
      CHANGING lv_reqtype_text.
    gv_reqtype_display = lv_reqtype_text.
  ELSE.
    gv_reqtype_display = 'Create'.
  ENDIF.

  " Convert IM POSNR to external POSID
  IF p_posnr IS NOT INITIAL.
    PERFORM get_im_posid_external
      USING    p_posnr
      CHANGING lv_im_posid.
    gv_im_posid_display = lv_im_posid.
    gv_posnr_display = lv_im_posid.
  ENDIF.

ENDMODULE.




