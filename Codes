## ADD THESE 5 NEW FORMS AT THE END OF FILE (BEFORE GET_USER_FULLNAME):

*&———————————————————————*
*& Form GET_IM_POSID_FOR_DISPLAY
*&———————————————————————*
FORM get_im_posid_for_display USING    iv_posnr         TYPE im_posnr
CHANGING cv_posid_display TYPE im_posid.

CLEAR cv_posid_display.

IF iv_posnr IS NOT INITIAL.
SELECT SINGLE posid
FROM impr
INTO cv_posid_display
WHERE posnr = iv_posnr.

```
IF sy-subrc <> 0.
  cv_posid_display = iv_posnr.
ENDIF.
```

ENDIF.

ENDFORM.

*&———————————————————————*
*& Form GET_AVAILABLE_BUDGET_DISPLAY
*&———————————————————————*
FORM get_available_budget_display USING    iv_posnr         TYPE im_posnr
CHANGING cv_budget_text   TYPE char10
cv_budget_amount TYPE bpge-wlges.

DATA: lv_objnr TYPE j_objnr,
lv_wlges TYPE bpge-wlges,
lv_wtgev TYPE bpge-wtgev,
lv_avail TYPE bpge-wlges.

CLEAR: cv_budget_text, cv_budget_amount.

SELECT SINGLE objnr
FROM impr
INTO lv_objnr
WHERE posnr = iv_posnr.

IF sy-subrc = 0 AND lv_objnr IS NOT INITIAL.

```
SELECT SINGLE wlges wtgev
  FROM bpge
  INTO (lv_wlges, lv_wtgev)
  WHERE objnr = lv_objnr.

IF sy-subrc = 0.
  lv_avail = lv_wlges - lv_wtgev.
  cv_budget_amount = lv_avail.

  IF lv_avail > 0.
    cv_budget_text = 'Yes'.
  ELSE.
    cv_budget_text = 'No'.
  ENDIF.
ELSE.
  cv_budget_text = 'No'.
  cv_budget_amount = 0.
ENDIF.
```

ELSE.
cv_budget_text = ‘No’.
cv_budget_amount = 0.
ENDIF.

ENDFORM.

*&———————————————————————*
*& Form GET_PROJECT_CURRENCY
*&———————————————————————*
FORM get_project_currency USING    iv_pspnr         TYPE ps_pspnr
CHANGING cv_currency      TYPE waers.

CLEAR cv_currency.

IF iv_pspnr IS NOT INITIAL.
SELECT SINGLE pwhie
FROM proj
INTO cv_currency
WHERE pspnr = iv_pspnr.

```
IF sy-subrc <> 0.
  SELECT SINGLE waers
    FROM t001
    INTO cv_currency
    WHERE bukrs = gv_bukrs.
ENDIF.
```

ENDIF.

ENDFORM.

*&———————————————————————*
*& Form CONVERT_WBS_POSID_TO_EXTERNAL
*&———————————————————————*
FORM convert_wbs_posid_to_external USING    iv_posid_internal TYPE ps_posid
CHANGING cv_posid_external TYPE ps_posid.

CLEAR cv_posid_external.

IF iv_posid_internal IS NOT INITIAL.
CALL FUNCTION ‘CONVERSION_EXIT_ABPSP_OUTPUT’
EXPORTING
input  = iv_posid_internal
IMPORTING
output = cv_posid_external
EXCEPTIONS
OTHERS = 1.

```
IF sy-subrc <> 0 OR cv_posid_external IS INITIAL.
  cv_posid_external = iv_posid_internal.
ENDIF.
```

ENDIF.

ENDFORM.

*&———————————————————————*
*& Form CONVERT_WBS_POSID_TO_INTERNAL
*&———————————————————————*
FORM convert_wbs_posid_to_internal USING    iv_posid_external TYPE ps_posid
CHANGING cv_posid_internal TYPE ps_posid.

CLEAR cv_posid_internal.

IF iv_posid_external IS NOT INITIAL.
CALL FUNCTION ‘CONVERSION_EXIT_ABPSP_INPUT’
EXPORTING
input  = iv_posid_external
IMPORTING
output = cv_posid_internal
EXCEPTIONS
OTHERS = 1.

```
IF sy-subrc <> 0 OR cv_posid_internal IS INITIAL.
  cv_posid_internal = iv_posid_external.
ENDIF.
```

ENDIF.

ENDFORM.

