MODULE status_0200 OUTPUT.
  SET PF-STATUS 'STATUS_200'.
  SET TITLEBAR 'TITLE_200'.

  " Handle field editability
  LOOP AT SCREEN.
    " Finish Date: Not editable for Lumpsum
    IF screen-name = 'P_PLSEZ' AND gv_izwek = 'LS'.
      screen-input = 0.
      MODIFY SCREEN.
    ENDIF.

    " GE Ariba Flag: Never editable
    IF screen-name = 'P_USR10'.
      screen-input = 0.
      MODIFY SCREEN.
    ENDIF.
  ENDLOOP.
ENDMODULE.



MODULE display_tree_preview OUTPUT.

  " Only proceed if template is set
  CHECK p_pspid IS NOT INITIAL.

  " Create tree on first call
  IF lo_tree_preview IS INITIAL.
    PERFORM create_tree_control.
    " Verify creation succeeded
    CHECK lo_tree_preview IS NOT INITIAL.
  ENDIF.

  " Load or reload data if template changed
  IF p_pspid NE gv_pspid_old.
    PERFORM load_tree_hierarchy.
    gv_pspid_old = p_pspid.
  ENDIF.

ENDMODULE.



*&---------------------------------------------------------------------*
*& Form CREATE_TREE_CONTROL
*&---------------------------------------------------------------------*
FORM create_tree_control.

  DATA: lv_error TYPE string.

  " Don't create if already exists
  CHECK lo_tree_preview IS INITIAL.

  TRY.
      " Create container
      CREATE OBJECT lo_cont_preview
        EXPORTING
          container_name = gc_tree_container.

      " Set header
      CLEAR ls_hierarchy_header.
      ls_hierarchy_header-heading = 'Project Structure: Description'.
      ls_hierarchy_header-tooltip = 'Project Structure: Description'.
      ls_hierarchy_header-width   = 40.

      " Create tree
      CREATE OBJECT lo_tree_preview
        EXPORTING
          parent                = lo_cont_preview
          node_selection_mode   = 0
          item_selection        = space
          hierarchy_column_name = lc_hierarchy_short_text
          hierarchy_header      = ls_hierarchy_header.

      " Add column
      CALL METHOD lo_tree_preview->add_column
        EXPORTING
          name        = lc_hierarchy_technical_key
          width       = 30
          alignment   = cl_gui_column_tree=>align_left
          header_text = 'Identification'.

      " Set alignment (CFW workaround)
      CALL METHOD lo_tree_preview->set_alignment
        EXPORTING
          alignment = 15.

      lv_tree_loaded = abap_true.

    CATCH cx_root INTO DATA(lx_error).
      " Clean up on error
      IF lo_tree_preview IS NOT INITIAL.
        FREE lo_tree_preview.
      ENDIF.
      IF lo_cont_preview IS NOT INITIAL.
        FREE lo_cont_preview.
      ENDIF.
      MESSAGE lx_error->get_text( ) TYPE 'S' DISPLAY LIKE 'E'.
  ENDTRY.

ENDFORM.




*&---------------------------------------------------------------------*
*& Form LOAD_TREE_HIERARCHY
*&---------------------------------------------------------------------*
FORM load_tree_hierarchy.

  DATA: ls_proj TYPE proj.

  " Prerequisites check
  CHECK p_pspid IS NOT INITIAL.
  CHECK lo_tree_preview IS NOT INITIAL.

  TRY.
      " Clear old data
      CLEAR: gt_treev_node, gt_treeitm, gs_objects_in_tree.

      " Refresh cache
      CALL FUNCTION 'CNPB_H_PROJ_HIER_REFRESH'.

      " Get project
      SELECT SINGLE * FROM proj INTO ls_proj
        WHERE pspid = p_pspid.

      IF sy-subrc <> 0.
        MESSAGE 'Template not found' TYPE 'S'.
        RETURN.
      ENDIF.

      " Set objects
      CLEAR ls_objects_in_hierarchy.
      ls_objects_in_hierarchy-proj = abap_true.
      ls_objects_in_hierarchy-prps = abap_true.
      ls_objects_in_hierarchy-pstx = abap_true.

      " Get hierarchy
      CALL FUNCTION 'CNPB_H_PROJ_HIER_SELECT'
        EXPORTING
          i_objects_in_hierarchy = ls_objects_in_hierarchy
          i_vsnmr                = ''
          i_pspid                = p_pspid
          i_aufnr                = ''
          i_flg_enqueue          = space
          i_expand_levels        = 06
        IMPORTING
          et_treeitm             = gt_treeitm
          et_treev_node          = gt_treev_node
          e_objects_in_hierarchy = gs_objects_in_tree
        EXCEPTIONS
          OTHERS                 = 1.

      IF sy-subrc <> 0 OR gt_treev_node IS INITIAL.
        MESSAGE 'No hierarchy data' TYPE 'S'.
        RETURN.
      ENDIF.

      " Clear tree
      CALL METHOD lo_tree_preview->delete_all_nodes.

      " Set header
      CALL METHOD lo_tree_preview->hierarchy_header_set_text
        EXPORTING
          text = 'Project Structure: Description'.

      " Add nodes
      CALL METHOD lo_tree_preview->add_nodes_and_items
        EXPORTING
          node_table                = gt_treev_node
          item_table                = gt_treeitm
          item_table_structure_name = 'CNPB_H_TREEITM'.

      " Expand
      CALL METHOD lo_tree_preview->expand_root_nodes
        EXPORTING
          level_count    = 0
          expand_subtree = space.

      " Set widths
      CALL METHOD lo_tree_preview->hierarchy_header_set_width
        EXPORTING
          width     = 40
          width_pix = space.

      CALL METHOD lo_tree_preview->column_set_width
        EXPORTING
          column_name = lc_hierarchy_technical_key
          width       = 21
          width_pix   = space.

      " Flush
      CALL METHOD cl_gui_cfw=>flush.

    CATCH cx_root INTO DATA(lx_error).
      MESSAGE lx_error->get_text( ) TYPE 'S' DISPLAY LIKE 'E'.
  ENDTRY.

ENDFORM.




