  SELECT SINGLE * FROM csks
  INTO ls_csks
  WHERE kostl = iv_kostl
  AND kokrs = iv_kokrs
  AND datab <= iv_plsez
  AND datbi >= iv_plsez.

  IF sy-subrc = 0.
    CLEAR cv_error.
  ELSE.
    MESSAGE e005 WITH iv_kostl iv_plsez.
    cv_error = gc_x.
  ENDIF.
