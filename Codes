*& SOLUTION 1: FIX THE DROPDOWN VALUE FORMAT
*&———————————————————————*

- The issue is that POSNR from IMPR might have different length
- than what the screen field expects
  *&———————————————————————*

MODULE build_im_dropdown OUTPUT.

DATA: ls_value TYPE vrm_value.

CHECK gt_im_dropdown IS INITIAL.

“ CRITICAL FIX: Convert POSNR to exact format expected by screen
SELECT i~posid, i~posnr, i~prnam, i~gjahr, i~izwek
FROM impr AS i
INNER JOIN ztb_a2r_conftab1 AS c
ON c~izwek = i~izwek
INTO @DATA(ls_impr)
ORDER BY i~posid DESCENDING
UP TO 500 ROWS.

```
CLEAR ls_value.

" KEY = POSNR (must be exact format as screen field!)
" Apply ALPHA conversion to ensure leading zeros
CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
  EXPORTING
    input  = ls_impr-posnr
  IMPORTING
    output = ls_value-key.

" TEXT = POSNR + POSID + PRNAM (what user sees)
" Show internal number first for clarity
CONCATENATE ls_value-key ls_impr-posid '-' ls_impr-prnam
  INTO ls_value-text SEPARATED BY space.

APPEND ls_value TO gt_im_dropdown.
```

ENDSELECT.

“ Bind dropdown values to P_POSNR field
CALL FUNCTION ‘VRM_SET_VALUES’
EXPORTING
id              = ‘P_POSNR’
values          = gt_im_dropdown
EXCEPTIONS
id_illegal_name = 1
OTHERS          = 2.

ENDMODULE.

