*&---------------------------------------------------------------------*
*& Form GET_PROFILE_TEMPLATE
*&---------------------------------------------------------------------*
FORM get_profile_template USING iv_izwek TYPE izwek
                          CHANGING cv_profl TYPE profidproj
                                   cv_pspid TYPE ps_pspid.

  DATA: ls_config TYPE ztb_a2r_conftab1,
        lv_pspnr  TYPE ps_pspnr.

  " FDS Step 1: Get config using Investment Reason (IZWEK)
  SELECT SINGLE profl pspnr
    FROM ztb_a2r_conftab1
    INTO (cv_profl, lv_pspnr)
    WHERE izwek = iv_izwek.

  IF sy-subrc <> 0.
    MESSAGE w003 WITH 'No configuration found for IZWEK' iv_izwek.
    CLEAR: cv_profl, cv_pspid.
    RETURN.
  ENDIF.

  " FDS Step 2: Get POSID (PSPID) from PSPNR
  " Try PRPS table (WBS elements)
  SELECT SINGLE posid
    FROM prps
    INTO cv_pspid
    WHERE pspnr = lv_pspnr.

  IF sy-subrc <> 0.
    " Fallback: Try PROJ table (project headers)
    SELECT SINGLE pspid
      FROM proj
      INTO cv_pspid
      WHERE pspnr = lv_pspnr.
  ENDIF.

  IF cv_pspid IS INITIAL.
    MESSAGE w003 WITH 'Template not found for PSPNR' lv_pspnr.
    CLEAR: cv_profl, cv_pspid.
  ENDIF.

ENDFORM.




*&---------------------------------------------------------------------*
*& Form LOAD_TREE_HIERARCHY
*&---------------------------------------------------------------------*
FORM load_tree_hierarchy.

  DATA: ls_prps       TYPE prps,
        lv_psphi      TYPE ps_pspnr,
        lv_pspid_proj TYPE ps_pspid.

  " Prerequisites check
  CHECK p_pspid IS NOT INITIAL.
  CHECK lo_tree_preview IS NOT INITIAL.

  TRY.
      " Clear old data
      CLEAR: gt_treev_node, gt_treeitm, gs_objects_in_tree.

      " Refresh cache
      CALL FUNCTION 'CNPB_H_PROJ_HIER_REFRESH'.

      " FDS: Get WBS hierarchy from PRPSS using template POSID (p_pspid)
      " First, get the WBS element details from PRPS
      SELECT SINGLE *
        FROM prps
        INTO ls_prps
        WHERE posid = p_pspid.

      IF sy-subrc <> 0.
        MESSAGE 'Template WBS element not found in PRPS' TYPE 'S' DISPLAY LIKE 'W'.
        RETURN.
      ENDIF.

      " Get parent project PSPNR
      lv_psphi = ls_prps-psphi.

      " Convert parent PSPNR to PSPID for hierarchy function
      SELECT SINGLE pspid
        FROM proj
        INTO lv_pspid_proj
        WHERE pspnr = lv_psphi.

      IF sy-subrc <> 0.
        MESSAGE 'Parent project not found' TYPE 'S' DISPLAY LIKE 'W'.
        RETURN.
      ENDIF.

      " Set objects to display
      CLEAR ls_objects_in_hierarchy.
      ls_objects_in_hierarchy-proj = abap_true.
      ls_objects_in_hierarchy-prps = abap_true.
      ls_objects_in_hierarchy-pstx = abap_true.

      " FDS: Get hierarchy using parent project PSPID
      CALL FUNCTION 'CNPB_H_PROJ_HIER_SELECT'
        EXPORTING
          i_objects_in_hierarchy = ls_objects_in_hierarchy
          i_vsnmr                = ''
          i_pspid                = lv_pspid_proj
          i_aufnr                = ''
          i_flg_enqueue          = space
          i_expand_levels        = 06
        IMPORTING
          et_treeitm             = gt_treeitm
          et_treev_node          = gt_treev_node
          e_objects_in_hierarchy = gs_objects_in_tree
        EXCEPTIONS
          OTHERS                 = 1.

      IF sy-subrc <> 0 OR gt_treev_node IS INITIAL.
        MESSAGE 'Error loading project hierarchy' TYPE 'S' DISPLAY LIKE 'W'.
        RETURN.
      ENDIF.

      " Clear tree
      CALL METHOD lo_tree_preview->delete_all_nodes.

      " Set header
      CALL METHOD lo_tree_preview->hierarchy_header_set_text
        EXPORTING
          text = 'Project Structure: Description'.

      " Add nodes
      CALL METHOD lo_tree_preview->add_nodes_and_items
        EXPORTING
          node_table                = gt_treev_node
          item_table                = gt_treeitm
          item_table_structure_name = 'CNPB_H_TREEITM'.

      " Expand
      CALL METHOD lo_tree_preview->expand_root_nodes
        EXPORTING
          level_count    = 0
          expand_subtree = space.

      " Set widths
      CALL METHOD lo_tree_preview->hierarchy_header_set_width
        EXPORTING
          width     = 40
          width_pix = space.

      CALL METHOD lo_tree_preview->column_set_width
        EXPORTING
          column_name = lc_hierarchy_technical_key
          width       = 21
          width_pix   = space.

      " Flush
      CALL METHOD cl_gui_cfw=>flush.

    CATCH cx_root INTO DATA(lx_error).
      MESSAGE lx_error->get_text( ) TYPE 'S' DISPLAY LIKE 'E'.
  ENDTRY.

ENDFORM.
