*& Form LOAD_SIMPLE_PREVIEW_FALLBACK - CORRECTED
*&———————————————————————*
FORM load_simple_preview_fallback.

  DATA: lv_pspnr TYPE ps_pspnr.

  " CORRECTED: Use PROJS first, then PROJ as fallback
  SELECT SINGLE pspnr FROM projs INTO lv_pspnr
  WHERE pspid = p_pspid.

  IF sy-subrc <> 0.
    SELECT SINGLE pspnr FROM proj INTO lv_pspnr
    WHERE pspid = p_pspid.
  ENDIF.

  CHECK sy-subrc = 0.

  " Use PRPSS for preview (screenshot 5)
  SELECT * FROM prpss INTO TABLE gt_preview_data
  WHERE psphi = lv_pspnr
  ORDER BY stufe posid.

  MESSAGE i001 WITH 'Tree view not available, showing list view'.

ENDFORM.

