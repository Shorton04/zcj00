      CALL FUNCTION 'STATUS_CHANGE_INTERN'
        EXPORTING
          client              = sy-mandt
          objnr               = lv_wbs_objnr
          user_stat           = 'SETC'
          set_inact           = ''
        EXCEPTIONS
          object_not_found    = 1
          status_inconsistent = 2
          OTHERS              = 3.
    ELSE.
      MESSAGE e024(zcj00).
      rv_success = abap_false.
      RETURN.
    ENDIF.
