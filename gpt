*&———————————————————————*
*& Form LOAD_TREE_HIERARCHY
*&———————————————————————*

- FDS Requirements:
- 1. Get Project Template PROJS-PSPID
- 1. Get WBS hierarchy from PRPSS using PROJS-PSPID
- 1. Display hierarchical view with PROJS-PSPID, PROJS-POST1, PRPSS-POST1
   *&———————————————————————*
   FORM load_tree_hierarchy.

DATA: ls_projs        TYPE projs,
lt_prpss        TYPE TABLE OF prpss,
ls_prpss        TYPE prpss,
lv_pspnr_templ  TYPE ps_pspnr,
lv_node_key     TYPE lvc_nkey,
lv_parent_key   TYPE lvc_nkey,
ls_node         TYPE treev_node,
ls_item         TYPE cnpb_h_treeitm,
lv_last_key     TYPE lvc_nkey VALUE 0,
lt_level_keys   TYPE TABLE OF lvc_nkey.

“ Prerequisites check
CHECK p_pspid IS NOT INITIAL.
CHECK lo_tree_preview IS NOT INITIAL.

TRY.
“ Clear previous data
CLEAR: gt_treev_node, gt_treeitm.

```
  " ===================================================================
  " STEP 1: Get Project Template PROJS-PSPID (FDS Requirement 1)
  " ===================================================================
  SELECT SINGLE * FROM projs INTO ls_projs
    WHERE pspid = p_pspid.

  IF sy-subrc <> 0.
    " Try with conversion exit
    CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
      EXPORTING
        input  = p_pspid
      IMPORTING
        output = p_pspid.

    SELECT SINGLE * FROM projs INTO ls_projs
      WHERE pspid = p_pspid.

    IF sy-subrc <> 0.
      MESSAGE 'Template project not found in PROJS table' TYPE 'S' DISPLAY LIKE 'W'.
      RETURN.
    ENDIF.
  ENDIF.

  lv_pspnr_templ = ls_projs-pspnr.

  " ===================================================================
  " STEP 2: Get WBS hierarchy from PRPSS (FDS Requirement 2)
  " ===================================================================
  SELECT * FROM prpss
    INTO TABLE lt_prpss
    WHERE psphi = lv_pspnr_templ
    ORDER BY stufe posid.

  IF sy-subrc <> 0.
    MESSAGE 'No WBS elements found for template' TYPE 'S' DISPLAY LIKE 'W'.
    RETURN.
  ENDIF.

  " ===================================================================
  " STEP 3: Build hierarchical tree (FDS Requirement 3)
  " Display: PROJS-PSPID, PROJS-POST1, PRPSS-POST1
  " ===================================================================

  " Create root node for Project Template
  lv_last_key = lv_last_key + 1.
  CLEAR ls_node.
  ls_node-node_key    = lv_last_key.
  ls_node-relatkey    = ''.
  ls_node-relatship   = cl_gui_column_tree=>relat_last_child.
  ls_node-hidden      = space.
  ls_node-disabled    = space.
  ls_node-isfolder    = abap_true.
  ls_node-expander    = abap_true.
  APPEND ls_node TO gt_treev_node.

  " Add description item (PROJS-POST1)
  CLEAR ls_item.
  ls_item-node_key = lv_last_key.
  ls_item-item_name = lc_hierarchy_short_text.
  ls_item-class = cl_gui_column_tree=>item_class_text.
  CONCATENATE 'Template:' ls_projs-post1 INTO ls_item-text SEPARATED BY space.
  APPEND ls_item TO gt_treeitm.

  " Add identification item (PROJS-PSPID)
  CLEAR ls_item.
  ls_item-node_key = lv_last_key.
  ls_item-item_name = lc_hierarchy_technical_key.
  ls_item-class = cl_gui_column_tree=>item_class_text.
  ls_item-text = ls_projs-pspid.
  APPEND ls_item TO gt_treeitm.

  " Store root key for level tracking
  CLEAR lt_level_keys.
  APPEND lv_last_key TO lt_level_keys.

  " Build WBS hierarchy nodes from PRPSS
  LOOP AT lt_prpss INTO ls_prpss.

    lv_last_key = lv_last_key + 1.

    " Determine parent key based on level
    IF ls_prpss-stufe = 1.
      " Level 1 WBS: Parent is root (template)
      READ TABLE lt_level_keys INTO lv_parent_key INDEX 1.
    ELSE.
      " Higher levels: Parent is previous level
      READ TABLE lt_level_keys INTO lv_parent_key INDEX ls_prpss-stufe.
    ENDIF.

    " Create node for WBS element
    CLEAR ls_node.
    ls_node-node_key    = lv_last_key.
    ls_node-relatkey    = lv_parent_key.
    ls_node-relatship   = cl_gui_column_tree=>relat_last_child.
    ls_node-hidden      = space.
    ls_node-disabled    = space.
    ls_node-isfolder    = abap_false.
    ls_node-expander    = space.
    APPEND ls_node TO gt_treev_node.

    " Add description item (PRPSS-POST1)
    CLEAR ls_item.
    ls_item-node_key = lv_last_key.
    ls_item-item_name = lc_hierarchy_short_text.
    ls_item-class = cl_gui_column_tree=>item_class_text.
    ls_item-text = ls_prpss-post1.
    APPEND ls_item TO gt_treeitm.

    " Add identification item (PRPSS-POSID)
    CLEAR ls_item.
    ls_item-node_key = lv_last_key.
    ls_item-item_name = lc_hierarchy_technical_key.
    ls_item-class = cl_gui_column_tree=>item_class_text.
    ls_item-text = ls_prpss-posid.
    APPEND ls_item TO gt_treeitm.

    " Update level tracking for parent relationships
    IF ls_prpss-stufe + 1 > lines( lt_level_keys ).
      APPEND lv_last_key TO lt_level_keys.
    ELSE.
      MODIFY lt_level_keys FROM lv_last_key INDEX ( ls_prpss-stufe + 1 ).
    ENDIF.

  ENDLOOP.

  " ===================================================================
  " Display the tree
  " ===================================================================

  " Delete existing nodes
  CALL METHOD lo_tree_preview->delete_all_nodes.

  " Set hierarchy header
  CALL METHOD lo_tree_preview->hierarchy_header_set_text
    EXPORTING
      text = 'Project Structure: Description'.

  " Add nodes and items to tree
  CALL METHOD lo_tree_preview->add_nodes_and_items
    EXPORTING
      node_table                = gt_treev_node
      item_table                = gt_treeitm
      item_table_structure_name = 'CNPB_H_TREEITM'.

  " Expand all nodes to show full hierarchy
  CALL METHOD lo_tree_preview->expand_root_nodes
    EXPORTING
      level_count    = 0
      expand_subtree = abap_true.

  " Set column widths
  CALL METHOD lo_tree_preview->hierarchy_header_set_width
    EXPORTING
      width     = 50
      width_pix = space.

  CALL METHOD lo_tree_preview->column_set_width
    EXPORTING
      column_name = lc_hierarchy_technical_key
      width       = 25
      width_pix   = space.

  " Flush to frontend (CRITICAL!)
  CALL METHOD cl_gui_cfw=>flush
    EXCEPTIONS
      cntl_system_error = 1
      cntl_error        = 2.

  IF sy-subrc = 0.
    lv_tree_loaded = abap_true.
  ENDIF.

CATCH cx_root INTO DATA(lx_error).
  MESSAGE lx_error->get_text( ) TYPE 'S' DISPLAY LIKE 'E'.
```

ENDTRY.

ENDFORM.

