METHOD create_wbs_elements.

  DATA: lv_pspid        TYPE ps_pspid,
        lt_return       TYPE TABLE OF bapiret2,
        ls_return       TYPE bapiret2,

        ls_proj_new     TYPE bapi_bus2001_new,

        lt_item         TYPE STANDARD TABLE OF ztb_a2r_wbsitem,
        ls_item         TYPE ztb_a2r_wbsitem,
        ls_item_tmp     TYPE ztb_a2r_wbsitem,

        lt_wbs_new      TYPE STANDARD TABLE OF bapi_bus2054_new,
        ls_wbs_new      TYPE bapi_bus2054_new,

        lt_extensionin TYPE STANDARD TABLE OF bapiparex,
        ls_extensionin TYPE bapiparex,
        ls_te_wbs      TYPE bapi_te_wbs_element,

        lv_upper_level TYPE ps_posid,
        lv_left_level  TYPE ps_posid,
        lv_index       TYPE i.

  rv_success = abap_false.

*--------------------------------------------------------------------*
* 1. GET PROJECT NUMBER (REFERENCE LOGIC)
*--------------------------------------------------------------------*
  lv_pspid = get_next_project_number( is_header-profl ).
  IF lv_pspid IS INITIAL.
    MESSAGE e029(zcj00) WITH 'Project number generation failed'.
    RETURN.
  ENDIF.

*--------------------------------------------------------------------*
* 2. PS INITIALIZATION
*--------------------------------------------------------------------*
  CALL FUNCTION 'BAPI_PS_INITIALIZATION'.

*--------------------------------------------------------------------*
* 3. CREATE PROJECT (CHECK_PROJ_CREATE)
*--------------------------------------------------------------------*
  CLEAR ls_proj_new.

  ls_proj_new-project_definition = lv_pspid.
  ls_proj_new-description        = is_header-post1.
  ls_proj_new-company_code       = is_header-bukrs.
  ls_proj_new-controlling_area   = is_header-vkokr.
  ls_proj_new-profit_ctr         = is_header-prctr.
  ls_proj_new-plant              = is_header-werks.
  ls_proj_new-project_profile    = is_header-profl.
  ls_proj_new-start              = is_header-plfaz.
  ls_proj_new-finish             = is_header-plsez.
  ls_proj_new-responsible_no     = is_header-vernr.

  CALL FUNCTION 'BAPI_BUS2001_CREATE'
    EXPORTING
      i_project_definition = ls_proj_new
    TABLES
      et_return            = lt_return.

  LOOP AT lt_return INTO ls_return WHERE type CA 'EA'.
    MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
      WITH ls_return-message_v1 ls_return-message_v2
           ls_return-message_v3 ls_return-message_v4.
    RETURN.
  ENDLOOP.

*--------------------------------------------------------------------*
* 4. BUILD WBS ELEMENTS (CHECK_PRPS_CREATE)
*--------------------------------------------------------------------*
  lt_item = it_wbs_items.

* EXACT reference sorting
  SORT lt_item BY pspid_new DESCENDING stufe DESCENDING.

  CLEAR: lt_wbs_new, lt_extensionin.

  LOOP AT lt_item INTO ls_item.

    CLEAR: ls_wbs_new,
           ls_te_wbs,
           lv_upper_level,
           lv_left_level.

    lv_index = sy-tabix + 1.

*---------------- BASIC FIELDS ----------------*
    ls_wbs_new-wbs_element      = ls_item-pspid_new.
    ls_wbs_new-description      = ls_item-post1.
    ls_wbs_new-company_code     = is_header-bukrs.
    ls_wbs_new-business_area    = ls_item-pgsbr.
    ls_wbs_new-controlling_area = is_header-vkokr.
    ls_wbs_new-profit_ctr       = ls_item-prctr.
    ls_wbs_new-plant            = ls_item-werks.

    ls_wbs_new-wbs_planning_element = abap_true.
    ls_wbs_new-wbs_account_assignment_element = ls_item-belkz.

*---------------- DATES ----------------*
    IF gv_capex IS NOT INITIAL.
      ls_wbs_new-wbs_basic_start_date  = ls_item-plfaz.
      ls_wbs_new-wbs_basic_finish_date = ls_item-plsez.
    ELSE.
      ls_wbs_new-wbs_basic_start_date  = ls_item-zstage_st_dt.
      ls_wbs_new-wbs_basic_finish_date = ls_item-zstage_end_dt.
    ENDIF.

*---------------- HIERARCHY (REFERENCE LOGIC) ----------------*
    LOOP AT lt_item INTO ls_item_tmp FROM lv_index.

      " Left sibling
      IF lv_left_level IS INITIAL
         AND ls_item_tmp-stufe = ls_item-stufe.
        lv_left_level = ls_item_tmp-pspid_new.
      ENDIF.

      " Parent
      IF ls_item_tmp-stufe < ls_item-stufe.
        lv_upper_level = ls_item_tmp-pspid_new.
        EXIT.
      ENDIF.

    ENDLOOP.

    IF lv_upper_level IS NOT INITIAL.
      ls_wbs_new-wbs_up = lv_upper_level.
    ENDIF.

    IF lv_left_level IS NOT INITIAL.
      ls_wbs_new-wbs_left = lv_left_level.
    ENDIF.

    APPEND ls_wbs_new TO lt_wbs_new.

*---------------- EXTENSION (REFERENCE STYLE) ----------------*
    CLEAR ls_te_wbs.
    ls_te_wbs-wbs_element = ls_item-pspid_new.
    ls_te_wbs-zasset      = ls_item-zasset.
    ls_te_wbs-zcustom     = ls_item-zcustom.

    CLEAR ls_extensionin.
    ls_extensionin-structure  = 'BAPI_TE_WBS_ELEMENT'.
    ls_extensionin-valuepart1 = ls_te_wbs.
    APPEND ls_extensionin TO lt_extensionin.

  ENDLOOP.

*--------------------------------------------------------------------*
* 5. CREATE WBS (CHECK_PRPS_CREATE)
*--------------------------------------------------------------------*
  CALL FUNCTION 'BAPI_BUS2054_CREATE_MULTI'
    EXPORTING
      i_project_definition = lv_pspid
    TABLES
      it_wbs_element       = lt_wbs_new
      extensionin          = lt_extensionin
      et_return            = lt_return.

  LOOP AT lt_return INTO ls_return WHERE type CA 'EA'.
    MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
      WITH ls_return-message_v1 ls_return-message_v2
           ls_return-message_v3 ls_return-message_v4.
    RETURN.
  ENDLOOP.

*--------------------------------------------------------------------*
* 6. PRECOMMIT + COMMIT (REFERENCE)
*--------------------------------------------------------------------*
  CALL FUNCTION 'BAPI_PS_PRECOMMIT'
    TABLES
      et_return = lt_return.

  LOOP AT lt_return INTO ls_return WHERE type CA 'EA'.
    MESSAGE ID ls_return-id TYPE 'E' NUMBER ls_return-number
      WITH ls_return-message_v1 ls_return-message_v2.
    RETURN.
  ENDLOOP.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = abap_true.

  rv_success = abap_true.

ENDMETHOD.