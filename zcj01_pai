*&---------------------------------------------------------------------*
*& Module SET_HEADER_DISPLAY_VALUES OUTPUT
*&---------------------------------------------------------------------*
MODULE set_header_display_values OUTPUT.

  DATA: gv_reqtype_text     TYPE char40,
        gv_posnr_for_budget TYPE im_posnr.

  IF gv_gos_reqnum IS NOT INITIAL.
    gv_display_reqnum = gv_gos_reqnum.
  ENDIF.
  " IM position display - derive only if user did not edit
  IF gv_u_im_posid IS INITIAL.
    IF gs_header-posnr IS NOT INITIAL.
      PERFORM get_im_posid_for_display
        USING    gs_header-posnr
        CHANGING gv_im_posid_display.
      gv_posnr_display_done = abap_true.
    ENDIF.
  ENDIF.

  " Requestor display
  IF gs_header-ernam IS NOT INITIAL.
    PERFORM get_user_fullname
      USING    gs_header-ernam
      CHANGING gv_fullname.
    gv_requestor_display = gv_fullname.
  ELSE.
    PERFORM get_user_fullname
      USING    sy-uname
      CHANGING gv_fullname.
    gv_requestor_display = gv_fullname.
  ENDIF.

  " Request type text
  IF gs_header-z_reqtype IS NOT INITIAL.
    PERFORM get_request_type_text
      USING    gv_req_type
      CHANGING gv_reqtype_text.
    gv_reqtype_display = gv_reqtype_text.
  ELSE.
    gv_reqtype_display = 'Create'(c01).
  ENDIF.

  " Budget display
  IF gv_u_im_posid = abap_true AND gv_im_posid_user IS NOT INITIAL.

    SELECT SINGLE posnr
      FROM impr
      INTO @gv_posnr_for_budget
      "UP TO 1 ROWS
      WHERE posid = @gv_im_posid_user.
    "ENDSELECT.

    IF sy-subrc <> 0.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = gv_im_posid_user
        IMPORTING
          output = gv_posnr_for_budget.

      SELECT SINGLE posnr
        FROM impr
        INTO @gv_check
        WHERE posnr = @gv_posnr_for_budget.

      IF sy-subrc <> 0.
        CLEAR gv_posnr_for_budget.
      ENDIF.
    ENDIF.

    IF gv_posnr_for_budget IS NOT INITIAL.
      PERFORM get_available_budget_display
        USING    gv_posnr_for_budget
        CHANGING gv_avail_budget_text
                 gv_available_budget.
    ELSE.
      gv_avail_budget_text = 'No'.
      CLEAR gv_available_budget.
    ENDIF.

  ELSE.

    IF gs_header-posnr IS NOT INITIAL.
      PERFORM get_available_budget_display
        USING    gs_header-posnr
        CHANGING gv_avail_budget_text
                 gv_available_budget.
    ELSE.
      gv_avail_budget_text = 'No'.
      CLEAR gv_available_budget.
    ENDIF.

  ENDIF.

  " Project currency display only
  IF gs_header-pspnr IS NOT INITIAL.
    PERFORM get_project_currency
      USING    gs_header-pspnr
      CHANGING gv_project_currency.
  ELSEIF gs_header-bukrs IS NOT INITIAL.
    SELECT SINGLE waers
      FROM t001
      INTO @gv_project_currency
      WHERE bukrs = @gs_header-bukrs.
  ENDIF.

  " Restore user-edited values LAST
  IF gv_u_post1 = abap_true.
    gs_header-post1 = gs_header_user-post1.
  ENDIF.

  IF gv_u_bukrs = abap_true.
    gs_header-bukrs = gs_header_user-bukrs.
  ENDIF.

  IF gv_u_vernr = abap_true.
    gs_header-vernr = gs_header_user-vernr.
  ENDIF.

  IF gv_u_plsez = abap_true.
    gs_header-plsez = gs_header_user-plsez.
  ENDIF.

  IF gv_u_werks = abap_true.
    gs_header-werks = gs_header_user-werks.
  ENDIF.

  IF gv_u_prctr = abap_true.
    gs_header-prctr = gs_header_user-prctr.
  ENDIF.

  IF gv_u_prnam = abap_true.
    gs_header-prnam = gs_header_user-prnam.
  ENDIF.

  IF gv_u_kostl = abap_true.
    gs_header-kostl = gs_header_user-kostl.
  ENDIF.

  IF gv_u_izwek = abap_true.
    gs_header-izwek = gs_header_user-izwek.
  ENDIF.

  IF gv_u_zunifier_proj = abap_true.
    gs_header-zunifier_proj = gs_header_user-zunifier_proj.
  ENDIF.

  IF gv_u_usr008 = abap_true.
    gs_header-usr008 = gs_header_user-usr008.
  ENDIF.

  IF gv_u_im_posid = abap_true.
    gv_im_posid_display = gv_im_posid_user.
  ENDIF.

ENDMODULE.

