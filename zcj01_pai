*&---------------------------------------------------------------------*
*& Include          ZTR_A2R_WBSZCJ01_PAI
*&---------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*& Module USER_COMMAND_0200 INPUT
*&---------------------------------------------------------------------*
MODULE user_command_0200 INPUT.
  DATA: gv_ok_code TYPE sy-ucomm.

  gv_ok_code = sy-ucomm.
  CLEAR sy-ucomm.

  CASE gv_ok_code.
    WHEN 'F4_POSNR'.
*      PERFORM f4_im_number CHANGING gv_p_posnr.

    WHEN 'SOP'.
      CLEAR gv_url.
      PERFORM sop_link.
      PERFORM show_dms_link USING gv_url.

    WHEN 'BACK'.
      PERFORM free_tree_control.
      LEAVE TO TRANSACTION 'ZA2R_ZCJ00'.

    WHEN 'CANCEL'.
      PERFORM free_tree_control.
      LEAVE TO TRANSACTION 'ZA2R_ZCJ00'.

    WHEN 'EXIT'.
      PERFORM free_tree_control.
      LEAVE TO TRANSACTION 'ZA2R_ZCJ00'.

    WHEN 'NEXT' OR 'ENTER'.
      " Validation
      IF gv_p_pspid IS INITIAL.
        MESSAGE e000(zmsg_a2r) WITH 'Fill IM Number' ##NO_TEXT.
        RETURN.
      ENDIF.

      IF gv_p_post1 IS INITIAL.
        MESSAGE e000(zmsg_a2r) WITH 'Fill Project Description' ##NO_TEXT.
        RETURN.
      ENDIF.

      IF gv_p_verna IS INITIAL.
        MESSAGE e000(zmsg_a2r) WITH 'Fill Person Responsible' ##NO_TEXT.
        RETURN.
      ENDIF.

      IF gv_p_plsez IS INITIAL.
        MESSAGE e000(zmsg_a2r) WITH 'Fill Finish Date' ##NO_TEXT.
        RETURN.
      ENDIF.

      IF gv_p_plsez <= sy-datum.
        MESSAGE e000(zmsg_a2r) WITH 'Finish Date is less than from the current Date' ##NO_TEXT.
        RETURN.
      ENDIF.

      IF gv_p_prctr IS INITIAL.
        MESSAGE e000(zmsg_a2r) WITH 'Fill Profit Center' ##NO_TEXT.
        RETURN.
      ENDIF.

      IF gv_p_kostl IS INITIAL.
        MESSAGE e000(zmsg_a2r) WITH 'Fill Cost Center' ##NO_TEXT.
        RETURN.
      ENDIF.

      IF gv_p_profl IS INITIAL.
        MESSAGE e000(zmsg_a2r) WITH 'Fill Project Profile' ##NO_TEXT.
        RETURN.
      ENDIF.

      IF gv_p_pspid IS INITIAL.
        MESSAGE e000(zmsg_a2r) WITH 'Fill Project Template' ##NO_TEXT.
        RETURN.
      ENDIF.

      " Validate and go to Screen 100
      gv_req_type = 'A1'.
      gs_header-z_reqtype = 'A1'.
      PERFORM validate_screen1.
      IF sy-subrc = 0.
        PERFORM free_tree_control.
        PERFORM prepare_screen2.

        CALL SCREEN 100.
      ENDIF.
  ENDCASE.
ENDMODULE.

*&---------------------------------------------------------------------*
*& Module USER_COMMAND_0100 INPUT
*&---------------------------------------------------------------------*
MODULE user_command_0100 INPUT.
  DATA: gv_ok_code1 TYPE sy-ucomm.

  gv_ok_code1 = sy-ucomm.
  CLEAR sy-ucomm.

  PERFORM set_screen USING gs_header.
  PERFORM get_text.

  CASE gv_ok_code1.
    WHEN 'ENTER' OR ''.

    WHEN 'SAVE'. " save entry as DRAFT
      IF gv_disp_req = abap_false.
        PERFORM get_text.
        PERFORM save_request.
      ENDIF.

    WHEN 'SOP'. " call SOP link
      CLEAR gv_url.
      PERFORM sop_link.
      PERFORM show_dms_link USING gv_url.

    WHEN 'CHECK'. " execute screen validation
      PERFORM get_text.
      PERFORM validate_screen2 USING abap_false.

    WHEN 'WFLOG'. " WF Logs
      PERFORM show_workflow_log.

    WHEN 'SUBMIT'. " send for approval
      gv_on_submit = abap_true.

      " get text for remarks
      PERFORM get_text.

      " execute screen validation before submit/saving
      PERFORM validate_screen2 USING abap_false.

      CASE gv_req_type.
        WHEN 'B3'.
          PERFORM submit_b3.                "Critical Changes
        WHEN 'B2'.
          PERFORM submit_b2.                "Budget Distribution
        WHEN 'B1'.
          PERFORM submit_b1.                "CAR
        WHEN 'E1'.
          PERFORM submit_e1.                "Unclose WBS
        WHEN OTHERS.
          PERFORM submit_direct_creation.   "Create Project A1
      ENDCASE.


    WHEN 'UPLD'. " upload file
      PERFORM upload.

    WHEN 'DWNLD'. " dowwnload file
      PERFORM download.

    WHEN 'TOTALUP'. " total up approved budget
      PERFORM total_up_wbs_tc.

      PERFORM b3_level1.

    WHEN 'ADDROW'. " add row in WBS info
      PERFORM add_wbs_row.

    WHEN 'DELROW'. " delete row in WBS info
      PERFORM delete_wbs_rows.

    WHEN 'ATTCH'. " add attachment before submit
      PERFORM handle_attachments.
      CLEAR gv_rw_mode.
      gv_rw_mode = 'E'.
      PERFORM start_gos USING    gs_header-zreq_num
                                 gv_rw_mode
                        CHANGING go_gos.

    WHEN 'BACK'.
      CLEAR: gv_im_posid_display,
             gv_im_posid_user,
             gv_u_im_posid.
      CLEAR gv_p_req_num.
      gv_header_initialized = abap_false.
      SET PARAMETER ID 'ZREQN' FIELD space.
      LEAVE TO TRANSACTION 'ZA2R_ZCJ00'.

    WHEN 'EXIT' OR 'CANCEL'.
      CLEAR: gv_im_posid_display,
             gv_im_posid_user,
             gv_u_im_posid.
      CLEAR gv_p_req_num.
      SET PARAMETER ID 'ZREQN' FIELD space.
      LEAVE TO TRANSACTION 'ZA2R_ZCJ00'.

  ENDCASE.
ENDMODULE.

*&---------------------------------------------------------------------*
*& Module VALIDATE_POSNR INPUT
*&---------------------------------------------------------------------*
MODULE validate_posnr INPUT.

  DATA: gv_posnr_numeric TYPE im_posnr,
        gv_input_char    TYPE char20,
        gv_posid         TYPE im_posid.

  IF gv_p_posnr IS NOT INITIAL.


    " Save original input
    gv_input_char = gv_p_posnr.

    " Remove leading spaces and convert to uppercase
    CONDENSE gv_input_char NO-GAPS.
    TRANSLATE gv_input_char TO UPPER CASE.

    " STEP 1: Try to find as POSID (user-friendly format like "PR02")
    " This handles when user types PR02 instead of 00000011
    gv_posid = gv_input_char.

    SELECT SINGLE posnr FROM impr
      INTO @gv_posnr_numeric
      WHERE posnr = @gv_posnr_numeric
      AND posid = @gv_posid.

    IF sy-subrc = 0.
      " Found via POSID - use the POSNR we got
      gv_p_posnr = gv_posnr_numeric.
    ELSE.
      " STEP 2: Not found as POSID, try as POSNR with leading zeros
      " Apply ALPHA conversion to add leading zeros
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = gv_input_char
        IMPORTING
          output = gv_posnr_numeric.

      " Validate this POSNR exists
      SELECT SINGLE posnr FROM impr
        INTO @DATA(gv_check)
        WHERE posnr = @gv_posnr_numeric.

      IF sy-subrc = 0.
        " Found as POSNR
        gv_p_posnr = gv_posnr_numeric.
      ELSE.
        " Not found in either format
        MESSAGE e002 WITH gv_input_char. " IM Number not found
        RETURN.
      ENDIF.
    ENDIF.

    " Load data if POSNR changed
    IF gv_p_posnr <> gv_posnr_old.
      PERFORM get_im_data USING gv_p_posnr.
      gv_posnr_old = gv_p_posnr.
    ENDIF.


  ENDIF.

ENDMODULE.



*&---------------------------------------------------------------------*
*& Form PREPARE_SCREEN2
*&---------------------------------------------------------------------*
FORM prepare_screen2.
  DATA gv_error          TYPE abap_bool.

  "Always get IM data (safe, doesn't overwrite screen2 edits)
  PERFORM get_additional_im_data USING gv_p_posnr.
  IF gv_gos_reqnum IS NOT INITIAL.
    gv_display_reqnum = gv_gos_reqnum.
  ENDIF.

  IF gv_display_reqnum = 0.
    CLEAR gv_display_reqnum.
  ENDIF.

  "Initialize screen2 ONCE only
  IF gv_header_initialized = abap_true.
    RETURN.
  ENDIF.

  IF gv_disp_req = abap_true.
    gv_req_type = gs_header-z_reqtype.
  ENDIF.

  "------------------------------------------------------------
  "FIRST ENTRY ONLY
  "------------------------------------------------------------

  "=============================
  "EDIT SAVED REQUEST (F1)
  "=============================
  IF gv_edit_mode = abap_true.

    "At this point, caller already loaded:
    " - gs_header from zta2r_WBSHDR
    " - gt_wbs_items from zta2r_WBSITEM
    "So DO NOT rebuild anything from template.
*    PERFORM refresh_gt_wbs_items_from_db USING gv_loaded_reqnum.

    PERFORM convert_to_display.
    PERFORM set_wbs_default_values.  "only fills INITIAL values (safe)

    "IMPORTANT: Do NOT call populate_header_structure in edit mode
    "because it may overwrite DB header values (erdat/ernam etc.)

    gv_header_initialized = abap_true.
    RETURN.

  ENDIF.

  IF gv_request_type = 'B1'.

    PERFORM load_b1_project_and_car_wbs.

    PERFORM convert_to_display.
    PERFORM set_wbs_default_values.

    gv_header_initialized = abap_true.
    RETURN.

  ENDIF.
  IF go_builder IS INITIAL.
    "if you normally create it elsewhere, keep this defensive guard
    CREATE OBJECT go_builder.  "adjust constructor if needed
  ENDIF.
  "=============================
  "CREATE MODE (A1)
  "=============================

  " Build WBS items in correct PRHIS order
  CLEAR gt_wbs_items.
  CALL METHOD go_builder->copy_template_structure
    EXPORTING
      iv_pspid     = gv_p_pspid
      iv_kostl     = gv_p_kostl
    CHANGING
      ct_wbs_items = gt_wbs_items.

  PERFORM convert_to_display.
  PERFORM set_wbs_default_values.
  PERFORM populate_header_structure.
  PERFORM validate_approver_matrix CHANGING gv_error.

  gv_header_initialized = abap_true.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form GET_ADDITIONAL_IM_DATA
*&---------------------------------------------------------------------*
FORM get_additional_im_data USING iv_posnr TYPE im_posnr.

  SELECT SINGLE bukrs werks izwek usr08
    FROM impr
    INTO (gv_bukrs, gv_werks, gv_izwek, gv_usr008)
    WHERE posnr = iv_posnr.

  " Get available budget
  PERFORM get_available_im_budget USING iv_posnr
                                  CHANGING gv_available_budget.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form CONVERT_TO_DISPLAY
*&---------------------------------------------------------------------*

FORM convert_to_display.

  DATA gv_posid_external TYPE ps_posid.

  FREE gt_wbs_display.

  LOOP AT gt_wbs_items INTO gs_wbs_item.
    CLEAR: gs_wbs_display, gv_posid_external.
    IF gv_raw_data = abap_true AND gs_wbs_item-stufe = 1.
      gv_p_post1              = gs_wbs_item-post1.
    ENDIF.
    gs_wbs_display-stufe = gs_wbs_item-stufe.
    gs_wbs_display-post1 = gs_wbs_item-post1.
    gs_wbs_display-kostl = gs_wbs_item-kostl.
    gs_wbs_display-posnr = gs_wbs_item-posnr.
    gs_wbs_display-zapproved_budg = gs_wbs_item-wert2.
    gs_wbs_display-zbudget_check = gs_wbs_item-zbudget_check.
    gs_wbs_display-bukrs = gs_wbs_item-bukrs.
    gs_wbs_display-imprf = gs_wbs_item-imprf.
    gs_wbs_display-prart = gs_wbs_item-prart.

    IF gs_wbs_item-posid IS NOT INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_ABPSP_OUTPUT'
        EXPORTING
          input  = gs_wbs_item-posid
        IMPORTING
          output = gv_posid_external
        EXCEPTIONS
          OTHERS = 1.

      gs_wbs_display-posid = COND #( WHEN sy-subrc = 0 AND gv_posid_external IS NOT INITIAL
                                     THEN gv_posid_external
                                     ELSE gs_wbs_item-posid ).
    ENDIF.

    APPEND gs_wbs_display TO gt_wbs_display.
  ENDLOOP.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form SET_WBS_DEFAULT_VALUES
*&---------------------------------------------------------------------*
FORM set_wbs_default_values.

  LOOP AT gt_wbs_display INTO gs_wbs_display.

    IF gv_p_post1 IS INITIAL AND gs_wbs_display-stufe = 1.
      gv_p_post1 = gs_wbs_display-post1.
    ENDIF.

    "Default KOSTL only if empty (don't overwrite user edit)
    IF gs_wbs_display-kostl IS INITIAL.
      gs_wbs_display-kostl = gv_p_kostl.
    ENDIF.

    "Budget check default for STUFE=1 only if initial
    IF gs_wbs_display-stufe = 1 AND gs_wbs_display-zbudget_check IS INITIAL.
      gs_wbs_display-zbudget_check = gc_x.
    ENDIF.

    "Level 1 description = to Proj description
    IF gs_wbs_display-stufe = 1.
      gs_wbs_display-post1 = gv_p_post1.
    ENDIF.

    MODIFY gt_wbs_display FROM gs_wbs_display.

  ENDLOOP.

ENDFORM.


