*&---------------------------------------------------------------------*
FORM download.

  TYPES: BEGIN OF ty_download,
           pspid   TYPE zta2r_wbsitem-pspid,
           zchange TYPE zta2r_wbsitem-zchange,
           stufe   TYPE zta2r_wbsitem-stufe,
           post1   TYPE zta2r_wbsitem-post1,
           budget  TYPE zta2r_wbsitem-zbudget_check,
         END OF ty_download,
         BEGIN OF ts_fieldnames,
           fieldname TYPE char50,
         END OF ts_fieldnames.

  DATA: ls_download   TYPE ty_download,
        lt_download   TYPE TABLE OF ty_download,
        lt_fieldnames TYPE STANDARD TABLE OF ts_fieldnames,
        ls_fieldnames TYPE ts_fieldnames.

  DATA: gv_action   TYPE i,
        gv_filename TYPE string,
        gv_fullpath TYPE string,
        gv_path     TYPE string.

  "Append header to the Excel file.
  ls_fieldnames-fieldname = 'Level'(c02).
  APPEND ls_fieldnames TO lt_fieldnames.
  CLEAR ls_fieldnames.

  ls_fieldnames-fieldname = 'WBS Element'(c03).
  APPEND ls_fieldnames TO lt_fieldnames.
  CLEAR ls_fieldnames.

  ls_fieldnames-fieldname = 'Description'(c04).
  APPEND ls_fieldnames TO lt_fieldnames.
  CLEAR ls_fieldnames.

  ls_fieldnames-fieldname = 'Budget'(c05).
  APPEND ls_fieldnames TO lt_fieldnames.
  CLEAR ls_fieldnames.

  LOOP AT gt_wbs_items INTO gs_wbs_item.
    ls_download-stufe  = gs_wbs_item-stufe.
    ls_download-post1  = gs_wbs_item-post1.
    ls_download-pspid  = gs_wbs_item-pspid.
    ls_download-budget = gs_wbs_item-zbudget_check.

    APPEND ls_download TO lt_download.
    CLEAR ls_download.
  ENDLOOP.

  CALL METHOD cl_gui_frontend_services=>file_save_dialog
    EXPORTING
      ##NO_TEXT window_title      = 'Please Select the location'
      ##NO_TEXT default_extension = 'XLSX'
      default_file_name           = 'Capex_template.xls'
      file_filter                 = '*.xls'
    CHANGING
      filename                    = gv_filename
      path                        = gv_path
      fullpath                    = gv_fullpath
      user_action                 = gv_action.

  IF NOT gv_action IS INITIAL.
    EXIT.
  ENDIF.

  CALL METHOD cl_gui_frontend_services=>gui_download
    EXPORTING
      filename              = gv_filename
      filetype              = 'ASC'
      write_field_separator = 'X'
      fieldnames            = lt_fieldnames
    CHANGING
      data_tab              = lt_download.

ENDFORM.
