*&---------------------------------------------------------------------*
*& Form HANDLE_ATTACHMENTS
*&---------------------------------------------------------------------*
FORM handle_attachments.
  IF gv_gos_reqnum IS INITIAL.
    IF go_builder IS INITIAL.
      "if you normally create it elsewhere, keep this defensive guard
      CREATE OBJECT go_builder.  "adjust constructor if needed
    ENDIF.
    IF gv_b_reqnum = abap_false.
      IF gv_req_type <> 'A1'.
        CLEAR: gs_header-zreq_num,
               gv_gos_reqnum.
        gv_b_reqnum = abap_true.
      ENDIF.
    ENDIF.

    CALL METHOD go_builder->get_next_request_number
      RECEIVING
        rv_reqnum = gv_gos_reqnum.
  ENDIF.

  IF gv_req_type <> 'A1' AND gv_req_type <> 'E1'.
    gv_b_reqnum = abap_true.
  ENDIF.

  IF gv_req_type = 'F1'.
    gv_gos_reqnum = gs_header-zreq_num.
    gv_b_reqnum = abap_false.
  ENDIF.

ENDFORM.

