*&---------------------------------------------------------------------*
FORM populate_header_structure.

  IF gs_header-posnr IS INITIAL.
    gs_header-posnr = gv_p_posnr.
  ENDIF.
  IF gs_header-prnam IS INITIAL.
    gs_header-prnam = gv_p_prnam.
  ENDIF.
  IF gv_gjahr        IS INITIAL.
    gv_gjahr        = gv_p_gjahr.
  ENDIF.
  IF gs_header-erdat IS INITIAL.
    gs_header-erdat = sy-datum.
  ENDIF.
  IF gs_header-bukrs IS INITIAL.
    gs_header-bukrs = gv_bukrs.
  ENDIF.
  IF gs_header-werks IS INITIAL.
    gs_header-werks = gv_werks.
  ENDIF.
  IF gs_header-izwek IS INITIAL.
    gs_header-izwek = gv_izwek.
  ENDIF.
  IF gs_header-profl IS INITIAL.
    gs_header-profl = gv_p_profl.
  ENDIF.
  IF gs_header-zunifier_proj IS INITIAL.
    gs_header-zunifier_proj = gv_p_usr10_c.
  ENDIF.
  IF gs_header-usr008 IS INITIAL. gs_header-usr008 = gv_usr008. ENDIF.
  IF gs_header-ernam IS INITIAL.
    gs_header-ernam = sy-uname.
  ENDIF.
  IF gs_header-z_reqtype IS INITIAL.
    gs_header-z_reqtype = gv_request_type.
  ENDIF.

  " User-editable fields: only auto-populate if user never edited them
  IF gv_u_post1 IS INITIAL AND gs_header-post1 IS INITIAL.
    gs_header-post1 = gv_p_post1.
  ENDIF.
  IF gv_u_vernr IS INITIAL AND gs_header-vernr IS INITIAL.
    gs_header-vernr = gv_p_verna.
  ENDIF.
  IF gv_u_plsez IS INITIAL AND gs_header-plsez IS INITIAL.
    gs_header-plsez = gv_p_plsez.
  ENDIF.
  IF gv_u_prctr IS INITIAL AND gs_header-prctr IS INITIAL.
    gs_header-prctr = gv_p_prctr.
  ENDIF.
  IF gv_u_kostl IS INITIAL AND gs_header-kostl IS INITIAL.
    gs_header-kostl = gv_p_kostl.
  ENDIF.

  IF gv_z_remarks IS NOT INITIAL AND gs_header-z_remarks IS INITIAL.
    gs_header-z_remarks = gv_z_remarks.
  ENDIF.
  IF gv_im_posid_display IS INITIAL.
    PERFORM get_im_posid_for_display USING gv_p_posnr CHANGING gv_im_posid_display.
  ENDIF.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form SAVE_REQUEST
*&---------------------------------------------------------------------*
FORM save_request.

  DATA: gv_reqnum TYPE zta2r_wbshdr-zreq_num.

  "Bring screen values back into gs_header/gt_wbs_display
  PERFORM sync_screen_to_header.
  PERFORM convert_from_display.  "gt_wbs_display -> gt_wbs_items (must fill WERT2 etc.)
  PERFORM append_tobe.

  "DO NOT call populate_header_structure in edit mode (can overwrite DB audit fields)
  IF gv_edit_mode <> abap_true.
    PERFORM populate_header_structure.
  ELSE.
    IF gv_z_remarks IS NOT INITIAL AND gs_header-z_remarks IS INITIAL.
      gs_header-z_remarks = gv_z_remarks.
    ENDIF.
  ENDIF.

  "=========================
  "F1: EDIT SAVED REQUEST
  "=========================
  IF gv_edit_mode = abap_true.
    IF gs_header-zreq_num = 0 OR gs_header-zreq_num IS INITIAL.
      IF go_builder IS INITIAL.
        "if you normally create it elsewhere, keep this defensive guard
        CREATE OBJECT go_builder.  "adjust constructor if needed

        CALL METHOD go_builder->get_next_request_number
          RECEIVING
            rv_reqnum = gv_request_number.


      ENDIF.

    ENDIF.

    IF gs_header-zreq_num = 0 OR gs_header-zreq_num IS INITIAL.
      gs_header-zreq_num = gv_request_number.
    ENDIF.

    gv_reqnum = gs_header-zreq_num.

    PERFORM update_draft_request_db USING gv_reqnum.

    gs_header-waers = gv_project_currency.

    IF gv_gos_reqnum IS NOT INITIAL.
      gs_header-zreq_num = gv_gos_reqnum.
    ENDIF.

    CALL METHOD go_builder->save_request
      EXPORTING
        is_header    = gs_header
        it_wbs_items = gt_wbs_items
        it_wbs_unclose = gt_wbs_unclose
      RECEIVING
        rv_reqnum    = gv_reqnum.

    gv_request_number = gv_reqnum.
    COMMIT WORK AND WAIT.
    MESSAGE s000(zmsg_a2r) WITH 'Saved Request :'(m33) gv_reqnum.
    CALL TRANSACTION 'ZA2R_ZCJ00'.
  ENDIF.

  "=========================
  "A1: CREATE/SAVE REQUEST
  "=========================
  IF go_builder IS INITIAL.
    "if you normally create it elsewhere, keep this defensive guard
    CREATE OBJECT go_builder.  "adjust constructor if needed
  ENDIF.
  gs_header-waers = gv_project_currency.

  IF gv_gos_reqnum IS NOT INITIAL.
    gs_header-zreq_num = gv_gos_reqnum.
  ENDIF.

  CALL METHOD go_builder->save_request
    EXPORTING
      is_header    = gs_header
      it_wbs_items = gt_wbs_items
      it_wbs_unclose = gt_wbs_unclose
    RECEIVING
      rv_reqnum    = gv_reqnum.

  IF gv_reqnum IS NOT INITIAL.
    gv_request_number = gv_reqnum.
    MESSAGE s000(zmsg_a2r) WITH gv_reqnum.
    COMMIT WORK AND WAIT.
  ELSE.
    MESSAGE e013.
  ENDIF.

ENDFORM.

